Dialogue: 0,0:00:00.09,0:00:02.84,Caption,,0,0,0,,ПЕРЕГОВОРЫ ЗАКОНЧИЛИСЬ, А ОЩУЩЕНИЕ ТАКОЕ,
Dialogue: 0,0:00:02.99,0:00:05.80,Caption,,0,0,0,,БУДТО САМОЕ ИНТЕРЕСНОЕ ТОЛЬКО НАЧИНАЕТСЯ. ВСЕ
Dialogue: 0,0:00:05.80,0:00:08.12,Caption,,0,0,0,,ГОВОРЯТ ПРО ГАРАНТИИ, ТЕРРИТОРИИ,
Dialogue: 0,0:00:08.28,0:00:13.24,Caption,,0,0,0,,БУДУЩИЙ МИР. ВСЁ КРАСИВО, ВСЁ СЕРЬЁЗНО. ТОЛЬКО Я ВСЁ ВРЕМЯ СПОТЫКАЮСЬ ОБ
Dialogue: 0,0:00:13.32,0:00:16.20,Caption,,0,0,0,,ОДИН ПРОСТОЙ ВОПРОС. МЫ ВООБЩЕ ПРО КАКУЮ УКРАИНУ
Dialogue: 0,0:00:16.20,0:00:19.40,Caption,,0,0,0,,СЕЙЧАС ГОВОРИМ? ПРО ТУ ЖЕ САМУЮ ИЛИ УЖЕ ПРО КАКУЮ
Dialogue: 0,0:00:19.40,0:00:22.44,Caption,,0,0,0,,ТО ДРУГУЮ? ЕСЛИ ВАМ НРАВИТСЯ ИМЕННО ТАКОЙ РАЗБОР,
Dialogue: 0,0:00:22.60,0:00:24.28,Caption,,0,0,0,,ГДЕ МЫ НЕ СЧИТАЕМ РУКОПОЖАТИЯ,
Dialogue: 0,0:00:24.44,0:00:26.68,Caption,,0,0,0,,А СМОТРИМ, ЧТО РЕАЛЬНО ЛЕЖИТ НА СТОЛЕ,
Dialogue: 0,0:00:26.88,0:00:29.48,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ТАМ НАЧИНАЕТСЯ
Dialogue: 0,0:00:29.48,0:00:32.84,Caption,,0,0,0,,АРИФМЕТИКА, ОТ КОТОРОЙ СЛОВО "ПРОГРЕСС" ВЫГЛЯДИТ ОСОБЕННО
Dialogue: 0,0:00:32.84,0:00:35.72,Caption,,0,0,0,,ВЕСЕЛО. ПОТОМУ ЧТО ПОСЛЕ АБУ ДАБИ ОПЯТЬ ПОШЛО
Dialogue: 0,0:00:35.72,0:00:39.08,Caption,,0,0,0,,ЗНАКОМОЕ СЛОВО ПРОГРЕСС. ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ
Dialogue: 0,0:00:39.15,0:00:42.84,Caption,,0,0,0,,ПРОГРЕСС. ПО ПЕРЕГОВОРАМ ДВИЖЕНИЕ. СЛЕДУЮЩАЯ ВСТРЕЧА
Dialogue: 0,0:00:42.84,0:00:46.20,Caption,,0,0,0,,БУДЕТ. АМЕРИКАНЦЫ ПОЕДУТ ДАЛЬШЕ РАЗГОВАРИВАТЬ. ОБМЕН
Dialogue: 0,0:00:46.20,0:00:48.20,Caption,,0,0,0,,ПЛЕННЫМИ СОГЛАСОВАЛИ. В ОБЩЕМ,
Dialogue: 0,0:00:48.45,0:00:50.84,Caption,,0,0,0,,ЕСЛИ СЛУШАТЬ ТОЛЬКО ОФИЦИАЛЬНЫЕ ФОРМУЛИРОВКИ,
Dialogue: 0,0:00:51.00,0:00:53.72,Caption,,0,0,0,,ЕЩЁ НЕМНОГО И МОЖНО ЗАКАЗЫВАТЬ ОРКЕСТР. ТОЛЬКО МЫ
Dialogue: 0,0:00:53.72,0:00:55.16,Caption,,0,0,0,,С ВАМИ УЖЕ НЕ ПЕРВЫЙ РАЗ НА ЭТИ
Dialogue: 0,0:00:55.16,0:00:58.68,Caption,,0,0,0,,ГРАБЛИ СМОТРИМ. ПОЭТОМУ ДАВАЙТЕ БЕЗ ОРКЕСТРА. ЕСТЬ
Dialogue: 0,0:00:58.76,0:01:01.48,Caption,,0,0,0,,ОДИН ОЧЕНЬ ПРОСТОЙ БАРОМЕТР. МОСКВА СВОИ ОСНОВНЫЕ
Dialogue: 0,0:01:01.48,0:01:04.36,Caption,,0,0,0,,ТРЕБОВАНИЯ СНЯЛА? НЕТ. МОСКВА СКАЗАЛА,
Dialogue: 0,0:01:04.60,0:01:06.44,Caption,,0,0,0,,ЧТО ДЕМИЛИТАРИЗАЦИЯ БОЛЬШЕ НЕ НУЖНА?
Dialogue: 0,0:01:06.67,0:01:09.32,Caption,,0,0,0,,НЕТ. ОТКАЗАЛАСЬ ОТ ТЕРРИТОРИАЛЬНЫХ ТРЕБОВАНИЙ?
Dialogue: 0,0:01:09.40,0:01:12.65,Caption,,0,0,0,,НЕТ. СКАЗАЛА,
Dialogue: 0,0:01:12.89,0:01:15.21,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ЕЁ УСТРАИВАЕТ ЛЮБАЯ УКРАИНА,
Dialogue: 0,0:01:15.29,0:01:18.17,Caption,,0,0,0,,С ЛЮБОЙ АРМИЕЙ, С ЛЮБЫМ ПОЛИТИЧЕСКИМ КУРСОМ,
Dialogue: 0,0:01:18.33,0:01:23.37,Caption,,0,0,0,,ЛИШЬ БЫ БУМАГУ ПОДПИСАЛИ? ТОЖЕ НЕТ. ЛАВРОВ ПОСЛЕ ПЕРЕГОВОРОВ СНОВА ПОДТВЕРДИЛ,
Dialogue: 0,0:01:23.60,0:01:26.49,Caption,,0,0,0,,ЧТО РОССИЙСКАЯ ЛИНИЯ ОСТАЁТСЯ СВЯЗАНА С ДОСТИЖЕНИЕМ
Dialogue: 0,0:01:26.49,0:01:29.29,Caption,,0,0,0,,ЗАЯВЛЕННЫХ ЦЕЛЕЙ МОСКВЫ. В АБУ ДАБИ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:01:29.37,0:01:31.85,Caption,,0,0,0,,ГОВОРИЛИ О НОВОЙ СИСТЕМЕ БЕЗОПАСНОСТИ В ЕВРОПЕ,
Dialogue: 0,0:01:32.23,0:01:34.89,Caption,,0,0,0,,А ПО КЛЮЧЕВЫМ ВОПРОСАМ, ПРЕЖДЕ ВСЕГО ТЕРРИТОРИЯМ,
Dialogue: 0,0:01:35.12,0:01:38.49,Caption,,0,0,0,,ПУБЛИЧНОГО ПРОРЫВА НЕ ПРОИЗОШЛО. ВОТ И ВСЁ. ПОЭТОМУ
Dialogue: 0,0:01:38.57,0:01:43.13,Caption,,0,0,0,,НАС СЕЙЧАС ИНТЕРЕСУЕТ НЕ ТО, СКОЛЬКО РАЗ ПРОИЗНЕСЛИ СЛОВО "ПРОГРЕСС". НАС
Dialogue: 0,0:01:43.13,0:01:46.49,Caption,,0,0,0,,ИНТЕРЕСУЕТ ДРУГОЕ. СХОДЯТСЯ УСЛОВИЯ ИЛИ НЕ СХОДЯТСЯ?
Dialogue: 0,0:01:46.69,0:01:48.89,Caption,,0,0,0,,НАЧНЁМ С ТЕРРИТОРИЙ. ТУТ ВООБЩЕ ПРИДУМАЛИ
Dialogue: 0,0:01:48.89,0:01:51.53,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНЫЙ ПОЛИТИЧЕСКИЙ ФОКУС. В БРИТАНСКОЙ
Dialogue: 0,0:01:51.53,0:01:54.09,Caption,,0,0,0,,ПРЕССЕ ПОЯВИЛАСЬ СХЕМА ИЗМЕНИТЬ АДМИНИСТРАТИВНЫЕ
Dialogue: 0,0:01:54.17,0:01:56.49,Caption,,0,0,0,,ГРАНИЦЫ ДОНЕЦКОЙ И ЛУГАНСКОЙ ОБЛАСТЕЙ ТАК,
Dialogue: 0,0:01:56.73,0:01:58.97,Caption,,0,0,0,,ЧТОБЫ РОССИЯ ПОЛУЧИЛА ВОЗМОЖНОСТЬ ЗАЯВИТЬ,
Dialogue: 0,0:01:59.13,0:02:01.29,Caption,,0,0,0,,ЧТО КОНТРОЛИРУЕТ НУЖНЫЕ ЕЙ ТЕРРИТОРИИ,
Dialogue: 0,0:02:01.52,0:02:04.09,Caption,,0,0,0,,А УКРАИНА ПРИ ЭТОМ ФОРМАЛЬНО НИЧЕГО НЕ ПЕРЕДАВАЛА.
Dialogue: 0,0:02:04.56,0:02:06.89,Caption,,0,0,0,,РЕБЯТА, ЭТО ЧТО ЗА ЦИРК С КОНЯМИ?
Dialogue: 0,0:02:07.27,0:02:09.45,Caption,,0,0,0,,ТО ЕСТЬ МЫ СЕЙЧАС ПЕРЕПИШЕМ ЛИНИИ НА БУМАЖКЕ
Dialogue: 0,0:02:09.53,0:02:12.17,Caption,,0,0,0,,И СКАЖЕМ, ЧТО ДОНБАСС ТЕПЕРЬ УЖЕ НЕ ТОТ ДОНБАСС,
Dialogue: 0,0:02:12.33,0:02:15.21,Caption,,0,0,0,,КОТОРЫЙ БЫЛ ДОНБАССОМ? И ВСЁ? ВОПРОС РЕШЁН?
Dialogue: 0,0:02:15.49,0:02:18.25,Caption,,0,0,0,,ЭТО ЖЕ НАПЁРСТКИ КАКИЕ ТО. СЛЕДИТЕ ЗА РУКАМИ.
Dialogue: 0,0:02:18.65,0:02:21.13,Caption,,0,0,0,,ВОТ ЗДЕСЬ БЫЛА ОБЛАСТЬ. ТЕПЕРЬ МЫ ЕЁ НАРИСОВАЛИ
Dialogue: 0,0:02:21.13,0:02:24.01,Caption,,0,0,0,,ЧУТЬ ИНАЧЕ. ЗЕМЛЯ ТА ЖЕ. ГОРОДА ТЕ ЖЕ.
Dialogue: 0,0:02:24.19,0:02:30.04,Caption,,0,0,0,,ЛЮДИ ТЕ ЖЕ. РОССИЙСКИЕ И УКРАИНСКИЕ ПРЕТЕНЗИИ ТЕ ЖЕ. НО
Dialogue: 0,0:02:30.04,0:02:33.64,Caption,,0,0,0,,АДМИНИСТРАТИВНАЯ ЛИНИЯ НОВАЯ, ПОЭТОМУ ВСЕ ДОЛЖНЫ СДЕЛАТЬ ВИД,
Dialogue: 0,0:02:33.72,0:02:36.52,Caption,,0,0,0,,ЧТО ПРОБЛЕМА ИСЧЕЗЛА. А КОГО ЭТИМ ПРЕДПОЛАГАЕТСЯ
Dialogue: 0,0:02:36.52,0:02:40.12,Caption,,0,0,0,,УБЕДИТЬ? ДЛЯ МОСКВЫ ВОПРОС ТЕРРИТОРИЙ ДАВНО НАХОДИТСЯ УЖЕ НЕ
Dialogue: 0,0:02:40.20,0:02:42.44,Caption,,0,0,0,,ТОЛЬКО В ПЛОСКОСТИ УКРАИНСКОГО АДМИНИСТРАТИВНОГО
Dialogue: 0,0:02:42.44,0:02:45.40,Caption,,0,0,0,,УСТРОЙСТВА. РОССИЯ ВКЛЮЧИЛА ДОНЕЦКУЮ И ЛУГАНСКУЮ
Dialogue: 0,0:02:45.40,0:02:47.96,Caption,,0,0,0,,НАРОДНЫЕ РЕСПУБЛИКИ В СОСТАВ ФЕДЕРАЦИИ И СТРОИТ
Dialogue: 0,0:02:48.04,0:02:50.44,Caption,,0,0,0,,СОБСТВЕННУЮ ЮРИДИЧЕСКУЮ КОНСТРУКЦИЮ ВОКРУГ ЭТИХ
Dialogue: 0,0:02:50.52,0:02:53.96,Caption,,0,0,0,,ТЕРРИТОРИЙ. УКРАИНА ЭТОГО НЕ ПРИЗНАЁТ. И ЕСЛИ КИЕВ
Dialogue: 0,0:02:54.04,0:02:56.92,Caption,,0,0,0,,ЗАВТРА ПЕРЕРИСУЕТ ВНУТРЕННЮЮ АДМИНИСТРАТИВНУЮ КАРТУ,
Dialogue: 0,0:02:57.23,0:02:59.80,Caption,,0,0,0,,РОССИЙСКАЯ ПОЗИЦИЯ ОТ ЭТОГО САМА СОБОЙ НЕ ИСЧЕЗНЕТ.
Dialogue: 0,0:03:00.10,0:03:03.16,Caption,,0,0,0,,ДЛЯ УКРАИНЫ ВОПРОС РОВНО ТАКОЙ ЖЕ. ЕСЛИ СЕГОДНЯ
Dialogue: 0,0:03:03.24,0:03:05.72,Caption,,0,0,0,,ИЗМЕНИТЬ ГРАНИЦУ ОБЛАСТИ, ЭТО ЧТО ОЗНАЧАЕТ?
Dialogue: 0,0:03:05.86,0:03:08.12,Caption,,0,0,0,,КИЕВ ПЕРЕСТАЁТ СЧИТАТЬ КОНКРЕТНЫЕ ТЕРРИТОРИИ
Dialogue: 0,0:03:08.12,0:03:12.20,Caption,,0,0,0,,УКРАИНСКИМИ? ЕСЛИ НЕТ, ТО ЧТО ИЗМЕНИЛОСЬ КРОМЕ ЛИНИИ НА БУМАГЕ?
Dialogue: 0,0:03:12.56,0:03:14.20,Caption,,0,0,0,,ТАК ГЕОПОЛИТИКА ВООБЩЕ ДЕЛАЕТСЯ?
Dialogue: 0,0:03:14.60,0:03:17.16,Caption,,0,0,0,,ПО ТАКОЙ ЛОГИКЕ МОЖНО ЗАВТРА ПЕРЕИМЕНОВАТЬ ПОЛОВИНУ
Dialogue: 0,0:03:17.16,0:03:20.92,Caption,,0,0,0,,СТРАНЫ И ОБЪЯВИТЬ, ЧТО ВСЕ СТАРЫЕ ВОПРОСЫ БОЛЬШЕ К НОВОМУ НАЗВАНИЮ
Dialogue: 0,0:03:20.92,0:03:24.68,Caption,,0,0,0,,ОТНОШЕНИЯ НЕ ИМЕЮТ. ОТЛИЧНЫЙ СПОСОБ. ДЁШЕВО. БУМАГИ
Dialogue: 0,0:03:24.76,0:03:26.76,Caption,,0,0,0,,МНОГО НЕ НАДО. ТЕМ БОЛЕЕ ЧТО КИЕВ,
Dialogue: 0,0:03:27.06,0:03:28.92,Caption,,0,0,0,,СУДЯ ПО ПУБЛИКАЦИЯМ О ПЕРЕГОВОРАХ,
Dialogue: 0,0:03:29.15,0:03:31.96,Caption,,0,0,0,,ЭТУ СХЕМУ ОТВЕРГ. ЗЕЛЕНСКИЙ ОТДЕЛЬНО ГОВОРИЛ,
Dialogue: 0,0:03:32.16,0:03:35.00,Caption,,0,0,0,,ЧТО АМЕРИКАНСКАЯ СТОРОНА ПОСТОЯННО ПОДНИМАЕТ ТЕМУ
Dialogue: 0,0:03:35.00,0:03:37.00,Caption,,0,0,0,,ДОНБАССА И ВЫВОДА УКРАИНСКИХ ВОЙСК.
Dialogue: 0,0:03:39.29,0:03:41.69,Caption,,0,0,0,,А РОССИЙСКАЯ СТОРОНА СО СВОЕЙ СТОРОНЫ ПРОДОЛЖАЕТ
Dialogue: 0,0:03:41.77,0:03:44.33,Caption,,0,0,0,,НАСТАИВАТЬ НА ТЕРРИТОРИАЛЬНЫХ ТРЕБОВАНИЯХ. ТО ЕСТЬ
Dialogue: 0,0:03:44.41,0:03:47.21,Caption,,0,0,0,,КРАСИВЫЙ АДМИНИСТРАТИВНЫЙ ФОКУС ПОКА НЕ РЕШИЛ РОВНЫМ
Dialogue: 0,0:03:47.21,0:03:49.85,Caption,,0,0,0,,СЧЁТОМ НИЧЕГО. И ВОТ ЗДЕСЬ МЫ ВОЗВРАЩАЕМСЯ К
Dialogue: 0,0:03:49.93,0:03:53.05,Caption,,0,0,0,,НАШЕМУ БАРОМЕТРУ. МОСКВА ГОВОРИТ ЦЕЛИ ОСТАЮТСЯ.
Dialogue: 0,0:03:53.19,0:03:55.77,Caption,,0,0,0,,ХОРОШО. ДАВАЙТЕ НЕ СПОРИТЬ С ТЕЛЕВИЗОРОМ И НЕ
Dialogue: 0,0:03:55.77,0:03:59.05,Caption,,0,0,0,,ГАДАТЬ, КТО ТАМ КОМУ УЛЫБНУЛСЯ В КОРИДОРЕ. БЕРЁМ ЭТИ
Dialogue: 0,0:03:59.05,0:04:00.97,Caption,,0,0,0,,ЦЕЛИ И ПРИКЛАДЫВАЕМ ИХ К ТОМУ,
Dialogue: 0,0:04:01.05,0:04:04.09,Caption,,0,0,0,,ЧТО СЕЙЧАС ОБСУЖДАЕТСЯ. САМЫЙ ПОКАЗАТЕЛЬНЫЙ ПРИМЕР
Dialogue: 0,0:04:04.17,0:04:07.37,Caption,,0,0,0,,ДАЖЕ НЕ ТЕРРИТОРИИ. АРМИЯ. КИЕВ ХОЧЕТ ПОСЛЕ
Dialogue: 0,0:04:07.37,0:04:09.85,Caption,,0,0,0,,ОКОНЧАНИЯ КОНФЛИКТА СОХРАНИТЬ ВООРУЖЁННЫЕ СИЛЫ
Dialogue: 0,0:04:09.85,0:04:12.81,Caption,,0,0,0,,ЧИСЛЕННОСТЬЮ ВОСЕМЬСОТ ТЫСЯЧ ЧЕЛОВЕК И ПОЛУЧАТЬ НА
Dialogue: 0,0:04:12.89,0:04:15.85,Caption,,0,0,0,,ИХ СОДЕРЖАНИЕ ЗАПАДНОЕ ФИНАНСИРОВАНИЕ МИНИМУМ ДЕСЯТЬ
Dialogue: 0,0:04:15.85,0:04:18.73,Caption,,0,0,0,,ЛЕТ. ИМЕННО ТАКАЯ ЦИФРА БЫЛА ОЗВУЧЕНА УКРАИНСКОЙ
Dialogue: 0,0:04:18.73,0:04:21.53,Caption,,0,0,0,,СТОРОНОЙ ЧЕРЕЗ AFP ВО ВРЕМЯ НЫНЕШНЕГО ПЕРЕГОВОРНОГО
Dialogue: 0,0:04:21.53,0:04:25.61,Caption,,0,0,0,,РАУНДА. ВОСЕМЬСОТ ТЫСЯЧ. ПОСЛЕ ВОЙНЫ. ДЕСЯТЬ ЛЕТ. А
Dialogue: 0,0:04:25.69,0:04:29.05,Caption,,0,0,0,,ТЕПЕРЬ ВСПОМИНАЕМ, ЧТО РОССИЯ ПРЕДЛАГАЛА В СТАМБУЛЬСКОМ ПРОЕКТЕ
Dialogue: 0,0:04:29.05,0:04:32.01,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОГО ГОДА. ВОСЕМЬДЕСЯТ ПЯТЬ ТЫСЯЧ
Dialogue: 0,0:04:32.01,0:04:35.69,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ ВСУ. ТРИСТА СОРОК ДВА ТАНКА. ПЯТЬСОТ
Dialogue: 0,0:04:35.69,0:04:38.41,Caption,,0,0,0,,ДЕВЯТНАДЦАТЬ АРТИЛЛЕРИЙСКИХ ОРУДИЙ. ОГРАНИЧЕНИЕ
Dialogue: 0,0:04:38.41,0:04:41.53,Caption,,0,0,0,,ДАЛЬНОСТИ РАКЕТ. ЗАПРЕТ НА ИНОСТРАННОЕ ВООРУЖЕНИЕ.
Dialogue: 0,0:04:41.82,0:04:44.49,Caption,,0,0,0,,УКРАИНА ТОГДА НАСТАИВАЛА НА ГОРАЗДО БОЛЬШЕЙ АРМИИ,
Dialogue: 0,0:04:44.73,0:04:47.21,Caption,,0,0,0,,А МОСКВА ТРЕБОВАЛА РАДИКАЛЬНОГО СОКРАЩЕНИЯ ЕЁ
Dialogue: 0,0:04:47.29,0:04:50.33,Caption,,0,0,0,,ВОЕННОГО ПОТЕНЦИАЛА. ВОСЕМЬДЕСЯТ ПЯТЬ ТЫСЯЧ ТОГДА.
Dialogue: 0,0:04:52.61,0:04:54.53,Caption,,0,0,0,,ВОСЕМЬСОТ ТЫСЯЧ СЕЙЧАС. НУ КАК?
Dialogue: 0,0:04:54.54,0:04:57.81,Caption,,0,0,0,,СХОДИТСЯ? ПОЧТИ В ДЕВЯТЬ С ПОЛОВИНОЙ РАЗ БОЛЬШЕ. И
Dialogue: 0,0:04:57.81,0:04:59.73,Caption,,0,0,0,,ВОТ ЗДЕСЬ У МЕНЯ ТОТ САМЫЙ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:05:00.13,0:05:03.89,Caption,,0,0,0,,А РОССИЯ СОГЛАСНА? ПОТОМУ ЧТО ЕСЛИ ОДНА ИЗ ЗАЯВЛЕННЫХ ЦЕЛЕЙ МОСКВЫ
Dialogue: 0,0:05:03.89,0:05:08.13,Caption,,0,0,0,,НАЗЫВАЕТСЯ ДЕМИЛИТАРИЗАЦИЕЙ, ТО ВОСЬМИСОТТЫСЯЧНАЯ АРМИЯ НА ЗАПАДНОМ
Dialogue: 0,0:05:08.13,0:05:10.37,Caption,,0,0,0,,ФИНАНСИРОВАНИИ ВЫГЛЯДИТ ОЧЕНЬ СВОЕОБРАЗНОЙ
Dialogue: 0,0:05:10.37,0:05:12.93,Caption,,0,0,0,,ДЕМИЛИТАРИЗАЦИЕЙ. ПРЯМО МОГУЧЕЙ ТАКОЙ.
Dialogue: 0,0:05:13.22,0:05:17.49,Caption,,0,0,0,,ДЕМИЛИТАРИЗИРОВАЛИ ТАК, ЧТО СОЛДАТ СТАЛО ПОЧТИ В ДЕСЯТЬ РАЗ БОЛЬШЕ,
Dialogue: 0,0:05:17.72,0:05:19.97,Caption,,0,0,0,,ЧЕМ МОСКВА ПРЕДЛАГАЛА ОСТАВИТЬ В ДВАДЦАТЬ ВТОРОМ
Dialogue: 0,0:05:20.05,0:05:23.25,Caption,,0,0,0,,ГОДУ. ЭТО НЕ МЕЛКАЯ ТЕХНИЧЕСКАЯ РАЗНИЦА. ЭТО ДВЕ
Dialogue: 0,0:05:23.25,0:05:26.53,Caption,,0,0,0,,ВООБЩЕ РАЗНЫЕ МОДЕЛИ ПОСЛЕВОЕННОЙ УКРАИНЫ. В ОДНОЙ
Dialogue: 0,0:05:26.53,0:05:29.73,Caption,,0,0,0,,МОДЕЛИ ВООРУЖЁННЫЕ СИЛЫ РЕЗКО ОГРАНИЧЕНЫ. В ДРУГОЙ
Dialogue: 0,0:05:29.73,0:05:34.77,Caption,,0,0,0,,СУЩЕСТВУЕТ ОГРОМНАЯ АРМИЯ, КОТОРУЮ ЕЩЁ ДЕСЯТЬ ЛЕТ СОДЕРЖАТ ВНЕШНИЕ СПОНСОРЫ. И
Dialogue: 0,0:05:34.85,0:05:37.01,Caption,,0,0,0,,ВОТ ЗДЕСЬ УЖЕ НЕДОСТАТОЧНО СКАЗАТЬ НУ ЗАТО БУДУТ
Dialogue: 0,0:05:37.09,0:05:39.81,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ. ГАРАНТИИ КОМУ?
Dialogue: 0,0:05:40.00,0:05:42.21,Caption,,0,0,0,,ВОТ ЭТОТ ВОПРОС ГОРАЗДО ИНТЕРЕСНЕЕ САМОГО СЛОВА
Dialogue: 0,0:05:42.21,0:05:45.17,Caption,,0,0,0,,"ГАРАНТИИ". КАКОЙ УКРАИНЕ? В КАКИХ ГРАНИЦАХ?
Dialogue: 0,0:05:45.25,0:05:46.77,Caption,,0,0,0,,С КАКИМ ПОЛИТИЧЕСКИМ РУКОВОДСТВОМ?
Dialogue: 0,0:05:46.85,0:05:49.49,Caption,,0,0,0,,С КАКОЙ АРМИЕЙ? С КАКИМ ВНЕШНЕПОЛИТИЧЕСКИМ КУРСОМ?
Dialogue: 0,0:05:49.72,0:05:54.37,Caption,,0,0,0,,С КАКИМ ОТНОШЕНИЕМ К РОССИИ? ПОТОМУ ЧТО ГАРАНТИРОВАТЬ БЕЗОПАСНОСТЬ ГОСУДАРСТВА И
Dialogue: 0,0:05:54.37,0:05:56.93,Caption,,0,0,0,,ГАРАНТИРОВАТЬ СОХРАНЕНИЕ ВСЕЙ НЫНЕШНЕЙ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:05:56.93,0:05:59.73,Caption,,0,0,0,,КОНСТРУКЦИИ ЭТО ДВЕ РАЗНЫЕ ВЕЩИ. ВОТ КОРОБКА.
Dialogue: 0,0:06:02.02,0:06:04.26,Caption,,0,0,0,,НА НЕЙ КРАСИВЫМИ БУКВАМИ НАПИСАНО "ГАРАНТИИ
Dialogue: 0,0:06:04.26,0:06:07.30,Caption,,0,0,0,,БЕЗОПАСНОСТИ УКРАИНЫ". ПРЕКРАСНО. А ВНУТРИ ЧТО?
Dialogue: 0,0:06:07.95,0:06:10.82,Caption,,0,0,0,,ВОТ ВОПРОС НЕ В УПАКОВКЕ. ВОПРОС В СОДЕРЖАНИИ.
Dialogue: 0,0:06:11.16,0:06:14.50,Caption,,0,0,0,,ДОПУСТИМ, ЗЕЛЕНСКОГО ЗАВТРА НЕТ. ПРИХОДИТ ДРУГОЙ ПРЕЗИДЕНТ.
Dialogue: 0,0:06:14.74,0:06:18.26,Caption,,0,0,0,,ФАМИЛИЯ ДРУГАЯ. КОСТЮМ ДРУГОЙ. ГАЛСТУК ДРУГОЙ. А
Dialogue: 0,0:06:18.34,0:06:20.66,Caption,,0,0,0,,КУРС ТОТ ЖЕ САМЫЙ. ОТНОШЕНИЕ К РОССИИ ТО
Dialogue: 0,0:06:20.74,0:06:24.02,Caption,,0,0,0,,ЖЕ. ВОЕННАЯ ПОЛИТИКА ТА ЖЕ. ЗАПАДНАЯ ИНФРАСТРУКТУРА
Dialogue: 0,0:06:24.10,0:06:27.62,Caption,,0,0,0,,ТА ЖЕ. ОГРОМНАЯ АРМИЯ ТА ЖЕ. ЯЗЫКОВАЯ ПОЛИТИКА
Dialogue: 0,0:06:27.71,0:06:30.74,Caption,,0,0,0,,ТА ЖЕ. ИСТОРИЧЕСКАЯ ПОЛИТИКА ТА ЖЕ. ЧТО ТОГДА
Dialogue: 0,0:06:30.74,0:06:35.14,Caption,,0,0,0,,ПРИНЦИПИАЛЬНО ИЗМЕНИЛОСЬ? НИЧЕГО. ИМЕННО ПОЭТОМУ РАЗГОВОР О ДЕНАЦИФИКАЦИИ
Dialogue: 0,0:06:35.22,0:06:39.14,Caption,,0,0,0,,НЕЛЬЗЯ СВОДИТЬ К ТОМУ, СИДИТ ЗЕЛЕНСКИЙ ЛИЧНО В КАБИНЕТЕ ИЛИ НЕ СИДИТ.
Dialogue: 0,0:06:39.46,0:06:41.78,Caption,,0,0,0,,И ЗДЕСЬ РЕЧЬ ИДЁТ О ПОЛНОЙ СМЕНЕ НЫНЕШНЕГО
Dialogue: 0,0:06:41.78,0:06:45.78,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО РЕЖИМА, А НЕ ПРОСТО О ЗАМЕНЕ ПРЕЗИДЕНТА. ЕСЛИ ВМЕСТО
Dialogue: 0,0:06:45.78,0:06:48.26,Caption,,0,0,0,,ЗЕЛЕНСКОГО ПРИДЁТ ЧЕЛОВЕК С ДРУГОЙ ФАМИЛИЕЙ,
Dialogue: 0,0:06:48.42,0:06:50.34,Caption,,0,0,0,,НО С ТОЙ ЖЕ АНТИРОССИЙСКОЙ ПОЛИТИКОЙ,
Dialogue: 0,0:06:50.66,0:06:53.70,Caption,,0,0,0,,ДЛЯ МОСКВЫ ПРИНЦИПИАЛЬНО НИЧЕГО НЕ ИЗМЕНИТСЯ. ДРУГАЯ
Dialogue: 0,0:06:53.78,0:06:55.78,Caption,,0,0,0,,ВЛАСТЬ, ДРУГОЙ ПОЛИТИЧЕСКИЙ КУРС,
Dialogue: 0,0:06:55.94,0:06:59.22,Caption,,0,0,0,,ДРУГОЕ ОТНОШЕНИЕ К РОССИИ. И РАДИКАЛЬНО ОГРАНИЧЕННАЯ
Dialogue: 0,0:06:59.22,0:07:02.34,Caption,,0,0,0,,АРМИЯ. ВОТ С КАКОЙ УЖЕ СОВЕРШЕННО ДРУГОЙ УКРАИНОЙ
Dialogue: 0,0:07:02.34,0:07:04.90,Caption,,0,0,0,,ТОГДА ПРЕДСТОИТ ОБСУЖДАТЬ ГАРАНТИИ БЕЗОПАСНОСТИ.
Dialogue: 0,0:07:05.10,0:07:08.34,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ВОТ ЗДЕСЬ
Dialogue: 0,0:07:08.42,0:07:10.82,Caption,,0,0,0,,И НАЧИНАЕТСЯ САМОЕ ВАЖНОЕ. НЕ ТО,
Dialogue: 0,0:07:10.92,0:07:13.38,Caption,,0,0,0,,КТО БУДЕТ СТОЯТЬ РЯДОМ С ФЛАГОМ НА ПОДПИСАНИИ.
Dialogue: 0,0:07:13.78,0:07:16.26,Caption,,0,0,0,,А ЧТО ЗА ГОСУДАРСТВО ОСТАНЕТСЯ ПОСЛЕ ПОДПИСАНИЯ.
Dialogue: 0,0:07:18.53,0:07:21.33,Caption,,0,0,0,,И ТУТ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ОЧЕНЬ НЕУДОБНАЯ ЦИФРА.
Dialogue: 0,0:07:21.73,0:07:26.05,Caption,,0,0,0,,ВОСЕМЬСОТ ТЫСЯЧ ВОЕННЫХ, ЭТО НЕ ТОЛЬКО ДЕНЬГИ. ЭТО ЛЮДИ. ОТКУДА ИХ
Dialogue: 0,0:07:26.13,0:07:30.05,Caption,,0,0,0,,БРАТЬ ДЕСЯТЬ ЛЕТ? ЕСЛИ АРМИЯ ДЕЙСТВИТЕЛЬНО ДОЛЖНА ОСТАВАТЬСЯ ТАКОГО
Dialogue: 0,0:07:30.05,0:07:32.21,Caption,,0,0,0,,РАЗМЕРА ПОСЛЕ ОКОНЧАНИЯ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:07:32.53,0:07:35.25,Caption,,0,0,0,,ЗНАЧИТ ДОЛЖНА СУЩЕСТВОВАТЬ СИСТЕМА ЕЁ ПОСТОЯННОГО
Dialogue: 0,0:07:35.25,0:07:37.97,Caption,,0,0,0,,КОМПЛЕКТОВАНИЯ. КОНТРАКТНИКИ, РЕЗЕРВ,
Dialogue: 0,0:07:38.20,0:07:40.77,Caption,,0,0,0,,МОБИЛИЗАЦИОННАЯ СИСТЕМА, ОГРАНИЧЕНИЯ,
Dialogue: 0,0:07:40.86,0:07:46.37,Caption,,0,0,0,,РОТАЦИИ. КАКАЯ ИМЕННО МОДЕЛЬ, ПОКА ОТДЕЛЬНЫЙ ВОПРОС. НО У ОБЫЧНОГО УКРАИНЦА ВОПРОС
Dialogue: 0,0:07:46.45,0:07:50.21,Caption,,0,0,0,,БУДЕТ НАМНОГО ПРОЩЕ. РЕБЯТА, А ГРАНИЦУ ПОСЛЕ ЭТОГО ОТКРОЮТ?
Dialogue: 0,0:07:50.41,0:07:54.13,Caption,,0,0,0,,ПОТОМУ ЧТО ЧЕЛОВЕКУ, КОТОРЫЙ ПЯТЬ ЛЕТ ЖИЛ В УСЛОВИЯХ МОБИЛИЗАЦИИ И
Dialogue: 0,0:07:54.13,0:07:56.69,Caption,,0,0,0,,ОГРАНИЧЕНИЙ НА ВЫЕЗД, ГЛУБОКО ВСЁ РАВНО,
Dialogue: 0,0:07:57.01,0:07:59.73,Caption,,0,0,0,,КАК КРАСИВО НАЗЫВАЕТСЯ НОВАЯ ЕВРОПЕЙСКАЯ АРХИТЕКТУРА
Dialogue: 0,0:07:59.73,0:08:04.77,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ОН ХОЧЕТ ЗНАТЬ, СМОЖЕТ ЛИ ПОСЛЕ ОКОНЧАНИЯ ВОЙНЫ СОБРАТЬ ЧЕМОДАН,
Dialogue: 0,0:08:05.06,0:08:07.65,Caption,,0,0,0,,СЕСТЬ В МАШИНУ И СПОКОЙНО ВЫЕХАТЬ. И ТУТ
Dialogue: 0,0:08:07.65,0:08:10.45,Caption,,0,0,0,,ВОЗНИКАЕТ СТРАННАЯ КАРТИНА. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:08:10.69,0:08:13.81,Caption,,0,0,0,,НАМ РАССКАЗЫВАЮТ О ПОСЛЕВОЕННОЙ УКРАИНЕ. С ДРУГОЙ,
Dialogue: 0,0:08:13.97,0:08:17.01,Caption,,0,0,0,,ОДНОВРЕМЕННО ПЛАНИРУЮТ АРМИЮ ПОЧТИ В МИЛЛИОН ЧЕЛОВЕК
Dialogue: 0,0:08:17.09,0:08:19.89,Caption,,0,0,0,,НА ДЕСЯТЬ ЛЕТ ВПЕРЁД. ТАК ВОЙНА ЗАКОНЧИЛАСЬ ИЛИ
Dialogue: 0,0:08:19.89,0:08:22.45,Caption,,0,0,0,,ВОЕННАЯ МОДЕЛЬ СТРАНЫ ПРОСТО ПЕРЕЕХАЛА В МИРНОЕ
Dialogue: 0,0:08:22.45,0:08:25.57,Caption,,0,0,0,,ВРЕМЯ? И ЕЩЁ ВОПРОС. КТО ВСЁ ЭТО БУДЕТ ОПЛАЧИВАТЬ?
Dialogue: 0,0:08:25.94,0:08:28.85,Caption,,0,0,0,,САМ КИЕВ ПРОСИТ ЗАПАДНОЕ ФИНАНСИРОВАНИЕ МИНИМУМ НА
Dialogue: 0,0:08:28.85,0:08:34.18,Caption,,0,0,0,,ДЕСЯТЬ ЛЕТ. ТО ЕСТЬ ПОСЛЕ ОКОНЧАНИЯ БОЕВЫХ ДЕЙСТВИЙ ОГРОМНАЯ
Dialogue: 0,0:08:34.18,0:08:36.98,Caption,,0,0,0,,ЧАСТЬ УКРАИНСКОЙ ВОЕННОЙ СИСТЕМЫ ВСЁ РАВНО ОСТАЁТСЯ
Dialogue: 0,0:08:36.98,0:08:39.86,Caption,,0,0,0,,ЗАВЯЗАНА НА ВНЕШНИЕ ДЕНЬГИ. ТОГДА ЭТО УЖЕ НЕ
Dialogue: 0,0:08:39.94,0:08:42.82,Caption,,0,0,0,,ПРОСТО ГАРАНТИЯ БЕЗОПАСНОСТИ. ЭТО ДОЛГОСРОЧНОЕ
Dialogue: 0,0:08:42.90,0:08:45.54,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВО ЗАПАДА СОДЕРЖАТЬ ОДНУ ИЗ КРУПНЕЙШИХ
Dialogue: 0,0:08:45.62,0:08:48.34,Caption,,0,0,0,,АРМИЙ ЕВРОПЫ. И ЕСЛИ МОСКВА КАК РАЗ ТРЕБУЕТ
Dialogue: 0,0:08:48.34,0:08:50.58,Caption,,0,0,0,,ДЕМИЛИТАРИЗАЦИИ И ГАРАНТИЙ ТОГО,
Dialogue: 0,0:08:50.75,0:08:53.14,Caption,,0,0,0,,ЧТО УКРАИНА БОЛЬШЕ НЕ БУДЕТ ПРЕДСТАВЛЯТЬ ДЛЯ НЕЁ
Dialogue: 0,0:08:53.22,0:08:57.22,Caption,,0,0,0,,ВОЕННУЮ УГРОЗУ, ТО МЫ ОПЯТЬ ЗАДАЁМ НАШ ПРОСТОЙ ВОПРОС. СХОДИТСЯ?
Dialogue: 0,0:08:57.51,0:09:00.98,Caption,,0,0,0,,ПОКА НЕТ. ДАЛЬШЕ ЕВРОПА. АМЕРИКАНЦЫ ХОТЯТ,
Dialogue: 0,0:09:01.22,0:09:03.70,Caption,,0,0,0,,ЧТОБЫ В СЛЕДУЮЩИХ РАУНДАХ ЕВРОПЕЙЦЫ УЧАСТВОВАЛИ
Dialogue: 0,0:09:03.70,0:09:08.58,Caption,,0,0,0,,АКТИВНЕЕ. КУШНЕР УЖЕ СКАЗАЛ, ЧТО ЕВРОПЕ НЕПЛОХО БЫ ВЫБРАТЬ ОДНОГО ЧЕЛОВЕКА,
Dialogue: 0,0:09:08.90,0:09:11.38,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ ГОВОРИТЬ ОТ ЕЁ ИМЕНИ. РОССИЯ В
Dialogue: 0,0:09:11.46,0:09:13.86,Caption,,0,0,0,,АБУ ДАБИ С ЕВРОПЕЙСКИМИ ПРЕДСТАВИТЕЛЯМИ ОТДЕЛЬНО НЕ
Dialogue: 0,0:09:13.86,0:09:15.94,Caption,,0,0,0,,ВСТРЕЧАЛАСЬ, А МЕДИНСКИЙ ЗАЯВИЛ,
Dialogue: 0,0:09:16.11,0:09:18.58,Caption,,0,0,0,,ЧТО МОСКВА НЕ ПОЛУЧИЛА ОТ НИХ КОНКРЕТНЫХ МИРНЫХ
Dialogue: 0,0:09:18.58,0:09:21.22,Caption,,0,0,0,,ПРЕДЛОЖЕНИЙ. И ЗДЕСЬ ПРОБЛЕМА ДАЖЕ НЕ В ТОМ,
Dialogue: 0,0:09:21.46,0:09:24.18,Caption,,0,0,0,,ПУСТЯТ ЕВРОПЕЙЦЕВ ЗА СТОЛ ИЛИ НЕ ПУСТЯТ. НУ
Dialogue: 0,0:09:24.18,0:09:26.74,Caption,,0,0,0,,ВЫБЕРУТ ОДНОГО. ХОРОШО. ДАЛЬШЕ ЧТО?
Dialogue: 0,0:09:26.98,0:09:30.10,Caption,,0,0,0,,ЧТО ЭТОТ ЧЕЛОВЕК ПРИНЕСЁТ? НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ?
Dialogue: 0,0:09:30.26,0:09:32.02,Caption,,0,0,0,,СОГЛАСИЕ НА РОССИЙСКИЕ ТРЕБОВАНИЯ?
Dialogue: 0,0:09:32.25,0:09:35.46,Caption,,0,0,0,,ДРУГУЮ МОДЕЛЬ УКРАИНЫ? ИЛИ ПРОСТО ЕЩЁ ОДИН СТУЛ ПОСТАВЯТ?
Dialogue: 0,0:09:35.57,0:09:38.10,Caption,,0,0,0,,ПОТОМУ ЧТО СТУЛ ЭТО ЕЩЁ НЕ ПОЗИЦИЯ. САМОЕ
Dialogue: 0,0:09:38.10,0:09:41.54,Caption,,0,0,0,,ИНТЕРЕСНОЕ, ЧТО АМЕРИКАНЦЫ И РОССИЯНЕ СЕЙЧАС ВООБЩЕ ГОВОРЯТ О
Dialogue: 0,0:09:41.54,0:09:47.74,Caption,,0,0,0,,ВОПРОСЕ ШИРЕ САМОЙ УКРАИНЫ. В АБУ ДАБИ ОБСУЖДАЛАСЬ БУДУЩАЯ АРХИТЕКТУРА
Dialogue: 0,0:09:47.74,0:09:51.02,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. МОСКВА СНОВА ПОДНИМАЕТ
Dialogue: 0,0:09:51.10,0:09:53.98,Caption,,0,0,0,,ТЕМУ ДОЛГОСРОЧНЫХ ГАРАНТИЙ И ПРЕДЛАГАЕТ ВАРИАНТЫ
Dialogue: 0,0:09:53.98,0:09:56.38,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ С ЕВРОПЕЙСКИМИ ГОСУДАРСТВАМИ,
Dialogue: 0,0:09:56.49,0:09:58.14,Caption,,0,0,0,,ВПЛОТЬ ДО ПАКТОВ О НЕНАПАДЕНИИ.
Dialogue: 0,0:09:58.70,0:10:00.86,Caption,,0,0,0,,ВАШИНГТОН ЭТОТ РАЗГОВОР УЖЕ НЕ ОТБРАСЫВАЕТ
Dialogue: 0,0:10:00.86,0:10:04.14,Caption,,0,0,0,,АВТОМАТИЧЕСКИ. И ВОТ ТУТ УКРАИНА СТАНОВИТСЯ НЕ ВСЕЙ
Dialogue: 0,0:10:04.14,0:10:08.06,Caption,,0,0,0,,КАРТИНОЙ, А ЧАСТЬЮ КАРТИНЫ. ПОТОМУ ЧТО ЕСЛИ РОССИЯ ГОВОРИТ,
Dialogue: 0,0:10:08.38,0:10:10.78,Caption,,0,0,0,,ЧТО ПРИЧИНЫ КОНФЛИКТА ЛЕЖАТ В УСТРОЙСТВЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:10:10.78,0:10:14.62,Caption,,0,0,0,,БЕЗОПАСНОСТИ, РАСШИРЕНИИ НАТО И ВОЕННОМ ПОЛОЖЕНИИ УКРАИНЫ,
Dialogue: 0,0:10:15.08,0:10:17.34,Caption,,0,0,0,,ТО ПРОСТО ДАТЬ КИЕВУ БУМАГУ С КРАСИВЫМ СЛОВОМ
Dialogue: 0,0:10:17.34,0:10:20.22,Caption,,0,0,0,,"ГАРАНТИИ" НЕДОСТАТОЧНО. НУЖНО ПОНИМАТЬ,
Dialogue: 0,0:10:20.39,0:10:24.38,Caption,,0,0,0,,ЧТО ГАРАНТИРУЮТ РОССИИ. ЧТО ГАРАНТИРУЮТ УКРАИНЕ. ЧТО
Dialogue: 0,0:10:24.38,0:10:27.50,Caption,,0,0,0,,ОБЯЗУЕТСЯ ДЕЛАТЬ ЕВРОПА. ЧТО ПЕРЕСТАЁТ ДЕЛАТЬ
Dialogue: 0,0:10:27.58,0:10:31.02,Caption,,0,0,0,,ЕВРОПА. КАКИМ ОСТАЁТСЯ УКРАИНСКОЕ ГОСУДАРСТВО. КАКИМ
Dialogue: 0,0:10:31.02,0:10:33.74,Caption,,0,0,0,,ОСТАЁТСЯ ЕГО ВОЕННЫЙ ПОТЕНЦИАЛ. И ВОТ ПОСЛЕ ЭТОГО
Dialogue: 0,0:10:33.74,0:10:37.98,Caption,,0,0,0,,УЖЕ МОЖНО СМОТРЕТЬ, ВЫПОЛНЕНЫ ЦЕЛИ ИЛИ НЕТ. А ПОКА ПОЛУЧАЕТСЯ ДОВОЛЬНО
Dialogue: 0,0:10:37.98,0:10:40.70,Caption,,0,0,0,,СМЕШНАЯ КОНСТРУКЦИЯ. РОССИЯ ГОВОРИТ ЦЕЛИ БУДУТ
Dialogue: 0,0:10:40.70,0:10:43.50,Caption,,0,0,0,,ДОСТИГНУТЫ. КИЕВ ГОВОРИТ ОСТАВЬТЕ НАМ ВОСЕМЬСОТ
Dialogue: 0,0:10:43.58,0:10:45.74,Caption,,0,0,0,,ТЫСЯЧ ВОЕННЫХ И ФИНАНСИРУЙТЕ ИХ ДЕСЯТЬ ЛЕТ.
Dialogue: 0,0:10:46.13,0:10:48.38,Caption,,0,0,0,,ТЕРРИТОРИИ ПРЕДЛАГАЮТ ПОПРАВИТЬ АДМИНИСТРАТИВНЫМ
Dialogue: 0,0:10:48.38,0:10:51.74,Caption,,0,0,0,,КАРАНДАШОМ. ЕВРОПУ ХОТЯТ ПОСАДИТЬ ЗА СТОЛ. ГАРАНТИИ
Dialogue: 0,0:10:51.74,0:10:53.90,Caption,,0,0,0,,ОБСУЖДАЮТ. И ВСЕ РАССКАЗЫВАЮТ,
Dialogue: 0,0:10:54.07,0:10:57.34,Caption,,0,0,0,,ЧТО ЕСТЬ ПРОГРЕСС. НУ ПРЕКРАСНО. ТОЛЬКО ГДЕ ИМЕННО
Dialogue: 0,0:10:57.42,0:11:03.14,Caption,,0,0,0,,ОН НАХОДИТСЯ? ПОТОМУ ЧТО ПО ТЕРРИТОРИЯМ ПУБЛИЧНОГО СОГЛАШЕНИЯ НЕТ.
Dialogue: 0,0:11:03.46,0:11:06.10,Caption,,0,0,0,,ПО БУДУЩЕМУ РАЗМЕРУ УКРАИНСКОЙ АРМИИ РАЗРЫВ МЕЖДУ
Dialogue: 0,0:11:06.10,0:11:08.34,Caption,,0,0,0,,ПРЕЖНИМ РОССИЙСКИМ ПРЕДЛОЖЕНИЕМ И НЫНЕШНИМ
Dialogue: 0,0:11:08.42,0:11:11.30,Caption,,0,0,0,,УКРАИНСКИМ ЗАПРОСОМ ГИГАНТСКИЙ. ПО ПОЛИТИЧЕСКОМУ
Dialogue: 0,0:11:11.30,0:11:14.26,Caption,,0,0,0,,УСТРОЙСТВУ ПОСЛЕВОЕННОЙ УКРАИНЫ ЯСНОСТИ НЕТ. ПО
Dialogue: 0,0:11:14.26,0:11:16.74,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ СИСТЕМЕ БЕЗОПАСНОСТИ РАЗГОВОР ТОЛЬКО
Dialogue: 0,0:11:16.74,0:11:19.38,Caption,,0,0,0,,НАЧАЛСЯ. И ВОТ МЫ С ВАМИ СНОВА ОКАЗАЛИСЬ
Dialogue: 0,0:11:19.46,0:11:21.86,Caption,,0,0,0,,ПРАВЫ. ГЛАВНЫЙ БАРОМЕТР ПЕРЕГОВОРОВ,
Dialogue: 0,0:11:22.08,0:11:27.22,Caption,,0,0,0,,НЕ КРАСИВЫЕ ЗАЯВЛЕНИЯ, А ВЫПОЛНЕНИЕ ЗАЯВЛЕННЫХ ЦЕЛЕЙ МОСКВЫ. ИМЕННО ПО НЕМУ
Dialogue: 0,0:11:27.30,0:11:29.62,Caption,,0,0,0,,МЫ И ПРОВЕРЯЕМ РЕЗУЛЬТАТ. НЕ НАДО СМОТРЕТЬ НА
Dialogue: 0,0:11:29.62,0:11:32.02,Caption,,0,0,0,,ПЕРЕГОВОРЫ КАК НА ФУТБОЛЬНЫЙ МАТЧ. СЕГОДНЯ
Dialogue: 0,0:11:32.02,0:11:35.14,Caption,,0,0,0,,ВСТРЕТИЛИСЬ, ЗНАЧИТ ПЛЮС ОДИН. ЗАВТРА УЛЫБНУЛИСЬ,
Dialogue: 0,0:11:35.36,0:11:38.02,Caption,,0,0,0,,ЕЩЁ ПЛЮС ОДИН. ПОСЛЕЗАВТРА ДОГОВОРИЛИСЬ СНОВА
Dialogue: 0,0:11:38.02,0:11:42.50,Caption,,0,0,0,,ПОГОВОРИТЬ, УЖЕ ПОЧТИ ПОБЕДА. НЕТ. ЕСТЬ УСЛОВИЯ. ЕСТЬ
Dialogue: 0,0:11:42.50,0:11:46.18,Caption,,0,0,0,,ТРЕБОВАНИЯ. ЕСТЬ СОДЕРЖАНИЕ БУДУЩЕГО СОГЛАШЕНИЯ. ВОТ
Dialogue: 0,0:11:46.26,0:11:48.50,Caption,,0,0,0,,ЭТО И ЕСТЬ БАРОМЕТР. МОСКВА НЕ ГОВОРИТ,
Dialogue: 0,0:11:48.72,0:11:51.62,Caption,,0,0,0,,ЧТО ОТКАЗАЛАСЬ ОТ ЗАЯВЛЕННЫХ ЦЕЛЕЙ. ЗНАЧИТ МЫ БЕРЁМ
Dialogue: 0,0:11:51.70,0:11:56.42,Caption,,0,0,0,,ЭТИ ЦЕЛИ И СВЕРЯЕМ С ТЕМ, ЧТО ПОЯВЛЯЕТСЯ НА СТОЛЕ. ДЕМИЛИТАРИЗАЦИЯ?
Dialogue: 0,0:11:56.48,0:12:01.54,Caption,,0,0,0,,ВОСЕМЬСОТ ТЫСЯЧ. ТЕРРИТОРИИ? СОГЛАСИЯ НЕТ. ПОЛИТИЧЕСКИЙ КУРС БУДУЩЕЙ УКРАИНЫ?
Dialogue: 0,0:12:01.75,0:12:04.26,Caption,,0,0,0,,НЕЯСЕН. НОВАЯ СИСТЕМА БЕЗОПАСНОСТИ?
Dialogue: 0,0:12:04.34,0:12:07.38,Caption,,0,0,0,,ОБСУЖДАЕТСЯ. И ПОСЛЕ ЭТОГО КАЖДЫЙ САМ МОЖЕТ ОТВЕТИТЬ
Dialogue: 0,0:12:07.46,0:12:10.90,Caption,,0,0,0,,НА ВОПРОС, НАСКОЛЬКО ДАЛЕКО ПРОДВИНУЛИСЬ ПЕРЕГОВОРЫ. ПОТОМУ ЧТО
Dialogue: 0,0:12:10.90,0:12:12.58,Caption,,0,0,0,,ПОДПИСАТЬ БУМАГУ МОЖНО БЫСТРО.
Dialogue: 0,0:12:14.87,0:12:16.87,Caption,,0,0,0,,САМОЕ СЛОЖНОЕ НАЧИНАЕТСЯ ТОГДА,
Dialogue: 0,0:12:17.11,0:12:21.43,Caption,,0,0,0,,КОГДА НАДО РЕШИТЬ, ЧТО ИМЕННО БУДЕТ НАПИСАНО МЕЛКИМ ШРИФТОМ. А ТАМ
Dialogue: 0,0:12:21.43,0:12:24.31,Caption,,0,0,0,,ПОКА, СУДЯ ПО ВСЕМУ, И ЛЕЖИТ ВСЯ ИСТОРИЯ.
