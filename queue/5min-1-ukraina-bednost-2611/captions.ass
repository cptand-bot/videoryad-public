Dialogue: 0,0:00:00.12,0:00:03.38,Caption,,0,0,0,,СУДЯ ПО СЛОВАМ МЕРЦА, УКРАИНСКОЙ ЭКОНОМИКЕ СЕЙЧАС ВПОРУ
Dialogue: 0,0:00:03.38,0:00:06.52,Caption,,0,0,0,,ЗАВИДОВАТЬ ДАЖЕ НЕМЦАМ. ВОТ ТОЛЬКО ХОТЕЛОСЬ БЫ ПОНЯТЬ,
Dialogue: 0,0:00:06.76,0:00:09.04,Caption,,0,0,0,,ЧТО ИМЕННО ВЫЗЫВАЕТ ТАКУЮ ЗАВИСТЬ.
Dialogue: 0,0:00:09.04,0:00:11.75,Caption,,0,0,0,,ВЕДЬ ОБ УСПЕХАХ ЭКОНОМИКИ ОБЫЧНО РАССКАЗЫВАЮТ НЕ
Dialogue: 0,0:00:11.75,0:00:15.72,Caption,,0,0,0,,ТОЛЬКО ПОЛИТИКИ, НО И ЛЮДИ, КОТОРЫЕ В ЭТОЙ ЭКОНОМИКЕ ЖИВУТ. И У
Dialogue: 0,0:00:15.72,0:00:17.40,Caption,,0,0,0,,НИХ, СУДЯ ПО ПОСЛЕДНИМ ДАННЫМ,
Dialogue: 0,0:00:17.65,0:00:19.46,Caption,,0,0,0,,НЕСКОЛЬКО ИНОЕ ПОНИМАНИЕ СЛОВА
Dialogue: 0,0:00:19.46,0:00:22.36,Caption,,0,0,0,,"УСПЕХ". ТАК ЧТО ЖЕ ТАКОГО УВИДЕЛ НЕМЕЦКИЙ КАНЦЛЕР,
Dialogue: 0,0:00:22.60,0:00:24.36,Caption,,0,0,0,,ЧЕГО НЕ ЗАМЕЧАЮТ САМИ УКРАИНЦЫ?
Dialogue: 0,0:00:25.00,0:00:28.21,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ, КОГДА КРАСИВЫЕ ПОЛИТИЧЕСКИЕ ЗАЯВЛЕНИЯ
Dialogue: 0,0:00:28.21,0:00:32.01,Caption,,0,0,0,,ПРОВЕРЯЮТ ОБЫЧНЫМИ ЦИФРАМИ, ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ЗДЕСЬ
Dialogue: 0,0:00:32.01,0:00:33.72,Caption,,0,0,0,,ЦИФРЫ СЕЙЧАС БУДУТ ОЧЕНЬ КСТАТИ.
Dialogue: 0,0:00:34.58,0:00:37.14,Caption,,0,0,0,,ФРИДРИХ МЕРЦ УДИВЛЯЕТСЯ. НЕСМОТРЯ НА
Dialogue: 0,0:00:37.14,0:00:39.16,Caption,,0,0,0,,ВОЙНУ, КОТОРАЯ ДЛИТСЯ УЖЕ ПЯТЫЙ ГОД,
Dialogue: 0,0:00:39.48,0:00:41.47,Caption,,0,0,0,,УКРАИНСКАЯ ЭКОНОМИКА СТАБИЛЬНО РАСТЁТ
Dialogue: 0,0:00:41.47,0:00:44.28,Caption,,0,0,0,,С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ТРЕТЬЕГО ГОДА. В ОТЛИЧИЕ,
Dialogue: 0,0:00:44.44,0:00:47.16,Caption,,0,0,0,,МЕЖДУ ПРОЧИМ, ОТ НЕМЕЦКОЙ. ВОТ КАКОЙ,
Dialogue: 0,0:00:47.30,0:00:50.52,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, РОСТ ПРОИСХОДИТ. Я ВОТ ТОЛЬКО ОДНОГО
Dialogue: 0,0:00:50.52,0:00:52.60,Caption,,0,0,0,,ПОНЯТЬ НЕ МОГУ. ГОСПОДИН КАНЦЛЕР,
Dialogue: 0,0:00:52.81,0:00:56.01,Caption,,0,0,0,,ВЫ КАКИЕ ОТЧЁТЫ СМОТРЕЛИ? ПОТОМУ ЧТО МЕРЦ ЖИВЁТ В КАКОМ ТО
Dialogue: 0,0:00:56.01,0:00:58.68,Caption,,0,0,0,,СОВЕРШЕННО ДРУГОМ МИРЕ. И САМОЕ СМЕШНОЕ,
Dialogue: 0,0:00:59.00,0:01:00.83,Caption,,0,0,0,,ЧТО НАМ ДАЖЕ НЕ НАДО СЕЙЧАС ОТКРЫВАТЬ
Dialogue: 0,0:01:00.83,0:01:02.44,Caption,,0,0,0,,КАКИЕ НИБУДЬ РОССИЙСКИЕ ОТЧЁТЫ,
Dialogue: 0,0:01:02.60,0:01:04.56,Caption,,0,0,0,,ЧТОБЫ СПОРИТЬ С НЕМЕЦКИМ КАНЦЛЕРОМ.
Dialogue: 0,0:01:04.56,0:01:07.74,Caption,,0,0,0,,ДАВАЙТЕ ВОЗЬМЁМ ВСЕМИРНЫЙ БАНК. МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ
Dialogue: 0,0:01:07.74,0:01:11.16,Caption,,0,0,0,,ФОНД. ОРГАНИЗАЦИИ, КОТОРЫМ В ЕВРОПЕ ВРОДЕ БЫ ДОВЕРЯЮТ.
Dialogue: 0,0:01:13.45,0:01:16.31,Caption,,0,0,0,,И ПОСМОТРИМ, КАК ВЫГЛЯДИТ ЭТА ЛЕТЯЩАЯ ВВЕРХ
Dialogue: 0,0:01:16.31,0:01:18.81,Caption,,0,0,0,,ЭКОНОМИКА УЖЕ НЕ С ТРИБУНЫ, А СНИЗУ.
Dialogue: 0,0:01:19.36,0:01:21.43,Caption,,0,0,0,,СОРОК ОДИН ПРОЦЕНТ УКРАИНЦЕВ ЖИВЁТ ЗА
Dialogue: 0,0:01:21.43,0:01:23.60,Caption,,0,0,0,,ЧЕРТОЙ БЕДНОСТИ. ШЕСТЬДЕСЯТ ПРОЦЕНТОВ
Dialogue: 0,0:01:23.60,0:01:26.49,Caption,,0,0,0,,ДОМОХОЗЯЙСТВ ГОВОРЯТ, ЧТО ИХ ПОЛОЖЕНИЕ ХУЖЕ,
Dialogue: 0,0:01:26.57,0:01:28.19,Caption,,0,0,0,,ЧЕМ ДО ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:01:28.19,0:01:31.13,Caption,,0,0,0,,ВТОРОГО ГОДА. У ДВАДЦАТИ ШЕСТИ ПРОЦЕНТОВ СЕМЕЙ
Dialogue: 0,0:01:31.13,0:01:33.84,Caption,,0,0,0,,ВООБЩЕ НЕТ СБЕРЕЖЕНИЙ. А СРЕДИ САМЫХ БЕДНЫХ
Dialogue: 0,0:01:33.84,0:01:37.22,Caption,,0,0,0,,ДОМОХОЗЯЙСТВ ТАКИХ УЖЕ ТРИДЦАТЬ ПЯТЬ ПРОЦЕНТОВ. ПОЧТИ
Dialogue: 0,0:01:37.22,0:01:39.89,Caption,,0,0,0,,КАЖДАЯ ЧЕТВЁРТАЯ МАЛООБЕСПЕЧЕННАЯ СЕМЬЯ НЕДАВНО
Dialogue: 0,0:01:39.89,0:01:43.38,Caption,,0,0,0,,ИСПЫТЫВАЛА ПРОБЛЕМЫ С ОПЛАТОЙ КОММУНАЛЬНЫХ УСЛУГ. ДОХОДЫ ОТ
Dialogue: 0,0:01:43.38,0:01:45.45,Caption,,0,0,0,,СЕЛЬСКОГО ХОЗЯЙСТВА ЗА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:01:45.45,0:01:48.28,Caption,,0,0,0,,ШЕСТОЙ ГОД СОКРАТИЛИСЬ НА ТРИНАДЦАТЬ ПРОЦЕНТОВ.
Dialogue: 0,0:01:48.28,0:01:50.29,Caption,,0,0,0,,ОТ ПРЕДПРИНИМАТЕЛЬСТВА И САМОЗАНЯТОСТИ НА
Dialogue: 0,0:01:50.29,0:01:53.13,Caption,,0,0,0,,ДЕВЯТНАДЦАТЬ ПРОЦЕНТОВ. И ОТДЕЛЬНО ОТМЕЧАЕТСЯ,
Dialogue: 0,0:01:53.37,0:01:55.49,Caption,,0,0,0,,ЧТО ПРОБЛЕМЫ С ПСИХИЧЕСКИМ СОСТОЯНИЕМ
Dialogue: 0,0:01:55.49,0:01:58.61,Caption,,0,0,0,,НАСЕЛЕНИЯ ОСТАЮТСЯ НА ВЫСОКОМ УРОВНЕ. ВОТ ТАКАЯ
Dialogue: 0,0:01:58.61,0:02:01.69,Caption,,0,0,0,,ОНА, ЭКОНОМИКА, КОТОРАЯ, ПО СЛОВАМ МЕРЦА,
Dialogue: 0,0:02:01.85,0:02:03.91,Caption,,0,0,0,,СТАБИЛЬНО РАСТЁТ. ОЧЕНЬ ХОЧЕТСЯ
Dialogue: 0,0:02:03.91,0:02:06.65,Caption,,0,0,0,,ПОЗНАКОМИТЬ ГОСПОДИНА КАНЦЛЕРА С ЭТИМИ ЦИФРАМИ.
Dialogue: 0,0:02:06.65,0:02:09.38,Caption,,0,0,0,,ПОТОМУ ЧТО ЭТО НЕ РОССИЙСКАЯ ПРОПАГАНДА. ЭТО
Dialogue: 0,0:02:09.38,0:02:11.53,Caption,,0,0,0,,ВСЕМИРНЫЙ БАНК. ВЫ ЖЕ ЕМУ ДОВЕРЯЕТЕ?
Dialogue: 0,0:02:12.08,0:02:14.01,Caption,,0,0,0,,ТОГДА КАКОЙ ИМЕННО РОСТ ВЫ УВИДЕЛИ?
Dialogue: 0,0:02:14.56,0:02:16.42,Caption,,0,0,0,,РОСТ ПОКАЗАТЕЛЕЙ НА БУМАГЕ И РОСТ
Dialogue: 0,0:02:16.42,0:02:19.05,Caption,,0,0,0,,БЛАГОСОСТОЯНИЯ ЛЮДЕЙ, КАК ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:02:19.13,0:02:21.00,Caption,,0,0,0,,ВЕЩИ СОВЕРШЕННО РАЗНЫЕ. ПРИЧЁМ
Dialogue: 0,0:02:21.00,0:02:23.21,Caption,,0,0,0,,ЭКОНОМИКА ЭТА РАСТЁТ НЕ САМА ПО СЕБЕ.
Dialogue: 0,0:02:25.49,0:02:27.69,Caption,,0,0,0,,ЕВРОСОЮЗ УЖЕ ИЩЕТ СПОСОБ ОБЕСПЕЧИТЬ
Dialogue: 0,0:02:27.69,0:02:30.20,Caption,,0,0,0,,УКРАИНЕ СТАБИЛЬНОЕ ФИНАНСИРОВАНИЕ ДО КОНЦА ДВЕ
Dialogue: 0,0:02:30.20,0:02:31.86,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА.
Dialogue: 0,0:02:31.86,0:02:35.38,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНАЯ ПОТРЕБНОСТЬ СОСТАВЛЯЕТ ОКОЛО СЕМИДЕСЯТИ МИЛЛИАРДОВ
Dialogue: 0,0:02:35.38,0:02:38.22,Caption,,0,0,0,,ЕВРО. ЕВРОКОМИССИЯ ПРЕДЛАГАЕТ ПРИВЛЕЧЬ СОРОК
Dialogue: 0,0:02:38.22,0:02:40.55,Caption,,0,0,0,,ПЯТЬ МИЛЛИАРДОВ ЧЕРЕЗ НОВЫЕ ЗАИМСТВОВАНИЯ.
Dialogue: 0,0:02:40.55,0:02:43.17,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО РАССМАТРИВАЕТСЯ ИСПОЛЬЗОВАНИЕ ДВУХСОТ
Dialogue: 0,0:02:43.17,0:02:45.10,Caption,,0,0,0,,ДЕСЯТИ МИЛЛИАРДОВ ЕВРО ЗАМОРОЖЕННЫХ
Dialogue: 0,0:02:45.10,0:02:48.82,Caption,,0,0,0,,РОССИЙСКИХ АКТИВОВ. ОКОНЧАТЕЛЬНОГО МЕХАНИЗМА ПОКА НЕТ. И В
Dialogue: 0,0:02:48.82,0:02:50.93,Caption,,0,0,0,,БРЮССЕЛЕ УЖЕ СМОТРЯТ НЕ ТОЛЬКО НА КИЕВ,
Dialogue: 0,0:02:51.22,0:02:53.16,Caption,,0,0,0,,НО И НА СОБСТВЕННУЮ ПОЛИТИЧЕСКУЮ
Dialogue: 0,0:02:53.16,0:02:55.98,Caption,,0,0,0,,КУХНЮ. ВЫБОРЫ ВО ФРАНЦИИ И ГЕРМАНИИ ТОЖЕ СПОСОБНЫ
Dialogue: 0,0:02:55.98,0:02:58.67,Caption,,0,0,0,,ПОВЛИЯТЬ НА ДАЛЬНЕЙШЕЕ ФИНАНСИРОВАНИЕ. ТО ЕСТЬ
Dialogue: 0,0:02:58.67,0:03:01.11,Caption,,0,0,0,,КАРТИНА ИНТЕРЕСНАЯ. ЭКОНОМИКА СТАБИЛЬНО
Dialogue: 0,0:03:01.11,0:03:04.45,Caption,,0,0,0,,РАСТЁТ, НО ДЛЯ ТОГО, ЧТОБЫ ОНА ПРОДОЛЖАЛА ФУНКЦИОНИРОВАТЬ,
Dialogue: 0,0:03:04.74,0:03:07.02,Caption,,0,0,0,,УЖЕ СЕЙЧАС ИЩУТ ДЕСЯТКИ МИЛЛИАРДОВ НА
Dialogue: 0,0:03:07.02,0:03:09.94,Caption,,0,0,0,,СЛЕДУЮЩИЕ ГОДЫ. ТУТ ПОНЕВОЛЕ ВСПОМИНАЕТСЯ ТЕОРИЯ
Dialogue: 0,0:03:09.94,0:03:12.72,Caption,,0,0,0,,СООБЩАЮЩИХСЯ СОСУДОВ. В ОДНОМ МЕСТЕ ДЕНЬГИ
Dialogue: 0,0:03:12.72,0:03:15.49,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ, В ДРУГОМ ИХ НАДО СНАЧАЛА ЗАНЯТЬ.
Dialogue: 0,0:03:16.10,0:03:18.12,Caption,,0,0,0,,И АППЕТИТ К ЕВРОПЕЙСКОМУ БЮДЖЕТУ ТОЖЕ
Dialogue: 0,0:03:18.12,0:03:20.45,Caption,,0,0,0,,ВСТРЕЧАЕТ СОПРОТИВЛЕНИЕ. ПЯТЬ СТРАН НЕ
Dialogue: 0,0:03:20.45,0:03:23.17,Caption,,0,0,0,,ПОДДЕРЖАЛИ ПРОЕКТ НОВОГО БЮДЖЕТА ЕВРОСОЮЗА,
Dialogue: 0,0:03:23.49,0:03:25.35,Caption,,0,0,0,,ГДЕ ДЛЯ УКРАИНЫ ПРЕДУСМОТРЕНО СТО
Dialogue: 0,0:03:25.35,0:03:28.16,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО НА ПЕРИОД С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО
Dialogue: 0,0:03:28.16,0:03:30.77,Caption,,0,0,0,,ПО ДВЕ ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ ГОД. ПОЛЬША,
Dialogue: 0,0:03:30.88,0:03:34.05,Caption,,0,0,0,,ЧЕХИЯ, ВЕНГРИЯ, СЛОВАКИЯ И АВСТРИЯ.
Dialogue: 0,0:03:36.26,0:03:39.93,Caption,,0,0,0,,РОБЕРТ ФИЦО ЗАЯВИЛ, ЧТО ТАКОЙ ПРОЕКТ НЕПРИЕМЛЕМ ДЛЯ ВСЕХ
Dialogue: 0,0:03:39.93,0:03:42.09,Caption,,0,0,0,,ПЯТИ ГОСУДАРСТВ. АНДРЕЙ БАБИШ ВООБЩЕ
Dialogue: 0,0:03:42.09,0:03:45.15,Caption,,0,0,0,,ПРЕДЛОЖИЛ ВЫНЕСТИ УКРАИНСКОЕ ФИНАНСИРОВАНИЕ ЗА ПРЕДЕЛЫ
Dialogue: 0,0:03:45.15,0:03:48.76,Caption,,0,0,0,,ОБЩЕГО БЮДЖЕТА ЕВРОСОЮЗА. ЛОГИКА У ЭТИХ СТРАН СВОЯ И
Dialogue: 0,0:03:48.76,0:03:51.11,Caption,,0,0,0,,ОЧЕНЬ ПРОСТАЯ. СНАЧАЛА ФИНАНСИРОВАТЬ
Dialogue: 0,0:03:51.11,0:03:54.64,Caption,,0,0,0,,СОБСТВЕННЫЕ РЕГИОНЫ И СОБСТВЕННОЕ СЕЛЬСКОЕ ХОЗЯЙСТВО. И ВОТ
Dialogue: 0,0:03:54.64,0:03:56.50,Caption,,0,0,0,,ТУТ СТАНОВИТСЯ ОСОБЕННО ИНТЕРЕСНО,
Dialogue: 0,0:03:56.82,0:03:58.35,Caption,,0,0,0,,ПОТОМУ ЧТО УКРАИНСКОЕ СЕЛЬСКОЕ
Dialogue: 0,0:03:58.35,0:04:01.40,Caption,,0,0,0,,ХОЗЯЙСТВО КАК РАЗ НАЧИНАЕТ ПОДАВАТЬ СОВСЕМ НЕХОРОШИЕ
Dialogue: 0,0:04:01.40,0:04:04.49,Caption,,0,0,0,,СИГНАЛЫ. УРОЖАЙ У ФЕРМЕРОВ ЕСТЬ. ТОЛЬКО ПРОДАТЬ ЕГО
Dialogue: 0,0:04:04.49,0:04:07.91,Caption,,0,0,0,,ВОВРЕМЯ СТАНОВИТСЯ ВСЁ СЛОЖНЕЕ. КРЕДИТЫ ПРИ ЭТОМ НИКТО НЕ
Dialogue: 0,0:04:07.91,0:04:10.24,Caption,,0,0,0,,ОТМЕНЯЛ И НЕ ПЕРЕНЁС. ЕЩЁ РАНЬШЕ ЗВУЧАЛИ
Dialogue: 0,0:04:10.24,0:04:13.21,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЯ, ЧТО ЧАСТЬ ХОЗЯЙСТВ РИСКУЕТ ОСТАТЬСЯ
Dialogue: 0,0:04:13.21,0:04:15.98,Caption,,0,0,0,,БЕЗ ДЕНЕГ НА СЛЕДУЮЩУЮ ПОСЕВНУЮ. ГЛАВА "НИБУЛОНА"
Dialogue: 0,0:04:15.98,0:04:19.76,Caption,,0,0,0,,АНДРЕЙ ВАДАТУРСКИЙ ГОВОРИТ, ЧТО ПРИ СОХРАНЕНИИ НЫНЕШНИХ УСЛОВИЙ
Dialogue: 0,0:04:19.76,0:04:21.93,Caption,,0,0,0,,ПЕРВЫЕ БАНКРОТСТВА КРУПНЫХ АГРАРИЕВ МОГУТ
Dialogue: 0,0:04:21.93,0:04:24.33,Caption,,0,0,0,,НАЧАТЬСЯ УЖЕ ВЕСНОЙ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО
Dialogue: 0,0:04:24.33,0:04:27.52,Caption,,0,0,0,,ГОДА. ПРИЧИНА ОЧЕНЬ ПРИЗЕМЛЁННАЯ. ИЗ ЗА АТАК
Dialogue: 0,0:04:27.52,0:04:30.42,Caption,,0,0,0,,В ЧЁРНОМ МОРЕ ЗЕРНО СКАПЛИВАЕТСЯ ВНУТРИ СТРАНЫ.
Dialogue: 0,0:04:30.42,0:04:33.41,Caption,,0,0,0,,ЗАКУПОЧНЫЕ ЦЕНЫ ПАДАЮТ. БАНКИ ВСЁ МЕНЕЕ ОХОТНО
Dialogue: 0,0:04:33.41,0:04:35.78,Caption,,0,0,0,,КРЕДИТУЮТ ПРОИЗВОДИТЕЛЕЙ. А ВЛАСТЬ,
Dialogue: 0,0:04:35.90,0:04:39.87,Caption,,0,0,0,,СУДЯ ПО ЭТИМ СООБЩЕНИЯМ, НЕ ТОРОПИТСЯ ПОМОГАТЬ ФЕРМЕРАМ С НОВОЙ
Dialogue: 0,0:04:39.87,0:04:42.26,Caption,,0,0,0,,ПОСЕВНОЙ. А ВЕСНОЙ ФЕРМЕРУ ПРИДЁТСЯ ВЫБИРАТЬ,
Dialogue: 0,0:04:42.50,0:04:44.43,Caption,,0,0,0,,КУДА ОТПРАВИТЬ ДЕНЬГИ ОТ ПРОДАННОГО
Dialogue: 0,0:04:44.43,0:04:49.02,Caption,,0,0,0,,УРОЖАЯ. ПОГАСИТЬ КРЕДИТ ИЛИ КУПИТЬ ДИЗЕЛЬ,
Dialogue: 0,0:04:49.10,0:04:51.19,Caption,,0,0,0,,СЕМЕНА И УДОБРЕНИЯ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:04:51.19,0:04:54.26,Caption,,0,0,0,,ПРЯЧЕТСЯ ВЕЩЬ ГОРАЗДО СЕРЬЁЗНЕЕ ОЧЕРЕДНОЙ ПЛОХОЙ
Dialogue: 0,0:04:54.26,0:04:56.86,Caption,,0,0,0,,СТАТИСТИКИ. В МЕТАЛЛУРГИИ ПОТЕРИ УЖЕ МОЖНО
Dialogue: 0,0:04:56.86,0:04:59.26,Caption,,0,0,0,,ПОСЧИТАТЬ. ВЫПЛАВКА СТАЛИ ОСТАНОВИЛАСЬ,
Dialogue: 0,0:04:59.50,0:05:01.25,Caption,,0,0,0,,И ПОСЛЕДСТВИЯ ВИДНЫ СРАЗУ. А В
Dialogue: 0,0:05:01.25,0:05:04.62,Caption,,0,0,0,,СЕЛЬСКОМ ХОЗЯЙСТВЕ ЭФФЕКТ ПРИХОДИТ С ЗАДЕРЖКОЙ. ЗЕРНО,
Dialogue: 0,0:05:04.70,0:05:08.25,Caption,,0,0,0,,КОТОРОЕ УЖЕ ЛЕЖИТ НА СКЛАДЕ, ЕЩЁ МОЖНО ПРОДАТЬ ЧЕРЕЗ МЕСЯЦ ИЛИ
Dialogue: 0,0:05:08.25,0:05:11.18,Caption,,0,0,0,,ЧЕРЕЗ ПОЛГОДА. НО ЕСЛИ ВЕСНОЙ ПОЛЕ НЕ ЗАСЕЯЛИ,
Dialogue: 0,0:05:11.43,0:05:13.99,Caption,,0,0,0,,ОСЕНЬЮ ОТТУДА УЖЕ НЕЧЕГО ВЕЗТИ В ПОРТ.
Dialogue: 0,0:05:13.99,0:05:15.99,Caption,,0,0,0,,И НИКАКОЕ ВОССТАНОВЛЕНИЕ ЭКСПОРТА ПОТОМ
Dialogue: 0,0:05:15.99,0:05:18.48,Caption,,0,0,0,,НЕ ВЕРНЁТ ПРОПУЩЕННЫЙ УРОЖАЙ. НЕ ВЕРНЁТ И
Dialogue: 0,0:05:18.48,0:05:22.04,Caption,,0,0,0,,ВАЛЮТНУЮ ВЫРУЧКУ, КОТОРОЙ ПРОСТО НЕ БЫЛО. ВОТ ВАМ ЕЩЁ
Dialogue: 0,0:05:22.04,0:05:23.76,Caption,,0,0,0,,ОДНА СТОРОНА ЭТОГО ЗАМЕЧАТЕЛЬНОГО
Dialogue: 0,0:05:23.76,0:05:27.09,Caption,,0,0,0,,ЭКОНОМИЧЕСКОГО РОСТА. НО ДАЛЬШЕ НАЧИНАЕТСЯ УЖЕ СОВСЕМ
Dialogue: 0,0:05:27.09,0:05:30.42,Caption,,0,0,0,,ВЕСЁЛАЯ АРИФМЕТИКА. ПОЧТИ ПОЛОВИНА СТРАНЫ НАХОДИТСЯ ЗА
Dialogue: 0,0:05:30.42,0:05:33.67,Caption,,0,0,0,,ЧЕРТОЙ БЕДНОСТИ. У МИЛЛИОНОВ ЛЮДЕЙ НЕТ СБЕРЕЖЕНИЙ.
Dialogue: 0,0:05:33.67,0:05:36.67,Caption,,0,0,0,,КАЖДАЯ ЧЕТВЁРТАЯ БЕДНАЯ СЕМЬЯ УЖЕ ИСПЫТЫВАЕТ ПРОБЛЕМЫ С
Dialogue: 0,0:05:36.67,0:05:39.58,Caption,,0,0,0,,КОММУНАЛЬНЫМИ ПЛАТЕЖАМИ. И В ЭТОТ МОМЕНТ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:05:39.58,0:05:42.02,Caption,,0,0,0,,ВОПРОС О РЕЗКОМ ПОВЫШЕНИИ ТАРИФОВ. В
Dialogue: 0,0:05:42.02,0:05:45.19,Caption,,0,0,0,,РЕКОМЕНДАЦИЯХ МВФ ФИГУРИРУЮТ ДВА СЦЕНАРИЯ НА ПЕРИОД С
Dialogue: 0,0:05:45.19,0:05:47.17,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ПО ДВЕ ТЫСЯЧИ
Dialogue: 0,0:05:47.17,0:05:49.65,Caption,,0,0,0,,ДВАДЦАТЬ ДЕВЯТЫЙ ГОД. ПО РАДИКАЛЬНОМУ СЦЕНАРИЮ
Dialogue: 0,0:05:49.65,0:05:53.16,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ДОЛЖНО ПОДОРОЖАТЬ С ЧЕТЫРЁХ ГРИВЕН ТРИДЦАТИ
Dialogue: 0,0:05:53.16,0:05:56.11,Caption,,0,0,0,,ДВУХ КОПЕЕК ДО ДЕВЯТИ ГРИВЕН СЕМИДЕСЯТИ КОПЕЕК ЗА
Dialogue: 0,0:05:56.11,0:06:01.16,Caption,,0,0,0,,КИЛОВАТТ ЧАС. ГАЗ С СЕМИ ГРИВЕН ДЕВЯНОСТА ШЕСТИ
Dialogue: 0,0:06:01.16,0:06:04.03,Caption,,0,0,0,,КОПЕЕК ДО ДВАДЦАТИ ДВУХ ГРИВЕН ЗА КУБОМЕТР. ПО
Dialogue: 0,0:06:04.03,0:06:06.14,Caption,,0,0,0,,БОЛЕЕ УМЕРЕННОМУ СЦЕНАРИЮ ЭЛЕКТРИЧЕСТВО
Dialogue: 0,0:06:06.14,0:06:08.51,Caption,,0,0,0,,ПОДНИМАЕТСЯ ДО ШЕСТИ ГРИВЕН ДЕВЯТИ КОПЕЕК,
Dialogue: 0,0:06:08.83,0:06:11.07,Caption,,0,0,0,,А ГАЗ ДО СЕМНАДЦАТИ ГРИВЕН ДВАДЦАТИ
Dialogue: 0,0:06:11.07,0:06:13.55,Caption,,0,0,0,,КОПЕЕК. ТО ЕСТЬ ДАЖЕ УМЕРЕННЫЙ ВАРИАНТ ПОЧЕМУ ТО
Dialogue: 0,0:06:13.55,0:06:16.60,Caption,,0,0,0,,ВЫГЛЯДИТ ДОВОЛЬНО БОДРО. ОБЪЯСНЕНИЕ ТОЖЕ ЕСТЬ.
Dialogue: 0,0:06:16.60,0:06:19.34,Caption,,0,0,0,,ГОСУДАРСТВУ НАДО СОКРАЩАТЬ РАСХОДЫ БЮДЖЕТА.
Dialogue: 0,0:06:19.34,0:06:22.13,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИМ КОМПАНИЯМ НУЖНЫ ДЕНЬГИ НА РЕМОНТ.
Dialogue: 0,0:06:22.13,0:06:24.92,Caption,,0,0,0,,УКРАИНЕ ПРИХОДИТСЯ БОЛЬШЕ ЗАНИМАТЬ У ВНЕШНИХ ПАРТНЁРОВ
Dialogue: 0,0:06:24.92,0:06:27.39,Caption,,0,0,0,,ПРИ ГОСУДАРСТВЕННОМ ДОЛГЕ ПОЧТИ В СТО
Dialogue: 0,0:06:27.39,0:06:31.11,Caption,,0,0,0,,ПРОЦЕНТОВ ВВП. ИЗ ЗА НИЗКИХ ТАРИФОВ БЮДЖЕТ НЕДОПОЛУЧАЕТ
Dialogue: 0,0:06:31.11,0:06:34.96,Caption,,0,0,0,,НАЛОГИ. И, НАКОНЕЦ, В МЕМОРАНДУМЕ С МВФ ОТ ВТОРОГО ИЮЛЯ
Dialogue: 0,0:06:34.96,0:06:37.18,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО ГОДА УЖЕ
Dialogue: 0,0:06:37.18,0:06:39.62,Caption,,0,0,0,,СОДЕРЖИТСЯ ОБЯЗАТЕЛЬСТВО ПОВЫШАТЬ ТАРИФЫ НА
Dialogue: 0,0:06:39.62,0:06:41.77,Caption,,0,0,0,,ЖИЛИЩНО КОММУНАЛЬНЫЕ УСЛУГИ. СЕЙЧАС
Dialogue: 0,0:06:41.77,0:06:44.42,Caption,,0,0,0,,СУБСИДИРОВАНИЕ ЭНЕРГОНОСИТЕЛЕЙ ДОСТИГАЕТ ПОЧТИ
Dialogue: 0,0:06:44.42,0:06:47.70,Caption,,0,0,0,,ЧЕТЫРЁХ ПРОЦЕНТОВ ВВП. ПРИ ЭТОМ САМА СИСТЕМА СУБСИДИЙ
Dialogue: 0,0:06:47.70,0:06:50.67,Caption,,0,0,0,,ТОЖЕ УПИРАЕТСЯ В ПРОБЛЕМУ. ИЗ ЗА МИГРАЦИИ,
Dialogue: 0,0:06:50.89,0:06:52.97,Caption,,0,0,0,,НЕОФИЦИАЛЬНЫХ ДОХОДОВ И МЕНЯЮЩЕГОСЯ
Dialogue: 0,0:06:52.97,0:06:55.50,Caption,,0,0,0,,СОСТАВА ДОМОХОЗЯЙСТВ ГОСУДАРСТВУ ВСЁ СЛОЖНЕЕ
Dialogue: 0,0:06:55.50,0:06:58.03,Caption,,0,0,0,,ПОНИМАТЬ, КОМУ ПОМОЩЬ ДЕЙСТВИТЕЛЬНО НУЖНА.
Dialogue: 0,0:06:58.67,0:07:00.71,Caption,,0,0,0,,ЭКОНОМИЯ ОТ ПОЛНОГО ПАКЕТА РЕФОРМ ПО
Dialogue: 0,0:07:00.71,0:07:03.53,Caption,,0,0,0,,РАДИКАЛЬНОМУ СЦЕНАРИЮ ОЦЕНИВАЕТСЯ В ТРИ ЦЕЛЫХ ДВЕ
Dialogue: 0,0:07:03.53,0:07:06.56,Caption,,0,0,0,,ДЕСЯТЫХ ПРОЦЕНТА ВВП. ПО БОЛЕЕ УМЕРЕННОМУ В
Dialogue: 0,0:07:06.56,0:07:09.89,Caption,,0,0,0,,ОДНУ ЦЕЛУЮ ПЯТЬ ДЕСЯТЫХ ПРОЦЕНТА. МВФ УКАЗЫВАЕТ И
Dialogue: 0,0:07:09.89,0:07:14.82,Caption,,0,0,0,,НА ДРУГОЙ РАЗРЫВ. ДЕЙСТВУЮЩИЙ ТАРИФ НА ЭЛЕКТРИЧЕСТВО
Dialogue: 0,0:07:14.82,0:07:17.62,Caption,,0,0,0,,ПОКРЫВАЕТ ЛИШЬ ОКОЛО СОРОКА ОДНОГО ПРОЦЕНТА РАСХОДОВ
Dialogue: 0,0:07:17.62,0:07:20.17,Caption,,0,0,0,,НА ПРОИЗВОДСТВО И ДОСТАВКУ. ГАЗОВЫЙ ТАРИФ
Dialogue: 0,0:07:20.17,0:07:23.28,Caption,,0,0,0,,ОКОЛО СОРОКА ДЕВЯТИ ПРОЦЕНТОВ. ЧТОБЫ ЗАКРЫТЬ ЭТОТ
Dialogue: 0,0:07:23.28,0:07:25.91,Caption,,0,0,0,,РАЗРЫВ, ЭЛЕКТРИЧЕСТВО НАДО ПОДНЯТЬ ПРИМЕРНО В
Dialogue: 0,0:07:25.91,0:07:27.58,Caption,,0,0,0,,ДВЕ ЦЕЛЫХ ЧЕТЫРЕ ДЕСЯТЫХ РАЗА,
Dialogue: 0,0:07:27.87,0:07:31.54,Caption,,0,0,0,,ГАЗ ПРИМЕРНО ВДВОЕ. И ВОТ ЗДЕСЬ У МЕНЯ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:07:31.54,0:07:33.68,Caption,,0,0,0,,ПОЧТИ ПОЛОВИНА СТРАНЫ УЖЕ ЗА ЧЕРТОЙ
Dialogue: 0,0:07:33.68,0:07:36.89,Caption,,0,0,0,,БЕДНОСТИ. А ТАРИФЫ НАДО УВЕЛИЧИТЬ ПРИМЕРНО В ДВА РАЗА.
Dialogue: 0,0:07:36.89,0:07:39.58,Caption,,0,0,0,,ЭТО ЧТОБЫ ЧТО? ЧТОБЫ ОСТАЛЬНЫХ ТУДА ЖЕ ЗАГНАТЬ?
Dialogue: 0,0:07:39.90,0:07:41.41,Caption,,0,0,0,,ПОТОМУ ЧТО ЭКОНОМИЧЕСКАЯ ЛОГИКА
Dialogue: 0,0:07:41.41,0:07:44.22,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ. СНАЧАЛА МЫ ФИКСИРУЕМ,
Dialogue: 0,0:07:44.46,0:07:47.10,Caption,,0,0,0,,ЧТО ЛЮДЯМ УЖЕ ТЯЖЕЛО ПЛАТИТЬ КОММУНАЛКУ. ПОТОМ
Dialogue: 0,0:07:47.18,0:07:48.98,Caption,,0,0,0,,СМОТРИМ НА ЭТУ ПРОБЛЕМУ И ГОВОРИМ
Dialogue: 0,0:07:48.98,0:07:51.86,Caption,,0,0,0,,ОТЛИЧНО, ДАВАЙТЕ КОММУНАЛКУ СДЕЛАЕМ ЕЩЁ ДОРОЖЕ.
Dialogue: 0,0:07:51.86,0:07:54.79,Caption,,0,0,0,,ПРИЧЁМ ПО ДАННЫМ, КОТОРЫЕ ПРИВОДЯТСЯ СО ССЫЛКОЙ НА
Dialogue: 0,0:07:54.79,0:07:57.59,Caption,,0,0,0,,ВСЕМИРНЫЙ БАНК, УРОВЕНЬ БЕДНОСТИ ВЫРОС С ДВАДЦАТИ
Dialogue: 0,0:07:57.59,0:08:00.58,Caption,,0,0,0,,ПРОЦЕНТОВ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ ДО СОРОКА
Dialogue: 0,0:08:00.58,0:08:03.42,Caption,,0,0,0,,ДВУХ ПРОЦЕНТОВ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ. В БОЛЕЕ
Dialogue: 0,0:08:03.42,0:08:05.99,Caption,,0,0,0,,СВЕЖИХ ДАННЫХ ФИГУРИРУЕТ СОРОК ОДИН ПРОЦЕНТ.
Dialogue: 0,0:08:05.99,0:08:08.43,Caption,,0,0,0,,ТО ЕСТЬ РЕЧЬ НЕ О КАКОЙ ТО НЕБОЛЬШОЙ ГРУППЕ
Dialogue: 0,0:08:08.43,0:08:11.54,Caption,,0,0,0,,НАСЕЛЕНИЯ. РЕЧЬ ИДЁТ ПРАКТИЧЕСКИ О ПОЛОВИНЕ СТРАНЫ.
Dialogue: 0,0:08:11.54,0:08:15.18,Caption,,0,0,0,,ВОТ ТАК, НАВЕРНОЕ, И ВЫГЛЯДИТ РАЗВИВАЮЩАЯСЯ ЭКОНОМИКА,
Dialogue: 0,0:08:15.42,0:08:18.14,Caption,,0,0,0,,КОТОРАЯ, ПО МНЕНИЮ МЕРЦА, ЛЕТИТ ВВЕРХ.
Dialogue: 0,0:08:20.42,0:08:22.24,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ИМЕННО ТАКОЙ
Dialogue: 0,0:08:22.24,0:08:25.05,Caption,,0,0,0,,РАЗБОР, ГДЕ РЯДОМ КЛАДУТ КРАСИВЫЕ ЗАЯВЛЕНИЯ И
Dialogue: 0,0:08:25.05,0:08:28.47,Caption,,0,0,0,,РЕАЛЬНЫЕ ЦИФРЫ, ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ У ЭТОЙ
Dialogue: 0,0:08:28.47,0:08:31.30,Caption,,0,0,0,,ИСТОРИИ ЕСТЬ ЕЩЁ ОДНА ОЧЕНЬ ЧЕЛОВЕЧЕСКАЯ СТОРОНА.
Dialogue: 0,0:08:31.86,0:08:34.34,Caption,,0,0,0,,НА ВОЙНУ ДЕНЬГИ ЕСТЬ. КУЧА ДЕНЕГ.
Dialogue: 0,0:08:34.34,0:08:37.78,Caption,,0,0,0,,ДЕСЯТКИ МИЛЛИАРДОВ НАХОДЯТСЯ. А НА ЛЮДЕЙ ДЕНЕГ НЕТ.
Dialogue: 0,0:08:38.41,0:08:40.42,Caption,,0,0,0,,КОГДА РЕЧЬ ДОХОДИТ ДО ОБЫЧНЫХ ЛЮДЕЙ,
Dialogue: 0,0:08:40.72,0:08:42.90,Caption,,0,0,0,,ВНЕЗАПНО НАЧИНАЕТСЯ ОЧЕНЬ ВНИМАТЕЛЬНЫЙ
Dialogue: 0,0:08:42.90,0:08:45.54,Caption,,0,0,0,,ПОДСЧЁТ КАЖДОГО ЕВРО. И ГЕРМАНИЯ ЗДЕСЬ ДАЁТ
Dialogue: 0,0:08:45.54,0:08:48.40,Caption,,0,0,0,,ПРЕКРАСНЫЙ ПРИМЕР. В РАЙОНЕ ГРАЙЦ В ТЮРИНГИИ
Dialogue: 0,0:08:48.40,0:08:50.98,Caption,,0,0,0,,ПРОВЕРИЛИ ШЕСТЬСОТ ПЯТЬДЕСЯТ ШЕСТЬ УКРАИНЦЕВ,
Dialogue: 0,0:08:50.98,0:08:53.01,Caption,,0,0,0,,ПОЛУЧАВШИХ СОЦИАЛЬНУЮ ПОМОЩЬ. У
Dialogue: 0,0:08:53.01,0:08:56.27,Caption,,0,0,0,,ПЯТИДЕСЯТИ ЧЕТЫРЁХ, ТО ЕСТЬ У ВОСЬМИ ЦЕЛЫХ ДВУХ ДЕСЯТЫХ
Dialogue: 0,0:08:56.27,0:08:59.26,Caption,,0,0,0,,ПРОЦЕНТА, НАШЛИ НЕЗАДЕКЛАРИРОВАННЫЕ ДОХОДЫ.
Dialogue: 0,0:08:59.26,0:09:02.19,Caption,,0,0,0,,ШЕСТНАДЦАТИ ВЫПЛАТЫ ПОЛНОСТЬЮ ПРЕКРАТИЛИ. ЕЩЁ
Dialogue: 0,0:09:02.19,0:09:05.32,Caption,,0,0,0,,ТРИДЦАТИ ВОСЬМИ ПОСОБИЯ СОКРАТИЛИ. РЕЧЬ ШЛА ОБ
Dialogue: 0,0:09:05.32,0:09:08.88,Caption,,0,0,0,,УКРАИНСКИХ ПЕНСИЯХ, ДОХОДАХ ОТ СДАЧИ НЕДВИЖИМОСТИ И ДРУГИХ
Dialogue: 0,0:09:08.88,0:09:11.75,Caption,,0,0,0,,ПОСТУПЛЕНИЯХ. ПРИЧЁМ РАЗОБРАТЬСЯ С ДОХОДАМИ ПОМОГЛИ
Dialogue: 0,0:09:11.75,0:09:14.40,Caption,,0,0,0,,ДОКУМЕНТЫ ИЗ УКРАИНСКОГО ПРИЛОЖЕНИЯ "ДІЯ". У
Dialogue: 0,0:09:14.40,0:09:17.80,Caption,,0,0,0,,НЕМЕЦКИХ ВЕДОМСТВ НЕТ ПРЯМОГО ДОСТУПА К СИСТЕМЕ. НО ОНИ
Dialogue: 0,0:09:17.80,0:09:19.78,Caption,,0,0,0,,МОГУТ ПОПРОСИТЬ ЗАЯВИТЕЛЯ ПРЕДОСТАВИТЬ
Dialogue: 0,0:09:19.78,0:09:21.88,Caption,,0,0,0,,ЭЛЕКТРОННУЮ СПРАВКУ. ПОЛУЧАЕТСЯ ПОЧТИ
Dialogue: 0,0:09:21.88,0:09:25.62,Caption,,0,0,0,,ТЕХНОЛОГИЧЕСКАЯ ИРОНИЯ. ЧЕЛОВЕК ПРИЕХАЛ ЗА НЕМЕЦКИМ ПОСОБИЕМ,
Dialogue: 0,0:09:26.02,0:09:27.90,Caption,,0,0,0,,А УКРАИНСКАЯ ЦИФРОВИЗАЦИЯ ПОМОГЛА
Dialogue: 0,0:09:27.90,0:09:29.46,Caption,,0,0,0,,НЕМЕЦКОМУ ЧИНОВНИКУ ПРОВЕРИТЬ,
Dialogue: 0,0:09:29.70,0:09:35.96,Caption,,0,0,0,,КАКИЕ ЕЩЁ ДЕНЬГИ У НЕГО ЕСТЬ. ПО НЕМЕЦКОМУ ЗАКОНОДАТЕЛЬСТВУ ДОХОДЫ И
Dialogue: 0,0:09:35.96,0:09:38.62,Caption,,0,0,0,,ИМУЩЕСТВО ДЕКЛАРИРОВАТЬ НАДО НЕЗАВИСИМО ОТ ТОГО,
Dialogue: 0,0:09:38.93,0:09:41.09,Caption,,0,0,0,,ИЗ КАКОЙ СТРАНЫ ПРИЕХАЛ ЧЕЛОВЕК. НО
Dialogue: 0,0:09:41.09,0:09:43.74,Caption,,0,0,0,,ТУТ ЕСТЬ ВАЖНАЯ ДЕТАЛЬ. НЕ УСТАНОВЛЕНО,
Dialogue: 0,0:09:43.82,0:09:45.96,Caption,,0,0,0,,ВСЕ ЛИ ЭТИ ЛЮДИ СОЗНАТЕЛЬНО СКРЫВАЛИ
Dialogue: 0,0:09:45.96,0:09:48.85,Caption,,0,0,0,,ДОХОДЫ. ПРИЧИНОЙ МОГЛИ БЫТЬ НЕЗНАНИЕ ПРАВИЛ
Dialogue: 0,0:09:48.85,0:09:51.82,Caption,,0,0,0,,ИЛИ ЯЗЫКОВЫЕ ПРОБЛЕМЫ. И Я БЫ ТОЧНО НЕ СТАЛ СЕЙЧАС
Dialogue: 0,0:09:51.82,0:09:53.72,Caption,,0,0,0,,ПРЕВРАЩАТЬ ПЯТЬДЕСЯТ ЧЕТЫРЕ СЛУЧАЯ В
Dialogue: 0,0:09:53.72,0:09:56.79,Caption,,0,0,0,,ОБВИНЕНИЕ ВСЕХ УКРАИНСКИХ БЕЖЕНЦЕВ. ЛЮДИ ИЩУТ ДЕНЬГИ
Dialogue: 0,0:09:56.79,0:10:01.09,Caption,,0,0,0,,НЕ ОТ ХОРОШЕЙ ЖИЗНИ. ДА, ЗАКОН ЕСТЬ ЗАКОН. ЕСЛИ ДОХОД НАДО
Dialogue: 0,0:10:01.09,0:10:04.61,Caption,,0,0,0,,ДЕКЛАРИРОВАТЬ, ЕГО НАДО ДЕКЛАРИРОВАТЬ. НО КОГДА ДОМА
Dialogue: 0,0:10:04.61,0:10:07.46,Caption,,0,0,0,,СОРОК ОДИН ПРОЦЕНТ НАСЕЛЕНИЯ НАХОДИТСЯ ЗА ЧЕРТОЙ
Dialogue: 0,0:10:07.46,0:10:09.98,Caption,,0,0,0,,БЕДНОСТИ, А ДОХОДЫ У ЧАСТИ СЕМЕЙ ПАДАЮТ,
Dialogue: 0,0:10:10.23,0:10:13.33,Caption,,0,0,0,,ОЧЕНЬ ТРУДНО ДЕЛАТЬ ВИД, ЧТО СОЦИАЛЬНАЯ СТОРОНА ЭТОЙ ИСТОРИИ
Dialogue: 0,0:10:13.33,0:10:16.17,Caption,,0,0,0,,ВООБЩЕ НИ ПРИ ЧЁМ. ДЛЯ МЕСТНОГО БЮДЖЕТА РЕЗУЛЬТАТ
Dialogue: 0,0:10:16.17,0:10:18.67,Caption,,0,0,0,,ВПОЛНЕ КОНКРЕТНЫЙ. ОТ ПРЕКРАЩЕНИЯ ПОСОБИЙ
Dialogue: 0,0:10:18.67,0:10:22.26,Caption,,0,0,0,,ШЕСТНАДЦАТИ ЛЮДЯМ ЭКОНОМИЯ СОСТАВЛЯЕТ СТО ПЯТЬДЕСЯТ ОДНУ
Dialogue: 0,0:10:22.26,0:10:25.32,Caption,,0,0,0,,ТЫСЯЧУ ЧЕТЫРЕСТА СОРОК ЕВРО В ГОД. СОКРАЩЕНИЕ
Dialogue: 0,0:10:25.32,0:10:27.84,Caption,,0,0,0,,ВЫПЛАТ ОСТАЛЬНЫМ ДАЁТ ЕЩЁ ПРИМЕРНО СЕМЬ С
Dialogue: 0,0:10:27.84,0:10:31.41,Caption,,0,0,0,,ПОЛОВИНОЙ, ВОСЕМЬ ТЫСЯЧ ЕВРО ЭКОНОМИИ ЕЖЕМЕСЯЧНО.
Dialogue: 0,0:10:31.41,0:10:33.26,Caption,,0,0,0,,ПРИЧЁМ ВСЕ ШЕСТНАДЦАТЬ ЧЕЛОВЕК,
Dialogue: 0,0:10:33.53,0:10:38.10,Caption,,0,0,0,,ПОЛНОСТЬЮ ЛИШИВШИЕСЯ ПОСОБИЙ, ПОСЛЕ ЭТОГО ПОКИНУЛИ РАЙОН ГРАЙЦ. КУДА
Dialogue: 0,0:10:38.10,0:10:40.85,Caption,,0,0,0,,ОНИ УЕХАЛИ, НЕИЗВЕСТНО. НИКТО РЕШЕНИЕ НЕ
Dialogue: 0,0:10:40.85,0:10:43.02,Caption,,0,0,0,,ОБЖАЛОВАЛ. ПРОВЕРКИ ПРОДОЛЖАЮТСЯ,
Dialogue: 0,0:10:43.10,0:10:45.10,Caption,,0,0,0,,В ТОМ ЧИСЛЕ СРЕДИ НОВЫХ ЗАЯВИТЕЛЕЙ.
Dialogue: 0,0:10:47.30,0:10:49.21,Caption,,0,0,0,,ОБЩЕНАЦИОНАЛЬНОЙ СТАТИСТИКИ ТАКИХ
Dialogue: 0,0:10:49.21,0:10:52.46,Caption,,0,0,0,,НАРУШЕНИЙ ПОКА НЕТ, ПОЭТОМУ ПЕРЕНОСИТЬ МЕСТНЫЕ ВОСЕМЬ
Dialogue: 0,0:10:52.46,0:10:55.60,Caption,,0,0,0,,ЦЕЛЫХ ДВЕ ДЕСЯТЫХ ПРОЦЕНТА НА ВСЮ ГЕРМАНИЮ НЕЛЬЗЯ. НО
Dialogue: 0,0:10:55.60,0:10:58.66,Caption,,0,0,0,,ОБЩИЙ МАСШТАБ СИСТЕМЫ ПОНЯТЕН. СОЦИАЛЬНУЮ ПОМОЩЬ В
Dialogue: 0,0:10:58.66,0:11:01.34,Caption,,0,0,0,,ГЕРМАНИИ ПОЛУЧАЮТ ОКОЛО ШЕСТИСОТ ДВАДЦАТИ ШЕСТИ
Dialogue: 0,0:11:01.34,0:11:03.96,Caption,,0,0,0,,ТЫСЯЧ УКРАИНЦЕВ. И ПОКА ГЕРМАНИЯ СЧИТАЕТ
Dialogue: 0,0:11:03.96,0:11:06.61,Caption,,0,0,0,,ПОСОБИЯ, В КИЕВЕ ЛЮДИ С СОВЕРШЕННО ДРУГИМИ
Dialogue: 0,0:11:06.61,0:11:09.74,Caption,,0,0,0,,ВОЗМОЖНОСТЯМИ ТОЖЕ ДЕЛАЮТ СВОИ ВЫВОДЫ. ЧАСТЬ ИЗВЕСТНЫХ
Dialogue: 0,0:11:09.74,0:11:12.21,Caption,,0,0,0,,УКРАИНСКИХ АРТИСТОВ РЕШИЛА НЕ ПРОВОДИТЬ ЗИМУ В
Dialogue: 0,0:11:12.21,0:11:14.34,Caption,,0,0,0,,СТОЛИЦЕ ИЗ ЗА ПЕРЕБОЕВ С ЭЛЕКТРИЧЕСТВОМ,
Dialogue: 0,0:11:14.50,0:11:17.06,Caption,,0,0,0,,ВОДОЙ И ОТОПЛЕНИЕМ. СРЕДИ УЕХАВШИХ
Dialogue: 0,0:11:17.06,0:11:20.26,Caption,,0,0,0,,НАЗЫВАЮТСЯ ЕЛЕНА КРАВЕЦ, ИРИНА СОПОНАРУ,
Dialogue: 0,0:11:20.42,0:11:23.14,Caption,,0,0,0,,НАЗАР ЗАДНЕПРОВСКИЙ, ЕКАТЕРИНА ТЫШКЕВИЧ,
Dialogue: 0,0:11:23.39,0:11:27.40,Caption,,0,0,0,,ВАЛЕНТИН ТОМУСЯК, СВЕТЛАНА ТАРАБАРОВА И ALYONA ALYONA.
Dialogue: 0,0:11:27.40,0:11:29.45,Caption,,0,0,0,,ОДНИ ОТПРАВИЛИСЬ В ЗАПАДНЫЕ РЕГИОНЫ
Dialogue: 0,0:11:29.45,0:11:32.71,Caption,,0,0,0,,УКРАИНЫ. ДРУГИЕ ЗА ГРАНИЦУ. И ЗДЕСЬ НЕ НАДО НИКОГО
Dialogue: 0,0:11:32.71,0:11:35.73,Caption,,0,0,0,,ОБВИНЯТЬ. ЕСЛИ У ЧЕЛОВЕКА ЕСТЬ ВОЗМОЖНОСТЬ ВЫВЕЗТИ
Dialogue: 0,0:11:35.73,0:11:37.78,Caption,,0,0,0,,СЕМЬЮ ТУДА, ГДЕ ЕСТЬ СВЕТ И ТЕПЛО,
Dialogue: 0,0:11:38.07,0:11:40.19,Caption,,0,0,0,,ОН ЭТОЙ ВОЗМОЖНОСТЬЮ ПОЛЬЗУЕТСЯ.
Dialogue: 0,0:11:40.19,0:11:42.58,Caption,,0,0,0,,ВОПРОС В ДРУГОМ. А ЧТО ДЕЛАТЬ ЧЕЛОВЕКУ,
Dialogue: 0,0:11:42.66,0:11:44.42,Caption,,0,0,0,,У КОТОРОГО ТАКОЙ ВОЗМОЖНОСТИ НЕТ?
Dialogue: 0,0:11:44.65,0:11:46.58,Caption,,0,0,0,,ЧТО ДЕЛАТЬ СЕМЬЕ БЕЗ СБЕРЕЖЕНИЙ?
Dialogue: 0,0:11:46.92,0:11:50.29,Caption,,0,0,0,,ЧТО ДЕЛАТЬ ЧЕЛОВЕКУ, КОТОРЫЙ УЖЕ СЕЙЧАС С ТРУДОМ ОПЛАЧИВАЕТ
Dialogue: 0,0:11:50.29,0:11:53.14,Caption,,0,0,0,,КОММУНАЛЬНЫЕ УСЛУГИ, А ВПЕРЕДИ ЕМУ ОБЪЯСНЯЮТ,
Dialogue: 0,0:11:53.38,0:11:55.27,Caption,,0,0,0,,ЧТО ТАРИФЫ НАДО ПРИБЛИЗИТЬ К РЫНОЧНОМУ
Dialogue: 0,0:11:55.27,0:11:58.05,Caption,,0,0,0,,УРОВНЮ? ВОТ ЗДЕСЬ ЭКОНОМИЧЕСКИЙ РОСТ ПЕРЕСТАЁТ
Dialogue: 0,0:11:58.05,0:11:59.78,Caption,,0,0,0,,БЫТЬ КРАСИВОЙ ЦИФРОЙ ИЗ ДОКЛАДА.
Dialogue: 0,0:12:02.07,0:12:03.85,Caption,,0,0,0,,ОН ПРИХОДИТ К ЧЕЛОВЕКУ ДОМОЙ В ВИДЕ
Dialogue: 0,0:12:03.85,0:12:06.25,Caption,,0,0,0,,ПЛАТЁЖКИ. И ТОГДА УЖЕ МОЖНО СКОЛЬКО УГОДНО
Dialogue: 0,0:12:06.25,0:12:10.23,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО ВВП РАСТЁТ, ФИНАНСОВАЯ СИСТЕМА ДЕРЖИТСЯ,
Dialogue: 0,0:12:10.39,0:12:14.24,Caption,,0,0,0,,ПАРТНЁРЫ ДАЮТ ДЕНЬГИ, А РЕФОРМЫ НЕОБХОДИМЫ. ЧЕЛОВЕК СМОТРИТ
Dialogue: 0,0:12:14.24,0:12:17.91,Caption,,0,0,0,,НЕ НА ВВП. ОН СМОТРИТ, СКОЛЬКО ОСТАЛОСЬ ПОСЛЕ ОПЛАТЫ
Dialogue: 0,0:12:17.91,0:12:22.12,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА, ГАЗА, ЕДЫ И ЛЕКАРСТВ. ПОЭТОМУ СЛОВА МЕРЦА И
Dialogue: 0,0:12:22.12,0:12:24.41,Caption,,0,0,0,,ЗВУЧАТ ТАК СТРАННО. УКРАИНСКАЯ ЭКОНОМИКА
Dialogue: 0,0:12:24.41,0:12:27.11,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО СПОСОБНА ПОКАЗЫВАТЬ РОСТ ОТДЕЛЬНЫХ
Dialogue: 0,0:12:27.11,0:12:29.19,Caption,,0,0,0,,МАКРОЭКОНОМИЧЕСКИХ ПОКАЗАТЕЛЕЙ. НО
Dialogue: 0,0:12:29.19,0:12:32.44,Caption,,0,0,0,,ЕСЛИ ОДНОВРЕМЕННО СОРОК ОДИН ПРОЦЕНТ НАСЕЛЕНИЯ НАХОДИТСЯ
Dialogue: 0,0:12:32.44,0:12:35.84,Caption,,0,0,0,,ЗА ЧЕРТОЙ БЕДНОСТИ, ПАДАЮТ ДОХОДЫ ПРЕДПРИНИМАТЕЛЕЙ И
Dialogue: 0,0:12:35.84,0:12:38.33,Caption,,0,0,0,,АГРАРИЕВ, ФЕРМЕРЫ ГОТОВЯТСЯ ВЫБИРАТЬ МЕЖДУ
Dialogue: 0,0:12:38.33,0:12:42.04,Caption,,0,0,0,,КРЕДИТОМ И ПОСЕВНОЙ, А ЕВРОПА ИЩЕТ НОВЫЕ ДЕСЯТКИ МИЛЛИАРДОВ
Dialogue: 0,0:12:42.04,0:12:46.27,Caption,,0,0,0,,ДЛЯ ПОДДЕРЖАНИЯ ГОСУДАРСТВА, ТО ОДНО СЛОВО "РОСТ" ОБЪЯСНЯЕТ ОЧЕНЬ
Dialogue: 0,0:12:46.27,0:12:49.64,Caption,,0,0,0,,МАЛО. ИРОНИЯ В ТОМ, ЧТО САМЫЕ НЕУДОБНЫЕ ВОПРОСЫ К ЭТОМУ
Dialogue: 0,0:12:49.64,0:12:53.22,Caption,,0,0,0,,РОСТУ ЗАДАЁТ НЕ МОСКВА. ИХ ЗАДАЮТ ЦИФРЫ ВСЕМИРНОГО
Dialogue: 0,0:12:53.22,0:12:56.11,Caption,,0,0,0,,БАНКА. ИХ ЗАДАЁТ АРИФМЕТИКА МВФ. ИХ ЗАДАЮТ
Dialogue: 0,0:12:56.11,0:12:58.39,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ БЮДЖЕТЫ. А ГЛАВНОЕ,
Dialogue: 0,0:12:58.55,0:13:01.70,Caption,,0,0,0,,ИХ ЗАДАЁТ ОБЫЧНЫЙ ЧЕЛОВЕК, КОТОРОМУ МОЖНО СКОЛЬКО УГОДНО
Dialogue: 0,0:13:01.70,0:13:04.96,Caption,,0,0,0,,РАССКАЗЫВАТЬ ПРО ПРОЦЕНТЫ ВВП. ПЛАТЁЖКУ ОТ ЭТОГО МЕНЬШЕ
Dialogue: 0,0:13:04.96,0:13:07.35,Caption,,0,0,0,,НЕ СДЕЛАЕШЬ. И ЗДЕСЬ, ПОЖАЛУЙ,
Dialogue: 0,0:13:07.43,0:13:09.65,Caption,,0,0,0,,САМАЯ НЕПРИЯТНАЯ ВЕЩЬ ВО ВСЕЙ ЭТОЙ
Dialogue: 0,0:13:09.65,0:13:12.46,Caption,,0,0,0,,ИСТОРИИ. ДЕНЬГИ МОЖНО ЗАНЯТЬ ЕЩЁ РАЗ. МОЖНО
Dialogue: 0,0:13:12.46,0:13:16.15,Caption,,0,0,0,,СОГЛАСОВАТЬ ЕЩЁ ОДИН ПАКЕТ. МОЖНО НАЙТИ ЕЩЁ НЕСКОЛЬКО
Dialogue: 0,0:13:16.15,0:13:21.78,Caption,,0,0,0,,ДЕСЯТКОВ МИЛЛИАРДОВ. НО ЕСЛИ ВЕСНОЙ ФЕРМЕР НЕ ЗАСЕЯЛ ПОЛЕ,
Dialogue: 0,0:13:22.16,0:13:24.18,Caption,,0,0,0,,ОСЕНЬЮ УЖЕ НИКАКОЙ КРЕДИТ НЕ ВЕРНЁТ
Dialogue: 0,0:13:24.18,0:13:27.07,Caption,,0,0,0,,УРОЖАЙ, КОТОРОГО НЕ БЫЛО. А ЕСЛИ ЭКОНОМИЧЕСКИЙ
Dialogue: 0,0:13:27.07,0:13:28.90,Caption,,0,0,0,,РОСТ ВСЁ ДАЛЬШЕ РАСХОДИТСЯ С ТЕМ,
Dialogue: 0,0:13:29.14,0:13:32.46,Caption,,0,0,0,,КАК ЖИВЁТ НАСЕЛЕНИЕ, ТО РАНО ИЛИ ПОЗДНО ПРИДЁТСЯ ОТВЕЧАТЬ
Dialogue: 0,0:13:32.46,0:13:35.22,Caption,,0,0,0,,УЖЕ НЕ НА ВОПРОС, СКОЛЬКО ПРОЦЕНТОВ ВЫРОС ВВП.
Dialogue: 0,0:13:35.78,0:13:37.87,Caption,,0,0,0,,А НА ГОРАЗДО БОЛЕЕ ПРОСТОЙ. КТО ЭТОТ
Dialogue: 0,0:13:37.87,0:13:39.14,Caption,,0,0,0,,РОСТ ВООБЩЕ ПОЧУВСТВОВАЛ?
