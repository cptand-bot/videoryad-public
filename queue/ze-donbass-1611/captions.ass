Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,АМЕРИКАНЦЫ СДЕЛАЛИ ЗЕЛЕНСКОМУ ТАКОЕ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:00:03.08,0:00:06.84,Caption,,0,0,0,,ЧТО ДАЖЕ ИНТЕРЕСНО, КТО ТАМ ВООБЩЕ ДОДУМАЛСЯ ДО ЭТОЙ КОМБИНАЦИИ. НА
Dialogue: 0,0:00:06.92,0:00:09.32,Caption,,0,0,0,,ПЕРВЫЙ ВЗГЛЯД ВСЁ КРАСИВО. ВАМ ОДНО,
Dialogue: 0,0:00:09.48,0:00:13.48,Caption,,0,0,0,,НАМ ДРУГОЕ, ПОЖАЛИ РУКИ И РАЗОШЛИСЬ ДОВОЛЬНЫЕ. ТОЛЬКО ЕСТЬ ОДНА
Dialogue: 0,0:00:13.48,0:00:15.72,Caption,,0,0,0,,МАЛЕНЬКАЯ ЗАГВОЗДКА. А КТО СКАЗАЛ,
Dialogue: 0,0:00:15.85,0:00:17.80,Caption,,0,0,0,,ЧТО АМЕРИКАНЦАМ ВООБЩЕ НУЖНО БЫЛО,
Dialogue: 0,0:00:17.97,0:00:22.68,Caption,,0,0,0,,ЧТОБЫ ЗЕЛЕНСКИЙ СОГЛАСИЛСЯ? ВОТ С ЭТОГО ВОПРОСА ВСЯ ИСТОРИЯ СТАНОВИТСЯ ГОРАЗДО
Dialogue: 0,0:00:22.76,0:00:25.48,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ЗДЕСЬ
Dialogue: 0,0:00:25.56,0:00:29.08,Caption,,0,0,0,,КАК РАЗ ТОТ СЛУЧАЙ, КОГДА САМОЕ ИНТЕРЕСНОЕ НАХОДИТСЯ НЕ В САМОМ
Dialogue: 0,0:00:29.08,0:00:33.72,Caption,,0,0,0,,ПРЕДЛОЖЕНИИ, А В ТОМ, ЗАЧЕМ ОНО ВООБЩЕ ПОНАДОБИЛОСЬ. ЗЕЛЕНСКИЙ РАССКАЗАЛ,
Dialogue: 0,0:00:34.02,0:00:36.76,Caption,,0,0,0,,ЧТО АМЕРИКАНСКИЕ ПРЕДСТАВИТЕЛИ ВПЕРВЫЕ СПРОСИЛИ ЕГО,
Dialogue: 0,0:00:37.00,0:00:39.64,Caption,,0,0,0,,ГОТОВА ЛИ УКРАИНА ВЫВЕСТИ ВОЙСКА ИЗ ДОНБАССА,
Dialogue: 0,0:00:39.88,0:00:42.76,Caption,,0,0,0,,ЕСЛИ ВЗАМЕН ПОЛУЧИТ ЧЛЕНСТВО В НАТО. ВОТ ТАК.
Dialogue: 0,0:00:43.08,0:00:45.16,Caption,,0,0,0,,НЕ ОЧЕРЕДНАЯ ОБЩАЯ ФОРМУЛА ПРО МИР,
Dialogue: 0,0:00:45.40,0:00:50.20,Caption,,0,0,0,,НЕ РАЗГОВОР О КОГДА НИБУДЬ, А ВПОЛНЕ КОНКРЕТНЫЙ ВОПРОС. УХОДИТЕ ИЗ ДОНБАССА.
Dialogue: 0,0:00:50.33,0:00:54.60,Caption,,0,0,0,,ПОЛУЧАЕТЕ НАТО. КРАСИВО? НА БУМАГЕ ОЧЕНЬ. ТОЛЬКО ЗЕЛЕНСКИЙ В ОТВЕТ НЕ
Dialogue: 0,0:00:54.60,0:00:59.08,Caption,,0,0,0,,СКАЗАЛ ХОРОШО, ДОГОВОРИЛИСЬ. ОН НАЧАЛ ПЕРЕЧИСЛЯТЬ УСЛОВИЯ. НУЖНЫ
Dialogue: 0,0:00:59.08,0:01:02.12,Caption,,0,0,0,,ПОЛНОЦЕННЫЕ ГАРАНТИИ БЕЗОПАСНОСТИ. НУЖНЫ ГАРАНТИИ ОТ
Dialogue: 0,0:01:02.20,0:01:05.32,Caption,,0,0,0,,НАТО И ЕВРОСОЮЗА. НУЖНО СТАБИЛЬНОЕ ФИНАНСИРОВАНИЕ.
Dialogue: 0,0:01:05.56,0:01:08.68,Caption,,0,0,0,,НУЖНО ВООРУЖЕНИЕ УКРАИНСКОЙ АРМИИ. НУЖНЫ ДЕНЬГИ НА
Dialogue: 0,0:01:08.68,0:01:11.64,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ СТРАНЫ. НЕЙТРАЛЬНЫЙ СТАТУС УКРАИНА
Dialogue: 0,0:01:11.64,0:01:13.88,Caption,,0,0,0,,ЗАКРЕПЛЯТЬ В КОНСТИТУЦИИ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:01:16.16,0:01:18.48,Caption,,0,0,0,,ЮРИДИЧЕСКИ ПРИЗНАВАТЬ ПОТЕРЯННЫЕ ТЕРРИТОРИИ
Dialogue: 0,0:01:18.48,0:01:21.12,Caption,,0,0,0,,РОССИЙСКИМИ ТОЖЕ НЕ СОБИРАЕТСЯ. ТО ЕСТЬ ВМЕСТО
Dialogue: 0,0:01:21.20,0:01:23.52,Caption,,0,0,0,,КОРОТКОГО "ДА" ПОЛУЧИЛСЯ ХОРОШИЙ ТАКОЙ СПИСОК
Dialogue: 0,0:01:23.60,0:01:26.08,Caption,,0,0,0,,ПОКУПОК. И ВОТ ТУТ ПОЯВЛЯЕТСЯ ВЕРСИЯ,
Dialogue: 0,0:01:26.40,0:01:29.28,Caption,,0,0,0,,КОТОРАЯ ДЕЛАЕТ ВСЮ ИСТОРИЮ ГОРАЗДО ИНТЕРЕСНЕЕ. А
Dialogue: 0,0:01:29.28,0:01:32.80,Caption,,0,0,0,,ЧТО, ЕСЛИ АМЕРИКАНЦАМ ЭТО "ДА" ВООБЩЕ БЫЛО НЕ НУЖНО?
Dialogue: 0,0:01:33.12,0:01:36.00,Caption,,0,0,0,,ЧТО, ЕСЛИ ИМ НУЖЕН БЫЛ ИМЕННО ТАКОЙ ОТВЕТ?
Dialogue: 0,0:01:36.28,0:01:39.04,Caption,,0,0,0,,ПОТОМУ ЧТО ТОГДА РАЗГОВОР ВЫГЛЯДИТ УЖЕ СОВСЕМ ИНАЧЕ.
Dialogue: 0,0:01:39.25,0:01:41.76,Caption,,0,0,0,,АМЕРИКАНСКИЙ ПРЕДСТАВИТЕЛЬ ПРИЕЗЖАЕТ К ЗЕЛЕНСКОМУ И
Dialogue: 0,0:01:41.76,0:01:46.08,Caption,,0,0,0,,КЛАДЁТ НА СТОЛ ПРЕДЛОЖЕНИЕ, КОТОРОЕ С УКРАИНСКОЙ ТОЧКИ ЗРЕНИЯ ВЫГЛЯДИТ ПОЧТИ
Dialogue: 0,0:01:46.08,0:01:51.68,Caption,,0,0,0,,МАКСИМАЛЬНО ЩЕДРЫМ. ДА, ДОНБАСС ПРИДЁТСЯ ОСТАВИТЬ. ЗАТО УКРАИНА ПОЛУЧАЕТ ТО,
Dialogue: 0,0:01:51.84,0:01:56.40,Caption,,0,0,0,,ЧЕГО ДОБИВАЛАСЬ ГОДАМИ, ЧЛЕНСТВО В НАТО. ПРИЧЁМ АМЕРИКАНЦЫ ПРЕКРАСНО ЗНАЮТ,
Dialogue: 0,0:01:56.56,0:01:59.60,Caption,,0,0,0,,ЧТО НЕЙТРАЛЬНЫЙ СТАТУС КИЕВ ОТВЕРГАЕТ. ЗНАЮТ,
Dialogue: 0,0:01:59.76,0:02:02.96,Caption,,0,0,0,,НАСКОЛЬКО БОЛЕЗНЕННЫЙ ТЕРРИТОРИАЛЬНЫЙ ВОПРОС. ЗНАЮТ,
Dialogue: 0,0:02:03.11,0:02:05.60,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ НЕ ХОЧЕТ ПОДПИСЫВАТЬ ЮРИДИЧЕСКОЕ
Dialogue: 0,0:02:05.60,0:02:07.92,Caption,,0,0,0,,ПРИЗНАНИЕ РОССИЙСКИХ ТЕРРИТОРИАЛЬНЫХ ПРИОБРЕТЕНИЙ.
Dialogue: 0,0:02:08.24,0:02:10.72,Caption,,0,0,0,,ОНИ ВЕДЬ НЕ ВЧЕРА ПОЗНАКОМИЛИСЬ. И ЕСЛИ ПОСЛЕ
Dialogue: 0,0:02:10.80,0:02:13.84,Caption,,0,0,0,,ВСЕГО ЭТОГО ЕМУ ПРЕДЛАГАЮТ ИМЕННО ТАКУЮ КОМБИНАЦИЮ,
Dialogue: 0,0:02:14.08,0:02:16.64,Caption,,0,0,0,,ЛОГИЧНЫЙ ВОПРОС ОЧЕНЬ ПРОСТОЙ. НА КАКОЙ ОТВЕТ
Dialogue: 0,0:02:16.64,0:02:19.52,Caption,,0,0,0,,РАССЧИТЫВАЛИ? ЕСЛИ РАССЧИТЫВАЛИ НА СОГЛАСИЕ,
Dialogue: 0,0:02:19.84,0:02:22.72,Caption,,0,0,0,,ЗНАЧИТ ДАЛЬШЕ ВОЗНИКАЕТ ЕЩЁ БОЛЕЕ ВЕСЁЛЫЙ ВОПРОС. А
Dialogue: 0,0:02:22.80,0:02:26.96,Caption,,0,0,0,,РОССИЯ НА ЭТО СОГЛАСИЛАСЬ? ПОТОМУ ЧТО МОСКВА МНОГО ЛЕТ ГОВОРИТ РОВНО ОБ
Dialogue: 0,0:02:27.04,0:02:31.48,Caption,,0,0,0,,ОБРАТНОМ. НЕ О ВСТУПЛЕНИИ УКРАИНЫ В НАТО,
Dialogue: 0,0:02:31.88,0:02:34.60,Caption,,0,0,0,,А О ЕЁ ВНЕБЛОКОВОМ СТАТУСЕ. НЕ О РАСШИРЕНИИ
Dialogue: 0,0:02:34.60,0:02:36.92,Caption,,0,0,0,,ВОЕННОГО ПРИСУТСТВИЯ АЛЬЯНСА ВОЗЛЕ РОССИЙСКИХ
Dialogue: 0,0:02:36.92,0:02:40.84,Caption,,0,0,0,,ГРАНИЦ, А ОБ ОГРАНИЧЕНИЯХ ЭТОГО ПРИСУТСТВИЯ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:02:40.84,0:02:44.28,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ СДЕЛКА. ОДНОМУ УЧАСТНИКУ ОБЕЩАЮТ ТО,
Dialogue: 0,0:02:44.50,0:02:47.24,Caption,,0,0,0,,ПРОТИВ ЧЕГО КАТЕГОРИЧЕСКИ ВЫСТУПАЕТ ДРУГОЙ УЧАСТНИК.
Dialogue: 0,0:02:47.56,0:02:50.60,Caption,,0,0,0,,ПРЯМО МАСТЕР КЛАСС ТОРГОВЛИ. Я ВАМ ПРОДАМ КВАРТИРУ
Dialogue: 0,0:02:50.60,0:02:54.68,Caption,,0,0,0,,СОСЕДА. ГЛАВНОЕ, ЧТОБЫ СОСЕД ПОКА НЕ ЗНАЛ. ПОЭТОМУ ВЕРСИЯ О
Dialogue: 0,0:02:54.68,0:02:57.24,Caption,,0,0,0,,ТОМ, ЧТО АМЕРИКАНЦАМ НУЖЕН БЫЛ НЕ ДОГОВОР,
Dialogue: 0,0:02:57.48,0:03:00.92,Caption,,0,0,0,,А ОТВЕТ ЗЕЛЕНСКОГО, ПО КРАЙНЕЙ МЕРЕ ОБЪЯСНЯЕТ СТРАННОСТЬ САМОЙ
Dialogue: 0,0:03:00.92,0:03:03.32,Caption,,0,0,0,,ПОСТАНОВКИ ВОПРОСА. ПОЛУЧИЛИ ОТКАЗ,
Dialogue: 0,0:03:03.56,0:03:05.56,Caption,,0,0,0,,ПОШЛИ ДАЛЬШЕ И ГОВОРЯТ ГОСПОДИН ПРЕЗИДЕНТ,
Dialogue: 0,0:03:05.88,0:03:08.68,Caption,,0,0,0,,МЫ УЖЕ ПРЕДЛАГАЛИ ЕМУ ДАЖЕ НАТО. ДАЖЕ ЭТО
Dialogue: 0,0:03:08.68,0:03:10.92,Caption,,0,0,0,,ПОЛОЖИЛИ НА СТОЛ. А ОН ВСЁ РАВНО ВЫДВИНУЛ
Dialogue: 0,0:03:11.00,0:03:13.88,Caption,,0,0,0,,ЕЩЁ ПАЧКУ УСЛОВИЙ. И ТОГДА ЗЕЛЕНСКОМУ СТАНОВИТСЯ
Dialogue: 0,0:03:13.88,0:03:15.88,Caption,,0,0,0,,НАМНОГО СЛОЖНЕЕ ОБЪЯСНЯТЬ ТРАМПУ,
Dialogue: 0,0:03:16.12,0:03:19.16,Caption,,0,0,0,,ЧТО ИМЕННО АМЕРИКА НЕДОСТАТОЧНО СТАРАЛАСЬ. ЭТО ЕЩЁ
Dialogue: 0,0:03:19.24,0:03:22.60,Caption,,0,0,0,,НЕ ОЗНАЧАЕТ, ЧТО ИМЕННО ТАКОЙ ЗАМЫСЕЛ ДЕЙСТВИТЕЛЬНО ЛЕЖАЛ НА
Dialogue: 0,0:03:22.68,0:03:25.72,Caption,,0,0,0,,СТОЛЕ У АМЕРИКАНЦЕВ. НО КАК ПОЛИТИЧЕСКИЙ РАСЧЁТ ЭТА
Dialogue: 0,0:03:25.80,0:03:28.20,Caption,,0,0,0,,СХЕМА ВПОЛНЕ ПОНЯТНА ТЕБЕ ДАЮТ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:03:28.44,0:03:31.16,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО ТВОЙ ОТКАЗ САМ СТАНОВИТСЯ РЕЗУЛЬТАТОМ
Dialogue: 0,0:03:31.16,0:03:34.36,Caption,,0,0,0,,ПЕРЕГОВОРОВ. И ЗЕЛЕНСКИЙ, НАДО ОТДАТЬ ЕМУ ДОЛЖНОЕ,
Dialogue: 0,0:03:34.68,0:03:37.08,Caption,,0,0,0,,ТОЖЕ ОТВЕТИЛ НЕ ВЧЕРА РОДИВШИСЬ. ОН НЕ ХЛОПНУЛ
Dialogue: 0,0:03:37.08,0:03:40.44,Caption,,0,0,0,,ДВЕРЬЮ. ОН СКАЗАЛ ОБСУЖДАТЬ МОЖНО. РЕФЕРЕНДУМ МОЖНО.
Dialogue: 0,0:03:42.71,0:03:45.59,Caption,,0,0,0,,НО СНАЧАЛА ГАРАНТИИ, НАТО, ЕВРОСОЮЗ,
Dialogue: 0,0:03:45.67,0:03:49.43,Caption,,0,0,0,,ДЕНЬГИ, ОРУЖИЕ, ВОССТАНОВЛЕНИЕ. ТО ЕСТЬ ФОРМАЛЬНО ДВЕРЬ НЕ
Dialogue: 0,0:03:49.43,0:03:52.31,Caption,,0,0,0,,ЗАХЛОПНУТА. НО ПРОЙТИ ЧЕРЕЗ НЕЁ МОЖНО ТОЛЬКО С
Dialogue: 0,0:03:52.31,0:03:55.59,Caption,,0,0,0,,ЦЕЛЫМ ГРУЗОВИКОМ УСЛОВИЙ. И ВОТ ТЕПЕРЬ ПОПРОБУЙ ЕЩЁ
Dialogue: 0,0:03:55.59,0:03:59.99,Caption,,0,0,0,,ОБЪЯСНИ, ЧТО ЭТО БЫЛО. ОТКАЗ? НЕ СОВСЕМ. СОГЛАСИЕ?
Dialogue: 0,0:04:00.17,0:04:03.19,Caption,,0,0,0,,ТОЖЕ НЕТ. КЛАССИЧЕСКАЯ ФОРМУЛА Я СОГЛАСЕН,
Dialogue: 0,0:04:03.27,0:04:05.67,Caption,,0,0,0,,ЕСЛИ ВЫ СНАЧАЛА СОГЛАСИТЕСЬ ВООБЩЕ СО ВСЕМ,
Dialogue: 0,0:04:05.75,0:04:08.87,Caption,,0,0,0,,ЧЕГО ХОЧУ Я. КРАСИВО. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ
Dialogue: 0,0:04:08.87,0:04:12.07,Caption,,0,0,0,,РАЗБОРЫ, ГДЕ МЫ СМОТРИМ НЕ ТОЛЬКО НА ЗАЯВЛЕНИЕ ПОЛИТИКА,
Dialogue: 0,0:04:12.31,0:04:15.51,Caption,,0,0,0,,НО И НА ТО, ЗАЧЕМ ОНО МОГЛО ПОНАДОБИТЬСЯ ИМЕННО СЕЙЧАС,
Dialogue: 0,0:04:15.65,0:04:18.47,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ДАЛЬШЕ СТАНОВИТСЯ ЕЩЁ ЗАНЯТНЕЕ.
Dialogue: 0,0:04:18.79,0:04:21.27,Caption,,0,0,0,,ПОТОМУ ЧТО ПОКА АМЕРИКАНЦЫ ПРОВЕРЯЮТ ЗЕЛЕНСКОГО,
Dialogue: 0,0:04:21.51,0:04:24.31,Caption,,0,0,0,,ЕВРОПА НАЧИНАЕТ ПРОВЕРЯТЬ УЖЕ САМУ ИДЕЮ РАЗГОВОРА С
Dialogue: 0,0:04:24.39,0:04:28.95,Caption,,0,0,0,,РОССИЕЙ. КАЯ КАЛЛАС ЗАЯВЛЯЕТ, ЧТО ОБСУЖДЕНИЕ РОССИЙСКИХ ТРЕБОВАНИЙ ПО БУДУЩЕЙ
Dialogue: 0,0:04:29.03,0:04:31.91,Caption,,0,0,0,,СИСТЕМЕ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ СПОСОБНО УВЕСТИ
Dialogue: 0,0:04:31.91,0:04:34.95,Caption,,0,0,0,,РАЗГОВОР ОТ ПРЕКРАЩЕНИЯ БОЕВЫХ ДЕЙСТВИЙ. ЕЁ ПОЗИЦИЯ
Dialogue: 0,0:04:34.95,0:04:38.07,Caption,,0,0,0,,ПОНЯТНА. СНАЧАЛА ОСТАНОВИТЬ БОЕВЫЕ ДЕЙСТВИЯ. А
Dialogue: 0,0:04:38.07,0:04:41.83,Caption,,0,0,0,,МОСКВА ГОВОРИТ, ЧТО ОБСУЖДАТЬ ХОЧЕТ ГОРАЗДО БОЛЬШЕ. И НАЧИНАЕТСЯ
Dialogue: 0,0:04:41.83,0:04:44.47,Caption,,0,0,0,,СТАРЫЙ ЕВРОПЕЙСКИЙ АТТРАКЦИОН. ВСЕ ХОТЯТ
Dialogue: 0,0:04:44.47,0:04:47.03,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТОЛЬКО КАЖДЫЙ ПОЧЕМУ ТО ХОЧЕТ
Dialogue: 0,0:04:47.03,0:04:49.91,Caption,,0,0,0,,ОБСУЖДАТЬ ИСКЛЮЧИТЕЛЬНО СВОЮ. МИНИСТР ОБОРОНЫ
Dialogue: 0,0:04:49.99,0:04:52.71,Caption,,0,0,0,,ФИНЛЯНДИИ АНТТИ ХЯККЯНЕН НАЗВАЛ РОССИЙСКИЕ
Dialogue: 0,0:04:52.71,0:04:55.19,Caption,,0,0,0,,ТРЕБОВАНИЯ К НАТО СОВЕРШЕННО ВОЗМУТИТЕЛЬНЫМИ.
Dialogue: 0,0:04:57.47,0:04:59.47,Caption,,0,0,0,,ПО ОПУБЛИКОВАННОЙ ВЕРСИИ ЭТИХ ТРЕБОВАНИЙ,
Dialogue: 0,0:04:59.71,0:05:01.87,Caption,,0,0,0,,РЕЧЬ ИДЁТ В ТОМ ЧИСЛЕ О ВОЕННОМ ПРИСУТСТВИИ
Dialogue: 0,0:05:01.87,0:05:05.23,Caption,,0,0,0,,АЛЬЯНСА, СТАТУСЕ УКРАИНЫ И ПОЛОЖЕНИИ ФИНЛЯНДИИ.
Dialogue: 0,0:05:05.79,0:05:08.75,Caption,,0,0,0,,ОТВЕТ ХЯККЯНЕНА ПРОСТОЙ ПОДОБНЫЕ ВЕЩИ ДАЖЕ ОБСУЖДАТЬ
Dialogue: 0,0:05:08.83,0:05:12.03,Caption,,0,0,0,,НЕ СТОИТ. КАНАДА ОТВЕЧАЕТ ПРИМЕРНО ТУДА ЖЕ. МАРК
Dialogue: 0,0:05:12.03,0:05:15.95,Caption,,0,0,0,,КАРНИ ЗАЯВИЛ, ЧТО ОТТАВА НЕ СОБИРАЕТСЯ ПЕРЕСМАТРИВАТЬ СВОЁ УЧАСТИЕ
Dialogue: 0,0:05:16.03,0:05:18.35,Caption,,0,0,0,,В НАТО И ОТКАЗЫВАТЬСЯ ОТ ОБЯЗАТЕЛЬСТВ ПЕРЕД
Dialogue: 0,0:05:18.35,0:05:21.23,Caption,,0,0,0,,СОЮЗНИКАМИ. КАНАДА СОХРАНЯЕТ КРУПНОЕ ВОЕННОЕ
Dialogue: 0,0:05:21.23,0:05:23.39,Caption,,0,0,0,,ПРИСУТСТВИЕ В ЛАТВИИ И СВОРАЧИВАТЬ ЕГО РАДИ
Dialogue: 0,0:05:23.39,0:05:26.27,Caption,,0,0,0,,РОССИЙСКИХ ТРЕБОВАНИЙ НЕ НАМЕРЕНА. ТО ЕСТЬ ПОКА
Dialogue: 0,0:05:26.27,0:05:28.83,Caption,,0,0,0,,АМЕРИКАНЦЫ ПРЕДЛАГАЮТ ЗЕЛЕНСКОМУ НАТО В ОБМЕН НА
Dialogue: 0,0:05:28.83,0:05:32.27,Caption,,0,0,0,,ДОНБАСС, ЕВРОПЕЙСКИЕ СОЮЗНИКИ ГОВОРЯТ НАШЕ НЫНЕШНЕЕ
Dialogue: 0,0:05:32.27,0:05:35.23,Caption,,0,0,0,,ПРИСУТСТВИЕ В НАТО И ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ ВООБЩЕ
Dialogue: 0,0:05:35.31,0:05:37.95,Caption,,0,0,0,,НЕ ПРЕДМЕТ ТОРГА. ОТЛИЧНОЕ НАЧАЛО БОЛЬШОГО
Dialogue: 0,0:05:37.95,0:05:40.11,Caption,,0,0,0,,СОГЛАШЕНИЯ. ОСТАЛОСЬ НАЙТИ ТОГО,
Dialogue: 0,0:05:40.24,0:05:42.83,Caption,,0,0,0,,КТО СОГЛАСЕН СО ВТОРОЙ СТОРОНОЙ. И ЗДЕСЬ ПРОБЛЕМА
Dialogue: 0,0:05:42.91,0:05:45.39,Caption,,0,0,0,,УЖЕ НЕ ТОЛЬКО В ЗЕЛЕНСКОМ. ДАЖЕ ЕСЛИ ЗАВТРА
Dialogue: 0,0:05:45.47,0:05:48.27,Caption,,0,0,0,,КИЕВ НЕОЖИДАННО СКАЖЕТ ЛАДНО, БЕРЁМ ВАШ ВАРИАНТ,
Dialogue: 0,0:05:48.67,0:05:50.91,Caption,,0,0,0,,ДАЛЬШЕ ПРИДЁТСЯ ЗАДАВАТЬ ТОТ ЖЕ САМЫЙ ВОПРОС
Dialogue: 0,0:05:50.91,0:05:53.71,Caption,,0,0,0,,ФИНЛЯНДИИ, КАНАДЕ, СТРАНАМ БАЛТИИ,
Dialogue: 0,0:05:53.84,0:05:56.59,Caption,,0,0,0,,ПОЛЬШЕ, ГЕРМАНИИ. ВЫ ЧТО ГОТОВЫ МЕНЯТЬ?
Dialogue: 0,0:05:57.00,0:06:00.11,Caption,,0,0,0,,ОТВЕТ ПОКА ЗВУЧИТ ПРИМЕРНО ОДИНАКОВО. НИЧЕГО. ТОГДА
Dialogue: 0,0:06:00.19,0:06:03.47,Caption,,0,0,0,,О ЧЁМ ТОРГ? ЕСЛИ КАЖДЫЙ УЧАСТНИК ПРИХОДИТ НА ПЕРЕГОВОРЫ СО
Dialogue: 0,0:06:03.47,0:06:05.55,Caption,,0,0,0,,СПИСКОМ ТОГО, ЧТО МЕНЯТЬ НЕЛЬЗЯ,
Dialogue: 0,0:06:05.84,0:06:08.27,Caption,,0,0,0,,СТОЛ ПЕРЕГОВОРОВ ОЧЕНЬ БЫСТРО ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:06:08.27,0:06:14.88,Caption,,0,0,0,,ВЫСТАВКУ КРАСНЫХ ЛИНИЙ. КРАСИВО РАЗЛОЖИЛИ. ТРОГАТЬ НИЧЕГО НЕЛЬЗЯ. НО МИР
Dialogue: 0,0:06:14.96,0:06:17.52,Caption,,0,0,0,,НУЖЕН СРОЧНО. И НА ЭТОМ ФОНЕ ИЗ БРИТАНИИ
Dialogue: 0,0:06:17.52,0:06:20.96,Caption,,0,0,0,,ПРИЛЕТАЕТ ЕЩЁ ОДИН ПРЕКРАСНЫЙ РЕЦЕПТ МИРА. РИШИ
Dialogue: 0,0:06:20.96,0:06:24.80,Caption,,0,0,0,,СУНАК ЗАЯВИЛ, ЧТО ЛОНДОН ДОЛЖЕН БЫТЬ ГОТОВ АТАКОВАТЬ РОССИЙСКИЕ
Dialogue: 0,0:06:24.88,0:06:28.08,Caption,,0,0,0,,БАЗЫ НА КОЛЬСКОМ ПОЛУОСТРОВЕ. ТАМ СЕВЕРНЫЙ ФЛОТ. ТАМ
Dialogue: 0,0:06:28.08,0:06:31.12,Caption,,0,0,0,,ЗНАЧИТЕЛЬНАЯ ЧАСТЬ РОССИЙСКИХ ЯДЕРНЫХ СИЛ. И БЫВШИЙ
Dialogue: 0,0:06:31.12,0:06:33.68,Caption,,0,0,0,,БРИТАНСКИЙ ПРЕМЬЕР ПРЕДЛАГАЕТ ПОКАЗАТЬ МОСКВЕ,
Dialogue: 0,0:06:33.99,0:06:36.88,Caption,,0,0,0,,ЧТО ЗАПАД СПОСОБЕН НАНЕСТИ УЩЕРБ РОССИЙСКОЙ ВОЕННОЙ
Dialogue: 0,0:06:36.88,0:06:41.20,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ. СЛУШАЙ, РИШИ, Я ТОЛЬКО ОДНОГО НЕ ПОНЯЛ. ТЫ ВЕДЬ БЫЛ
Dialogue: 0,0:06:41.20,0:06:44.64,Caption,,0,0,0,,ПРЕМЬЕРОМ. НЕ КОММЕНТАТОРОМ НА ДИВАНЕ. НЕ ЭКСПЕРТОМ
Dialogue: 0,0:06:44.72,0:06:47.84,Caption,,0,0,0,,В ИНТЕРНЕТЕ. ПРЕМЬЕРОМ ВЕЛИКОБРИТАНИИ. У ТЕБЯ БЫЛ
Dialogue: 0,0:06:47.84,0:06:51.68,Caption,,0,0,0,,КАБИНЕТ. БЫЛИ МИНИСТРЫ. БЫЛИ ВООРУЖЁННЫЕ СИЛЫ. БЫЛИ
Dialogue: 0,0:06:51.68,0:06:54.64,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНЫЕ СТРУКТУРЫ. БЫЛ ДОСТУП К ВОЕННОМУ
Dialogue: 0,0:06:54.64,0:06:57.44,Caption,,0,0,0,,ПЛАНИРОВАНИЮ. ЕСЛИ ИДЕЯ ТАКАЯ ПРЕКРАСНАЯ,
Dialogue: 0,0:06:57.76,0:07:01.28,Caption,,0,0,0,,ПОЧЕМУ САМ НЕ СДЕЛАЛ? ВОТ ТОГДА И НАДО БЫЛО СКАЗАТЬ РЕБЯТА,
Dialogue: 0,0:07:01.44,0:07:03.84,Caption,,0,0,0,,ГОТОВИМСЯ АТАКОВАТЬ РОССИЙСКИЕ БАЗЫ НА КОЛЬСКОМ
Dialogue: 0,0:07:03.84,0:07:06.96,Caption,,0,0,0,,ПОЛУОСТРОВЕ. ВСЁ БЫЛО В РУКАХ. НО НЕТ. ПОКА
Dialogue: 0,0:07:07.04,0:07:08.64,Caption,,0,0,0,,ЧЕЛОВЕК СИДЕЛ НА ДАУНИНГ СТРИТ,
Dialogue: 0,0:07:08.80,0:07:11.36,Caption,,0,0,0,,КАК ТО НЕ СЛОЖИЛОСЬ. А ТЕПЕРЬ МОЖНО. ТЕПЕРЬ
Dialogue: 0,0:07:11.44,0:07:14.96,Caption,,0,0,0,,ДАВАЙТЕ, АТАКУЙТЕ. ОЧЕНЬ УДОБНО. УПРАВЛЯТЬ УЖЕ НЕ НАДО.
Dialogue: 0,0:07:15.12,0:07:17.84,Caption,,0,0,0,,ПОСЛЕДСТВИЯ РАЗГРЕБАТЬ НЕ ТЕБЕ. ОТВЕТ РОССИИ
Dialogue: 0,0:07:17.84,0:07:20.48,Caption,,0,0,0,,ПРИНИМАТЬ ТОЖЕ НЕ ТЕБЕ. МОЖНО БЫТЬ РЕШИТЕЛЬНЫМ
Dialogue: 0,0:07:20.48,0:07:23.12,Caption,,0,0,0,,СКОЛЬКО УГОДНО. ВООБЩЕ БЫВШИЕ В ЭТОТ РАЗ ПОШЛИ
Dialogue: 0,0:07:23.20,0:07:27.04,Caption,,0,0,0,,В АТАКУ МОЩНО. ПОКА, ПРАВДА, В ОСНОВНОМ ИДЕЯМИ.
Dialogue: 0,0:07:29.32,0:07:32.12,Caption,,0,0,0,,СУНАК БЫВШИЙ ПРЕМЬЕР. КУЛЕБА БЫВШИЙ МИНИСТР
Dialogue: 0,0:07:32.12,0:07:35.24,Caption,,0,0,0,,ИНОСТРАННЫХ ДЕЛ УКРАИНЫ. И У КУЛЕБЫ ТОЖЕ ПОЯВИЛСЯ
Dialogue: 0,0:07:35.24,0:07:37.40,Caption,,0,0,0,,СТРАТЕГИЧЕСКИЙ СОВЕТ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:07:37.64,0:07:40.60,Caption,,0,0,0,,ЕДИНСТВЕННАЯ СТРАТЕГИЯ УКРАИНЫ СЕГОДНЯ ЗАКЛЮЧАЕТСЯ В
Dialogue: 0,0:07:40.60,0:07:43.72,Caption,,0,0,0,,ТОМ, ЧТОБЫ ДЕРЖАТЬСЯ СТОЛЬКО, СКОЛЬКО ВОЗМОЖНО.
Dialogue: 0,0:07:44.32,0:07:47.24,Caption,,0,0,0,,ВОТ ЗДЕСЬ ХОЧЕТСЯ ОСТАНОВИТЬСЯ. ДЕРЖАТЬСЯ. ХОРОШО.
Dialogue: 0,0:07:47.40,0:07:51.56,Caption,,0,0,0,,ДО ЧЕГО? КАКОЙ ФИНАЛ? ВОТ МЫ ДЕРЖИМСЯ ЕЩЁ ГОД. ПОТОМ ЕЩЁ ГОД.
Dialogue: 0,0:07:51.75,0:07:54.20,Caption,,0,0,0,,ПОТОМ ЕЩЁ. ЧТО ДОЛЖНО ПРОИЗОЙТИ В КОНЦЕ?
Dialogue: 0,0:07:54.50,0:07:57.88,Caption,,0,0,0,,КАКИМ ДОЛЖЕН БЫТЬ РЕЗУЛЬТАТ, ПОСЛЕ КОТОРОГО МОЖНО СКАЗАТЬ ВСЁ,
Dialogue: 0,0:07:58.04,0:08:01.56,Caption,,0,0,0,,СТРАТЕГИЯ СРАБОТАЛА? РОССИЯ ДОЛЖНА ИЗМЕНИТЬ СВОИ ТРЕБОВАНИЯ?
Dialogue: 0,0:08:01.85,0:08:03.72,Caption,,0,0,0,,РОССИЙСКАЯ ЭКОНОМИКА ДОЛЖНА РУХНУТЬ?
Dialogue: 0,0:08:03.91,0:08:07.48,Caption,,0,0,0,,ПУТИН ДОЛЖЕН ПЕРЕДУМАТЬ? ЗАПАД ДОЛЖЕН ДАТЬ СТОЛЬКО ОРУЖИЯ,
Dialogue: 0,0:08:07.64,0:08:09.96,Caption,,0,0,0,,ЧТО СИТУАЦИЯ НА ФРОНТЕ ПОЛНОСТЬЮ ИЗМЕНИТСЯ?
Dialogue: 0,0:08:10.28,0:08:13.08,Caption,,0,0,0,,ДОЛЖНО ПРОИЗОЙТИ ВНУТРЕННЕЕ ПОЛИТИЧЕСКОЕ ИЗМЕНЕНИЕ В
Dialogue: 0,0:08:13.08,0:08:17.80,Caption,,0,0,0,,РОССИИ? ЧТО? КУЛЕБА ГОВОРИТ, РАСЧЁТ ИДЁТ НА ИЗМЕНЕНИЕ ОБСТОЯТЕЛЬСТВ,
Dialogue: 0,0:08:17.89,0:08:20.44,Caption,,0,0,0,,КОТОРЫЕ ПОВЛИЯЮТ НА РЕШЕНИЯ ПУТИНА. КАКИХ
Dialogue: 0,0:08:20.44,0:08:22.84,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВ? КОГДА? КАКИМ ОБРАЗОМ?
Dialogue: 0,0:08:23.24,0:08:25.80,Caption,,0,0,0,,ПОКА ЭТО БОЛЬШЕ НАПОМИНАЕТ НЕ СТРАТЕГИЮ ДОСТИЖЕНИЯ
Dialogue: 0,0:08:25.80,0:08:29.72,Caption,,0,0,0,,РЕЗУЛЬТАТА, А СТРАТЕГИЮ ОЖИДАНИЯ РЕЗУЛЬТАТА. ДЕРЖИМСЯ,
Dialogue: 0,0:08:29.88,0:08:32.52,Caption,,0,0,0,,А ДАЛЬШЕ ЧТО НИБУДЬ ПРОИЗОЙДЁТ. У СУНАКА ХОТЯ
Dialogue: 0,0:08:32.52,0:08:35.24,Caption,,0,0,0,,БЫ ЦЕЛЬ ПОНЯТНА. ОН ПРЕДЛАГАЕТ ПРОДЕМОНСТРИРОВАТЬ
Dialogue: 0,0:08:35.24,0:08:37.56,Caption,,0,0,0,,ВОЗМОЖНОСТЬ УДАРИТЬ ПО РОССИЙСКОЙ СТРАТЕГИЧЕСКОЙ
Dialogue: 0,0:08:37.56,0:08:39.88,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ. ОПАСНО ДО БЕЗУМИЯ,
Dialogue: 0,0:08:40.28,0:08:43.72,Caption,,0,0,0,,НО ХОТЯ БЫ ПОНЯТНО, ЧТО ЧЕЛОВЕК ПРЕДЛАГАЕТ СДЕЛАТЬ. А ЗДЕСЬ?
Dialogue: 0,0:08:45.99,0:08:47.99,Caption,,0,0,0,,ДЕРЖАТЬСЯ. ДО КАКОГО РЕЗУЛЬТАТА?
Dialogue: 0,0:08:48.51,0:08:51.11,Caption,,0,0,0,,И ВОТ ЗДЕСЬ МАРЬЯНА БЕЗУГЛАЯ, КАК НИ СТРАННО,
Dialogue: 0,0:08:51.35,0:08:54.23,Caption,,0,0,0,,СМОТРИТ НА СИТУАЦИЮ НАМНОГО ПРАКТИЧНЕЕ. ПОТОМУ ЧТО
Dialogue: 0,0:08:54.31,0:08:57.99,Caption,,0,0,0,,ЕСЛИ СТРАТЕГИЯ СОСТОИТ В ТОМ, ЧТОБЫ ДЕРЖАТЬСЯ МАКСИМАЛЬНО ДОЛГО,
Dialogue: 0,0:08:58.39,0:09:01.67,Caption,,0,0,0,,ЗНАЧИТ НУЖНО ЧЕМ ТО ДЕРЖАТЬСЯ. НУЖНЫ ДЕНЬГИ. НУЖНО
Dialogue: 0,0:09:01.67,0:09:04.79,Caption,,0,0,0,,ОРУЖИЕ. НУЖНЫ БОЕПРИПАСЫ. И САМОЕ ГЛАВНОЕ,
Dialogue: 0,0:09:04.95,0:09:09.11,Caption,,0,0,0,,НУЖНЫ ЛЮДИ. БЕЗУГЛАЯ СНОВА ПРЕДЛАГАЕТ РАСШИРЯТЬ ВОИНСКИЙ УЧЁТ
Dialogue: 0,0:09:09.11,0:09:11.67,Caption,,0,0,0,,ЖЕНЩИН. В ТОМ ЧИСЛЕ СПЕЦИАЛИСТОВ СВЯЗИ,
Dialogue: 0,0:09:11.75,0:09:15.51,Caption,,0,0,0,,ИНЖЕНЕРИИ, ИНФОРМАЦИОННЫХ ТЕХНОЛОГИЙ. ПРЕДЛАГАЕТ СИЛЬНЕЕ
Dialogue: 0,0:09:15.51,0:09:18.23,Caption,,0,0,0,,ОГРАНИЧИВАТЬ БРОНИРОВАНИЕ. ПРЕДЛАГАЕТ УСИЛИВАТЬ
Dialogue: 0,0:09:18.31,0:09:20.95,Caption,,0,0,0,,ВОЕННУЮ ПОДГОТОВКУ В ШКОЛАХ. ПРИЧЁМ ОНА ПРЯМО
Dialogue: 0,0:09:21.03,0:09:23.83,Caption,,0,0,0,,ГОВОРИТ О ПОДГОТОВКЕ ОБЩЕСТВА К ЗАТЯЖНОМУ КОНФЛИКТУ.
Dialogue: 0,0:09:24.25,0:09:26.31,Caption,,0,0,0,,И ВОТ ТУТ ВСЁ СХОДИТСЯ БЕЗ ВСЯКИХ СЛОЖНЫХ
Dialogue: 0,0:09:26.31,0:09:29.43,Caption,,0,0,0,,СХЕМ. КУЛЕБА ГОВОРИТ ДЕРЖАТЬСЯ КАК МОЖНО ДОЛЬШЕ.
Dialogue: 0,0:09:29.59,0:09:32.15,Caption,,0,0,0,,БЕЗУГЛАЯ ОТВЕЧАЕТ НА ПРАКТИЧЕСКИЙ ВОПРОС КЕМ?
Dialogue: 0,0:09:32.44,0:09:35.51,Caption,,0,0,0,,МУЖСКОЙ МОБИЛИЗАЦИОННЫЙ РЕСУРС НЕ БЕСКОНЕЧНЫЙ. ЕСЛИ
Dialogue: 0,0:09:35.51,0:09:37.99,Caption,,0,0,0,,ЗАДАЧА СОСТОИТ ИМЕННО В ДЛИТЕЛЬНОМ ПРОДОЛЖЕНИИ
Dialogue: 0,0:09:38.07,0:09:40.79,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ, ПРИХОДИТСЯ СМОТРЕТЬ ТУДА,
Dialogue: 0,0:09:40.87,0:09:43.59,Caption,,0,0,0,,КУДА РАНЬШЕ СТАРАЛИСЬ ОСОБЕННО НЕ СМОТРЕТЬ. НА
Dialogue: 0,0:09:43.67,0:09:46.95,Caption,,0,0,0,,ЖЕНЩИН. НА СПЕЦИАЛИСТОВ ГРАЖДАНСКИХ ПРОФЕССИЙ. НА
Dialogue: 0,0:09:47.03,0:09:50.31,Caption,,0,0,0,,ТЕХ, КОГО ЕЩЁ МОЖНО ПОСТАВИТЬ НА ВОИНСКИЙ УЧЁТ. НА
Dialogue: 0,0:09:50.31,0:09:53.75,Caption,,0,0,0,,ТЕХ, У КОГО ЕЩЁ МОЖНО СОКРАТИТЬ БРОНЬ. НА БУДУЩИЕ
Dialogue: 0,0:09:53.75,0:09:57.03,Caption,,0,0,0,,ПОКОЛЕНИЯ, КОТОРЫХ ПРЕДЛАГАЕТСЯ РАНЬШЕ ГОТОВИТЬ К ВОЕННОЙ
Dialogue: 0,0:09:57.03,0:10:01.39,Caption,,0,0,0,,СЛУЖБЕ. БЕЗУГЛАЯ ЗДЕСЬ КАК РАЗ ПОНИМАЕТ,
Dialogue: 0,0:10:01.56,0:10:04.51,Caption,,0,0,0,,КУДА ВЕДЁТ СТРАТЕГИЯ "ДЕРЖАТЬСЯ". ЕСЛИ ДЕРЖАТЬСЯ
Dialogue: 0,0:10:04.51,0:10:07.71,Caption,,0,0,0,,ДОЛГО, ПРИДЁТСЯ ВЫЧЕРПЫВАТЬ ДОСТУПНЫЕ РЕСУРСЫ ВСЁ ГЛУБЖЕ.
Dialogue: 0,0:10:07.94,0:10:11.07,Caption,,0,0,0,,ЧУДЕС ЗДЕСЬ НЕТ. ДОПОЛНИТЕЛЬНЫЙ БАТАЛЬОН ИЗ ВОЗДУХА
Dialogue: 0,0:10:11.07,0:10:14.03,Caption,,0,0,0,,НЕ МАТЕРИАЛИЗУЕТСЯ. ЛЮДЕЙ НУЖНО ГДЕ ТО БРАТЬ. И
Dialogue: 0,0:10:14.11,0:10:16.27,Caption,,0,0,0,,ЕСЛИ КУЛЕБА ГОВОРИТ О ВРЕМЕНИ КАК О ГЛАВНОМ
Dialogue: 0,0:10:16.27,0:10:18.51,Caption,,0,0,0,,РЕСУРСЕ, БЕЗУГЛАЯ ГОВОРИТ О ТОМ,
Dialogue: 0,0:10:18.80,0:10:21.47,Caption,,0,0,0,,ЧЕМ ЭТО ВРЕМЯ ОПЛАЧИВАЕТСЯ. ВОТ ТОЛЬКО ЦЕНА
Dialogue: 0,0:10:21.47,0:10:23.95,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ИНТЕРЕСНАЯ. АМЕРИКАНЦЫ ПРЕДЛАГАЮТ
Dialogue: 0,0:10:23.95,0:10:26.59,Caption,,0,0,0,,ЗЕЛЕНСКОМУ СДЕЛКУ. ЕВРОПЕЙЦЫ ОБЪЯСНЯЮТ,
Dialogue: 0,0:10:26.67,0:10:29.31,Caption,,0,0,0,,ЧЕГО ОНИ МЕНЯТЬ НЕ БУДУТ. СУНАК ПРЕДЛАГАЕТ
Dialogue: 0,0:10:29.31,0:10:31.63,Caption,,0,0,0,,ДЕЙСТВУЮЩИМ ВЛАСТЯМ БЫТЬ ГОТОВЫМИ АТАКОВАТЬ
Dialogue: 0,0:10:31.63,0:10:34.67,Caption,,0,0,0,,РОССИЙСКИЕ СТРАТЕГИЧЕСКИЕ ОБЪЕКТЫ. КУЛЕБА ПРЕДЛАГАЕТ
Dialogue: 0,0:10:34.67,0:10:37.15,Caption,,0,0,0,,УКРАИНЕ ДЕРЖАТЬСЯ ДО ИЗМЕНЕНИЯ ОБСТОЯТЕЛЬСТВ.
Dialogue: 0,0:10:37.39,0:10:39.31,Caption,,0,0,0,,БЕЗУГЛАЯ УЖЕ НАЧИНАЕТ СЧИТАТЬ ТЕХ,
Dialogue: 0,0:10:39.55,0:10:42.27,Caption,,0,0,0,,ЗА СЧЁТ КОГО ЭТО "ДЕРЖАТЬСЯ" МОЖНО ПРОДЛИТЬ. И
Dialogue: 0,0:10:42.27,0:10:45.07,Caption,,0,0,0,,ВСЁ ЭТО ПРОИСХОДИТ ОДНОВРЕМЕННО. ПОЭТОМУ ГЛАВНЫЙ
Dialogue: 0,0:10:45.07,0:10:49.87,Caption,,0,0,0,,ВОПРОС ЗДЕСЬ ДАЖЕ НЕ В ТОМ, КТО ГРОМЧЕ ВСЕХ ТРЕБУЕТ ПРОДОЛЖАТЬ. ВОПРОС ПРОЩЕ.
Dialogue: 0,0:10:50.20,0:10:52.35,Caption,,0,0,0,,КАКОЙ У КАЖДОГО ИЗ НИХ ФИНАЛЬНЫЙ ПЛАН?
Dialogue: 0,0:10:52.83,0:10:55.31,Caption,,0,0,0,,У АМЕРИКАНЦЕВ ПРИ ОПРЕДЕЛЁННОЙ ЛОГИКЕ ОН ХОТЯ БЫ
Dialogue: 0,0:10:55.31,0:10:58.59,Caption,,0,0,0,,ПРОСМАТРИВАЕТСЯ. ЕСЛИ ИМ НУЖЕН БЫЛ ОТКАЗ ЗЕЛЕНСКОГО,
Dialogue: 0,0:10:58.90,0:11:01.47,Caption,,0,0,0,,ОНИ ЭТОТ ОТКАЗ ПОЛУЧАЮТ И ДАЛЬШЕ МОГУТ МЕНЯТЬ
Dialogue: 0,0:11:01.47,0:11:03.95,Caption,,0,0,0,,СОБСТВЕННУЮ ПОЗИЦИЮ, ПОКАЗЫВАЯ ТРАМПУ,
Dialogue: 0,0:11:04.03,0:11:06.91,Caption,,0,0,0,,ЧТО КИЕВ НЕ ПРИНИМАЕТ ПРЕДЛОЖЕННУЮ КОМБИНАЦИЮ. У
Dialogue: 0,0:11:06.99,0:11:10.19,Caption,,0,0,0,,СУНАКА ТОЖЕ ЕСТЬ КОНКРЕТНОЕ ДЕЙСТВИЕ. ОЧЕНЬ ОПАСНОЕ,
Dialogue: 0,0:11:10.35,0:11:17.43,Caption,,0,0,0,,НО КОНКРЕТНОЕ. А У УКРАИНЫ? ДЕРЖАТЬСЯ. МОБИЛИЗОВАТЬ ДАЛЬШЕ. ЖДАТЬ ИЗМЕНЕНИЯ
Dialogue: 0,0:11:17.43,0:11:20.23,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВ. НО К КАКОЙ ТОЧКЕ ДОЛЖНА ПРИЙТИ
Dialogue: 0,0:11:20.31,0:11:23.27,Caption,,0,0,0,,СТРАНА? ВОТ ЭТОГО ОТВЕТА ПОКА И НЕ ВИДНО. И
Dialogue: 0,0:11:23.35,0:11:25.67,Caption,,0,0,0,,ЗДЕСЬ ИСТОРИЯ С АМЕРИКАНСКИМ ПРЕДЛОЖЕНИЕМ НАЧИНАЕТ
Dialogue: 0,0:11:25.75,0:11:28.23,Caption,,0,0,0,,ИГРАТЬ СОВСЕМ ДРУГИМИ КРАСКАМИ. ПОТОМУ ЧТО ЕСЛИ
Dialogue: 0,0:11:28.23,0:11:30.55,Caption,,0,0,0,,ВАШИНГТОН ДЕЙСТВИТЕЛЬНО ПРОВЕРЯЛ НЕ ГОТОВНОСТЬ
Dialogue: 0,0:11:30.55,0:11:33.59,Caption,,0,0,0,,ЗЕЛЕНСКОГО ПОДПИСАТЬ СДЕЛКУ, А ГОТОВНОСТЬ СКАЗАТЬ "НЕТ",
Dialogue: 0,0:11:33.91,0:11:36.87,Caption,,0,0,0,,ТОГДА ГЛАВНЫЙ РЕЗУЛЬТАТ РАЗГОВОРА УЖЕ ПОЛУЧЕН. А
Dialogue: 0,0:11:36.95,0:11:38.87,Caption,,0,0,0,,ДАЛЬШЕ ВОПРОС БУДЕТ СТОЯТЬ НЕ О ТОМ,
Dialogue: 0,0:11:39.03,0:11:41.51,Caption,,0,0,0,,ЧТО ЕЩЁ ПРЕДЛОЖИТЬ КИЕВУ. А О ТОМ,
Dialogue: 0,0:11:41.67,0:11:44.55,Caption,,0,0,0,,КТО И КАКОЙ ВЫВОД СДЕЛАЕТ ИЗ ПОЛУЧЕННОГО ОТВЕТА.
Dialogue: 0,0:11:44.87,0:11:47.43,Caption,,0,0,0,,И ВОТ ЭТО УЖЕ НАМНОГО ВАЖНЕЕ САМОГО ПРЕДЛОЖЕНИЯ.
