Dialogue: 0,0:00:00.12,0:00:02.62,Caption,,0,0,0,,ЗНАЕТЕ, В ЧЁМ ПРЕЛЕСТЬ НЕКОТОРЫХ СЕКРЕТОВ
Dialogue: 0,0:00:02.62,0:00:05.24,Caption,,0,0,0,,ПОЛИШИНЕЛЯ? ВСЕ ВСЁ ПРЕКРАСНО ПОНИМАЮТ,
Dialogue: 0,0:00:05.32,0:00:09.00,Caption,,0,0,0,,НО ПОПРОБУЙ ЕЩЁ ДОКАЖИ. И ТУТ ПОЯВЛЯЕТСЯ ЗЕЛЕНСКИЙ,
Dialogue: 0,0:00:09.16,0:00:11.35,Caption,,0,0,0,,КОТОРЫЙ САМ БЕРЁТСЯ ВСЁ ОБЪЯСНЯТЬ.
Dialogue: 0,0:00:11.35,0:00:15.17,Caption,,0,0,0,,КАЗАЛОСЬ БЫ, ЗАЧЕМ? ВЕДЬ ПОСЛЕ ТАКИХ ОБЪЯСНЕНИЙ НЕУДОБНЫЕ
Dialogue: 0,0:00:15.17,0:00:17.72,Caption,,0,0,0,,ВОПРОСЫ НАЧИНАЮТ ЗАДАВАТЬ УЖЕ НЕ ТОЛЬКО ЕМУ.
Dialogue: 0,0:00:17.72,0:00:19.56,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ ИСТОРИИ,
Dialogue: 0,0:00:19.80,0:00:21.60,Caption,,0,0,0,,В КОТОРЫХ ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ
Dialogue: 0,0:00:21.60,0:00:23.40,Caption,,0,0,0,,СКРЫВАЕТСЯ СОВСЕМ ДРУГАЯ КАРТИНА,
Dialogue: 0,0:00:23.58,0:00:25.66,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ИСТОРИЯ С ЛИВИЕЙ
Dialogue: 0,0:00:25.66,0:00:28.35,Caption,,0,0,0,,ПОЛУЧИЛАСЬ ПОЧТИ ОБРАЗЦОВАЯ. СНАЧАЛА ЗЕЛЕНСКИЙ
Dialogue: 0,0:00:28.35,0:00:30.92,Caption,,0,0,0,,ГОВОРИТ, ЧТО УКРАИНА НИКОГДА НЕ ДЕЙСТВУЕТ БЕЗ
Dialogue: 0,0:00:30.92,0:00:32.46,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНОГО СОГЛАСОВАНИЯ С
Dialogue: 0,0:00:32.46,0:00:34.68,Caption,,0,0,0,,ПАРТНЁРАМИ. ФОРМУЛИРОВКА УДОБНАЯ,
Dialogue: 0,0:00:34.83,0:00:37.34,Caption,,0,0,0,,КРАСИВАЯ И ОЧЕНЬ ШИРОКАЯ. НЕ ГДЕ ТО
Dialogue: 0,0:00:37.34,0:00:40.36,Caption,,0,0,0,,ТАМ ИНОГДА СОВЕТУЕМСЯ, А НИКОГДА НЕ ДЕЙСТВУЕМ БЕЗ
Dialogue: 0,0:00:40.36,0:00:43.94,Caption,,0,0,0,,СОГЛАСОВАНИЯ. И БУКВАЛЬНО РЯДОМ МИНИСТР ИНОСТРАННЫХ ДЕЛ ИТАЛИИ
Dialogue: 0,0:00:43.94,0:00:47.16,Caption,,0,0,0,,АНТОНИО ТАЯНИ ГОВОРИТ ОБРАТНОЕ. НИКТО ИЗ НАС НЕ БЫЛ
Dialogue: 0,0:00:47.16,0:00:49.64,Caption,,0,0,0,,ПРОИНФОРМИРОВАН. НИКТО НИЧЕГО НЕ ЗНАЛ
Dialogue: 0,0:00:49.64,0:00:52.36,Caption,,0,0,0,,О ТОМ, ЧТО УКРАИНЦЫ ДЕЛАЮТ В ЛИВИИ. ТО ЕСТЬ
Dialogue: 0,0:00:52.36,0:00:54.28,Caption,,0,0,0,,ОДИН ГОВОРИТ, ЧТО ВСЁ СОГЛАСОВАНО,
Dialogue: 0,0:00:54.52,0:00:57.87,Caption,,0,0,0,,ДРУГОЙ ОТВЕЧАЕТ РЕБЯТА, НАС ВООБЩЕ НИКТО НЕ СПРАШИВАЛ. КАК ТО
Dialogue: 0,0:00:57.87,0:01:00.45,Caption,,0,0,0,,НЕУДОБНО ПОЛУЧИЛОСЬ. ПОТОМ ПРОХОДИТ РАЗГОВОР С
Dialogue: 0,0:01:00.45,0:01:03.32,Caption,,0,0,0,,ДЖОРДЖЕЙ МЕЛОНИ, И ЗЕЛЕНСКИЙ УЖЕ ПОДТВЕРЖДАЕТ,
Dialogue: 0,0:01:03.48,0:01:05.62,Caption,,0,0,0,,ЧТО ОПЕРАЦИЯ В ЛИВИИ БЫЛА ПРОВЕДЕНА
Dialogue: 0,0:01:05.62,0:01:07.33,Caption,,0,0,0,,БЕЗ ПРЕДВАРИТЕЛЬНОЙ КООРДИНАЦИИ С
Dialogue: 0,0:01:07.33,0:01:11.93,Caption,,0,0,0,,ЕВРОПЕЙСКИМИ ПАРТНЁРАМИ. ЗАОДНО ОБЕЩАЕТ,
Dialogue: 0,0:01:12.09,0:01:13.95,Caption,,0,0,0,,ЧТО СООТВЕТСТВУЮЩИЕ ОРГАНЫ ТЕПЕРЬ
Dialogue: 0,0:01:13.95,0:01:16.15,Caption,,0,0,0,,БУДУТ ЛУЧШЕ ОБМЕНИВАТЬСЯ ИНФОРМАЦИЕЙ И
Dialogue: 0,0:01:16.15,0:01:19.80,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ ПРЯМУЮ, РЕГУЛЯРНУЮ СВЯЗЬ. НУ ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:01:19.80,0:01:22.65,Caption,,0,0,0,,СНАЧАЛА ВСЁ СОГЛАСОВАНО. ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:01:22.79,0:01:24.84,Caption,,0,0,0,,ЧТО НИЧЕГО НЕ СОГЛАСОВАНО. А ПОТОМ
Dialogue: 0,0:01:24.84,0:01:26.98,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ОБЕЩАНИЕ В СЛЕДУЮЩИЙ РАЗ ЛУЧШЕ
Dialogue: 0,0:01:26.98,0:01:30.01,Caption,,0,0,0,,РАЗГОВАРИВАТЬ ДРУГ С ДРУГОМ. ПРЯМ СЕМЕЙНАЯ ТЕРАПИЯ,
Dialogue: 0,0:01:30.25,0:01:32.31,Caption,,0,0,0,,ТОЛЬКО ОБСУЖДАЮТ НЕ РАЗБИТУЮ ЧАШКУ НА
Dialogue: 0,0:01:32.31,0:01:35.14,Caption,,0,0,0,,КУХНЕ, А ВОЕННУЮ ОПЕРАЦИЮ В ЛИВИИ. ПО ДАННЫМ
Dialogue: 0,0:01:35.14,0:01:37.65,Caption,,0,0,0,,BLOOMBERG, РАЗГОВОР ЗЕЛЕНСКОГО С МЕЛОНИ БЫЛ
Dialogue: 0,0:01:37.65,0:01:40.85,Caption,,0,0,0,,НАПРЯЖЁННЫМ. ИТАЛЬЯНСКОГО ПРЕМЬЕРА РАЗОЗЛИЛО ИМЕННО
Dialogue: 0,0:01:40.85,0:01:43.45,Caption,,0,0,0,,ОТСУТСТВИЕ ПРЕДУПРЕЖДЕНИЯ. БОЛЕЕ ТОГО,
Dialogue: 0,0:01:43.61,0:01:46.17,Caption,,0,0,0,,ИСТОРИЯ УЖЕ СОЗДАЁТ ДЛЯ НЕЁ ВНУТРИПОЛИТИЧЕСКИЕ
Dialogue: 0,0:01:46.17,0:01:48.65,Caption,,0,0,0,,ПРОБЛЕМЫ, А ОТНОШЕНИЯ РИМА И КИЕВА,
Dialogue: 0,0:01:48.88,0:01:50.85,Caption,,0,0,0,,КОТОРЫЕ ЕЩЁ НЕДАВНО ВЫГЛЯДЕЛИ ВПОЛНЕ
Dialogue: 0,0:01:50.85,0:01:53.49,Caption,,0,0,0,,ТЁПЛЫМИ, ЗАМЕТНО ОХЛАДИЛИСЬ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:01:53.49,0:01:56.52,Caption,,0,0,0,,НАЧИНАЕТСЯ КУДА БОЛЕЕ ИНТЕРЕСНАЯ ЧАСТЬ. ПРОБЛЕМА ВЕДЬ
Dialogue: 0,0:01:56.52,0:01:59.82,Caption,,0,0,0,,НЕ ТОЛЬКО В ТОМ, СОГЛАСОВЫВАЛА УКРАИНА КОНКРЕТНЫЙ УДАР
Dialogue: 0,0:01:59.82,0:02:02.59,Caption,,0,0,0,,С ИТАЛИЕЙ ИЛИ НЕ СОГЛАСОВЫВАЛА. ЕСТЬ ЕЩЁ ГОРАЗДО
Dialogue: 0,0:02:02.59,0:02:05.66,Caption,,0,0,0,,БОЛЕЕ ПРОСТОЙ ВОПРОС. КАК ВООБЩЕ УКРАИНСКИЕ МОРСКИЕ
Dialogue: 0,0:02:05.66,0:02:07.53,Caption,,0,0,0,,БЕСПИЛОТНИКИ ОКАЗАЛИСЬ У БЕНГАЗИ?
Dialogue: 0,0:02:07.92,0:02:11.16,Caption,,0,0,0,,ЗЕЛЕНСКИЙ САМ ГОВОРИЛ, ЧТО В ОПЕРАЦИИ ИСПОЛЬЗОВАЛИСЬ СЕМЬ
Dialogue: 0,0:02:11.16,0:02:12.98,Caption,,0,0,0,,МОРСКИХ БЕСПИЛОТНИКОВ УКРАИНСКОГО
Dialogue: 0,0:02:12.98,0:02:15.87,Caption,,0,0,0,,ПРОИЗВОДСТВА. МЕСТО ЗАПУСКА ОН НЕ НАЗВАЛ. ДО ЭТОГО
Dialogue: 0,0:02:15.87,0:02:19.25,Caption,,0,0,0,,ПОЯВЛЯЛАСЬ ВЕРСИЯ О ЗАПУСКЕ С ТЕРРИТОРИИ АЛБАНИИ. БЫЛА И
Dialogue: 0,0:02:19.25,0:02:21.77,Caption,,0,0,0,,ДРУГАЯ ВЕРСИЯ, О БАЗЕ НА ЗАПАДЕ ЛИВИИ.
Dialogue: 0,0:02:24.06,0:02:26.49,Caption,,0,0,0,,НО ГЕОГРАФИЯ НИКУДА НЕ ДЕВАЕТСЯ. ЕСЛИ
Dialogue: 0,0:02:26.49,0:02:28.78,Caption,,0,0,0,,КАТЕР СТАРТУЕТ ИЗ ОДЕССЫ СВОИМ ХОДОМ,
Dialogue: 0,0:02:29.01,0:02:31.66,Caption,,0,0,0,,ЕМУ НАДО ПРОЙТИ ЧЁРНОЕ МОРЕ, БОСФОР,
Dialogue: 0,0:02:31.74,0:02:35.01,Caption,,0,0,0,,МРАМОРНОЕ МОРЕ, ДАРДАНЕЛЛЫ, ЭГЕЙСКОЕ МОРЕ,
Dialogue: 0,0:02:35.25,0:02:37.22,Caption,,0,0,0,,ПОТОМ ЕЩЁ ДОБРАТЬСЯ ДО ЛИВИЙСКОГО
Dialogue: 0,0:02:37.22,0:02:40.04,Caption,,0,0,0,,ПОБЕРЕЖЬЯ. ДЛЯ БЕЗЭКИПАЖНОГО КАТЕРА ЭТО НЕ ПРОГУЛКА
Dialogue: 0,0:02:40.04,0:02:43.30,Caption,,0,0,0,,ПОСЛЕ УЖИНА. ПОЭТОМУ ВОПРОС ЛОГИСТИКИ ВОЗНИКАЕТ САМ
Dialogue: 0,0:02:43.30,0:02:46.45,Caption,,0,0,0,,СОБОЙ. ЕГО ОТКУДА ТО ДОСТАВИЛИ. КУДА ТО ПРИВЕЗЛИ.
Dialogue: 0,0:02:46.45,0:02:49.25,Caption,,0,0,0,,ГДЕ ТО СПУСТИЛИ НА ВОДУ. КТО ТО ОБЕСПЕЧИЛ
Dialogue: 0,0:02:49.25,0:02:52.86,Caption,,0,0,0,,МАРШРУТ, ХРАНЕНИЕ, ПЕРЕВОЗКУ ИЛИ ПЛОЩАДКУ ДЛЯ ЗАПУСКА.
Dialogue: 0,0:02:53.49,0:02:55.40,Caption,,0,0,0,,И ЗДЕСЬ УЖЕ СТАНОВИТСЯ ИНТЕРЕСНЫМ
Dialogue: 0,0:02:55.40,0:02:57.83,Caption,,0,0,0,,ДРУГОЕ. ИТАЛИЯ МОГЛА ДЕЙСТВИТЕЛЬНО НЕ ЗНАТЬ О
Dialogue: 0,0:02:57.83,0:03:00.94,Caption,,0,0,0,,КОНКРЕТНОЙ ЦЕЛИ, КОНКРЕТНОМ ВРЕМЕНИ И КОНКРЕТНОЙ
Dialogue: 0,0:03:00.94,0:03:04.39,Caption,,0,0,0,,КОМАНДЕ НА УДАР. НО ОТСУТСТВИЕ СОГЛАСОВАНИЯ САМОГО УДАРА
Dialogue: 0,0:03:04.39,0:03:07.35,Caption,,0,0,0,,НЕ ОБЪЯСНЯЕТ, КАКИМ ОБРАЗОМ ТЕХНИКА ФИЗИЧЕСКИ
Dialogue: 0,0:03:07.35,0:03:10.62,Caption,,0,0,0,,ОКАЗАЛАСЬ ЗА ТЫСЯЧИ КИЛОМЕТРОВ ОТ УКРАИНСКОГО ПОБЕРЕЖЬЯ.
Dialogue: 0,0:03:10.62,0:03:13.19,Caption,,0,0,0,,ВОТ ЭТО ДВЕ СОВЕРШЕННО РАЗНЫЕ ВЕЩИ. МОЖНО НЕ
Dialogue: 0,0:03:13.19,0:03:16.31,Caption,,0,0,0,,УЧАСТВОВАТЬ В ПРИНЯТИИ РЕШЕНИЯ НАЖАТЬ КНОПКУ. НО ДЛЯ
Dialogue: 0,0:03:16.31,0:03:18.70,Caption,,0,0,0,,САМОЙ ОПЕРАЦИИ ВСЁ РАВНО НУЖНЫ ЛОГИСТИКА,
Dialogue: 0,0:03:18.78,0:03:21.50,Caption,,0,0,0,,ИНФРАСТРУКТУРА, ТРАНСПОРТ, ЛЮДИ,
Dialogue: 0,0:03:21.57,0:03:25.62,Caption,,0,0,0,,БАЗЫ, ПОРТЫ И МАРШРУТЫ, БЕЗ КОТОРЫХ КНОПКА ВООБЩЕ НЕ ИМЕЛА БЫ
Dialogue: 0,0:03:25.62,0:03:28.28,Caption,,0,0,0,,СМЫСЛА. ПОЭТОМУ ФРАЗА "МЫ НИЧЕГО НЕ ЗНАЛИ"
Dialogue: 0,0:03:28.28,0:03:31.24,Caption,,0,0,0,,ЗАКРЫВАЕТ ТОЛЬКО ОДИН ВОПРОС. ОНА НЕ ЗАКРЫВАЕТ ВСЮ
Dialogue: 0,0:03:31.24,0:03:33.92,Caption,,0,0,0,,ЦЕПОЧКУ. АЛБАНСКАЯ ВЕРСИЯ В ЭТОЙ ИСТОРИИ
Dialogue: 0,0:03:33.92,0:03:36.73,Caption,,0,0,0,,ПОЯВИЛАСЬ НЕ СЛУЧАЙНО. АЛБАНСКАЯ СТОРОНА ОТ НЕЁ
Dialogue: 0,0:03:36.73,0:03:41.67,Caption,,0,0,0,,ОТКРЕСТИЛАСЬ. И ЭТО ТОЖЕ СОВЕРШЕННО ПОНЯТНАЯ
Dialogue: 0,0:03:41.67,0:03:45.06,Caption,,0,0,0,,РЕАКЦИЯ. ПОТОМУ ЧТО ОДНО ДЕЛО ПОМОГАТЬ УКРАИНЕ ОРУЖИЕМ,
Dialogue: 0,0:03:45.14,0:03:47.10,Caption,,0,0,0,,ДЕНЬГАМИ ИЛИ ТЕХНИКОЙ В РАМКАХ ДАВНО
Dialogue: 0,0:03:47.10,0:03:49.61,Caption,,0,0,0,,ОБЪЯВЛЕННОЙ ПОЛИТИКИ. И СОВСЕМ ДРУГОЕ ДЕЛО
Dialogue: 0,0:03:49.61,0:03:52.70,Caption,,0,0,0,,ОБНАРУЖИТЬ СВОЁ ИМЯ РЯДОМ С УДАРОМ НА ТЕРРИТОРИИ ТРЕТЬЕЙ
Dialogue: 0,0:03:52.70,0:03:56.18,Caption,,0,0,0,,СТРАНЫ. ЛОГИКА ОПЕРАЦИИ ВЕДЁТ К ПРОСТОЙ МЫСЛИ.
Dialogue: 0,0:03:56.18,0:03:58.81,Caption,,0,0,0,,ОРУЖИЕ ТАЩИТСЯ НЕ ТОЛЬКО В СТОРОНУ УКРАИНЫ.
Dialogue: 0,0:03:58.81,0:04:02.03,Caption,,0,0,0,,ОНО ИДЁТ И С УКРАИНЫ. И ТОГДА ВАЖНЕЕ ДРУГОЕ.
Dialogue: 0,0:04:02.03,0:04:04.18,Caption,,0,0,0,,КТО ДАЛ РАЗРЕШЕНИЕ НА КОНКРЕТНЫЙ УДАР,
Dialogue: 0,0:04:04.42,0:04:06.32,Caption,,0,0,0,,И КТО ВООБЩЕ ОБЕСПЕЧИВАЕТ ВСЮ ДОРОГУ
Dialogue: 0,0:04:06.32,0:04:09.89,Caption,,0,0,0,,ДО ТОЧКИ ЗАПУСКА? ОТСЮДА И РОЖДАЕТСЯ ВПОЛНЕ ЛОГИЧНАЯ
Dialogue: 0,0:04:09.89,0:04:12.50,Caption,,0,0,0,,ВЕРСИЯ. КИЕВ РАСШИРЯЕТ ГЕОГРАФИЮ ОПЕРАЦИЙ,
Dialogue: 0,0:04:12.74,0:04:14.90,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ПУБЛИЧНО ДИСТАНЦИРУЮТСЯ,
Dialogue: 0,0:04:15.20,0:04:17.59,Caption,,0,0,0,,А БРИТАНЦЫ В ЭТОЙ ИСТОРИИ ПРЕДПОЧИТАЮТ
Dialogue: 0,0:04:17.59,0:04:19.92,Caption,,0,0,0,,МОЛЧАТЬ. ТАМ УЖЕ НАЧИНАЮТСЯ ВОПРОСЫ НЕ
Dialogue: 0,0:04:19.92,0:04:22.62,Caption,,0,0,0,,ТЕЛЕВИЗИОННЫЕ. ТАМ НАЧИНАЮТ СПРАШИВАТЬ ДРУГИЕ
Dialogue: 0,0:04:22.62,0:04:25.77,Caption,,0,0,0,,ГОСУДАРСТВА. ЛИВИЙСКАЯ НАЦИОНАЛЬНАЯ АРМИЯ УЖЕ ПООБЕЩАЛА
Dialogue: 0,0:04:25.77,0:04:28.76,Caption,,0,0,0,,ОТВЕТИТЬ НА АТАКУ БЕЗЭКИПАЖНЫХ КАТЕРОВ В БЕНГАЗИ. В
Dialogue: 0,0:04:28.76,0:04:32.29,Caption,,0,0,0,,РЕЗУЛЬТАТЕ ПОГИБЛИ ДВОЕ ВОЕННОСЛУЖАЩИХ. ГЕНШТАБ ЛНА
Dialogue: 0,0:04:32.29,0:04:34.95,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО ОТВЕТ ПОСЛЕДУЕТ В НАДЛЕЖАЩЕЕ
Dialogue: 0,0:04:34.95,0:04:37.61,Caption,,0,0,0,,ВРЕМЯ, В НАДЛЕЖАЩЕМ МЕСТЕ И НАДЛЕЖАЩИМИ
Dialogue: 0,0:04:37.61,0:04:41.20,Caption,,0,0,0,,СРЕДСТВАМИ. ПРИЧЁМ ДАЖЕ ЗДЕСЬ ЕСТЬ ЗАНЯТНАЯ ДЕТАЛЬ. НЕ
Dialogue: 0,0:04:41.20,0:04:44.42,Caption,,0,0,0,,УТОЧНЯЕТСЯ, КОМУ ИМЕННО АДРЕСОВАН ЭТОТ ОТВЕТ.
Dialogue: 0,0:04:44.42,0:04:46.66,Caption,,0,0,0,,УКРАИНЕ ИЛИ ВЛАСТЯМ ЗАПАДНОЙ ЛИВИИ,
Dialogue: 0,0:04:46.87,0:04:48.72,Caption,,0,0,0,,КОТОРЫХ ПОДОЗРЕВАЮТ В СОДЕЙСТВИИ
Dialogue: 0,0:04:48.72,0:04:53.04,Caption,,0,0,0,,КИЕВУ. А ВЛАСТИ ЗАПАДНОЙ ЛИВИИ ТУТ ЖЕ
Dialogue: 0,0:04:53.04,0:04:55.81,Caption,,0,0,0,,ЗАЯВИЛИ, ЧТО К АТАКЕ ОТНОШЕНИЯ НЕ ИМЕЮТ И С
Dialogue: 0,0:04:55.81,0:04:58.61,Caption,,0,0,0,,УКРАИНОЙ В ЭТОЙ ОПЕРАЦИИ НЕ СОТРУДНИЧАЛИ. ТО ЕСТЬ
Dialogue: 0,0:04:58.61,0:05:00.44,Caption,,0,0,0,,ВОКРУГ ОДНОЙ АТАКИ УЖЕ НЕСКОЛЬКО
Dialogue: 0,0:05:00.44,0:05:03.57,Caption,,0,0,0,,СТОРОН ОБЪЯСНЯЮТ, ЧТО ОНИ ЗДЕСЬ ВООБЩЕ НИ ПРИ ЧЁМ. ОЧЕНЬ
Dialogue: 0,0:05:03.57,0:05:07.00,Caption,,0,0,0,,УДОБНАЯ КОНСТРУКЦИЯ, ПОКА ВСЕ МОЛЧАТ. ВОТ ПОЭТОМУ
Dialogue: 0,0:05:07.00,0:05:10.72,Caption,,0,0,0,,ЗЕЛЕНСКИЙ, ПО СУТИ, НЕ ОТКРЫЛ НИКАКОГО НОВОГО СЕКРЕТА
Dialogue: 0,0:05:10.72,0:05:12.85,Caption,,0,0,0,,ПОЛИШИНЕЛЯ. ОН ПРОСТО БОЛТНУЛ ТО,
Dialogue: 0,0:05:12.94,0:05:14.79,Caption,,0,0,0,,ЧТО НЕ НУЖНО БЫЛО БОЛТАТЬ. СЕКРЕТ
Dialogue: 0,0:05:14.79,0:05:17.65,Caption,,0,0,0,,ПОЛИШИНЕЛЯ ТЕМ И ХОРОШ, ЧТО ВСЕ ВСЁ ПОНИМАЮТ,
Dialogue: 0,0:05:17.89,0:05:19.59,Caption,,0,0,0,,НО ДОКАЗАТЬ КОНКРЕТНОЕ УЧАСТИЕ
Dialogue: 0,0:05:19.59,0:05:22.85,Caption,,0,0,0,,КОНКРЕТНОЙ СТОРОНЫ БЫВАЕТ КРАЙНЕ ТРУДНО. НИКТО НЕ ПОЙМАН
Dialogue: 0,0:05:22.85,0:05:25.57,Caption,,0,0,0,,ЗА РУКУ. НИКТО НЕ ПОДПИСАЛ БУМАГУ. НИКТО
Dialogue: 0,0:05:25.57,0:05:28.29,Caption,,0,0,0,,ПУБЛИЧНО НЕ СКАЗАЛ ДА, МЫ ДАЛИ БАЗУ,
Dialogue: 0,0:05:28.45,0:05:30.93,Caption,,0,0,0,,МЫ ПЕРЕВЕЗЛИ ТЕХНИКУ, МЫ ЗНАЛИ МАРШРУТ,
Dialogue: 0,0:05:31.16,0:05:33.18,Caption,,0,0,0,,МЫ ПОМОГАЛИ ЗАПУСКАТЬ. И У КАЖДОГО
Dialogue: 0,0:05:33.18,0:05:36.05,Caption,,0,0,0,,ОСТАЁТСЯ ПРОСТРАНСТВО СКАЗАТЬ НАС ТАМ НЕ БЫЛО.
Dialogue: 0,0:05:36.05,0:05:38.83,Caption,,0,0,0,,А ТУТ РАЗ, И ПО ВОПРОСУ КООРДИНАЦИИ ЧАСТЬ
Dialogue: 0,0:05:38.83,0:05:41.39,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВ САМ ВЫВАЛИЛ. СНАЧАЛА СКАЗАЛ ПРО
Dialogue: 0,0:05:41.39,0:05:44.75,Caption,,0,0,0,,СОГЛАСОВАНИЕ С ПАРТНЁРАМИ, ПОТОМ ПОСЛЕ РАЗГОВОРА С МЕЛОНИ
Dialogue: 0,0:05:44.75,0:05:47.25,Caption,,0,0,0,,ПРИЗНАЛ, ЧТО ПРЕДВАРИТЕЛЬНОЙ КООРДИНАЦИИ НЕ
Dialogue: 0,0:05:47.25,0:05:50.03,Caption,,0,0,0,,БЫЛО. ВОТ ЭТО УЖЕ ДРУГАЯ ИСТОРИЯ. ПОТОМУ ЧТО ДО
Dialogue: 0,0:05:50.03,0:05:53.38,Caption,,0,0,0,,ПУБЛИЧНОГО ПРИЗНАНИЯ У ПОЛИТИКА ЕСТЬ ПРОСТРАНСТВО ДЛЯ
Dialogue: 0,0:05:53.38,0:05:57.21,Caption,,0,0,0,,МАНЁВРА. МОЖНО ГОВОРИТЬ, ЧТО ИНФОРМАЦИИ НЕТ. МОЖНО ССЫЛАТЬСЯ НА
Dialogue: 0,0:05:57.21,0:06:00.30,Caption,,0,0,0,,СПЕЦСЛУЖБЫ. МОЖНО ВООБЩЕ НЕ ОТВЕЧАТЬ. А ПОСЛЕ
Dialogue: 0,0:06:00.30,0:06:03.33,Caption,,0,0,0,,ПУБЛИЧНОЙ ФРАЗЫ ПАРТНЁРА ПРИХОДИТСЯ ЛИБО СОГЛАШАТЬСЯ,
Dialogue: 0,0:06:03.57,0:06:08.88,Caption,,0,0,0,,ЛИБО ЕГО ОПРОВЕРГАТЬ. ТАЯНИ ВЫБРАЛ ВТОРОЙ ВАРИАНТ. И
Dialogue: 0,0:06:08.88,0:06:11.62,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ЗАТЕМ ФАКТИЧЕСКИ ОТСТУПИЛ ОТ СОБСТВЕННОЙ
Dialogue: 0,0:06:11.62,0:06:14.76,Caption,,0,0,0,,ПЕРВОЙ ФОРМУЛИРОВКИ, ПРИЗНАВ ОТСУТСТВИЕ ПРЕДВАРИТЕЛЬНОЙ
Dialogue: 0,0:06:14.76,0:06:19.28,Caption,,0,0,0,,КООРДИНАЦИИ. ЗАЧЕМ? ВОТ ЭТО САМЫЙ ПРОСТОЙ ВОПРОС ВО ВСЕЙ
Dialogue: 0,0:06:19.28,0:06:22.11,Caption,,0,0,0,,ИСТОРИИ. ЧТО ТАКОГО ЗНАЧИТЕЛЬНОГО ПРИОБРЁЛ
Dialogue: 0,0:06:22.11,0:06:24.55,Caption,,0,0,0,,ЗЕЛЕНСКИЙ, ЧТО РАДИ ЭТОГО СТОИЛО СТАВИТЬ
Dialogue: 0,0:06:24.55,0:06:26.90,Caption,,0,0,0,,СОБСТВЕННЫХ ПАРТНЁРОВ В НЕУДОБНОЕ ПОЛОЖЕНИЕ?
Dialogue: 0,0:06:27.30,0:06:30.10,Caption,,0,0,0,,ЧТО ИЗМЕНИЛОСЬ БЫ, ЕСЛИ БЫ ОН ПРОСТО ПРОМОЛЧАЛ?
Dialogue: 0,0:06:30.50,0:06:32.51,Caption,,0,0,0,,КОРАБЛИ ОТ ЭТОГО НЕ ВОССТАНОВИЛИСЬ БЫ.
Dialogue: 0,0:06:32.51,0:06:35.57,Caption,,0,0,0,,РЕЗУЛЬТАТ ОПЕРАЦИИ НЕ ИСЧЕЗ БЫ. УКРАИНА НЕ СТАЛА
Dialogue: 0,0:06:35.57,0:06:39.40,Caption,,0,0,0,,БЫ СЛАБЕЕ ТОЛЬКО ПОТОМУ, ЧТО ПРЕЗИДЕНТ НЕ РАССКАЗАЛ ЛИШНЕГО.
Dialogue: 0,0:06:39.40,0:06:42.43,Caption,,0,0,0,,ЗАТО У МЕЛОНИ НЕ ПОЯВИЛОСЬ БЫ НЕОБХОДИМОСТИ ПУБЛИЧНО
Dialogue: 0,0:06:42.43,0:06:46.03,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЗНАЛА ИТАЛИЯ ОБ ОПЕРАЦИИ ИЛИ НЕ ЗНАЛА.
Dialogue: 0,0:06:46.03,0:06:48.19,Caption,,0,0,0,,И ВЕДЬ ЭТО НЕ ПЕРВЫЙ ПОДОБНЫЙ РАЗГОВОР.
Dialogue: 0,0:06:48.19,0:06:50.92,Caption,,0,0,0,,ДЖАРЕД КУШНЕР ПРЯМО УКАЗЫВАЛ НА ПРИВЫЧКУ УКРАИНСКОЙ
Dialogue: 0,0:06:50.92,0:06:53.54,Caption,,0,0,0,,СТОРОНЫ ВЫНОСИТЬ ДЕТАЛИ ПЕРЕГОВОРНОГО ПРОЦЕССА
Dialogue: 0,0:06:53.54,0:06:56.10,Caption,,0,0,0,,В ПУБЛИЧНОЕ ПРОСТРАНСТВО. ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:06:56.34,0:06:58.74,Caption,,0,0,0,,ИМЕННО ТАКАЯ ТАКТИКА МЕШАЕТ ДОСТИЖЕНИЮ
Dialogue: 0,0:06:58.74,0:07:00.82,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ. ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:07:01.14,0:07:04.78,Caption,,0,0,0,,РЕЧЬ ДАЖЕ НЕ О ТОМ, КТО ПРАВ В СПОРЕ. РЕЧЬ О САМОЙ
Dialogue: 0,0:07:04.78,0:07:07.26,Caption,,0,0,0,,МЕХАНИКЕ ПЕРЕГОВОРОВ. ЕСЛИ ЛЮДИ САДЯТСЯ
Dialogue: 0,0:07:07.26,0:07:10.10,Caption,,0,0,0,,ОБСУЖДАТЬ ЧТО ТО ЗАКРЫТО, ОНИ РАССЧИТЫВАЮТ,
Dialogue: 0,0:07:10.34,0:07:12.49,Caption,,0,0,0,,ЧТО ЧЕРЕЗ ЧАС СОДЕРЖАНИЕ РАЗГОВОРА НЕ
Dialogue: 0,0:07:12.49,0:07:15.29,Caption,,0,0,0,,ОКАЖЕТСЯ ПЕРЕД ТЕЛЕКАМЕРАМИ В УДОБНОЙ ДЛЯ ОДНОЙ
Dialogue: 0,0:07:15.29,0:07:18.18,Caption,,0,0,0,,СТОРОНЫ ВЕРСИИ. И ТУТ ВСПОМИНАЕТСЯ ЮЖНАЯ КОРЕЯ.
Dialogue: 0,0:07:20.39,0:07:22.13,Caption,,0,0,0,,ТАМ ПОСЛЕ РАСКРЫТИЯ ИНФОРМАЦИИ О
Dialogue: 0,0:07:22.13,0:07:25.27,Caption,,0,0,0,,СЕВЕРОКОРЕЙСКИХ ПЛЕННЫХ СЕУЛ СЧЁЛ УКРАИНСКИЕ ИЗВИНЕНИЯ
Dialogue: 0,0:07:25.27,0:07:27.46,Caption,,0,0,0,,НЕДОСТАТОЧНЫМИ И ДАЖЕ РАССМАТРИВАЛ
Dialogue: 0,0:07:27.46,0:07:31.48,Caption,,0,0,0,,ОТЗЫВ СВОЕГО ПОСЛА. ПОЗЖЕ ЮЖНОКОРЕЙСКАЯ ОБОРОННАЯ КОМПАНИЯ
Dialogue: 0,0:07:31.48,0:07:33.95,Caption,,0,0,0,,ПРЕКРАТИЛА СОТРУДНИЧЕСТВО С УКРАИНСКИМИ ВОЕННЫМИ
Dialogue: 0,0:07:33.95,0:07:38.55,Caption,,0,0,0,,НА ФОНЕ УХУДШЕНИЯ ОТНОШЕНИЙ. ВАЖНА ДРУГАЯ ВЕЩЬ. И ТАМ ПУБЛИЧНОСТЬ
Dialogue: 0,0:07:38.55,0:07:40.44,Caption,,0,0,0,,НЕ ДАЛА КИЕВУ КАКОГО ТО ПОНЯТНОГО
Dialogue: 0,0:07:40.44,0:07:44.35,Caption,,0,0,0,,ПРАКТИЧЕСКОГО ВЫИГРЫША, ЗАТО СОЗДАЛА ПРОБЛЕМЫ ПАРТНЁРУ. ВОТ
Dialogue: 0,0:07:44.35,0:07:47.35,Caption,,0,0,0,,ГДЕ АРИФМЕТИКА НЕ СХОДИТСЯ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ,
Dialogue: 0,0:07:47.51,0:07:49.56,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПУБЛИЧНЫЙ
Dialogue: 0,0:07:49.56,0:07:52.72,Caption,,0,0,0,,ЭФФЕКТ ЕСТЬ СРАЗУ. ЗАГОЛОВКИ ЕСТЬ. ГРОМКОЕ
Dialogue: 0,0:07:52.72,0:07:56.46,Caption,,0,0,0,,ЗАЯВЛЕНИЕ ЕСТЬ. ШАНС ПОКАЗАТЬ СОБСТВЕННУЮ РЕШИТЕЛЬНОСТЬ
Dialogue: 0,0:07:56.46,0:07:58.74,Caption,,0,0,0,,ТОЖЕ ЕСТЬ. А ПОТОМ ПАРТНЁРЫ НАЧИНАЮТ ТУШИТЬ
Dialogue: 0,0:07:58.74,0:08:02.11,Caption,,0,0,0,,ПОСЛЕДСТВИЯ У СЕБЯ ДОМА. НУ НИЧЕГО НЕ МЕНЯЕТСЯ. ПИАР
Dialogue: 0,0:08:02.11,0:08:05.37,Caption,,0,0,0,,ВАЖНЕЕ, ЧЕМ СУТЬ ДЕЛА. ПИАР ПРЕВЫШЕ ВСЕГО.
Dialogue: 0,0:08:05.37,0:08:08.24,Caption,,0,0,0,,ХАЙП ПРЕВЫШЕ ВСЕГО. ПРИЧЁМ В ЛИВИИ ЦЕНА ЭТОЙ
Dialogue: 0,0:08:08.24,0:08:11.35,Caption,,0,0,0,,ПРИВЫЧКИ СТАНОВИТСЯ ВЫШЕ. ЗДЕСЬ УЖЕ РЕЧЬ НЕ ТОЛЬКО О
Dialogue: 0,0:08:11.35,0:08:14.01,Caption,,0,0,0,,РАЗДРАЖЁННОМ СОЮЗНИКЕ ИЛИ СОРВАННОЙ АТМОСФЕРЕ
Dialogue: 0,0:08:14.01,0:08:16.31,Caption,,0,0,0,,ПЕРЕГОВОРОВ. ЗДЕСЬ ПОЯВЛЯЕТСЯ СТОРОНА,
Dialogue: 0,0:08:16.47,0:08:18.80,Caption,,0,0,0,,КОТОРАЯ ПРЯМО ОБЕЩАЕТ ОТВЕТ. И ЭТО
Dialogue: 0,0:08:18.80,0:08:22.36,Caption,,0,0,0,,ВАЖНЫЙ ПОВОРОТ. ПОКА КОНФЛИКТ ЖИВЁТ ВНУТРИ ПРИВЫЧНОЙ
Dialogue: 0,0:08:22.36,0:08:25.01,Caption,,0,0,0,,ГЕОГРАФИИ, У ВСЕХ УЖЕ ВЫРАБОТАЛИСЬ ПРАВИЛА
Dialogue: 0,0:08:25.01,0:08:28.70,Caption,,0,0,0,,ПОВЕДЕНИЯ. КТО ЧТО ПОСТАВЛЯЕТ. КТО ЧТО ФИНАНСИРУЕТ. КТО
Dialogue: 0,0:08:28.70,0:08:31.99,Caption,,0,0,0,,ДЕЛАЕТ ВИД, ЧТО НИ ПРИ ЧЁМ. КТО ГОВОРИТ ГРОМКО,
Dialogue: 0,0:08:32.15,0:08:37.37,Caption,,0,0,0,,А КТО ПРЕДПОЧИТАЕТ МОЛЧАТЬ. НО КОГДА УКРАИНСКИЕ МОРСКИЕ
Dialogue: 0,0:08:37.37,0:08:39.61,Caption,,0,0,0,,БЕСПИЛОТНИКИ ОКАЗЫВАЮТСЯ У БЕРЕГОВ ЛИВИИ,
Dialogue: 0,0:08:39.93,0:08:42.34,Caption,,0,0,0,,ГЕОГРАФИЯ НАЧИНАЕТ РАСПОЛЗАТЬСЯ. РЯДОМ
Dialogue: 0,0:08:42.34,0:08:44.72,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЕЩЁ КУВЕЙТ. ТАМ ПОСЛЕ УДАРА
Dialogue: 0,0:08:44.72,0:08:48.51,Caption,,0,0,0,,БЕСПИЛОТНИКА ПОГИБЛИ ДВОЕ ИТАЛЬЯНСКИХ СПЕЦИАЛИСТОВ. КУВЕЙТ
Dialogue: 0,0:08:48.51,0:08:50.99,Caption,,0,0,0,,И ИТАЛИЯ ВОЗЛАГАЮТ ОТВЕТСТВЕННОСТЬ НА ИРАН.
Dialogue: 0,0:08:50.99,0:08:53.48,Caption,,0,0,0,,ТЕГЕРАН ЭТО ОТВЕРГАЕТ И ГОВОРИТ ОБ ОПЕРАЦИИ ПОД
Dialogue: 0,0:08:53.48,0:08:56.60,Caption,,0,0,0,,ЧУЖИМ ФЛАГОМ. ИРАНСКИЕ ИСТОЧНИКИ ВЫДВИНУЛИ ВЕРСИЮ ОБ
Dialogue: 0,0:08:56.60,0:08:58.65,Caption,,0,0,0,,УКРАИНСКОМ СЛЕДЕ. ПО ИХ ВЕРСИИ,
Dialogue: 0,0:08:58.81,0:09:00.64,Caption,,0,0,0,,СМЫСЛ ТАКОЙ ОПЕРАЦИИ СОСТОЯЛ В
Dialogue: 0,0:09:00.64,0:09:04.04,Caption,,0,0,0,,РАСШИРЕНИИ КОНФЛИКТА В ПЕРСИДСКОМ ЗАЛИВЕ И ВТЯГИВАНИИ В
Dialogue: 0,0:09:04.04,0:09:06.81,Caption,,0,0,0,,НЕГО ЕВРОПЫ. ПОДТВЕРЖДЕНИЙ ЭТОЙ ВЕРСИИ НЕ
Dialogue: 0,0:09:06.81,0:09:09.93,Caption,,0,0,0,,ПРЕДСТАВЛЕНО. НО САМА ПОСТАНОВКА ВОПРОСА УЖЕ ПОКАЗЫВАЕТ,
Dialogue: 0,0:09:10.19,0:09:12.02,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО РАСПОЛЗЛАСЬ ТЕМА
Dialogue: 0,0:09:12.02,0:09:14.76,Caption,,0,0,0,,УКРАИНСКИХ ОПЕРАЦИЙ. ПОДТВЕРЖДЕНИЕ УКРАИНСКОГО
Dialogue: 0,0:09:14.76,0:09:17.56,Caption,,0,0,0,,СЛЕДА В КУВЕЙТЕ ВЫВЕЛО БЫ СКАНДАЛ СОВСЕМ НА ДРУГОЙ
Dialogue: 0,0:09:17.56,0:09:20.15,Caption,,0,0,0,,УРОВЕНЬ. ТОГДА ЗЕЛЕНСКОМУ ПРИШЛОСЬ БЫ ОБЪЯСНЯТЬ УЖЕ
Dialogue: 0,0:09:20.15,0:09:22.09,Caption,,0,0,0,,НЕ УДАР ПО РОССИЙСКОМУ ОБЪЕКТУ В ЛИВИИ,
Dialogue: 0,0:09:22.34,0:09:24.39,Caption,,0,0,0,,А ГИБЕЛЬ ИТАЛЬЯНСКИХ СПЕЦИАЛИСТОВ ЗА
Dialogue: 0,0:09:24.39,0:09:26.61,Caption,,0,0,0,,ТЫСЯЧИ КИЛОМЕТРОВ ОТ УКРАИНЫ. В ТАКОМ
Dialogue: 0,0:09:26.61,0:09:29.69,Caption,,0,0,0,,СЦЕНАРИИ ОБВИНЕНИЯ В ГОСУДАРСТВЕННОМ ТЕРРОРИЗМЕ ПРОЗВУЧАЛИ
Dialogue: 0,0:09:29.69,0:09:32.73,Caption,,0,0,0,,БЫ УЖЕ ДАЛЕКО ЗА ПРЕДЕЛАМИ РОССИИ. И РАЗГОВОР О ТОМ,
Dialogue: 0,0:09:32.89,0:09:37.12,Caption,,0,0,0,,КТО С КЕМ ЧТО СОГЛАСОВАЛ, ВЫГЛЯДЕЛ БЫ СОВСЕМ ИНАЧЕ. А У ИТАЛИИ
Dialogue: 0,0:09:37.12,0:09:40.11,Caption,,0,0,0,,ВОЗНИКАЕТ ОСОБЕННО НЕПРИЯТНАЯ СИТУАЦИЯ. В ЛИВИИ
Dialogue: 0,0:09:40.11,0:09:43.08,Caption,,0,0,0,,РИМ ГОВОРИТ, ЧТО ЕГО НЕ ПРЕДУПРЕДИЛИ. В КУВЕЙТЕ
Dialogue: 0,0:09:43.08,0:09:48.20,Caption,,0,0,0,,ГИБНУТ ИТАЛЬЯНЦЫ. ТО ЕСТЬ ДЛЯ ИТАЛЬЯНСКОГО ПРАВИТЕЛЬСТВА
Dialogue: 0,0:09:48.20,0:09:50.63,Caption,,0,0,0,,ЗАРУБЕЖНАЯ АКТИВНОСТЬ ВОКРУГ ЭТОГО КОНФЛИКТА ВСЁ
Dialogue: 0,0:09:50.63,0:09:52.44,Caption,,0,0,0,,МЕНЬШЕ ПОХОЖА НА ДАЛЁКУЮ ИСТОРИЮ,
Dialogue: 0,0:09:52.76,0:09:54.57,Caption,,0,0,0,,КОТОРУЮ МОЖНО ОБСУЖДАТЬ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:09:54.57,0:09:57.08,Caption,,0,0,0,,В КАТЕГОРИЯХ ПОДДЕРЖКИ КИЕВА. ОНА НАЧИНАЕТ
Dialogue: 0,0:09:57.08,0:10:00.27,Caption,,0,0,0,,ПРИХОДИТЬ ВО ВНУТРЕННЮЮ ПОЛИТИКУ ИТАЛИИ. ИМЕННО
Dialogue: 0,0:10:00.27,0:10:03.74,Caption,,0,0,0,,ПОЭТОМУ РЕАКЦИЯ МЕЛОНИ ТАК ВАЖНА. ПОЛИТИК МОЖЕТ ДОЛГО
Dialogue: 0,0:10:03.74,0:10:07.54,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ СОЮЗНИКА, ПОКА ЦЕНА ЭТОЙ ПОДДЕРЖКИ СУЩЕСТВУЕТ
Dialogue: 0,0:10:07.54,0:10:10.43,Caption,,0,0,0,,ГДЕ ТО ДАЛЕКО. НО КОГДА ПРИХОДИТСЯ ОБЪЯСНЯТЬСЯ УЖЕ
Dialogue: 0,0:10:10.43,0:10:12.12,Caption,,0,0,0,,ПЕРЕД СОБСТВЕННЫМИ ИЗБИРАТЕЛЯМИ,
Dialogue: 0,0:10:12.37,0:10:16.22,Caption,,0,0,0,,ПОЧЕМУ ТЕБЯ НЕ ПРЕДУПРЕДИЛИ, ПОЧЕМУ ТВОИ ГРАЖДАНЕ ИЛИ СПЕЦИАЛИСТЫ
Dialogue: 0,0:10:16.22,0:10:18.97,Caption,,0,0,0,,ОКАЗЫВАЮТСЯ РЯДОМ С ЧУЖИМИ ОПЕРАЦИЯМИ И КТО ВООБЩЕ
Dialogue: 0,0:10:18.97,0:10:22.20,Caption,,0,0,0,,ПРИНИМАЕТ РЕШЕНИЯ, РАЗГОВОР СТАНОВИТСЯ НАМНОГО ЖЁСТЧЕ.
Dialogue: 0,0:10:22.91,0:10:25.03,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ЗДЕСЬ СОЗДАЛ ПРОБЛЕМУ НЕ
Dialogue: 0,0:10:25.03,0:10:28.03,Caption,,0,0,0,,ТОЛЬКО СЕБЕ. ОН ЛИШНИЙ РАЗ ПОДСВЕТИЛ САМУЮ НЕУДОБНУЮ
Dialogue: 0,0:10:28.03,0:10:30.84,Caption,,0,0,0,,ЧАСТЬ ВСЕЙ КОНСТРУКЦИИ. ПАРТНЁРЫ МОГУТ ХОТЕТЬ
Dialogue: 0,0:10:30.84,0:10:34.23,Caption,,0,0,0,,ПОМОГАТЬ УКРАИНЕ. ОНИ МОГУТ ЗАКРЫВАТЬ ГЛАЗА НА КАКИЕ ТО
Dialogue: 0,0:10:34.23,0:10:36.72,Caption,,0,0,0,,ДЕТАЛИ. ОНИ МОГУТ ПРЕДПОЧИТАТЬ НЕ ЗАДАВАТЬ
Dialogue: 0,0:10:36.72,0:10:40.12,Caption,,0,0,0,,ЛИШНИХ ВОПРОСОВ ПУБЛИЧНО. НО ОНИ ХОТЯТ САМИ РЕШАТЬ,
Dialogue: 0,0:10:40.27,0:10:43.36,Caption,,0,0,0,,ЧТО ПРИЗНАВАТЬ, КОГДА ПРИЗНАВАТЬ И КАКУЮ ЧАСТЬ
Dialogue: 0,0:10:43.36,0:10:46.52,Caption,,0,0,0,,СОТРУДНИЧЕСТВА ВЫСТАВЛЯТЬ НА СВЕТ. А КОГДА ЗА НИХ ЭТО
Dialogue: 0,0:10:46.52,0:10:50.23,Caption,,0,0,0,,НАЧИНАЕТ ДЕЛАТЬ ЗЕЛЕНСКИЙ, СОЮЗНИЧЕСТВО ПРЕВРАЩАЕТСЯ В ДОВОЛЬНО
Dialogue: 0,0:10:50.23,0:10:52.76,Caption,,0,0,0,,СТРАННУЮ УСЛУГУ. ТЫ ПОМОГАЕШЬ ЧЕЛОВЕКУ,
Dialogue: 0,0:10:52.98,0:10:54.79,Caption,,0,0,0,,А ОН ПОТОМ ВЫХОДИТ К ЖУРНАЛИСТАМ И
Dialogue: 0,0:10:54.79,0:10:57.32,Caption,,0,0,0,,РАССКАЗЫВАЕТ, КАК ИМЕННО ТЫ ЕМУ ПОМОГ.
Dialogue: 0,0:10:59.60,0:11:01.13,Caption,,0,0,0,,ПРИЧЁМ ТЫ ЕЩЁ И НЕ ПРОСИЛ ЕГО ОБ
Dialogue: 0,0:11:01.13,0:11:03.05,Caption,,0,0,0,,ЭТОМ РАССКАЗЫВАТЬ. ПОСЛЕ ЧЕГО ТЕБЕ
Dialogue: 0,0:11:03.05,0:11:05.13,Caption,,0,0,0,,САМОМУ ПРИХОДИТСЯ ВЫХОДИТЬ И ОБЪЯСНЯТЬ,
Dialogue: 0,0:11:05.36,0:11:09.48,Caption,,0,0,0,,ЧТО ОН ОПЯТЬ СКАЗАЛ ЛИШНЕЕ. ВОТ ПОЭТОМУ ВОПРОС ЗДЕСЬ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:11:09.48,0:11:12.29,Caption,,0,0,0,,О ЛИВИИ. ГЛАВНЫЙ ВОПРОС ПРОЩЕ. СКОЛЬКО
Dialogue: 0,0:11:12.29,0:11:14.58,Caption,,0,0,0,,РАЗ ПАРТНЁРЫ ГОТОВЫ ПЛАТИТЬ СОБСТВЕННОЙ
Dialogue: 0,0:11:14.58,0:11:17.13,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ ЦЕНОЙ ЗА ЧУЖОЙ ПУБЛИЧНЫЙ ЭФФЕКТ?
Dialogue: 0,0:11:17.40,0:11:19.46,Caption,,0,0,0,,ПОТОМУ ЧТО ОПЕРАЦИЮ МОЖНО ПРОВЕСТИ
Dialogue: 0,0:11:19.46,0:11:22.93,Caption,,0,0,0,,ОДИН РАЗ. СКАНДАЛ МОЖНО ПОГАСИТЬ. ПОСЛА МОЖНО ВЕРНУТЬ.
Dialogue: 0,0:11:22.93,0:11:25.59,Caption,,0,0,0,,ОБЪЯСНЕНИЕ МОЖНО ПРИДУМАТЬ. А ВОТ ПРИВЫЧКА
Dialogue: 0,0:11:25.59,0:11:28.73,Caption,,0,0,0,,БОЛТАТЬ О ТОМ, О ЧЁМ ОСТАЛЬНЫЕ ПРЕДПОЧИТАЮТ МОЛЧАТЬ,
Dialogue: 0,0:11:29.05,0:11:31.04,Caption,,0,0,0,,В БОЛЬШОЙ ПОЛИТИКЕ ОДНАЖДЫ СТАНОВИТСЯ
Dialogue: 0,0:11:31.04,0:11:32.25,Caption,,0,0,0,,ДОРОЖЕ САМОЙ ОПЕРАЦИИ.
