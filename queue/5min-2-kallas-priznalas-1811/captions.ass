Dialogue: 0,0:00:00.12,0:00:02.68,Caption,,0,0,0,,НУ ЧТО, ГОСПОДА ЕВРОПЕЙЦЫ, ДОГОВОРИЛИСЬ?
Dialogue: 0,0:00:02.94,0:00:06.20,Caption,,0,0,0,,АХ, ЕЩЁ НЕТ? А С КЕМ СОБИРАЕТЕСЬ ДОГОВАРИВАТЬСЯ,
Dialogue: 0,0:00:06.52,0:00:08.68,Caption,,0,0,0,,ЕСЛИ ДАЖЕ МЕЖДУ СОБОЙ НИКАК НЕ ПОЛУЧАЕТСЯ?
Dialogue: 0,0:00:09.02,0:00:13.08,Caption,,0,0,0,,ОДНИ УЖЕ СОБИРАЮТ ДЕЛЕГАЦИЮ, ДРУГИЕ ВОЗМУЩАЮТСЯ ЕЁ СОСТАВОМ,
Dialogue: 0,0:00:13.32,0:00:17.00,Caption,,0,0,0,,ТРЕТЬИ ВООБЩЕ НЕ ПОНИМАЮТ, КТО ТАМ ГЛАВНЫЙ. И ВЕДЬ ВСЕ ЭТИ ЛЮДИ
Dialogue: 0,0:00:17.00,0:00:19.48,Caption,,0,0,0,,ЕЩЁ НЕДАВНО ДЕМОНСТРИРОВАЛИ ТАКОЕ ТРОГАТЕЛЬНОЕ
Dialogue: 0,0:00:19.48,0:00:22.76,Caption,,0,0,0,,ЕДИНСТВО, ЧТО ХОТЬ СЕМЕЙНУЮ ФОТОГРАФИЮ ДЕЛАЙ. А ТЕПЕРЬ
Dialogue: 0,0:00:22.76,0:00:26.68,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО ДАЖЕ ЗА ОДНИМ СТОЛОМ РАЗМЕСТИТЬСЯ НЕПРОСТО. И
Dialogue: 0,0:00:26.76,0:00:29.80,Caption,,0,0,0,,ВОТ ЗДЕСЬ ВОЗНИКАЕТ ОЧЕНЬ ИНТЕРЕСНЫЙ ВОПРОС. ЧТО ЖЕ
Dialogue: 0,0:00:29.80,0:00:33.56,Caption,,0,0,0,,ТАКОГО ИЗМЕНИЛОСЬ, ЧТО ВЧЕРАШНИЕ СОЮЗНИКИ ВДРУГ НАЧАЛИ МЕШАТЬ ДРУГ
Dialogue: 0,0:00:33.64,0:00:36.36,Caption,,0,0,0,,ДРУГУ? ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ЗА ВСЕЙ ЭТОЙ
Dialogue: 0,0:00:36.36,0:00:38.68,Caption,,0,0,0,,ВОЗНЁЙ ВОКРУГ СТУЛЬЕВ СКРЫВАЕТСЯ КУДА БОЛЕЕ
Dialogue: 0,0:00:38.68,0:00:42.04,Caption,,0,0,0,,ИНТЕРЕСНАЯ ИСТОРИЯ. ГЛАВА МИД АВСТРИИ БЕАТЕ МАЙНЛЬ
Dialogue: 0,0:00:42.04,0:00:44.52,Caption,,0,0,0,,РАЙЗИНГЕР ВЫРАЗИЛАСЬ ВООБЩЕ ПРЕКРАСНО. НА
Dialogue: 0,0:00:44.52,0:00:46.52,Caption,,0,0,0,,ПЕРЕГОВОРАХ В АБУ ДАБИ ЕВРОПА,
Dialogue: 0,0:00:46.68,0:00:50.28,Caption,,0,0,0,,ПО ЕЁ СЛОВАМ, СИДЕЛА ЗА ДЕТСКИМ СТОЛИКОМ. ФОРМУЛИРОВКА,
Dialogue: 0,0:00:50.39,0:00:54.28,Caption,,0,0,0,,КОНЕЧНО, ОБИДНАЯ. СТОЛЬКО ЛЕТ БОЛЬШИЕ ЛЮДИ ЗАНИМАЛИСЬ БОЛЬШОЙ
Dialogue: 0,0:00:54.28,0:00:57.80,Caption,,0,0,0,,ПОЛИТИКОЙ, А ПОТОМ ПРИШЛИ НА СЕРЬЁЗНЫЙ РАЗГОВОР И ОБНАРУЖИЛИ,
Dialogue: 0,0:00:57.96,0:01:00.52,Caption,,0,0,0,,ЧТО ВЗРОСЛЫЕ РАЗГОВАРИВАЮТ ГДЕ ТО В ДРУГОМ МЕСТЕ.
Dialogue: 0,0:01:00.93,0:01:02.68,Caption,,0,0,0,,НО САМОЕ ИНТЕРЕСНОЕ ДАЖЕ НЕ ТО,
Dialogue: 0,0:01:02.82,0:01:06.04,Caption,,0,0,0,,КТО ЕВРОПУ ТУДА ПОСАДИЛ. ГОРАЗДО ИНТЕРЕСНЕЕ ДРУГОЕ.
Dialogue: 0,0:01:06.34,0:01:08.68,Caption,,0,0,0,,А ЕСЛИ ЕЁ ПЕРЕСАДИТЬ ЗА ВЗРОСЛЫЙ СТОЛ,
Dialogue: 0,0:01:08.76,0:01:12.56,Caption,,0,0,0,,КОГО ИМЕННО ТУДА САЖАТЬ? ВОТ ТУТ И НАЧИНАЕТСЯ НАСТОЯЩЕЕ ВЕСЕЛЬЕ.
Dialogue: 0,0:01:14.72,0:01:17.53,Caption,,0,0,0,,УРСУЛА ФОН ДЕР ЛЯЙЕН ПОДТВЕРЖДАЕТ НОВЫЙ ФОРМАТ Е
Dialogue: 0,0:01:17.53,0:01:20.89,Caption,,0,0,0,,ПЯТЬ ПЛЮС ЕС. ЕВРОКОМИССИЯ, ЕВРОСОВЕТ,
Dialogue: 0,0:01:21.04,0:01:23.85,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ, ГЕРМАНИЯ, ИТАЛИЯ,
Dialogue: 0,0:01:23.93,0:01:27.69,Caption,,0,0,0,,ПОЛЬША И ФРАНЦИЯ. КОМПАНИЯ СОЛИДНАЯ. СТУЛЬЕВ МНОГО.
Dialogue: 0,0:01:27.84,0:01:31.21,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЕЙ МНОГО. ТОЛЬКО ГЛАВА МИД ИСПАНИИ ХОСЕ
Dialogue: 0,0:01:31.29,0:01:33.85,Caption,,0,0,0,,МАНУЭЛЬ АЛЬБАРЕС УЖЕ ПРЕДУПРЕЖДАЕТ НАРОДУ СЛИШКОМ
Dialogue: 0,0:01:33.85,0:01:37.45,Caption,,0,0,0,,МНОГО, ПОЛУЧИТСЯ КАКОФОНИЯ. ТО ЕСТЬ ЕВРОПА ЕЩЁ НЕ НАЧАЛА
Dialogue: 0,0:01:37.53,0:01:42.01,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ С РОССИЕЙ, А ЕЙ УЖЕ ПОНАДОБИЛИСЬ ПЕРЕГОВОРЫ ВНУТРИ ПЕРЕГОВОРОВ.
Dialogue: 0,0:01:42.40,0:01:46.97,Caption,,0,0,0,,СНАЧАЛА НУЖНО ВЫЯСНИТЬ, КТО БУДЕТ ПРЕДСТАВЛЯТЬ ЕВРОПУ. ПОТОМ ВЫЯСНИТЬ,
Dialogue: 0,0:01:47.16,0:01:50.17,Caption,,0,0,0,,КОГО ИМЕННО ОН ПРЕДСТАВЛЯЕТ. ПОТОМ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:01:50.33,0:01:53.13,Caption,,0,0,0,,ЧТО ЭТОТ ЧЕЛОВЕК ИМЕЕТ ПРАВО ГОВОРИТЬ. ПОТОМ
Dialogue: 0,0:01:53.13,0:01:57.37,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО ДОГОВОРИТЬСЯ, ЧТО ОСТАЛЬНЫЕ ПРИЗНАЮТ СКАЗАННОЕ ИМ ОБЩЕЙ
Dialogue: 0,0:01:57.37,0:02:00.33,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ ПОЗИЦИЕЙ. И ТОЛЬКО ПОСЛЕ ЭТОГО МОЖНО
Dialogue: 0,0:02:00.33,0:02:02.97,Caption,,0,0,0,,ОТПРАВЛЯТЬСЯ ДОГОВАРИВАТЬСЯ С МОСКВОЙ. ОТЛИЧНЫЙ
Dialogue: 0,0:02:02.97,0:02:05.53,Caption,,0,0,0,,ПЛАН. ПРИЧЁМ ИСПАНИЯ ЗДЕСЬ ЗАДАЁТ СОВЕРШЕННО
Dialogue: 0,0:02:05.53,0:02:08.73,Caption,,0,0,0,,НОРМАЛЬНЫЙ ВОПРОС. ЕСЛИ ЗА СТОЛ ПРИХОДИТ СЕМЬ РАЗНЫХ
Dialogue: 0,0:02:08.73,0:02:12.01,Caption,,0,0,0,,ЦЕНТРОВ ВЛИЯНИЯ, ТО КТО ПРИНИМАЕТ ОКОНЧАТЕЛЬНОЕ РЕШЕНИЕ?
Dialogue: 0,0:02:12.48,0:02:15.53,Caption,,0,0,0,,ЕСЛИ ГЕРМАНИЯ ХОЧЕТ ОДНОГО, ФРАНЦИЯ ДРУГОГО,
Dialogue: 0,0:02:15.77,0:02:19.05,Caption,,0,0,0,,ПОЛЬША ТРЕТЬЕГО, А ИНСТИТУТЫ ЕВРОСОЮЗА ЧЕТВЁРТОГО,
Dialogue: 0,0:02:19.32,0:02:21.45,Caption,,0,0,0,,ЧЬЯ ПОЗИЦИЯ СЧИТАЕТСЯ ЕВРОПЕЙСКОЙ?
Dialogue: 0,0:02:21.74,0:02:24.41,Caption,,0,0,0,,ВОТ ТУТ И ВСПОМИНАЕТСЯ ВСЯ ЭТА ПРЕКРАСНАЯ ИСТОРИЯ
Dialogue: 0,0:02:24.49,0:02:27.53,Caption,,0,0,0,,ПРО ЕВРОПЕЙСКОЕ ЕДИНСТВО. ПОКА У БОЛЬШОЙ КОМПАНИИ
Dialogue: 0,0:02:27.53,0:02:30.17,Caption,,0,0,0,,ЕСТЬ ОБЩИЙ ПРОТИВНИК, ДРУЖИТЬ ДОВОЛЬНО ПРОСТО.
Dialogue: 0,0:02:32.44,0:02:35.00,Caption,,0,0,0,,НЕ ОБЯЗАТЕЛЬНО ЛЮБИТЬ ДРУГ ДРУГА. НЕ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:02:35.00,0:02:36.92,Caption,,0,0,0,,ОДИНАКОВО СМОТРЕТЬ НА ЭКОНОМИКУ,
Dialogue: 0,0:02:37.08,0:02:39.72,Caption,,0,0,0,,БЕЗОПАСНОСТЬ, МИГРАЦИЮ, ДЕНЬГИ,
Dialogue: 0,0:02:39.94,0:02:42.52,Caption,,0,0,0,,ОТНОШЕНИЯ С США ИЛИ УСТРОЙСТВО САМОЙ ЕВРОПЫ.
Dialogue: 0,0:02:42.99,0:02:47.48,Caption,,0,0,0,,ДОСТАТОЧНО ДОГОВОРИТЬСЯ, ПРОТИВ КОГО СЕГОДНЯ ВЫСТУПАЕМ. ОБЩИЙ ПРОТИВНИК ОЧЕНЬ
Dialogue: 0,0:02:47.48,0:02:51.24,Caption,,0,0,0,,ХОРОШО СКЛЕИВАЕТ ДАЖЕ ТЕХ, КТО В ОБЫЧНОЙ ЖИЗНИ ДРУГ ДРУГА ТЕРПИТ ЧЕРЕЗ
Dialogue: 0,0:02:51.24,0:02:54.52,Caption,,0,0,0,,СИЛУ. А ТЕПЕРЬ МЫСЛЕННО УБЕРИТЕ ИЗ ЭТОЙ КОНСТРУКЦИИ
Dialogue: 0,0:02:54.52,0:02:57.08,Caption,,0,0,0,,РОССИЮ. ПРОСТО УБЕРИТЕ. И ЧТО ОСТАНЕТСЯ?
Dialogue: 0,0:02:57.31,0:03:00.60,Caption,,0,0,0,,ГЕРМАНИЯ СО СВОИМИ ИНТЕРЕСАМИ. ФРАНЦИЯ СО СВОИМИ.
Dialogue: 0,0:03:00.84,0:03:04.36,Caption,,0,0,0,,ПОЛЬША СО СВОИМИ. ИТАЛИЯ СО СВОИМИ. ВЕНГРИЯ ВООБЩЕ
Dialogue: 0,0:03:04.44,0:03:06.84,Caption,,0,0,0,,ДАВНО ЖИВЁТ ПО ОТДЕЛЬНОЙ ИНСТРУКЦИИ. ИСПАНИЯ
Dialogue: 0,0:03:06.84,0:03:10.76,Caption,,0,0,0,,СПРАШИВАЕТ, ЗАЧЕМ СОБРАЛИ ТАКУЮ ТОЛПУ. АВСТРИЯ ЖАЛУЕТСЯ,
Dialogue: 0,0:03:11.00,0:03:14.04,Caption,,0,0,0,,ЧТО ЕВРОПУ НЕ ВОСПРИНИМАЮТ ВСЕРЬЁЗ. БРИТАНИЯ ВООБЩЕ
Dialogue: 0,0:03:14.12,0:03:18.36,Caption,,0,0,0,,НЕ СОСТОИТ В ЕВРОСОЮЗЕ, НО ТОЖЕ ХОЧЕТ ОПРЕДЕЛЯТЬ ЕВРОПЕЙСКУЮ ПОЗИЦИЮ. И
Dialogue: 0,0:03:18.44,0:03:22.52,Caption,,0,0,0,,ВДРУГ ВЫЯСНЯЕТСЯ, ЧТО БЕЗ ОБЩЕГО ПРОТИВНИКА ВЧЕРАШНИЕ СОЮЗНИКИ САМИ
Dialogue: 0,0:03:22.52,0:03:24.68,Caption,,0,0,0,,ДРУГ ДРУГУ ЧУТЬ ЛИ НЕ ВРАГИ. ТЕПЕРЬ НАДО
Dialogue: 0,0:03:24.68,0:03:28.12,Caption,,0,0,0,,РЕШИТЬ, ЗА ЧТО ИМЕННО ДРУЖИТЬ. А ЭТО ГОРАЗДО СЛОЖНЕЕ.
Dialogue: 0,0:03:28.52,0:03:30.84,Caption,,0,0,0,,ПОТОМУ ЧТО ДРУЖБА ПРОТИВ КОГО ТО НЕ ТРЕБУЕТ
Dialogue: 0,0:03:30.92,0:03:33.32,Caption,,0,0,0,,ОБЩЕГО ПРЕДСТАВЛЕНИЯ О БУДУЩЕМ. А ВОТ МИРНОЕ
Dialogue: 0,0:03:33.32,0:03:35.32,Caption,,0,0,0,,УСТРОЙСТВО ТРЕБУЕТ. КТО ПЛАТИТ?
Dialogue: 0,0:03:35.56,0:03:38.68,Caption,,0,0,0,,КТО ПОЛУЧАЕТ ГАРАНТИИ? КТО ОТВЕЧАЕТ ЗА БЕЗОПАСНОСТЬ?
Dialogue: 0,0:03:38.76,0:03:40.68,Caption,,0,0,0,,КТО ОПРЕДЕЛЯЕТ ОТНОШЕНИЯ С РОССИЕЙ?
Dialogue: 0,0:03:40.90,0:03:42.92,Caption,,0,0,0,,КТО ПРИНИМАЕТ РЕШЕНИЯ ПО УКРАИНЕ?
Dialogue: 0,0:03:43.15,0:03:45.80,Caption,,0,0,0,,КТО НЕСЁТ РАСХОДЫ ПОСЛЕ ЗАВЕРШЕНИЯ КОНФЛИКТА?
Dialogue: 0,0:03:48.09,0:03:50.33,Caption,,0,0,0,,КТО ПОЛУЧАЕТ ПОЛИТИЧЕСКИЕ ДИВИДЕНДЫ?
Dialogue: 0,0:03:50.49,0:03:54.09,Caption,,0,0,0,,И ГЛАВНОЕ, ПОЧЕМУ ОСТАЛЬНЫЕ ДОЛЖНЫ СОГЛАШАТЬСЯ ИМЕННО С ЕГО
Dialogue: 0,0:03:54.09,0:03:57.93,Caption,,0,0,0,,ВАРИАНТОМ? ВОТ ЗДЕСЬ ПРИВЫЧНОЕ ЕДИНСТВО И НАЧИНАЕТ ПОТРЕСКИВАТЬ
Dialogue: 0,0:03:57.93,0:04:00.81,Caption,,0,0,0,,СОВСЕМ В ДРУГОМ МЕСТЕ. ОТДЕЛЬНАЯ ПЕСНЯ,
Dialogue: 0,0:04:00.94,0:04:03.93,Caption,,0,0,0,,КАЯ КАЛЛАС. В ПЕРЕГОВОРНУЮ ГРУППУ ЕЁ НЕ ВКЛЮЧИЛИ.
Dialogue: 0,0:04:04.17,0:04:08.49,Caption,,0,0,0,,НО КАЛЛАС УЖЕ ОБЪЯСНИЛА, ЧТО ВСЁ РАВНО СОБИРАЕТСЯ ВЛИЯТЬ НА ПРОЦЕСС. У
Dialogue: 0,0:04:08.57,0:04:12.49,Caption,,0,0,0,,НЕЁ ЕСТЬ СПЕЦИАЛИСТЫ, КОТОРЫЕ ДАВНО РАБОТАЮТ ПО РОССИЙСКОМУ НАПРАВЛЕНИЮ,
Dialogue: 0,0:04:12.65,0:04:15.61,Caption,,0,0,0,,ЗНАЮТ ПЕРЕГОВОРНУЮ КУХНЮ И БУДУТ ПОМОГАТЬ ДЕРЖАТЬ
Dialogue: 0,0:04:15.61,0:04:18.33,Caption,,0,0,0,,НУЖНЫЙ КУРС. ПРЕКРАСНО. ТО ЕСТЬ ЧЕЛОВЕКА ЗА СТОЛ
Dialogue: 0,0:04:18.41,0:04:20.33,Caption,,0,0,0,,НЕ ПОСАДИЛИ, НО ЧЕЛОВЕК РЕШИЛ,
Dialogue: 0,0:04:20.41,0:04:22.89,Caption,,0,0,0,,ЧТО СТОЛ ЭТО ЕЩЁ НЕ ГЛАВНОЕ. ПРИ ЭТОМ
Dialogue: 0,0:04:22.97,0:04:25.21,Caption,,0,0,0,,САМА КАЛЛАС ПРЕДЛАГАЕТ НАЧИНАТЬ РАЗГОВОР С
Dialogue: 0,0:04:25.21,0:04:28.09,Caption,,0,0,0,,ТРЕБОВАНИЯ ПРЕКРАЩЕНИЯ ОГНЯ И НАЗЫВАЕТ РОССИЙСКИЕ
Dialogue: 0,0:04:28.09,0:04:31.13,Caption,,0,0,0,,УСЛОВИЯ АБСУРДНЫМИ. ПРЕЗИДЕНТ ФИНЛЯНДИИ АЛЕКСАНДР
Dialogue: 0,0:04:31.13,0:04:34.33,Caption,,0,0,0,,СТУББ СМОТРИТ НА ВОПРОС НЕСКОЛЬКО ИНАЧЕ. ОН ГОВОРИТ,
Dialogue: 0,0:04:34.42,0:04:37.45,Caption,,0,0,0,,ЧТО ОТКАЗ ЕВРОПЕЙЦЕВ ВЕСТИ ПРЯМОЙ РАЗГОВОР С РОССИЕЙ
Dialogue: 0,0:04:37.45,0:04:40.41,Caption,,0,0,0,,БЕЗОТВЕТСТВЕНЕН. ПОТОМУ ЧТО БЕЗ СОГЛАСИЯ РОССИИ
Dialogue: 0,0:04:40.41,0:04:43.29,Caption,,0,0,0,,НИКАКОЙ СДЕЛКИ ПРОСТО НЕ БУДЕТ. И ВОТ ОНИ,
Dialogue: 0,0:04:43.37,0:04:48.49,Caption,,0,0,0,,ДВА ЕВРОПЕЙСКИХ ПОДХОДА, РЯДОМ. ОДИН ГОВОРИТ СНАЧАЛА ТРЕБУЕМ. ДРУГОЙ ГОВОРИТ
Dialogue: 0,0:04:48.49,0:04:51.61,Caption,,0,0,0,,РЕБЯТА, ДЛЯ НАЧАЛА НЕПЛОХО БЫ ВООБЩЕ РАЗГОВАРИВАТЬ С ТЕМ,
Dialogue: 0,0:04:51.77,0:04:54.49,Caption,,0,0,0,,С КЕМ ВЫ СОБРАЛИСЬ ЗАКЛЮЧАТЬ СОГЛАШЕНИЕ. ПРИЧЁМ
Dialogue: 0,0:04:54.57,0:05:00.92,Caption,,0,0,0,,СТУББ ВЕДЬ НЕ ОТКРЫЛ АМЕРИКУ. НО САМА НЕОБХОДИМОСТЬ ОБЪЯСНЯТЬ ВЗРОСЛЫМ ЕВРОПЕЙСКИМ
Dialogue: 0,0:05:00.92,0:05:04.92,Caption,,0,0,0,,РУКОВОДИТЕЛЯМ, ЧТО ДОГОВОР С РОССИЕЙ ТРЕБУЕТ РАЗГОВОРА С РОССИЕЙ,
Dialogue: 0,0:05:05.23,0:05:07.96,Caption,,0,0,0,,УЖЕ ЗВУЧИТ ДОВОЛЬНО КОМИЧНО. А У КАЛЛАС ТЕМ
Dialogue: 0,0:05:07.96,0:05:11.00,Caption,,0,0,0,,ВРЕМЕНЕМ ВООБЩЕ НАСЫЩЕННАЯ ПРОГРАММА. ОНА ЗАГОВОРИЛА
Dialogue: 0,0:05:11.08,0:05:13.48,Caption,,0,0,0,,О РОССИЙСКИХ ЦИФРОВЫХ ДАННЫХ УЧАСТНИКОВ БОЕВЫХ
Dialogue: 0,0:05:13.48,0:05:17.80,Caption,,0,0,0,,ДЕЙСТВИЙ. ПО ЕЁ СЛОВАМ, ЭТИ ДАННЫЕ СУЩЕСТВУЮТ В ЦИФРОВОМ ВИДЕ И ИХ
Dialogue: 0,0:05:17.88,0:05:21.00,Caption,,0,0,0,,МОЖНО ПОЛУЧИТЬ ДЛЯ ДАЛЬНЕЙШИХ ОГРАНИЧЕНИЙ. В РОССИИ
Dialogue: 0,0:05:21.00,0:05:24.04,Caption,,0,0,0,,ОТВЕТ ПРИЛЕТЕЛ МГНОВЕННО. ВЯЧЕСЛАВ ВОЛОДИН УЖЕ
Dialogue: 0,0:05:24.04,0:05:26.44,Caption,,0,0,0,,НАСЧИТАЛ КАЛЛАС ДО ДВАДЦАТИ ЛЕТ ПО РОССИЙСКОМУ
Dialogue: 0,0:05:26.44,0:05:29.72,Caption,,0,0,0,,УГОЛОВНОМУ КОДЕКСУ И ПОСОВЕТОВАЛ ЕЙ ЗАОДНО ПОДТЯНУТЬ
Dialogue: 0,0:05:29.72,0:05:32.60,Caption,,0,0,0,,ИСТОРИЮ. НУ ТУТ ОСТАЁТСЯ ТОЛЬКО ВСПОМНИТЬ КЛАССИКУ.
Dialogue: 0,0:05:32.76,0:05:36.92,Caption,,0,0,0,,КТО Ж ЕЁ ПОСАДИТ? ОНА ЖЕ ПАМЯТНИК. НО ДЛЯ ОСТРОТЫ ОБЩЕЙ КАРТИНЫ
Dialogue: 0,0:05:36.93,0:05:40.04,Caption,,0,0,0,,ЭПИЗОД ПРЕКРАСНЫЙ. ЧЕЛОВЕКА НЕ ВЗЯЛИ В ПЕРЕГОВОРНУЮ
Dialogue: 0,0:05:40.04,0:05:43.16,Caption,,0,0,0,,ГРУППУ, ОНА ОБЕЩАЕТ ВСЁ РАВНО ВЛИЯТЬ НА ПЕРЕГОВОРЫ,
Dialogue: 0,0:05:43.41,0:05:46.04,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ОБСУЖДАЕТ ПОЛУЧЕНИЕ РОССИЙСКИХ ДАННЫХ,
Dialogue: 0,0:05:46.36,0:05:48.84,Caption,,0,0,0,,А ИЗ МОСКВЫ ЕЙ УЖЕ СОВЕТУЮТ ИЗУЧАТЬ УГОЛОВНЫЙ
Dialogue: 0,0:05:48.84,0:05:52.04,Caption,,0,0,0,,КОДЕКС. ВОТ ТАКАЯ ПОДГОТОВКА К БОЛЬШОМУ ЕВРОПЕЙСКОМУ
Dialogue: 0,0:05:52.04,0:05:54.04,Caption,,0,0,0,,ПРИМИРЕНИЮ. ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:05:54.16,0:05:56.44,Caption,,0,0,0,,КОГДА ЗА КРАСИВЫМИ ЗАЯВЛЕНИЯМИ РАЗБИРАЮТ САМ
Dialogue: 0,0:05:56.44,0:06:01.00,Caption,,0,0,0,,МЕХАНИЗМ ПРОИСХОДЯЩЕГО, ПОДДЕРЖИТЕ КАНАЛ ПОДПИСКОЙ. НО НАСТОЯЩАЯ ПРОБЛЕМА
Dialogue: 0,0:06:01.00,0:06:02.84,Caption,,0,0,0,,ЕВРОПЫ НАЧИНАЕТСЯ ДАЖЕ НЕ ЗДЕСЬ.
Dialogue: 0,0:06:05.05,0:06:07.21,Caption,,0,0,0,,В ОКРУЖЕНИИ МАКРОНА ЗВУЧИТ ОБВИНЕНИЕ,
Dialogue: 0,0:06:07.37,0:06:10.49,Caption,,0,0,0,,ЧТО США УЖЕ НЕ ПРОСТО СОКРАЩАЮТ ПОДДЕРЖКУ УКРАИНЫ,
Dialogue: 0,0:06:10.73,0:06:13.37,Caption,,0,0,0,,А СОЗНАТЕЛЬНО ОСЛАБЛЯЮТ ЕЁ СПОСОБНОСТЬ ПРОДОЛЖАТЬ
Dialogue: 0,0:06:13.37,0:06:17.13,Caption,,0,0,0,,КОНФЛИКТ. ФОРМУЛИРОВКА ЕЩЁ ЖЁСТЧЕ США ЯКОБЫ ПЫТАЮТСЯ
Dialogue: 0,0:06:17.13,0:06:21.45,Caption,,0,0,0,,УТОПИТЬ УКРАИНУ, ЛИШИВ ЕЁ ВОЗМОЖНОСТИ ПРОДОЛЖАТЬ БОРЬБУ. И ПАРИЖ
Dialogue: 0,0:06:21.53,0:06:24.57,Caption,,0,0,0,,ДЕЛАЕТ ИЗ ЭТОГО СВОЙ ВЫВОД. ЕСЛИ ВАШИНГТОН ОСЛАБЛЯЕТ
Dialogue: 0,0:06:24.57,0:06:29.05,Caption,,0,0,0,,КИЕВ, ЗНАЧИТ, ЕВРОПЕ НУЖНО ПРОДОЛЖАТЬ ПОДДЕРЖКУ САМОЙ И УБЕЖДАТЬ
Dialogue: 0,0:06:29.13,0:06:32.01,Caption,,0,0,0,,ОСТАЛЬНЫХ ДЕЛАТЬ ТО ЖЕ САМОЕ. ВОТ ЗДЕСЬ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:06:32.09,0:06:35.05,Caption,,0,0,0,,ЕЩЁ ОДИН РАЗЛОМ. ПОКА ЕВРОПА И США ДВИГАЛИСЬ
Dialogue: 0,0:06:35.05,0:06:39.53,Caption,,0,0,0,,ПРОТИВ ОДНОГО ПРОТИВНИКА, РАЗЛИЧИЯ МОЖНО БЫЛО ПРЯТАТЬ. А КОГДА ВОЗНИКАЕТ
Dialogue: 0,0:06:39.53,0:06:42.65,Caption,,0,0,0,,ВОПРОС, КАКИМ ДОЛЖЕН БЫТЬ РЕЗУЛЬТАТ И КАКОЙ ЦЕНОЙ ЕГО
Dialogue: 0,0:06:42.65,0:06:47.69,Caption,,0,0,0,,ДОБИВАТЬСЯ, ВЫЯСНЯЕТСЯ, ЧТО ДАЖЕ ТРАНСАТЛАНТИЧЕСКОЕ ЕДИНСТВО ВЫГЛЯДИТ УЖЕ НЕ
Dialogue: 0,0:06:47.69,0:06:50.81,Caption,,0,0,0,,ТАК ГЛАДКО. ОДНИ ХОТЯТ ДАВИТЬ КИЕВ К УСТУПКАМ.
Dialogue: 0,0:06:51.08,0:06:53.53,Caption,,0,0,0,,ДРУГИЕ СЧИТАЮТ, ЧТО КИЕВ, НАОБОРОТ,
Dialogue: 0,0:06:53.69,0:06:56.33,Caption,,0,0,0,,НАДО УДЕРЖАТЬ ОТ УСТУПОК. ОДНИ ИЩУТ ПУТЬ К
Dialogue: 0,0:06:56.33,0:07:01.85,Caption,,0,0,0,,СОГЛАШЕНИЮ. ДРУГИЕ ОПАСАЮТСЯ, ЧТО САМ ПУТЬ К СОГЛАШЕНИЮ ОКАЖЕТСЯ ПРОИГРЫШНЫМ. И
Dialogue: 0,0:07:01.93,0:07:05.13,Caption,,0,0,0,,ВСЁ ЭТО НАЗЫВАЕТСЯ ОДНОЙ ОБЩЕЙ ЗАПАДНОЙ ПОЗИЦИЕЙ.
Dialogue: 0,0:07:05.69,0:07:08.49,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЮТСЯ ДЕНЬГИ. ЕВРОКОМИССИЯ ГОТОВИТ
Dialogue: 0,0:07:08.49,0:07:11.37,Caption,,0,0,0,,УКРАИНЕ НОВЫЙ КРЕДИТ НА СОРОК ПЯТЬ МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:07:11.69,0:07:14.17,Caption,,0,0,0,,ПРИЧЁМ ЭТО ДОПОЛНИТЕЛЬНО К УЖЕ ВЫДЕЛЕННЫМ ДЕВЯНОСТА
Dialogue: 0,0:07:14.17,0:07:17.13,Caption,,0,0,0,,МИЛЛИАРДАМ. НО И ЗДЕСЬ ДРУЖНАЯ ЕВРОПЕЙСКАЯ СЕМЬЯ
Dialogue: 0,0:07:17.13,0:07:19.85,Caption,,0,0,0,,НЕОЖИДАННО НАЧИНАЕТ СЧИТАТЬ СОБСТВЕННЫЕ КОШЕЛЬКИ.
Dialogue: 0,0:07:22.14,0:07:25.50,Caption,,0,0,0,,ЧЕХИЯ, СЛОВАКИЯ И ВЕНГРИЯ НЕ УЧАСТВОВАЛИ В ПРЕДЫДУЩЕЙ
Dialogue: 0,0:07:25.50,0:07:28.54,Caption,,0,0,0,,СХЕМЕ. ТЕПЕРЬ К НИМ ДОБАВИЛАСЬ БОЛГАРИЯ. ВОЗНИК
Dialogue: 0,0:07:28.54,0:07:31.02,Caption,,0,0,0,,КОНФЛИКТ ВОКРУГ ПОПЫТКИ СВЯЗАТЬ ВОПРОС ПОМОЩИ
Dialogue: 0,0:07:31.02,0:07:34.06,Caption,,0,0,0,,УКРАИНЕ С ЕВРОПЕЙСКИМ БЮДЖЕТОМ. ДАЖЕ ИРЛАНДИЯ,
Dialogue: 0,0:07:34.24,0:07:36.06,Caption,,0,0,0,,КОТОРАЯ ПОДДЕРЖКУ КИЕВА НЕ ОТВЕРГАЕТ,
Dialogue: 0,0:07:36.38,0:07:38.38,Caption,,0,0,0,,ВЫРАЗИЛА БЕСПОКОЙСТВО ПО ПОВОДУ ТОГО,
Dialogue: 0,0:07:38.62,0:07:41.10,Caption,,0,0,0,,КАК ВСЁ ЭТО ПРОТАЛКИВАЕТСЯ. И ВОТ ЭТО УЖЕ
Dialogue: 0,0:07:41.18,0:07:44.22,Caption,,0,0,0,,ОЧЕНЬ ПОКАЗАТЕЛЬНЫЙ МОМЕНТ. ОДНО ДЕЛО СКАЗАТЬ МЫ ВСЕ
Dialogue: 0,0:07:44.22,0:07:47.50,Caption,,0,0,0,,ВМЕСТЕ ПОДДЕРЖИВАЕМ УКРАИНУ. ДРУГОЕ ДЕЛО ПОЛОЖИТЬ НА
Dialogue: 0,0:07:47.50,0:07:50.06,Caption,,0,0,0,,СТОЛ СЧЁТ. ПОКА РЕЧЬ ИДЁТ О ЛОЗУНГЕ,
Dialogue: 0,0:07:50.22,0:07:53.02,Caption,,0,0,0,,ЕДИНСТВО БЕСПЛАТНОЕ. КОГДА ПОЯВЛЯЮТСЯ ДЕСЯТКИ
Dialogue: 0,0:07:53.02,0:07:56.46,Caption,,0,0,0,,МИЛЛИАРДОВ, НАЧИНАЕТСЯ АРИФМЕТИКА. КТО ПЛАТИТ БОЛЬШЕ?
Dialogue: 0,0:07:56.67,0:07:59.10,Caption,,0,0,0,,КТО МЕНЬШЕ? КТО ИМЕЕТ ПРАВО ОТКАЗАТЬСЯ?
Dialogue: 0,0:07:59.34,0:08:01.42,Caption,,0,0,0,,КТО БУДЕТ КОМПЕНСИРОВАТЬ ОТКАЗАВШИХСЯ?
Dialogue: 0,0:08:01.66,0:08:04.30,Caption,,0,0,0,,МОЖНО ЛИ ДАВИТЬ НА НЕСОГЛАСНЫХ ЧЕРЕЗ ОБЩИЙ БЮДЖЕТ?
Dialogue: 0,0:08:04.69,0:08:07.58,Caption,,0,0,0,,И ПОЧЕМУ ОДНО ГОСУДАРСТВО ДОЛЖНО ОПЛАЧИВАТЬ РЕШЕНИЕ,
Dialogue: 0,0:08:07.74,0:08:09.74,Caption,,0,0,0,,С КОТОРЫМ ЕГО ПРАВИТЕЛЬСТВО НЕ СОГЛАСНО?
Dialogue: 0,0:08:09.95,0:08:12.78,Caption,,0,0,0,,ВОТ ЗДЕСЬ ДРУЖБА ПРОТИВ ОБЩЕГО ПРОТИВНИКА ПОСТЕПЕННО
Dialogue: 0,0:08:12.78,0:08:15.42,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ОЧЕНЬ ОБЫЧНЫЙ РАЗГОВОР О СОБСТВЕННЫХ
Dialogue: 0,0:08:15.42,0:08:18.78,Caption,,0,0,0,,ИНТЕРЕСАХ. И ЭТО КАСАЕТСЯ НЕ ТОЛЬКО ДЕНЕГ. ГУТЕРРИШ
Dialogue: 0,0:08:18.78,0:08:22.46,Caption,,0,0,0,,ГОВОРИТ, ЧТО БЫСТРОГО ОКОНЧАНИЯ КОНФЛИКТА НЕ ВИДИТ. ПЕСКОВ
Dialogue: 0,0:08:22.46,0:08:25.42,Caption,,0,0,0,,ГОВОРИТ, ЧТО МОСКВА НЕ СОБИРАЕТСЯ СОГЛАШАТЬСЯ НА КОРОТКУЮ
Dialogue: 0,0:08:25.42,0:08:27.66,Caption,,0,0,0,,ПЕРЕДЫШКУ И ХОЧЕТ ДОЛГОСРОЧНОЕ РЕШЕНИЕ.
Dialogue: 0,0:08:29.93,0:08:32.09,Caption,,0,0,0,,ДЕПУТАТ РАДЫ СЕРГЕЙ СОБОЛЕВ УТВЕРЖДАЕТ,
Dialogue: 0,0:08:32.30,0:08:34.89,Caption,,0,0,0,,ЧТО НОВЫХ РОССИЙСКИХ ПРЕДЛОЖЕНИЙ ЖДАТЬ НЕ СТОИТ И
Dialogue: 0,0:08:34.89,0:08:38.17,Caption,,0,0,0,,МОСКВА БУДЕТ НАСТАИВАТЬ НА ПРЕЖНИХ УСЛОВИЯХ. КАЛЛАС,
Dialogue: 0,0:08:38.25,0:08:42.25,Caption,,0,0,0,,НАПРОТИВ, ТРЕБУЕТ СНАЧАЛА ПРЕКРАЩЕНИЯ ОГНЯ. МЫ ВСЕ ЭТИ ПОЗИЦИИ
Dialogue: 0,0:08:42.25,0:08:45.29,Caption,,0,0,0,,ПРЕКРАСНО ЗНАЕМ. ПЯТЫЙ ГОД ИДЁТ. ПОЭТОМУ ГОРАЗДО
Dialogue: 0,0:08:45.29,0:08:47.21,Caption,,0,0,0,,ИНТЕРЕСНЕЕ НЕ ПОВТОРЯТЬ ИХ ЕЩЁ РАЗ,
Dialogue: 0,0:08:47.52,0:08:50.41,Caption,,0,0,0,,А ПОСМОТРЕТЬ НА ДРУГОЕ. ДАЖЕ ПОРЯДОК ПЕРЕГОВОРОВ
Dialogue: 0,0:08:50.41,0:08:53.21,Caption,,0,0,0,,СТОРОНЫ ПОНИМАЮТ ПО РАЗНОМУ. ОДНИ ГОВОРЯТ СНАЧАЛА
Dialogue: 0,0:08:53.21,0:08:57.29,Caption,,0,0,0,,ОСТАНОВИЛИСЬ, ПОТОМ ОБСУЖДАЕМ. ДРУГИЕ ГОВОРЯТ СНАЧАЛА ДОГОВОРИЛИСЬ
Dialogue: 0,0:08:57.29,0:08:59.45,Caption,,0,0,0,,О ТОМ, ЧТО БУДЕТ ПОСЛЕ ОСТАНОВКИ,
Dialogue: 0,0:08:59.68,0:09:02.89,Caption,,0,0,0,,ИНАЧЕ ЧЕРЕЗ НЕКОТОРОЕ ВРЕМЯ ВСЁ НАЧНЁТСЯ ЗАНОВО. И
Dialogue: 0,0:09:02.89,0:09:05.29,Caption,,0,0,0,,ЕВРОПА В ЭТОЙ КОНСТРУКЦИИ ДОЛЖНА НЕ ПРОСТО ВЫБРАТЬ
Dialogue: 0,0:09:05.29,0:09:07.93,Caption,,0,0,0,,ОДНУ ИЗ ФОРМУЛ. ОНА ДОЛЖНА СНАЧАЛА ДОГОВОРИТЬСЯ
Dialogue: 0,0:09:07.93,0:09:12.57,Caption,,0,0,0,,ВНУТРИ СЕБЯ, КАКУЮ ФОРМУЛУ ВООБЩЕ СЧИТАТЬ СВОЕЙ. ИМЕННО ПОЭТОМУ
Dialogue: 0,0:09:12.57,0:09:15.05,Caption,,0,0,0,,ИСТОРИЯ С ДЕТСКИМ СТОЛИКОМ ТАК ХОРОШО ПОКАЗЫВАЕТ
Dialogue: 0,0:09:15.05,0:09:18.01,Caption,,0,0,0,,ПРОБЛЕМУ. МОЖНО СКОЛЬКО УГОДНО ТРЕБОВАТЬ МЕСТО СРЕДИ
Dialogue: 0,0:09:18.01,0:09:20.65,Caption,,0,0,0,,ВЗРОСЛЫХ. НО ВЗРОСЛЫЙ СТУЛ САМ ПО СЕБЕ НЕ
Dialogue: 0,0:09:20.73,0:09:24.89,Caption,,0,0,0,,ДАЁТ ОБЩЕЙ ПОЗИЦИИ. ТЕМ ВРЕМЕНЕМ ЕВРОПЕЙСКОЕ ДАВЛЕНИЕ НА РОССИЮ НИКУДА
Dialogue: 0,0:09:24.97,0:09:28.09,Caption,,0,0,0,,НЕ ИСЧЕЗАЕТ. ВОЕННЫЕ ВЫСАДИЛИСЬ НА ТАНКЕР ПОД ФЛАГОМ
Dialogue: 0,0:09:28.09,0:09:31.37,Caption,,0,0,0,,ЗИМБАБВЕ, КОТОРЫЙ БРЮССЕЛЬ СВЯЗЫВАЕТ С ПЕРЕВОЗКАМИ РОССИЙСКОЙ
Dialogue: 0,0:09:31.37,0:09:34.49,Caption,,0,0,0,,НЕФТИ. КАЛЛАС ГОВОРИТ О ПРОДОЛЖЕНИИ ДАВЛЕНИЯ НА ТАК
Dialogue: 0,0:09:34.49,0:09:38.17,Caption,,0,0,0,,НАЗЫВАЕМЫЙ ТЕНЕВОЙ ФЛОТ. ГОТОВЯТСЯ НОВЫЕ ОГРАНИЧЕНИЯ
Dialogue: 0,0:09:38.17,0:09:44.45,Caption,,0,0,0,,ПРОТИВ БАНКОВ И КОМПАНИЙ. ТО ЕСТЬ ПЕРЕГОВОРНЫЙ ПРОЦЕСС ИДЁТ СВОИМ ХОДОМ,
Dialogue: 0,0:09:44.76,0:09:47.81,Caption,,0,0,0,,А ИНСТРУМЕНТЫ ДАВЛЕНИЯ СВОИМ. И ЭТО ТОЖЕ ЧАСТЬ
Dialogue: 0,0:09:47.81,0:09:50.61,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ПРОТИВОРЕЧИЯ. ОДНОВРЕМЕННО НУЖНО
Dialogue: 0,0:09:50.61,0:09:53.09,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ О БУДУЩЕМ УСТРОЙСТВЕ И ПРОДОЛЖАТЬ
Dialogue: 0,0:09:53.09,0:09:57.33,Caption,,0,0,0,,ПОЛИТИКУ, ВОКРУГ КОТОРОЙ СТРОИЛОСЬ ПРЕЖНЕЕ ЕДИНСТВО. ЧЕЙ БОУЗ
Dialogue: 0,0:09:57.41,0:09:59.73,Caption,,0,0,0,,ВООБЩЕ ВОЗВРАЩАЕТ РАЗГОВОР В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:09:59.81,0:10:02.61,Caption,,0,0,0,,ПЕРВЫЙ ГОД. ЕГО МЫСЛЬ ПРОСТА РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:10:02.69,0:10:04.69,Caption,,0,0,0,,ПО БЕЗОПАСНОСТИ ОБСУЖДАЛИСЬ ЕЩЁ ТОГДА,
Dialogue: 0,0:10:05.02,0:10:07.33,Caption,,0,0,0,,НО ЕВРОПЕЙСКАЯ ПОЛИТИКА ПОШЛА ДРУГИМ ПУТЁМ,
Dialogue: 0,0:10:07.64,0:10:09.09,Caption,,0,0,0,,А ТЕПЕРЬ УСЛОВИЯ СТАЛИ ЖЁСТЧЕ.
Dialogue: 0,0:10:09.80,0:10:12.13,Caption,,0,0,0,,МОЖНО СОГЛАШАТЬСЯ С БОУЗОМ ИЛИ СПОРИТЬ С НИМ,
Dialogue: 0,0:10:12.37,0:10:15.25,Caption,,0,0,0,,НО ОДИН МОМЕНТ ЗДЕСЬ ДЕЙСТВИТЕЛЬНО ИНТЕРЕСЕН. САМА
Dialogue: 0,0:10:15.25,0:10:17.89,Caption,,0,0,0,,КАЛЛАС ЕЩЁ ТОГДА ВЫСТУПАЛА ПРОТИВ ПОЛНОЦЕННОГО
Dialogue: 0,0:10:17.97,0:10:20.85,Caption,,0,0,0,,САММИТА ЕВРОСОЮЗА С РОССИЕЙ БЕЗ ВЫПОЛНЕНИЯ
Dialogue: 0,0:10:20.85,0:10:23.65,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНЫХ УСЛОВИЙ. ТО ЕСТЬ НЫНЕШНЯЯ ПРОБЛЕМА
Dialogue: 0,0:10:23.65,0:10:26.53,Caption,,0,0,0,,ВОЗНИКЛА НЕ ВНЕЗАПНО. ЕВРОПА МНОГО ЛЕТ МОГЛА
Dialogue: 0,0:10:26.53,0:10:28.45,Caption,,0,0,0,,ПОЗВОЛИТЬ СЕБЕ НЕ ОТВЕЧАТЬ НА ВОПРОС,
Dialogue: 0,0:10:28.69,0:10:31.25,Caption,,0,0,0,,КАК ИМЕННО СТРОИТЬ ОТНОШЕНИЯ С РОССИЕЙ ПОСЛЕ
Dialogue: 0,0:10:31.25,0:10:34.13,Caption,,0,0,0,,КОНФЛИКТА. ПОТОМУ ЧТО ГЛАВНЫМ СОДЕРЖАНИЕМ ПОЛИТИКИ
Dialogue: 0,0:10:34.21,0:10:37.33,Caption,,0,0,0,,БЫЛО ПРОТИВОСТОЯНИЕ. А ТЕПЕРЬ ПРИХОДИТСЯ ОТВЕЧАТЬ. И
Dialogue: 0,0:10:37.33,0:10:41.57,Caption,,0,0,0,,СРАЗУ ВЫЯСНЯЕТСЯ, ЧТО ЕДИНОГО ОТВЕТА НЕТ. ВОТ ПОЧЕМУ НЫНЕШНЯЯ
Dialogue: 0,0:10:41.57,0:10:44.77,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ НЕРАЗБЕРИХА ИНТЕРЕСНЕЕ ОБЫЧНОГО СПОРА О
Dialogue: 0,0:10:44.77,0:10:47.57,Caption,,0,0,0,,СОСТАВЕ ДЕЛЕГАЦИИ. ЭТО ПРОВЕРКА КОНСТРУКЦИИ НА
Dialogue: 0,0:10:47.57,0:10:53.05,Caption,,0,0,0,,ПРОЧНОСТЬ. КОГДА ВСЕ ОБЪЕДИНЕНЫ ПРОТИВ ОДНОГО ПРОТИВНИКА,
Dialogue: 0,0:10:53.36,0:10:56.17,Caption,,0,0,0,,ВНУТРИ МОЖНО ГОДАМИ ОТКЛАДЫВАТЬ МАССУ НЕПРИЯТНЫХ
Dialogue: 0,0:10:56.17,0:10:58.73,Caption,,0,0,0,,ВОПРОСОВ. КТО СИЛЬНЕЕ В САМОЙ ЕВРОПЕ?
Dialogue: 0,0:10:59.02,0:11:01.77,Caption,,0,0,0,,КТО ПРИНИМАЕТ РЕШЕНИЯ? ЧЬИ ИНТЕРЕСЫ ВАЖНЕЕ?
Dialogue: 0,0:11:01.85,0:11:04.17,Caption,,0,0,0,,КТО ПЛАТИТ? КТО ОТВЕЧАЕТ ЗА ПОСЛЕДСТВИЯ?
Dialogue: 0,0:11:04.42,0:11:07.13,Caption,,0,0,0,,КАКОЕ МЕСТО ЗАНИМАЕТ ВЕЛИКОБРИТАНИЯ ПОСЛЕ ВЫХОДА ИЗ
Dialogue: 0,0:11:07.13,0:11:10.73,Caption,,0,0,0,,ЕВРОСОЮЗА? НАСКОЛЬКО ГЕРМАНИЯ И ФРАНЦИЯ ГОТОВЫ ПОДЧИНЯТЬ
Dialogue: 0,0:11:10.81,0:11:12.65,Caption,,0,0,0,,СОБСТВЕННЫЕ ИНТЕРЕСЫ ОБЩЕЙ ПОЗИЦИИ?
Dialogue: 0,0:11:13.05,0:11:16.57,Caption,,0,0,0,,И ЧТО ДЕЛАТЬ С ГОСУДАРСТВАМИ, КОТОРЫЕ ВООБЩЕ НЕ ХОТЯТ ДВИГАТЬСЯ В ОДНОМ
Dialogue: 0,0:11:16.57,0:11:21.37,Caption,,0,0,0,,НАПРАВЛЕНИИ С БРЮССЕЛЕМ? ОБЩИЙ ПРОТИВНИК ПОЗВОЛЯЕТ КАКОЕ ТО ВРЕМЯ НЕ ОТВЕЧАТЬ
Dialogue: 0,0:11:21.45,0:11:24.49,Caption,,0,0,0,,НА ВСЁ ЭТО. НО МИР ЗАСТАВЛЯЕТ ОТВЕЧАТЬ. И
Dialogue: 0,0:11:24.57,0:11:27.69,Caption,,0,0,0,,ЗДЕСЬ ПОЛУЧАЕТСЯ ДОВОЛЬНО ЗАБАВНАЯ ВЕЩЬ. ЕВРОПА ТАК
Dialogue: 0,0:11:27.69,0:11:29.69,Caption,,0,0,0,,ДОЛГО ГОТОВИЛАСЬ УЧАСТВОВАТЬ В ПЕРЕГОВОРАХ С
Dialogue: 0,0:11:29.69,0:11:33.13,Caption,,0,0,0,,РОССИЕЙ, ЧТО ТЕПЕРЬ ОБНАРУЖИЛА НЕОБХОДИМОСТЬ СНАЧАЛА ПРОВЕСТИ
Dialogue: 0,0:11:33.13,0:11:35.93,Caption,,0,0,0,,ПЕРЕГОВОРЫ С ЕВРОПОЙ. ПРИЧЁМ ОНИ ВПОЛНЕ СПОСОБНЫ
Dialogue: 0,0:11:35.93,0:11:38.89,Caption,,0,0,0,,ОКАЗАТЬСЯ НЕ МЕНЕЕ СЛОЖНЫМИ. ПОТОМУ ЧТО ДОГОВОРИТЬСЯ
Dialogue: 0,0:11:38.89,0:11:42.57,Caption,,0,0,0,,ПРОТИВ КОГО ТО НАМНОГО ЛЕГЧЕ, ЧЕМ ДОГОВОРИТЬСЯ МЕЖДУ СОБОЙ О ТОМ,
Dialogue: 0,0:11:42.65,0:11:45.61,Caption,,0,0,0,,ЧТО БУДЕТ ПОТОМ. И, ПОХОЖЕ,
Dialogue: 0,0:11:45.69,0:11:48.89,Caption,,0,0,0,,ИМЕННО ЭТОТ ВОПРОС СТАНОВИТСЯ ДЛЯ ЕВРОПЫ КУДА ВАЖНЕЕ
Dialogue: 0,0:11:48.89,0:11:52.49,Caption,,0,0,0,,ТОГО, СКОЛЬКО СТУЛЬЕВ ЕЙ ВЫДЕЛЯТ ЗА СЛЕДУЮЩИМ ПЕРЕГОВОРНЫМ
Dialogue: 0,0:11:52.49,0:11:52.89,Caption,,0,0,0,,СТОЛОМ.
