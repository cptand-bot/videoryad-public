Dialogue: 0,0:00:00.04,0:00:02.60,Caption,,0,0,0,,В ЕВРОПЕ ПРИДУМАЛИ ЗАМЕЧАТЕЛЬНЫЙ СПОСОБ ЗАКОНЧИТЬ
Dialogue: 0,0:00:02.60,0:00:05.48,Caption,,0,0,0,,КОНФЛИКТ С РОССИЕЙ. СЕСТЬ ЗА СТОЛ ПЕРЕГОВОРОВ И
Dialogue: 0,0:00:05.48,0:00:08.12,Caption,,0,0,0,,САМУ РОССИЮ ЗА ЭТОТ СТОЛ НЕ ПУСКАТЬ. КРАСИВО,
Dialogue: 0,0:00:08.22,0:00:10.04,Caption,,0,0,0,,КОНЕЧНО. ТОЛЬКО ВОТ ОБЪЯСНИТЕ МНЕ,
Dialogue: 0,0:00:10.14,0:00:12.76,Caption,,0,0,0,,МУЖИКИ, А С КЕМ ТОГДА ДОГОВАРИВАТЬСЯ СОБРАЛИСЬ?
Dialogue: 0,0:00:13.08,0:00:14.76,Caption,,0,0,0,,И ВЕДЬ ЭТО НЕ КАКАЯ НИБУДЬ ШУТКА ИЗ
Dialogue: 0,0:00:14.76,0:00:17.88,Caption,,0,0,0,,ИНТЕРНЕТА, А ПРЕДЛОЖЕНИЕ ВПОЛНЕ СЕРЬЁЗНОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:00:17.88,0:00:20.84,Caption,,0,0,0,,ПОЛИТИКА. НО САМОЕ ЗАНЯТНОЕ ЗДЕСЬ ДАЖЕ НЕ ЭТО.
Dialogue: 0,0:00:21.05,0:00:24.52,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ПОСМОТРЕТЬ, ЧТО ПРОИСХОДИТ ВОКРУГ ЭТИХ ПЕРЕГОВОРОВ,
Dialogue: 0,0:00:24.77,0:00:28.20,Caption,,0,0,0,,ВОЗНИКАЕТ ВОПРОС ЕЩЁ ПОХЛЕЩЕ. А ВЫ ВООБЩЕ УВЕРЕНЫ,
Dialogue: 0,0:00:28.41,0:00:30.28,Caption,,0,0,0,,ЧТО ВСЕ ЭТИ ЛЮДИ ХОТЯТ ОДНОГО И ТОГО
Dialogue: 0,0:00:30.36,0:00:32.60,Caption,,0,0,0,,ЖЕ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:32.69,0:00:36.52,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ИТАК, ПРЕДСЕДАТЕЛЬ КОМИТЕТА ПО МЕЖДУНАРОДНЫМ ДЕЛАМ
Dialogue: 0,0:00:36.52,0:00:39.80,Caption,,0,0,0,,ПАРЛАМЕНТА ЭСТОНИИ МАРКО МИКЕЛЬСОН ПРЕДЛАГАЕТ СВОЙ
Dialogue: 0,0:00:39.80,0:00:43.16,Caption,,0,0,0,,ВАРИАНТ ЗАВЕРШЕНИЯ КОНФЛИКТА. ПЕРЕГОВОРЫ НУЖНЫ. МИР
Dialogue: 0,0:00:43.16,0:00:47.56,Caption,,0,0,0,,НУЖЕН. США, ЕВРОПА И УКРАИНА ДОЛЖНЫ МЕЖДУ СОБОЙ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:00:47.64,0:00:50.36,Caption,,0,0,0,,КАКИМ ЭТОТ МИР БУДЕТ. А РОССИИ ЗА СТОЛОМ
Dialogue: 0,0:00:50.44,0:00:53.24,Caption,,0,0,0,,БЫТЬ НЕ ДОЛЖНО. ВЕЛИКОЛЕПНО. ТО ЕСТЬ УСЛОВИЯ
Dialogue: 0,0:00:53.24,0:00:55.80,Caption,,0,0,0,,ОКОНЧАНИЯ КОНФЛИКТА С РОССИЕЙ ПРЕДЛАГАЕТСЯ СНАЧАЛА
Dialogue: 0,0:00:55.80,0:00:58.20,Caption,,0,0,0,,СОГЛАСОВАТЬ БЕЗ РОССИИ, А ПОТОМ,
Dialogue: 0,0:00:58.34,0:01:01.80,Caption,,0,0,0,,ВИДИМО, ТОРЖЕСТВЕННО ВРУЧИТЬ МОСКВЕ ГОТОВЫЙ ДОКУМЕНТ. ВОТ
Dialogue: 0,0:01:01.80,0:01:04.92,Caption,,0,0,0,,ЗДЕСЬ ПОДПИШИТЕ. ВОТ ЗДЕСЬ ПОСТАВЬТЕ ДАТУ. А ЕСЛИ
Dialogue: 0,0:01:05.00,0:01:09.72,Caption,,0,0,0,,НЕ СОГЛАСНЫ, ЗНАЧИТ, ВЫ ПРОТИВ МИРА. ЛОГИКА ЖЕЛЕЗНАЯ. ОСОБЕННО ЕСЛИ
Dialogue: 0,0:01:09.80,0:01:15.69,Caption,,0,0,0,,ЗАБЫТЬ ОДНУ МЕЛОЧЬ. РОССИЯ НЕ НАБЛЮДАЕТ ЗА ЭТОЙ ИСТОРИЕЙ ПО ТЕЛЕВИЗОРУ.
Dialogue: 0,0:01:15.93,0:01:18.57,Caption,,0,0,0,,У НЕЁ ЕСТЬ АРМИЯ, СОБСТВЕННЫЕ ТРЕБОВАНИЯ,
Dialogue: 0,0:01:18.80,0:01:21.13,Caption,,0,0,0,,СОБСТВЕННОЕ ПРЕДСТАВЛЕНИЕ О БЕЗОПАСНОСТИ И
Dialogue: 0,0:01:21.13,0:01:23.93,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ПРОДОЛЖАТЬ БОЕВЫЕ ДЕЙСТВИЯ. МОЖНО
Dialogue: 0,0:01:24.01,0:01:26.57,Caption,,0,0,0,,СКОЛЬКО УГОДНО СЧИТАТЬ ЭТИ ТРЕБОВАНИЯ НЕПРАВИЛЬНЫМИ,
Dialogue: 0,0:01:26.69,0:01:29.61,Caption,,0,0,0,,НАГЛЫМИ ИЛИ НЕПРИЕМЛЕМЫМИ. ТОЛЬКО ОТ ЭТОГО
Dialogue: 0,0:01:29.61,0:01:32.17,Caption,,0,0,0,,НЕОБХОДИМОСТЬ ДОГОВАРИВАТЬСЯ С САМОЙ РОССИЕЙ НИКУДА
Dialogue: 0,0:01:32.17,0:01:34.89,Caption,,0,0,0,,НЕ ИСЧЕЗАЕТ. И ТУТ СНОВА ВСПОМИНАЕТСЯ СТАРАЯ
Dialogue: 0,0:01:34.89,0:01:37.77,Caption,,0,0,0,,ФОРМУЛА. САМЫЕ МАЛЕНЬКИЕ ОПЯТЬ ОКАЗАЛИСЬ САМЫМИ
Dialogue: 0,0:01:37.85,0:01:40.25,Caption,,0,0,0,,ГРОМКИМИ. ИЗ ЭСТОНИИ УЖЕ ОБЪЯСНЯЮТ,
Dialogue: 0,0:01:40.34,0:01:43.05,Caption,,0,0,0,,КОГО НАДО ПРИГЛАШАТЬ, КОГО НЕ НАДО ПРИГЛАШАТЬ,
Dialogue: 0,0:01:43.29,0:01:45.93,Caption,,0,0,0,,КТО ИМЕЕТ ПРАВО ОПРЕДЕЛЯТЬ УСЛОВИЯ И КТО ТАКОГО
Dialogue: 0,0:01:45.93,0:01:48.65,Caption,,0,0,0,,ПРАВА НЕ ИМЕЕТ. И ТУТ ХОЧЕТСЯ ЗАДАТЬ СТАРЫЙ
Dialogue: 0,0:01:48.65,0:01:51.37,Caption,,0,0,0,,НЕПРИЛИЧНЫЙ ВОПРОС. А СКОЛЬКО У ВАС ДИВИЗИЙ?
Dialogue: 0,0:01:51.71,0:01:54.25,Caption,,0,0,0,,НЕ У СОЕДИНЁННЫХ ШТАТОВ. НЕ У ВСЕГО НАТО.
Dialogue: 0,0:01:54.46,0:01:57.45,Caption,,0,0,0,,У ВАС. ПОТОМУ ЧТО ПОЛИТИЧЕСКИЕ УСЛОВИЯ ИМЕЮТ ОДНУ
Dialogue: 0,0:01:57.45,0:02:00.09,Caption,,0,0,0,,НЕПРИЯТНУЮ ОСОБЕННОСТЬ. ЗА НИМИ ДОЛЖЕН СТОЯТЬ
Dialogue: 0,0:02:00.09,0:02:03.45,Caption,,0,0,0,,МЕХАНИЗМ, КОТОРЫЙ ЗАСТАВЛЯЕТ ДРУГУЮ СТОРОНУ ЭТИ УСЛОВИЯ
Dialogue: 0,0:02:03.53,0:02:06.89,Caption,,0,0,0,,ПРИНЯТЬ. ИНАЧЕ ЭТО НЕ ПЛАН ЗАВЕРШЕНИЯ КОНФЛИКТА. ЭТО
Dialogue: 0,0:02:06.97,0:02:10.81,Caption,,0,0,0,,СПИСОК ПОЖЕЛАНИЙ. КАЯ КАЛЛАС ПРИМЕРНО В ЭТО ЖЕ ВРЕМЯ ГОВОРИТ,
Dialogue: 0,0:02:11.03,0:02:13.77,Caption,,0,0,0,,ЧТО ПРЕДПОСЫЛОК ДЛЯ ОКОНЧАНИЯ КОНФЛИКТА НЕ ВИДИТ.
Dialogue: 0,0:02:14.09,0:02:18.73,Caption,,0,0,0,,СНАЧАЛА, ПО ЕЁ ЛОГИКЕ, НЕОБХОДИМО ПРЕКРАЩЕНИЕ ОГНЯ И УСТУПКИ СО СТОРОНЫ
Dialogue: 0,0:02:18.73,0:02:21.53,Caption,,0,0,0,,РОССИИ. ТО ЕСТЬ СХЕМА ПОЛУЧАЕТСЯ ДОВОЛЬНО УДОБНАЯ.
Dialogue: 0,0:02:23.82,0:02:25.90,Caption,,0,0,0,,МОСКВА СНАЧАЛА ДОЛЖНА СДЕЛАТЬ ТО,
Dialogue: 0,0:02:26.06,0:02:30.14,Caption,,0,0,0,,ЧЕГО ОТ НЕЁ ТРЕБУЮТ, А УЖЕ ПОТОМ ПОЯВЯТСЯ ПРЕДПОСЫЛКИ ДЛЯ РАЗГОВОРА О
Dialogue: 0,0:02:30.22,0:02:33.58,Caption,,0,0,0,,МИРЕ. ХОРОШО УСТРОИЛИСЬ. ТОЛЬКО РОССИЙСКИЕ УСЛОВИЯ
Dialogue: 0,0:02:33.58,0:02:35.74,Caption,,0,0,0,,ТОЖЕ НИКУДА НЕ ДЕЛИСЬ. И СКОЛЬКО БЫ В
Dialogue: 0,0:02:35.74,0:02:37.82,Caption,,0,0,0,,БРЮССЕЛЕ НИ ПОВТОРЯЛИ СЛОВО "УСТУПКИ",
Dialogue: 0,0:02:38.14,0:02:40.54,Caption,,0,0,0,,МОСКВА ОТ ЭТОГО НЕ НАЧИНАЕТ СЧИТАТЬ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:02:40.54,0:02:43.34,Caption,,0,0,0,,ТРЕБОВАНИЯ СВОИМИ СОБСТВЕННЫМИ. КАЛЛАС ОДНОВРЕМЕННО
Dialogue: 0,0:02:43.34,0:02:46.38,Caption,,0,0,0,,ОБВИНЯЕТ РОССИЮ В ТОМ, ЧТО УДАРЫ ПО ЭНЕРГЕТИКЕ,
Dialogue: 0,0:02:46.50,0:02:49.58,Caption,,0,0,0,,МОСТАМ И ЖЕЛЕЗНЫМ ДОРОГАМ ИСПОЛЬЗУЮТСЯ КАК СРЕДСТВО
Dialogue: 0,0:02:49.58,0:02:52.62,Caption,,0,0,0,,ДАВЛЕНИЯ НА УКРАИНСКОЕ НАСЕЛЕНИЕ. И ВОТ ЗДЕСЬ УЖЕ
Dialogue: 0,0:02:52.62,0:02:55.74,Caption,,0,0,0,,ВОЗНИКАЕТ ГОРАЗДО БОЛЕЕ НЕПРИЯТНЫЙ ВОПРОС. ЕСЛИ
Dialogue: 0,0:02:55.74,0:03:00.38,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ПОЛИТИКИ СЧИТАЮТ, ЧТО ПРОИСХОДЯЩЕЕ НАНОСИТ ТЯЖЁЛЫЙ УЩЕРБ ОБЫЧНЫМ
Dialogue: 0,0:03:00.38,0:03:02.78,Caption,,0,0,0,,ЛЮДЯМ, ТОГДА КАКОЙ У НИХ КОНЕЧНЫЙ ПЛАН?
Dialogue: 0,0:03:03.14,0:03:06.06,Caption,,0,0,0,,НЕ ЛОЗУНГ. НЕ ОЧЕРЕДНОЕ "ДАВИТЬ ДАЛЬШЕ". А
Dialogue: 0,0:03:06.06,0:03:08.94,Caption,,0,0,0,,КОНКРЕТНЫЙ РЕЗУЛЬТАТ. ДО КАКОГО СОСТОЯНИЯ ОНИ
Dialogue: 0,0:03:09.02,0:03:13.18,Caption,,0,0,0,,СОБИРАЮТСЯ ДАВИТЬ? ЧТО ИМЕННО ДОЛЖНО ПРОИЗОЙТИ ПОСЛЕ СЛЕДУЮЩЕГО ПАКЕТА
Dialogue: 0,0:03:13.18,0:03:16.94,Caption,,0,0,0,,ОГРАНИЧЕНИЙ, СЛЕДУЮЩЕГО РАУНДА ВОЕННОЙ ПОМОЩИ И СЛЕДУЮЩЕГО
Dialogue: 0,0:03:16.94,0:03:19.50,Caption,,0,0,0,,ЗАЯВЛЕНИЯ О ТОМ, ЧТО РОССИИ НАДО УСТУПИТЬ?
Dialogue: 0,0:03:19.98,0:03:22.62,Caption,,0,0,0,,ПОТОМУ ЧТО ПЯТЫЙ ГОД КОНФЛИКТА УЖЕ ИДЁТ. И
Dialogue: 0,0:03:22.62,0:03:25.34,Caption,,0,0,0,,ВОПРОС "А ЧТО ДАЛЬШЕ?" СТАНОВИТСЯ ВСЁ ТРУДНЕЕ
Dialogue: 0,0:03:25.34,0:03:28.06,Caption,,0,0,0,,ЗАКРЫВАТЬ КРАСИВОЙ ФРАЗОЙ. ОСОБЕННО КОГДА ВНУТРИ
Dialogue: 0,0:03:28.06,0:03:30.94,Caption,,0,0,0,,САМОЙ ЗАПАДНОЙ КОАЛИЦИИ ОТВЕТЫ НАЧИНАЮТ РАСХОДИТЬСЯ.
Dialogue: 0,0:03:31.14,0:03:33.74,Caption,,0,0,0,,МИКЕЛЬСОН ПРЕДЛАГАЕТ ДОГОВАРИВАТЬСЯ БЕЗ МОСКВЫ.
Dialogue: 0,0:03:36.02,0:03:39.94,Caption,,0,0,0,,КАЛЛАС ГОВОРИТ, ЧТО УСЛОВИЙ ДЛЯ ОКОНЧАНИЯ КОНФЛИКТА ПОКА НЕТ. А
Dialogue: 0,0:03:39.94,0:03:42.10,Caption,,0,0,0,,АМЕРИКАНЦЫ ТЕМ ВРЕМЕНЕМ ПЫТАЮТСЯ ПЕРЕГОВОРЫ
Dialogue: 0,0:03:42.10,0:03:45.22,Caption,,0,0,0,,УСКОРИТЬ. ВОТ ТЕБЕ И ОБЩАЯ ЛИНИЯ. ОДИН ТОРМОЗИТ.
Dialogue: 0,0:03:45.55,0:03:48.50,Caption,,0,0,0,,ДРУГОЙ СТАВИТ УСЛОВИЯ. ТРЕТИЙ УЖЕ СМОТРИТ НА ЧАСЫ.
Dialogue: 0,0:03:49.06,0:03:51.70,Caption,,0,0,0,,А ТЕПЕРЬ ДОБАВИМ СЮДА ЗЕЛЕНСКОГО. ОН ЗАЯВИЛ В
Dialogue: 0,0:03:51.78,0:03:53.30,Caption,,0,0,0,,ИНТЕРВЬЮ АМЕРИКАНСКОМУ ТЕЛЕВИДЕНИЮ,
Dialogue: 0,0:03:53.54,0:03:56.02,Caption,,0,0,0,,ЧТО КРУПНЫЕ ГОСУДАРСТВА НЕ ДОЛЖНЫ РЕШАТЬ СУДЬБУ
Dialogue: 0,0:03:56.02,0:03:59.06,Caption,,0,0,0,,УКРАИНЫ БЕЗ УЧАСТИЯ САМОЙ УКРАИНЫ. ЗВУЧИТ ВПОЛНЕ
Dialogue: 0,0:03:59.06,0:04:01.78,Caption,,0,0,0,,ПОНЯТНО. ЕСЛИ ОБСУЖДАЮТ БУДУЩЕЕ УКРАИНЫ,
Dialogue: 0,0:04:02.02,0:04:04.90,Caption,,0,0,0,,КИЕВ ХОЧЕТ НАХОДИТЬСЯ ЗА СТОЛОМ. НО ТЕПЕРЬ ПОСТАВЬТЕ
Dialogue: 0,0:04:04.98,0:04:07.94,Caption,,0,0,0,,РЯДОМ ДВЕ ПОЗИЦИИ. УКРАИНУ БЕЗ УКРАИНЫ ОБСУЖДАТЬ
Dialogue: 0,0:04:07.94,0:04:11.38,Caption,,0,0,0,,НЕЛЬЗЯ. А ЗАВЕРШЕНИЕ КОНФЛИКТА С РОССИЕЙ БЕЗ РОССИИ,
Dialogue: 0,0:04:11.64,0:04:15.46,Caption,,0,0,0,,ЗНАЧИТ, ОБСУЖДАТЬ МОЖНО. ОЧЕНЬ ТОНКИЙ ПРИНЦИП МЕЖДУНАРОДНОЙ
Dialogue: 0,0:04:15.46,0:04:18.42,Caption,,0,0,0,,СПРАВЕДЛИВОСТИ. РАБОТАЕТ ВЫБОРОЧНО. КОГО СЧИТАЕМ
Dialogue: 0,0:04:18.50,0:04:22.10,Caption,,0,0,0,,ПРАВИЛЬНЫМ УЧАСТНИКОМ, ТОГО ОТСУТСТВИЕ ВОЗМУЩАЕТ. КОГО СЧИТАЕМ
Dialogue: 0,0:04:22.10,0:04:25.78,Caption,,0,0,0,,НЕПРАВИЛЬНЫМ, ТОГО МОЖНО ВООБЩЕ НЕ ПРИГЛАШАТЬ. ТОЛЬКО КОНФЛИКТ ОТ
Dialogue: 0,0:04:25.78,0:04:28.18,Caption,,0,0,0,,МОРАЛЬНОЙ ОЦЕНКИ УЧАСТНИКОВ НЕ ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:04:28.34,0:04:30.82,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ДАЛЬШЕ НАЧИНАЕТСЯ ИСТОРИЯ,
Dialogue: 0,0:04:31.06,0:04:33.06,Caption,,0,0,0,,ГДЕ ТРЕБОВАНИЯ УЖЕ ПОЯВЛЯЮТСЯ РАНЬШЕ,
Dialogue: 0,0:04:33.25,0:04:37.30,Caption,,0,0,0,,ЧЕМ УСПЕВАЮТ ПОНЯТЬ, КТО ИМЕННО ИХ ВЫДВИНУЛ. ПРЕЗИДЕНТ ФИНЛЯНДИИ
Dialogue: 0,0:04:37.30,0:04:41.38,Caption,,0,0,0,,АЛЕКСАНДР СТУББ ЗАЯВИЛ, ЧТО ФИНЛЯНДИЯ ИЗ НАТО ВЫХОДИТЬ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:04:41.54,0:04:44.18,Caption,,0,0,0,,ПОЗИЦИЯ ЯСНАЯ. НО ДАЛЬШЕ СТАЛО ВЕСЕЛЕЕ.
Dialogue: 0,0:04:46.45,0:04:50.21,Caption,,0,0,0,,СТУББ УТОЧНИЛ, ЧТО ОТ РОССИЙСКИХ ПРЕДСТАВИТЕЛЕЙ ТРЕБОВАНИЯ О ВЫХОДЕ
Dialogue: 0,0:04:50.21,0:04:53.09,Caption,,0,0,0,,ФИНЛЯНДИИ ИЗ НАТО ОН НЕ СЛЫШАЛ. КРЕМЛЬ ТОЖЕ
Dialogue: 0,0:04:53.09,0:04:56.61,Caption,,0,0,0,,СООБЩИЛ, ЧТО ТАКОГО ТРЕБОВАНИЯ НЕ ПРЕДЪЯВЛЯЛ. ПРЕКРАСНО.
Dialogue: 0,0:04:56.93,0:04:58.93,Caption,,0,0,0,,ЧЕЛОВЕК РЕШИТЕЛЬНО ОТВЕРГ УСЛОВИЕ,
Dialogue: 0,0:04:59.16,0:05:01.49,Caption,,0,0,0,,КОТОРОЕ ЕМУ, ПО ЕГО СОБСТВЕННЫМ СЛОВАМ,
Dialogue: 0,0:05:01.64,0:05:04.61,Caption,,0,0,0,,НИКТО НЕ СТАВИЛ. ТО ЕСТЬ ПОЛИТИЧЕСКАЯ РЕАКЦИЯ УЖЕ
Dialogue: 0,0:05:04.61,0:05:08.37,Caption,,0,0,0,,ЕСТЬ. КАТЕГОРИЧЕСКИЙ ОТВЕТ УЖЕ ЕСТЬ. ЗАГОЛОВКИ УЖЕ
Dialogue: 0,0:05:08.45,0:05:11.57,Caption,,0,0,0,,ЕСТЬ. ОСТАЛОСЬ НАЙТИ САМО ТРЕБОВАНИЕ. НО ЗА ЭТИМ
Dialogue: 0,0:05:11.57,0:05:13.81,Caption,,0,0,0,,СПОРОМ МОЖЕТ СКРЫВАТЬСЯ КУДА БОЛЕЕ ИНТЕРЕСНЫЙ
Dialogue: 0,0:05:13.81,0:05:17.01,Caption,,0,0,0,,РАСЧЁТ. МОСКВЕ МОГУТ ЗАРАНЕЕ ПРИПИСЫВАТЬ ЗАВЫШЕННЫЕ
Dialogue: 0,0:05:17.01,0:05:20.53,Caption,,0,0,0,,ТРЕБОВАНИЯ, ЧТОБЫ ПОТОМ ОБЪЯСНИТЬ ВОЗМОЖНЫЙ ПРОВАЛ ПЕРЕГОВОРОВ
Dialogue: 0,0:05:20.54,0:05:23.49,Caption,,0,0,0,,ОЧЕНЬ ПРОСТО. РОССИЯ ПОТРЕБОВАЛА НЕВОЗМОЖНОГО.
Dialogue: 0,0:05:23.81,0:05:26.69,Caption,,0,0,0,,РОССИЯ НЕ ЗАХОТЕЛА ДОГОВАРИВАТЬСЯ. РОССИЯ ВСЁ
Dialogue: 0,0:05:26.69,0:05:30.13,Caption,,0,0,0,,СОРВАЛА. СХЕМА УДОБНЕЙШАЯ. СНАЧАЛА СОЗДАЁТСЯ
Dialogue: 0,0:05:30.13,0:05:33.57,Caption,,0,0,0,,УСЛОВИЕ, КОТОРОЕ ВЫГЛЯДИТ ЗАВЕДОМО НЕПРИЕМЛЕМЫМ. ПОТОМ
Dialogue: 0,0:05:33.57,0:05:36.77,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ПОЛИТИК ЕГО ГЕРОИЧЕСКИ ОТВЕРГАЕТ. А ЕСЛИ
Dialogue: 0,0:05:36.77,0:05:38.53,Caption,,0,0,0,,ПЕРЕГОВОРЫ ЗАКАНЧИВАЮТСЯ НИЧЕМ,
Dialogue: 0,0:05:38.66,0:05:40.93,Caption,,0,0,0,,ВИНОВНЫЙ УЖЕ НАЗНАЧЕН. И ЗАМЕТЬТЕ,
Dialogue: 0,0:05:41.17,0:05:43.33,Caption,,0,0,0,,ВСЁ ЭТО ПРОИСХОДИТ ЕЩЁ ДО ТОГО,
Dialogue: 0,0:05:43.49,0:05:46.37,Caption,,0,0,0,,КАК БОЛЬШОЙ РАЗГОВОР ВООБЩЕ ЗАКОНЧЕН. ТО ЕСТЬ БОРЬБА
Dialogue: 0,0:05:46.37,0:05:49.25,Caption,,0,0,0,,УЖЕ ИДЁТ НЕ ТОЛЬКО ЗА УСЛОВИЯ СОГЛАШЕНИЯ. ИДЁТ
Dialogue: 0,0:05:49.33,0:05:51.41,Caption,,0,0,0,,БОРЬБА ЗА ТО, КТО БУДЕТ ВИНОВАТ,
Dialogue: 0,0:05:51.56,0:05:54.45,Caption,,0,0,0,,ЕСЛИ СОГЛАШЕНИЯ НЕ БУДЕТ. НО ТУТ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:05:54.45,0:05:58.53,Caption,,0,0,0,,СООБЩЕНИЕ BLOOMBERG, И ИСТОРИЯ С ФИНЛЯНДИЕЙ НАЧИНАЕТ ВЫГЛЯДЕТЬ СОВСЕМ
Dialogue: 0,0:05:58.53,0:06:03.53,Caption,,0,0,0,,ИНАЧЕ. ПОТОМУ ЧТО РЕЧЬ ИДЁТ НЕ О ВЫХОДЕ ФИНЛЯНДИИ
Dialogue: 0,0:06:03.53,0:06:06.41,Caption,,0,0,0,,ИЗ НАТО. МОСКВА, СОГЛАСНО ПУБЛИКАЦИИ,
Dialogue: 0,0:06:06.65,0:06:09.85,Caption,,0,0,0,,ОБСУЖДАЕТ СОВСЕМ ДРУГУЮ КОНСТРУКЦИЮ. ОГРАНИЧЕНИЕ
Dialogue: 0,0:06:09.85,0:06:11.93,Caption,,0,0,0,,ВОЕННОГО ПРИСУТСТВИЯ НАТО В СТРАНАХ,
Dialogue: 0,0:06:12.09,0:06:14.81,Caption,,0,0,0,,ВСТУПИВШИХ В АЛЬЯНС ПОСЛЕ ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО
Dialogue: 0,0:06:14.81,0:06:17.93,Caption,,0,0,0,,СЕДЬМОГО ГОДА. И В ОБМЕН РОССИЯ ГОТОВА ОБСУЖДАТЬ
Dialogue: 0,0:06:17.93,0:06:20.81,Caption,,0,0,0,,СОКРАЩЕНИЕ СОБСТВЕННЫХ СИЛ В КАЛИНИНГРАДСКОЙ ОБЛАСТИ
Dialogue: 0,0:06:20.81,0:06:23.61,Caption,,0,0,0,,И БЕЛАРУСИ. ВОТ ЭТО УЖЕ СОВСЕМ ДРУГОЙ РАЗГОВОР.
Dialogue: 0,0:06:23.89,0:06:28.25,Caption,,0,0,0,,НЕ "ФИНЛЯНДИЯ, ВЫХОДИ ИЗ НАТО". НЕ "РАЗОГНАТЬ АЛЬЯНС". А ВЗАИМНОЕ
Dialogue: 0,0:06:28.25,0:06:30.65,Caption,,0,0,0,,ОГРАНИЧЕНИЕ ВОЕННОГО ПРИСУТСТВИЯ. И ЭТО
Dialogue: 0,0:06:30.65,0:06:33.45,Caption,,0,0,0,,ПРИНЦИПИАЛЬНАЯ РАЗНИЦА. СТРАНА МОЖЕТ ОСТАВАТЬСЯ
Dialogue: 0,0:06:33.45,0:06:36.33,Caption,,0,0,0,,ЧЛЕНОМ НАТО, НО КОЛИЧЕСТВО ИНОСТРАННЫХ ВОЙСК,
Dialogue: 0,0:06:36.41,0:06:40.01,Caption,,0,0,0,,ТЕХНИКИ, БАЗ И ВОЕННОЙ ИНФРАСТРУКТУРЫ НА ЕЁ ТЕРРИТОРИИ МОЖНО
Dialogue: 0,0:06:40.01,0:06:43.13,Caption,,0,0,0,,ОБСУЖДАТЬ ОТДЕЛЬНО. ТО ЕСТЬ ГРОМКАЯ ИСТОРИЯ О ТОМ,
Dialogue: 0,0:06:43.37,0:06:46.25,Caption,,0,0,0,,ЧТО ФИНЛЯНДИЮ ЯКОБЫ ЗАСТАВЛЯЮТ ВЫЙТИ ИЗ АЛЬЯНСА,
Dialogue: 0,0:06:46.57,0:06:49.37,Caption,,0,0,0,,В ОДНОМ ИНФОРМАЦИОННОМ ПОТОКЕ СУЩЕСТВУЕТ РЯДОМ С
Dialogue: 0,0:06:49.37,0:06:52.65,Caption,,0,0,0,,ГОРАЗДО БОЛЕЕ СЛОЖНОЙ СХЕМОЙ. И ЭТА СХЕМА ВОЗВРАЩАЕТ
Dialogue: 0,0:06:52.65,0:06:56.33,Caption,,0,0,0,,НАС К ТОМУ, О ЧЁМ РОССИЯ ГОВОРИТ УЖЕ МНОГО ЛЕТ. ТЫСЯЧА
Dialogue: 0,0:06:56.41,0:06:58.65,Caption,,0,0,0,,ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОЙ ГОД ВОЗНИК НЕ НЕДЕЛЮ
Dialogue: 0,0:06:58.65,0:07:01.61,Caption,,0,0,0,,НАЗАД. РОССИЙСКИЕ ТРЕБОВАНИЯ О НОВОЙ АРХИТЕКТУРЕ
Dialogue: 0,0:07:01.61,0:07:04.25,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ ЗВУЧАЛИ ЕЩЁ ДО НАЧАЛА
Dialogue: 0,0:07:04.25,0:07:07.21,Caption,,0,0,0,,НЫНЕШНЕГО КОНФЛИКТА. МОСКВА ТОГДА ПРЯМО СТАВИЛА
Dialogue: 0,0:07:07.21,0:07:10.01,Caption,,0,0,0,,ВОПРОС О РАСШИРЕНИИ НАТО И ВОЕННОЙ ИНФРАСТРУКТУРЕ У
Dialogue: 0,0:07:10.01,0:07:15.42,Caption,,0,0,0,,СВОИХ ГРАНИЦ. ПОЭТОМУ САМ ПО СЕБЕ РАЗГОВОР О ТЫСЯЧА ДЕВЯТЬСОТ
Dialogue: 0,0:07:15.42,0:07:18.22,Caption,,0,0,0,,ДЕВЯНОСТО СЕДЬМОМ ГОДЕ ДАВНО НЕ НОВОСТЬ. НОВОЕ ЗДЕСЬ
Dialogue: 0,0:07:18.22,0:07:21.10,Caption,,0,0,0,,ДРУГОЕ. ЕСЛИ ИНФОРМАЦИЯ BLOOMBERG ВЕРНА,
Dialogue: 0,0:07:21.30,0:07:24.86,Caption,,0,0,0,,ОБСУЖДАЕТСЯ НЕ ПРОСТО ОТКАТ НАТО. ОБСУЖДАЕТСЯ ОБМЕН.
Dialogue: 0,0:07:25.18,0:07:28.14,Caption,,0,0,0,,ВЫ СОКРАЩАЕТЕ ПРИСУТСТВИЕ ЗДЕСЬ. МЫ СОКРАЩАЕМ
Dialogue: 0,0:07:28.14,0:07:31.42,Caption,,0,0,0,,ПРИСУТСТВИЕ ТАМ. А ЭТО УЖЕ ТОРГ. ПРИЧЁМ ТОРГ
Dialogue: 0,0:07:31.42,0:07:34.06,Caption,,0,0,0,,НЕ О КАКОМ НИБУДЬ ОТДЕЛЬНО ВЗЯТОМ НАСЕЛЁННОМ ПУНКТЕ
Dialogue: 0,0:07:34.14,0:07:36.94,Caption,,0,0,0,,НА УКРАИНЕ. РЕЧЬ ИДЁТ ОБ УСТРОЙСТВЕ БЕЗОПАСНОСТИ НА
Dialogue: 0,0:07:37.02,0:07:39.82,Caption,,0,0,0,,ОГРОМНОЙ ЧАСТИ ЕВРОПЕЙСКОГО КОНТИНЕНТА. И ВОТ ЗДЕСЬ
Dialogue: 0,0:07:39.90,0:07:44.06,Caption,,0,0,0,,РУШИТСЯ УДОБНАЯ КОНСТРУКЦИЯ, В КОТОРОЙ ВСЁ МОЖНО СВЕСТИ ТОЛЬКО К УКРАИНСКОЙ
Dialogue: 0,0:07:44.06,0:07:47.10,Caption,,0,0,0,,ТЕРРИТОРИИ. НЕ ПОЛУЧАЕТСЯ. РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:07:47.10,0:07:49.58,Caption,,0,0,0,,ШИРЕ. МОСКВА СВЯЗЫВАЕТ КОНФЛИКТ С ВОЕННЫМ
Dialogue: 0,0:07:49.66,0:07:52.14,Caption,,0,0,0,,УСТРОЙСТВОМ ЕВРОПЫ И ПРИСУТСТВИЕМ НАТО У СВОИХ
Dialogue: 0,0:07:52.14,0:07:55.58,Caption,,0,0,0,,ГРАНИЦ. МОЖНО СОГЛАШАТЬСЯ С ТАКОЙ ЛОГИКОЙ. МОЖНО ЕЁ
Dialogue: 0,0:07:55.58,0:07:58.86,Caption,,0,0,0,,ОТВЕРГАТЬ. НО ЕСЛИ ИМЕННО ЭТО РОССИЯ СЧИТАЕТ ОДНОЙ
Dialogue: 0,0:07:58.94,0:08:03.42,Caption,,0,0,0,,ИЗ КЛЮЧЕВЫХ ПРИЧИН КОНФЛИКТА, НЕВОЗМОЖНО ВСЕРЬЁЗ РАССЧИТЫВАТЬ ЗАКОНЧИТЬ КОНФЛИКТ,
Dialogue: 0,0:08:03.58,0:08:06.22,Caption,,0,0,0,,ВООБЩЕ НЕ ОБСУЖДАЯ ЭТОТ ВОПРОС. ТЕМ БОЛЕЕ БЕЗ
Dialogue: 0,0:08:06.22,0:08:10.70,Caption,,0,0,0,,РОССИИ ЗА СТОЛОМ. А ТЕПЕРЬ САМОЕ ИНТЕРЕСНОЕ. ПОКА ЕВРОПЕЙСКИЕ ПОЛИТИКИ
Dialogue: 0,0:08:10.70,0:08:14.30,Caption,,0,0,0,,РАССКАЗЫВАЮТ, КОГО НАДО ПРИГЛАШАТЬ И КАКИЕ УСТУПКИ ДОЛЖНА СДЕЛАТЬ
Dialogue: 0,0:08:14.30,0:08:17.50,Caption,,0,0,0,,МОСКВА, АМЕРИКАНЦЫ ПОЧЕМУ ТО НАЧИНАЮТ ТОРОПИТЬСЯ.
Dialogue: 0,0:08:19.79,0:08:21.71,Caption,,0,0,0,,ПО ИНФОРМАЦИИ THE KYIV INDEPENDENT,
Dialogue: 0,0:08:21.90,0:08:24.83,Caption,,0,0,0,,СТИВ УИТКОФФ И ДЖАРЕД КУШНЕР ПЫТАЮТСЯ УСКОРИТЬ
Dialogue: 0,0:08:24.83,0:08:27.47,Caption,,0,0,0,,ПЕРЕГОВОРЫ ДО ВОЗМОЖНОГО ИЗМЕНЕНИЯ ПОЛИТИЧЕСКОГО
Dialogue: 0,0:08:27.47,0:08:30.35,Caption,,0,0,0,,БАЛАНСА В КОНГРЕССЕ США. ТО ЕСТЬ НЫНЕШНЕЕ ОКНО
Dialogue: 0,0:08:30.43,0:08:32.03,Caption,,0,0,0,,ДЛЯ СОГЛАШЕНИЯ МОЖЕТ ЗАКРЫТЬСЯ.
Dialogue: 0,0:08:32.58,0:08:35.47,Caption,,0,0,0,,И ВОТ ЭТО УЖЕ ОЧЕНЬ ИНТЕРЕСНАЯ ДЕТАЛЬ. ПОЛУЧАЕТСЯ,
Dialogue: 0,0:08:35.70,0:08:38.67,Caption,,0,0,0,,УСЛОВИЯ БУДУЩЕГО МИРА ЗАВИСЯТ НЕ ТОЛЬКО ОТ ТОГО,
Dialogue: 0,0:08:38.91,0:08:41.87,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ МЕЖДУ РОССИЕЙ И УКРАИНОЙ. ОНИ ЗАВИСЯТ
Dialogue: 0,0:08:41.87,0:08:44.19,Caption,,0,0,0,,ЕЩЁ И ОТ АМЕРИКАНСКОГО ПОЛИТИЧЕСКОГО КАЛЕНДАРЯ.
Dialogue: 0,0:08:44.67,0:08:47.95,Caption,,0,0,0,,СЕГОДНЯ В ВАШИНГТОНЕ ОДИН РАСКЛАД. ЗАВТРА ДРУГОЙ.
Dialogue: 0,0:08:48.11,0:08:50.99,Caption,,0,0,0,,СЕГОДНЯ МОЖНО ДОГОВОРИТЬСЯ НА ОДНИХ УСЛОВИЯХ. ПОСЛЕ
Dialogue: 0,0:08:50.99,0:08:54.11,Caption,,0,0,0,,ПЕРЕСТАНОВКИ В КОНГРЕССЕ СТАНЕТ СЛОЖНЕЕ. ОТЛИЧНАЯ
Dialogue: 0,0:08:54.11,0:08:56.91,Caption,,0,0,0,,ОСНОВА ДЛЯ АРХИТЕКТУРЫ БЕЗОПАСНОСТИ НА ДЕСЯТИЛЕТИЯ.
Dialogue: 0,0:08:57.22,0:08:59.79,Caption,,0,0,0,,ОСОБЕННО ДЛЯ РОССИИ. ТЕБЕ ПРЕДЛАГАЮТ ДОГОВОРИТЬСЯ
Dialogue: 0,0:08:59.79,0:09:02.75,Caption,,0,0,0,,СЕЙЧАС, ПОТОМУ ЧТО ЧЕРЕЗ НЕКОТОРОЕ ВРЕМЯ АМЕРИКАНСКАЯ
Dialogue: 0,0:09:02.75,0:09:05.95,Caption,,0,0,0,,ВНУТРЕННЯЯ ПОЛИТИКА МОЖЕТ ИЗМЕНИТЬСЯ. А У МОСКВЫ ТУТ
Dialogue: 0,0:09:05.95,0:09:09.23,Caption,,0,0,0,,ВОЗНИКАЕТ ЛОГИЧНЫЙ ВОПРОС. ХОРОШО. ДОПУСТИМ,
Dialogue: 0,0:09:09.31,0:09:12.35,Caption,,0,0,0,,МЫ ДОГОВОРИЛИСЬ. А ЧЕРЕЗ СЛЕДУЮЩИЙ ПОЛИТИЧЕСКИЙ ЦИКЛ
Dialogue: 0,0:09:12.43,0:09:14.35,Caption,,0,0,0,,ЧТО? СНОВА ВСЁ ПЕРЕСМАТРИВАЕМ?
Dialogue: 0,0:09:14.59,0:09:18.11,Caption,,0,0,0,,СНОВА МЕНЯЕТСЯ КОНГРЕСС? СНОВА ПОЯВЛЯЮТСЯ ДРУГИЕ УСЛОВИЯ?
Dialogue: 0,0:09:18.27,0:09:21.95,Caption,,0,0,0,,СНОВА НАЧИНАЕМ СНАЧАЛА? ВОТ ПОЧЕМУ РОССИЙСКИЙ РАЗГОВОР О ГАРАНТИЯХ
Dialogue: 0,0:09:21.95,0:09:24.43,Caption,,0,0,0,,БЕЗОПАСНОСТИ ПОСТОЯННО УПИРАЕТСЯ НЕ ТОЛЬКО В
Dialogue: 0,0:09:24.43,0:09:29.71,Caption,,0,0,0,,КРАСИВЫЕ ОБЕЩАНИЯ, НО И В ТО, НАСКОЛЬКО ЭТИ ОБЕЩАНИЯ ПЕРЕЖИВУТ ОЧЕРЕДНЫЕ ВЫБОРЫ.
Dialogue: 0,0:09:31.99,0:09:34.39,Caption,,0,0,0,,ТРАМП В ЭТОЙ ИСТОРИИ ДЕЙСТВУЕТ СОВЕРШЕННО В СВОЁМ
Dialogue: 0,0:09:34.39,0:09:37.03,Caption,,0,0,0,,СТИЛЕ. ЕМУ НУЖЕН РЕЗУЛЬТАТ. НЕ ПОТОМУ,
Dialogue: 0,0:09:37.27,0:09:40.07,Caption,,0,0,0,,ЧТО ОН ВНЕЗАПНО ПРОНИКСЯ ЕВРОПЕЙСКОЙ ИДЕЕЙ ВСЕОБЩЕГО
Dialogue: 0,0:09:40.07,0:09:43.27,Caption,,0,0,0,,БРАТСТВА. У СОЕДИНЁННЫХ ШТАТОВ СВОИ ИНТЕРЕСЫ. У
Dialogue: 0,0:09:43.27,0:09:46.63,Caption,,0,0,0,,ТРАМПА СВОИ ИНТЕРЕСЫ. И ОНИ НЕ ОБЯЗАНЫ СОВПАДАТЬ
Dialogue: 0,0:09:46.63,0:09:50.15,Caption,,0,0,0,,НИ С ИНТЕРЕСАМИ ЗЕЛЕНСКОГО, НИ С ПОЛИТИЧЕСКОЙ ЛИНИЕЙ КАЛЛАС,
Dialogue: 0,0:09:50.39,0:09:52.71,Caption,,0,0,0,,НИ С ФАНТАЗИЯМИ ЭСТОНСКОГО ПАРЛАМЕНТАРИЯ О
Dialogue: 0,0:09:52.79,0:09:55.27,Caption,,0,0,0,,ПЕРЕГОВОРАХ БЕЗ РОССИИ. И ПОКА АМЕРИКАНСКИЕ
Dialogue: 0,0:09:55.27,0:09:59.59,Caption,,0,0,0,,ПЕРЕГОВОРЩИКИ ТОРОПЯТСЯ, В САМОМ ВАШИНГТОНЕ НАЧИНАЕТ ЗВУЧАТЬ ЕЩЁ ОДИН
Dialogue: 0,0:09:59.59,0:10:04.15,Caption,,0,0,0,,ИНТЕРЕСНЫЙ ГОЛОС. ЗАМЕСТИТЕЛЬ ГЛАВЫ ПЕНТАГОНА ПО ПОЛИТИЧЕСКИМ ВОПРОСАМ
Dialogue: 0,0:10:04.15,0:10:07.27,Caption,,0,0,0,,ЭЛБРИДЖ КОЛБИ РАСКРИТИКОВАЛ ЭФФЕКТИВНОСТЬ УКРАИНСКИХ
Dialogue: 0,0:10:07.27,0:10:10.23,Caption,,0,0,0,,УДАРОВ ВГЛУБЬ РОССИИ. НЕ С ТОЧКИ ЗРЕНИЯ ТОГО,
Dialogue: 0,0:10:10.43,0:10:13.51,Caption,,0,0,0,,НАСКОЛЬКО ЭФФЕКТНО ВЫГЛЯДИТ ВЗРЫВ. НЕ С ТОЧКИ ЗРЕНИЯ
Dialogue: 0,0:10:13.51,0:10:16.39,Caption,,0,0,0,,КРАСИВЫХ КАДРОВ. А С ТОЧКИ ЗРЕНИЯ РЕЗУЛЬТАТА.
Dialogue: 0,0:10:16.66,0:10:18.95,Caption,,0,0,0,,ПОМОГЛО ЭТО ОСТАНОВИТЬ РОССИЙСКОЕ ПРОДВИЖЕНИЕ?
Dialogue: 0,0:10:19.11,0:10:21.27,Caption,,0,0,0,,НЕТ. ПОМОГЛО ЗАКОНЧИТЬ КОНФЛИКТ?
Dialogue: 0,0:10:21.34,0:10:25.51,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, ТОЖЕ НЕТ. ВОТ ЭТО УЖЕ РАЗГОВОР ВЗРОСЛОГО ЧЕЛОВЕКА.
Dialogue: 0,0:10:25.83,0:10:28.79,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО ОБСУЖДАТЬ ГРОМКОСТЬ ВЗРЫВА. НО
Dialogue: 0,0:10:28.79,0:10:31.27,Caption,,0,0,0,,ЕСЛИ ПОСЛЕ НЕГО ЛИНИЯ ФРОНТА НЕ ИЗМЕНИЛАСЬ,
Dialogue: 0,0:10:31.35,0:10:35.51,Caption,,0,0,0,,ВОЗНИКАЕТ ВОПРОС, ДЛЯ ЧЕГО ИМЕННО БЫЛ НАНЕСЁН УДАР. НО ЗДЕСЬ
Dialogue: 0,0:10:35.59,0:10:38.07,Caption,,0,0,0,,ВАЖНЕЕ ДРУГОЕ. ЭТИ ВОПРОСЫ ТЕПЕРЬ ЗАДАЁТ
Dialogue: 0,0:10:38.07,0:10:40.79,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЬ ПЕНТАГОНА. НА ЗАСЕДАНИИ НАТО.
Dialogue: 0,0:10:40.93,0:10:44.15,Caption,,0,0,0,,СОЮЗНИКАМ. И ДАЛЬШЕ КОЛБИ ВООБЩЕ УШЁЛ ДО ВЫСТУПЛЕНИЯ
Dialogue: 0,0:10:44.15,0:10:49.72,Caption,,0,0,0,,УКРАИНСКОГО МИНИСТРА ОБОРОНЫ. МОЖНО ОБЪЯСНЯТЬ ЭТО РАСПИСАНИЕМ,
Dialogue: 0,0:10:49.87,0:10:53.64,Caption,,0,0,0,,ДЕЛАМИ, ЗАНЯТОСТЬЮ. НО ПОЛИТИЧЕСКИ КАРТИНКА ПОЛУЧИЛАСЬ
Dialogue: 0,0:10:53.64,0:10:56.84,Caption,,0,0,0,,РОСКОШНАЯ. АМЕРИКАНЕЦ ПРИШЁЛ. ОБЪЯСНИЛ,
Dialogue: 0,0:10:56.94,0:10:59.48,Caption,,0,0,0,,ЧТО ЧАСТЬ УКРАИНСКОЙ СТРАТЕГИИ НЕ ДАЁТ НУЖНОГО
Dialogue: 0,0:10:59.48,0:11:04.04,Caption,,0,0,0,,РЕЗУЛЬТАТА. И УШЁЛ, НЕ ДОЖДАВШИСЬ УКРАИНСКОГО ОТВЕТА. ПРЕКРАСНАЯ
Dialogue: 0,0:11:04.04,0:11:06.68,Caption,,0,0,0,,ДЕМОНСТРАЦИЯ ПОЛНОГО СОЮЗНИЧЕСКОГО ЕДИНСТВА.
Dialogue: 0,0:11:07.00,0:11:10.84,Caption,,0,0,0,,ОСОБЕННО НА ФОНЕ ТОГО, ЧТО ЕВРОПЕЙЦЫ ПРОДОЛЖАЮТ ПРИЗЫВАТЬ К УСИЛЕНИЮ
Dialogue: 0,0:11:10.84,0:11:13.56,Caption,,0,0,0,,ДАВЛЕНИЯ. И ВОТ ТУТ МЫ ПОДХОДИМ К ТРАМПУ.
Dialogue: 0,0:11:13.90,0:11:17.32,Caption,,0,0,0,,ОН ЗАЯВИЛ, ЧТО СОЕДИНЁННЫЕ ШТАТЫ ХОРОШО ЗАРАБАТЫВАЮТ НА
Dialogue: 0,0:11:17.32,0:11:19.80,Caption,,0,0,0,,ВООРУЖЕНИИ УКРАИНЫ. ПРИЧЁМ ОРУЖИЕ ПОКУПАЮТ
Dialogue: 0,0:11:19.80,0:11:22.60,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ГОСУДАРСТВА. ТО ЕСТЬ СХЕМА ПРОСТАЯ.
Dialogue: 0,0:11:22.75,0:11:26.28,Caption,,0,0,0,,ЕВРОПА ПЛАТИТ. АМЕРИКА ПРОИЗВОДИТ. УКРАИНА ПОЛУЧАЕТ.
Dialogue: 0,0:11:26.49,0:11:29.32,Caption,,0,0,0,,АМЕРИКАНСКИЙ БИЗНЕС ЗАРАБАТЫВАЕТ. И ТРАМП СОВЕРШЕННО
Dialogue: 0,0:11:29.32,0:11:31.96,Caption,,0,0,0,,СПОКОЙНО ЭТО ПРОГОВАРИВАЕТ. НИКАКОЙ РОМАНТИКИ.
Dialogue: 0,0:11:32.28,0:11:34.36,Caption,,0,0,0,,НИКАКИХ РАЗГОВОРОВ О БЕСКОРЫСТНОЙ ПОМОЩИ
Dialogue: 0,0:11:34.36,0:11:37.48,Caption,,0,0,0,,ЧЕЛОВЕЧЕСТВУ. ХОРОШИЙ БИЗНЕС. И ТЕПЕРЬ ПОСМОТРИТЕ,
Dialogue: 0,0:11:37.64,0:11:39.80,Caption,,0,0,0,,КАКАЯ ИНТЕРЕСНАЯ КОНСТРУКЦИЯ ПОЛУЧАЕТСЯ У
Dialogue: 0,0:11:39.80,0:11:43.08,Caption,,0,0,0,,ВАШИНГТОНА. УИТКОФФ И КУШНЕР ТОРОПЯТСЯ ДОГОВОРИТЬСЯ.
Dialogue: 0,0:11:43.37,0:11:45.64,Caption,,0,0,0,,КОЛБИ СПРАШИВАЕТ, ЗАЧЕМ НУЖНЫ УДАРЫ,
Dialogue: 0,0:11:45.88,0:11:48.52,Caption,,0,0,0,,КОТОРЫЕ НЕ ДАЮТ ВОЕННОГО РЕЗУЛЬТАТА. ТРАМП
Dialogue: 0,0:11:48.52,0:11:52.36,Caption,,0,0,0,,РАССКАЗЫВАЕТ, СКОЛЬКО АМЕРИКА ЗАРАБАТЫВАЕТ НА ПРОДАЖЕ ОРУЖИЯ. И
Dialogue: 0,0:11:52.36,0:11:54.84,Caption,,0,0,0,,ВСЁ ЭТО СУЩЕСТВУЕТ ОДНОВРЕМЕННО. ПОТОМУ ЧТО
Dialogue: 0,0:11:54.92,0:11:57.72,Caption,,0,0,0,,АМЕРИКАНСКИЕ ИНТЕРЕСЫ НЕ ОБЯЗАНЫ ПОМЕЩАТЬСЯ В ОДНУ
Dialogue: 0,0:11:57.72,0:12:00.68,Caption,,0,0,0,,КРАСИВУЮ ЕВРОПЕЙСКУЮ ФОРМУЛУ. АМЕРИКА МОЖЕТ ХОТЕТЬ
Dialogue: 0,0:12:00.68,0:12:06.25,Caption,,0,0,0,,СОГЛАШЕНИЯ. АМЕРИКА МОЖЕТ ПРОДАВАТЬ ОРУЖИЕ. АМЕРИКА МОЖЕТ
Dialogue: 0,0:12:06.25,0:12:09.21,Caption,,0,0,0,,ТРЕБОВАТЬ ЭФФЕКТИВНОСТИ ОТ ВОЕННЫХ ДЕЙСТВИЙ. АМЕРИКА
Dialogue: 0,0:12:09.21,0:12:12.01,Caption,,0,0,0,,МОЖЕТ ПОЛУЧАТЬ ПОЛИТИЧЕСКИЙ РЕЗУЛЬТАТ. И АМЕРИКА
Dialogue: 0,0:12:12.01,0:12:14.73,Caption,,0,0,0,,СОВЕРШЕННО НЕ ОБЯЗАНА ДЕЛАТЬ ВСЁ ЭТО РАДИ ТОГО,
Dialogue: 0,0:12:14.88,0:12:19.53,Caption,,0,0,0,,ЧТОБЫ КАЛЛАС БЫЛА ДОВОЛЬНА. А ЕВРОПА В ЭТОЙ СИСТЕМЕ ВЫГЛЯДИТ ВСЁ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:12:19.95,0:12:22.57,Caption,,0,0,0,,ОНА ТРЕБУЕТ ОТ МОСКВЫ УСТУПОК. ОНА СПОРИТ О
Dialogue: 0,0:12:22.57,0:12:25.45,Caption,,0,0,0,,СОСТАВЕ ПЕРЕГОВОРОВ. ОНА ОПЛАЧИВАЕТ АМЕРИКАНСКОЕ
Dialogue: 0,0:12:25.45,0:12:28.01,Caption,,0,0,0,,ОРУЖИЕ. ОНА БЕРЁТ НА СЕБЯ ЗНАЧИТЕЛЬНУЮ ЧАСТЬ
Dialogue: 0,0:12:28.01,0:12:30.73,Caption,,0,0,0,,РАСХОДОВ. И ОДНОВРЕМЕННО ВСЁ СИЛЬНЕЕ ЗАВИСИТ ОТ
Dialogue: 0,0:12:30.73,0:12:34.25,Caption,,0,0,0,,ТОГО, КАКОЕ РЕШЕНИЕ ПРИМУТ В ВАШИНГТОНЕ. ПРИЧЁМ ТЕПЕРЬ
Dialogue: 0,0:12:34.25,0:12:37.77,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО ДАЖЕ УСЛОВИЯ БУДУЩЕГО СОГЛАШЕНИЯ СПОСОБНЫ
Dialogue: 0,0:12:37.77,0:12:40.17,Caption,,0,0,0,,МЕНЯТЬСЯ В ЗАВИСИМОСТИ ОТ СОСТАВА АМЕРИКАНСКОГО
Dialogue: 0,0:12:40.17,0:12:42.49,Caption,,0,0,0,,КОНГРЕССА. И ВОТ ЭТО, ПОЖАЛУЙ,
Dialogue: 0,0:12:42.65,0:12:45.69,Caption,,0,0,0,,ГЛАВНЫЙ ВОПРОС ДЛЯ ЕВРОПЫ. НЕ ЧТО РОССИЯ ДОЛЖНА
Dialogue: 0,0:12:45.69,0:12:48.57,Caption,,0,0,0,,СДЕЛАТЬ. НЕ КОГО НАДО ПОСАДИТЬ ЗА СТОЛ. НЕ
Dialogue: 0,0:12:48.57,0:12:51.45,Caption,,0,0,0,,КАКУЮ ЕЩЁ ЖЁСТКУЮ ФРАЗУ ПРОИЗНЕСТИ В АДРЕС МОСКВЫ.
Dialogue: 0,0:12:51.85,0:12:53.93,Caption,,0,0,0,,А КТО ВООБЩЕ ОПРЕДЕЛЯЕТ ПРАВИЛА ЭТОЙ ИГРЫ?
Dialogue: 0,0:12:54.25,0:12:56.89,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ БЕЗОПАСНОСТЬ ЕВРОПЕЙСКОГО КОНТИНЕНТА
Dialogue: 0,0:12:56.89,0:13:00.25,Caption,,0,0,0,,ЗАВИСИТ ОТ ТОГО, КТО ПОЛУЧИЛ НЕСКОЛЬКО ДОПОЛНИТЕЛЬНЫХ КРЕСЕЛ В
Dialogue: 0,0:13:00.25,0:13:04.17,Caption,,0,0,0,,АМЕРИКАНСКОМ КОНГРЕССЕ, ТОГДА У ЕВРОПЫ ПРОБЛЕМА ЗНАЧИТЕЛЬНО БОЛЬШЕ,
Dialogue: 0,0:13:04.37,0:13:07.13,Caption,,0,0,0,,ЧЕМ ОЧЕРЕДНОЙ СПОР ВОКРУГ УКРАИНЫ. И РЕШАТЬ ЕЁ
Dialogue: 0,0:13:07.13,0:13:09.45,Caption,,0,0,0,,КОГДА НИБУДЬ ВСЁ РАВНО ПРИДЁТСЯ. ЖЕЛАТЕЛЬНО ЗА
Dialogue: 0,0:13:09.45,0:13:11.61,Caption,,0,0,0,,СТОЛОМ. И ЖЕЛАТЕЛЬНО ВСЁ ТАКИ СО ВСЕМИ,
Dialogue: 0,0:13:11.85,0:13:13.21,Caption,,0,0,0,,ОТ КОГО ЗАВИСИТ РЕЗУЛЬТАТ.
