Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,ЕСТЬ ОДНА УДИВИТЕЛЬНАЯ ОСОБЕННОСТЬ У ОЧЕНЬ СМЕЛЫХ
Dialogue: 0,0:00:02.60,0:00:05.24,Caption,,0,0,0,,ПОЛИТИКОВ. ЧЕМ МЕНЬШЕ СОБСТВЕННАЯ СТРАНА,
Dialogue: 0,0:00:05.48,0:00:08.60,Caption,,0,0,0,,ТЕМ ГРОМЧЕ ИНОГДА ЗВУЧАТ УГРОЗЫ. ПРИЧЁМ СТАВКИ ТАМ
Dialogue: 0,0:00:08.60,0:00:11.08,Caption,,0,0,0,,СОВСЕМ НЕ ШУТОЧНЫЕ. РЕЧЬ ВЕДЬ НЕ О ТОМ,
Dialogue: 0,0:00:11.19,0:00:13.32,Caption,,0,0,0,,ЧТО КОМУ ТО ПРИДЁТСЯ УЙТИ В ОТСТАВКУ ИЛИ
Dialogue: 0,0:00:13.32,0:00:16.12,Caption,,0,0,0,,ПРОИГРАТЬ ВЫБОРЫ. ТАМ В СЛУЧАЕ БОЛЬШОЙ ДРАКИ ОТ
Dialogue: 0,0:00:16.12,0:00:18.68,Caption,,0,0,0,,СТРАНЫ ВООБЩЕ МАЛО ЧТО ОСТАНЕТСЯ. И ЭТИ ЛЮДИ
Dialogue: 0,0:00:18.68,0:00:22.44,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЮТ, С ЧЕМ ИГРАЮТ. ТОГДА ПОЧЕМУ ОНИ ТАК УВЕРЕННО
Dialogue: 0,0:00:22.44,0:00:27.16,Caption,,0,0,0,,ПРОДОЛЖАЮТ? КТО ИМ ПООБЕЩАЛ, ЧТО РАСПЛАЧИВАТЬСЯ ЗА ЭТУ СМЕЛОСТЬ БУДУТ ДРУГИЕ?
Dialogue: 0,0:00:27.65,0:00:30.20,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНО СМОТРЕТЬ НЕ НА ОТДЕЛЬНЫЕ ГРОМКИЕ
Dialogue: 0,0:00:30.20,0:00:32.68,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, А НА ТО, КУДА ОНИ ВЕДУТ,
Dialogue: 0,0:00:32.92,0:00:35.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:35.48,0:00:38.20,Caption,,0,0,0,,КОГДА СОБЫТИЯ ЛУЧШЕ СКЛАДЫВАТЬ РЯДОМ. И НАЧИНАТЬ
Dialogue: 0,0:00:38.28,0:00:41.08,Caption,,0,0,0,,НАДО С ФРАНЦИИ. ПОТОМУ ЧТО ГЛАВА ФРАНЦУЗСКОГО МИДА
Dialogue: 0,0:00:41.08,0:00:44.28,Caption,,0,0,0,,ЖАН НОЭЛЬ БАРРО ОФИЦИАЛЬНО ПОДТВЕРДИЛ ПРИСУТСТВИЕ
Dialogue: 0,0:00:44.28,0:00:47.16,Caption,,0,0,0,,ФРАНЦУЗСКИХ ВОЕННЫХ СПЕЦИАЛИСТОВ НА УКРАИНЕ. ГЛАВА
Dialogue: 0,0:00:47.16,0:00:49.88,Caption,,0,0,0,,ВНЕШНЕПОЛИТИЧЕСКОГО ВЕДОМСТВА ФРАНЦИИ САМ ГОВОРИТ
Dialogue: 0,0:00:49.88,0:00:53.00,Caption,,0,0,0,,ДА, ФРАНЦУЗСКИЕ ИНСТРУКТОРЫ И ТЕХНИЧЕСКИЙ ПЕРСОНАЛ
Dialogue: 0,0:00:53.00,0:00:54.76,Caption,,0,0,0,,НАХОДЯТСЯ НА УКРАИНСКОЙ ТЕРРИТОРИИ,
Dialogue: 0,0:00:55.04,0:00:57.72,Caption,,0,0,0,,ОБУЧАЮТ УКРАИНСКИХ ВОЕННЫХ И ПОМОГАЮТ ОБСЛУЖИВАТЬ
Dialogue: 0,0:00:57.72,0:01:00.60,Caption,,0,0,0,,ТЕХНИКУ. ПРИ ЭТОМ ПАРИЖ ПРОДОЛЖАЕТ ОБЪЯСНЯТЬ,
Dialogue: 0,0:01:00.84,0:01:03.16,Caption,,0,0,0,,ЧТО ФРАНЦИЯ СТОРОНОЙ КОНФЛИКТА НЕ ЯВЛЯЕТСЯ.
Dialogue: 0,0:01:03.40,0:01:07.00,Caption,,0,0,0,,СПЕЦИАЛИСТОВ НЕМНОГО, РАБОТАЮТ ОНИ ДАЛЕКО ОТ ЛИНИИ ФРОНТА,
Dialogue: 0,0:01:07.24,0:01:09.72,Caption,,0,0,0,,НЕПОСРЕДСТВЕННОГО УЧАСТИЯ В БОЯХ НЕ ПРИНИМАЮТ.
Dialogue: 0,0:01:12.01,0:01:14.41,Caption,,0,0,0,,ТО ЕСТЬ ФРАНЦУЗСКИЙ ВОЕННЫЙ НАХОДИТСЯ НА ТЕРРИТОРИИ
Dialogue: 0,0:01:14.41,0:01:18.73,Caption,,0,0,0,,ВОЮЮЩЕЙ СТРАНЫ, ОБУЧАЕТ ЕЁ АРМИЮ И ПОМОГАЕТ ОБСЛУЖИВАТЬ ВОЕННУЮ
Dialogue: 0,0:01:18.73,0:01:23.13,Caption,,0,0,0,,ТЕХНИКУ, НО ФРАНЦИЯ В ВОЙНЕ НЕ УЧАСТВУЕТ. ХОРОШО. ЗАПОМНИМ
Dialogue: 0,0:01:23.13,0:01:26.01,Caption,,0,0,0,,ЭТУ ЕВРОПЕЙСКУЮ МАТЕМАТИКУ. И ЗДЕСЬ НЕ НАДО ДЕЛАТЬ
Dialogue: 0,0:01:26.01,0:01:29.21,Caption,,0,0,0,,КРУГЛЫЕ ГЛАЗА. САМО ПРИСУТСТВИЕ ФРАНЦУЗОВ НА УКРАИНЕ
Dialogue: 0,0:01:29.21,0:01:31.77,Caption,,0,0,0,,ДАВНО НЕ СЕКРЕТ ПОЛИШИНЕЛЯ. ИНФОРМАЦИЯ ОБ
Dialogue: 0,0:01:31.77,0:01:35.21,Caption,,0,0,0,,ИНСТРУКТОРАХ ХОДИЛА ДАВНО. ФРАНЦУЗСКОЕ РАДИО RFI
Dialogue: 0,0:01:35.21,0:01:38.65,Caption,,0,0,0,,СООБЩАЛО И О МИССИИ VOLIA, КОТОРАЯ ДЕЙСТВУЕТ С ЛЕТА,
Dialogue: 0,0:01:38.97,0:01:43.05,Caption,,0,0,0,,И О НЕБОЛЬШИХ ГРУППАХ, КОТОРЫЕ ОТПРАВЛЯЮТСЯ НА КОРОТКИЕ ЗАДАНИЯ. БОЛЕЕ
Dialogue: 0,0:01:43.05,0:01:47.13,Caption,,0,0,0,,ТОГО, СООБЩАЛОСЬ, ЧТО ФРАНЦУЗСКИЕ ДЕПУТАТЫ О РАЗВЁРТЫВАНИИ ЭТОЙ МИССИИ
Dialogue: 0,0:01:47.21,0:01:50.09,Caption,,0,0,0,,ВООБЩЕ НЕ БЫЛИ ПРОИНФОРМИРОВАНЫ. ТАМ ЖЕ ВСПЛЫВАЛА
Dialogue: 0,0:01:50.09,0:01:53.29,Caption,,0,0,0,,ЕЩЁ ОДНА ЗАНЯТНАЯ ДЕТАЛЬ. ОФИЦИАЛЬНАЯ ФРАНЦУЗСКАЯ
Dialogue: 0,0:01:53.37,0:01:56.17,Caption,,0,0,0,,МИССИЯ GERFAUT В ПОЛЬШЕ ИСПОЛЬЗОВАЛАСЬ КАК КАНАЛ ДЛЯ
Dialogue: 0,0:01:56.17,0:01:58.97,Caption,,0,0,0,,ПРИСУТСТВИЯ ФРАНЦУЗСКИХ ВОЕННЫХ НА УКРАИНЕ. ТО ЕСТЬ
Dialogue: 0,0:01:59.05,0:02:01.13,Caption,,0,0,0,,САМА СХЕМА СУЩЕСТВОВАЛА НЕ ПЕРВЫЙ ДЕНЬ.
Dialogue: 0,0:02:01.69,0:02:04.89,Caption,,0,0,0,,НОВОЕ ЗДЕСЬ ДРУГОЕ. РАНЬШЕ ВОКРУГ ТАКОГО ПРИСУТСТВИЯ
Dialogue: 0,0:02:04.89,0:02:07.85,Caption,,0,0,0,,ХОДИЛИ НА ЦЫПОЧКАХ. ТЕПЕРЬ ГЛАВА МИДА СПОКОЙНО
Dialogue: 0,0:02:07.85,0:02:10.41,Caption,,0,0,0,,ПОДТВЕРЖДАЕТ ЕГО ПУБЛИЧНО И ЕЩЁ ОБЪЯСНЯЕТ,
Dialogue: 0,0:02:10.65,0:02:16.01,Caption,,0,0,0,,ПОЧЕМУ ЭТО, ПО МНЕНИЮ ПАРИЖА, ВСЁ РАВНО НЕ ДЕЛАЕТ ФРАНЦИЮ УЧАСТНИКОМ ВОЙНЫ. СЕКРЕТ
Dialogue: 0,0:02:16.01,0:02:18.25,Caption,,0,0,0,,ПОЛИШИНЕЛЯ ПРОСТО ПЕРЕСТАЛ БЫТЬ СЕКРЕТОМ ПО
Dialogue: 0,0:02:18.25,0:02:21.05,Caption,,0,0,0,,ПРОТОКОЛУ. РАНЬШЕ ВСЕ ЗНАЛИ И ДЕЛАЛИ ВИД,
Dialogue: 0,0:02:21.23,0:02:27.58,Caption,,0,0,0,,ЧТО ВОПРОС СЛИШКОМ СКОЛЬЗКИЙ. ТЕПЕРЬ МИНИСТР САМ ПОДТВЕРЖДАЕТ ПРИСУТСТВИЕ,
Dialogue: 0,0:02:27.90,0:02:31.90,Caption,,0,0,0,,И СПОР ИДЁТ УЖЕ НЕ О ТОМ, ЕСТЬ ЛИ ТАМ ФРАНЦУЗСКИЕ ВОЕННЫЕ СПЕЦИАЛИСТЫ,
Dialogue: 0,0:02:32.22,0:02:34.62,Caption,,0,0,0,,А О ТОМ, КАК ИМЕННО НАЗВАТЬ ТО,
Dialogue: 0,0:02:34.74,0:02:38.46,Caption,,0,0,0,,ЧТО ОНИ ТАМ ДЕЛАЮТ. ВОТ ЭТО И ЕСТЬ ПРОДОЛЖЕНИЕ ПРОЦЕССА,
Dialogue: 0,0:02:38.70,0:02:43.10,Caption,,0,0,0,,КОТОРЫЙ ИДЁТ УЖЕ ДАВНО. ЕВРОПА НЕ НАЧАЛА ГОТОВИТЬСЯ К СТОЛКНОВЕНИЮ С РОССИЕЙ
Dialogue: 0,0:02:43.18,0:02:46.22,Caption,,0,0,0,,ПОСЛЕ ЗАЯВЛЕНИЯ БАРРО. ОНА ДАВНО РАСКРУЧИВАЕТ ЭТУ
Dialogue: 0,0:02:46.30,0:02:49.02,Caption,,0,0,0,,СПИРАЛЬ. УЧЕНИЯ, ПЕРЕБРОСКА СИЛ,
Dialogue: 0,0:02:49.26,0:02:53.10,Caption,,0,0,0,,РАЗГОВОРЫ О КОНТИНГЕНТАХ, УКРЕПЛЕНИЕ ВОСТОЧНОГО НАПРАВЛЕНИЯ,
Dialogue: 0,0:02:53.26,0:02:56.14,Caption,,0,0,0,,ЯДЕРНАЯ ТЕМА, ПОЛЬСКОЕ НАПРАВЛЕНИЕ,
Dialogue: 0,0:02:56.22,0:02:59.18,Caption,,0,0,0,,ФРАНЦУЗСКОЕ ПРИСУТСТВИЕ. ТЕПЕРЬ ПРОСТО ЕЩЁ ОДНА
Dialogue: 0,0:02:59.18,0:03:01.82,Caption,,0,0,0,,ВЕЩЬ, О КОТОРОЙ РАНЬШЕ СТАРАЛИСЬ ГОВОРИТЬ ТИШЕ,
Dialogue: 0,0:03:01.98,0:03:04.86,Caption,,0,0,0,,ПЕРЕШЛА В ОФИЦИАЛЬНЫЙ РАЗГОВОР. И ДАЛЬШЕ СТАНОВИТСЯ
Dialogue: 0,0:03:04.94,0:03:07.74,Caption,,0,0,0,,ЕЩЁ ВЕСЕЛЕЕ. ЭСТОНИЯ ГОТОВИТ ГОСУДАРСТВЕННЫЕ
Dialogue: 0,0:03:07.74,0:03:10.30,Caption,,0,0,0,,ЦИФРОВЫЕ СЕРВИСЫ К РАБОТЕ ИЗ ЗА РУБЕЖА. НЕ
Dialogue: 0,0:03:10.30,0:03:13.18,Caption,,0,0,0,,САЙТ ТУРИСТИЧЕСКОГО ВЕДОМСТВА И НЕ РЕЗЕРВНУЮ ПОЧТУ
Dialogue: 0,0:03:13.26,0:03:15.82,Caption,,0,0,0,,ДЛЯ ЧИНОВНИКОВ. РЕЕСТРЫ НАСЕЛЕНИЯ,
Dialogue: 0,0:03:15.94,0:03:19.42,Caption,,0,0,0,,ЗЕМЛИ, НЕДВИЖИМОСТИ И ДРУГИЕ КРИТИЧЕСКИЕ ГОСУДАРСТВЕННЫЕ
Dialogue: 0,0:03:19.42,0:03:23.18,Caption,,0,0,0,,БАЗЫ СОБИРАЮТСЯ ДЕРЖАТЬ ТАК, ЧТОБЫ ОНИ ПРОДОЛЖАЛИ РАБОТАТЬ,
Dialogue: 0,0:03:23.46,0:03:26.14,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ВНУТРЕННИЕ ЦЕНТРЫ ОБРАБОТКИ ДАННЫХ БУДУТ
Dialogue: 0,0:03:26.14,0:03:28.86,Caption,,0,0,0,,УНИЧТОЖЕНЫ ИЛИ ГОСУДАРСТВО ПОТЕРЯЕТ КОНТРОЛЬ НАД
Dialogue: 0,0:03:28.86,0:03:31.58,Caption,,0,0,0,,СВОЕЙ ТЕРРИТОРИЕЙ. ТО ЕСТЬ ТАЛЛИН УЖЕ ДУМАЕТ НЕ
Dialogue: 0,0:03:31.58,0:03:34.54,Caption,,0,0,0,,ТОЛЬКО О ТОМ, КАК ВОЕВАТЬ ИЛИ КАК ЗАЩИЩАТЬСЯ.
Dialogue: 0,0:03:36.80,0:03:39.69,Caption,,0,0,0,,ОН ДУМАЕТ, КАК ГОСУДАРСТВУ ПРОДОЛЖАТЬ СУЩЕСТВОВАТЬ,
Dialogue: 0,0:03:40.01,0:03:42.33,Caption,,0,0,0,,ЕСЛИ УПРАВЛЯТЬ СВОЕЙ ТЕРРИТОРИЕЙ НОРМАЛЬНО УЖЕ НЕ
Dialogue: 0,0:03:42.33,0:03:46.01,Caption,,0,0,0,,ПОЛУЧИТСЯ. ВОТ ТУТ КАК РАЗ И ЗАКАНЧИВАЮТСЯ КРАСИВЫЕ РЕЧИ
Dialogue: 0,0:03:46.09,0:03:49.21,Caption,,0,0,0,,О ХРАБРОСТИ И НАЧИНАЕТСЯ ОБЫЧНАЯ КАРТА. КСТАТИ,
Dialogue: 0,0:03:49.29,0:03:52.89,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ НУЖЕН ИМЕННО ТАКОЙ РАЗБОР. ПОТОМУ ЧТО
Dialogue: 0,0:03:52.97,0:03:55.53,Caption,,0,0,0,,ДАЛЬШЕ КАРТА НАЧИНАЕТ ЗАДАВАТЬ ПОЛИТИКАМ ОЧЕНЬ
Dialogue: 0,0:03:55.53,0:03:59.45,Caption,,0,0,0,,НЕПРИЯТНЫЕ ВОПРОСЫ. ЭСТОНИЯ МАЛЕНЬКАЯ. ЛИТВА
Dialogue: 0,0:03:59.52,0:04:03.93,Caption,,0,0,0,,МАЛЕНЬКАЯ. ЛАТВИЯ МАЛЕНЬКАЯ. ВСЕ ТРИ НАХОДЯТСЯ ТАМ,
Dialogue: 0,0:04:04.25,0:04:06.89,Caption,,0,0,0,,ГДЕ В СЛУЧАЕ ПРЯМОГО СТОЛКНОВЕНИЯ РОССИИ И НАТО
Dialogue: 0,0:04:07.13,0:04:09.85,Caption,,0,0,0,,НИКТО НЕ ДАСТ ИМ РОСКОШИ НАБЛЮДАТЬ ЗА ПРОИСХОДЯЩИМ
Dialogue: 0,0:04:09.93,0:04:13.21,Caption,,0,0,0,,ПО ТЕЛЕВИЗОРУ ИЗДАЛЕКА. ОНИ ОКАЖУТСЯ ПРЯМО НА ЛИНИИ
Dialogue: 0,0:04:13.21,0:04:16.17,Caption,,0,0,0,,ЭТОГО СТОЛКНОВЕНИЯ. И РУКОВОДИТЕЛИ ЭТИХ СТРАН ЭТО
Dialogue: 0,0:04:16.17,0:04:18.17,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЮТ. БОЛЕЕ ТОГО,
Dialogue: 0,0:04:18.41,0:04:20.81,Caption,,0,0,0,,ЭСТОНИЯ УЖЕ ГОТОВИТ ГОСУДАРСТВО К СЦЕНАРИЮ,
Dialogue: 0,0:04:21.05,0:04:23.45,Caption,,0,0,0,,ПРИ КОТОРОМ ЧАСТЬ УПРАВЛЕНИЯ ПРИДЁТСЯ ВЫНЕСТИ ЗА
Dialogue: 0,0:04:23.45,0:04:28.17,Caption,,0,0,0,,ГРАНИЦУ. ЗНАЧИТ, ЦЕНУ ОНИ ПОНИМАЮТ ОТЛИЧНО. И ОДНОВРЕМЕННО ПРОДОЛЖАЮТ
Dialogue: 0,0:04:28.17,0:04:32.09,Caption,,0,0,0,,ГОВОРИТЬ И ДЕЙСТВОВАТЬ ТАК, БУДТО ЗАПАСНЫХ СТРАН У НИХ ЛЕЖИТ ЕЩЁ ШТУКИ
Dialogue: 0,0:04:32.09,0:04:34.09,Caption,,0,0,0,,ПО ТРИ В КЛАДОВКЕ. ВОТ ТУТ У МЕНЯ
Dialogue: 0,0:04:34.17,0:04:38.01,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС. ОНИ ЧТО, РЕШИЛИ СЫГРАТЬ В САМОУБИЙЦУ ОБ РОССИЮ?
Dialogue: 0,0:04:38.56,0:04:40.65,Caption,,0,0,0,,ПОТОМУ ЧТО ПРИ БОЛЬШОЙ ВОЙНЕ РЕЧЬ ДЛЯ ЭТИХ
Dialogue: 0,0:04:40.65,0:04:42.73,Caption,,0,0,0,,СТРАН ПОЙДЁТ НЕ О ПАДЕНИИ ВВП НА ДВА
Dialogue: 0,0:04:42.81,0:04:45.37,Caption,,0,0,0,,ПРОЦЕНТА, НЕ О ДОСРОЧНЫХ ВЫБОРАХ И ДАЖЕ НЕ О
Dialogue: 0,0:04:45.37,0:04:51.73,Caption,,0,0,0,,РАЗБИТОЙ ЭЛЕКТРОСТАНЦИИ. В ХУДШЕМ СЦЕНАРИИ ВОПРОС БУДЕТ ЗВУЧАТЬ НАМНОГО ПРОЩЕ
Dialogue: 0,0:04:51.73,0:04:54.53,Caption,,0,0,0,,ОСТАНЕТСЯ ЛИ ЭТА СТРАНА ВООБЩЕ СУЩЕСТВОВАТЬ И НЕ
Dialogue: 0,0:04:54.53,0:04:57.49,Caption,,0,0,0,,ОСТАНЕТСЯ ЛИ НА ЕЁ МЕСТЕ БОЛЬШАЯ ДЫРКА. ЭТО
Dialogue: 0,0:04:57.57,0:05:01.97,Caption,,0,0,0,,И ЕСТЬ ТОТ УРОВЕНЬ СТАВОК, С КОТОРЫМ ОНИ ИГРАЮТ. ПРИЧЁМ СОБСТВЕННЫЕ ВОЗМОЖНОСТИ
Dialogue: 0,0:05:01.97,0:05:04.13,Caption,,0,0,0,,ЭТИХ СТРАН С МАСШТАБОМ ТАКОЙ ИГРЫ ВООБЩЕ НЕ
Dialogue: 0,0:05:04.13,0:05:07.25,Caption,,0,0,0,,СОПОСТАВИМЫ. ПОЭТОМУ ВСЯ ЭТА СМЕЛОСТЬ ДЕРЖИТСЯ НЕ НА
Dialogue: 0,0:05:07.25,0:05:09.89,Caption,,0,0,0,,СОБСТВЕННОЙ СИЛЕ. ОНА ДЕРЖИТСЯ НА УВЕРЕННОСТИ,
Dialogue: 0,0:05:10.21,0:05:14.69,Caption,,0,0,0,,ЧТО ЕСЛИ ДЕЛО ДОЙДЁТ ДО КРАЯ, ЗА НИХ В ДРАКУ ВОЙДУТ ОСТАЛЬНЫЕ. НО ПЯТАЯ
Dialogue: 0,0:05:14.69,0:05:17.65,Caption,,0,0,0,,СТАТЬЯ НАТО НЕ УМЕЕТ ПЕРЕДВИГАТЬ СТРАНЫ ПО КАРТЕ.
Dialogue: 0,0:05:18.06,0:05:20.13,Caption,,0,0,0,,ТАЛЛИН НЕ УЕДЕТ ПОДАЛЬШЕ ОТ РОССИИ,
Dialogue: 0,0:05:20.37,0:05:22.37,Caption,,0,0,0,,ВИЛЬНЮС НЕ СПРЯЧЕТСЯ ЗА ГЕРМАНИЕЙ,
Dialogue: 0,0:05:22.53,0:05:25.33,Caption,,0,0,0,,РИГА НЕ ПЕРЕЕДЕТ К АТЛАНТИКЕ. В СЛУЧАЕ БОЛЬШОЙ
Dialogue: 0,0:05:25.33,0:05:27.73,Caption,,0,0,0,,ДРАКИ ГЕОГРАФИЮ НИКАКИМ РЕШЕНИЕМ САММИТА НЕ
Dialogue: 0,0:05:27.81,0:05:31.01,Caption,,0,0,0,,ОТМЕНИШЬ. НО ТОГДА ИСТОРИЯ С ЭСТОНИЕЙ СТАНОВИТСЯ ЕЩЁ
Dialogue: 0,0:05:31.01,0:05:33.73,Caption,,0,0,0,,ЗАНЯТНЕЕ. ЧЕТЫРНАДЦАТОГО НОЯБРЯ БЫЛА ПРЕДПРИНЯТА
Dialogue: 0,0:05:33.73,0:05:36.29,Caption,,0,0,0,,ПОПЫТКА УСТРОИТЬ ВЗРЫВ И ПОДЖОГ НА ПРЕДПРИЯТИИ
Dialogue: 0,0:05:36.37,0:05:40.29,Caption,,0,0,0,,THREOD SYSTEMS, КОТОРОЕ ПРОИЗВОДИТ БЕСПИЛОТНИКИ. ПОДОЗРЕВАЕМЫХ
Dialogue: 0,0:05:40.29,0:05:43.41,Caption,,0,0,0,,ЗАДЕРЖАЛИ. ЭСТОНСКАЯ СЛУЖБА БЕЗОПАСНОСТИ СВЯЗАЛА
Dialogue: 0,0:05:43.41,0:05:46.29,Caption,,0,0,0,,НАПАДЕНИЕ С РОССИЙСКИМИ СПЕЦСЛУЖБАМИ И ПРЕДУПРЕДИЛА,
Dialogue: 0,0:05:46.61,0:05:49.25,Caption,,0,0,0,,ЧТО ИНТЕРЕС К ОБОРОННЫМ ПРЕДПРИЯТИЯМ СТРАНЫ НЕ
Dialogue: 0,0:05:49.25,0:05:51.97,Caption,,0,0,0,,ОГРАНИЧИВАЕТСЯ ОДНОЙ КОМПАНИЕЙ. КОНТРРАЗВЕДКА
Dialogue: 0,0:05:51.97,0:05:54.61,Caption,,0,0,0,,ГОВОРИТ ПРИМЕРНО О ДЕСЯТИ ПРЕДПРИЯТИЯХ ОБОРОННОЙ
Dialogue: 0,0:05:54.61,0:05:58.29,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ, КОТОРЫЕ СПОСОБНЫ ПРЕДСТАВЛЯТЬ ИНТЕРЕС ДЛЯ РОССИЙСКИХ
Dialogue: 0,0:05:58.37,0:06:03.86,Caption,,0,0,0,,СЛУЖБ. ТО ЕСТЬ ВЛАСТИ САМИ ОПИСЫВАЮТ УГРОЗУ КАК СЕТЬ,
Dialogue: 0,0:06:04.10,0:06:06.74,Caption,,0,0,0,,КОТОРАЯ НЕ ЗАКАНЧИВАЕТСЯ ОДНИМ ЗАБОРОМ И ОДНИМ
Dialogue: 0,0:06:06.74,0:06:09.78,Caption,,0,0,0,,ПОГРАНИЧНЫМ ПУНКТОМ. ПОСЛЕ ЭТОГО ПРЕМЬЕР МИНИСТР
Dialogue: 0,0:06:09.78,0:06:12.58,Caption,,0,0,0,,КРИСТЕН МИХАЛ ПОРУЧИЛ ГОТОВИТЬ ЗАКРЫТИЕ СУХОПУТНЫХ
Dialogue: 0,0:06:12.58,0:06:15.86,Caption,,0,0,0,,ПЕРЕХОДОВ С РОССИЕЙ. ЛОГИКА ПОНЯТНА ЕСТЬ УГРОЗА,
Dialogue: 0,0:06:16.02,0:06:18.90,Caption,,0,0,0,,ЗНАЧИТ НАДО ПЕРЕКРЫВАТЬ ГРАНИЦУ. ТОЛЬКО ПРЕЗИДЕНТ
Dialogue: 0,0:06:18.90,0:06:21.70,Caption,,0,0,0,,ЭСТОНИИ ЮЛЛЕ МАДИЗЕ ВЗЯЛА И ИСПОРТИЛА КРАСИВУЮ
Dialogue: 0,0:06:21.70,0:06:26.82,Caption,,0,0,0,,КАРТИНКУ. ОНА ПРЯМО СКАЗАЛА, ЧТО ЗАКРЫТАЯ ГРАНИЦА НЕ ПРЕДОТВРАТИЛА БЫ НАПАДЕНИЯ
Dialogue: 0,0:06:26.90,0:06:29.62,Caption,,0,0,0,,НА THREOD SYSTEMS И ДРУГИЕ ОБОРОННЫЕ ПРЕДПРИЯТИЯ.
Dialogue: 0,0:06:30.10,0:06:32.66,Caption,,0,0,0,,ВОТ И ПОЛУЧАЕТСЯ ЛЮБОПЫТНАЯ ВЕЩЬ. ГРАНИЦА
Dialogue: 0,0:06:32.66,0:06:34.58,Caption,,0,0,0,,ЗАКРЫВАЕТСЯ КАК ОТВЕТ НА УГРОЗУ,
Dialogue: 0,0:06:34.90,0:06:36.66,Caption,,0,0,0,,НО ГЛАВА ГОСУДАРСТВА САМА ГОВОРИТ,
Dialogue: 0,0:06:36.87,0:06:39.78,Caption,,0,0,0,,ЧТО КОНКРЕТНОЕ НАПАДЕНИЕ ТАКАЯ МЕРА НЕ ОСТАНОВИЛА
Dialogue: 0,0:06:39.78,0:06:42.66,Caption,,0,0,0,,БЫ. ЗАТО ОСТАНОВИТ ОБЫЧНЫЕ ПОЕЗДКИ ЛЮДЕЙ,
Dialogue: 0,0:06:42.82,0:06:44.82,Caption,,0,0,0,,У КОТОРЫХ ПО ДРУГУЮ СТОРОНУ ДЕТИ,
Dialogue: 0,0:06:44.90,0:06:47.94,Caption,,0,0,0,,РОДИТЕЛИ И РОДСТВЕННИКИ. ТО ЕСТЬ ПОЛИТИЧЕСКИЙ ЖЕСТ
Dialogue: 0,0:06:47.94,0:06:50.90,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ ЗАМЕТНЫЙ. А СВЯЗЬ ЭТОГО ЖЕСТА С
Dialogue: 0,0:06:50.90,0:06:53.78,Caption,,0,0,0,,САМИМ МЕХАНИЗМОМ УГРОЗЫ УЖЕ КУДА МЕНЕЕ ОЧЕВИДНАЯ.
Dialogue: 0,0:06:53.93,0:06:57.06,Caption,,0,0,0,,ЛИТВА СМОТРИТ ТУДА ЖЕ. ПРЕЗИДЕНТ ГИТАНАС НАУСЕДА
Dialogue: 0,0:06:57.14,0:06:59.46,Caption,,0,0,0,,ДОПУСТИЛ ЗАКРЫТИЕ ГРАНИЦЫ С РОССИЕЙ ВСЛЕД ЗА
Dialogue: 0,0:06:59.54,0:07:02.42,Caption,,0,0,0,,ЭСТОНИЕЙ. НО ТУТ В КАБИНЕТ СНОВА ЗАШЛА ГЕОГРАФИЯ
Dialogue: 0,0:07:02.42,0:07:05.46,Caption,,0,0,0,,И СЕЛА ПРЯМО НА СТОЛ. ЛИТВА ЯВЛЯЕТСЯ ТРАНЗИТНОЙ
Dialogue: 0,0:07:05.54,0:07:07.86,Caption,,0,0,0,,СТРАНОЙ ДЛЯ КАЛИНИНГРАДСКОЙ ОБЛАСТИ. ПОЭТОМУ
Dialogue: 0,0:07:07.86,0:07:10.82,Caption,,0,0,0,,КРАСИВОЕ РЕШЕНИЕ В СТИЛЕ ЗАКРЫЛИ И ЗАБЫЛИ СРАЗУ
Dialogue: 0,0:07:10.82,0:07:13.62,Caption,,0,0,0,,УПИРАЕТСЯ В ВОПРОС, ЧТО ДЕЛАТЬ С ТРАНЗИТОМ.
Dialogue: 0,0:07:15.89,0:07:19.10,Caption,,0,0,0,,ТУТ УЖЕ ОДНОЙ ГРОМКОЙ ФРАЗОЙ НЕ ОТДЕЛАЕШЬСЯ. ГРАНИЦА
Dialogue: 0,0:07:19.18,0:07:23.02,Caption,,0,0,0,,ЭТО НЕ ЗАНАВЕСКА, КОТОРУЮ ДЁРНУЛ И ВСЁ ИСЧЕЗЛО. ЗА НЕЙ ОСТАЁТСЯ
Dialogue: 0,0:07:23.02,0:07:25.58,Caption,,0,0,0,,КАЛИНИНГРАД, ОСТАЮТСЯ ДОГОВОРЁННОСТИ,
Dialogue: 0,0:07:25.81,0:07:30.14,Caption,,0,0,0,,ОСТАЮТСЯ МАРШРУТЫ, И КАЖДОЕ ТАКОЕ РЕШЕНИЕ СРАЗУ СТАНОВИТСЯ ЧАСТЬЮ
Dialogue: 0,0:07:30.14,0:07:32.78,Caption,,0,0,0,,БОЛЬШОГО ПРОТИВОСТОЯНИЯ. А КАЛИНИНГРАД В ЭТОЙ
Dialogue: 0,0:07:32.86,0:07:35.50,Caption,,0,0,0,,ИСТОРИИ ВООБЩЕ СТАНОВИТСЯ ОТДЕЛЬНЫМ НЕРВОМ. ПОЛЬША
Dialogue: 0,0:07:35.50,0:07:37.74,Caption,,0,0,0,,НЕДАВНО УСИЛИВАЛА МЕРЫ НА ЭТОМ НАПРАВЛЕНИИ,
Dialogue: 0,0:07:38.07,0:07:40.94,Caption,,0,0,0,,А ТЕПЕРЬ ПОЛЬСКАЯ RZECZPOSPOLITA СООБЩИЛА О ЯКОБЫ
Dialogue: 0,0:07:40.94,0:07:43.82,Caption,,0,0,0,,ПОДГОТОВЛЕННОЙ РОССИЙСКОЙ ОПЕРАЦИИ ПОД ЧУЖИМ ФЛАГОМ.
Dialogue: 0,0:07:44.46,0:07:49.02,Caption,,0,0,0,,ПО ИЗЛОЖЕННОЙ ГАЗЕТОЙ ВЕРСИИ, ЛЮДИ ДОЛЖНЫ БЫЛИ ИЗОБРАЖАТЬ УКРАИНСКИХ ДИВЕРСАНТОВ,
Dialogue: 0,0:07:49.26,0:07:51.74,Caption,,0,0,0,,ПЕРЕЙТИ ГРАНИЦУ И СОЗДАТЬ ПОВОД ДЛЯ БОЛЬШОЙ
Dialogue: 0,0:07:51.74,0:07:54.86,Caption,,0,0,0,,ПОЛИТИЧЕСКОЙ ЭСКАЛАЦИИ. ИСТОЧНИКИ ИЗДАНИЯ ГОВОРИЛИ
Dialogue: 0,0:07:54.86,0:07:57.10,Caption,,0,0,0,,ДАЖЕ О РАСЧЁТЕ НА БОЛЬШОЕ ЧИСЛО ЖЕРТВ И
Dialogue: 0,0:07:57.10,0:07:59.58,Caption,,0,0,0,,О ЦЕЛИ УДАРИТЬ ПО ПОЛЬСКОЙ ПОДДЕРЖКЕ УКРАИНЫ.
Dialogue: 0,0:08:00.05,0:08:02.78,Caption,,0,0,0,,ПОЛЬСКИЕ СЛУЖБЫ ЗАЯВЛЯЮТ, ЧТО ОПЕРАЦИЮ СОРВАЛИ.
Dialogue: 0,0:08:03.41,0:08:07.18,Caption,,0,0,0,,И ВОТ ТУТ ЕСТЬ ДЕТАЛЬ, КОТОРУЮ Я БЫ НЕ ПРЯТАЛ ПОД КОВЁР. РАССКАЗ
Dialogue: 0,0:08:07.26,0:08:10.30,Caption,,0,0,0,,О ЗАМЫСЛЕ ОЧЕНЬ ПОДРОБНЫЙ. ЕСТЬ ПРЕДПОЛАГАЕМАЯ ЦЕЛЬ,
Dialogue: 0,0:08:10.45,0:08:14.30,Caption,,0,0,0,,ЕСТЬ НАПРАВЛЕНИЕ, ЕСТЬ РОЛЬ ЛИПОВЫХ УКРАИНСКИХ ДИВЕРСАНТОВ,
Dialogue: 0,0:08:14.54,0:08:18.94,Caption,,0,0,0,,ЕСТЬ ПОЛИТИЧЕСКИЙ РЕЗУЛЬТАТ, КОТОРОГО ЯКОБЫ ХОТЕЛИ ДОБИТЬСЯ. А ВОТ КАК ИМЕННО
Dialogue: 0,0:08:18.94,0:08:22.70,Caption,,0,0,0,,ВСЁ ЭТО СОРВАЛИ, КОГО ОСТАНОВИЛИ И ГДЕ САМИ ИСПОЛНИТЕЛИ,
Dialogue: 0,0:08:23.03,0:08:25.66,Caption,,0,0,0,,В ПУБЛИЧНОМ РАССКАЗЕ УЖЕ ГОРАЗДО МЕНЬШЕ КОНКРЕТИКИ.
Dialogue: 0,0:08:27.86,0:08:31.86,Caption,,0,0,0,,ЭТО НЕ ОТМЕНЯЕТ ТОГО, ЧТО ПОЛЬША ДЕЙСТВИТЕЛЬНО УСИЛИВАЕТ КАЛИНИНГРАДСКОЕ
Dialogue: 0,0:08:31.86,0:08:34.34,Caption,,0,0,0,,НАПРАВЛЕНИЕ. НО ЗДЕСЬ ВАЖНО НЕ РАЗРЫВАТЬ
Dialogue: 0,0:08:34.34,0:08:37.62,Caption,,0,0,0,,ПРОИСХОДЯЩЕЕ НА ДЕСЯТЬ ОТДЕЛЬНЫХ НОВОСТЕЙ. ПОЛЬША
Dialogue: 0,0:08:37.62,0:08:42.82,Caption,,0,0,0,,ОДНА, АРМИЯ ОДНА, ПРОСТО НАПРАВЛЕНИЯ РАЗНЫЕ. НА ОДНОМ НАПРАВЛЕНИИ ИДЁТ
Dialogue: 0,0:08:42.90,0:08:45.94,Caption,,0,0,0,,ПОДДЕРЖКА УКРАИНЫ. НА ДРУГОМ УСИЛИВАЕТСЯ ГРАНИЦА С
Dialogue: 0,0:08:45.94,0:08:48.90,Caption,,0,0,0,,КАЛИНИНГРАДОМ. РЯДОМ ПРИБАЛТЫ ОБСУЖДАЮТ ЗАКРЫТИЕ
Dialogue: 0,0:08:48.90,0:08:51.86,Caption,,0,0,0,,ПЕРЕХОДОВ. ФРАНЦУЗЫ УЖЕ ОФИЦИАЛЬНО ПРИЗНАЮТ СВОИХ
Dialogue: 0,0:08:51.94,0:08:54.74,Caption,,0,0,0,,ВОЕННЫХ СПЕЦИАЛИСТОВ НА УКРАИНЕ. ВСЁ ЭТО НЕ СТАРТ
Dialogue: 0,0:08:54.74,0:08:57.86,Caption,,0,0,0,,НОВОГО ПРОЦЕССА. ЭТО НОВЫЕ ОБОРОТЫ ТОЙ ЖЕ СПИРАЛИ.
Dialogue: 0,0:08:58.18,0:09:00.66,Caption,,0,0,0,,И НА ЭТОМ ФОНЕ ОСОБЕННО КРАСИВО ЗВУЧАТ ДЕНЬГИ.
Dialogue: 0,0:09:01.06,0:09:05.22,Caption,,0,0,0,,МАРК РЮТТЕ ПРИЗНАЛ, ЧТО ДО СОГЛАСОВАННОГО ОБЪЁМА ВОЕННОЙ ПОМОЩИ УКРАИНЕ
Dialogue: 0,0:09:05.22,0:09:08.18,Caption,,0,0,0,,В СЕМЬДЕСЯТ МИЛЛИАРДОВ ДОЛЛАРОВ СОЮЗНИКАМ ВСЁ ЕЩЁ НЕ
Dialogue: 0,0:09:08.18,0:09:11.22,Caption,,0,0,0,,ХВАТАЕТ НЕСКОЛЬКИХ МИЛЛИАРДОВ. ПО ПРОГРАММЕ ЗАКУПКИ
Dialogue: 0,0:09:11.22,0:09:13.94,Caption,,0,0,0,,АМЕРИКАНСКОГО ВООРУЖЕНИЯ ЗА ЕВРОПЕЙСКИЕ И КАНАДСКИЕ
Dialogue: 0,0:09:13.94,0:09:16.82,Caption,,0,0,0,,ДЕНЬГИ ОБЪЁМ ОКАЗАЛСЯ ОКОЛО ДЕСЯТИ МИЛЛИАРДОВ.
Dialogue: 0,0:09:17.14,0:09:19.86,Caption,,0,0,0,,РАНЬШЕ НАЗЫВАЛИ ОРИЕНТИР ОТ ДВЕНАДЦАТИ ДО ПЯТНАДЦАТИ
Dialogue: 0,0:09:19.86,0:09:22.50,Caption,,0,0,0,,МИЛЛИАРДОВ, НО САМ РЮТТЕ ТЕПЕРЬ ОБЪЯСНЯЕТ,
Dialogue: 0,0:09:22.81,0:09:24.50,Caption,,0,0,0,,ЧТО ЭТО БЫЛ РАСЧЁТНЫЙ ОРИЕНТИР,
Dialogue: 0,0:09:24.74,0:09:27.22,Caption,,0,0,0,,А НА ПРАКТИКЕ ПОТРЕБНОСТЬ ОКАЗАЛАСЬ НИЖЕ. С
Dialogue: 0,0:09:27.22,0:09:30.34,Caption,,0,0,0,,СЕМЬЮДЕСЯТЬЮ МИЛЛИАРДАМИ ИСТОРИЯ ДРУГАЯ. ЭТО УЖЕ
Dialogue: 0,0:09:30.34,0:09:33.62,Caption,,0,0,0,,СОГЛАСОВАННАЯ ЦЕЛЬ, И ДО НЕЁ, ПО СЛОВАМ РЮТТЕ,
Dialogue: 0,0:09:33.78,0:09:36.74,Caption,,0,0,0,,ВСЁ ЕЩЁ НЕ ХВАТАЕТ НЕСКОЛЬКИХ МИЛЛИАРДОВ. ТО ЕСТЬ
Dialogue: 0,0:09:36.74,0:09:39.06,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ РЕШИМОСТЬ ИДЁТ ВПЕРЕДИ КАССЫ.
Dialogue: 0,0:09:41.34,0:09:44.22,Caption,,0,0,0,,ВОЕННЫХ ИНСТРУКТОРОВ ОТПРАВЛЯТЬ ГОТОВЫ. ГРАНИЦЫ
Dialogue: 0,0:09:44.22,0:09:47.34,Caption,,0,0,0,,ЗАКРЫВАТЬ ГОТОВЫ. ГОСУДАРСТВЕННЫЕ СЕРВИСЫ ВЫНОСИТЬ
Dialogue: 0,0:09:47.42,0:09:50.14,Caption,,0,0,0,,ЗА РУБЕЖ НА СЛУЧАЙ САМОГО ПЛОХОГО СЦЕНАРИЯ ГОТОВЫ.
Dialogue: 0,0:09:50.54,0:09:53.18,Caption,,0,0,0,,А КОГДА НАЧИНАЕТСЯ РАЗГОВОР О ПОЛНОМ ФИНАНСИРОВАНИИ
Dialogue: 0,0:09:53.18,0:09:57.66,Caption,,0,0,0,,УЖЕ СОГЛАСОВАННЫХ ПОСТАВОК, ТАМ ЕЩЁ НАДО ДОБРАТЬ НЕСКОЛЬКО МИЛЛИАРДОВ. И ЭТО
Dialogue: 0,0:09:57.66,0:09:59.98,Caption,,0,0,0,,ХОРОШО ПОКАЗЫВАЕТ ВСЮ СТРАННОСТЬ НЫНЕШНЕЙ
Dialogue: 0,0:10:00.06,0:10:02.70,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ ЛИНИИ. ПОДГОТОВКА К ПРОТИВОСТОЯНИЮ
Dialogue: 0,0:10:02.70,0:10:04.46,Caption,,0,0,0,,СТАНОВИТСЯ ВСЁ БОЛЕЕ КОНКРЕТНОЙ,
Dialogue: 0,0:10:04.73,0:10:08.06,Caption,,0,0,0,,А ЦЕНА ЭТОЙ ПОДГОТОВКИ ВСЁ МЕНЕЕ АБСТРАКТНОЙ. ОДНИ
Dialogue: 0,0:10:08.14,0:10:10.46,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА УЖЕ ГОТОВЯТ УПРАВЛЕНИЕ СТРАНОЙ ИЗ ЗА
Dialogue: 0,0:10:10.46,0:10:13.58,Caption,,0,0,0,,РУБЕЖА. ДРУГИЕ СПОКОЙНО ПРИЗНАЮТ СВОИХ ВОЕННЫХ НА
Dialogue: 0,0:10:13.58,0:10:16.86,Caption,,0,0,0,,УКРАИНСКОЙ ТЕРРИТОРИИ. ТРЕТЬИ ОБСУЖДАЮТ МЕРЫ ВОКРУГ
Dialogue: 0,0:10:16.86,0:10:20.46,Caption,,0,0,0,,КАЛИНИНГРАДА. И ПРИ ЭТОМ САМЫЕ МАЛЕНЬКИЕ И УЯЗВИМЫЕ
Dialogue: 0,0:10:20.46,0:10:23.26,Caption,,0,0,0,,УЧАСТНИКИ ЭТОЙ ИСТОРИИ ПРОДОЛЖАЮТ ВЕСТИ СЕБЯ ТАК,
Dialogue: 0,0:10:23.50,0:10:26.22,Caption,,0,0,0,,БУДТО ИМЕННО ИМ ДОСТАЛСЯ БЕЗЛИМИТНЫЙ ЗАПАС
Dialogue: 0,0:10:26.22,0:10:30.06,Caption,,0,0,0,,ПРОЧНОСТИ. БОЛЬШАЯ ВОЙНА В ЕВРОПЕ НЕ НАЧИНАЕТСЯ С ОДНОГО
Dialogue: 0,0:10:30.06,0:10:34.06,Caption,,0,0,0,,ЗАЯВЛЕНИЯ БАРРО, ОДНОГО ЗАКРЫТОГО ПЕРЕХОДА ИЛИ ОДНОГО ПОДЖОГА НА
Dialogue: 0,0:10:34.14,0:10:37.42,Caption,,0,0,0,,ЗАВОДЕ БЕСПИЛОТНИКОВ. ИМЕННО ПОЭТОМУ ОПАСНО СМОТРЕТЬ
Dialogue: 0,0:10:37.50,0:10:40.46,Caption,,0,0,0,,НА КАЖДЫЙ ЭПИЗОД ОТДЕЛЬНО. СПИРАЛЬ ЗАКРУЧИВАЕТСЯ
Dialogue: 0,0:10:40.46,0:10:43.98,Caption,,0,0,0,,ТОГДА, КОГДА ТО, ЧТО РАНЬШЕ ТРЕБОВАЛО ОТРИЦАНИЙ,
Dialogue: 0,0:10:44.16,0:10:45.98,Caption,,0,0,0,,СТАНОВИТСЯ ОФИЦИАЛЬНО ПРИЗНАННЫМ,
Dialogue: 0,0:10:46.32,0:10:49.10,Caption,,0,0,0,,А ТО, ЧТО РАНЬШЕ СЧИТАЛОСЬ КРАЙНИМ СЦЕНАРИЕМ,
Dialogue: 0,0:10:49.33,0:10:51.50,Caption,,0,0,0,,УЖЕ ЗАКЛАДЫВАЮТ В ГОСУДАРСТВЕННЫЕ ПЛАНЫ.
Dialogue: 0,0:10:53.78,0:10:56.26,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ВОПРОС К ПРИБАЛТИЙСКИМ РУКОВОДИТЕЛЯМ
Dialogue: 0,0:10:56.34,0:10:59.54,Caption,,0,0,0,,ОСТАЁТСЯ ОЧЕНЬ ПРОСТОЙ. ЕСЛИ ВЫ САМИ ГОТОВИТЕСЬ К
Dialogue: 0,0:10:59.54,0:11:02.50,Caption,,0,0,0,,СЦЕНАРИЮ, ПРИ КОТОРОМ ГОСУДАРСТВО ПРИДЁТСЯ СПАСАТЬ ЗА
Dialogue: 0,0:11:02.50,0:11:06.18,Caption,,0,0,0,,ГРАНИЦЕЙ, ЗНАЧИТ ВЫ ПРЕКРАСНО ПОНИМАЕТЕ ЦЕНУ БОЛЬШОЙ ДРАКИ.
Dialogue: 0,0:11:06.58,0:11:08.98,Caption,,0,0,0,,ТОГДА ЗАЧЕМ ПРОДОЛЖАТЬ ПОВЫШАТЬ СТАВКИ ТАК,
Dialogue: 0,0:11:09.22,0:11:11.70,Caption,,0,0,0,,БУДТО РАСПЛАЧИВАТЬСЯ ЗА НИХ БУДЕТ КТО ТО ДРУГОЙ?
Dialogue: 0,0:11:11.98,0:11:14.58,Caption,,0,0,0,,ПОТОМУ ЧТО В БОЛЬШОЙ ВОЙНЕ ГЕОГРАФИЯ НЕ СПОРИТ,
Dialogue: 0,0:11:14.95,0:11:17.30,Caption,,0,0,0,,НЕ ВЫСТУПАЕТ НА ПРЕСС КОНФЕРЕНЦИЯХ И НЕ ЧИТАЕТ
Dialogue: 0,0:11:17.30,0:11:20.02,Caption,,0,0,0,,КРАСИВЫЕ ЗАЯВЛЕНИЯ. ОНА ПРОСТО ПОКАЗЫВАЕТ,
Dialogue: 0,0:11:20.15,0:11:21.46,Caption,,0,0,0,,КТО СТОИТ БЛИЖЕ ВСЕХ.
