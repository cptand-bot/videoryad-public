Dialogue: 0,0:00:00.12,0:00:04.52,Caption,,0,0,0,,ПОСЛЕ МАДУРО ДЯДЯ СЭМ РЕШИЛ, ЧТО ЖИЗНЬ УДАЛАСЬ. РАЗ ПОЛУЧИЛОСЬ ОДИН РАЗ,
Dialogue: 0,0:00:04.76,0:00:07.32,Caption,,0,0,0,,СЕЙЧАС ПОПРЁТ ЕЩЁ БОЛЬШЕ. ДАЛЬШЕ ИРАН,
Dialogue: 0,0:00:07.40,0:00:09.72,Caption,,0,0,0,,БЫСТРАЯ ПОБЕДА, КРАСИВЫЙ ФИНАЛ,
Dialogue: 0,0:00:09.88,0:00:12.20,Caption,,0,0,0,,ДОВОЛЬНЫЕ ИЗБИРАТЕЛИ. НАВЕРНОЕ,
Dialogue: 0,0:00:12.28,0:00:14.52,Caption,,0,0,0,,ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ GROK ПРИМЕРНО ТАК И
Dialogue: 0,0:00:14.52,0:00:17.08,Caption,,0,0,0,,НАСЧИТАЛ. А ПОТОМ РЕАЛЬНОСТЬ ВЗЯЛА И ДАЛА ПО
Dialogue: 0,0:00:17.16,0:00:19.40,Caption,,0,0,0,,МОРДЕ. ДА ЕЩЕ И С ОТМАШКОЙ. И ТЕПЕРЬ
Dialogue: 0,0:00:19.40,0:00:23.40,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ НЕ В ТОМ, ЧТО РЕСПУБЛИКАНЦЫ ПРОИГРАЛИ ВЫБОРЫ. САМОЕ
Dialogue: 0,0:00:23.40,0:00:27.00,Caption,,0,0,0,,ИНТЕРЕСНОЕ, ЧТО ОНИ УЖЕ СОБРАЛИСЬ ДЕЛАТЬ ПОСЛЕ ЭТОГО. ЕСЛИ
Dialogue: 0,0:00:27.08,0:00:29.64,Caption,,0,0,0,,ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗБОР БЕЗ ПОЛИТИЧЕСКОЙ ВАТЫ,
Dialogue: 0,0:00:29.72,0:00:31.96,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:32.20,0:00:34.44,Caption,,0,0,0,,КОГДА САМА НОВОСТЬ ЗАКАНЧИВАЕТСЯ НА СЛОВАХ
Dialogue: 0,0:00:34.44,0:00:39.00,Caption,,0,0,0,,"ДЕМОКРАТЫ ВЗЯЛИ КОНГРЕСС", А НАСТОЯЩАЯ ИСТОРИЯ ТОЛЬКО НАЧИНАЕТСЯ. СНАЧАЛА
Dialogue: 0,0:00:39.08,0:00:42.04,Caption,,0,0,0,,УБЕРЁМ ЛИШНИЙ ПАФОС. ПАРТИЯ ПРЕЗИДЕНТА ПРОИГРЫВАЕТ
Dialogue: 0,0:00:42.04,0:00:43.88,Caption,,0,0,0,,ПРОМЕЖУТОЧНЫЕ ВЫБОРЫ. НУ И ЧТО?
Dialogue: 0,0:00:44.16,0:00:46.12,Caption,,0,0,0,,ДЛЯ АМЕРИКИ ЭТО ВООБЩЕ НЕ КАКОЕ ТО ЧУДО
Dialogue: 0,0:00:46.12,0:00:49.00,Caption,,0,0,0,,ПРИРОДЫ. ТАМ ЭТО ПРОИСХОДИТ РЕГУЛЯРНО. ВЫБИРАЮТ
Dialogue: 0,0:00:49.00,0:00:51.24,Caption,,0,0,0,,ПРЕЗИДЕНТА, ПРОХОДИТ ДВА ГОДА,
Dialogue: 0,0:00:51.41,0:00:53.40,Caption,,0,0,0,,НАРОД УСПЕВАЕТ РАЗОЧАРОВАТЬСЯ,
Dialogue: 0,0:00:53.48,0:00:56.36,Caption,,0,0,0,,РАЗОЗЛИТЬСЯ, ВСПОМНИТЬ ЦЕНЫ В МАГАЗИНЕ,
Dialogue: 0,0:00:56.44,0:01:01.72,Caption,,0,0,0,,БЕНЗИН, НАЛОГИ, ОБЕЩАНИЯ И НАЧИНАЕТ ВЫПИСЫВАТЬ СЧЁТ. ИНОГДА МЯГКО,
Dialogue: 0,0:01:02.04,0:01:05.08,Caption,,0,0,0,,ИНОГДА ТАК, ЧТО ПОТОМ ЕЩЁ ДОЛГО ПЕРЕСЧИТЫВАЮТ МЕБЕЛЬ В
Dialogue: 0,0:01:05.16,0:01:10.12,Caption,,0,0,0,,КАБИНЕТАХ. ТО ЕСТЬ САМ ФАКТ, ЧТО ДЕМОКРАТЫ ЗАБРАЛИ ПАЛАТУ ПРЕДСТАВИТЕЛЕЙ И СЕНАТ,
Dialogue: 0,0:01:10.36,0:01:13.80,Caption,,0,0,0,,ЕЩЁ НЕ ОЗНАЧАЕТ, ЧТО АМЕРИКА ВНЕЗАПНО ПРОСНУЛАСЬ ДРУГОЙ СТРАНОЙ.
Dialogue: 0,0:01:16.08,0:01:20.16,Caption,,0,0,0,,И ТЕМ БОЛЕЕ НЕ ОЗНАЧАЕТ, ЧТО ЧЕРЕЗ ДВА ГОДА ДЕМОКРАТИЧЕСКИЙ КАНДИДАТ УЖЕ
Dialogue: 0,0:01:20.24,0:01:21.92,Caption,,0,0,0,,МОЖЕТ ЗАКАЗЫВАТЬ ШТОРЫ В БЕЛЫЙ ДОМ.
Dialogue: 0,0:01:22.48,0:01:25.20,Caption,,0,0,0,,АМЕРИКАНСКАЯ ИСТОРИЯ ЛЮБИТ ТАКИЕ ЗАРАНЕЕ КУПЛЕННЫЕ
Dialogue: 0,0:01:25.20,0:01:29.76,Caption,,0,0,0,,ШТОРЫ. ПОТОМ ВЫЯСНЯЕТСЯ, ЧТО ЖИТЬ В КОМНАТЕ БУДЕТ СОВСЕМ ДРУГОЙ ЧЕЛОВЕК.
Dialogue: 0,0:01:30.12,0:01:33.28,Caption,,0,0,0,,НО ЕСТЬ ОДНА ПРОБЛЕМА. ОДНО ДЕЛО ПРОИГРАТЬ ТАМ,
Dialogue: 0,0:01:33.36,0:01:35.28,Caption,,0,0,0,,ГДЕ У ТЕБЯ И ТАК ВСЁ ШАТАЛОСЬ. И
Dialogue: 0,0:01:35.28,0:01:38.08,Caption,,0,0,0,,СОВСЕМ ДРУГОЕ ДЕЛО ОТДАТЬ ТЕХАС. ВОТ ЭТО УЖЕ
Dialogue: 0,0:01:38.08,0:01:41.20,Caption,,0,0,0,,НЕ ПРОСТО НЕПРИЯТНОСТЬ. ТЕХАС ДЛЯ РЕСПУБЛИКАНЦЕВ НЕ
Dialogue: 0,0:01:41.20,0:01:44.40,Caption,,0,0,0,,"ВАЖНЫЙ ШТАТ". ТЕХАС ЭТО БАСТИОН. НЕ ВЧЕРА
Dialogue: 0,0:01:44.40,0:01:46.96,Caption,,0,0,0,,ПОСТРОЕННЫЙ И НЕ НА ОДИН ИЗБИРАТЕЛЬНЫЙ ЦИКЛ.
Dialogue: 0,0:01:47.29,0:01:50.08,Caption,,0,0,0,,ДЕМОКРАТ ДЖЕЙМС ТАЛАРИКО ВЫИГРАЛ ТАМ ВЫБОРЫ В СЕНАТ.
Dialogue: 0,0:01:50.40,0:01:53.52,Caption,,0,0,0,,ДЕМОКРАТЫ ВЗЯЛИ ГУБЕРНАТОРСКУЮ ГОНКУ. ПОШЛИ ПОБЕДЫ И
Dialogue: 0,0:01:53.60,0:01:56.48,Caption,,0,0,0,,НИЖЕ, НА УРОВНЕ САМОГО ШТАТА. И ВСЁ ЭТО ПОСЛЕ
Dialogue: 0,0:01:56.48,0:01:59.76,Caption,,0,0,0,,ТОГО, КАК РЕСПУБЛИКАНЦЫ ЕЩЁ НЕДАВНО ПЕРЕКРАИВАЛИ КАРТУ
Dialogue: 0,0:01:59.84,0:02:02.72,Caption,,0,0,0,,ОКРУГОВ В РАСЧЁТЕ НА ДОПОЛНИТЕЛЬНЫЕ МЕСТА. КРАСИВО
Dialogue: 0,0:02:02.72,0:02:05.12,Caption,,0,0,0,,ПОЛУЧИЛОСЬ. РИСОВАЛИ КАРТУ ПОД СЕБЯ,
Dialogue: 0,0:02:05.36,0:02:07.44,Caption,,0,0,0,,А В ИТОГЕ КАРТА ВЗЯЛА И НАРИСОВАЛА ИХ.
Dialogue: 0,0:02:07.84,0:02:10.32,Caption,,0,0,0,,ПОТОМУ ЧТО КОГДА ПАРТИЯ ПРЕЗИДЕНТА ТЕРЯЕТ НЕ ПРОСТО
Dialogue: 0,0:02:10.40,0:02:13.12,Caption,,0,0,0,,СПОРНЫЕ ТЕРРИТОРИИ, А СОБСТВЕННЫЙ БАСТИОН,
Dialogue: 0,0:02:13.36,0:02:15.60,Caption,,0,0,0,,СПИСАТЬ ВСЁ НА ОБЫЧНУЮ АМЕРИКАНСКУЮ КАЧЕЛЬ
Dialogue: 0,0:02:15.60,0:02:18.88,Caption,,0,0,0,,СТАНОВИТСЯ СЛОЖНЕЕ. И ТУТ ТРАМП С ВЭНСОМ САМИ
Dialogue: 0,0:02:18.88,0:02:24.40,Caption,,0,0,0,,ПРИНЕСЛИ ОТВЕТ. ОБА ПРИЗНАЛИ, ЧТО ВОЙНА С ИРАНОМ УДАРИЛА ПО РЕСПУБЛИКАНЦАМ. ТРАМП
Dialogue: 0,0:02:24.40,0:02:26.80,Caption,,0,0,0,,ГОВОРИЛ, ЧТО ОНА СТАЛА ОДНОЙ ИЗ ПРИЧИН.
Dialogue: 0,0:02:29.07,0:02:31.87,Caption,,0,0,0,,ВЭНС ПОШЁЛ ДАЛЬШЕ И СКАЗАЛ ФАКТИЧЕСКИ ПРЯМЫМ ТЕКСТОМ
Dialogue: 0,0:02:31.87,0:02:35.15,Caption,,0,0,0,,ПРИЧИНА ПОРАЖЕНИЯ ЭТО ВОЙНА. НЕ СЛОЖНАЯ ГЕОМЕТРИЯ
Dialogue: 0,0:02:35.15,0:02:39.63,Caption,,0,0,0,,ЭЛЕКТОРАТА, НЕ ПЛОХАЯ ПОГОДА, НЕ МЕРКУРИЙ В РЕТРОГРАДЕ. ВОЙНА.
Dialogue: 0,0:02:40.35,0:02:42.67,Caption,,0,0,0,,И ВОТ ТУТ ХОЧЕТСЯ ВЕРНУТЬСЯ НЕМНОГО НАЗАД. ПОСЛЕ
Dialogue: 0,0:02:42.67,0:02:45.23,Caption,,0,0,0,,ИСТОРИИ С МАДУРО В ВАШИНГТОНЕ ЯВНО ПОЧУВСТВОВАЛИ
Dialogue: 0,0:02:45.31,0:02:47.87,Caption,,0,0,0,,ВКУС УДАЧИ. БЫСТРАЯ СИЛОВАЯ ОПЕРАЦИЯ,
Dialogue: 0,0:02:48.03,0:02:50.99,Caption,,0,0,0,,ЭФФЕКТНЫЙ РЕЗУЛЬТАТ, ПРЕЗИДЕНТ ВЫГЛЯДИТ ЧЕЛОВЕКОМ,
Dialogue: 0,0:02:51.18,0:02:52.99,Caption,,0,0,0,,КОТОРЫЙ НЕ РАЗГОВАРИВАЕТ ЧАСАМИ,
Dialogue: 0,0:02:53.11,0:02:55.79,Caption,,0,0,0,,А БЕРЁТ И ДЕЛАЕТ. ДЛЯ ВНУТРЕННЕЙ ПОЛИТИКИ ЭТО
Dialogue: 0,0:02:55.87,0:02:58.43,Caption,,0,0,0,,ВООБЩЕ КОНФЕТКА. АМЕРИКАНСКИЙ ИЗБИРАТЕЛЬ ЛЮБИТ
Dialogue: 0,0:02:58.43,0:03:02.75,Caption,,0,0,0,,ПОБЕДЫ, ОСОБЕННО КОРОТКИЕ, ЖЕЛАТЕЛЬНО ЧТОБЫ К УЖИНУ УЖЕ МОЖНО БЫЛО ВКЛЮЧИТЬ
Dialogue: 0,0:03:02.75,0:03:05.55,Caption,,0,0,0,,ТЕЛЕВИЗОР И ПОСМОТРЕТЬ КРАСИВЫЙ ИТОГ. ДАЛЬШЕ
Dialogue: 0,0:03:05.63,0:03:09.15,Caption,,0,0,0,,ПОЯВИЛСЯ ИРАН. ЛОГИКА БЫЛА ПОНЯТНАЯ. ЕСЛИ ОДИН РАЗ
Dialogue: 0,0:03:09.15,0:03:11.39,Caption,,0,0,0,,ПОЛУЧИЛОСЬ БЫСТРО, ПОЧЕМУ БЫ НЕ ПОВТОРИТЬ?
Dialogue: 0,0:03:11.77,0:03:15.23,Caption,,0,0,0,,ТЕМ БОЛЕЕ ПРОТИВНИК ЗНАКОМЫЙ, УГРОЗЫ ЗВУЧАТ ДАВНО,
Dialogue: 0,0:03:15.39,0:03:20.27,Caption,,0,0,0,,ИЗРАИЛЬ РЯДОМ, ВОЕННАЯ МАШИНА ОГРОМНАЯ. ЕЩЁ ОДНА КОРОТКАЯ КАМПАНИЯ,
Dialogue: 0,0:03:20.46,0:03:25.47,Caption,,0,0,0,,ЕЩЁ ОДНА ДЕМОНСТРАЦИЯ СИЛЫ, ЕЩЁ ОДИН ТРОФЕЙ НА ПОЛИТИЧЕСКУЮ ПОЛКУ. ВОТ И
Dialogue: 0,0:03:25.55,0:03:27.87,Caption,,0,0,0,,ПОЛАГАЙСЯ ПОСЛЕ ЭТОГО НА GROK. ПОТОМУ ЧТО ВМЕСТО
Dialogue: 0,0:03:27.87,0:03:30.03,Caption,,0,0,0,,КРАСИВОГО ФИНАЛА ПОЛУЧИЛАСЬ ВОЙНА,
Dialogue: 0,0:03:30.28,0:03:32.91,Caption,,0,0,0,,КОТОРАЯ ЗАТЯНУЛАСЬ, СТАЛА ЖРАТЬ ДЕНЬГИ,
Dialogue: 0,0:03:33.07,0:03:36.03,Caption,,0,0,0,,ВЛИЯТЬ НА ЦЕНЫ И РАЗДРАЖАТЬ ТЕХ САМЫХ ЛЮДЕЙ,
Dialogue: 0,0:03:36.17,0:03:38.67,Caption,,0,0,0,,КОТОРЫЕ ГОЛОСОВАЛИ ЗА ТРАМПА ПОД ЛОЗУНГОМ AMERICA
Dialogue: 0,0:03:38.75,0:03:40.67,Caption,,0,0,0,,FIRST. А ЭТО УЖЕ СОВСЕМ СМЕШНО.
Dialogue: 0,0:03:42.94,0:03:46.22,Caption,,0,0,0,,ЧЕЛОВЕК ГОЛОСОВАЛ ЗА ТО, ЧТОБЫ АМЕРИКА ЗАНИМАЛАСЬ АМЕРИКОЙ,
Dialogue: 0,0:03:46.54,0:03:49.02,Caption,,0,0,0,,А ПОТОМ ОТКРЫВАЕТ НОВОСТИ И СНОВА ВИДИТ БЛИЖНИЙ
Dialogue: 0,0:03:49.02,0:03:51.98,Caption,,0,0,0,,ВОСТОК, УДАРЫ, РАСХОДЫ И ОБЪЯСНЕНИЯ,
Dialogue: 0,0:03:52.14,0:03:55.02,Caption,,0,0,0,,ПОЧЕМУ ЕЩЁ НЕМНОГО НАДО ПОТЕРПЕТЬ. ТО ЕСТЬ ПРОБЛЕМА
Dialogue: 0,0:03:55.10,0:03:57.34,Caption,,0,0,0,,НЕ ТОЛЬКО В САМОЙ ВОЙНЕ. ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:03:57.50,0:04:00.06,Caption,,0,0,0,,ЧТО ОНА УДАРИЛА РОВНО ПО НЕРВУ СОБСТВЕННОГО
Dialogue: 0,0:04:00.06,0:04:03.66,Caption,,0,0,0,,ЭЛЕКТОРАТА ТРАМПА. ВЭНС ЭТО ПОНЯЛ ОЧЕНЬ БЫСТРО. И,
Dialogue: 0,0:04:03.84,0:04:07.82,Caption,,0,0,0,,НАДО ПРИЗНАТЬ, ВРЕМЕНИ ЗРЯ НЕ ПОТЕРЯЛ. ПОСЛЕ СОВЕЩАНИЯ В БЕЛОМ
Dialogue: 0,0:04:07.82,0:04:11.02,Caption,,0,0,0,,ДОМЕ, ГДЕ АДМИНИСТРАЦИЯ ПЫТАЛАСЬ ВЫРАБОТАТЬ ОБЩУЮ ЛИНИЮ
Dialogue: 0,0:04:11.10,0:04:15.10,Caption,,0,0,0,,ПОСЛЕ ВЫБОРОВ, ВЭНС ВЫШЕЛ СО СВОЕЙ. И ЛИНИЯ ОКАЗАЛАСЬ ДОВОЛЬНО
Dialogue: 0,0:04:15.10,0:04:18.46,Caption,,0,0,0,,ИНТЕРЕСНОЙ. ЗАКОНЧИТЬ ВОЙНУ С ИРАНОМ. ЗАНЯТЬСЯ
Dialogue: 0,0:04:18.46,0:04:21.26,Caption,,0,0,0,,СТОИМОСТЬЮ ЖИЗНИ. ВЕРНУТЬСЯ К AMERICA FIRST.
Dialogue: 0,0:04:21.51,0:04:24.46,Caption,,0,0,0,,ПЕРЕСМОТРЕТЬ ОТНОШЕНИЯ С ИЗРАИЛЕМ. ХОРОШИЙ СПИСОК.
Dialogue: 0,0:04:24.70,0:04:28.62,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ ВСПОМНИТЬ, ЧТО ЕГО АВТОР ВООБЩЕ ТО НЕ ВЕДУЩИЙ ВЕЧЕРНЕГО
Dialogue: 0,0:04:28.62,0:04:32.94,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО ШОУ, А ВИЦЕ ПРЕЗИДЕНТ ДЕЙСТВУЮЩЕЙ АДМИНИСТРАЦИИ. ТО ЕСТЬ
Dialogue: 0,0:04:33.02,0:04:35.26,Caption,,0,0,0,,КОРАБЛЬ ЕЩЁ НЕ ПРИШВАРТОВАЛСЯ ПОСЛЕ ШТОРМА,
Dialogue: 0,0:04:35.50,0:04:38.06,Caption,,0,0,0,,А ВТОРОЙ ЧЕЛОВЕК НА БОРТУ УЖЕ ОБЪЯСНЯЕТ ПАССАЖИРАМ,
Dialogue: 0,0:04:38.30,0:04:40.62,Caption,,0,0,0,,ЧТО КУРС НАДО БЫЛО ПРОКЛАДЫВАТЬ НЕМНОГО В ДРУГУЮ
Dialogue: 0,0:04:40.70,0:04:45.50,Caption,,0,0,0,,СТОРОНУ. FOX NEWS ПИШЕТ, ЧТО ВЭНС ТЕПЕРЬ СОБИРАЕТ ВОКРУГ СЕБЯ ТЕХ СТОРОННИКОВ
Dialogue: 0,0:04:45.50,0:04:48.70,Caption,,0,0,0,,ТРАМПА, КОТОРЫЕ ЧУВСТВУЮТ СЕБЯ ОБМАНУТЫМИ ЕГО ВНЕШНЕЙ
Dialogue: 0,0:04:48.70,0:04:51.58,Caption,,0,0,0,,ПОЛИТИКОЙ. НЕ АНТИ ТРАМП. НЕ ДЕМОКРАТЫ.
Dialogue: 0,0:04:53.87,0:04:57.39,Caption,,0,0,0,,ИМЕННО ЛЮДИ MAGA, КОТОРЫЕ ГОВОРЯТ МЫ ЗА ВАС ГОЛОСОВАЛИ НЕ ДЛЯ
Dialogue: 0,0:04:57.39,0:05:01.15,Caption,,0,0,0,,ТОГО, ЧТОБЫ ПОЛУЧИТЬ ЕЩЁ ОДНУ БЕСКОНЕЧНУЮ ВОЙНУ. А ВПЕРЕДИ
Dialogue: 0,0:05:01.23,0:05:02.59,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ ГОД.
Dialogue: 0,0:05:03.23,0:05:05.71,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ИСТОРИЯ СТАНОВИТСЯ НАМНОГО ИНТЕРЕСНЕЕ
Dialogue: 0,0:05:05.71,0:05:08.99,Caption,,0,0,0,,САМОГО ПРОИГРЫША РЕСПУБЛИКАНЦЕВ. ПОТОМУ ЧТО ВЭНС УЖЕ
Dialogue: 0,0:05:08.99,0:05:10.83,Caption,,0,0,0,,НАЧАЛ ОБЪЯСНЯТЬ ПОРАЖЕНИЕ ТАК,
Dialogue: 0,0:05:11.11,0:05:13.63,Caption,,0,0,0,,ЧТОБЫ ЭТО ОБЪЯСНЕНИЕ ОДНОВРЕМЕННО СТАНОВИЛОСЬ ЕГО
Dialogue: 0,0:05:13.63,0:05:16.43,Caption,,0,0,0,,СОБСТВЕННОЙ ПОЛИТИЧЕСКОЙ ПЛАТФОРМОЙ. ОЧЕНЬ УДОБНО.
Dialogue: 0,0:05:16.65,0:05:20.03,Caption,,0,0,0,,ПОБЕДЫ АДМИНИСТРАЦИИ ОБЩИЕ. ОШИБКИ ВНЕШНЕЙ ПОЛИТИКИ
Dialogue: 0,0:05:20.11,0:05:22.27,Caption,,0,0,0,,УЖЕ МОЖНО ПОТИХОНЬКУ РАСКЛАДЫВАТЬ ПО ОТДЕЛЬНЫМ
Dialogue: 0,0:05:22.27,0:05:25.07,Caption,,0,0,0,,ПАПКАМ. ПРИЧЁМ ТРАМП НЕ МОЖЕТ ПРОСТО МАХНУТЬ РУКОЙ
Dialogue: 0,0:05:25.15,0:05:28.43,Caption,,0,0,0,,И СКАЗАТЬ, ЧТО НИЧЕГО СЕРЬЁЗНОГО НЕ ПРОИЗОШЛО. ДЕМОКРАТЫ
Dialogue: 0,0:05:28.43,0:05:31.15,Caption,,0,0,0,,ПОЛУЧИЛИ ОБЕ ПАЛАТЫ КОНГРЕССА. А ЗНАЧИТ,
Dialogue: 0,0:05:31.39,0:05:33.95,Caption,,0,0,0,,БЛИЖАЙШИЕ ДВА ГОДА БЕЛЫЙ ДОМ БУДЕТ ЖИТЬ СОВСЕМ
Dialogue: 0,0:05:33.95,0:05:36.83,Caption,,0,0,0,,В ДРУГОЙ ОБСТАНОВКЕ. ТРАМП УЖЕ НАПОМНИЛ О СВОЁМ
Dialogue: 0,0:05:36.91,0:05:39.71,Caption,,0,0,0,,ПРАВЕ ВЕТО. МОЛ, ХОТИТЕ ПРИНИМАТЬ ЗАКОНЫ,
Dialogue: 0,0:05:39.86,0:05:42.11,Caption,,0,0,0,,ПОЖАЛУЙСТА. А ПОТОМ НЕСИТЕ СЮДА,
Dialogue: 0,0:05:42.27,0:05:46.35,Caption,,0,0,0,,Я ПОСМОТРЮ. НО КОНГРЕСС ЭТО НЕ ТОЛЬКО ЗАКОНЫ. ЭТО ДЕНЬГИ,
Dialogue: 0,0:05:46.43,0:05:51.39,Caption,,0,0,0,,НАЗНАЧЕНИЯ, СЛУШАНИЯ, КОМИТЕТЫ И РАССЛЕДОВАНИЯ. ЛЮБОЙ НЕУДОБНЫЙ ВОПРОС
Dialogue: 0,0:05:51.39,0:05:53.95,Caption,,0,0,0,,АДМИНИСТРАЦИИ ТЕПЕРЬ МОЖНО ПРЕВРАТИТЬ В МНОГОЧАСОВОЙ
Dialogue: 0,0:05:53.95,0:05:56.91,Caption,,0,0,0,,ТЕЛЕВИЗИОННЫЙ СЕРИАЛ С ДОКУМЕНТАМИ И СВИДЕТЕЛЯМИ. И
Dialogue: 0,0:05:56.91,0:05:59.63,Caption,,0,0,0,,ВНЕШНЯЯ ПОЛИТИКА ЗДЕСЬ ТОЖЕ ПОПАДАЕТ ПОД РАЗДАЧУ.
Dialogue: 0,0:06:00.09,0:06:02.35,Caption,,0,0,0,,REUTERS УЖЕ ОПИСЫВАЕТ НЕСКОЛЬКО НАПРАВЛЕНИЙ,
Dialogue: 0,0:06:02.59,0:06:04.91,Caption,,0,0,0,,ГДЕ ДЕМОКРАТЫ СОБИРАЮТСЯ ДАВИТЬ НА БЕЛЫЙ ДОМ.
Dialogue: 0,0:06:07.19,0:06:09.75,Caption,,0,0,0,,ОГРАНИЧИВАТЬ ВОЗМОЖНОСТИ ПРОДОЛЖЕНИЯ ВОЙНЫ С ИРАНОМ
Dialogue: 0,0:06:09.83,0:06:12.31,Caption,,0,0,0,,ЧЕРЕЗ ФИНАНСИРОВАНИЕ. ТОРМОЗИТЬ НАЗНАЧЕНИЯ.
Dialogue: 0,0:06:12.63,0:06:15.59,Caption,,0,0,0,,ТРЕБОВАТЬ ОТЧЁТОВ. ВОЗВРАЩАТЬ АМЕРИКАНСКУЮ ПОМОЩЬ
Dialogue: 0,0:06:15.59,0:06:18.63,Caption,,0,0,0,,УКРАИНЕ. МЕШАТЬ СМЯГЧЕНИЮ САНКЦИЙ ПРОТИВ РОССИЙСКОЙ
Dialogue: 0,0:06:18.63,0:06:22.07,Caption,,0,0,0,,ЭНЕРГЕТИКИ. ВОТ ЗДЕСЬ КИЕВ ДЕЙСТВИТЕЛЬНО ПОЛУЧАЕТ ОКНО
Dialogue: 0,0:06:22.07,0:06:25.11,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ. НЕ ВОЛШЕБНУЮ КНОПКУ "ТРАМП ВЫКЛЮЧЕН".
Dialogue: 0,0:06:25.35,0:06:29.19,Caption,,0,0,0,,ОН ОСТАЁТСЯ ПРЕЗИДЕНТОМ, У НЕГО ОСТАЮТСЯ ПРАВО ВЕТО И ДВА ГОДА
Dialogue: 0,0:06:29.19,0:06:31.99,Caption,,0,0,0,,СРОКА. НО ТЕПЕРЬ ПОПЫТКА РЕЗКО УРЕЗАТЬ УКРАИНСКОЕ
Dialogue: 0,0:06:31.99,0:06:34.15,Caption,,0,0,0,,НАПРАВЛЕНИЕ ПОЛУЧАЕТ ВСТРЕЧНОЕ ДВИЖЕНИЕ
Dialogue: 0,0:06:34.15,0:06:37.03,Caption,,0,0,0,,НЕПОСРЕДСТВЕННО ИЗ КОНГРЕССА. В ГЕРМАНИИ ЭТО ПОНЯЛИ
Dialogue: 0,0:06:37.03,0:06:39.99,Caption,,0,0,0,,МГНОВЕННО. ГЛАВА МИД ЙОХАНН ВАДЕФУЛЬ УЖЕ ГОВОРИТ,
Dialogue: 0,0:06:40.23,0:06:42.95,Caption,,0,0,0,,ЧТО ПОСЛЕ ПОБЕДЫ ДЕМОКРАТОВ РАССЧИТЫВАЕТ НА БОЛЕЕ
Dialogue: 0,0:06:42.95,0:06:45.75,Caption,,0,0,0,,АКТИВНОЕ ОБСУЖДЕНИЕ АМЕРИКАНСКОЙ ПОМОЩИ КИЕВУ МЕЖДУ
Dialogue: 0,0:06:45.75,0:06:48.63,Caption,,0,0,0,,ДВУМЯ ПАРТИЯМИ. ТО ЕСТЬ В БЕРЛИНЕ ОТКРЫЛИ ОКНО,
Dialogue: 0,0:06:48.87,0:06:51.03,Caption,,0,0,0,,ПОСМОТРЕЛИ НА ВАШИНГТОН И РЕШИЛИ О,
Dialogue: 0,0:06:51.26,0:06:53.83,Caption,,0,0,0,,ВЕТЕР ПОМЕНЯЛСЯ. НО ОСОБЕННО ИНТЕРЕСНО,
Dialogue: 0,0:06:54.00,0:06:56.55,Caption,,0,0,0,,КАК НА ВСЁ ЭТО ПОСМОТРЕЛИ ЯПОНЦЫ. ПОТОМУ ЧТО
Dialogue: 0,0:06:56.55,0:06:59.59,Caption,,0,0,0,,ТАМ ПОЧЕМУ ТО НЕ ПОБЕЖАЛИ ОТКРЫВАТЬ ШАМПАНСКОЕ. В
Dialogue: 0,0:06:59.67,0:07:02.23,Caption,,0,0,0,,ТОКИО РЕАКЦИЯ ДРУГАЯ. ТАМ ОПАСАЮТСЯ,
Dialogue: 0,0:07:02.39,0:07:04.55,Caption,,0,0,0,,ЧТО ЕСЛИ ТРАМПА ЗАЖМУТ ВНУТРИ СТРАНЫ,
Dialogue: 0,0:07:04.80,0:07:07.11,Caption,,0,0,0,,ОН НАЧНЁТ АКТИВНЕЕ ИСКАТЬ УСПЕХИ ТАМ,
Dialogue: 0,0:07:07.27,0:07:10.23,Caption,,0,0,0,,ГДЕ КОНГРЕСС ОГРАНИЧИВАЕТ ПРЕЗИДЕНТА МЕНЬШЕ. ВО
Dialogue: 0,0:07:10.31,0:07:13.11,Caption,,0,0,0,,ВНЕШНЕЙ ПОЛИТИКЕ. И ВОТ ЭТО УЖЕ ВАЖНАЯ ШТУКА.
Dialogue: 0,0:07:13.29,0:07:16.07,Caption,,0,0,0,,ПОТОМУ ЧТО ПОРАЖЕНИЕ ТРАМПА ВНУТРИ АМЕРИКИ ВОВСЕ НЕ
Dialogue: 0,0:07:16.07,0:07:18.39,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО ДЕЛАЕТ ТРАМПА ТИШЕ СНАРУЖИ.
Dialogue: 0,0:07:20.68,0:07:25.40,Caption,,0,0,0,,ДЛЯ НЕГО ТЕПЕРЬ, НАОБОРОТ, ВНЕШНЯЯ ПОЛИТИКА МОЖЕТ СТАТЬ ОДНИМ ИЗ НЕМНОГИХ МЕСТ,
Dialogue: 0,0:07:25.64,0:07:27.48,Caption,,0,0,0,,ГДЕ ЕЩЁ МОЖНО ПОКАЗАТЬ ДЕЙСТВИЕ,
Dialogue: 0,0:07:27.64,0:07:31.40,Caption,,0,0,0,,СИЛУ, РЕЗУЛЬТАТ И ОСТАВИТЬ ПОСЛЕ СЕБЯ БОЛЬШОЙ ФИНАЛЬНЫЙ
Dialogue: 0,0:07:31.40,0:07:37.00,Caption,,0,0,0,,СЮЖЕТ ВТОРОГО СРОКА. ЯПОНЦЕВ БЕСПОКОИТ ИРАН. КИТАЙ. СЕВЕРНАЯ КОРЕЯ.
Dialogue: 0,0:07:37.15,0:07:40.44,Caption,,0,0,0,,РОССИЯ. ВОЗМОЖНЫЕ БОЛЬШИЕ СДЕЛКИ. ДАВЛЕНИЕ НА
Dialogue: 0,0:07:40.52,0:07:43.48,Caption,,0,0,0,,СОЮЗНИКОВ ПО ВОЕННЫМ РАСХОДАМ. ИНЫМИ СЛОВАМИ,
Dialogue: 0,0:07:43.79,0:07:46.68,Caption,,0,0,0,,В ТОКИО СМОТРЯТ НА ПРОИГРЫШ РЕСПУБЛИКАНЦЕВ И ДУМАЮТ
Dialogue: 0,0:07:46.68,0:07:49.72,Caption,,0,0,0,,НЕ "ТРАМП ОСЛАБ", А "А КУДА ТЕПЕРЬ ЕГО ПОНЕСЁТ?"
Dialogue: 0,0:07:50.51,0:07:52.76,Caption,,0,0,0,,ВОТ В ЭТОМ И ЕСТЬ НАСТОЯЩАЯ ИНТРИГА ЭТИХ
Dialogue: 0,0:07:52.76,0:07:55.64,Caption,,0,0,0,,ВЫБОРОВ. ПОТОМУ ЧТО ЕВРОПА ВИДИТ ШАНС СИЛЬНЕЕ
Dialogue: 0,0:07:55.72,0:07:58.84,Caption,,0,0,0,,ПРИВЯЗАТЬ АМЕРИКУ ОБРАТНО К УКРАИНЕ. ДЕМОКРАТЫ ВИДЯТ
Dialogue: 0,0:07:58.84,0:08:02.20,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ОГРАНИЧИТЬ ВНЕШНЮЮ ПОЛИТИКУ ТРАМПА. ВЭНС
Dialogue: 0,0:08:02.28,0:08:04.76,Caption,,0,0,0,,ВИДИТ ВОЗМОЖНОСТЬ ЗАБРАТЬ СЕБЕ НЕДОВОЛЬНУЮ ЧАСТЬ
Dialogue: 0,0:08:04.76,0:08:07.56,Caption,,0,0,0,,MAGA. А ТРАМП ВИДИТ ПЕРЕД СОБОЙ ДВА ГОДА,
Dialogue: 0,0:08:07.86,0:08:10.20,Caption,,0,0,0,,В ТЕЧЕНИЕ КОТОРЫХ ДОМА ЕМУ БУДУТ СТАВИТЬ ПАЛКИ
Dialogue: 0,0:08:10.28,0:08:12.76,Caption,,0,0,0,,В КОЛЁСА БУКВАЛЬНО НА КАЖДОМ ПОВОРОТЕ. КСТАТИ,
Dialogue: 0,0:08:13.00,0:08:14.52,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ ФОРМАТ,
Dialogue: 0,0:08:14.76,0:08:17.24,Caption,,0,0,0,,ГДЕ МЫ НЕ ОБСУЖДАЕМ ОДИН ЗАГОЛОВОК ПЯТНАДЦАТЬ МИНУТ,
Dialogue: 0,0:08:17.56,0:08:20.68,Caption,,0,0,0,,А СМОТРИМ, КТО ЧТО РЕАЛЬНО ПОЛУЧАЕТ ПОСЛЕ СОБЫТИЯ,
Dialogue: 0,0:08:20.85,0:08:23.00,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ. ЗДЕСЬ КАК РАЗ ЕСТЬ ЧТО
Dialogue: 0,0:08:23.08,0:08:26.04,Caption,,0,0,0,,ОБСУДИТЬ. И ОТДЕЛЬНО ХОЧЕТСЯ НЕМНОГО ОХЛАДИТЬ ТЕХ,
Dialogue: 0,0:08:26.17,0:08:28.60,Caption,,0,0,0,,КТО УЖЕ НАЗНАЧИЛ ПОБЕДИТЕЛЯ ПРЕЗИДЕНТСКИХ ВЫБОРОВ
Dialogue: 0,0:08:28.68,0:08:30.04,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА.
Dialogue: 0,0:08:30.60,0:08:32.92,Caption,,0,0,0,,ВТОРОЙ ДЕНЬ ПО КАНАЛАМ ГУЛЯЕТ ОЩУЩЕНИЕ,
Dialogue: 0,0:08:33.07,0:08:39.04,Caption,,0,0,0,,ЧТО ВСЁ, ПРИЕХАЛИ. РЕСПУБЛИКАНЦЫ ПРОИГРАЛИ ПРОМЕЖУТОЧНЫЕ ВЫБОРЫ,
Dialogue: 0,0:08:39.36,0:08:41.52,Caption,,0,0,0,,ЗНАЧИТ ДАЛЬШЕ ДЕМОКРАТ БЕРЁТ БЕЛЫЙ ДОМ,
Dialogue: 0,0:08:41.68,0:08:44.24,Caption,,0,0,0,,СОХРАНЯЕТ КОНГРЕСС, И МОЖНО РАСХОДИТЬСЯ.
Dialogue: 0,0:08:44.80,0:08:47.36,Caption,,0,0,0,,ДВА ГОДА НАЗАД У ДЕМОКРАТОВ УЖЕ БЫЛ КАНДИДАТ,
Dialogue: 0,0:08:47.60,0:08:50.48,Caption,,0,0,0,,КОТОРОГО ОЧЕНЬ МНОГИЕ ТОЖЕ СЧИТАЛИ ВПОЛНЕ ПРОХОДНЫМ.
Dialogue: 0,0:08:50.84,0:08:54.08,Caption,,0,0,0,,КАМАЛА ХАРРИС ПРОИГРАЛА. ПОСЛЕ ПОРАЖЕНИЯ ДЕМОКРАТЫ
Dialogue: 0,0:08:54.16,0:08:56.64,Caption,,0,0,0,,ТАК И НЕ ПРОВЕЛИ ПОЛНОЦЕННУЮ РАБОТУ НАД ОШИБКАМИ.
Dialogue: 0,0:08:56.94,0:08:59.92,Caption,,0,0,0,,ВНУТРИ ПАРТИИ НИКУДА НЕ ИСЧЕЗ СПОР МЕЖДУ СТАРОЙ
Dialogue: 0,0:08:59.92,0:09:03.36,Caption,,0,0,0,,ПАРТИЙНОЙ МАШИНОЙ И МОЛОДОЙ ПРОГРЕССИВНОЙ ЧАСТЬЮ. НЕ
Dialogue: 0,0:09:03.36,0:09:07.04,Caption,,0,0,0,,ИСЧЕЗ ВОПРОС, ЧТО ИМЕННО ОНИ ПРЕДЛАГАЮТ ИЗБИРАТЕЛЮ КРОМЕ "МЫ НЕ
Dialogue: 0,0:09:07.04,0:09:09.60,Caption,,0,0,0,,ТРАМП". НЕ ИСЧЕЗЛИ ЛИЧНЫЕ РАЗБОРКИ,
Dialogue: 0,0:09:09.84,0:09:12.88,Caption,,0,0,0,,ВЗАИМНЫЕ ОБВИНЕНИЯ, ВНУТРИПАРТИЙНАЯ МЕСТЬ,
Dialogue: 0,0:09:12.96,0:09:16.16,Caption,,0,0,0,,АМБИЦИИ И КОНКУРЕНЦИЯ. В ТЫСЯЧА ДЕВЯТЬСОТ СОРОК
Dialogue: 0,0:09:16.16,0:09:19.04,Caption,,0,0,0,,ВОСЬМОМ ТОМАС ДЬЮИ БЫЛ НАСТОЛЬКО УВЕРЕННЫМ ФАВОРИТОМ
Dialogue: 0,0:09:19.12,0:09:23.36,Caption,,0,0,0,,ПРОТИВ ГАРРИ ТРУМЭНА, ЧТО ГАЗЕТА CHICAGO DAILY TRIBUNE УСПЕЛА НАПЕЧАТАТЬ
Dialogue: 0,0:09:23.36,0:09:26.88,Caption,,0,0,0,,ЗНАМЕНИТОЕ "ДЬЮИ ПОБЕДИЛ ТРУМЭНА". ТРУМЭН ПОТОМ С
Dialogue: 0,0:09:26.88,0:09:29.12,Caption,,0,0,0,,УДОВОЛЬСТВИЕМ ФОТОГРАФИРОВАЛСЯ С ЭТОЙ ГАЗЕТОЙ В
Dialogue: 0,0:09:29.20,0:09:32.16,Caption,,0,0,0,,РУКАХ. В ДВЕ ТЫСЯЧИ ШЕСТНАДЦАТОМ УЖЕ ХИЛЛАРИ КЛИНТОН
Dialogue: 0,0:09:32.24,0:09:34.24,Caption,,0,0,0,,ШЛА НА ВЫБОРЫ С УВЕРЕННОСТЬЮ БОЛЬШЕЙ ЧАСТИ
Dialogue: 0,0:09:34.24,0:09:36.96,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО КЛАССА, МЕДИА И МОДЕЛЕЙ,
Dialogue: 0,0:09:37.20,0:09:39.92,Caption,,0,0,0,,ЧТО БЕЛЫЙ ДОМ ПРАКТИЧЕСКИ У НЕЁ. ПОТОМ ПРИШЁЛ
Dialogue: 0,0:09:39.92,0:09:43.92,Caption,,0,0,0,,ДОНАЛЬД ТРАМП И ОБЪЯСНИЛ, ЧТО АМЕРИКАНСКИЙ ИЗБИРАТЕЛЬ НЕ ОБЯЗАН ЧИТАТЬ
Dialogue: 0,0:09:43.92,0:09:49.23,Caption,,0,0,0,,ПРОГНОЗЫ. ТАК ЧТО ДЕМОКРАТАМ СЕЙЧАС ЕСТЬ СМЫСЛ РАДОВАТЬСЯ,
Dialogue: 0,0:09:49.47,0:09:51.55,Caption,,0,0,0,,НО МЕБЕЛЬ В ОВАЛЬНЫЙ КАБИНЕТ ПОКА ЛУЧШЕ НЕ
Dialogue: 0,0:09:51.55,0:09:54.19,Caption,,0,0,0,,ЗАКАЗЫВАТЬ. А РЕСПУБЛИКАНЦАМ ЕСТЬ СМЫСЛ НЕ
Dialogue: 0,0:09:54.19,0:09:58.43,Caption,,0,0,0,,РАССКАЗЫВАТЬ СЕБЕ СКАЗКИ, ЧТО ЭТО ПРОСТО ОБЫЧНАЯ ПОТЕРЯ МЕСТ НА ПРОМЕЖУТОЧНЫХ
Dialogue: 0,0:09:58.51,0:10:01.55,Caption,,0,0,0,,ВЫБОРАХ. ПОТОМУ ЧТО ОБЫЧНАЯ ИСТОРИЧЕСКАЯ КАЧЕЛЬ НЕ
Dialogue: 0,0:10:01.63,0:10:04.83,Caption,,0,0,0,,ОБЪЯСНЯЕТ ТЕХАС. НЕ ОБЪЯСНЯЕТ ПЕРЕХОД ЧАСТИ ЛЮДЕЙ,
Dialogue: 0,0:10:05.07,0:10:07.23,Caption,,0,0,0,,ГОЛОСОВАВШИХ ЗА ТРАМПА И ВЭНСА В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:10:07.23,0:10:10.91,Caption,,0,0,0,,ДВАДЦАТЬ ЧЕТВЁРТОМ, К ДЕМОКРАТАМ ЧЕРЕЗ ДВА ГОДА. И УЖ ТОЧНО
Dialogue: 0,0:10:10.99,0:10:14.83,Caption,,0,0,0,,НЕ ОБЪЯСНЯЕТ, ПОЧЕМУ САМ ВИЦЕ ПРЕЗИДЕНТ УЖЕ ПУБЛИЧНО ТРЕБУЕТ
Dialogue: 0,0:10:14.83,0:10:18.03,Caption,,0,0,0,,МЕНЯТЬ ВНЕШНЕПОЛИТИЧЕСКИЙ КУРС. ПОЛУЧИЛАСЬ ДОВОЛЬНО
Dialogue: 0,0:10:18.03,0:10:20.91,Caption,,0,0,0,,ИРОНИЧНАЯ ИСТОРИЯ. ТРАМП ШЁЛ НА ВТОРОЙ СРОК КАК
Dialogue: 0,0:10:20.99,0:10:24.27,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫЙ ДОЛЖЕН БЫЛ ВЕРНУТЬ АМЕРИКЕ СИЛУ И ЗАКОНЧИТЬ
Dialogue: 0,0:10:24.35,0:10:27.23,Caption,,0,0,0,,ЧУЖИЕ ВОЙНЫ. А ТЕПЕРЬ ОДНА ИЗ ГЛАВНЫХ ПРОБЛЕМ
Dialogue: 0,0:10:27.23,0:10:30.67,Caption,,0,0,0,,ЕГО ПАРТИИ ВЫРОСЛА ИМЕННО ИЗ НОВОЙ ВОЙНЫ. ДЕМОКРАТЫ,
Dialogue: 0,0:10:30.85,0:10:33.23,Caption,,0,0,0,,КОТОРЫХ ДВА ГОДА НАЗАД ОТПРАВИЛИ В ОППОЗИЦИЮ,
Dialogue: 0,0:10:33.47,0:10:36.19,Caption,,0,0,0,,ВОЗВРАЩАЮТСЯ СРАЗУ В ОБЕ ПАЛАТЫ. ВЭНС,
Dialogue: 0,0:10:36.43,0:10:39.15,Caption,,0,0,0,,КОТОРОГО ТРАМП СДЕЛАЛ СВОИМ НАСЛЕДНИКОМ НОМЕР ОДИН,
Dialogue: 0,0:10:39.36,0:10:41.15,Caption,,0,0,0,,УЖЕ СОБИРАЕТ ВОКРУГ СЕБЯ ЛЮДЕЙ,
Dialogue: 0,0:10:41.31,0:10:44.43,Caption,,0,0,0,,НЕДОВОЛЬНЫХ РЕШЕНИЯМИ ТРАМПА. И СВЕРХУ НА ВСЁ ЭТО
Dialogue: 0,0:10:44.43,0:10:47.07,Caption,,0,0,0,,ЕВРОПА ТРЕБУЕТ БОЛЬШЕ АМЕРИКАНСКОГО УЧАСТИЯ,
Dialogue: 0,0:10:47.39,0:10:50.59,Caption,,0,0,0,,А ЯПОНИЯ БОИТСЯ, ЧТО УЧАСТИЯ СТАНЕТ СЛИШКОМ МНОГО,
Dialogue: 0,0:10:50.89,0:10:53.23,Caption,,0,0,0,,ТОЛЬКО СОВСЕМ НЕ ТАМ, ГДЕ ЕЙ ХОТЕЛОСЬ БЫ.
Dialogue: 0,0:10:53.90,0:10:56.99,Caption,,0,0,0,,ВОТ ТАКАЯ ПОЛУЧИЛАСЬ ПОБЕДНАЯ ДОРОЖНАЯ КАРТА. GROK,
Dialogue: 0,0:10:57.14,0:11:03.66,Caption,,0,0,0,,НАВЕРНОЕ, УЖЕ ПЕРЕСЧИТАЛ. НО ТЕПЕРЬ ГЛАВНАЯ ПРОБЛЕМА ТРАМПА ДАЖЕ НЕ КОНГРЕСС.
Dialogue: 0,0:11:03.90,0:11:05.74,Caption,,0,0,0,,КОНГРЕСС МОЖНО БЛОКИРОВАТЬ ВЕТОМ,
Dialogue: 0,0:11:05.90,0:11:08.62,Caption,,0,0,0,,С НИМ МОЖНО ТОРГОВАТЬСЯ, ЕГО МОЖНО ОБВИНЯТЬ,
Dialogue: 0,0:11:08.83,0:11:11.90,Caption,,0,0,0,,С НИМ МОЖНО ВОЕВАТЬ ПУБЛИЧНО КАЖДЫЙ ДЕНЬ. ГОРАЗДО
Dialogue: 0,0:11:11.90,0:11:14.94,Caption,,0,0,0,,СЛОЖНЕЕ ДРУГОЕ. КОГДА СОБСТВЕННЫЙ ВИЦЕ ПРЕЗИДЕНТ
Dialogue: 0,0:11:14.94,0:11:17.74,Caption,,0,0,0,,НАЧИНАЕТ ГОВОРИТЬ ТВОЕМУ СОБСТВЕННОМУ ЭЛЕКТОРАТУ ДА,
Dialogue: 0,0:11:17.85,0:11:22.78,Caption,,0,0,0,,ВЫ ПРАВЫ, КУРС НАДО МЕНЯТЬ, ЭТО УЖЕ НЕ ИСТОРИЯ ПРО ДЕМОКРАТОВ. ЭТО БОРЬБА
Dialogue: 0,0:11:22.86,0:11:26.70,Caption,,0,0,0,,ЗА ТО, ЧТО ОСТАНЕТСЯ ПОСЛЕ ТРАМПА. И БЛИЖАЙШИЕ ДВА ГОДА
Dialogue: 0,0:11:26.78,0:11:29.02,Caption,,0,0,0,,ПОЭТОМУ БУДУТ НЕ ПРОСТО ДРАКОЙ БЕЛОГО ДОМА С
Dialogue: 0,0:11:29.02,0:11:33.66,Caption,,0,0,0,,КОНГРЕССОМ. ЭТО БУДЕТ ВРЕМЯ, КОГДА ДЕМОКРАТЫ ПОПРОБУЮТ ВЕРНУТЬ СЕБЕ ВНЕШНЮЮ
Dialogue: 0,0:11:33.66,0:11:36.06,Caption,,0,0,0,,ПОЛИТИКУ, ТРАМП ПОПРОБУЕТ ДОКАЗАТЬ,
Dialogue: 0,0:11:36.30,0:11:40.06,Caption,,0,0,0,,ЧТО ОН ВСЁ ЕЩЁ ХОЗЯИН ИГРЫ, А ВЭНС БУДЕТ АККУРАТНО ПРОВЕРЯТЬ,
Dialogue: 0,0:11:40.22,0:11:42.54,Caption,,0,0,0,,СКОЛЬКО ЛЮДЕЙ ГОТОВЫ ИДТИ УЖЕ НЕ ПРОСТО ЗА
Dialogue: 0,0:11:42.62,0:11:48.22,Caption,,0,0,0,,MAGA, А КОНКРЕТНО ЗА НИМ. ВЫБОРЫ ЗАКОНЧИЛИСЬ. ДЕЛЁЖ НАСЛЕДСТВА УЖЕ НАЧАЛСЯ.
