Dialogue: 0,0:00:00.12,0:00:02.44,Caption,,0,0,0,,НА УКРАИНСКОМ ТЕЛЕМАРАФОНЕ ПОЯВИЛОСЬ НОВОЕ
Dialogue: 0,0:00:02.44,0:00:06.20,Caption,,0,0,0,,ВЫРАЖЕНИЕ. ВОДНЫЙ БЛЭКАУТ. ЗВУЧИТ ПОЧТИ КАК
Dialogue: 0,0:00:06.20,0:00:09.08,Caption,,0,0,0,,ОЧЕРЕДНОЙ МОДНЫЙ ТЕРМИН, ПОКА НЕ СЛЫШИШЬ ЦИФРЫ.
Dialogue: 0,0:00:09.64,0:00:11.80,Caption,,0,0,0,,ЕСЛИ НАСОСНАЯ ГРУППА СТОИТ ВОСЕМЬ,
Dialogue: 0,0:00:11.94,0:00:15.32,Caption,,0,0,0,,ДЕСЯТЬ ЧАСОВ, ПОТОМ НЕДОСТАТОЧНО ПРОСТО ВЕРНУТЬ ЭЛЕКТРИЧЕСТВО.
Dialogue: 0,0:00:15.72,0:00:18.76,Caption,,0,0,0,,НУЖНО ЕЩЁ ПРИМЕРНО ТРИ ЧАСА НЕПРЕРЫВНОГО ПИТАНИЯ,
Dialogue: 0,0:00:18.84,0:00:21.80,Caption,,0,0,0,,ЧТОБЫ ЗАНОВО ПОДНЯТЬ ДАВЛЕНИЕ В СИСТЕМЕ. И ВОТ
Dialogue: 0,0:00:21.88,0:00:25.32,Caption,,0,0,0,,ЗДЕСЬ НАЧИНАЮТСЯ ОЧЕНЬ НЕПРИЯТНЫЕ ВОПРОСЫ. ПОТОМУ
Dialogue: 0,0:00:25.40,0:00:27.64,Caption,,0,0,0,,ЧТО ЭЛЕКТРИЧЕСТВО В КИЕВЕ СЕЙЧАС КАК РАЗ УМЕЕТ
Dialogue: 0,0:00:27.64,0:00:31.24,Caption,,0,0,0,,ИСЧЕЗАТЬ НАДОЛГО, А ВОЗВРАЩАТЬСЯ СОВСЕМ НЕ ОБЯЗАТЕЛЬНО НА ТРИ
Dialogue: 0,0:00:31.32,0:00:34.28,Caption,,0,0,0,,СПОКОЙНЫХ ЧАСА ПОДРЯД. ПОДПИШИТЕСЬ. СЕГОДНЯ ТАМ
Dialogue: 0,0:00:34.36,0:00:36.68,Caption,,0,0,0,,СТОЛЬКО РАЗНЫХ ИСТОРИЙ СОШЛОСЬ В ОДНОЙ ТОЧКЕ,
Dialogue: 0,0:00:36.97,0:00:40.12,Caption,,0,0,0,,ЧТО ОДНОЙ ЭНЕРГЕТИКОЙ ДЕЛО УЖЕ НЕ ЗАКАНЧИВАЕТСЯ. С
Dialogue: 0,0:00:40.12,0:00:42.76,Caption,,0,0,0,,ВОДОСНАБЖЕНИЕМ ПОЛУЧИЛАСЬ ОЧЕНЬ ПОКАЗАТЕЛЬНАЯ ШТУКА.
Dialogue: 0,0:00:43.24,0:00:46.12,Caption,,0,0,0,,ПРИ КОРОТКОМ ОТКЛЮЧЕНИИ СИСТЕМА ЕЩЁ КАКОЕ ТО ВРЕМЯ
Dialogue: 0,0:00:46.12,0:00:48.68,Caption,,0,0,0,,ДЕРЖИТСЯ ЗА СЧЁТ ДАВЛЕНИЯ. А ВОТ ЕСЛИ НАСОСЫ
Dialogue: 0,0:00:48.76,0:00:52.92,Caption,,0,0,0,,СТОЯТ БОЛЬШУЮ ЧАСТЬ ДНЯ, ПОСЛЕ ПОЯВЛЕНИЯ СВЕТА ГОРОД НЕ ПОЛУЧАЕТ ВОДУ
Dialogue: 0,0:00:52.92,0:00:56.04,Caption,,0,0,0,,МГНОВЕННО. СНАЧАЛА НАСОСАМ НАДО ОТРАБОТАТЬ НЕСКОЛЬКО
Dialogue: 0,0:00:56.04,0:00:59.00,Caption,,0,0,0,,ЧАСОВ БЕЗ НОВОГО ПРОВАЛА ЭЛЕКТРИЧЕСТВА. ТО ЕСТЬ СВЕТ
Dialogue: 0,0:00:59.00,0:01:03.40,Caption,,0,0,0,,УЖЕ ПОЯВИЛСЯ, А ПОСЛЕДСТВИЯ СТАРОГО ОТКЛЮЧЕНИЯ ЕЩЁ ПРОДОЛЖАЮТСЯ. И
Dialogue: 0,0:01:03.40,0:01:06.68,Caption,,0,0,0,,ЭТО УЖЕ ПРОИСХОДИЛО. ПОСЛЕ ПОСЛЕДНИХ УДАРОВ ОСНОВНЫЕ
Dialogue: 0,0:01:06.68,0:01:09.48,Caption,,0,0,0,,ВОДОПРОВОДНЫЕ ОБЪЕКТЫ КИЕВА ОСТАВАЛИСЬ БЕЗ ПИТАНИЯ.
Dialogue: 0,0:01:11.75,0:01:16.15,Caption,,0,0,0,,ВОДУ ЗАТЕМ ВЕРНУЛИ, НО ТЕПЕРЬ УКРАИНСКИЕ ЭКСПЕРТЫ ПРЯМО ПРЕДУПРЕЖДАЮТ,
Dialogue: 0,0:01:16.39,0:01:19.59,Caption,,0,0,0,,ЧТО ПРИ ДЛИННЫХ ОТКЛЮЧЕНИЯХ ГРАФИК ВОДЫ ТОЖЕ СТАНЕТ
Dialogue: 0,0:01:19.59,0:01:22.95,Caption,,0,0,0,,ЖЁСТКИМ И ПЛОХО ПРЕДСКАЗУЕМЫМ. ВОТ ВАМ И НОВЫЙ
Dialogue: 0,0:01:22.95,0:01:25.99,Caption,,0,0,0,,УРОВЕНЬ ПОДГОТОВКИ К ЗИМЕ. РАНЬШЕ ЛЮДЯМ ОБЪЯСНЯЛИ
Dialogue: 0,0:01:25.99,0:01:28.79,Caption,,0,0,0,,ГРАФИКИ СВЕТА. ТЕПЕРЬ ОТДЕЛЬНО ГОТОВЯТ К ТОМУ,
Dialogue: 0,0:01:29.00,0:01:31.43,Caption,,0,0,0,,ЧТО ПОСЛЕ СВЕТА ПРИДЁТСЯ ЖДАТЬ ЕЩЁ И ВОДУ.
Dialogue: 0,0:01:31.70,0:01:34.15,Caption,,0,0,0,,А СОБСТВЕННАЯ КИЕВСКАЯ ГЕНЕРАЦИЯ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:01:34.15,0:01:38.63,Caption,,0,0,0,,ПОЛУЧИЛА УДАР, КОТОРЫЙ ОДНИМ АВАРИЙНЫМ РЕМОНТОМ УЖЕ НЕ ЗАКРЫВАЕТСЯ.
Dialogue: 0,0:01:39.19,0:01:42.23,Caption,,0,0,0,,АЛЕКСАНДР ХАРЧЕНКО ГОВОРИТ О ТРЁХ КРУПНЫХ КИЕВСКИХ
Dialogue: 0,0:01:42.23,0:01:45.59,Caption,,0,0,0,,ТЭЦ. ДО РАЗРУШЕНИЙ ОНИ ВМЕСТЕ ДАВАЛИ ОКОЛО ОДНОЙ
Dialogue: 0,0:01:45.59,0:01:48.55,Caption,,0,0,0,,ЦЕЛОЙ ТРЁХ ДЕСЯТЫХ ГИГАВАТТА. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:01:48.71,0:01:50.87,Caption,,0,0,0,,В НОРМАЛЬНОЙ СИТУАЦИИ ЭТОГО ХВАТАЛО БЫ,
Dialogue: 0,0:01:51.03,0:01:52.95,Caption,,0,0,0,,ЧТОБЫ ОБЕСПЕЧИВАТЬ СТОЛИЦУ СОБСТВЕННОЙ
Dialogue: 0,0:01:52.95,0:01:56.23,Caption,,0,0,0,,ЭЛЕКТРОЭНЕРГИЕЙ. ТЕПЕРЬ ЭТОЙ ГЕНЕРАЦИИ ПРАКТИЧЕСКИ
Dialogue: 0,0:01:56.23,0:01:59.19,Caption,,0,0,0,,НЕТ. ХАРЧЕНКО ОЦЕНИВАЕТ РЕАЛЬНОЕ ВОССТАНОВЛЕНИЕ
Dialogue: 0,0:01:59.19,0:02:03.19,Caption,,0,0,0,,МАКСИМУМ В ДЕСЯТЬ, ПЯТНАДЦАТЬ ПРОЦЕНТОВ ОТ ПРЕЖНЕГО УРОВНЯ. НЕ
Dialogue: 0,0:02:03.19,0:02:05.91,Caption,,0,0,0,,ПОЛОВИНУ. НЕ ДВЕ ТРЕТИ. ДЕСЯТЬ,
Dialogue: 0,0:02:06.06,0:02:09.03,Caption,,0,0,0,,ПЯТНАДЦАТЬ. ОСТАЛЬНОЕ ЭЛЕКТРИЧЕСТВО НАДО ПОЛУЧАТЬ ИЗ
Dialogue: 0,0:02:09.03,0:02:11.75,Caption,,0,0,0,,ДРУГИХ ЧАСТЕЙ ЭНЕРГОСИСТЕМЫ. А ТУТ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:02:11.83,0:02:14.95,Caption,,0,0,0,,СЛЕДУЮЩАЯ ПРОБЛЕМА. МАЛО ПРОИЗВЕСТИ ЭЛЕКТРОЭНЕРГИЮ
Dialogue: 0,0:02:15.03,0:02:17.27,Caption,,0,0,0,,ГДЕ ТО ДАЛЕКО. ЕЁ ЕЩЁ НАДО ПРОВЕСТИ ДО
Dialogue: 0,0:02:17.27,0:02:20.95,Caption,,0,0,0,,ОГРОМНОГО ГОРОДА ЧЕРЕЗ СЕТЬ, ГДЕ ПОВРЕЖДЕНЫ ПОДСТАНЦИИ,
Dialogue: 0,0:02:21.11,0:02:24.39,Caption,,0,0,0,,ЛИНИИ И РАСПРЕДЕЛИТЕЛЬНЫЕ УЗЛЫ. ПОЛУЧАЕТСЯ ДОВОЛЬНО
Dialogue: 0,0:02:24.39,0:02:30.66,Caption,,0,0,0,,НЕПРИЯТНАЯ КОНСТРУКЦИЯ. КИЕВ ТЕРЯЕТ СОБСТВЕННУЮ ГЕНЕРАЦИЮ ИМЕННО В ТОТ
Dialogue: 0,0:02:30.66,0:02:34.50,Caption,,0,0,0,,МОМЕНТ, КОГДА ЗИМОЙ ПОТРЕБЛЕНИЕ ДОЛЖНО ВЫРАСТИ. И НА ЭТОМ
Dialogue: 0,0:02:34.50,0:02:37.30,Caption,,0,0,0,,МЕСТЕ ЭКСПЕРТНЫЕ ОЦЕНКИ УЖЕ НАЧИНАЮТ ЗВУЧАТЬ СОВСЕМ
Dialogue: 0,0:02:37.30,0:02:40.42,Caption,,0,0,0,,ВЕСЕЛО. ХАРЧЕНКО ГОВОРИТ О ТЯЖЁЛЫХ ОТКЛЮЧЕНИЯХ
Dialogue: 0,0:02:40.42,0:02:43.62,Caption,,0,0,0,,ПРОДОЛЖИТЕЛЬНОСТЬЮ ДО ПОЛУТОРА СУТОК. ОЛЕГ ПОПЕНКО
Dialogue: 0,0:02:43.62,0:02:46.66,Caption,,0,0,0,,СМОТРИТ ЕЩЁ ДАЛЬШЕ. ПРИ ТЕМПЕРАТУРЕ ОКОЛО МИНУС ПЯТИ
Dialogue: 0,0:02:46.66,0:02:48.66,Caption,,0,0,0,,ГРАДУСОВ ОН ДОПУСКАЕТ СЦЕНАРИЙ,
Dialogue: 0,0:02:48.90,0:02:50.98,Caption,,0,0,0,,ПРИ КОТОРОМ СВЕТА НЕ БУДЕТ ТРОЕ,
Dialogue: 0,0:02:51.09,0:02:54.66,Caption,,0,0,0,,ПЯТЕРО СУТОК, А ВКЛЮЧАТЬ ЕГО БУДУТ НА ПОЛЧАСА ИЛИ ЧАС.
Dialogue: 0,0:02:55.14,0:02:58.10,Caption,,0,0,0,,И ВОТ СЮДА ТЕПЕРЬ НАДО ДОБАВИТЬ НАСОСЫ. ЕСЛИ
Dialogue: 0,0:02:58.10,0:03:02.50,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ДАЛИ НА ЧАС, А ВОДОПРОВОДНОЙ СИСТЕМЕ ПОСЛЕ ДЛИННОГО ПРОСТОЯ НУЖНЫ
Dialogue: 0,0:03:02.50,0:03:07.46,Caption,,0,0,0,,ПРИМЕРНО ТРИ СТАБИЛЬНЫХ ЧАСА, ВОЗНИКАЕТ ОЧЕНЬ ПРОСТАЯ АРИФМЕТИКА. СВЕТ ВРОДЕ
Dialogue: 0,0:03:07.46,0:03:10.18,Caption,,0,0,0,,ПОЯВИЛСЯ. А СИСТЕМЕ ОТ ЭТОГО ПОКА НИ ХОЛОДНО
Dialogue: 0,0:03:10.18,0:03:13.14,Caption,,0,0,0,,НИ ЖАРКО. ОНА ПРОСТО НЕ УСПЕЛА ПОДНЯТЬСЯ. И
Dialogue: 0,0:03:13.22,0:03:15.46,Caption,,0,0,0,,ЭТО УЖЕ НЕ ТЕОРИЯ НА ЯНВАРЬ. В НЕКОТОРЫХ
Dialogue: 0,0:03:15.54,0:03:18.18,Caption,,0,0,0,,РАЙОНАХ КИЕВА ЛЮДИ НЕСКОЛЬКО ДНЕЙ ЖИЛИ С КРАТКИМИ
Dialogue: 0,0:03:18.18,0:03:21.22,Caption,,0,0,0,,ВКЛЮЧЕНИЯМИ ЭЛЕКТРИЧЕСТВА. СВЕТ ПОЯВЛЯЛСЯ МИНУТ НА
Dialogue: 0,0:03:21.22,0:03:24.74,Caption,,0,0,0,,ПЯТНАДЦАТЬ, ПОТОМ СНОВА ПРОПАДАЛ. ГРАФИКИ ПЕРЕСТАВАЛИ
Dialogue: 0,0:03:24.74,0:03:28.58,Caption,,0,0,0,,СООТВЕТСТВОВАТЬ ТОМУ, ЧТО ПРОИСХОДИЛО В ДОМАХ. В КАКОЙ ТО МОМЕНТ
Dialogue: 0,0:03:28.58,0:03:31.22,Caption,,0,0,0,,ЖИТЕЛИ ВЫШЛИ НА УЛИЦЫ И НАЧАЛИ ПЕРЕКРЫВАТЬ ДОРОГИ.
Dialogue: 0,0:03:31.52,0:03:34.90,Caption,,0,0,0,,ВОТ ЭТО ХОРОШИЙ ИНДИКАТОР СОСТОЯНИЯ СИСТЕМЫ. НЕ
Dialogue: 0,0:03:34.98,0:03:36.98,Caption,,0,0,0,,ЛОЗУНГ, НЕ ЗАЯВЛЕНИЕ ПОЛИТИКА,
Dialogue: 0,0:03:37.22,0:03:42.94,Caption,,0,0,0,,НЕ КРАСИВЫЙ ОТЧЁТ. ЛЮДИ ПРОСТО ПЕРЕСТАЛИ ЖДАТЬ СЛЕДУЮЩУЮ КЛЕТОЧКУ В
Dialogue: 0,0:03:42.94,0:03:45.26,Caption,,0,0,0,,ТАБЛИЦЕ ОТКЛЮЧЕНИЙ И ПОШЛИ ВЫЯСНЯТЬ,
Dialogue: 0,0:03:45.42,0:03:50.22,Caption,,0,0,0,,ЧТО ВООБЩЕ ПРОИСХОДИТ. В ГОРОДЕ УЖЕ РАЗВОРАЧИВАЮТ ПУНКТЫ ОБОГРЕВА. БЫЛИ
Dialogue: 0,0:03:50.22,0:03:53.74,Caption,,0,0,0,,ПЕРЕБОИ С ВОДОЙ. ОСТАНАВЛИВАЛСЯ ЭЛЕКТРОТРАНСПОРТ. НА
Dialogue: 0,0:03:53.82,0:03:56.94,Caption,,0,0,0,,МОСТАХ ВОЗНИКАЛИ ПРОБКИ. ПРИ ЭТОМ ДО НАСТОЯЩЕГО
Dialogue: 0,0:03:56.94,0:03:59.50,Caption,,0,0,0,,ЗИМНЕГО ПИКА ЕЩЁ ДАЛЕКО. МЫ УЖЕ ВИДЕЛИ,
Dialogue: 0,0:03:59.74,0:04:02.38,Caption,,0,0,0,,КАК БЫСТРО ПОДОБНЫЙ МЕХАНИЗМ РАБОТАЕТ В МЕНЬШИХ
Dialogue: 0,0:04:02.46,0:04:05.42,Caption,,0,0,0,,ГОРОДАХ. КОНОТОП БЫЛ ХОРОШИМ ПРИМЕРОМ. ПОКА
Dialogue: 0,0:04:05.42,0:04:09.98,Caption,,0,0,0,,ИНФРАСТРУКТУРА СТАБИЛЬНА, ГОРОД ВЫГЛЯДИТ ОЧЕНЬ ПРОЧНОЙ КОНСТРУКЦИЕЙ. ПОТОМ
Dialogue: 0,0:04:09.98,0:04:12.22,Caption,,0,0,0,,ВЫБИВАЕТСЯ НЕСКОЛЬКО КЛЮЧЕВЫХ ЭЛЕМЕНТОВ,
Dialogue: 0,0:04:12.61,0:04:15.34,Caption,,0,0,0,,И ВСЯ ЭТА ПРОЧНОСТЬ ЗА СЧИТАНЫЕ ДНИ ПРЕВРАЩАЕТСЯ
Dialogue: 0,0:04:15.42,0:04:18.46,Caption,,0,0,0,,В АВАРИЙНЫЕ СХЕМЫ. В КИЕВЕ ПРОСТО ДРУГОЙ МАСШТАБ.
Dialogue: 0,0:04:19.02,0:04:23.34,Caption,,0,0,0,,И ДРУГОЙ ОБЪЁМ ТОГО, ЧТО НУЖНО ПОСТОЯННО ВОЗВРАЩАТЬ В СТРОЙ. ПРИЧЁМ
Dialogue: 0,0:04:23.34,0:04:25.66,Caption,,0,0,0,,ВОССТАНАВЛИВАЮТ ВСЁ ЭТО НЕ АБСТРАКТНЫЕ СЛУЖБЫ ИЗ
Dialogue: 0,0:04:25.66,0:04:28.86,Caption,,0,0,0,,ТЕЛЕВИЗОРА. ТАМ РАБОТАЮТ КОНКРЕТНЫЕ ЭНЕРГЕТИКИ,
Dialogue: 0,0:04:29.02,0:04:32.78,Caption,,0,0,0,,ИНЖЕНЕРЫ, РЕМОНТНЫЕ БРИГАДЫ. ОДНО ДЕЛО ВОССТАНОВИТЬ
Dialogue: 0,0:04:32.78,0:04:35.34,Caption,,0,0,0,,ПОВРЕЖДЁННЫЙ ОБЪЕКТ ОДИН РАЗ. СОВСЕМ ДРУГОЕ
Dialogue: 0,0:04:35.34,0:04:38.22,Caption,,0,0,0,,ПОСТОЯННО ВОЗВРАЩАТЬСЯ ТУДА ПОСЛЕ НОВЫХ УДАРОВ.
Dialogue: 0,0:04:38.70,0:04:41.10,Caption,,0,0,0,,ЛЮДЕЙ ТОЖЕ НЕЛЬЗЯ ПРОИЗВОДИТЬ НА ЗАВОДЕ ПО ДВЕСТИ
Dialogue: 0,0:04:41.18,0:04:44.62,Caption,,0,0,0,,ШТУК В МЕСЯЦ. А ВОТ РАКЕТЫ, СУДЯ ПО УКРАИНСКОЙ РАЗВЕДКЕ,
Dialogue: 0,0:04:44.94,0:04:48.30,Caption,,0,0,0,,РОССИЯ ПРОИЗВОДИТ ИМЕННО СОТНЯМИ. ГУР ОЦЕНИВАЕТ
Dialogue: 0,0:04:48.30,0:04:51.50,Caption,,0,0,0,,ЕЖЕМЕСЯЧНЫЙ ВЫПУСК БОЛЕЕ ЧЕМ В ДВЕСТИ КРЫЛАТЫХ И
Dialogue: 0,0:04:51.50,0:04:57.79,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИХ РАКЕТ. В ЗАПАСАХ НАЗЫВАЮТ ОКОЛО СЕМИСОТ БАЛЛИСТИЧЕСКИХ И
Dialogue: 0,0:04:57.79,0:05:00.91,Caption,,0,0,0,,ТЫСЯЧИ КРЫЛАТЫХ. ПО ОТДЕЛЬНЫМ ПОЗИЦИЯМ ТЕМПЫ ТОЖЕ
Dialogue: 0,0:05:00.91,0:05:03.47,Caption,,0,0,0,,ПРИЛИЧНЫЕ. ДЛЯ "ИСКАНДЕРОВ" ДЕСЯТКИ РАКЕТ
Dialogue: 0,0:05:03.47,0:05:06.51,Caption,,0,0,0,,ЕЖЕМЕСЯЧНО. РАКЕТ ХА СТО ОДИН ВЫПУСКАЮТ БОЛЬШЕ
Dialogue: 0,0:05:06.51,0:05:09.63,Caption,,0,0,0,,ВОСЬМИДЕСЯТИ В МЕСЯЦ. "КАЛИБРОВ" ОКОЛО ТРИДЦАТИ.
Dialogue: 0,0:05:10.19,0:05:12.75,Caption,,0,0,0,,МОЖНО ДОЛГО СПОРИТЬ О КАЖДОМ ИНДЕКСЕ ОТДЕЛЬНО,
Dialogue: 0,0:05:13.07,0:05:16.35,Caption,,0,0,0,,НО ДЛЯ ЭТОЙ ИСТОРИИ ГЛАВНОЕ ДРУГОЕ. ЭНЕРГОСИСТЕМА
Dialogue: 0,0:05:16.35,0:05:18.11,Caption,,0,0,0,,ЖИВЁТ В РЕЖИМЕ ВОССТАНОВЛЕНИЯ,
Dialogue: 0,0:05:18.35,0:05:21.07,Caption,,0,0,0,,А ПРОИЗВОДСТВО СРЕДСТВ ДЛЯ НОВЫХ УДАРОВ ИДЁТ СВОИМ
Dialogue: 0,0:05:21.07,0:05:23.71,Caption,,0,0,0,,ОТДЕЛЬНЫМ КОНВЕЙЕРОМ. И У ЭТИХ ДВУХ ПРОЦЕССОВ
Dialogue: 0,0:05:23.71,0:05:26.67,Caption,,0,0,0,,СОВЕРШЕННО РАЗНАЯ ЛОГИКА. РАКЕТУ ИЗГОТОВИЛИ,
Dialogue: 0,0:05:26.91,0:05:31.39,Caption,,0,0,0,,ПОЛОЖИЛИ НА СКЛАД, ПОТОМ ВЫПУСТИЛИ. С КРУПНЫМ ЭНЕРГЕТИЧЕСКИМ ОБЪЕКТОМ
Dialogue: 0,0:05:31.39,0:05:33.79,Caption,,0,0,0,,ТАК НЕ РАБОТАЕТ. ТАМ ОБОРУДОВАНИЕ,
Dialogue: 0,0:05:33.87,0:05:38.99,Caption,,0,0,0,,СЕТИ, СПЕЦИАЛИСТЫ, ВРЕМЯ. А ЕСЛИ ОБЪЕКТ ЧЕРЕЗ НЕСКОЛЬКО НЕДЕЛЬ СНОВА
Dialogue: 0,0:05:38.99,0:05:42.59,Caption,,0,0,0,,ПОВРЕЖДЁН, ПРЕДЫДУЩАЯ РАБОТА ЧАСТИЧНО УЛЕТАЕТ ТУДА ЖЕ,
Dialogue: 0,0:05:42.83,0:05:44.99,Caption,,0,0,0,,КУДА И САМА ПОДСТАНЦИЯ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:05:45.15,0:05:48.03,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ РАЗГОВОР
Dialogue: 0,0:05:48.03,0:05:50.91,Caption,,0,0,0,,ВНЕЗАПНО УХОДИТ ОТ ЭНЕРГЕТИКИ СОВСЕМ В ДРУГУЮ
Dialogue: 0,0:05:50.91,0:05:54.03,Caption,,0,0,0,,СТОРОНУ. НА ЭТОМ ФОНЕ В УКРАИНСКОЙ НАЦПОЛИЦИИ
Dialogue: 0,0:05:54.03,0:05:57.63,Caption,,0,0,0,,ЗАДЕРЖИВАЮТ ЧЕЛОВЕКА, КОТОРЫЙ ДОЛЖЕН БЫЛ ЗАНИМАТЬСЯ СТРАТЕГИЧЕСКИМИ
Dialogue: 0,0:05:57.63,0:06:00.27,Caption,,0,0,0,,РАССЛЕДОВАНИЯМИ И ОРГАНИЗОВАННОЙ ПРЕСТУПНОСТЬЮ.
Dialogue: 0,0:06:00.49,0:06:02.91,Caption,,0,0,0,,ПЕРВОГО ЗАМЕСТИТЕЛЯ ГЛАВЫ СООТВЕТСТВУЮЩЕГО
Dialogue: 0,0:06:02.91,0:06:06.27,Caption,,0,0,0,,ДЕПАРТАМЕНТА ВЛАДИМИРА ЦЕНОВА. В МАТЕРИАЛАХ ДЕЛА У
Dialogue: 0,0:06:06.27,0:06:12.55,Caption,,0,0,0,,НЕГО КЛИЧКА "ПРАЙС". И ДАЛЬШЕ НАЗВАНИЕ НАЧИНАЕТ ЗВУЧАТЬ ОСОБЕННО УМЕСТНО.
Dialogue: 0,0:06:12.92,0:06:15.67,Caption,,0,0,0,,СЛЕДСТВИЕ ОПИСЫВАЕТ СЕТЬ ИЗ ПЯТИДЕСЯТИ ДВУХ
Dialogue: 0,0:06:15.67,0:06:18.63,Caption,,0,0,0,,МОШЕННИЧЕСКИХ КОЛЛ ЦЕНТРОВ. ПОЧТИ ТРИ ТЫСЯЧИ
Dialogue: 0,0:06:18.63,0:06:22.07,Caption,,0,0,0,,СОТРУДНИКОВ. ЗА БЕЗОПАСНОСТЬ КАЖДОЙ ТОЧКИ СИЛОВИКАМ
Dialogue: 0,0:06:22.07,0:06:25.27,Caption,,0,0,0,,ЯКОБЫ ПЛАТИЛИ ОКОЛО СЕМИ ТЫСЯЧ ДОЛЛАРОВ ЕЖЕМЕСЯЧНО.
Dialogue: 0,0:06:25.73,0:06:29.27,Caption,,0,0,0,,ПЯТЬДЕСЯТ ДВЕ ТОЧКИ. СЕМЬ ТЫСЯЧ С КАЖДОЙ. И
Dialogue: 0,0:06:29.27,0:06:30.95,Caption,,0,0,0,,ВСЁ ЭТО НЕ В КАКОМ ТО ПОДВАЛЕ,
Dialogue: 0,0:06:31.25,0:06:34.31,Caption,,0,0,0,,ГДЕ ДВА ЖУЛИКА ЗВОНЯТ ПЕНСИОНЕРАМ. В ДЕЛЕ ВСПЛЫВАЮТ
Dialogue: 0,0:06:34.31,0:06:39.51,Caption,,0,0,0,,СОТРУДНИКИ НАЦПОЛИЦИИ, СБУ И ПРОКУРАТУРЫ. ОПЕРАЦИЮ НАЗВАЛИ "КАРФАГЕН".
Dialogue: 0,0:06:40.06,0:06:42.31,Caption,,0,0,0,,В ТОТ ЖЕ ДЕНЬ ЗАДЕРЖАЛИ ГЕНЕРАЛ МАЙОРА СБУ
Dialogue: 0,0:06:42.39,0:06:44.55,Caption,,0,0,0,,СЕРГЕЯ ДУКУ. ВО ВРЕМЯ ОБЫСКА ОН,
Dialogue: 0,0:06:44.79,0:06:49.51,Caption,,0,0,0,,СОГЛАСНО МАТЕРИАЛАМ ДЕЛА, СОПРОТИВЛЯЛСЯ И УГРОЖАЛ ДЕТЕКТИВАМ ОРУЖИЕМ. ДАЛЬШЕ
Dialogue: 0,0:06:49.59,0:06:51.91,Caption,,0,0,0,,ВООБЩЕ НАЧИНАЕТСЯ ПОЛНЫЙ НАБОР. НАРКОТИКИ.
Dialogue: 0,0:06:52.16,0:06:55.11,Caption,,0,0,0,,ПОДДЕЛЬНЫЕ ЕВРО. ДОСТУП К ЗАКРЫТЫМ БАЗАМ МВД.
Dialogue: 0,0:06:55.51,0:06:58.47,Caption,,0,0,0,,ИНФОРМАЦИЯ О БУДУЩИХ ОБЫСКАХ. ПОХИЩЕНИЯ ЛЮДЕЙ.
Dialogue: 0,0:06:58.63,0:07:02.07,Caption,,0,0,0,,ВЫМОГАТЕЛЬСТВО. ВОТ ВАМ ЕЩЁ ОДИН РЕСУРС ГОСУДАРСТВА,
Dialogue: 0,0:07:02.32,0:07:04.63,Caption,,0,0,0,,КОТОРЫЙ, СУДЯ ПО МАТЕРИАЛАМ ДЕЛА,
Dialogue: 0,0:07:04.95,0:07:07.91,Caption,,0,0,0,,БЫЛ ЗАНЯТ ОЧЕНЬ СВОЕОБРАЗНОЙ СТРАТЕГИЧЕСКОЙ РАБОТОЙ.
Dialogue: 0,0:07:08.23,0:07:10.95,Caption,,0,0,0,,ДЛЯ ЭНЕРГОСИСТЕМЫ ИЩУТ ОБОРУДОВАНИЕ И СЧИТАЮТ
Dialogue: 0,0:07:10.95,0:07:15.51,Caption,,0,0,0,,МЕГАВАТТЫ. А СИЛОВОЙ АППАРАТ, КОТОРЫЙ ДОЛЖЕН ЛОВИТЬ ОРГАНИЗОВАННУЮ ПРЕСТУПНОСТЬ,
Dialogue: 0,0:07:15.75,0:07:18.63,Caption,,0,0,0,,САМ СТАНОВИТСЯ ЧАСТЬЮ РАССЛЕДОВАНИЯ ПО ОГРОМНОЙ СЕТИ
Dialogue: 0,0:07:18.63,0:07:21.35,Caption,,0,0,0,,МОШЕННИКОВ. СИСТЕМА, НАДО ПРИЗНАТЬ,
Dialogue: 0,0:07:21.43,0:07:26.63,Caption,,0,0,0,,МНОГОЗАДАЧНАЯ. И КАЗАЛОСЬ БЫ, КУДА УЖЕ ДАЛЬШЕ. А ДАЛЬШЕ ПОДКЛЮЧАЕТСЯ ИРАН.
Dialogue: 0,0:07:28.90,0:07:32.74,Caption,,0,0,0,,БЕДА ПРИШЛА ВООБЩЕ ОТТУДА, ОТКУДА В УКРАИНСКОЙ ЭНЕРГЕТИКЕ ЕЁ НИКТО НЕ
Dialogue: 0,0:07:32.74,0:07:35.70,Caption,,0,0,0,,ЗАКАЗЫВАЛ. ИРАН ПРИГРОЗИЛ УДАРИТЬ ПО УКРАИНЕ,
Dialogue: 0,0:07:35.94,0:07:38.90,Caption,,0,0,0,,ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ НАЧНУТ НОВУЮ АТАКУ НА ИРАН.
Dialogue: 0,0:07:39.42,0:07:42.02,Caption,,0,0,0,,В СЮЖЕТЕ ИРАНСКОГО ТЕЛЕВИДЕНИЯ СРЕДИ ВОЗМОЖНЫХ ЦЕЛЕЙ
Dialogue: 0,0:07:42.10,0:07:47.38,Caption,,0,0,0,,НАЗВАНЫ КИЕВ, ЛЬВОВ И ОДЕССА. ТО ЕСТЬ УКРАИНА ВНЕЗАПНО ПОЯВЛЯЕТСЯ ЕЩЁ И НА
Dialogue: 0,0:07:47.46,0:07:49.86,Caption,,0,0,0,,КАРТЕ ВОЗМОЖНОГО ОТВЕТА ТЕГЕРАНА НА ДЕЙСТВИЯ
Dialogue: 0,0:07:49.86,0:07:52.90,Caption,,0,0,0,,ВАШИНГТОНА. ОЧЕНЬ УДОБНАЯ СИТУАЦИЯ. СО СВОИМИ
Dialogue: 0,0:07:52.90,0:07:55.86,Caption,,0,0,0,,УДАРАМИ И ОТКЛЮЧЕНИЯМИ ЕЩЁ ДО КОНЦА НЕ РАЗОБРАЛИСЬ,
Dialogue: 0,0:07:56.10,0:07:58.42,Caption,,0,0,0,,А ТУТ УЖЕ ПРЕДЛАГАЮТ ПОЛУЧИТЬ ДОПОЛНИТЕЛЬНЫЕ
Dialogue: 0,0:07:58.42,0:08:02.50,Caption,,0,0,0,,ПРОБЛЕМЫ ИЗ КОНФЛИКТА, КОТОРЫЙ ВООБЩЕ НАЧИНАЛСЯ ЗА ТЫСЯЧИ КИЛОМЕТРОВ.
Dialogue: 0,0:08:03.08,0:08:05.54,Caption,,0,0,0,,НО ДЛЯ ИРАНА ЛОГИКА ЗДЕСЬ ДАВНО СТАЛА ШИРЕ
Dialogue: 0,0:08:05.62,0:08:08.82,Caption,,0,0,0,,ОБЫЧНОГО ОБМЕНА УДАРАМИ. ПОСЛЕ ПРОШЛЫХ АТАК ТЕГЕРАН
Dialogue: 0,0:08:08.90,0:08:11.62,Caption,,0,0,0,,УЖЕ ПОТЕРЯЛ КОМАНДИРОВ, ВОЕННЫЕ ОБЪЕКТЫ,
Dialogue: 0,0:08:11.71,0:08:14.98,Caption,,0,0,0,,ЧАСТЬ ИНФРАСТРУКТУРЫ. ПРИ ЭТОМ САМА СИСТЕМА ВЛАСТИ
Dialogue: 0,0:08:15.06,0:08:18.02,Caption,,0,0,0,,НЕ РУХНУЛА. И ЕСЛИ ИРАНСКОЕ РУКОВОДСТВО ИСХОДИТ ИЗ
Dialogue: 0,0:08:18.02,0:08:21.06,Caption,,0,0,0,,ТОГО, ЧТО СЛЕДУЮЩИЙ АМЕРИКАНСКИЙ УДАР НАПРАВЛЕН УЖЕ НЕ
Dialogue: 0,0:08:21.14,0:08:22.90,Caption,,0,0,0,,ПРОСТО ПРОТИВ КОНКРЕТНОГО ОБЪЕКТА,
Dialogue: 0,0:08:23.14,0:08:25.14,Caption,,0,0,0,,А ПРОТИВ УСТОЙЧИВОСТИ ВСЕЙ СТРАНЫ,
Dialogue: 0,0:08:25.46,0:08:28.02,Caption,,0,0,0,,ТОГДА И ОГРАНИЧЕНИЯ НА ОТВЕТ НАЧИНАЮТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:08:28.02,0:08:31.78,Caption,,0,0,0,,СОВСЕМ ИНАЧЕ. КОГДА ТЕБЯ ПЫТАЮТСЯ НАПУГАТЬ ОДНИМ УДАРОМ,
Dialogue: 0,0:08:32.02,0:08:34.34,Caption,,0,0,0,,МОЖНО ТОРГОВАТЬСЯ. КОГДА ТЫ СЧИТАЕШЬ,
Dialogue: 0,0:08:34.50,0:08:36.50,Caption,,0,0,0,,ЧТО ТЕБЯ ВСЁ РАВНО СОБИРАЮТСЯ ДОБИВАТЬ,
Dialogue: 0,0:08:36.73,0:08:39.94,Caption,,0,0,0,,ВОПРОС УЖЕ ДРУГОЙ. ЧТО ИМЕННО ТЕБЕ ЕЩЁ БЕРЕЧЬ?
Dialogue: 0,0:08:42.23,0:08:44.63,Caption,,0,0,0,,ВОТ ПОЧЕМУ СЛЕДУЮЩИЙ ВИТОК ВОКРУГ ИРАНА СПОСОБЕН
Dialogue: 0,0:08:44.71,0:08:46.71,Caption,,0,0,0,,ОКАЗАТЬСЯ ГОРАЗДО ШИРЕ ПРЕДЫДУЩЕГО.
Dialogue: 0,0:08:47.27,0:08:49.83,Caption,,0,0,0,,АМЕРИКАНСКИЕ ОБЪЕКТЫ НАХОДЯТСЯ ПО ВСЕМУ РЕГИОНУ И В
Dialogue: 0,0:08:49.83,0:08:53.91,Caption,,0,0,0,,ЕВРОПЕ. ЕСТЬ СОЮЗНИКИ США. ЕСТЬ ЛОГИСТИКА. ЕСТЬ
Dialogue: 0,0:08:53.91,0:08:57.99,Caption,,0,0,0,,ИНФРАСТРУКТУРА. ЕСТЬ СТРАНЫ, КОТОРЫЕ ПРЕДОСТАВЛЯЮТ ТЕРРИТОРИИ,
Dialogue: 0,0:08:58.07,0:09:00.95,Caption,,0,0,0,,АЭРОДРОМЫ И ДРУГИЕ ВОЗМОЖНОСТИ. И ТЕПЕРЬ В ЭТУ
Dialogue: 0,0:09:01.03,0:09:03.99,Caption,,0,0,0,,КАРТУ НЕОЖИДАННО ВПИСЫВАЮТ ЕЩЁ И УКРАИНСКИЕ ГОРОДА.
Dialogue: 0,0:09:04.15,0:09:06.55,Caption,,0,0,0,,ДЛЯ КИЕВА ЭТО ОСОБЕННО НЕПРИЯТНО НЕ САМО ПО
Dialogue: 0,0:09:06.55,0:09:10.39,Caption,,0,0,0,,СЕБЕ, А ПО ВРЕМЕНИ. ЭНЕРГЕТИЧЕСКАЯ СИСТЕМА УЖЕ РАБОТАЕТ С
Dialogue: 0,0:09:10.47,0:09:13.51,Caption,,0,0,0,,ОГРОМНЫМ НАПРЯЖЕНИЕМ. СОБСТВЕННАЯ ГЕНЕРАЦИЯ СТОЛИЦЫ
Dialogue: 0,0:09:13.51,0:09:16.15,Caption,,0,0,0,,РАЗРУШЕНА. ЭКСПЕРТЫ ГОВОРЯТ О МНОГОСУТОЧНЫХ
Dialogue: 0,0:09:16.15,0:09:19.19,Caption,,0,0,0,,ОТКЛЮЧЕНИЯХ. ПОЯВИЛСЯ ОТДЕЛЬНЫЙ ТЕРМИН ДЛЯ ПРОБЛЕМ С
Dialogue: 0,0:09:19.27,0:09:22.63,Caption,,0,0,0,,ВОДОЙ. ЛЮДИ ВЫХОДЯТ НА УЛИЦЫ. РЕМОНТНЫЕ БРИГАДЫ
Dialogue: 0,0:09:22.63,0:09:25.43,Caption,,0,0,0,,СНОВА И СНОВА ВОЗВРАЩАЮТ ПОВРЕЖДЁННЫЕ ОБЪЕКТЫ В
Dialogue: 0,0:09:25.43,0:09:28.55,Caption,,0,0,0,,СТРОЙ. А ПАРАЛЛЕЛЬНО ОТКРЫВАЕТСЯ ЕЩЁ ОДИН ВНЕШНИЙ
Dialogue: 0,0:09:28.63,0:09:32.47,Caption,,0,0,0,,КОНТУР РИСКА, КОТОРЫЙ УКРАИНА САМА ВООБЩЕ НЕ КОНТРОЛИРУЕТ.
Dialogue: 0,0:09:33.02,0:09:35.83,Caption,,0,0,0,,РЕШЕНИЕ ПРИНИМАЕТ ВАШИНГТОН. ОТВЕЧАТЬ СОБИРАЕТСЯ
Dialogue: 0,0:09:35.91,0:09:38.95,Caption,,0,0,0,,ТЕГЕРАН. А НАЗВАНИЕ УКРАИНСКОГО ГОРОДА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:09:38.95,0:09:41.75,Caption,,0,0,0,,ПОСЕРЕДИНЕ. ОЧЕНЬ УДОБНАЯ ГЕОПОЛИТИЧЕСКАЯ
Dialogue: 0,0:09:41.75,0:09:43.83,Caption,,0,0,0,,КОНСТРУКЦИЯ. ОСОБЕННО ДЛЯ ТОГО,
Dialogue: 0,0:09:43.99,0:09:46.23,Caption,,0,0,0,,КТО В ЭТОМ ГОРОДЕ ЖИВЁТ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:09:46.23,0:09:49.43,Caption,,0,0,0,,НОВЫЙ ТЕРМИН "ВОДНЫЙ БЛЭКАУТ" ВДРУГ ОКАЗЫВАЕТСЯ
Dialogue: 0,0:09:49.51,0:09:53.35,Caption,,0,0,0,,НАМНОГО ВАЖНЕЕ, ЧЕМ КАЖЕТСЯ. ОН ПОКАЗЫВАЕТ ОДНУ ПРОСТУЮ ВЕЩЬ.
Dialogue: 0,0:09:55.63,0:09:58.51,Caption,,0,0,0,,СОВРЕМЕННЫЙ БОЛЬШОЙ ГОРОД ДЕРЖИТСЯ НЕ НА ОТДЕЛЬНЫХ
Dialogue: 0,0:09:58.51,0:10:01.23,Caption,,0,0,0,,СИСТЕМАХ, КОТОРЫЕ ЖИВУТ КАЖДАЯ САМА ПО СЕБЕ.
Dialogue: 0,0:10:01.79,0:10:06.03,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ПРОСЕДАЕТ, СЛЕДОМ НАЧИНАЕТ ЗАВИСЕТЬ ВОДА. ПОВРЕЖДАЕТСЯ
Dialogue: 0,0:10:06.03,0:10:10.19,Caption,,0,0,0,,ГЕНЕРАЦИЯ, РАСТЁТ НАГРУЗКА НА ПЕРЕДАЧУ. ДЛИННЫЕ ОТКЛЮЧЕНИЯ
Dialogue: 0,0:10:10.19,0:10:12.75,Caption,,0,0,0,,ЗАСТАВЛЯЮТ МЕНЯТЬ РЕЖИМ РАБОТЫ ТРАНСПОРТА И
Dialogue: 0,0:10:12.75,0:10:16.83,Caption,,0,0,0,,КОММУНАЛЬНЫХ СЛУЖБ. ПОТОМ К ВНУТРЕННИМ ПРОБЛЕМАМ ДОБАВЛЯЮТСЯ НОВЫЕ
Dialogue: 0,0:10:16.91,0:10:20.27,Caption,,0,0,0,,ВНЕШНИЕ РИСКИ. КАЖДЫЙ ОТДЕЛЬНЫЙ УДАР СИСТЕМА ЕЩЁ
Dialogue: 0,0:10:20.27,0:10:22.99,Caption,,0,0,0,,ПЫТАЕТСЯ ПОГЛОТИТЬ. НО КОЛИЧЕСТВО ОДНОВРЕМЕННО
Dialogue: 0,0:10:22.99,0:10:25.79,Caption,,0,0,0,,ОТКРЫТЫХ ПРОБЛЕМ ПРОДОЛЖАЕТ РАСТИ. И ВОТ ЗДЕСЬ
