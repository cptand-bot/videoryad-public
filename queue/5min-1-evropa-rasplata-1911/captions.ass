Dialogue: 0,0:00:00.12,0:00:02.44,Caption,,0,0,0,,ПОМНИТЕ ГОГОЛЕВСКУЮ УНТЕР ОФИЦЕРСКУЮ ВДОВУ,
Dialogue: 0,0:00:02.60,0:00:04.76,Caption,,0,0,0,,КОТОРАЯ САМА СЕБЯ ВЫСЕКЛА? ТАК ВОТ,
Dialogue: 0,0:00:04.86,0:00:08.84,Caption,,0,0,0,,ПОХОЖЕ, У ЭТОЙ ЖЕНЩИНЫ ТЕПЕРЬ ЕВРОПЕЙСКАЯ ПРОПИСКА. СНАЧАЛА
Dialogue: 0,0:00:08.84,0:00:10.52,Caption,,0,0,0,,ПРИДУМАЛИ НАКАЗАНИЕ ДЛЯ РОССИИ,
Dialogue: 0,0:00:10.76,0:00:13.00,Caption,,0,0,0,,ПОТОМ НЕСКОЛЬКО ЛЕТ СТАРАТЕЛЬНО ПРИВОДИЛИ ЕГО В
Dialogue: 0,0:00:13.00,0:00:15.24,Caption,,0,0,0,,ИСПОЛНЕНИЕ. А ТЕПЕРЬ ПУТИН ГОВОРИТ,
Dialogue: 0,0:00:15.40,0:00:18.20,Caption,,0,0,0,,ЧТО НАКАЗАННЫЕ ПОЧЕМУ ТО ОКАЗАЛИСЬ СОВСЕМ НЕ ТАМ,
Dialogue: 0,0:00:18.36,0:00:20.92,Caption,,0,0,0,,ГДЕ ИХ СОБИРАЛИСЬ ИСКАТЬ. И ВОТ ТУТ САМОЕ
Dialogue: 0,0:00:20.92,0:00:24.60,Caption,,0,0,0,,ВРЕМЯ ПОСМОТРЕТЬ, ЧТО ПРОИЗОШЛО ЗА ПОСЛЕДНИЕ ДНИ. ПОТОМУ ЧТО У
Dialogue: 0,0:00:24.60,0:00:26.68,Caption,,0,0,0,,ЭТОЙ ИСТОРИИ ОБНАРУЖИЛОСЬ ПРОДОЛЖЕНИЕ,
Dialogue: 0,0:00:26.92,0:00:29.96,Caption,,0,0,0,,КОТОРОГО В БРЮССЕЛЕ ЯВНО НЕ ЗАКАЗЫВАЛИ. ПОДПИШИТЕСЬ.
Dialogue: 0,0:00:30.52,0:00:34.84,Caption,,0,0,0,,ТУТ КАК РАЗ ТОТ СЛУЧАЙ, КОГДА САМОЕ ИНТЕРЕСНОЕ НАЧИНАЕТСЯ НЕ С ОЧЕРЕДНОГО
Dialogue: 0,0:00:34.84,0:00:38.04,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, А С ТОГО, ЧТО ПРОИСХОДИТ ПОСЛЕ НЕГО.
Dialogue: 0,0:00:38.68,0:00:41.32,Caption,,0,0,0,,НА ДЕЛОВОМ САММИТЕ АТЭС ПУТИН НАПОМНИЛ ВЕЩЬ,
Dialogue: 0,0:00:41.56,0:00:44.12,Caption,,0,0,0,,КОТОРУЮ В ЕВРОПЕ ОЧЕНЬ НЕ ЛЮБЯТ ОБСУЖДАТЬ ИМЕННО
Dialogue: 0,0:00:44.20,0:00:47.00,Caption,,0,0,0,,В ТАКОЙ ФОРМУЛИРОВКЕ. РОССИЯ, СКАЗАЛ ОН,
Dialogue: 0,0:00:47.23,0:00:49.80,Caption,,0,0,0,,СТАЛА МИРОВЫМ РЕКОРДСМЕНОМ ПО КОЛИЧЕСТВУ САНКЦИЙ.
Dialogue: 0,0:00:50.12,0:00:51.80,Caption,,0,0,0,,ОГРАНИЧЕНИЙ НАВВОДИЛИ СТОЛЬКО,
Dialogue: 0,0:00:51.98,0:00:54.20,Caption,,0,0,0,,ЧТО ТУТ УЖЕ ДЕЙСТВИТЕЛЬНО МОЖНО ОТДЕЛЬНУЮ КНИГУ
Dialogue: 0,0:00:54.28,0:00:57.80,Caption,,0,0,0,,ВЫПУСКАТЬ. ТОМ ПЕРВЫЙ. ТОМ ВТОРОЙ. САНКЦИИ ВЕСЕННИЕ.
Dialogue: 0,0:00:58.04,0:01:01.80,Caption,,0,0,0,,САНКЦИИ ОСЕННИЕ. САНКЦИИ РОЖДЕСТВЕНСКИЕ. ПОДАРОЧНЫЙ
Dialogue: 0,0:01:01.88,0:01:04.68,Caption,,0,0,0,,НАБОР САНКЦИЙ С ОТКРЫТКОЙ ВНУТРИ. ТОЛЬКО ПРОБЛЕМА В
Dialogue: 0,0:01:04.68,0:01:07.72,Caption,,0,0,0,,ТОМ, ЧТО САНКЦИИ ВВОДЯТ НЕ ДЛЯ КОЛЛЕКЦИИ. У НИХ
Dialogue: 0,0:01:07.72,0:01:13.84,Caption,,0,0,0,,ВРОДЕ КАК ДОЛЖНА БЫТЬ ЦЕЛЬ. ЕСЛИ ЧЕЛОВЕКА ПЯТЬ ЛЕТ БИТЬ МОЛОТКОМ ПО ПАЛЬЦУ,
Dialogue: 0,0:01:14.12,0:01:18.64,Caption,,0,0,0,,А ОН ПРОДОЛЖАЕТ РАБОТАТЬ, ТО НА ШЕСТОЙ ГОД ВОЗНИКАЕТ НЕПРИЯТНЫЙ ВОПРОС. МОЖЕТ,
Dialogue: 0,0:01:18.88,0:01:21.28,Caption,,0,0,0,,ПОРА ПОСМОТРЕТЬ, ПО ПАЛЬЦУ ЛИ ВООБЩЕ ПОПАДАЕМ?
Dialogue: 0,0:01:21.84,0:01:25.52,Caption,,0,0,0,,ПУТИН ГОВОРИТ, ЧТО РОССИЯ ЭТОТ УДАР ВЫДЕРЖАЛА. БОЛЕЕ ТОГО,
Dialogue: 0,0:01:25.60,0:01:29.84,Caption,,0,0,0,,ПРИСПОСОБИЛАСЬ. А ЕВРОПА, ОТКАЗАВШИСЬ ОТ РОССИЙСКОГО РЫНКА И ПРЕЖНИХ
Dialogue: 0,0:01:29.84,0:01:33.12,Caption,,0,0,0,,ЭКОНОМИЧЕСКИХ СВЯЗЕЙ, В ИТОГЕ САМА ПОЛУЧИЛА ПРОБЛЕМЫ С
Dialogue: 0,0:01:33.12,0:01:36.24,Caption,,0,0,0,,КОНКУРЕНТОСПОСОБНОСТЬЮ, ДОЛГАМИ И УРОВНЕМ ЖИЗНИ.
Dialogue: 0,0:01:36.86,0:01:38.80,Caption,,0,0,0,,И ВОТ ЗДЕСЬ КАК РАЗ ВСПОМИНАЕТСЯ ТА САМАЯ
Dialogue: 0,0:01:38.80,0:01:41.28,Caption,,0,0,0,,ВДОВА. ПОТОМУ ЧТО ПЕРВОНАЧАЛЬНАЯ КОНСТРУКЦИЯ
Dialogue: 0,0:01:41.28,0:01:44.00,Caption,,0,0,0,,ВЫГЛЯДЕЛА ДОВОЛЬНО ПРОСТО. СЕЙЧАС МЫ ВАМ ПЕРЕКРОЕМ
Dialogue: 0,0:01:44.00,0:01:47.28,Caption,,0,0,0,,РЫНКИ. СЕЙЧАС МЫ ВАМ ПЕРЕКРОЕМ РАСЧЁТЫ. СЕЙЧАС МЫ
Dialogue: 0,0:01:47.28,0:01:50.24,Caption,,0,0,0,,ОТКАЖЕМСЯ ОТ ВАШИХ РЕСУРСОВ. СЕЙЧАС СДЕЛАЕМ ТАК,
Dialogue: 0,0:01:50.48,0:01:53.92,Caption,,0,0,0,,ЧТО ВАМ СТАНЕТ ОЧЕНЬ ДОРОГО. НУ ХОРОШО. ПРОШЛО
Dialogue: 0,0:01:53.92,0:01:56.24,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ. И ТЕПЕРЬ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:01:56.48,0:01:58.80,Caption,,0,0,0,,ЧТО СЛОВО "ДОРОГО" ДЕЙСТВИТЕЛЬНО СТАЛО ОДНИМ ИЗ
Dialogue: 0,0:01:58.88,0:02:02.00,Caption,,0,0,0,,ГЛАВНЫХ СЛОВ ЭТОЙ ИСТОРИИ. ТОЛЬКО ЗВУЧИТ ОНО ПОЧЕМУ
Dialogue: 0,0:02:02.00,0:02:04.56,Caption,,0,0,0,,ТО ВСЁ ЧАЩЕ УЖЕ В САМОЙ ЕВРОПЕ. ПРИЧЁМ
Dialogue: 0,0:02:04.64,0:02:06.56,Caption,,0,0,0,,ЗДЕСЬ ДАЖЕ НЕ НАДО ДАЛЕКО ХОДИТЬ И СОБИРАТЬ
Dialogue: 0,0:02:06.56,0:02:09.20,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЕ ОТЧЁТЫ ТОЛЩИНОЙ С КИРПИЧ. ЕСТЬ
Dialogue: 0,0:02:09.28,0:02:12.00,Caption,,0,0,0,,MERCEDES BENZ. ВОТ MERCEDES ДЛЯ ГЕРМАНИИ,
Dialogue: 0,0:02:12.32,0:02:16.72,Caption,,0,0,0,,ЭТО ЖЕ НЕ ПРОСТО ФИРМА, КОТОРАЯ ДЕЛАЕТ АВТОМОБИЛИ. ЭТО ПОЧТИ ГОСУДАРСТВЕННЫЙ
Dialogue: 0,0:02:16.80,0:02:20.08,Caption,,0,0,0,,ГЕРБ, ТОЛЬКО С ТРЕМЯ ЛУЧАМИ. НЕМЕЦКОЕ МАШИНОСТРОЕНИЕ.
Dialogue: 0,0:02:20.40,0:02:23.84,Caption,,0,0,0,,НЕМЕЦКАЯ ИНЖЕНЕРИЯ. НЕМЕЦКОЕ КАЧЕСТВО. НЕМЕЦКАЯ
Dialogue: 0,0:02:23.84,0:02:27.33,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬ. ВСЁ,
Dialogue: 0,0:02:27.41,0:02:30.05,Caption,,0,0,0,,ЧЕМ ГЕРМАНИЯ ДЕСЯТИЛЕТИЯМИ ПОКАЗЫВАЛА МИРУ ВОТ
Dialogue: 0,0:02:30.05,0:02:34.05,Caption,,0,0,0,,СМОТРИТЕ, КАК НАДО ДЕЛАТЬ МАШИНЫ. MERCEDES ПЕРЕЖИЛ НАЦИСТСКУЮ
Dialogue: 0,0:02:34.05,0:02:37.81,Caption,,0,0,0,,ГЕРМАНИЮ. ПЕРЕЖИЛ МИРОВУЮ ВОЙНУ. ПЕРЕЖИЛ РАЗРУШЕННУЮ
Dialogue: 0,0:02:37.81,0:02:40.85,Caption,,0,0,0,,СТРАНУ. ПЕРЕЖИЛ РАЗДЕЛ ГЕРМАНИИ. ПЕРЕЖИЛ ЕЁ
Dialogue: 0,0:02:40.85,0:02:43.57,Caption,,0,0,0,,ОБЪЕДИНЕНИЕ. ПЕРЕЖИЛ КРИЗИСЫ, НЕФТЬ,
Dialogue: 0,0:02:43.65,0:02:46.13,Caption,,0,0,0,,ИНФЛЯЦИЮ, КОНКУРЕНТОВ, ЯПОНЦЕВ,
Dialogue: 0,0:02:46.25,0:02:51.41,Caption,,0,0,0,,АМЕРИКАНЦЕВ, КОРЕЙЦЕВ. СТОЯЛ. РАБОТАЛ. СТРОИЛ. ВКЛАДЫВАЛ ДЕНЬГИ.
Dialogue: 0,0:02:51.79,0:02:54.53,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ РУКОВОДСТВО MERCEDES ГОВОРИТ ДАЛЬНЕЙШИЕ
Dialogue: 0,0:02:54.53,0:02:57.41,Caption,,0,0,0,,ИНВЕСТИЦИИ В НЕМЕЦКИЕ ПРЕДПРИЯТИЯ ПРИОСТАНАВЛИВАЕМ.
Dialogue: 0,0:02:57.68,0:03:01.25,Caption,,0,0,0,,ОПА. ВОТ ТУТ ХОЧЕТСЯ ОСТАНОВИТЬСЯ. НЕ КАКАЯ НИБУДЬ
Dialogue: 0,0:03:01.33,0:03:03.89,Caption,,0,0,0,,ПАЛАТКА С ШАУРМОЙ РЕШИЛА ПЕРЕЕХАТЬ ЧЕРЕЗ ДОРОГУ,
Dialogue: 0,0:03:04.12,0:03:07.73,Caption,,0,0,0,,ПОТОМУ ЧТО АРЕНДА ДОРОГАЯ. MERCEDES. В ГЕРМАНИИ. НЕ
Dialogue: 0,0:03:07.81,0:03:09.97,Caption,,0,0,0,,ХОЧЕТ ПОКА ВКЛАДЫВАТЬ НОВЫЕ ДЕНЬГИ В НЕМЕЦКИЕ
Dialogue: 0,0:03:09.97,0:03:12.21,Caption,,0,0,0,,ЗАВОДЫ. МУЖИКИ, А ЧТО СЛУЧИЛОСЬ?
Dialogue: 0,0:03:12.44,0:03:15.17,Caption,,0,0,0,,ГЕРМАНИЯ КУДА ТО ПЕРЕЕХАЛА? ШТУТГАРТ ПРОПАЛ?
Dialogue: 0,0:03:15.52,0:03:18.37,Caption,,0,0,0,,ИНЖЕНЕРЫ ЗАКОНЧИЛИСЬ? ЗВЕЗДА С КАПОТА ОТВАЛИЛАСЬ?
Dialogue: 0,0:03:18.51,0:03:21.41,Caption,,0,0,0,,НЕТ. РУКОВОДСТВО ГОВОРИТ О СТОИМОСТИ ПРОИЗВОДСТВА.
Dialogue: 0,0:03:21.65,0:03:25.41,Caption,,0,0,0,,КОМПАНИЯ СМОТРИТ, КАКИЕ ПРЕДПРИЯТИЯ ОНА ВООБЩЕ МОЖЕТ СЕБЕ ПОЗВОЛИТЬ
Dialogue: 0,0:03:25.41,0:03:27.81,Caption,,0,0,0,,СОДЕРЖАТЬ. А В ОБСУЖДЕНИИ УЖЕ ПОЯВЛЯЕТСЯ И
Dialogue: 0,0:03:27.81,0:03:30.77,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ЗАКРЫТИЯ ОТДЕЛЬНЫХ ЗАВОДОВ. ВОТ ТАК
Dialogue: 0,0:03:30.77,0:03:33.17,Caption,,0,0,0,,ВЫГЛЯДИТ ПРОМЫШЛЕННАЯ РОМАНТИКА ДВАДЦАТЬ ПЕРВОГО
Dialogue: 0,0:03:33.17,0:03:36.29,Caption,,0,0,0,,ВЕКА. РАНЬШЕ НЕМЕЦКИЙ ЗАВОД БЫЛ ПРЕДМЕТОМ ГОРДОСТИ.
Dialogue: 0,0:03:36.51,0:03:38.53,Caption,,0,0,0,,ТЕПЕРЬ ФИНАНСОВЫЙ ДИРЕКТОР СМОТРИТ НА НЕГО И
Dialogue: 0,0:03:38.53,0:03:41.41,Caption,,0,0,0,,СПРАШИВАЕТ А МЫ ТОЧНО МОЖЕМ СЕБЕ ПОЗВОЛИТЬ ЭТУ
Dialogue: 0,0:03:41.41,0:03:46.97,Caption,,0,0,0,,ГОРДОСТЬ? И ЗДЕСЬ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ЦИФРА. ГЛАВА
Dialogue: 0,0:03:46.97,0:03:49.29,Caption,,0,0,0,,ПРОИЗВОДСТВА MERCEDES МИХАЭЛЬ ШИБЕ ГОВОРИТ,
Dialogue: 0,0:03:49.53,0:03:52.33,Caption,,0,0,0,,ЧТО СТОИМОСТЬ ОДНОГО ЧАСА ПРОИЗВОДСТВА В ГЕРМАНИИ В
Dialogue: 0,0:03:52.33,0:03:56.57,Caption,,0,0,0,,ПЯТЬ РАЗ ВЫШЕ, ЧЕМ В ВОСТОЧНОЙ ЕВРОПЕ. В ПЯТЬ РАЗ. ВОТ
Dialogue: 0,0:03:56.65,0:03:58.25,Caption,,0,0,0,,ЭТО УЖЕ НЕ РАЗНИЦА В ЦЕНЕ КОФЕ НА
Dialogue: 0,0:03:58.25,0:04:01.29,Caption,,0,0,0,,ВОКЗАЛЕ. ЭТО КОГДА ДВА ЗАВОДА ВЫПУСКАЮТ ПРОДУКЦИЮ,
Dialogue: 0,0:04:01.60,0:04:03.45,Caption,,0,0,0,,А ОДИН ИЗ НИХ С САМОГО НАЧАЛА БЕЖИТ
Dialogue: 0,0:04:03.45,0:04:05.77,Caption,,0,0,0,,ДИСТАНЦИЮ С ГИРЕЙ НА НОГЕ. И ПОТОМ ВСЕ
Dialogue: 0,0:04:05.77,0:04:10.17,Caption,,0,0,0,,ОЧЕНЬ УДИВЛЯЮТСЯ, ПОЧЕМУ РУКОВОДСТВО НАЧИНАЕТ СЧИТАТЬ ДЕНЬГИ. ПРИЧЁМ
Dialogue: 0,0:04:10.17,0:04:12.65,Caption,,0,0,0,,САМОЕ ИЗДЕВАТЕЛЬСКОЕ ЗДЕСЬ ДАЖЕ НЕ В САМОЙ ЦИФРЕ.
Dialogue: 0,0:04:12.97,0:04:16.17,Caption,,0,0,0,,САМОЕ ИЗДЕВАТЕЛЬСКОЕ В НАЗВАНИИ. MADE IN GERMANY.
Dialogue: 0,0:04:16.57,0:04:18.41,Caption,,0,0,0,,КОГДА ТО ЭТИ ТРИ СЛОВА САМИ ПО СЕБЕ
Dialogue: 0,0:04:18.49,0:04:20.89,Caption,,0,0,0,,БЫЛИ РЕКЛАМОЙ. МОЖНО БЫЛО НИЧЕГО БОЛЬШЕ НЕ
Dialogue: 0,0:04:20.89,0:04:24.17,Caption,,0,0,0,,ОБЪЯСНЯТЬ. СДЕЛАНО В ГЕРМАНИИ. ВСЁ. ЗНАЧИТ
Dialogue: 0,0:04:24.17,0:04:29.13,Caption,,0,0,0,,КАЧЕСТВЕННО, НАДЁЖНО, ДОРОГО, НО ПОНЯТНО ЗА ЧТО. И ТУТ ЗВУЧИТ СОВСЕМ
Dialogue: 0,0:04:29.13,0:04:32.73,Caption,,0,0,0,,ДРУГОЙ ВЕРДИКТ БРЕНД MADE IN GERMANY МЁРТВ. ФРАЗА
Dialogue: 0,0:04:32.81,0:04:34.97,Caption,,0,0,0,,ЖЁСТКАЯ. НО ВЕДЬ ОТКУДА ОНА ПОЯВЛЯЕТСЯ?
Dialogue: 0,0:04:35.12,0:04:37.29,Caption,,0,0,0,,НЕ ИЗ ПУСТОТЫ. ПОТОМУ ЧТО КОГДА ОДНА ИЗ
Dialogue: 0,0:04:37.37,0:04:40.09,Caption,,0,0,0,,САМЫХ НЕМЕЦКИХ КОМПАНИЙ НА ПЛАНЕТЕ НАЧИНАЕТ ДУМАТЬ,
Dialogue: 0,0:04:40.33,0:04:42.81,Caption,,0,0,0,,НАСКОЛЬКО ЕЙ ВООБЩЕ ВЫГОДНО ДАЛЬШЕ ПРОИЗВОДИТЬ В
Dialogue: 0,0:04:42.81,0:04:45.13,Caption,,0,0,0,,ГЕРМАНИИ, ЗДЕСЬ УЖЕ ТРУДНО ДЕЛАТЬ ВИД,
Dialogue: 0,0:04:45.37,0:04:48.33,Caption,,0,0,0,,ЧТО НИЧЕГО ОСОБЕННОГО НЕ ПРОИЗОШЛО. ОСОБЕННО СМЕШНО
Dialogue: 0,0:04:48.41,0:04:50.65,Caption,,0,0,0,,ЧИТАТЬ ВСЁ ЭТО НА ФОНЕ МНОГОЛЕТНИХ РАЗГОВОРОВ О
Dialogue: 0,0:04:50.65,0:04:53.45,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ СТРАТЕГИЧЕСКОЙ АВТОНОМИИ. АВТОНОМИЯ
Dialogue: 0,0:04:53.53,0:04:58.85,Caption,,0,0,0,,ПРЕКРАСНАЯ. ОСОБЕННО КОГДА СОБСТВЕННАЯ ПРОМЫШЛЕННОСТЬ НАЧИНАЕТ
Dialogue: 0,0:04:58.93,0:05:01.81,Caption,,0,0,0,,ИСКАТЬ МЕСТО ПОДЕШЕВЛЕ. ХОТИТЕ НАСТОЯЩУЮ
Dialogue: 0,0:05:01.81,0:05:05.25,Caption,,0,0,0,,СТРАТЕГИЧЕСКУЮ НЕЗАВИСИМОСТЬ? ДЛЯ НАЧАЛА ПОПРОБУЙТЕ СДЕЛАТЬ ТАК,
Dialogue: 0,0:05:05.48,0:05:08.29,Caption,,0,0,0,,ЧТОБЫ ВАШ ГЛАВНЫЙ АВТОМОБИЛЬНЫЙ СИМВОЛ НЕ СМОТРЕЛ НА
Dialogue: 0,0:05:08.29,0:05:10.45,Caption,,0,0,0,,СОБСТВЕННУЮ СТРАНУ КАК НА СЛИШКОМ ДОРОГУЮ
Dialogue: 0,0:05:10.45,0:05:13.65,Caption,,0,0,0,,ПРОИЗВОДСТВЕННУЮ ПЛОЩАДКУ. И ВОТ ЗДЕСЬ СЛОВА ПУТИНА
Dialogue: 0,0:05:13.73,0:05:16.37,Caption,,0,0,0,,УЖЕ ЗВУЧАТ СОВСЕМ ИНАЧЕ. ОН ГОВОРИТ ВЫ ОТКАЗАЛИСЬ
Dialogue: 0,0:05:16.45,0:05:19.41,Caption,,0,0,0,,ОТ РОССИЙСКОГО РЫНКА, ОТКАЗАЛИСЬ ОТ ПРЕЖНИХ СВЯЗЕЙ,
Dialogue: 0,0:05:19.64,0:05:23.09,Caption,,0,0,0,,ВВЕЛИ ОГРАНИЧЕНИЯ, ПЫТАЛИСЬ НАКАЗАТЬ РОССИЙСКУЮ ЭКОНОМИКУ,
Dialogue: 0,0:05:23.33,0:05:26.05,Caption,,0,0,0,,А ТЕПЕРЬ ТЕРЯЕТЕ СОБСТВЕННЫЙ ПРОМЫШЛЕННЫЙ ПОТЕНЦИАЛ.
Dialogue: 0,0:05:26.43,0:05:29.09,Caption,,0,0,0,,КОНЕЧНО, MERCEDES НЕ ГОВОРИТ МЫ ВСЁ ЭТО ДЕЛАЕМ ИЗ
Dialogue: 0,0:05:29.09,0:05:31.57,Caption,,0,0,0,,ЗА САНКЦИЙ ПРОТИВ РОССИИ. ОН ГОВОРИТ О СВОИХ
Dialogue: 0,0:05:31.57,0:05:34.21,Caption,,0,0,0,,ИЗДЕРЖКАХ. НО ПУТИН ВЕДЬ ТОЖЕ ГОВОРИТ НЕ ПРО
Dialogue: 0,0:05:34.21,0:05:37.25,Caption,,0,0,0,,ОДИН ЗАВОД MERCEDES. ОН ГОВОРИТ ПРО ОБЩИЙ РЕЗУЛЬТАТ
Dialogue: 0,0:05:37.33,0:05:40.05,Caption,,0,0,0,,КУРСА. И ВОТ ОБЩИЙ РЕЗУЛЬТАТ УЖЕ ОЧЕНЬ ТРУДНО
Dialogue: 0,0:05:40.05,0:05:43.25,Caption,,0,0,0,,ОБСУЖДАТЬ ИСКЛЮЧИТЕЛЬНО ЛОЗУНГАМИ. ПОТОМУ ЧТО ЛОЗУНГ
Dialogue: 0,0:05:43.25,0:05:46.13,Caption,,0,0,0,,НЕ ПЛАТИТ ЗАРПЛАТУ. ЛОЗУНГ НЕ СНИЖАЕТ ЦЕНУ
Dialogue: 0,0:05:46.13,0:05:49.09,Caption,,0,0,0,,ПРОИЗВОДСТВЕННОГО ЧАСА. ЛОЗУНГ НЕ ДЕЛАЕТ НЕМЕЦКИЙ
Dialogue: 0,0:05:49.17,0:05:52.13,Caption,,0,0,0,,ЗАВОД КОНКУРЕНТОСПОСОБНЕЕ. МОЖНО ЕЩЁ ДВАДЦАТЬ РАЗ
Dialogue: 0,0:05:52.21,0:05:56.69,Caption,,0,0,0,,ВЫЙТИ К МИКРОФОНУ И СКАЗАТЬ, ЧТО ЕВРОПА СИЛЬНА КАК НИКОГДА. MERCEDES ОТ ЭТОГО
Dialogue: 0,0:05:56.69,0:05:59.33,Caption,,0,0,0,,ДЕШЕВЛЕ ПРОИЗВОДИТЬ В ГЕРМАНИИ НЕ СТАНЕТ. КСТАТИ,
Dialogue: 0,0:05:59.65,0:06:03.41,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ, КОГДА ЗА ГРОМКИМИ ПОЛИТИЧЕСКИМИ СЛОВАМИ МЫ СМОТРИМ,
Dialogue: 0,0:06:03.65,0:06:06.05,Caption,,0,0,0,,КТО В ИТОГЕ ДОСТАЁТ КОШЕЛЁК, ПОДПИШИТЕСЬ.
Dialogue: 0,0:06:08.34,0:06:10.74,Caption,,0,0,0,,ПОТОМУ ЧТО ДАЛЬШЕ КОШЕЛЁК УЖЕ БУДЕТ НЕ ЕДИНСТВЕННОЙ
Dialogue: 0,0:06:10.74,0:06:13.38,Caption,,0,0,0,,ПРОБЛЕМОЙ. ПОКА НЕМЕЦКАЯ ПРОМЫШЛЕННОСТЬ СЧИТАЕТ
Dialogue: 0,0:06:13.38,0:06:16.34,Caption,,0,0,0,,ДЕНЬГИ, ВО ФРАНЦИИ РЕШИЛИ ПОСЧИТАТЬ КОЕ ЧТО ДРУГОЕ.
Dialogue: 0,0:06:16.61,0:06:19.94,Caption,,0,0,0,,ПОЛНОМОЧИЯ БРЮССЕЛЯ. МАРИН ЛЕ ПЕН И ЕЁ ПОЛИТИЧЕСКИЕ
Dialogue: 0,0:06:19.94,0:06:22.74,Caption,,0,0,0,,СОЮЗНИКИ ПРЕДЛАГАЮТ ЛИКВИДИРОВАТЬ ИЛИ ОЧЕНЬ СЕРЬЁЗНО
Dialogue: 0,0:06:22.74,0:06:25.46,Caption,,0,0,0,,СОКРАТИТЬ ЕВРОПЕЙСКУЮ ДИПЛОМАТИЧЕСКУЮ СЛУЖБУ,
Dialogue: 0,0:06:25.67,0:06:28.82,Caption,,0,0,0,,КОТОРУЮ ВОЗГЛАВЛЯЕТ КАЯ КАЛЛАС. ВОТ ЭТО УЖЕ ГОРАЗДО
Dialogue: 0,0:06:28.82,0:06:32.50,Caption,,0,0,0,,ИНТЕРЕСНЕЕ, ЧЕМ ОЧЕРЕДНАЯ ПЕРЕПАЛКА ДВУХ ПОЛИТИКОВ. ПОТОМУ ЧТО
Dialogue: 0,0:06:32.50,0:06:34.90,Caption,,0,0,0,,УБРАТЬ КАЛЛАС И ПОСТАВИТЬ ВМЕСТО НЕЁ ДРУГОГО
Dialogue: 0,0:06:34.90,0:06:39.54,Caption,,0,0,0,,ЧЕЛОВЕКА, ЭТО ОДНО. СЕГОДНЯ КАЛЛАС. ЗАВТРА УСЛОВНЫЙ ЖАН,
Dialogue: 0,0:06:39.62,0:06:42.58,Caption,,0,0,0,,ФРАНЦ ИЛИ ХАНС. ТАБЛИЧКУ НА ДВЕРИ ПОМЕНЯЛИ,
Dialogue: 0,0:06:42.81,0:06:45.78,Caption,,0,0,0,,АППАРАТ ОСТАЛСЯ. А ЗДЕСЬ ВОПРОС ДРУГОЙ. А САМ
Dialogue: 0,0:06:45.86,0:06:50.02,Caption,,0,0,0,,АППАРАТ ВАМ ЗАЧЕМ? СОВЕТНИК РУКОВОДСТВА НАЦИОНАЛЬНОГО ОБЪЕДИНЕНИЯ ШАРЛЬ
Dialogue: 0,0:06:50.10,0:06:53.78,Caption,,0,0,0,,АНРИ ГАЛЛУА ГОВОРИТ, ЧТО ПОЛЬЗА ОТ КАЛЛАС ОЧЕНЬ ОГРАНИЧЕНА,
Dialogue: 0,0:06:54.02,0:06:56.50,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКАЯ ДИПЛОМАТИЯ ДУБЛИРУЕТ РАБОТУ
Dialogue: 0,0:06:56.50,0:06:59.06,Caption,,0,0,0,,НАЦИОНАЛЬНЫХ ГОСУДАРСТВ И ЧТО ЕЁ ЛЕГИТИМНОСТЬ,
Dialogue: 0,0:06:59.30,0:07:02.26,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, НЕ ПРИЗНАЮТ НИ СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:07:02.34,0:07:06.26,Caption,,0,0,0,,НИ КИТАЙ. И ВОТ ТУТ БРЮССЕЛЬСКАЯ ИСТОРИЯ СТАНОВИТСЯ СОВСЕМ
Dialogue: 0,0:07:06.34,0:07:09.38,Caption,,0,0,0,,ВЕСЁЛОЙ. ПОТОМУ ЧТО ГОДАМИ ЕВРОПЕЙСКАЯ МАШИНА РОСЛА
Dialogue: 0,0:07:09.38,0:07:12.10,Caption,,0,0,0,,ПРИМЕРНО ПО ОДНОМУ ПРИНЦИПУ. ЕСТЬ ПРОБЛЕМА?
Dialogue: 0,0:07:12.17,0:07:14.98,Caption,,0,0,0,,СОЗДАДИМ СТРУКТУРУ. СТРУКТУРА НЕ СПРАВЛЯЕТСЯ?
Dialogue: 0,0:07:14.98,0:07:17.78,Caption,,0,0,0,,СОЗДАДИМ НАД НЕЙ ЕЩЁ ОДНУ СТРУКТУРУ. ЕСТЬ
Dialogue: 0,0:07:17.78,0:07:19.86,Caption,,0,0,0,,НАЦИОНАЛЬНЫЕ МИНИСТЕРСТВА ИНОСТРАННЫХ ДЕЛ?
Dialogue: 0,0:07:19.96,0:07:25.03,Caption,,0,0,0,,ОТЛИЧНО. ЗНАЧИТ НУЖЕН ЕЩЁ ЕВРОПЕЙСКИЙ ДИПЛОМАТИЧЕСКИЙ
Dialogue: 0,0:07:25.03,0:07:28.79,Caption,,0,0,0,,АППАРАТ. ЕСТЬ МИНИСТРЫ? НУЖЕН ВЕРХОВНЫЙ ПРЕДСТАВИТЕЛЬ. ЕСТЬ ВЕРХОВНЫЙ
Dialogue: 0,0:07:28.79,0:07:30.79,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЬ? НУЖНЫ КАБИНЕТЫ,
Dialogue: 0,0:07:30.87,0:07:33.67,Caption,,0,0,0,,СОВЕТНИКИ, ПОМОЩНИКИ, ДЕЛЕГАЦИИ,
Dialogue: 0,0:07:33.84,0:07:37.51,Caption,,0,0,0,,ДЕПАРТАМЕНТЫ, УПРАВЛЕНИЯ И ОБЯЗАТЕЛЬНО ЧЕЛОВЕК,
Dialogue: 0,0:07:37.74,0:07:40.15,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ КООРДИНИРОВАТЬ РАБОТУ ЛЮДЕЙ,
Dialogue: 0,0:07:40.31,0:07:43.59,Caption,,0,0,0,,КОТОРЫЕ КООРДИНИРУЮТ ОСТАЛЬНЫХ. КРАСОТА. А ТЕПЕРЬ ЛЕ
Dialogue: 0,0:07:43.67,0:07:47.99,Caption,,0,0,0,,ПЕН ГОВОРИТ РЕБЯТА, ДАВАЙТЕ ВНЕШНЮЮ ПОЛИТИКУ ОБРАТНО ГОСУДАРСТВАМ. И ТУТ
Dialogue: 0,0:07:47.99,0:07:51.03,Caption,,0,0,0,,ВОЗНИКАЕТ ОЧЕНЬ НЕХОРОШИЙ ВОПРОС. ЕСЛИ ГОСУДАРСТВА
Dialogue: 0,0:07:51.03,0:07:53.11,Caption,,0,0,0,,САМИ БУДУТ ВЕСТИ ВНЕШНЮЮ ПОЛИТИКУ,
Dialogue: 0,0:07:53.43,0:07:55.27,Caption,,0,0,0,,ТОГДА ЗАЧЕМ НУЖНА ВСЯ ЭТА НАДСТРОЙКА?
Dialogue: 0,0:07:55.52,0:07:58.87,Caption,,0,0,0,,ВОТ СИДИТ ОГРОМНАЯ МАШИНА. КАБИНЕТЫ ЕСТЬ. ЗАРПЛАТЫ
Dialogue: 0,0:07:58.87,0:08:02.47,Caption,,0,0,0,,ЕСТЬ. КОМАНДИРОВКИ ЕСТЬ. СОВЕЩАНИЯ ЕСТЬ. ПЕРЕВОДЧИКИ
Dialogue: 0,0:08:02.47,0:08:05.83,Caption,,0,0,0,,ЕСТЬ. ПРЕСС СЛУЖБА ЕСТЬ. КОФЕМАШИНА НАВЕРНЯКА ТОЖЕ
Dialogue: 0,0:08:05.83,0:08:08.55,Caption,,0,0,0,,ЕСТЬ. А ПОЛНОМОЧИЯ ЗАБРАЛИ. ЧТО ДЕЛАТЬ БУДЕМ?
Dialogue: 0,0:08:08.71,0:08:11.19,Caption,,0,0,0,,МОЖНО СОЗДАТЬ РАБОЧУЮ ГРУППУ ПО ВОПРОСУ О ТОМ,
Dialogue: 0,0:08:11.43,0:08:14.31,Caption,,0,0,0,,ПОЧЕМУ У РАБОЧЕЙ ГРУППЫ БОЛЬШЕ НЕТ РАБОТЫ. ПОТОМ
Dialogue: 0,0:08:14.31,0:08:17.11,Caption,,0,0,0,,ПРОВЕСТИ КОНФЕРЕНЦИЮ. ПОТОМ ВЫПУСТИТЬ ДОКУМЕНТ НА
Dialogue: 0,0:08:17.11,0:08:20.23,Caption,,0,0,0,,ЧЕТЫРЕСТА СТРАНИЦ. НАЗВАТЬ ЕГО "СТРАТЕГИЧЕСКОЕ
Dialogue: 0,0:08:20.31,0:08:22.87,Caption,,0,0,0,,ВИДЕНИЕ БУДУЩЕГО ЕВРОПЕЙСКОЙ ДИПЛОМАТИИ ПОСЛЕ
Dialogue: 0,0:08:22.87,0:08:25.59,Caption,,0,0,0,,ИСЧЕЗНОВЕНИЯ ЕВРОПЕЙСКОЙ ДИПЛОМАТИИ". В БРЮССЕЛЕ
Dialogue: 0,0:08:25.59,0:08:28.15,Caption,,0,0,0,,УМЕЮТ. ТОЛЬКО САМА ПРОБЛЕМА ОТ ЭТОГО НИКУДА НЕ
Dialogue: 0,0:08:28.15,0:08:30.23,Caption,,0,0,0,,ДЕНЕТСЯ. И ВЕДЬ РЕЧЬ УЖЕ ИДЁТ НЕ ТОЛЬКО
Dialogue: 0,0:08:30.31,0:08:33.19,Caption,,0,0,0,,О ФРАНЦИИ. ПОХОЖИЕ ИДЕИ ЕСТЬ У ПОЛИТИЧЕСКИХ СИЛ
Dialogue: 0,0:08:33.19,0:08:38.59,Caption,,0,0,0,,ГЕРМАНИИ И ПОЛЬШИ. ОНИ ТОЖЕ ГОВОРЯТ О ВОЗВРАЩЕНИИ ПОЛНОМОЧИЙ
Dialogue: 0,0:08:38.59,0:08:41.15,Caption,,0,0,0,,НАЦИОНАЛЬНЫМ ПРАВИТЕЛЬСТВАМ. А ЭТО УЖЕ СОВСЕМ ДРУГАЯ
Dialogue: 0,0:08:41.15,0:08:44.19,Caption,,0,0,0,,ИСТОРИЯ. ПОТОМУ ЧТО ЕВРОСОЮЗ ДЕРЖИТСЯ НЕ НА ФЛАГЕ
Dialogue: 0,0:08:44.19,0:08:47.55,Caption,,0,0,0,,СО ЗВЁЗДОЧКАМИ. И НЕ НА ЗДАНИИ ЕВРОКОМИССИИ. ОН
Dialogue: 0,0:08:47.55,0:08:51.39,Caption,,0,0,0,,ДЕРЖИТСЯ НА ТОМ, ЧТО ГОСУДАРСТВА СОГЛАСИЛИСЬ ЧАСТЬ СВОИХ ПОЛНОМОЧИЙ
Dialogue: 0,0:08:51.47,0:08:54.43,Caption,,0,0,0,,ОТДАТЬ НАВЕРХ. ВОТ ЭТО И ЕСТЬ ГЛАВНОЕ. ДЕНЬГИ.
Dialogue: 0,0:08:54.64,0:08:58.11,Caption,,0,0,0,,ПРАВИЛА. ТОРГОВЛЯ. РЕГУЛИРОВАНИЕ. ВНЕШНЯЯ ПОЛИТИКА.
Dialogue: 0,0:08:58.33,0:09:00.35,Caption,,0,0,0,,КАЖДЫЙ РАЗ ГОСУДАРСТВО ГОВОРИТ ХОРОШО,
Dialogue: 0,0:09:00.51,0:09:03.47,Caption,,0,0,0,,ВОТ ЭТОТ КУСОК ТЕПЕРЬ РЕШАЕМ ВМЕСТЕ. А ТЕПЕРЬ
Dialogue: 0,0:09:03.47,0:09:05.95,Caption,,0,0,0,,ПРОЦЕСС ПОШЁЛ В ОБРАТНУЮ СТОРОНУ. ЛЕ ПЕН УЖЕ
Dialogue: 0,0:09:05.95,0:09:09.39,Caption,,0,0,0,,ГОВОРИТ, С ЧЕГО НАЧАТЬ. ВЕРНИТЕ ВНЕШНЮЮ ПОЛИТИКУ СТОЛИЦАМ.
Dialogue: 0,0:09:09.56,0:09:12.51,Caption,,0,0,0,,ХОРОШО. ВЕРНУЛИ. А ПОТОМ КТО НИБУДЬ СКАЖЕТ РАЗ
Dialogue: 0,0:09:12.59,0:09:16.27,Caption,,0,0,0,,УЖ НАЧАЛИ, ДАВАЙТЕ ЕЩЁ ВОТ ЭТО ОБРАТНО. ПОТОМ СЛЕДУЮЩЕЕ. ПОТОМ
Dialogue: 0,0:09:16.35,0:09:18.91,Caption,,0,0,0,,ЕЩЁ КУСОЧЕК. И В КАКОЙ ТО МОМЕНТ ВОЗНИКАЕТ
Dialogue: 0,0:09:18.99,0:09:21.71,Caption,,0,0,0,,ВОПРОС УЖЕ НЕ О КАЕ КАЛЛАС. ВОПРОС СТАНОВИТСЯ
Dialogue: 0,0:09:21.79,0:09:24.35,Caption,,0,0,0,,ОЧЕНЬ ПРОСТЫМ. А ЗАЧЕМ ТОГДА ВООБЩЕ НУЖНА ЭТА
Dialogue: 0,0:09:24.35,0:09:26.43,Caption,,0,0,0,,МАХИНА? ЧТОБЫ ВЫПУСКАТЬ РЕКОМЕНДАЦИИ?
Dialogue: 0,0:09:26.83,0:09:30.67,Caption,,0,0,0,,ЧТОБЫ РАСПРЕДЕЛЯТЬ КАБИНЕТЫ? ЧТОБЫ ОБЪЯСНЯТЬ ДВАДЦАТИ СЕМИ ПРАВИТЕЛЬСТВАМ,
Dialogue: 0,0:09:30.83,0:09:32.91,Caption,,0,0,0,,ЧТО ОНИ ТЕПЕРЬ САМИ РЕШАЮТ ВОПРОСЫ,
Dialogue: 0,0:09:33.07,0:09:34.99,Caption,,0,0,0,,КОТОРЫЕ РАНЬШЕ БРЮССЕЛЬ РЕШАЛ ЗА НИХ?
Dialogue: 0,0:09:35.62,0:09:38.51,Caption,,0,0,0,,ВОТ ЗДЕСЬ ИНИЦИАТИВА ЛЕ ПЕН И СТАНОВИТСЯ НАСТОЯЩИМ
Dialogue: 0,0:09:38.59,0:09:42.99,Caption,,0,0,0,,ГВОЗДЁМ. НЕ ПОТОМУ, ЧТО ЗАВТРА УТРОМ ЕВРОСОЮЗ ИСЧЕЗНЕТ. А ПОТОМУ,
Dialogue: 0,0:09:43.17,0:09:45.87,Caption,,0,0,0,,ЧТО ОНА БЬЁТ НЕ ПО КОНКРЕТНОМУ ЧЕЛОВЕКУ. ОНА
Dialogue: 0,0:09:45.95,0:09:51.66,Caption,,0,0,0,,БЬЁТ ПО САМОМУ ПРИНЦИПУ. ЗАЧЕМ НАМ ОТДАВАТЬ ПОЛНОМОЧИЯ БРЮССЕЛЮ,
Dialogue: 0,0:09:51.92,0:09:54.46,Caption,,0,0,0,,ЕСЛИ НАЦИОНАЛЬНЫЕ ГОСУДАРСТВА СПОСОБНЫ ЗАНИМАТЬСЯ
Dialogue: 0,0:09:54.46,0:09:57.74,Caption,,0,0,0,,ЭТИМ САМИ? ДЛЯ БЮРОКРАТИЧЕСКОЙ СИСТЕМЫ ВОПРОС ПОЧТИ
Dialogue: 0,0:09:57.74,0:10:00.78,Caption,,0,0,0,,НЕПРИЛИЧНЫЙ. ПОТОМУ ЧТО ЛЮБОЙ АППАРАТ ОЧЕНЬ ЛЮБИТ
Dialogue: 0,0:10:00.78,0:10:04.38,Caption,,0,0,0,,ОБСУЖДАТЬ, КАКИЕ НОВЫЕ ФУНКЦИИ ЕМУ НУЖНЫ. И ОЧЕНЬ НЕ
Dialogue: 0,0:10:04.38,0:10:08.22,Caption,,0,0,0,,ЛЮБИТ ОБСУЖДАТЬ, КАКИЕ СТАРЫЕ ФУНКЦИИ У НЕГО МОЖНО ЗАБРАТЬ. А
Dialogue: 0,0:10:08.22,0:10:11.26,Caption,,0,0,0,,ЛЕ ПЕН ИМЕННО ЭТО И ПРЕДЛАГАЕТ. ПРИЧЁМ РЯДОМ
Dialogue: 0,0:10:11.30,0:10:13.98,Caption,,0,0,0,,ТУТ ЖЕ ПОЯВЛЯЕТСЯ УКРАИНА. ОНА ТРЕБУЕТ МИРНОЙ
Dialogue: 0,0:10:13.98,0:10:17.74,Caption,,0,0,0,,КОНФЕРЕНЦИИ И ГОВОРИТ, ЧТО У ЕВРОПЫ БОЛЬШЕ НЕТ ДЕНЕГ ДЛЯ КИЕВА.
Dialogue: 0,0:10:18.05,0:10:21.17,Caption,,0,0,0,,И ВОТ ДВЕ ТЕМЫ ВНЕЗАПНО ОКАЗЫВАЮТСЯ РЯДОМ. ДЕНЬГИ
Dialogue: 0,0:10:21.18,0:10:23.74,Caption,,0,0,0,,И ПОЛНОМОЧИЯ. КТО ПРИНИМАЕТ РЕШЕНИЕ?
Dialogue: 0,0:10:23.98,0:10:27.74,Caption,,0,0,0,,КТО ОПЛАЧИВАЕТ ЭТО РЕШЕНИЕ? И КТО ПОТОМ ОБЪЯСНЯЕТ ИЗБИРАТЕЛЮ,
Dialogue: 0,0:10:27.99,0:10:30.38,Caption,,0,0,0,,ПОЧЕМУ ИМЕННО ОН ДОЛЖЕН ЗА НЕГО ПЛАТИТЬ?
Dialogue: 0,0:10:30.52,0:10:34.86,Caption,,0,0,0,,ПОКА ВСЁ ХОРОШО, ОТВЕТ ПРОСТОЙ. РЕШЕНИЕ ЕВРОПЕЙСКОЕ. ЦЕННОСТИ
Dialogue: 0,0:10:34.86,0:10:38.54,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ. ПОЛИТИКА ЕВРОПЕЙСКАЯ. А КОГДА ПРИХОДИТ
Dialogue: 0,0:10:38.62,0:10:42.78,Caption,,0,0,0,,СЧЁТ, ВЫЯСНЯЕТСЯ, ЧТО НАЛОГИ ПОЧЕМУ ТО НАЦИОНАЛЬНЫЕ. ЗАВОДЫ
Dialogue: 0,0:10:42.85,0:10:46.29,Caption,,0,0,0,,НАЦИОНАЛЬНЫЕ. РАБОЧИЕ МЕСТА НАЦИОНАЛЬНЫЕ. ВЫБОРЫ
Dialogue: 0,0:10:46.29,0:10:49.26,Caption,,0,0,0,,ТОЖЕ НАЦИОНАЛЬНЫЕ. И ВОТ ТУТ ВСЯ КРАСОТА ОБЩЕЙ
Dialogue: 0,0:10:49.26,0:10:52.05,Caption,,0,0,0,,КОНСТРУКЦИИ НАЧИНАЕТ СЛЕГКА СКРИПЕТЬ. ПОТОМУ ЧТО
Dialogue: 0,0:10:52.05,0:10:54.54,Caption,,0,0,0,,НЕМЕЦКОМУ РАБОЧЕМУ ДОВОЛЬНО ТРУДНО ОБЪЯСНИТЬ
Dialogue: 0,0:10:54.54,0:10:56.94,Caption,,0,0,0,,ПРЕИМУЩЕСТВА БОЛЬШОЙ ЕВРОПЕЙСКОЙ СТРАТЕГИИ,
Dialogue: 0,0:10:57.25,0:10:59.10,Caption,,0,0,0,,ЕСЛИ MERCEDES В ЭТО ВРЕМЯ ДУМАЕТ,
Dialogue: 0,0:10:59.41,0:11:01.98,Caption,,0,0,0,,КАКИЕ НЕМЕЦКИЕ ПРЕДПРИЯТИЯ ЕМУ СЛИШКОМ ДОРОГО
Dialogue: 0,0:11:01.98,0:11:07.36,Caption,,0,0,0,,СОДЕРЖАТЬ. ФРАНЦУЗСКОМУ НАЛОГОПЛАТЕЛЬЩИКУ ТРУДНО БЕСКОНЕЧНО
Dialogue: 0,0:11:07.36,0:11:10.08,Caption,,0,0,0,,РАССКАЗЫВАТЬ ПРО ВЕЛИКИЕ ГЕОПОЛИТИЧЕСКИЕ ЗАДАЧИ,
Dialogue: 0,0:11:10.40,0:11:12.96,Caption,,0,0,0,,ЕСЛИ ЕГО СОБСТВЕННЫЕ ПОЛИТИКИ НАЧИНАЮТ СПРАШИВАТЬ,
Dialogue: 0,0:11:13.12,0:11:15.12,Caption,,0,0,0,,ЗАЧЕМ ФРАНЦИИ ОПЛАЧИВАТЬ АППАРАТ,
Dialogue: 0,0:11:15.36,0:11:18.16,Caption,,0,0,0,,КОТОРЫЙ ДУБЛИРУЕТ ФРАНЦУЗСКУЮ ДИПЛОМАТИЮ. А
Dialogue: 0,0:11:18.16,0:11:21.68,Caption,,0,0,0,,ПОЛЬСКОМУ, НЕМЕЦКОМУ ИЛИ ФРАНЦУЗСКОМУ ИЗБИРАТЕЛЮ В КАКОЙ ТО
Dialogue: 0,0:11:21.76,0:11:23.52,Caption,,0,0,0,,МОМЕНТ СТАНОВИТСЯ ИНТЕРЕСНО НЕ ТО,
Dialogue: 0,0:11:23.76,0:11:26.72,Caption,,0,0,0,,КАК КРАСИВО НАЗЫВАЕТСЯ ОЧЕРЕДНАЯ ПРОГРАММА. ЕМУ
Dialogue: 0,0:11:26.80,0:11:31.12,Caption,,0,0,0,,СТАНОВИТСЯ ИНТЕРЕСНО, СКОЛЬКО ОНА СТОИТ. ВОТ ЗДЕСЬ И ВОЗВРАЩАЕТСЯ НАША
Dialogue: 0,0:11:31.12,0:11:33.84,Caption,,0,0,0,,ГОГОЛЕВСКАЯ ВДОВА. ПОТОМУ ЧТО ИСТОРИЯ ПОЛУЧИЛАСЬ
Dialogue: 0,0:11:33.84,0:11:35.92,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ. ХОТЕЛИ ПОКАЗАТЬ,
Dialogue: 0,0:11:36.03,0:11:38.64,Caption,,0,0,0,,ЧТО РОССИЯ БЕЗ ЕВРОПЫ НЕ СМОЖЕТ. РОССИЯ
Dialogue: 0,0:11:38.64,0:11:41.20,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ПОЛУЧИЛА ОГРОМНОЕ КОЛИЧЕСТВО ПРОБЛЕМ,
Dialogue: 0,0:11:41.44,0:11:44.08,Caption,,0,0,0,,ПЕРЕСТРАИВАЛА ТОРГОВЛЮ, РАСЧЁТЫ,
Dialogue: 0,0:11:44.16,0:11:48.24,Caption,,0,0,0,,ЛОГИСТИКУ, ИСКАЛА НОВЫЕ РЫНКИ. НО ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ПУТИН
Dialogue: 0,0:11:48.24,0:11:50.64,Caption,,0,0,0,,ВЫХОДИТ НА ПЛОЩАДКУ АТЭС УЖЕ В КИТАЕ И
Dialogue: 0,0:11:50.64,0:11:52.80,Caption,,0,0,0,,ГОВОРИТ АЗИАТСКИМ ПАРТНЁРАМ СМОТРИТЕ,
Dialogue: 0,0:11:52.88,0:11:55.12,Caption,,0,0,0,,МЫ ВЫДЕРЖАЛИ. А В ЭТО САМОЕ ВРЕМЯ В
Dialogue: 0,0:11:55.12,0:11:57.76,Caption,,0,0,0,,ЕВРОПЕ MERCEDES СЧИТАЕТ СТОИМОСТЬ ПРОИЗВОДСТВА,
Dialogue: 0,0:11:58.00,0:12:00.80,Caption,,0,0,0,,НАЦИОНАЛЬНЫЕ ПОЛИТИКИ СЧИТАЮТ ПОЛНОМОЧИЯ БРЮССЕЛЯ,
Dialogue: 0,0:12:01.12,0:12:03.52,Caption,,0,0,0,,А НАЛОГОПЛАТЕЛЬЩИКИ ВСЁ ЧАЩЕ СЧИТАЮТ ДЕНЬГИ.
Dialogue: 0,0:12:03.87,0:12:06.16,Caption,,0,0,0,,КРАСИВО. ОСОБЕННО ЕСЛИ ВСПОМНИТЬ,
Dialogue: 0,0:12:06.31,0:12:11.12,Caption,,0,0,0,,КАК ВСЁ НАЧИНАЛОСЬ. ХОТЕЛИ, ЧТОБЫ РАСПЛАТА ПРИШЛА В МОСКВУ. А ТЕПЕРЬ РАЗГОВОР
Dialogue: 0,0:12:11.20,0:12:13.28,Caption,,0,0,0,,О РАСПЛАТЕ ВСЁ ЧАЩЕ ИДЁТ В БЕРЛИНЕ,
Dialogue: 0,0:12:13.36,0:12:16.72,Caption,,0,0,0,,ПАРИЖЕ И БРЮССЕЛЕ. И САМОЕ НЕПРИЯТНОЕ ЗДЕСЬ ДАЖЕ
Dialogue: 0,0:12:16.80,0:12:19.04,Caption,,0,0,0,,НЕ MERCEDES. ЗАВОД МОЖНО ПЕРЕСТРОИТЬ.
Dialogue: 0,0:12:21.32,0:12:24.28,Caption,,0,0,0,,ИНВЕСТИЦИОННЫЙ ПЛАН МОЖНО ИЗМЕНИТЬ. ИЗДЕРЖКИ МОЖНО
Dialogue: 0,0:12:24.28,0:12:28.60,Caption,,0,0,0,,ПОПЫТАТЬСЯ СОКРАТИТЬ. ГОРАЗДО ИНТЕРЕСНЕЕ ДРУГОЕ. КОГДА ЭКОНОМИЧЕСКИЕ
Dialogue: 0,0:12:28.60,0:12:30.76,Caption,,0,0,0,,ПРОБЛЕМЫ НАЧИНАЮТ ПРЕВРАЩАТЬСЯ В ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:12:30.76,0:12:34.36,Caption,,0,0,0,,ВОПРОС, НАЗАД ВСЁ СОБИРАЕТСЯ НАМНОГО СЛОЖНЕЕ. ПОТОМУ ЧТО
Dialogue: 0,0:12:34.36,0:12:36.76,Caption,,0,0,0,,ВОПРОС УЖЕ ЗВУЧИТ НЕ ТАК ХОРОША ИЛИ ПЛОХА
Dialogue: 0,0:12:36.84,0:12:38.44,Caption,,0,0,0,,КОНКРЕТНАЯ ЕВРОПЕЙСКАЯ ПОЛИТИКА?
Dialogue: 0,0:12:38.76,0:12:41.64,Caption,,0,0,0,,ВОПРОС ЗВУЧИТ ИНАЧЕ. КТО ВООБЩЕ ПОЛУЧИЛ ПРАВО ЭТУ
Dialogue: 0,0:12:41.72,0:12:45.64,Caption,,0,0,0,,ПОЛИТИКУ ОПРЕДЕЛЯТЬ? И ЕСЛИ НАЦИОНАЛЬНЫЕ СТОЛИЦЫ НАЧНУТ ОТВЕЧАТЬ МЫ ХОТИМ
Dialogue: 0,0:12:45.72,0:12:49.48,Caption,,0,0,0,,ЭТО ПРАВО ОБРАТНО, ТОГДА БРЮССЕЛЮ ПРИДЁТСЯ ОБЪЯСНЯТЬ УЖЕ НЕ РОССИЮ,
Dialogue: 0,0:12:49.65,0:12:52.68,Caption,,0,0,0,,НЕ ПУТИНА И НЕ ОЧЕРЕДНОЙ ПАКЕТ САНКЦИЙ. ПРИДЁТСЯ
Dialogue: 0,0:12:52.76,0:12:56.20,Caption,,0,0,0,,ОБЪЯСНЯТЬ САМОГО СЕБЯ. ЗАЧЕМ ОН НУЖЕН. ЧТО ИМЕННО
Dialogue: 0,0:12:56.28,0:12:58.92,Caption,,0,0,0,,ОН ДЕЛАЕТ. ПОЧЕМУ ЭТО НЕЛЬЗЯ ДЕЛАТЬ В ПАРИЖЕ,
Dialogue: 0,0:12:59.00,0:13:02.04,Caption,,0,0,0,,БЕРЛИНЕ ИЛИ ВАРШАВЕ. И ПОЧЕМУ ЗА ЭТУ ОГРОМНУЮ
Dialogue: 0,0:13:02.04,0:13:04.92,Caption,,0,0,0,,КОНСТРУКЦИЮ ВСЁ ЕЩЁ НАДО ПЛАТИТЬ. ВОТ ЭТО ДЛЯ
Dialogue: 0,0:13:04.92,0:13:07.72,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЮРОКРАТИИ ДЕЙСТВИТЕЛЬНО ПЛОХАЯ НОВОСТЬ.
Dialogue: 0,0:13:07.98,0:13:10.76,Caption,,0,0,0,,ПОТОМУ ЧТО БУМЕРАНГ ИНОГДА ВОЗВРАЩАЕТСЯ НЕ ТУДА,
Dialogue: 0,0:13:10.89,0:13:13.72,Caption,,0,0,0,,КУДА ЦЕЛИЛИСЬ. А ИНОГДА ВОЗВРАЩАЕТСЯ ПРЯМО В РУКУ
Dialogue: 0,0:13:13.72,0:13:17.40,Caption,,0,0,0,,ЧЕЛОВЕКУ, КОТОРЫЙ ЕГО БРОСИЛ. И ТОГДА УЖЕ ОЧЕНЬ ТРУДНО
Dialogue: 0,0:13:17.40,0:13:19.72,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО ТАК ВСЁ И БЫЛО ЗАДУМАНО.
