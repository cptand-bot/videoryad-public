Dialogue: 0,0:00:00.12,0:00:02.12,Caption,,0,0,0,,КОГДА ЧЕЛОВЕК НАСТУПАЕТ НА ОДНИ И ТЕ ЖЕ
Dialogue: 0,0:00:02.12,0:00:05.48,Caption,,0,0,0,,ГРАБЛИ, ЭТО ЕЩЁ МОЖНО СПИСАТЬ НА НЕВЕЗЕНИЕ. НО КОГДА
Dialogue: 0,0:00:05.56,0:00:10.12,Caption,,0,0,0,,ОН ДОСТАЁТ СТАРЫЕ ГРАБЛИ, ТЩАТЕЛЬНО ПРОТИРАЕТ ИХ И СНОВА КЛАДЁТ ПЕРЕД СОБОЙ,
Dialogue: 0,0:00:10.48,0:00:13.64,Caption,,0,0,0,,ТУТ УЖЕ ВОЗНИКАЮТ ВОПРОСЫ. ТЕМ БОЛЕЕ ЧТО ПРЕДЫДУЩИЙ
Dialogue: 0,0:00:13.64,0:00:18.84,Caption,,0,0,0,,ОПЫТ БЫЛ, МЯГКО ГОВОРЯ, НЕЗАБЫВАЕМЫМ. ОДНАКО ЗЕЛЕНСКИЙ СНОВА ДЕМОНСТРИРУЕТ
Dialogue: 0,0:00:18.84,0:00:21.40,Caption,,0,0,0,,УДИВИТЕЛЬНУЮ УВЕРЕННОСТЬ В СЕБЕ. ВИДИМО,
Dialogue: 0,0:00:21.49,0:00:24.84,Caption,,0,0,0,,СЧИТАЕТ, ЧТО НА ЭТОТ РАЗ ВСЁ ПОЙДЁТ ИНАЧЕ. А
Dialogue: 0,0:00:24.92,0:00:27.16,Caption,,0,0,0,,С ЧЕГО, СОБСТВЕННО, ОН ЭТО ВЗЯЛ?
Dialogue: 0,0:00:27.72,0:00:29.96,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНА ИМЕННО ТАКАЯ ПОЛИТИКА,
Dialogue: 0,0:00:30.20,0:00:31.88,Caption,,0,0,0,,ГДЕ ВАЖНЫ НЕ ТОЛЬКО ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:31.97,0:00:36.52,Caption,,0,0,0,,НО И ТО, ЧТО СТОИТ ЗА НИМИ, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:36.76,0:00:39.24,Caption,,0,0,0,,КОГДА ОДНА КОЛКОСТЬ МОЖЕТ ОКАЗАТЬСЯ ИНТЕРЕСНЕЕ
Dialogue: 0,0:00:39.24,0:00:42.04,Caption,,0,0,0,,ДЕСЯТКА ОФИЦИАЛЬНЫХ ПРЕСС РЕЛИЗОВ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:00:42.04,0:00:45.16,Caption,,0,0,0,,ВЫСТУПАЕТ В ПАРЛАМЕНТЕ ДАНИИ И СНОВА ЦЕПЛЯЕТ ТРАМПА
Dialogue: 0,0:00:45.24,0:00:47.48,Caption,,0,0,0,,ЧЕРЕЗ ТЕМУ ГРЕНЛАНДИИ. ИРОНИЧНО,
Dialogue: 0,0:00:47.64,0:00:51.24,Caption,,0,0,0,,С УЛЫБКОЙ, ПЕРЕД ЕВРОПЕЙСКОЙ АУДИТОРИЕЙ. ВРОДЕ БЫ МЕЛОЧЬ.
Dialogue: 0,0:00:51.40,0:00:54.20,Caption,,0,0,0,,ПОЛИТИКИ ДРУГ ДРУГА ПОДКАЛЫВАЮТ ПОСТОЯННО. ТОЛЬКО
Dialogue: 0,0:00:54.28,0:00:56.52,Caption,,0,0,0,,ЕСТЬ ОДНА ПРОБЛЕМА ТРАМП СЕЙЧАС НЕ ВЕДУЩИЙ
Dialogue: 0,0:00:56.52,0:01:00.36,Caption,,0,0,0,,ЮМОРИСТИЧЕСКОГО ШОУ, КОТОРОМУ МОЖНО БРОСИТЬ РЕПЛИКУ ИЗ ЗАЛА И ЗАБЫТЬ.
Dialogue: 0,0:01:00.60,0:01:04.28,Caption,,0,0,0,,ЭТО ПРЕЗИДЕНТ США, ОТ РЕШЕНИЙ КОТОРОГО ДЛЯ КИЕВА ЗАВИСИТ СЛИШКОМ
Dialogue: 0,0:01:04.28,0:01:06.60,Caption,,0,0,0,,МНОГОЕ. А ЗЕЛЕНСКИЙ ВЕДЁТ СЕБЯ ТАК,
Dialogue: 0,0:01:06.79,0:01:09.24,Caption,,0,0,0,,БУДТО ПЕРЕД НИМ СОСЕД ПО ЛЕСТНИЧНОЙ ПЛОЩАДКЕ,
Dialogue: 0,0:01:09.48,0:01:11.48,Caption,,0,0,0,,С КОТОРЫМ МОЖНО ПОШУТИТЬ НАСЧЁТ ЗАБОРА.
Dialogue: 0,0:01:13.75,0:01:15.84,Caption,,0,0,0,,ПРИЧЁМ ШУТКА УЖЕ НЕ ПОТЕРЯЛАСЬ ГДЕ ТО МЕЖДУ
Dialogue: 0,0:01:15.84,0:01:19.04,Caption,,0,0,0,,КОПЕНГАГЕНОМ И ВАШИНГТОНОМ. РЕАКЦИЯ В США ПОЯВИЛАСЬ
Dialogue: 0,0:01:19.04,0:01:22.32,Caption,,0,0,0,,СРАЗУ. КОНГРЕССМЕН ГРЕГ СТЬЮБЕ ОТРЕАГИРОВАЛ ЖЁСТКО.
Dialogue: 0,0:01:22.64,0:01:26.00,Caption,,0,0,0,,А ДАЛЬШЕ ИСТОРИЯ СТАЛА ЕЩЁ ИНТЕРЕСНЕЕ. ЮРИЙ УШАКОВ
Dialogue: 0,0:01:26.00,0:01:29.20,Caption,,0,0,0,,РАССКАЗАЛ, ЧТО НА ВСТРЕЧЕ ПУТИНА С УИТКОФФОМ И КУШНЕРОМ
Dialogue: 0,0:01:29.29,0:01:32.32,Caption,,0,0,0,,ОБСУЖДАЛИ ЗЕЛЕНСКОГО И ЕГО "ПРИВЕТЫ" ТРАМПУ. ТО ЕСТЬ
Dialogue: 0,0:01:32.36,0:01:36.48,Caption,,0,0,0,,ПРИВЕТЫ ДОШЛИ. БОЛЕЕ ТОГО, ИХ УЖЕ ОБСУЖДАЮТ НА УРОВНЕ ЛЮДЕЙ,
Dialogue: 0,0:01:36.71,0:01:39.20,Caption,,0,0,0,,КОТОРЫЕ ПРЯМО СЕЙЧАС ТАСКАЮТ НА СТОЛ ВАРИАНТЫ
Dialogue: 0,0:01:39.20,0:01:42.48,Caption,,0,0,0,,ЗАВЕРШЕНИЯ КОНФЛИКТА. ВОТ ЗЕЛЕНСКИЙ ХОТЕЛ,
Dialogue: 0,0:01:42.64,0:01:45.60,Caption,,0,0,0,,ЧТОБЫ ЕГО УСЛЫШАЛИ. УСЛЫШАЛИ. ХОТЕЛ,
Dialogue: 0,0:01:45.68,0:01:48.80,Caption,,0,0,0,,ЧТОБЫ ЗАМЕТИЛИ. ЗАМЕТИЛИ. ТЕПЕРЬ ОСТАЁТСЯ САМЫЙ
Dialogue: 0,0:01:48.80,0:01:50.48,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС А ДАЛЬШЕ ЧТО?
Dialogue: 0,0:01:50.83,0:01:52.88,Caption,,0,0,0,,ПОТОМУ ЧТО ЭТА МАНЕРА У ЗЕЛЕНСКОГО НЕ ВЧЕРА
Dialogue: 0,0:01:52.88,0:01:55.20,Caption,,0,0,0,,ПОЯВИЛАСЬ. В ДВЕ ТЫСЯЧИ ДЕВЯТНАДЦАТОМ ОН УЖЕ
Dialogue: 0,0:01:55.20,0:01:58.32,Caption,,0,0,0,,РАЗГОВАРИВАЛ С ПУТИНЫМ ТАК, БУДТО ПЕРЕД НИМ ПОЛИТИК,
Dialogue: 0,0:01:58.48,0:02:00.80,Caption,,0,0,0,,КОТОРОГО ДОСТАТОЧНО ПЕРЕБИТЬ, ПОДКОЛОТЬ,
Dialogue: 0,0:02:00.97,0:02:03.20,Caption,,0,0,0,,ПУБЛИЧНО ПОСТАВИТЬ В НЕУДОБНОЕ ПОЛОЖЕНИЕ,
Dialogue: 0,0:02:03.44,0:02:05.60,Caption,,0,0,0,,И ДАЛЬШЕ МОЖНО ИДТИ ПО СВОИМ ДЕЛАМ. ВСЕ
Dialogue: 0,0:02:05.60,0:02:09.60,Caption,,0,0,0,,ПРЕКРАСНО ПОМНЯТ, ВО ЧТО ПОТОМ ПРЕВРАТИЛИСЬ ОТНОШЕНИЯ МОСКВЫ И КИЕВА.
Dialogue: 0,0:02:09.92,0:02:12.32,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ЗЕЛЕНСКИЙ ДОСТАЁТ ТЕ ЖЕ САМЫЕ
Dialogue: 0,0:02:12.32,0:02:15.68,Caption,,0,0,0,,ГРАБЛИ, ТОЛЬКО НА РУЧКЕ УЖЕ НАПИСАНО ДРУГОЕ ИМЯ ДОНАЛЬД
Dialogue: 0,0:02:15.76,0:02:20.08,Caption,,0,0,0,,ТРАМП. ХОЧЕТ ПОВТОРЕНИЯ? ОЧЕНЬ СТРАННЫЙ СПОСОБ ПРОВЕРЯТЬ СУДЬБУ НА ЧУВСТВО
Dialogue: 0,0:02:20.16,0:02:23.04,Caption,,0,0,0,,ЮМОРА. ТЕМ БОЛЕЕ ЧТО АМЕРИКАНЦЫ СЕЙЧАС ГОВОРЯТ УЖЕ
Dialogue: 0,0:02:23.12,0:02:29.07,Caption,,0,0,0,,НЕ ЯЗЫКОМ КОМПЛИМЕНТОВ. СТИВ УИТКОФФ ПОСЛЕ ВСТРЕЧИ С ПУТИНЫМ ЗАЯВИЛ,
Dialogue: 0,0:02:29.31,0:02:31.39,Caption,,0,0,0,,ЧТО ОНИ С КУШНЕРОМ ПОЕДУТ К ЗЕЛЕНСКОМУ И
Dialogue: 0,0:02:31.39,0:02:33.87,Caption,,0,0,0,,БУДУТ ЕГО УБЕЖДАТЬ ИДТИ ПО ОДНОМУ ИЗ ВЫБРАННЫХ
Dialogue: 0,0:02:33.95,0:02:37.15,Caption,,0,0,0,,ПУТЕЙ ЗАВЕРШЕНИЯ КОНФЛИКТА. НЕ ПРОСИТЬ ПОДУМАТЬ. НЕ
Dialogue: 0,0:02:37.15,0:02:40.67,Caption,,0,0,0,,ОБМЕНЯТЬСЯ МНЕНИЯМИ ЗА ЧАШКОЙ КОФЕ. УБЕЖДАТЬ. СЛОВО
Dialogue: 0,0:02:40.67,0:02:44.35,Caption,,0,0,0,,ПРОСТОЕ, ЧЕЛОВЕЧЕСКОЕ. И СРАЗУ ХОЧЕТСЯ СПРОСИТЬ ЧЕМ?
Dialogue: 0,0:02:44.62,0:02:47.23,Caption,,0,0,0,,"ВОЛОДЯ, НУ НЕ ДЕЛАЙ ТАК"? ЭТО,
Dialogue: 0,0:02:47.37,0:02:51.23,Caption,,0,0,0,,КОНЕЧНО, СТРАШНОЕ ОРУЖИЕ АМЕРИКАНСКОЙ ДИПЛОМАТИИ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:02:51.23,0:02:54.99,Caption,,0,0,0,,УСЛЫШИТ, УСТЫДИТСЯ И СРАЗУ ВСЁ ПОДПИШЕТ. НЕТ. ЕСЛИ
Dialogue: 0,0:02:54.99,0:02:57.31,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПЕРЕГОВОРЩИКИ ГОВОРЯТ ОБ УБЕЖДЕНИИ
Dialogue: 0,0:02:57.31,0:03:00.91,Caption,,0,0,0,,ПРЕЗИДЕНТА СТРАНЫ, КОТОРЫЙ УЖЕ МНОГО РАЗ ПУБЛИЧНО ПОКАЗЫВАЛ,
Dialogue: 0,0:03:01.15,0:03:05.95,Caption,,0,0,0,,ЧТО ОТСТУПАТЬ НЕ СОБИРАЕТСЯ, ЗНАЧИТ РАЗГОВОР ИДЁТ О РЫЧАГАХ. А РЫЧАГОВ ВОКРУГ
Dialogue: 0,0:03:06.03,0:03:10.59,Caption,,0,0,0,,КИЕВА НАКОПИЛОСЬ СТОЛЬКО, ЧТО ОТДЕЛЬНЫЙ СКЛАД АРЕНДОВАТЬ ПОРА. КОРРУПЦИОННЫЕ
Dialogue: 0,0:03:10.59,0:03:13.95,Caption,,0,0,0,,ИСТОРИИ НИКУДА НЕ ДЕЛИСЬ. НАБУ РАБОТАЕТ. ФАМИЛИЯ
Dialogue: 0,0:03:13.95,0:03:16.91,Caption,,0,0,0,,МИНДИЧА ДАВНО ГУЛЯЕТ ПО УКРАИНСКОЙ ПОЛИТИКЕ. СТАРЫЕ
Dialogue: 0,0:03:16.91,0:03:19.47,Caption,,0,0,0,,СКАНДАЛЫ МИНОБОРОНЫ ТОЖЕ НИКУДА НЕ ИСПАРИЛИСЬ,
Dialogue: 0,0:03:19.71,0:03:22.51,Caption,,0,0,0,,ВКЛЮЧАЯ ЗНАМЕНИТУЮ ИСТОРИЮ С ЗАКУПКАМИ И ТЕМИ САМЫМИ
Dialogue: 0,0:03:22.51,0:03:25.79,Caption,,0,0,0,,ЯЙЦАМИ, КОТОРЫЕ НЕСКОЛЬКО ЛЕТ НАЗАД ВДРУГ ПОЧУВСТВОВАЛИ СЕБЯ
Dialogue: 0,0:03:25.79,0:03:28.43,Caption,,0,0,0,,ЮВЕЛИРНЫМИ ИЗДЕЛИЯМИ. И ЭТО ТОЛЬКО ТО,
Dialogue: 0,0:03:28.51,0:03:31.47,Caption,,0,0,0,,ЧТО ЛЕЖИТ НА ПОВЕРХНОСТИ. ПОЭТОМУ ВОПРОС СЕЙЧАС НЕ
Dialogue: 0,0:03:31.47,0:03:34.35,Caption,,0,0,0,,В ЯЙЦАХ. ВОПРОС В КОЛИЧЕСТВЕ БОЛЕВЫХ ТОЧЕК,
Dialogue: 0,0:03:34.44,0:03:37.23,Caption,,0,0,0,,НА КОТОРЫЕ ПРИ ЖЕЛАНИИ МОЖНО НАЖАТЬ. ДОБАВЬТЕ СЮДА
Dialogue: 0,0:03:37.23,0:03:39.31,Caption,,0,0,0,,ВОЕННУЮ И ТЕХНОЛОГИЧЕСКУЮ ЗАВИСИМОСТЬ.
Dialogue: 0,0:03:41.59,0:03:44.23,Caption,,0,0,0,,УКРАИНА СООБЩИЛА О НОВЫХ ОГРАНИЧЕНИЯХ СКОРОСТИ
Dialogue: 0,0:03:44.31,0:03:46.87,Caption,,0,0,0,,STARSHIELD ВДОЛЬ ЛИНИИ ФРОНТА И НА КОНТРОЛИРУЕМЫХ
Dialogue: 0,0:03:46.87,0:03:49.91,Caption,,0,0,0,,РОССИЕЙ ТЕРРИТОРИЯХ. ЗЕЛЕНСКИЙ ПУБЛИЧНО ЗАЯВИЛ,
Dialogue: 0,0:03:50.17,0:03:52.79,Caption,,0,0,0,,ЧТО ЭТИ ОГРАНИЧЕНИЯ МЕШАЮТ РАБОТЕ УКРАИНСКИХ
Dialogue: 0,0:03:52.79,0:03:55.27,Caption,,0,0,0,,ПЕРЕХВАТЧИКОВ. САМ ПО СЕБЕ ЭТОТ ЭПИЗОД УЖЕ
Dialogue: 0,0:03:55.27,0:03:57.43,Caption,,0,0,0,,ПОКАЗЫВАЕТ ПРОСТУЮ ВЕЩЬ ЕСТЬ СИСТЕМЫ,
Dialogue: 0,0:03:57.75,0:04:01.35,Caption,,0,0,0,,БЕЗ КОТОРЫХ КИЕВУ ТЯЖЕЛО, А КНОПКА ОТ НИХ НАХОДИТСЯ НЕ В КИЕВЕ.
Dialogue: 0,0:04:01.67,0:04:04.79,Caption,,0,0,0,,ВОТ ВАМ И ВСЯ ФИЛОСОФИЯ ПЕРЕГОВОРОВ. ОДИН ЧЕЛОВЕК
Dialogue: 0,0:04:04.79,0:04:07.91,Caption,,0,0,0,,ПУБЛИЧНО ПОКАЗЫВАЕТ ХАРАКТЕР. ДРУГИЕ ЛЮДИ ДЕРЖАТ В
Dialogue: 0,0:04:07.91,0:04:10.79,Caption,,0,0,0,,РУКАХ ВПОЛНЕ КОНКРЕТНЫЕ ИНСТРУМЕНТЫ. И ВСЁ РАВНО
Dialogue: 0,0:04:10.79,0:04:14.07,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ВЕДЁТ СЕБЯ УВЕРЕННО. ДАЖЕ БОРЗО. ОТКУДА
Dialogue: 0,0:04:14.07,0:04:17.59,Caption,,0,0,0,,ТАКАЯ УВЕРЕННОСТЬ? ЗДЕСЬ У НЕГО ДЕЙСТВИТЕЛЬНО ПОЯВИЛСЯ ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:04:17.67,0:04:20.39,Caption,,0,0,0,,ПОВОД РАСПРАВИТЬ ПЛЕЧИ. НА ПРОМЕЖУТОЧНЫХ ВЫБОРАХ
Dialogue: 0,0:04:20.39,0:04:22.39,Caption,,0,0,0,,ДЕМОКРАТЫ ПОЛУЧИЛИ БОЛЬШИНСТВО И В ПАЛАТЕ
Dialogue: 0,0:04:22.39,0:04:26.39,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЕЙ, И В СЕНАТЕ. НОВЫЙ СОСТАВ КОНГРЕССА НАЧНЁТ РАБОТУ
Dialogue: 0,0:04:26.47,0:04:29.19,Caption,,0,0,0,,В ЯНВАРЕ. ДЛЯ ЗЕЛЕНСКОГО ЭТО ОЧЕНЬ СОБЛАЗНИТЕЛЬНАЯ
Dialogue: 0,0:04:29.19,0:04:32.87,Caption,,0,0,0,,КАРТИНКА ТРАМП ДАВИТ, А ЗА СПИНОЙ УЖЕ СОБИРАЕТСЯ ДЕМОКРАТИЧЕСКИЙ
Dialogue: 0,0:04:32.87,0:04:36.79,Caption,,0,0,0,,ПРОТИВОВЕС. МОЖНО РЕШИТЬ, ЧТО СЕЙЧАС ДОСТАТОЧНО ДОТЯНУТЬ,
Dialogue: 0,0:04:36.88,0:04:41.27,Caption,,0,0,0,,УПЕРЕТЬСЯ, ДОЖДАТЬСЯ ЯНВАРЯ, А ТАМ ТРАМПУ СТАНЕТ ГОРАЗДО ВЕСЕЛЕЕ ВНУТРИ
Dialogue: 0,0:04:41.35,0:04:44.23,Caption,,0,0,0,,СОБСТВЕННОЙ СТРАНЫ. ЛОГИКА ПОНЯТНАЯ. ТОЛЬКО БЕЛЫЙ
Dialogue: 0,0:04:44.31,0:04:47.03,Caption,,0,0,0,,ДОМ НИКУДА НЕ ИСЧЕЗАЕТ. ПРЕЗИДЕНТСКИЕ ПОЛНОМОЧИЯ
Dialogue: 0,0:04:47.03,0:04:49.83,Caption,,0,0,0,,ТОЖЕ. ПЕРЕГОВОРЩИКИ ТРАМПА НИКУДА НЕ ИСЧЕЗАЮТ.
Dialogue: 0,0:04:52.04,0:04:56.04,Caption,,0,0,0,,И САМОЕ ГЛАВНОЕ, САМА УКРАИНСКАЯ ТЕМА УЖЕ ДВИГАЕТСЯ НЕ ТОЛЬКО ЧЕРЕЗ
Dialogue: 0,0:04:56.04,0:04:58.60,Caption,,0,0,0,,ЗЕЛЕНСКОГО. ВОТ ЗДЕСЬ НАЧИНАЕТСЯ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:58.60,0:05:01.88,Caption,,0,0,0,,ИНТЕРЕСНАЯ ЧАСТЬ. ПОКА ЗЕЛЕНСКИЙ ПУБЛИЧНО ПОКАЗЫВАЕТ
Dialogue: 0,0:05:01.88,0:05:05.16,Caption,,0,0,0,,ХАРАКТЕР, В ВАШИНГТОНЕ ОЧЕНЬ АККУРАТНО ПОДСВЕЧИВАЮТ СОВСЕМ
Dialogue: 0,0:05:05.16,0:05:08.68,Caption,,0,0,0,,ДРУГОГО ЧЕЛОВЕКА. ДМИТРИЙ ЛУБИНЕЦ. НЕ ЗАЛУЖНЫЙ. НЕ
Dialogue: 0,0:05:08.68,0:05:11.56,Caption,,0,0,0,,БУДАНОВ. НЕ АРАХАМИЯ. НЕ ГЕНЕРАЛ,
Dialogue: 0,0:05:11.72,0:05:14.92,Caption,,0,0,0,,НЕ РАЗВЕДЧИК, НЕ ПАРТИЙНЫЙ ТЯЖЕЛОВЕС И НЕ ЧЕЛОВЕК,
Dialogue: 0,0:05:15.01,0:05:17.16,Caption,,0,0,0,,КОТОРЫЙ КАЖДЫЙ ВЕЧЕР ОБЪЯСНЯЕТ СТРАНЕ,
Dialogue: 0,0:05:17.32,0:05:21.24,Caption,,0,0,0,,КАК ОНА ДОЛЖНА ЖИТЬ. ОМБУДСМЕН. ГУМАНИТАРНАЯ РАБОТА.
Dialogue: 0,0:05:21.39,0:05:25.40,Caption,,0,0,0,,ПЛЕННЫЕ. ДЕТИ. ПРАВА ЧЕЛОВЕКА. ВОЗВРАЩЕНИЕ ЛЮДЕЙ.
Dialogue: 0,0:05:25.55,0:05:28.20,Caption,,0,0,0,,МИЛОСЕРДИЕ. ЕСЛИ СОВСЕМ ПО ПРОСТОМУ,
Dialogue: 0,0:05:28.36,0:05:30.60,Caption,,0,0,0,,В УКРАИНСКОЙ ПОЛИТИЧЕСКОЙ ДЕКОРАЦИИ ОН ВЫГЛЯДИТ
Dialogue: 0,0:05:30.60,0:05:34.52,Caption,,0,0,0,,ПОЧТИ КАК ДОБРЫЙ БАТЮШКА, КОТОРОГО КАКИМ ТО ОБРАЗОМ ЗАНЕСЛО НА ПАРТИЙНЫЙ
Dialogue: 0,0:05:34.52,0:05:37.48,Caption,,0,0,0,,СЪЕЗД. ИЛИ КАК МОНАХ, КОТОРЫЙ ХОДИЛ ПОМОГАТЬ ЛЮДЯМ,
Dialogue: 0,0:05:37.72,0:05:39.80,Caption,,0,0,0,,А ПОТОМ ВНЕЗАПНО ОКАЗАЛСЯ РЯДОМ С ТЕМИ,
Dialogue: 0,0:05:40.04,0:05:42.84,Caption,,0,0,0,,КТО РЕШАЕТ СУДЬБУ ГОСУДАРСТВА. И ВОТ ИМЕННО ПОЭТОМУ
Dialogue: 0,0:05:42.84,0:05:47.08,Caption,,0,0,0,,ОН ТАК ИНТЕРЕСЕН. ПЯТОГО НОЯБРЯ МЕЛАНИЯ ТРАМП СОБРАЛА В БЕЛОМ ДОМЕ
Dialogue: 0,0:05:47.16,0:05:49.72,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЕЙ РОССИИ И УКРАИНЫ ПОСЛЕ ГУМАНИТАРНОЙ
Dialogue: 0,0:05:49.72,0:05:53.00,Caption,,0,0,0,,МИССИИ. СРЕДИ УКРАИНСКОЙ СТОРОНЫ БЫЛИ ДАВИД АРАХАМИЯ
Dialogue: 0,0:05:53.00,0:05:56.44,Caption,,0,0,0,,И ДМИТРИЙ ЛУБИНЕЦ. НО ПЕРВАЯ ЛЕДИ США ОТДЕЛЬНО
Dialogue: 0,0:05:56.44,0:05:59.16,Caption,,0,0,0,,ПОБЛАГОДАРИЛА ЛУБИНЦА ЗА ЕГО МУЖЕСТВО И СЕРДЦЕ,
Dialogue: 0,0:05:59.32,0:06:03.76,Caption,,0,0,0,,С КОТОРЫМ ОН СЛУЖИТ ЛЮДЯМ. ДЛЯ ПОЛИТИКА,
Dialogue: 0,0:06:03.89,0:06:06.00,Caption,,0,0,0,,КОТОРЫЙ ДО ЭТОГО НЕ БЫЛ МЕЖДУНАРОДНОЙ ЗВЕЗДОЙ
Dialogue: 0,0:06:06.08,0:06:09.68,Caption,,0,0,0,,ПЕРВОГО РЯДА, ЭТО ОЧЕНЬ ЗАМЕТНАЯ ПОДСВЕТКА. ЕГО БУКВАЛЬНО
Dialogue: 0,0:06:09.68,0:06:12.32,Caption,,0,0,0,,ВЫТАСКИВАЮТ ИЗ ПРИВЫЧНОГО УКРАИНСКОГО ВНУТРЕННЕГО
Dialogue: 0,0:06:12.32,0:06:15.52,Caption,,0,0,0,,КАДРА И СТАВЯТ В СОВЕРШЕННО ДРУГУЮ РАМКУ. НЕ
Dialogue: 0,0:06:15.60,0:06:20.24,Caption,,0,0,0,,ЧЕЛОВЕК ВОЙНЫ. НЕ ЛИЦО ПРЕЖНЕЙ ПОЛИТИЧЕСКОЙ ДРАКИ. НЕ СИМВОЛ АРМИИ.
Dialogue: 0,0:06:20.54,0:06:23.52,Caption,,0,0,0,,НЕ СИМВОЛ РАЗВЕДКИ. НЕ ГОВОРЯЩАЯ ГОЛОВА ПАРТИИ
Dialogue: 0,0:06:23.60,0:06:27.28,Caption,,0,0,0,,ВЛАСТИ. ГУМАНИТАРНЫЙ ЧЕЛОВЕК. И ВОТ ТУТ ЛУБИНЕЦ
Dialogue: 0,0:06:27.28,0:06:29.84,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ НАМНОГО ИНТЕРЕСНЕЕ ВСЕХ ОЧЕВИДНЫХ
Dialogue: 0,0:06:29.84,0:06:32.80,Caption,,0,0,0,,ФАМИЛИЙ. ЗАЛУЖНЫЙ ВСЁ РАВНО СВЯЗАН С АРМИЕЙ И
Dialogue: 0,0:06:32.88,0:06:35.68,Caption,,0,0,0,,ВСЕЙ ИСТОРИЕЙ ПОСЛЕДНИХ ЛЕТ. БУДАНОВ СВЯЗАН СО
Dialogue: 0,0:06:35.68,0:06:38.80,Caption,,0,0,0,,СПЕЦСЛУЖБАМИ И ВОЕННОЙ ЛОГИКОЙ. АРАХАМИЯ ВООБЩЕ
Dialogue: 0,0:06:38.80,0:06:41.36,Caption,,0,0,0,,ВСТРОЕН В НЫНЕШНЮЮ ПОЛИТИЧЕСКУЮ СИСТЕМУ ПО САМЫЕ
Dialogue: 0,0:06:41.36,0:06:46.56,Caption,,0,0,0,,УШИ. КАК НИ ПЕРЕОДЕВАЙ, ВСЁ РАВНО УЗНАВАЕМАЯ КОМПАНИЯ. А ЛУБИНЦА ОТДЕЛИТЬ ОТ
Dialogue: 0,0:06:46.56,0:06:49.12,Caption,,0,0,0,,ЭТОЙ КОНСТРУКЦИИ ОЧЕНЬ ЛЕГКО. ОН НЕ НЕСЁТ НА
Dialogue: 0,0:06:49.20,0:06:52.08,Caption,,0,0,0,,СЕБЕ ТОГО ЖЕ ПОЛИТИЧЕСКОГО БАГАЖА. ЕГО ПУБЛИЧНЫЙ
Dialogue: 0,0:06:52.08,0:06:55.04,Caption,,0,0,0,,ОБРАЗ ВООБЩЕ ИЗ ДРУГОГО ОТДЕЛА. НЕ НАСТУПЛЕНИЕ,
Dialogue: 0,0:06:55.28,0:07:00.56,Caption,,0,0,0,,НЕ МОБИЛИЗАЦИЯ, НЕ РАКЕТЫ, НЕ ПАРТИЙНЫЕ РАЗБОРКИ. ЛЮДЕЙ ВЕРНУТЬ. ПЛЕННЫХ
Dialogue: 0,0:07:00.56,0:07:03.76,Caption,,0,0,0,,ОБМЕНЯТЬ. ДЕТЕЙ ЗАЩИТИТЬ. ГУМАНИТАРНЫЕ ВОПРОСЫ
Dialogue: 0,0:07:03.84,0:07:06.40,Caption,,0,0,0,,РЕШИТЬ. ДЛЯ ТАКОГО ПЕРЕХОДНОГО МОМЕНТА ЛУЧШЕЙ
Dialogue: 0,0:07:06.40,0:07:09.12,Caption,,0,0,0,,КАНДИДАТУРЫ НА ЭТУ РОЛЬ ПРОСТО НЕ НАЙТИ. И
Dialogue: 0,0:07:09.20,0:07:13.12,Caption,,0,0,0,,РЕЧЬ ВООБЩЕ НЕ О ТОМ, ЧТО ЛУБИНЕЦ ЗАВТРА СЯДЕТ НАПРОТИВ ПУТИНА И НАЧНЁТ
Dialogue: 0,0:07:13.20,0:07:15.68,Caption,,0,0,0,,ТОРГОВАТЬСЯ ЗА ТЕРРИТОРИИ. ДЛЯ ПЕРЕГОВОРОВ ЕСТЬ
Dialogue: 0,0:07:15.76,0:07:21.64,Caption,,0,0,0,,СОВСЕМ ДРУГИЕ ЛЮДИ. ЕГО РОЛЬ В ЭТОЙ КОНСТРУКЦИИ ДРУГАЯ. ОН НУЖЕН
Dialogue: 0,0:07:21.64,0:07:23.72,Caption,,0,0,0,,КАК ЛИЦО СМЕНЫ КУРСА. СМОТРИТЕ,
Dialogue: 0,0:07:24.05,0:07:25.72,Caption,,0,0,0,,БЫЛО ПОЛИТИЧЕСКОЕ РУКОВОДСТВО,
Dialogue: 0,0:07:25.92,0:07:28.28,Caption,,0,0,0,,КОТОРОЕ МОСКВА ГОДАМИ НАЗЫВАЛА ВРАЖДЕБНЫМ И
Dialogue: 0,0:07:28.28,0:07:31.40,Caption,,0,0,0,,СВЯЗЫВАЛА С АНТИРОССИЙСКИМ КУРСОМ УКРАИНЫ. ПОТОМ ЭТО
Dialogue: 0,0:07:31.48,0:07:33.96,Caption,,0,0,0,,РУКОВОДСТВО УХОДИТ. А ВМЕСТО НЕГО ПОЯВЛЯЕТСЯ
Dialogue: 0,0:07:33.96,0:07:36.92,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРОГО ОЧЕНЬ ТРУДНО ПРОДАТЬ ПУБЛИКЕ КАК
Dialogue: 0,0:07:36.92,0:07:39.96,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ ПРЕЖНЕЙ ВОЕННОЙ ЛИНИИ. ВОТ ВАМ И ГОТОВАЯ
Dialogue: 0,0:07:39.96,0:07:42.36,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ КАРТИНКА РУКОВОДСТВО ДРУГОЕ,
Dialogue: 0,0:07:42.52,0:07:47.72,Caption,,0,0,0,,РИТОРИКА ДРУГАЯ, ЛИЦО ДРУГОЕ, ГУМАНИТАРНАЯ ПОВЕСТКА ВМЕСТО БЕСКОНЕЧНОЙ ДРАКИ.
Dialogue: 0,0:07:48.20,0:07:50.84,Caption,,0,0,0,,МОСКВА ГОДАМИ ГОВОРИТ О "ДЕНАЦИФИКАЦИИ" И О
Dialogue: 0,0:07:50.84,0:07:53.64,Caption,,0,0,0,,НЕОБХОДИМОСТИ ИЗМЕНЕНИЯ САМОГО ПОЛИТИЧЕСКОГО КУРСА
Dialogue: 0,0:07:53.64,0:07:55.64,Caption,,0,0,0,,УКРАИНЫ. И ЕСЛИ НУЖЕН ЧЕЛОВЕК,
Dialogue: 0,0:07:55.80,0:07:57.48,Caption,,0,0,0,,НА КОТОРОМ МОЖНО ПОКАЗАТЬ СМОТРИТЕ,
Dialogue: 0,0:07:57.80,0:08:01.08,Caption,,0,0,0,,ПРЕЖНЯЯ СИСТЕМА ЗАКОНЧИЛАСЬ, ТЕПЕРЬ НАЧИНАЕТСЯ ДРУГАЯ,
Dialogue: 0,0:08:01.40,0:08:04.36,Caption,,0,0,0,,ЛУБИНЕЦ ДЛЯ ТАКОЙ РОЛИ ПОДХОДИТ ПОЧТИ ИДЕАЛЬНО. НЕ
Dialogue: 0,0:08:04.36,0:08:07.72,Caption,,0,0,0,,ВОЕННЫЙ. НЕ СИЛОВИК. НЕ ГЛАВНЫЙ ПАРТИЙНЫЙ ИГРОК.
Dialogue: 0,0:08:08.04,0:08:10.68,Caption,,0,0,0,,ЧЕЛОВЕК С ОБРАЗОМ МИЛОСЕРДНОГО ПОСРЕДНИКА. И
Dialogue: 0,0:08:10.68,0:08:15.32,Caption,,0,0,0,,ОСОБЕННО ИНТЕРЕСНО, ЧТО ЕГО НАЧИНАЮТ ЗАМЕТНО ПОДНИМАТЬ ИМЕННО СЕЙЧАС. НА
Dialogue: 0,0:08:15.40,0:08:20.44,Caption,,0,0,0,,БАНКОВОЙ УЖЕ, ПОХОЖЕ, РЕВНИВО СМОТРЯТ НА ЕГО МЕЖДУНАРОДНУЮ АКТИВНОСТЬ. В
Dialogue: 0,0:08:20.52,0:08:23.48,Caption,,0,0,0,,УКРАИНСКОМ ЭКСПЕРТНОМ ПОЛЕ ОБСУЖДАЮТ ЕГО КАК ФИГУРУ,
Dialogue: 0,0:08:23.65,0:08:26.92,Caption,,0,0,0,,КОТОРУЮ В ВАШИНГТОНЕ ПРИСМАТРИВАЮТ НА БУДУЩЕЕ. САМ
Dialogue: 0,0:08:27.00,0:08:29.16,Caption,,0,0,0,,ПО СЕБЕ ТАКОЙ РАЗГОВОР ЕЩЁ НЕДАВНО ЗВУЧАЛ БЫ
Dialogue: 0,0:08:29.16,0:08:33.99,Caption,,0,0,0,,СТРАННО. А СЕГОДНЯ ОН УЖЕ ЛОЖИТСЯ В ОБЩУЮ КАРТИНУ
Dialogue: 0,0:08:33.99,0:08:36.07,Caption,,0,0,0,,СЛИШКОМ АККУРАТНО. ПОДПИШИТЕСЬ,
Dialogue: 0,0:08:36.31,0:08:38.47,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ДАЛЬШЕ РАЗБИРАТЬ ТАКИЕ ВЕЩИ БЕЗ
Dialogue: 0,0:08:38.47,0:08:41.43,Caption,,0,0,0,,КИЛОМЕТРА ОФИЦИАЛЬНОЙ ШЕЛУХИ. ПОТОМУ ЧТО ОФИЦИАЛЬНО
Dialogue: 0,0:08:41.51,0:08:45.43,Caption,,0,0,0,,ВАМ ВСЕГДА РАССКАЖУТ, КТО КУДА ПРИЛЕТЕЛ. КУДА ИНТЕРЕСНЕЕ ПОНЯТЬ,
Dialogue: 0,0:08:45.67,0:08:48.31,Caption,,0,0,0,,ЗАЧЕМ ВНЕЗАПНО НАЧИНАЮТ ПОДНИМАТЬ ЧЕЛОВЕКА,
Dialogue: 0,0:08:48.63,0:08:50.71,Caption,,0,0,0,,КОТОРОГО ВЧЕРА БОЛЬШИНСТВО ЗРИТЕЛЕЙ ВООБЩЕ НЕ
Dialogue: 0,0:08:50.71,0:08:53.35,Caption,,0,0,0,,РАССМАТРИВАЛО КАК ПОЛИТИЧЕСКУЮ ФИГУРУ ПЕРВОГО РЯДА.
Dialogue: 0,0:08:53.51,0:08:56.07,Caption,,0,0,0,,И ТЕПЕРЬ ВЕРНЁМСЯ К ЗЕЛЕНСКОМУ. ОН ШУТИТ НАД
Dialogue: 0,0:08:56.07,0:08:58.87,Caption,,0,0,0,,ТРАМПОМ. ЕГО "ПРИВЕТЫ" УЖЕ ОБСУЖДАЮТСЯ В МОСКВЕ С
Dialogue: 0,0:08:58.95,0:09:00.87,Caption,,0,0,0,,ЛЮДЬМИ ТРАМПА. УИТКОФФ ГОВОРИТ,
Dialogue: 0,0:09:01.11,0:09:03.67,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКОГО БУДУТ УБЕЖДАТЬ. У ВАШИНГТОНА ЕСТЬ
Dialogue: 0,0:09:03.67,0:09:06.71,Caption,,0,0,0,,РЫЧАГИ. САМ ЗЕЛЕНСКИЙ, СУДЯ ПО ЕГО ПОВЕДЕНИЮ,
Dialogue: 0,0:09:06.95,0:09:09.27,Caption,,0,0,0,,РАССЧИТЫВАЕТ ВЫДЕРЖАТЬ ДАВЛЕНИЕ И ОПЕРЕТЬСЯ НА
Dialogue: 0,0:09:09.27,0:09:12.15,Caption,,0,0,0,,ДЕМОКРАТОВ ПОСЛЕ ИХ ПОБЕДЫ В КОНГРЕССЕ. А РЯДОМ
Dialogue: 0,0:09:12.15,0:09:15.35,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ДРУГОЙ ЧЕЛОВЕК. ТИХИЙ. ГУМАНИТАРНЫЙ.
Dialogue: 0,0:09:15.58,0:09:18.39,Caption,,0,0,0,,УДОБНЫЙ ДЛЯ СОВЕРШЕННО ДРУГОЙ ПОЛИТИЧЕСКОЙ КАРТИНКИ.
Dialogue: 0,0:09:19.03,0:09:21.27,Caption,,0,0,0,,ВОТ ЗДЕСЬ И ВОЗНИКАЕТ НЕПРИЯТНЫЙ ДЛЯ ЗЕЛЕНСКОГО
Dialogue: 0,0:09:21.27,0:09:26.07,Caption,,0,0,0,,ВОПРОС. ОН ТОЧНО УВЕРЕН, ЧТО ВО ВСЕЙ ЭТОЙ КОНСТРУКЦИИ НЕЗАМЕНИМ ИМЕННО ОН?
Dialogue: 0,0:09:26.58,0:09:29.43,Caption,,0,0,0,,ПОТОМУ ЧТО ПЕРЕГОВОРЫ МОГУТ ИДТИ МЕСЯЦАМИ. ТАМ БУДУТ
Dialogue: 0,0:09:29.43,0:09:32.23,Caption,,0,0,0,,ТЕРРИТОРИИ, ГАРАНТИИ, БЕЗОПАСНОСТЬ,
Dialogue: 0,0:09:32.31,0:09:37.99,Caption,,0,0,0,,САНКЦИИ, УСЛОВИЯ, ПОДПИСИ, ЕЩЁ ДЕСЯТЬ КРУГОВ СПОРОВ. НО ПОЛИТИЧЕСКУЮ СМЕНУ
Dialogue: 0,0:09:37.99,0:09:39.67,Caption,,0,0,0,,КУРСА ОДНОЙ БУМАГОЙ НЕ ПОКАЖЕШЬ.
Dialogue: 0,0:09:41.95,0:09:45.62,Caption,,0,0,0,,НУЖЕН ЧЕЛОВЕК, КОТОРЫЙ САМИМ СВОИМ ПОЯВЛЕНИЕМ БУДЕТ ОЗНАЧАТЬ
Dialogue: 0,0:09:45.69,0:09:49.86,Caption,,0,0,0,,ПРЕЖНЕЕ РУКОВОДСТВО УШЛО, ПРЕЖНИЙ АНТИРОССИЙСКИЙ КУРС ЗАКАНЧИВАЕТСЯ,
Dialogue: 0,0:09:50.18,0:09:53.54,Caption,,0,0,0,,НАЧИНАЕТСЯ ДРУГАЯ ПОЛИТИЧЕСКАЯ ЭПОХА. И ЛУБИНЕЦ ДЛЯ
Dialogue: 0,0:09:53.62,0:09:56.18,Caption,,0,0,0,,ТАКОЙ РОЛИ ПОДХОДИТ ИДЕАЛЬНО. И ТОГДА ИСТОРИЯ
Dialogue: 0,0:09:56.18,0:09:59.14,Caption,,0,0,0,,ПОЛУЧАЕТ СОВСЕМ ДРУГОЙ ФИНАЛ. ЗЕЛЕНСКИЙ СЕГОДНЯ
Dialogue: 0,0:09:59.22,0:10:02.74,Caption,,0,0,0,,ВЕДЁТ СЕБЯ ТАК, БУДТО ЕГО ГЛАВНАЯ ЗАДАЧА ПЕРЕЖДАТЬ ТРАМПА,
Dialogue: 0,0:10:02.97,0:10:05.78,Caption,,0,0,0,,ОТБИТЬСЯ ОТ ДАВЛЕНИЯ И СОХРАНИТЬ СОБСТВЕННУЮ ЛИНИЮ.
Dialogue: 0,0:10:05.99,0:10:10.10,Caption,,0,0,0,,НО ЕСЛИ ВАШИНГТОН РЕШИТ, ЧТО ЗЕЛЕНСКИЙ БОЛЬШЕ НЕ НУЖЕН И СМЕНУ ПОЛИТИЧЕСКОГО
Dialogue: 0,0:10:10.10,0:10:12.42,Caption,,0,0,0,,КУРСА УКРАИНЫ УДОБНЕЕ ПОКАЗАТЬ ЧЕРЕЗ ДРУГОГО
Dialogue: 0,0:10:12.42,0:10:15.95,Caption,,0,0,0,,ЧЕЛОВЕКА, ВСЯ ЭТА БРАВАДА НАЧИНАЕТ ВЫГЛЯДЕТЬ СОВСЕМ ИНАЧЕ.
Dialogue: 0,0:10:16.16,0:10:18.02,Caption,,0,0,0,,ПРИЧЁМ САМОЕ ЕХИДНОЕ ЗДЕСЬ ТО,
Dialogue: 0,0:10:18.31,0:10:21.14,Caption,,0,0,0,,ЧТО ИСКАТЬ КАКОГО ТО НОВОГО УКРАИНСКОГО НАПОЛЕОНА
Dialogue: 0,0:10:21.14,0:10:24.02,Caption,,0,0,0,,ВООБЩЕ НЕ ТРЕБУЕТСЯ. НЕ НУЖЕН ЕЩЁ ОДИН ГЕНЕРАЛ
Dialogue: 0,0:10:24.02,0:10:26.83,Caption,,0,0,0,,С КРАСИВЫМ ПОРТРЕТОМ. НЕ НУЖЕН РАЗВЕДЧИК С СУРОВЫМ
Dialogue: 0,0:10:26.83,0:10:29.22,Caption,,0,0,0,,ВЗГЛЯДОМ. НЕ НУЖЕН ПАРТИЙНЫЙ НАЧАЛЬНИК,
Dialogue: 0,0:10:29.40,0:10:34.50,Caption,,0,0,0,,КОТОРЫЙ ДЕСЯТЬ ЛЕТ ОБЪЯСНЯЕТ, ПОЧЕМУ ИМЕННО ОН ДОЛЖЕН БЫТЬ ГЛАВНЫМ. НУЖЕН ЧЕЛОВЕК,
Dialogue: 0,0:10:34.74,0:10:37.71,Caption,,0,0,0,,САМИМ СВОИМ ВИДОМ ПОКАЗЫВАЮЩИЙ ПРЕДЫДУЩАЯ ЭПОХА
Dialogue: 0,0:10:37.71,0:10:40.42,Caption,,0,0,0,,ЗАКОНЧИЛАСЬ. И ТАКОЙ ЧЕЛОВЕК УЖЕ СТОИТ В БЕЛОМ
Dialogue: 0,0:10:40.50,0:10:43.30,Caption,,0,0,0,,ДОМЕ РЯДОМ С МЕЛАНИЕЙ ТРАМП. ПОЭТОМУ ВОПРОС ТЕПЕРЬ
Dialogue: 0,0:10:43.38,0:10:47.07,Caption,,0,0,0,,НЕ ТОЛЬКО В ТОМ, ПРОСТИТ ЛИ ТРАМП ЗЕЛЕНСКОМУ ЕГО ПУБЛИЧНЫЕ КОЛКОСТИ.
Dialogue: 0,0:10:47.30,0:10:51.49,Caption,,0,0,0,,ВОПРОС ГОРАЗДО НЕПРИЯТНЕЕ. А ЧТО,
Dialogue: 0,0:10:51.81,0:10:54.61,Caption,,0,0,0,,ЕСЛИ ЗЕЛЕНСКИЙ ДЕЙСТВИТЕЛЬНО ДОИГРАЕТСЯ ДО МОМЕНТА,
Dialogue: 0,0:10:54.93,0:10:57.73,Caption,,0,0,0,,КОГДА ТО, ЧТО В КИЕВЕ НАЗОВУТ КАПИТУЛЯЦИЕЙ,
Dialogue: 0,0:10:57.97,0:10:59.81,Caption,,0,0,0,,ПОДПИШЕТ УЖЕ СОВСЕМ ДРУГОЙ ЧЕЛОВЕК?
