Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,ГРУЗОВОЕ СУДНО ИДЁТ В КАЛИНИНГРАД ЧЕРЕЗ НЕЙТРАЛЬНЫЕ
Dialogue: 0,0:00:02.92,0:00:06.12,Caption,,0,0,0,,ВОДЫ ФИНСКОГО ЗАЛИВА. ДО РОССИЙСКОЙ ГРАНИЦЫ ОСТАЁТСЯ
Dialogue: 0,0:00:06.12,0:00:09.32,Caption,,0,0,0,,НЕСКОЛЬКО МОРСКИХ МИЛЬ. И ТУТ В НЕГО ПРИЛЕТАЮТ
Dialogue: 0,0:00:09.32,0:00:12.28,Caption,,0,0,0,,ДВА БЕСПИЛОТНИКА. ФОРМАЛЬНО НИКАКОЙ БЛОКАДЫ НЕТ,
Dialogue: 0,0:00:12.52,0:00:16.52,Caption,,0,0,0,,МАРШРУТ ОТКРЫТ, МОРЕ СВОБОДНОЕ. ПРОСТО У ПЕРЕВОЗЧИКОВ ТЕПЕРЬ
Dialogue: 0,0:00:16.52,0:00:19.08,Caption,,0,0,0,,ПОЯВИЛСЯ НОВЫЙ ПУНКТ В РАСПИСАНИИ ПОГРУЗКА,
Dialogue: 0,0:00:19.24,0:00:21.72,Caption,,0,0,0,,ВЫХОД ИЗ ПОРТА, ПРОВЕРКА ДОКУМЕНТОВ,
Dialogue: 0,0:00:21.88,0:00:25.24,Caption,,0,0,0,,ВОЗМОЖНЫЙ УДАР С ВОЗДУХА. ЕСЛИ ВАМ НУЖНЫ РАЗБОРЫ,
Dialogue: 0,0:00:25.47,0:00:27.40,Caption,,0,0,0,,ГДЕ СМОТРЯТ НЕ НА ОТДЕЛЬНЫЙ ХЛОПОК,
Dialogue: 0,0:00:27.56,0:00:32.28,Caption,,0,0,0,,А НА ВСЮ ЦЕПОЧКУ, ПОДПИШИТЕСЬ. НА БАЛТИКЕ ЯВНО ОТКРЫВАЮТ НОВУЮ ГЛАВУ,
Dialogue: 0,0:00:32.36,0:00:37.56,Caption,,0,0,0,,И СПОКОЙНОЙ ОНА НЕ БУДЕТ. СУДНО ШЛО ИМЕННО В КАЛИНИНГРАД. ЕГО АТАКОВАЛИ НЕ
Dialogue: 0,0:00:37.64,0:00:40.44,Caption,,0,0,0,,У ПРИЧАЛА, НЕ В ЗАКРЫТОЙ ГАВАНИ И НЕ В ЗОНЕ
Dialogue: 0,0:00:40.52,0:00:43.16,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ. УДАР ПРОИЗОШЁЛ ТАМ,
Dialogue: 0,0:00:43.33,0:00:45.80,Caption,,0,0,0,,ГДЕ ТОРГОВОЕ СУДОХОДСТВО ВРОДЕ БЫ ДОЛЖНО ЖИТЬ ПО
Dialogue: 0,0:00:45.80,0:00:49.16,Caption,,0,0,0,,ОБЫЧНЫМ ПРАВИЛАМ. БАЛТИКА СТАЛА НОВОЙ ТОЧКОЙ
Dialogue: 0,0:00:49.16,0:00:51.48,Caption,,0,0,0,,ЭСКАЛАЦИИ. ДЛЯ ДАВЛЕНИЯ ВЫБРАЛИ МЕСТО,
Dialogue: 0,0:00:51.80,0:00:54.84,Caption,,0,0,0,,ГДЕ САМА КАРТА УЖЕ ДЕЛАЕТ ПОЛОВИНУ РАБОТЫ. ВЫШЕ
Dialogue: 0,0:00:54.84,0:00:58.36,Caption,,0,0,0,,НАХОДИТСЯ ФИНЛЯНДИЯ. НИЖЕ ЭСТОНИЯ. ОБЕ ВХОДЯТ В
Dialogue: 0,0:00:58.36,0:01:00.92,Caption,,0,0,0,,НАТО. МЕЖДУ НИМИ ПРОХОДИТ МОРСКОЙ ПУТЬ К
Dialogue: 0,0:01:00.92,0:01:03.56,Caption,,0,0,0,,КАЛИНИНГРАДСКОЙ ОБЛАСТИ. ПО НЕКОТОРЫМ ОЦЕНКАМ,
Dialogue: 0,0:01:03.73,0:01:06.52,Caption,,0,0,0,,ЧЕРЕЗ МОРЕ ТУДА ДОСТАВЛЯЮТ ОКОЛО ДВАДЦАТИ ДВУХ
Dialogue: 0,0:01:06.52,0:01:09.56,Caption,,0,0,0,,ПРОЦЕНТОВ ГРУЗОВ. НАЗЕМНОЕ СООБЩЕНИЕ ИДЁТ ЧЕРЕЗ
Dialogue: 0,0:01:09.56,0:01:12.52,Caption,,0,0,0,,ЛИТВУ. САМОЛЁТЫ ЛЕТАЮТ ПО УЗКОМУ БАЛТИЙСКОМУ
Dialogue: 0,0:01:12.52,0:01:16.71,Caption,,0,0,0,,КОРИДОРУ. ПОЛУЧАЕТСЯ НЕ РЕГИОН,
Dialogue: 0,0:01:16.97,0:01:21.03,Caption,,0,0,0,,А КВАРТИРА С ТРЕМЯ ВЫХОДАМИ, ВОЗЛЕ КАЖДОГО ИЗ КОТОРЫХ ВНЕЗАПНО НАЧАЛИ
Dialogue: 0,0:01:21.03,0:01:24.15,Caption,,0,0,0,,ПЕРЕСТАВЛЯТЬ ЗАМКИ. ОБЪЯВЛЯТЬ ОФИЦИАЛЬНУЮ БЛОКАДУ
Dialogue: 0,0:01:24.23,0:01:26.95,Caption,,0,0,0,,ПРИ ТАКОЙ ГЕОГРАФИИ СОВЕРШЕННО НЕОБЯЗАТЕЛЬНО. ЭТО
Dialogue: 0,0:01:26.95,0:01:29.11,Caption,,0,0,0,,СЛИШКОМ ЗАМЕТНО И ТРЕБУЕТ ХОТЯ БЫ КАКОЙ ТО
Dialogue: 0,0:01:29.11,0:01:32.07,Caption,,0,0,0,,ОТВЕТСТВЕННОСТИ. ГОРАЗДО УДОБНЕЕ СОЗДАВАТЬ ПОМЕХИ
Dialogue: 0,0:01:32.07,0:01:35.83,Caption,,0,0,0,,НЕБОЛЬШИМИ ПОРЦИЯМИ. СНАЧАЛА ПОСТРАДАЛО ОДНО СУДНО.
Dialogue: 0,0:01:36.31,0:01:39.35,Caption,,0,0,0,,ЗАТЕМ РИСКИ ПЕРЕСЧИТАЛ ВТОРОЙ ПЕРЕВОЗЧИК. ПОТОМ
Dialogue: 0,0:01:39.35,0:01:42.47,Caption,,0,0,0,,СТРАХОВАЯ КОМПАНИЯ ПОДНЯЛА ТАРИФ. СЛЕДОМ КАПИТАН
Dialogue: 0,0:01:42.47,0:01:45.67,Caption,,0,0,0,,ОТКАЗАЛСЯ ОТ РЕЙСА, ВЛАДЕЛЕЦ ПОТРЕБОВАЛ ОХРАНУ,
Dialogue: 0,0:01:45.91,0:01:49.03,Caption,,0,0,0,,А ГРУЗООТПРАВИТЕЛЬ ВЫБРАЛ ДРУГОЙ МАРШРУТ. НА БУМАГЕ
Dialogue: 0,0:01:49.03,0:01:52.07,Caption,,0,0,0,,ВСЁ ОТКРЫТО. НА ПРАКТИКЕ КАЖДЫЙ РЕЙС НАЧИНАЕТ
Dialogue: 0,0:01:52.07,0:01:54.87,Caption,,0,0,0,,НАПОМИНАТЬ ЛОТЕРЕЮ, ГДЕ БИЛЕТ ПОКУПАЕШЬ ТЫ,
Dialogue: 0,0:01:55.11,0:01:58.07,Caption,,0,0,0,,А БАРАБАН КРУТИТ НЕИЗВЕСТНЫЙ ДОБРОЖЕЛАТЕЛЬ. И ВСЕГДА
Dialogue: 0,0:01:58.15,0:02:00.47,Caption,,0,0,0,,МОЖНО СДЕЛАТЬ УДИВЛЁННОЕ ЛИЦО. МОЛ,
Dialogue: 0,0:02:00.56,0:02:03.19,Caption,,0,0,0,,МОРЕ БОЛЬШОЕ, АППАРАТЫ НЕОПОЗНАННЫЕ,
Dialogue: 0,0:02:03.41,0:02:06.39,Caption,,0,0,0,,МЫ ТОЖЕ ВОЗМУЩЕНЫ. ПОЧТИ СИЛЬНЕЕ ПОСТРАДАВШИХ.
Dialogue: 0,0:02:06.84,0:02:11.99,Caption,,0,0,0,,ФИНСКИЕ ВОЕННЫЕ СООБЩИЛИ, ЧТО НАБЛЮДАЛИ АТАКУ И ПЕРЕДАЛИ СВЕДЕНИЯ НАТО. РАЙОН
Dialogue: 0,0:02:11.99,0:02:14.71,Caption,,0,0,0,,НАХОДИЛСЯ ПОД КОНТРОЛЕМ. ПЕРЕД ПРОИСШЕСТВИЕМ ТАМ
Dialogue: 0,0:02:14.79,0:02:17.83,Caption,,0,0,0,,ЗАМЕЧАЛИ АКТИВНОСТЬ ЗАПАДНОЙ АВИАЦИИ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:02:17.91,0:02:21.35,Caption,,0,0,0,,РЕДКОЕ СОЧЕТАНИЕ. МОРЕ ВИДЕЛИ. ВОЗДУХ ВИДЕЛИ.
Dialogue: 0,0:02:21.51,0:02:24.71,Caption,,0,0,0,,ИНФОРМАЦИЮ ПОЛУЧИЛИ. ТОЛЬКО БЕСПИЛОТНИКИ ПОЧЕМУ ТО
Dialogue: 0,0:02:24.71,0:02:29.35,Caption,,0,0,0,,ЗАБЫЛИ ПРЕДУПРЕДИТЬ, ЧТО ИМ ЛЕТЕТЬ НЕЛЬЗЯ. ПРЕМЬЕР ФИНЛЯНДИИ ПЕТТЕРИ ОРПО
Dialogue: 0,0:02:29.35,0:02:32.71,Caption,,0,0,0,,ВСКОРЕ НАПОМНИЛ О ПРАВЕ УКРАИНЫ ДАВАТЬ ОТПОР РОССИИ.
Dialogue: 0,0:02:35.00,0:02:37.72,Caption,,0,0,0,,МОМЕНТ ДЛЯ ТАКОГО ЗАЯВЛЕНИЯ ВЫБРАН ПОЧТИ ЮВЕЛИРНО.
Dialogue: 0,0:02:37.94,0:02:40.68,Caption,,0,0,0,,РОССИЙСКОЕ СУДНО ПОЛУЧАЕТ УДАР В НЕЙТРАЛЬНЫХ ВОДАХ
Dialogue: 0,0:02:40.76,0:02:44.52,Caption,,0,0,0,,РЯДОМ С ФИНЛЯНДИЕЙ, А ПУБЛИКЕ СРАЗУ ОБЪЯСНЯЮТ ПРАВО КИЕВА НА
Dialogue: 0,0:02:44.52,0:02:48.60,Caption,,0,0,0,,САМООБОРОНУ. ВОПРОС О ТОМ, КТО ИМЕННО АТАКОВАЛ СУХОГРУЗ,
Dialogue: 0,0:02:48.84,0:02:51.08,Caption,,0,0,0,,ЕЩЁ НЕ УСПЕЛ УДОБНО УСТРОИТЬСЯ В КРЕСЛЕ,
Dialogue: 0,0:02:51.32,0:02:54.04,Caption,,0,0,0,,А ОТВЕТСТВЕННЫЙ КОММЕНТАРИЙ УЖЕ ПРИНЁС ЕМУ ПАЛЬТО И
Dialogue: 0,0:02:54.12,0:02:56.68,Caption,,0,0,0,,ПОПРОСИЛ НЕ ЗАДЕРЖИВАТЬСЯ. ДАЛЬШЕ ВСПОМНИЛИ,
Dialogue: 0,0:02:56.84,0:02:59.72,Caption,,0,0,0,,ЧТО СУДНО СВЯЗАНО С ОБОРОНЛОГИСТИКОЙ И НАХОДИТСЯ ПОД
Dialogue: 0,0:02:59.72,0:03:02.92,Caption,,0,0,0,,АМЕРИКАНСКИМИ САНКЦИЯМИ. НО САНКЦИИ НЕ ПРЕВРАЩАЮТ
Dialogue: 0,0:03:02.92,0:03:06.04,Caption,,0,0,0,,МОРСКОЙ ОБЪЕКТ В МИШЕНЬ. ИСТОРИЯ С ФИНЛЯНДИЕЙ ВАЖНА
Dialogue: 0,0:03:06.04,0:03:09.08,Caption,,0,0,0,,НЕ ПРИСУТСТВИЕМ ОТДЕЛЬНОГО САМОЛЁТА. СТРАНЫ НАТО
Dialogue: 0,0:03:09.08,0:03:13.96,Caption,,0,0,0,,СЛЕДЯТ ЗА ДВИЖЕНИЕМ КОРАБЛЕЙ, КОНТРОЛИРУЮТ ВОЗДУШНУЮ ОБСТАНОВКУ И РАСПОЛАГАЮТ
Dialogue: 0,0:03:13.96,0:03:16.92,Caption,,0,0,0,,ТЕХНИЧЕСКИМИ СРЕДСТВАМИ НАБЛЮДЕНИЯ. ЭТО НЕ ПУСТЫННЫЙ
Dialogue: 0,0:03:16.92,0:03:20.84,Caption,,0,0,0,,УЧАСТОК ОКЕАНА, ГДЕ НЕДЕЛЯМИ МОЖНО НЕ ВСТРЕТИТЬ НИ ОДНОГО СВИДЕТЕЛЯ.
Dialogue: 0,0:03:21.13,0:03:24.44,Caption,,0,0,0,,ЗНАЧИТ, ВОКРУГ КАЛИНИНГРАДА ПОЯВИЛСЯ НОВЫЙ ПОРЯДОК ВСЕ НА
Dialogue: 0,0:03:24.52,0:03:27.88,Caption,,0,0,0,,ВИДУ, НО МЕШАТЬ НЕ СПЕШИТ НИКТО. НО СУДНО МОГЛО
Dialogue: 0,0:03:27.88,0:03:30.52,Caption,,0,0,0,,БЫТЬ ТОЛЬКО ИНСТРУМЕНТОМ. НАСТОЯЩЕЙ ЦЕЛЬЮ ВПОЛНЕ
Dialogue: 0,0:03:30.52,0:03:33.72,Caption,,0,0,0,,МОГЛА СТАТЬ РЕАКЦИЯ РОССИИ. СМЫСЛ ПРОВЕРКИ ПРЕДЕЛЬНО
Dialogue: 0,0:03:33.72,0:03:35.72,Caption,,0,0,0,,ПРОСТОЙ ЧТО ПОСЛЕДУЕТ ПОСЛЕ УДАРА?
Dialogue: 0,0:03:35.94,0:03:37.64,Caption,,0,0,0,,МОСКВА УСИЛИТ ОХРАНУ МАРШРУТА?
Dialogue: 0,0:03:37.94,0:03:40.92,Caption,,0,0,0,,ОТПРАВИТ ВОЕННЫЕ КОРАБЛИ? ОТВЕТИТ В ДРУГОМ РАЙОНЕ?
Dialogue: 0,0:03:41.30,0:03:43.96,Caption,,0,0,0,,ОГРАНИЧИТСЯ ЗАЯВЛЕНИЯМИ? СДЕЛАЕТ ВИД,
Dialogue: 0,0:03:44.12,0:03:46.52,Caption,,0,0,0,,ЧТО ЭПИЗОД НЕ ЗАСЛУЖИВАЕТ ОТДЕЛЬНОГО ШАГА?
Dialogue: 0,0:03:48.80,0:03:53.60,Caption,,0,0,0,,ЛЮБОЙ ВАРИАНТ ПОЛЕЗЕН ТОМУ, КТО ИЗМЕРЯЕТ РОССИЙСКУЮ ГОТОВНОСТЬ. ОДИН АППАРАТ
Dialogue: 0,0:03:53.67,0:03:56.88,Caption,,0,0,0,,ПРОВЕРЯЕТ МАРШРУТ. ВТОРОЙ ПРОВЕРЯЕТ НЕРВЫ. А
Dialogue: 0,0:03:56.96,0:03:59.28,Caption,,0,0,0,,АНАЛИТИКИ ПОТОМ СПОКОЙНО ЗАНОСЯТ РЕЗУЛЬТАТ В
Dialogue: 0,0:03:59.36,0:04:02.24,Caption,,0,0,0,,ТАБЛИЦУ, ПОТОМУ ЧТО У НИХ, В ОТЛИЧИЕ ОТ СУХОГРУЗА,
Dialogue: 0,0:04:02.56,0:04:04.32,Caption,,0,0,0,,РАБОЧИЙ ДЕНЬ ПРОХОДИТ БЕЗ ПРОБОИН.
Dialogue: 0,0:04:04.90,0:04:10.64,Caption,,0,0,0,,ТАК ВЫЯСНЯЕТСЯ НЕ ЗАЯВЛЕННАЯ, А НАСТОЯЩАЯ ГРАНИЦА ДОПУСТИМОГО. КРАСНЫХ ЛИНИЙ МОЖНО
Dialogue: 0,0:04:10.72,0:04:13.60,Caption,,0,0,0,,НАРИСОВАТЬ СКОЛЬКО УГОДНО. ЦЕНА ПОЯВЛЯЕТСЯ ТОЛЬКО У
Dialogue: 0,0:04:13.68,0:04:17.44,Caption,,0,0,0,,ТОЙ ЛИНИИ, ПОСЛЕ ПЕРЕСЕЧЕНИЯ КОТОРОЙ ПРОТИВНИК ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:17.44,0:04:20.56,Caption,,0,0,0,,СТАЛКИВАЕТСЯ С ПОСЛЕДСТВИЯМИ. МОСКВА ОКАЗЫВАЕТСЯ В
Dialogue: 0,0:04:20.64,0:04:23.60,Caption,,0,0,0,,КРАЙНЕ НЕУДОБНОМ ПОЛОЖЕНИИ. ЕСЛИ ОТВЕТА НЕТ,
Dialogue: 0,0:04:23.91,0:04:26.64,Caption,,0,0,0,,СЛЕДУЮЩИЙ ЭПИЗОД ОРГАНИЗОВАТЬ ЛЕГЧЕ. ПЕРВЫЙ УДАР
Dialogue: 0,0:04:26.72,0:04:31.28,Caption,,0,0,0,,ТРЕБУЕТ РЕШИМОСТИ, ПОДГОТОВКИ И РИСКА. ВТОРОЙ УЖЕ ОПИРАЕТСЯ НА ОПЫТ.
Dialogue: 0,0:04:31.58,0:04:34.24,Caption,,0,0,0,,ПОСЛЕ ТРЕТЬЕГО НАЧИНАЕТСЯ ПРИВЫЧКА. СНАЧАЛА
Dialogue: 0,0:04:34.32,0:04:37.28,Caption,,0,0,0,,ПРОИСШЕСТВИЕ ВЫЗЫВАЕТ ТРЕВОГУ. ЗАТЕМ СТАНОВИТСЯ ЕЩЁ
Dialogue: 0,0:04:37.28,0:04:40.24,Caption,,0,0,0,,ОДНОЙ НОВОСТЬЮ. ПОТОМ КАПИТАНАМ ПРОСТО ВЫДАЮТ
Dialogue: 0,0:04:40.24,0:04:44.64,Caption,,0,0,0,,ОБНОВЛЁННУЮ ПАМЯТКУ, ГДЕ МЕЖДУ ПОГОДОЙ И ГЛУБИНОЙ ФАРВАТЕРА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:04:44.64,0:04:50.00,Caption,,0,0,0,,СТРОКА О ВЕРОЯТНОСТИ ПРИЛЁТА. НО СИЛЬНЫЙ ОТВЕТ ТОЖЕ МОЖЕТ ОКАЗАТЬСЯ ПОДАРКОМ ДЛЯ
Dialogue: 0,0:04:50.08,0:04:53.68,Caption,,0,0,0,,ТЕХ, КТО УСТРАИВАЕТ ЭТУ ПРОВЕРКУ. СТОИТ РОССИИ УДАРИТЬ ПО
Dialogue: 0,0:04:53.68,0:04:55.52,Caption,,0,0,0,,ОБЪЕКТУ НА ТЕРРИТОРИИ СТРАНЫ НАТО,
Dialogue: 0,0:04:55.91,0:04:58.56,Caption,,0,0,0,,И ПРЕДЫСТОРИЯ МГНОВЕННО ИСЧЕЗНЕТ ИЗ ЕВРОПЕЙСКОГО
Dialogue: 0,0:04:58.64,0:05:01.92,Caption,,0,0,0,,ЭФИРА. ОСТАНЕТСЯ УДОБНЫЙ ЗАГОЛОВОК МОСКВА НАПАЛА НА
Dialogue: 0,0:05:01.92,0:05:06.60,Caption,,0,0,0,,ЕВРОПУ. КТО СОЗДАВАЛ УГРОЗУ СУДОХОДСТВУ,
Dialogue: 0,0:05:06.80,0:05:09.08,Caption,,0,0,0,,КТО НАБЛЮДАЛ ЗА БЕСПИЛОТНИКАМИ И КТО ШАГ ЗА
Dialogue: 0,0:05:09.08,0:05:13.48,Caption,,0,0,0,,ШАГОМ ПОВЫШАЛ СТАВКИ, ОТПРАВЯТ МЕЛКИМ ШРИФТОМ В САМЫЙ ДАЛЬНИЙ УГОЛ.
Dialogue: 0,0:05:13.98,0:05:17.08,Caption,,0,0,0,,МЕХАНИКА СТАРАЯ. СНАЧАЛА ВАМ ЧАС НАСТУПАЮТ НА
Dialogue: 0,0:05:17.08,0:05:19.96,Caption,,0,0,0,,БОТИНОК. КОГДА ВЫ НАКОНЕЦ ОТДЁРГИВАЕТЕ НОГУ,
Dialogue: 0,0:05:20.20,0:05:22.92,Caption,,0,0,0,,ВАС ОБВИНЯЮТ В РЕЗКОМ ДВИЖЕНИИ И ТРЕБУЮТ СОБЛЮДАТЬ
Dialogue: 0,0:05:23.00,0:05:26.04,Caption,,0,0,0,,СПОКОЙСТВИЕ. ПОЭТОМУ РАЗГОВОР ДАВНО ВЫШЕЛ ЗА ПРЕДЕЛЫ
Dialogue: 0,0:05:26.04,0:05:28.84,Caption,,0,0,0,,ОДНОГО ПОВРЕЖДЁННОГО СУХОГРУЗА. ОПРЕДЕЛЁННЫМ
Dialogue: 0,0:05:28.84,0:05:31.40,Caption,,0,0,0,,ПОЛИТИЧЕСКИМ СИЛАМ В ЕВРОПЕ КАК РАЗ И НУЖЕН
Dialogue: 0,0:05:31.40,0:05:33.64,Caption,,0,0,0,,ОГРАНИЧЕННЫЙ РОССИЙСКИЙ УДАР ПО ЕВРОПЕЙСКОЙ
Dialogue: 0,0:05:33.64,0:05:37.96,Caption,,0,0,0,,ТЕРРИТОРИИ. НЕ ТОТ, ПОСЛЕ КОТОРОГО МИНИСТРЫ ЗАБЫВАЮТ ТЕКСТЫ ВЫСТУПЛЕНИЙ
Dialogue: 0,0:05:38.04,0:05:41.24,Caption,,0,0,0,,И НАЧИНАЮТ ИСКАТЬ БЛИЖАЙШЕЕ УБЕЖИЩЕ. НУЖЕН НЕБОЛЬШОЙ
Dialogue: 0,0:05:41.24,0:05:44.20,Caption,,0,0,0,,УЩЕРБ, ПОНЯТНАЯ КАРТИНКА И ОГРОМНЫЙ ШУМ.
Dialogue: 0,0:05:44.82,0:05:48.76,Caption,,0,0,0,,ВО ФРАНЦИИ, ГЕРМАНИИ И ИТАЛИИ У ВЛАСТЕЙ НАКОПИЛИСЬ ВНУТРЕННИЕ
Dialogue: 0,0:05:48.76,0:05:52.04,Caption,,0,0,0,,НЕПРИЯТНОСТИ. ЭКОНОМИКА БУКСУЕТ. РАСХОДЫ РАСТУТ.
Dialogue: 0,0:05:52.28,0:05:55.48,Caption,,0,0,0,,ПРАВЫЕ НАБИРАЮТ ПОДДЕРЖКУ. ИЗБИРАТЕЛИ ВСЁ ЧАЩЕ
Dialogue: 0,0:05:55.48,0:05:58.84,Caption,,0,0,0,,ИНТЕРЕСУЮТСЯ, ПОЧЕМУ ОБЕЩАНИЯ СТАНОВЯТСЯ СКРОМНЕЕ,
Dialogue: 0,0:05:59.00,0:06:02.60,Caption,,0,0,0,,А СЧЕТА ТОЛЩЕ. ВНЕШНИЙ УДАР СПОСОБЕН БЫСТРО ИЗМЕНИТЬ
Dialogue: 0,0:06:02.60,0:06:05.32,Caption,,0,0,0,,ТЕМУ РАЗГОВОРА. ВМЕСТО ВОПРОСОВ О ЦЕНАХ,
Dialogue: 0,0:06:05.60,0:06:08.60,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ И БЮДЖЕТАХ ГРАЖДАНАМ ПОКАЗЫВАЮТ НОВУЮ
Dialogue: 0,0:06:08.60,0:06:10.60,Caption,,0,0,0,,УГРОЗУ. ТЕПЕРЬ НАДО СПЛОТИТЬСЯ,
Dialogue: 0,0:06:10.78,0:06:13.56,Caption,,0,0,0,,УВЕЛИЧИТЬ ВОЕННЫЕ ТРАТЫ И ВРЕМЕННО ОТЛОЖИТЬ
Dialogue: 0,0:06:13.56,0:06:16.44,Caption,,0,0,0,,ПРЕТЕНЗИИ К СВОИМ ПРАВИТЕЛЬСТВАМ. СЛОВО ВРЕМЕННО В
Dialogue: 0,0:06:16.44,0:06:18.20,Caption,,0,0,0,,ТАКИХ СЛУЧАЯХ ОСОБЕННО ПРЕКРАСНО.
Dialogue: 0,0:06:20.49,0:06:22.73,Caption,,0,0,0,,ОНО ОБЫЧНО ЖИВЁТ ДОЛЬШЕ ТЕХ КАБИНЕТОВ,
Dialogue: 0,0:06:22.96,0:06:27.37,Caption,,0,0,0,,КОТОРЫЕ ЕГО ПРОИЗНОСЯТ. ОГРАНИЧЕННЫЙ ОТВЕТ ПОЗВОЛЯЕТ ПРЕДСТАВИТЬ ВЛАСТЬ
Dialogue: 0,0:06:27.44,0:06:31.77,Caption,,0,0,0,,ЗАЩИТНИКОМ ЕВРОПЫ. ДАЖЕ ЕСЛИ ПЕРЕД ЭТИМ ТА ЖЕ ВЛАСТЬ СТАРАТЕЛЬНО
Dialogue: 0,0:06:31.85,0:06:35.37,Caption,,0,0,0,,СОЗДАВАЛА УСЛОВИЯ, ПРИ КОТОРЫХ ОТВЕТ СТАНОВИЛСЯ ВСЁ ВЕРОЯТНЕЕ.
Dialogue: 0,0:06:35.92,0:06:38.89,Caption,,0,0,0,,БОЛЬШОЙ РОССИЙСКИЙ УДАР ДЛЯ ЭТОЙ СХЕМЫ УЖЕ ОПАСЕН.
Dialogue: 0,0:06:39.18,0:06:42.89,Caption,,0,0,0,,КОГДА ЛЮДИ ПОНИМАЮТ, ЧТО ИХ ПРАВИТЕЛЬСТВА ПРИБЛИЗИЛИ ПРЯМОЕ СТОЛКНОВЕНИЕ
Dialogue: 0,0:06:42.89,0:06:47.69,Caption,,0,0,0,,С ЯДЕРНОЙ ДЕРЖАВОЙ, РАЗГОВОР МЕНЯЕТСЯ. ВМЕСТО БОДРЫХ ПРИЗЫВОВ К ЕДИНСТВУ
Dialogue: 0,0:06:47.77,0:06:49.77,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ПРОСТОЙ ВОПРОС ВЫ НАС ВООБЩЕ КУДА
Dialogue: 0,0:06:49.77,0:06:53.45,Caption,,0,0,0,,ПРИВЕЛИ? ПОЭТОМУ УЧАСТНИКАМ НУЖНА ОЧЕНЬ ТОЧНАЯ МЕРА.
Dialogue: 0,0:06:54.09,0:06:56.73,Caption,,0,0,0,,РОССИЙСКИЙ ОТВЕТ ДОЛЖЕН БЫТЬ ДОСТАТОЧНО ЗАМЕТНЫМ ДЛЯ
Dialogue: 0,0:06:56.73,0:06:58.65,Caption,,0,0,0,,МОБИЛИЗАЦИИ ЕВРОПЕЙСКОГО ОБЩЕСТВА,
Dialogue: 0,0:06:59.05,0:07:02.17,Caption,,0,0,0,,НО НЕДОСТАТОЧНЫМ ДЛЯ МАССОВОЙ ПАНИКИ И ТРЕБОВАНИЙ
Dialogue: 0,0:07:02.17,0:07:04.65,Caption,,0,0,0,,ПРЕКРАТИТЬ ИГРУ. СЛАБОСТЬ МОСКВЫ РАЗРЕШАЕТ
Dialogue: 0,0:07:04.65,0:07:07.77,Caption,,0,0,0,,ПРОДОЛЖАТЬ ДАВЛЕНИЕ. ЧРЕЗМЕРНАЯ СИЛА МОЖЕТ НАПУГАТЬ
Dialogue: 0,0:07:07.85,0:07:11.21,Caption,,0,0,0,,ТЕХ, КОГО СОБИРАЛИСЬ ПОСТРОИТЬ В КОЛОННУ. МЕЖДУ ЭТИМИ
Dialogue: 0,0:07:11.21,0:07:14.33,Caption,,0,0,0,,ВАРИАНТАМИ ИЩУТ УДОБНЫЙ РЕЖИМ ЭСКАЛАЦИИ. ЧТОБЫ
Dialogue: 0,0:07:14.33,0:07:18.97,Caption,,0,0,0,,ТРЕВОГА НЕ ИСЧЕЗАЛА, НО ЧЕМОДАНЫ ЕЩЁ НЕ ДОСТАВАЛИ. ЧТОБЫ БЮДЖЕТЫ РОСЛИ,
Dialogue: 0,0:07:19.25,0:07:22.01,Caption,,0,0,0,,А ВОКЗАЛЫ ОСТАВАЛИСЬ СПОКОЙНЫМИ. КАК ВЫ СЧИТАЕТЕ,
Dialogue: 0,0:07:22.24,0:07:24.57,Caption,,0,0,0,,РОССИИ СТОИТ СОПРОВОЖДАТЬ СУДА В КАЛИНИНГРАД
Dialogue: 0,0:07:24.57,0:07:28.17,Caption,,0,0,0,,ВОЕННЫМИ КОРАБЛЯМИ ИЛИ ИМЕННО ТАКОГО ШАГА ОТ НЕЁ
Dialogue: 0,0:07:28.25,0:07:31.13,Caption,,0,0,0,,И ДОБИВАЮТСЯ? НАПИШИТЕ В КОММЕНТАРИЯХ И ПОДПИШИТЕСЬ.
Dialogue: 0,0:07:33.40,0:07:35.80,Caption,,0,0,0,,ПОТОМУ ЧТО РЯДОМ С БАЛТИЙСКИМ СЮЖЕТОМ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:07:35.80,0:07:39.56,Caption,,0,0,0,,БРИТАНИЯ, А ОНА РЕДКО ПРИХОДИТ ПРОСТО ПОСМОТРЕТЬ. В ВЕРСИИ
Dialogue: 0,0:07:39.64,0:07:42.60,Caption,,0,0,0,,ОБ АТАКЕ СУХОГРУЗА БРИТАНЦАМ ОТВОДЯТ РОЛЬ УЧАСТНИКА
Dialogue: 0,0:07:42.68,0:07:45.88,Caption,,0,0,0,,ОПЕРАЦИИ. ЗАТО О ДРУГОЙ ДЕЯТЕЛЬНОСТИ ЛОНДОН ГОВОРИТ
Dialogue: 0,0:07:45.88,0:07:48.84,Caption,,0,0,0,,СОВЕРШЕННО ОТКРЫТО. ВЕЛИКОБРИТАНИЯ ПРИЗНАЛА,
Dialogue: 0,0:07:49.10,0:07:51.88,Caption,,0,0,0,,ЧТО ВЕДЁТ НАСТУПАТЕЛЬНЫЕ КИБЕРОПЕРАЦИИ ПРОТИВ
Dialogue: 0,0:07:51.88,0:07:54.68,Caption,,0,0,0,,РОССИИ, КИТАЯ, ИРАНА И КНДР.
Dialogue: 0,0:07:55.28,0:07:58.68,Caption,,0,0,0,,КЛЮЧЕВОЕ СЛОВО ЗДЕСЬ НАСТУПАТЕЛЬНЫЕ. НЕ ОХРАНА
Dialogue: 0,0:07:58.68,0:08:01.88,Caption,,0,0,0,,СОБСТВЕННЫХ СЕТЕЙ. НЕ ОТРАЖЕНИЕ ЧУЖИХ ПРОНИКНОВЕНИЙ.
Dialogue: 0,0:08:02.11,0:08:05.88,Caption,,0,0,0,,РЕЧЬ ИДЁТ О ДЕЙСТВИЯХ, ПОСЛЕ КОТОРЫХ ПОСЛЕДСТВИЯ ДОЛЖЕН ПОЧУВСТВОВАТЬ
Dialogue: 0,0:08:05.88,0:08:09.80,Caption,,0,0,0,,ПРОТИВНИК. КОМАНДУЮЩИЙ БРИТАНСКИМ КИБЕРНЕТИЧЕСКИМ И СПЕЦИАЛЬНЫМ
Dialogue: 0,0:08:09.80,0:08:12.68,Caption,,0,0,0,,ОПЕРАТИВНЫМ КОМАНДОВАНИЕМ ГЕНЕРАЛ РОБЕРТ МАГОВАН
Dialogue: 0,0:08:13.00,0:08:16.60,Caption,,0,0,0,,ОБЪЯСНИЛ ПОДХОД БЕЗ ЛИШНИХ КРУЖЕВ. ПРОТИВНИК ОБЯЗАН
Dialogue: 0,0:08:16.68,0:08:20.36,Caption,,0,0,0,,ОЩУЩАТЬ ЦЕНУ СВОИХ ДЕЙСТВИЙ. ГЛАВА МИ ШЕСТЬ БЛЕЗ
Dialogue: 0,0:08:20.36,0:08:23.24,Caption,,0,0,0,,МЕТРЕВЕЛИ ТАКЖЕ ГОВОРИТ О СПЕЦИАЛЬНЫХ ОПЕРАЦИЯХ И
Dialogue: 0,0:08:23.24,0:08:25.88,Caption,,0,0,0,,СКРЫТОЙ РАБОТЕ. ЛОНДОН НЕ ПРЯЧЕТ ПРИНЦИП.
Dialogue: 0,0:08:26.17,0:08:28.36,Caption,,0,0,0,,ВОЗДЕЙСТВОВАТЬ ТАМ, ГДЕ БОЛЬНО,
Dialogue: 0,0:08:28.68,0:08:31.24,Caption,,0,0,0,,И ПО ВОЗМОЖНОСТИ ОСТАВЛЯТЬ КАК МОЖНО МЕНЬШЕ СЛЕДОВ.
Dialogue: 0,0:08:31.83,0:08:34.52,Caption,,0,0,0,,БАЛТИКА В ЭТОЙ СИСТЕМЕ НЕ СУЩЕСТВУЕТ ОТДЕЛЬНО ОТ
Dialogue: 0,0:08:34.52,0:08:39.08,Caption,,0,0,0,,КИБЕРПРОСТРАНСТВА, РАЗВЕДКИ И ТАЙНЫХ ОПЕРАЦИЙ. НА МОРЕ ПОВРЕЖДАЮТ
Dialogue: 0,0:08:39.08,0:08:42.20,Caption,,0,0,0,,СУДНО. В ЦИФРОВОЙ СРЕДЕ АТАКУЮТ ИНФРАСТРУКТУРУ.
Dialogue: 0,0:08:42.49,0:08:45.64,Caption,,0,0,0,,СПЕЦСЛУЖБЫ ВЕДУТ СВОЮ РАБОТУ. ПРЕДСТАВИТЕЛИ ВЛАСТИ
Dialogue: 0,0:08:45.64,0:08:48.68,Caption,,0,0,0,,ОБЕСПЕЧИВАЮТ НУЖНОЕ ОБЪЯСНЕНИЕ. БРИТАНСКИЕ ЦИФРЫ
Dialogue: 0,0:08:48.68,0:08:51.08,Caption,,0,0,0,,ДОБАВЛЯЮТ СЮЖЕТУ ОТДЕЛЬНЫЙ ОТТЕНОК.
Dialogue: 0,0:08:53.36,0:08:56.96,Caption,,0,0,0,,У ЛОНДОНА ОКОЛО ДВУХ ТЫСЯЧ СПЕЦИАЛИСТОВ. У РОССИИ,
Dialogue: 0,0:08:57.04,0:09:01.20,Caption,,0,0,0,,КИТАЯ, ИРАНА И КНДР ВМЕСТЕ БОЛЕЕ ТРИДЦАТИ ТЫСЯЧ.
Dialogue: 0,0:09:01.51,0:09:04.40,Caption,,0,0,0,,СООТНОШЕНИЕ ПРИМЕРНО ОДИН К ПЯТНАДЦАТИ. НО В
Dialogue: 0,0:09:04.40,0:09:07.12,Caption,,0,0,0,,КИБЕРОПЕРАЦИЯХ НЕ ПРОВОДЯТ ПЕРЕКЛИЧКУ ПЕРЕД АТАКОЙ.
Dialogue: 0,0:09:07.61,0:09:10.16,Caption,,0,0,0,,ОДИН УДАЧНЫЙ ДОСТУП ИНОГДА ДАЁТ БОЛЬШЕ,
Dialogue: 0,0:09:10.32,0:09:14.08,Caption,,0,0,0,,ЧЕМ СОТНЯ СОТРУДНИКОВ, КОТОРЫЕ ЧЕСТНО МЕНЯЮТ ПАРОЛИ ПО ПЯТНИЦАМ.
Dialogue: 0,0:09:14.64,0:09:17.52,Caption,,0,0,0,,ПОЭТОМУ ЧИСЛЕННОЕ СРАВНЕНИЕ ЗДЕСЬ МАЛО ЧТО РЕШАЕТ.
Dialogue: 0,0:09:17.88,0:09:21.04,Caption,,0,0,0,,ГОРАЗДО ВАЖНЕЕ ПРИЗНАНИЕ САМОГО МЕТОДА. СЛЕДОМ
Dialogue: 0,0:09:21.04,0:09:23.60,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ПОЛЬСКИЙ ЭПИЗОД. ПОСЛЕ РАКЕТНОГО
Dialogue: 0,0:09:23.60,0:09:26.56,Caption,,0,0,0,,ИНЦИДЕНТА МАРК РЮТТЕ ПООБЕЩАЛ ЗАЩИЩАТЬ КАЖДЫЙ
Dialogue: 0,0:09:26.56,0:09:29.60,Caption,,0,0,0,,САНТИМЕТР ТЕРРИТОРИИ ПОЛЬШИ. ФРАЗА СОЛИДНАЯ.
Dialogue: 0,0:09:29.76,0:09:31.76,Caption,,0,0,0,,САНТИМЕТРАМ ТЕПЕРЬ МОЖНО СПАТЬ СПОКОЙНО.
Dialogue: 0,0:09:32.63,0:09:35.04,Caption,,0,0,0,,ПОЛЬША ПРИВЕЛА В ГОТОВНОСТЬ КОМПЛЕКСЫ ПЭТРИОТ,
Dialogue: 0,0:09:35.24,0:09:37.52,Caption,,0,0,0,,ДРУГИЕ СРЕДСТВА ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ,
Dialogue: 0,0:09:37.68,0:09:40.80,Caption,,0,0,0,,ВЕРТОЛЁТЫ И ТЕРРИТОРИАЛЬНЫЕ ПОДРАЗДЕЛЕНИЯ. РЕАКЦИЯ
Dialogue: 0,0:09:40.80,0:09:44.80,Caption,,0,0,0,,ПОКАЗЫВАЕТ, ЧТО НЕРВОЗНОСТЬ ВНУТРИ НАТО ВОВСЕ НЕ ДЕКОРАТИВНАЯ.
Dialogue: 0,0:09:45.18,0:09:47.20,Caption,,0,0,0,,ПРЕЗИДЕНТ ЧЕХИИ ПЕТР ПАВЕЛ ЗАЯВИЛ,
Dialogue: 0,0:09:47.44,0:09:49.76,Caption,,0,0,0,,ЧТО ПОДОБНОЕ МОЖЕТ СЛУЧИТЬСЯ И В ЕГО СТРАНЕ.
Dialogue: 0,0:09:50.13,0:09:52.96,Caption,,0,0,0,,ЧЕШСКИЕ ВОЕННЫЕ УЖЕ СЛУЖАТ В СОСТАВЕ СИЛ НАТО
Dialogue: 0,0:09:53.04,0:09:57.36,Caption,,0,0,0,,В ПРИБАЛТИКЕ, А ВЕРТОЛЁТЫ УЧАСТВУЮТ В ОХРАНЕ ПОЛЬСКОГО НЕБА. НО
Dialogue: 0,0:09:57.36,0:10:00.40,Caption,,0,0,0,,ОДНОВРЕМЕННО ВНУТРИ ПОЛЬШИ ЗВУЧИТ ОБВИНЕНИЕ УЖЕ В
Dialogue: 0,0:10:00.48,0:10:03.92,Caption,,0,0,0,,АДРЕС УКРАИНЫ. ПУБЛИЦИСТ РЫШАРД РЫБИЦКИЙ УТВЕРЖДАЕТ,
Dialogue: 0,0:10:04.08,0:10:07.44,Caption,,0,0,0,,ЧТО КИЕВ ЯКОБЫ СОЗНАТЕЛЬНО НЕ ПЕРЕХВАТЫВАЕТ РАКЕТЫ,
Dialogue: 0,0:10:07.64,0:10:11.86,Caption,,0,0,0,,ЛЕТЯЩИЕ К ПОЛЬСКОЙ ГРАНИЦЕ. ПРИЧЁМ,
Dialogue: 0,0:10:12.10,0:10:15.71,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ПРИЧИНА НЕ В НЕХВАТКЕ СРЕДСТВ ПРОТИВОВОЗДУШНОЙ
Dialogue: 0,0:10:15.71,0:10:18.26,Caption,,0,0,0,,ОБОРОНЫ. ТАКОЙ ВОПРОС ДЛЯ СОЮЗНИКОВ КРАЙНЕ
Dialogue: 0,0:10:18.26,0:10:20.90,Caption,,0,0,0,,НЕПРИЯТЕН. ОН ЛОМАЕТ УДОБНУЮ СХЕМУ,
Dialogue: 0,0:10:20.98,0:10:24.50,Caption,,0,0,0,,В КОТОРОЙ ЕДИНЫЙ ЗАПАД ДРУЖНО ОТРАЖАЕТ ОДНУ ВНЕШНЮЮ
Dialogue: 0,0:10:24.50,0:10:28.50,Caption,,0,0,0,,УГРОЗУ. ВЫЯСНЯЕТСЯ, ЧТО УЧАСТНИКИ УЖЕ ПОДОЗРЕВАЮТ ДРУГ ДРУГА В
Dialogue: 0,0:10:28.58,0:10:30.74,Caption,,0,0,0,,ИСПОЛЬЗОВАНИИ ПОЛЬСКОЙ ТЕРРИТОРИИ ДЛЯ СОБСТВЕННЫХ
Dialogue: 0,0:10:30.74,0:10:35.07,Caption,,0,0,0,,ЗАДАЧ. РЮТТЕ ОБЕЩАЕТ ЗАЩИЩАТЬ КАЖДЫЙ САНТИМЕТР. КИЕВ
Dialogue: 0,0:10:35.14,0:10:38.18,Caption,,0,0,0,,ПРОСИТ НОВЫЕ ВООРУЖЕНИЯ. ПОЛЬСКИЕ АВТОРЫ СПРАШИВАЮТ,
Dialogue: 0,0:10:38.50,0:10:41.78,Caption,,0,0,0,,ПОЧЕМУ ОПАСНЫЕ ЦЕЛИ ПРОПУСКАЮТ К ИХ ГРАНИЦЕ. РЯДОМ
Dialogue: 0,0:10:41.78,0:10:43.86,Caption,,0,0,0,,ПРОХОДЯТ УЧЕНИЯ КОАЛИЦИИ ЖЕЛАЮЩИХ.
Dialogue: 0,0:10:44.50,0:10:46.83,Caption,,0,0,0,,КОЛЛЕКТИВНАЯ БЕЗОПАСНОСТЬ ВЫГЛЯДИТ ВНУШИТЕЛЬНО,
Dialogue: 0,0:10:47.14,0:10:48.98,Caption,,0,0,0,,ПОКА УЧАСТНИКИ НЕ НАЧИНАЮТ ПРОВЕРЯТЬ,
Dialogue: 0,0:10:49.30,0:10:52.90,Caption,,0,0,0,,КТО ИМЕННО ДЕРЖИТ РУКУ ВОЗЛЕ ОБЩЕЙ РОЗЕТКИ. БАЛТИКА
Dialogue: 0,0:10:52.98,0:10:55.94,Caption,,0,0,0,,ДЛЯ ТАКИХ КОМБИНАЦИЙ ПОДХОДИТ ПОЧТИ ИДЕАЛЬНО. ЗДЕСЬ
Dialogue: 0,0:10:55.94,0:10:58.42,Caption,,0,0,0,,СХОДЯТСЯ ИНТЕРЕСЫ РОССИИ, ФИНЛЯНДИИ,
Dialogue: 0,0:10:58.50,0:11:01.30,Caption,,0,0,0,,ЭСТОНИИ, ЛИТВЫ, ПОЛЬШИ, НАТО,
Dialogue: 0,0:11:01.46,0:11:04.74,Caption,,0,0,0,,БРИТАНИИ И УКРАИНЫ. У КАЖДОГО ЕСТЬ ТЕХНИКА,
Dialogue: 0,0:11:04.84,0:11:08.74,Caption,,0,0,0,,РАЗВЕДКА, СОЮЗНИКИ И СОБСТВЕННОЕ ОБЪЯСНЕНИЕ ПРОИСХОДЯЩЕГО.
Dialogue: 0,0:11:09.19,0:11:13.78,Caption,,0,0,0,,ТАНК, ПЕРЕСЁКШИЙ ГРАНИЦУ, ТРУДНО ПРЕДСТАВИТЬ ЗАБЛУДИВШИМСЯ ТУРИСТОМ. С
Dialogue: 0,0:11:13.78,0:11:16.82,Caption,,0,0,0,,БЕСПИЛОТНИКОМ НАД ВОДОЙ ВСЁ УДОБНЕЕ. МАРШРУТ МОЖНО
Dialogue: 0,0:11:16.82,0:11:18.98,Caption,,0,0,0,,ЗАПУТАТЬ, УПРАВЛЕНИЕ СПРЯТАТЬ,
Dialogue: 0,0:11:19.22,0:11:24.18,Caption,,0,0,0,,ВЛАДЕЛЬЦА ТЕРМИНАЛА ЗАМЕНИТЬ, А СВЯЗЬ ПРОВЕСТИ ЧЕРЕЗ НЕСКОЛЬКО ЗВЕНЬЕВ. ОПЕРАТОРУ
Dialogue: 0,0:11:24.26,0:11:26.74,Caption,,0,0,0,,СОВЕРШЕННО НЕ ТРЕБУЕТСЯ СТОЯТЬ НА БЕРЕГУ С ПУЛЬТОМ
Dialogue: 0,0:11:26.90,0:11:32.22,Caption,,0,0,0,,И РАЗМАХИВАТЬ РУКАМИ. СУЩЕСТВУЮТ СПУТНИКОВЫЕ КАНАЛЫ,
Dialogue: 0,0:11:32.46,0:11:37.98,Caption,,0,0,0,,РЕТРАНСЛЯТОРЫ И ОБОРУДОВАНИЕ, ОФОРМЛЕННОЕ НА ТРЕТЬИХ ЛИЦ. КОМАНДУ МОЖНО ПЕРЕДАТЬ
Dialogue: 0,0:11:38.06,0:11:41.34,Caption,,0,0,0,,ТАК, ЧТО СЛЕД ПРИВЕДЁТ К ДЛИННОЙ ОЧЕРЕДИ ПОСРЕДНИКОВ,
Dialogue: 0,0:11:41.56,0:11:44.38,Caption,,0,0,0,,КАЖДЫЙ ИЗ КОТОРЫХ БУДЕТ ОЧЕНЬ УДИВЛЁН ЗНАКОМСТВУ С
Dialogue: 0,0:11:44.38,0:11:46.78,Caption,,0,0,0,,ПРЕДЫДУЩИМ. ВСЕ ПРИМЕРНО ПОНИМАЮТ,
Dialogue: 0,0:11:46.86,0:11:49.82,Caption,,0,0,0,,КАК ЭТО УСТРОЕНО. НО ПОНИМАНИЕ ЕЩЁ НАДО ПРЕВРАТИТЬ
Dialogue: 0,0:11:49.90,0:11:52.86,Caption,,0,0,0,,В ДОКАЗАТЕЛЬСТВО. ПОКА СПЕЦИАЛИСТЫ СОБИРАЮТ ЦЕПОЧКУ,
Dialogue: 0,0:11:53.02,0:11:55.90,Caption,,0,0,0,,СЛЕДУЮЩИЙ АППАРАТ УЖЕ МОЖЕТ ИДТИ ПО НОВОМУ МАРШРУТУ.
Dialogue: 0,0:11:56.19,0:11:58.86,Caption,,0,0,0,,ТАК И РАБОТАЕТ ОГРАНИЧЕННАЯ ЭСКАЛАЦИЯ. ОНА НЕ
Dialogue: 0,0:11:58.86,0:12:04.30,Caption,,0,0,0,,ПРОБИВАЕТ ВЕРХНИЙ ПОТОЛОК, ЗАТО НЕПРЕРЫВНО ДАВИТ СНИЗУ. НЕЗАДОЛГО ДО БАЛТИЙСКОЙ
Dialogue: 0,0:12:04.38,0:12:07.26,Caption,,0,0,0,,АТАКИ ПОЯВИЛИСЬ СООБЩЕНИЯ О ДЕКЛАРАЦИИ РОССИИ,
Dialogue: 0,0:12:07.39,0:12:10.70,Caption,,0,0,0,,США И КИТАЯ ПО ВОПРОСУ НЕДОПУЩЕНИЯ ЯДЕРНОГО
Dialogue: 0,0:12:10.70,0:12:14.22,Caption,,0,0,0,,СТОЛКНОВЕНИЯ. КРУПНЕЙШИЕ ДЕРЖАВЫ ОБОЗНАЧАЮТ КРАЙНЮЮ
Dialogue: 0,0:12:14.22,0:12:16.94,Caption,,0,0,0,,ЧЕРТУ. ПОЧТИ РЯДОМ ВОЗНИКАЕТ НЕБОЛЬШОЙ,
Dialogue: 0,0:12:17.18,0:12:19.34,Caption,,0,0,0,,НО ВПОЛНЕ МАТЕРИАЛЬНЫЙ УДАР НА ЕВРОПЕЙСКОМ
Dialogue: 0,0:12:19.34,0:12:22.30,Caption,,0,0,0,,НАПРАВЛЕНИИ. НЕ ЯДЕРНЫЙ КОНФЛИКТ. ВСЕГО ДВА
Dialogue: 0,0:12:22.30,0:12:25.42,Caption,,0,0,0,,БЕСПИЛОТНИКА И ОДНО ГРУЗОВОЕ СУДНО. ОДНОВРЕМЕННО
Dialogue: 0,0:12:25.50,0:12:28.70,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПОСЛЕ ДОЛГОГО ОТСУТСТВИЯ ВЕРНУЛСЯ В КИЕВ И
Dialogue: 0,0:12:28.70,0:12:31.66,Caption,,0,0,0,,ЗАМЕТНО УСИЛИЛ ПУБЛИЧНУЮ АКТИВНОСТЬ. ПОЯВИЛАСЬ
Dialogue: 0,0:12:31.66,0:12:35.58,Caption,,0,0,0,,ВЕРСИЯ, ЧТО ОН ПОЛУЧИЛ ГАРАНТИИ ЛИЧНОЙ БЕЗОПАСНОСТИ. СМЫСЛ
Dialogue: 0,0:12:35.66,0:12:37.50,Caption,,0,0,0,,ЗДЕСЬ ШИРЕ СУДЬБЫ ОДНОГО ЧЕЛОВЕКА.
Dialogue: 0,0:12:39.79,0:12:42.27,Caption,,0,0,0,,КОГДА ОСНОВНЫЕ ИГРОКИ ОЧЕРЧИВАЮТ ПРЕДЕЛ,
Dialogue: 0,0:12:42.44,0:12:45.15,Caption,,0,0,0,,ЗА КОТОРЫМ НАЧИНАЕТСЯ НЕКОНТРОЛИРУЕМОЕ СТОЛКНОВЕНИЕ,
Dialogue: 0,0:12:45.54,0:12:48.51,Caption,,0,0,0,,ПРОСТРАНСТВО НИЖЕ ЭТОГО ПРЕДЕЛА СТАНОВИТСЯ АРЕНОЙ
Dialogue: 0,0:12:48.59,0:12:52.91,Caption,,0,0,0,,ДЛЯ ПОСТОЯННЫХ ПРОБ. ТАМ МОЖНО АТАКОВАТЬ СУДА БЕСПИЛОТНИКАМИ. МОЖНО
Dialogue: 0,0:12:52.99,0:12:56.03,Caption,,0,0,0,,ПРОВЕРЯТЬ РЕАКЦИЮ ПРОТИВНИКА, НЕ ПЕРЕХОДЯ К ВОЙНЕ,
Dialogue: 0,0:12:56.35,0:12:59.15,Caption,,0,0,0,,КОТОРУЮ УЖЕ НЕВОЗМОЖНО ОСТАНОВИТЬ ОДНИМ ТЕЛЕФОННЫМ
Dialogue: 0,0:12:59.15,0:13:02.59,Caption,,0,0,0,,ЗВОНКОМ. ПОЭТОМУ ОПАСНОСТЬ БАЛТИЙСКОЙ ИСТОРИИ НЕ
Dialogue: 0,0:13:02.67,0:13:07.15,Caption,,0,0,0,,СВОДИТСЯ К СУХОГРУЗУ, ЕГО ПОВРЕЖДЕНИЯМ ИЛИ ИМЕНИ ВОЗМОЖНОГО ОПЕРАТОРА.
Dialogue: 0,0:13:07.57,0:13:10.51,Caption,,0,0,0,,ОДНА СТОРОНА ИЗУЧАЕТ НАБОР ОТВЕТОВ ДРУГОЙ И
Dialogue: 0,0:13:10.51,0:13:14.27,Caption,,0,0,0,,ПОДБИРАЕТ ДЕЙСТВИЕ, ПРИ КОТОРОМ КАЖДЫЙ ВАРИАНТ ПРИНОСИТ ЕЙ ПОЛЬЗУ.
Dialogue: 0,0:13:14.98,0:13:19.31,Caption,,0,0,0,,МОСКВА ПРОМОЛЧАЛА, ДАВЛЕНИЕ МОЖНО УСИЛИВАТЬ. ОТВЕТИЛА ОГРАНИЧЕННО,
Dialogue: 0,0:13:19.54,0:13:22.91,Caption,,0,0,0,,ЗНАЧИТ ВЕРХНЯЯ ГРАНИЦА ЕЩЁ ДАЛЬШЕ. УДАРИЛА ЖЁСТКО,
Dialogue: 0,0:13:23.16,0:13:25.95,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ ПУБЛИКЕ ПОКАЗЫВАЮТ ГОТОВУЮ КАРТИНУ
Dialogue: 0,0:13:25.95,0:13:29.23,Caption,,0,0,0,,РОССИЙСКОЙ УГРОЗЫ. ТАК ПРОТИВНИКУ ПРЕДЛАГАЮТ МЕНЮ,
Dialogue: 0,0:13:29.39,0:13:34.83,Caption,,0,0,0,,ГДЕ ВСЕ БЛЮДА ОПЛАЧИВАЕТ ОН. ИМЕННО ПОЭТОМУ СЛЕДУЮЩИЙ ШАГ ВАЖНЕЕ ПРЕДЫДУЩЕГО.
Dialogue: 0,0:13:35.30,0:13:37.87,Caption,,0,0,0,,УДАРЫ ПО МОРСКОМУ МАРШРУТУ МОГУТ СТАТЬ ПРИВЫЧНЫМ
Dialogue: 0,0:13:37.95,0:13:39.63,Caption,,0,0,0,,ИНСТРУМЕНТОМ ТОЛЬКО В ТОМ СЛУЧАЕ,
Dialogue: 0,0:13:39.95,0:13:42.75,Caption,,0,0,0,,ЕСЛИ ИХ ОРГАНИЗАТОР КАЖДЫЙ РАЗ ПОЛУЧАЕТ ВЫГОДУ.
Dialogue: 0,0:13:42.98,0:13:46.03,Caption,,0,0,0,,ИНФОРМАЦИЮ, БОЛЕЕ ВЫСОКИЙ УРОВЕНЬ ДАВЛЕНИЯ,
Dialogue: 0,0:13:46.19,0:13:49.31,Caption,,0,0,0,,РАСХОДЫ РОССИИ НА ОХРАНУ ИЛИ НУЖНУЮ КАРТИНКУ ДЛЯ
Dialogue: 0,0:13:49.31,0:13:52.75,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ МОБИЛИЗАЦИИ. УБРАТЬ ЭТУ ВЫГОДУ НАМНОГО
Dialogue: 0,0:13:52.75,0:13:56.67,Caption,,0,0,0,,СЛОЖНЕЕ, ЧЕМ СБИТЬ ОТДЕЛЬНЫЙ БЕСПИЛОТНИК. ЗДЕСЬ НЕДОСТАТОЧНО
Dialogue: 0,0:13:56.75,0:14:01.10,Caption,,0,0,0,,ПРОСТО ПОКАЗАТЬ СИЛУ. НУЖНО СДЕЛАТЬ ТАК,
Dialogue: 0,0:14:01.33,0:14:04.38,Caption,,0,0,0,,ЧТОБЫ ПРОДОЛЖЕНИЕ ИГРЫ ОБХОДИЛОСЬ ИНИЦИАТОРУ ДОРОЖЕ
Dialogue: 0,0:14:04.38,0:14:07.42,Caption,,0,0,0,,ЛЮБОГО ВОЗМОЖНОГО РЕЗУЛЬТАТА. КОРАБЛИ НАСТОЯЩИЕ.
Dialogue: 0,0:14:07.74,0:14:11.58,Caption,,0,0,0,,МАРШРУТЫ НАСТОЯЩИЕ. РАКЕТЫ И БЕСПИЛОТНИКИ ТОЖЕ НЕ
Dialogue: 0,0:14:11.66,0:14:14.54,Caption,,0,0,0,,УЧАСТВУЮТ В ТЕЛЕВИЗИОННОЙ РЕПЕТИЦИИ. ПОЭТОМУ ВОПРОС
Dialogue: 0,0:14:14.62,0:14:18.54,Caption,,0,0,0,,УЖЕ НЕ В ТОМ, ПРОИЗОЙДЁТ ЛИ НА БАЛТИКЕ НОВЫЙ ЭПИЗОД. ВОПРОС В
Dialogue: 0,0:14:18.54,0:14:22.14,Caption,,0,0,0,,ТОМ, СУМЕЕТ ЛИ МОСКВА ПРЕВРАТИТЬ СЛЕДУЮЩИЙ ХОД ИЗ УДОБНОЙ
Dialogue: 0,0:14:22.22,0:14:24.54,Caption,,0,0,0,,ПРОВЕРКИ РОССИИ В ПРОБЛЕМУ ДЛЯ ТОГО,
Dialogue: 0,0:14:24.79,0:14:26.30,Caption,,0,0,0,,КТО ЭТУ ПРОВЕРКУ УСТРАИВАЕТ.
