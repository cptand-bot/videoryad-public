Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,ЕВРОПА ОБНАРУЖИЛА НЕПРИЯТНУЮ ВЕЩЬ. ОПАСАТЬСЯ
Dialogue: 0,0:00:02.92,0:00:04.92,Caption,,0,0,0,,ПРИХОДИТСЯ УЖЕ НЕ ТОЛЬКО ПРОТИВНИКОВ,
Dialogue: 0,0:00:05.08,0:00:08.20,Caption,,0,0,0,,НО И СОЮЗНИКОВ. ФРИДРИХ МЕРЦ ПРОСИТ ВАШИНГТОН НЕ
Dialogue: 0,0:00:08.28,0:00:11.24,Caption,,0,0,0,,УСТРАИВАТЬ НЕОЖИДАННЫХ СДЕЛОК С МОСКВОЙ. ЛОНДОН
Dialogue: 0,0:00:11.24,0:00:13.64,Caption,,0,0,0,,ПОСЛЕ МНОГОЛЕТНЕГО ПОВЫШЕНИЯ СТАВОК ЗАГОВОРИЛ О
Dialogue: 0,0:00:13.64,0:00:16.76,Caption,,0,0,0,,ПЕРЕГОВОРАХ. В НАТО СЧИТАЮТ ДЕНЬГИ И ВЫЯСНЯЮТ,
Dialogue: 0,0:00:17.08,0:00:19.72,Caption,,0,0,0,,ЧТО ЖЕЛАЮЩИХ ПРОИЗНОСИТЬ РЕЧИ ГОРАЗДО БОЛЬШЕ,
Dialogue: 0,0:00:19.96,0:00:22.84,Caption,,0,0,0,,ЧЕМ ЖЕЛАЮЩИХ ОПЛАЧИВАТЬ ПРОДОЛЖЕНИЕ КОНФЛИКТА. А
Dialogue: 0,0:00:22.84,0:00:25.48,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ГОТОВЯТСЯ ОБСУЖДАТЬ С РОССИЕЙ И
Dialogue: 0,0:00:25.48,0:00:29.40,Caption,,0,0,0,,КИТАЕМ ВОПРОСЫ, РЯДОМ С КОТОРЫМИ УКРАИНСКАЯ ПОВЕСТКА СТАНОВИТСЯ ЛИШЬ
Dialogue: 0,0:00:29.40,0:00:33.67,Caption,,0,0,0,,ЧАСТЬЮ БОЛЕЕ КРУПНОГО ТОРГА. ТЕ,
Dialogue: 0,0:00:33.99,0:00:37.03,Caption,,0,0,0,,КТО ДОЛГО УВЕРЯЛ, ЧТО С МОСКВОЙ РАЗГОВАРИВАТЬ НЕ О ЧЕМ,
Dialogue: 0,0:00:37.27,0:00:41.03,Caption,,0,0,0,,ТЕПЕРЬ БОЯТСЯ, ЧТО С НЕЙ ПОГОВОРЯТ БЕЗ НИХ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:00:41.27,0:00:44.07,Caption,,0,0,0,,И ЕВРОПЕЙСКИЕ ЛИДЕРЫ НАЧНУТ ДЕЖУРИТЬ ВОЗЛЕ ТЕЛЕФОНА
Dialogue: 0,0:00:44.15,0:00:47.59,Caption,,0,0,0,,ТРАМПА, ЧТОБЫ ОН СЛУЧАЙНО НЕ ПОЗВОНИЛ ПУТИНУ БЕЗ РАЗРЕШЕНИЯ
Dialogue: 0,0:00:47.59,0:00:53.47,Caption,,0,0,0,,БРЮССЕЛЯ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ЗДЕСЬ ВАЖНЫ НЕ ОТДЕЛЬНЫЕ
Dialogue: 0,0:00:53.47,0:00:57.23,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, А ПРИЧИНЫ, ПО КОТОРЫМ ОДНИ И ТЕ ЖЕ ЛЮДИ НАЧАЛИ
Dialogue: 0,0:00:57.31,0:00:59.79,Caption,,0,0,0,,ГОВОРИТЬ СОВСЕМ НЕ ТО, ЧТО ГОВОРИЛИ ПРЕЖДЕ.
Dialogue: 0,0:01:02.06,0:01:04.70,Caption,,0,0,0,,МЕРЦ ОТКРЫТО ОПАСАЕТСЯ ПОВТОРЕНИЯ АНКОРИДЖА.
Dialogue: 0,0:01:04.96,0:01:06.94,Caption,,0,0,0,,ОЖИДАЕТСЯ ПОЕЗДКА ТРАМПА В КИТАЙ,
Dialogue: 0,0:01:07.34,0:01:09.26,Caption,,0,0,0,,ТАМ ВОЗМОЖНЫ ЕГО КОНТАКТЫ С ПУТИНЫМ,
Dialogue: 0,0:01:09.56,0:01:11.98,Caption,,0,0,0,,И НЕМЕЦКИЙ КАНЦЛЕР НАПОМИНАЕТ ВАШИНГТОНУ,
Dialogue: 0,0:01:12.20,0:01:14.94,Caption,,0,0,0,,ЧТО ЕВРОПА И УКРАИНА ТОЖЕ ЧИСЛЯТСЯ В АМЕРИКАНСКОЙ
Dialogue: 0,0:01:14.94,0:01:20.10,Caption,,0,0,0,,КОМАНДЕ. ЕСЛИ СОЮЗНИКУ ПРИХОДИТСЯ ОТДЕЛЬНО НАПОМИНАТЬ О
Dialogue: 0,0:01:20.10,0:01:24.74,Caption,,0,0,0,,СОЮЗНИЧЕСКИХ ОБЯЗАТЕЛЬСТВАХ, СОВМЕСТНАЯ ИГРА УЖЕ НАПОМИНАЕТ СЕМЕЙНЫЙ УЖИН,
Dialogue: 0,0:01:25.05,0:01:27.46,Caption,,0,0,0,,ГДЕ ХОЗЯИН НАЧАЛ ОБСУЖДАТЬ ПРОДАЖУ КВАРТИРЫ С
Dialogue: 0,0:01:27.46,0:01:30.66,Caption,,0,0,0,,СОСЕДОМ, А РОДСТВЕННИКАМ ПРЕДЛОЖИЛ ПОКА ДОЕСТЬ САЛАТ.
Dialogue: 0,0:01:32.93,0:01:35.41,Caption,,0,0,0,,ЕВРОПУ БЕСПОКОИТ НЕ КОЛИЧЕСТВО СТУЛЬЕВ ВОЗЛЕ
Dialogue: 0,0:01:35.41,0:01:38.29,Caption,,0,0,0,,ПЕРЕГОВОРНОГО СТОЛА. ГЛАВНАЯ ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:01:38.59,0:01:41.25,Caption,,0,0,0,,ЧТО СОЕДИНЁННЫЕ ШТАТЫ ПРИ ТРАМПЕ СМОТРЯТ НА
Dialogue: 0,0:01:41.25,0:01:45.09,Caption,,0,0,0,,ОТНОШЕНИЯ С РОССИЕЙ ИНАЧЕ, ЧЕМ ПРИВЫКЛИ ЕВРОПЕЙСКИЕ СТОЛИЦЫ.
Dialogue: 0,0:01:47.30,0:01:50.18,Caption,,0,0,0,,ПРЕЖНЯЯ СХЕМА БЫЛА ПРОСТОЙ. ДАВЛЕНИЕ НА МОСКВУ
Dialogue: 0,0:01:50.18,0:01:53.06,Caption,,0,0,0,,УСИЛИВАЕТСЯ, САНКЦИОННЫЕ ПАКЕТЫ МНОЖАТСЯ,
Dialogue: 0,0:01:53.28,0:01:57.86,Caption,,0,0,0,,УКРАИНА ПОЛУЧАЕТ ОРУЖИЕ, А НАКОПЛЕННЫЙ УЩЕРБ КОГДА НИБУДЬ ВЫНУЖДАЕТ РОССИЮ
Dialogue: 0,0:01:57.86,0:02:01.30,Caption,,0,0,0,,ПРИНЯТЬ ЧУЖИЕ УСЛОВИЯ. ВАШИНГТОН ОБЕСПЕЧИВАЛ ДЕНЬГИ,
Dialogue: 0,0:02:01.38,0:02:06.74,Caption,,0,0,0,,РАЗВЕДКУ, ВООРУЖЕНИЯ, ВЛИЯНИЕ И ВОЗМОЖНОСТИ НАТО. БЕЗ АМЕРИКАНСКОЙ ТЯГИ
Dialogue: 0,0:02:06.74,0:02:08.74,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ СОСТАВ ДАЛЕКО НЕ УЕДЕТ.
Dialogue: 0,0:02:10.98,0:02:13.82,Caption,,0,0,0,,МОСКВА МНОГО ЛЕТ ПОВТОРЯЕТ ФОРМУЛУ ОБ УСТРАНЕНИИ
Dialogue: 0,0:02:13.82,0:02:16.86,Caption,,0,0,0,,ПЕРВОПРИЧИН КОНФЛИКТА. ПОСЛЕ ЭТИХ СЛОВ ВСПОМИНАЮТ
Dialogue: 0,0:02:16.86,0:02:20.62,Caption,,0,0,0,,ТЕРРИТОРИИ, ДЕМИЛИТАРИЗАЦИЮ, ПОЛОЖЕНИЕ РУССКОГО ЯЗЫКА,
Dialogue: 0,0:02:20.78,0:02:24.06,Caption,,0,0,0,,УКРАИНСКУЮ АРМИЮ И ВЛАСТЬ В КИЕВЕ. НО РОССИЙСКАЯ
Dialogue: 0,0:02:24.14,0:02:26.78,Caption,,0,0,0,,ПОСТАНОВКА ВОПРОСА ВОЗНИКЛА РАНЬШЕ УКРАИНСКОЙ ФАЗЫ
Dialogue: 0,0:02:26.78,0:02:29.82,Caption,,0,0,0,,КОНФЛИКТА. МОСКВА ГОВОРИЛА О РАСШИРЕНИИ НАТО,
Dialogue: 0,0:02:30.05,0:02:32.06,Caption,,0,0,0,,ПРИБЛИЖЕНИИ ВОЕННОЙ ИНФРАСТРУКТУРЫ,
Dialogue: 0,0:02:32.22,0:02:35.58,Caption,,0,0,0,,ГРАНИЦАХ АЛЬЯНСА И ПРИНЦИПЕ НЕДЕЛИМОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:02:35.78,0:02:40.46,Caption,,0,0,0,,УКРАИНА СТАЛА МЕСТОМ, ГДЕ СТАРЫЙ СПОР ПЕРЕШЁЛ В ОТКРЫТУЮ СИЛОВУЮ ФОРМУ.
Dialogue: 0,0:02:42.73,0:02:45.29,Caption,,0,0,0,,ПОЭТОМУ СООБЩЕНИЕ УШАКОВА О РАЗГОВОРЕ ПУТИНА С
Dialogue: 0,0:02:45.37,0:02:48.41,Caption,,0,0,0,,УИТКОФФОМ И КУШНЕРОМ ВАЖНЕЕ ОЧЕРЕДНОГО ОБМЕНА
Dialogue: 0,0:02:48.41,0:02:51.53,Caption,,0,0,0,,ЗАЯВЛЕНИЯМИ О ПРЕКРАЩЕНИИ ОГНЯ. В ОБСУЖДЕНИЕ
Dialogue: 0,0:02:51.53,0:02:53.53,Caption,,0,0,0,,ВЕРНУЛИСЬ ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:02:53.85,0:02:56.57,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО И ВОЗМОЖНОСТЬ СОВМЕСТНО
Dialogue: 0,0:02:56.57,0:02:58.81,Caption,,0,0,0,,ПРОРАБАТЫВАТЬ ПРЕДЛОЖЕНИЯ МЕЖДУ МОСКВОЙ И
Dialogue: 0,0:02:58.81,0:03:04.28,Caption,,0,0,0,,ВАШИНГТОНОМ. ЭТО УЖЕ НЕ СПОР О НЕСКОЛЬКИХ НАСЕЛЁННЫХ ПУНКТАХ,
Dialogue: 0,0:03:04.60,0:03:07.08,Caption,,0,0,0,,А ПОПЫТКА ВЕРНУТЬСЯ К НАЧАЛУ ВСЕЙ ЦЕПОЧКИ.
Dialogue: 0,0:03:09.35,0:03:11.11,Caption,,0,0,0,,МОЖНО ДОГОВОРИТЬСЯ ОБ ЭНЕРГЕТИКЕ,
Dialogue: 0,0:03:11.27,0:03:15.11,Caption,,0,0,0,,ОБМЕНЯТЬ ПЛЕННЫХ, ПРОВЕСТИ ЛИНИЮ РАЗГРАНИЧЕНИЯ И УСТРОИТЬ
Dialogue: 0,0:03:15.11,0:03:19.83,Caption,,0,0,0,,ТОРЖЕСТВЕННУЮ ФОТОСЕССИЮ. НО ЕСЛИ СПОР РОССИИ И НАТО ОСТАНЕТСЯ ПРЕЖНИМ,
Dialogue: 0,0:03:20.07,0:03:22.07,Caption,,0,0,0,,СНОВА ПОЯВЯТСЯ ВОПРОСЫ О БАЗАХ,
Dialogue: 0,0:03:22.26,0:03:26.95,Caption,,0,0,0,,КОНТИНГЕНТАХ, ВООРУЖЕНИЯХ И НОВЫХ ГРАНИЦАХ АЛЬЯНСА. ПОЛИТИКАМ
Dialogue: 0,0:03:27.03,0:03:29.83,Caption,,0,0,0,,ПРИДЁТСЯ ВНОВЬ СОБИРАТЬ МИРНЫЙ САММИТ И ТУШИТЬ
Dialogue: 0,0:03:29.91,0:03:32.55,Caption,,0,0,0,,ПОЖАР, ПОД КОТОРЫЙ ОНИ ЗАРАНЕЕ СЛОЖИЛИ ДРОВА.
Dialogue: 0,0:03:34.82,0:03:38.50,Caption,,0,0,0,,КУШНЕР ГОВОРИТ, ЧТО ПЕРЕД КАМЕРАМИ СТОРОНЫ СОХРАНЯЮТ МАКСИМАЛЬНО
Dialogue: 0,0:03:38.50,0:03:42.42,Caption,,0,0,0,,ЖЁСТКИЕ ПОЗИЦИИ, А ЗА ЗАКРЫТЫМИ ДВЕРЯМИ ПОНИМАЮТ НЕОБХОДИМОСТЬ
Dialogue: 0,0:03:42.42,0:03:45.94,Caption,,0,0,0,,КОМПРОМИССОВ. ТАК ВЫГЛЯДЯТ НАСТОЯЩИЕ ПЕРЕГОВОРЫ. НА
Dialogue: 0,0:03:46.02,0:03:48.82,Caption,,0,0,0,,ПУБЛИКЕ ВСЕ НЕПОБЕДИМЫ. ПОСЛЕ ЗАКРЫТИЯ ДВЕРЕЙ
Dialogue: 0,0:03:48.82,0:03:51.78,Caption,,0,0,0,,НАЧИНАЕТСЯ РАЗГОВОР О ТОМ, КТО ЧТО ПОЛУЧАЕТ,
Dialogue: 0,0:03:51.99,0:03:56.34,Caption,,0,0,0,,ЧЕМ ПОСТУПАЕТСЯ, КТО ГАРАНТИРУЕТ ДОГОВОРЁННОСТИ И ЧТО ПРОИЗОЙДЁТ ПРИ
Dialogue: 0,0:03:56.42,0:04:00.95,Caption,,0,0,0,,ИХ НАРУШЕНИИ. ДАЛЬШЕ ПОЯВЛЯЕТСЯ КИТАЙ.
Dialogue: 0,0:04:03.22,0:04:08.18,Caption,,0,0,0,,ОЖИДАЕТСЯ ВСТРЕЧА ТРАМПА, ПУТИНА И СИ ЦЗИНЬПИНА. ОДНИ УЖЕ РИСУЮТ НОВУЮ
Dialogue: 0,0:04:08.18,0:04:11.78,Caption,,0,0,0,,ЯЛТУ, ГДЕ ТРИ ДЕРЖАВЫ РЕШАТ СУДЬБУ ОСТАЛЬНЫХ. ДРУГИЕ
Dialogue: 0,0:04:11.78,0:04:15.54,Caption,,0,0,0,,УТВЕРЖДАЮТ, ЧТО УКРАИНСКИЙ КОНФЛИКТ ПОЙДЁТ ПО ОТДЕЛЬНОМУ КАНАЛУ,
Dialogue: 0,0:04:15.77,0:04:18.90,Caption,,0,0,0,,А ЛИДЕРЫ СОСРЕДОТОЧАТСЯ НА ЯДЕРНОМ ОРУЖИИ И ИРАНЕ.
Dialogue: 0,0:04:21.16,0:04:24.28,Caption,,0,0,0,,ВТОРОЙ ВАРИАНТ НИЧУТЬ НЕ МЕЛЬЧЕ ПЕРВОГО. ЕСЛИ
Dialogue: 0,0:04:24.36,0:04:28.76,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ, РОССИЯ И КИТАЙ ОБСУЖДАЮТ СТРАТЕГИЧЕСКОЕ ОРУЖИЕ,
Dialogue: 0,0:04:28.86,0:04:31.72,Caption,,0,0,0,,ИРАН И ПРАВИЛА ПОВЕДЕНИЯ КРУПНЕЙШИХ ДЕРЖАВ,
Dialogue: 0,0:04:32.06,0:04:34.76,Caption,,0,0,0,,УКРАИНА ПЕРЕСТАЁТ БЫТЬ ЕДИНСТВЕННОЙ ОСЬЮ МИРОВОЙ
Dialogue: 0,0:04:34.76,0:04:37.32,Caption,,0,0,0,,БЕЗОПАСНОСТИ. РЯДОМ СТОЯТ ТАЙВАНЬ,
Dialogue: 0,0:04:37.56,0:04:40.60,Caption,,0,0,0,,БЛИЖНИЙ ВОСТОК, НАТО И ЯДЕРНОЕ СДЕРЖИВАНИЕ.
Dialogue: 0,0:04:42.87,0:04:47.19,Caption,,0,0,0,,НОВАЯ ЯЛТА НЕ ОЗНАЧАЕТ, ЧТО ТРОЕ ЛИДЕРОВ РАЗЛОЖАТ КАРТУ И НАЧНУТ ДЕЛИТЬ
Dialogue: 0,0:04:47.19,0:04:50.39,Caption,,0,0,0,,СТРАНЫ, КАК ПИРОГ. НО ДОГОВОРЁННОСТИ ВАШИНГТОНА,
Dialogue: 0,0:04:50.47,0:04:54.47,Caption,,0,0,0,,МОСКВЫ И ПЕКИНА ПО СТРАТЕГИЧЕСКИМ ВОПРОСАМ ОСТАВЛЯЮТ
Dialogue: 0,0:04:54.47,0:04:57.27,Caption,,0,0,0,,ЕВРОПУ ПЕРЕД ВОПРОСОМ КАКУЮ РОЛЬ ОНА ИГРАЕТ,
Dialogue: 0,0:04:57.58,0:04:59.35,Caption,,0,0,0,,ЕСЛИ ПРАВИЛА ОБСУЖДАЮТ БЕЗ НЕЁ?
Dialogue: 0,0:05:01.62,0:05:04.67,Caption,,0,0,0,,ПОЭТОМУ МЕРЦ И НЕРВНИЧАЕТ. СПОРИТЬ С РОССИЕЙ,
Dialogue: 0,0:05:04.74,0:05:06.82,Caption,,0,0,0,,ЧУВСТВУЯ ЗА СПИНОЙ ВСЮ МОЩЬ США,
Dialogue: 0,0:05:06.96,0:05:11.46,Caption,,0,0,0,,УДОБНО. НАБЛЮДАТЬ, КАК ВАШИНГТОН ДОГОВАРИВАЕТСЯ С МОСКВОЙ И ПЕКИНОМ,
Dialogue: 0,0:05:11.62,0:05:17.74,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО МЕНЕЕ УЮТНО. КИТАЙ ПРИХОДИТ К ТАКОМУ РАЗГОВОРУ НЕ С ПАПКОЙ
Dialogue: 0,0:05:17.82,0:05:20.94,Caption,,0,0,0,,ДОБРЫХ ПОЖЕЛАНИЙ. ТАЙВАНЬ СООБЩАЕТ БОЛЕЕ ЧЕМ О СОТНЕ
Dialogue: 0,0:05:20.94,0:05:23.82,Caption,,0,0,0,,КИТАЙСКИХ ВОЕННЫХ КОРАБЛЕЙ И СУДОВ БЕРЕГОВОЙ ОХРАНЫ
Dialogue: 0,0:05:23.90,0:05:26.94,Caption,,0,0,0,,В ЗАПАДНОЙ ЧАСТИ ТИХОГО ОКЕАНА. АВИАНОСНАЯ ГРУППА
Dialogue: 0,0:05:26.94,0:05:31.26,Caption,,0,0,0,,"ЛЯОНИН" ПРОВОДИТ УЧЕНИЯ, "ФУЦЗЯНЬ" ЗАМЕЧЕН В ЮЖНО КИТАЙСКОМ МОРЕ,
Dialogue: 0,0:05:31.50,0:05:34.14,Caption,,0,0,0,,КИТАЙСКАЯ АВИАЦИЯ ВЫПОЛНЯЕТ ДЕСЯТКИ ВЫЛЕТОВ.
Dialogue: 0,0:05:36.42,0:05:41.06,Caption,,0,0,0,,ЗА СЛОВАМИ ПЕКИНА СТОИТ СИЛА, КОТОРУЮ НЕВОЗМОЖНО УБРАТЬ ИЗ ПЕРЕГОВОРОВ УДАЧНОЙ
Dialogue: 0,0:05:41.06,0:05:44.34,Caption,,0,0,0,,ФОРМУЛИРОВКОЙ. ТАЙВАНЬ ДЛЯ КИТАЯ ЯВЛЯЕТСЯ ВОПРОСОМ
Dialogue: 0,0:05:44.34,0:05:46.82,Caption,,0,0,0,,БЕЗОПАСНОСТИ И ТЕРРИТОРИАЛЬНОЙ ЦЕЛОСТНОСТИ,
Dialogue: 0,0:05:47.06,0:05:49.22,Caption,,0,0,0,,А НЕ ТЕМОЙ ДЛЯ ОЧЕРЕДНОГО КРУГЛОГО СТОЛА С
Dialogue: 0,0:05:49.30,0:05:55.10,Caption,,0,0,0,,МИНЕРАЛЬНОЙ ВОДОЙ. СОЕДИНЁННЫЕ ШТАТЫ ТОЖЕ СЧИТАЮТ СОБСТВЕННЫЕ УГРОЗЫ
Dialogue: 0,0:05:55.10,0:05:57.26,Caption,,0,0,0,,РЕАЛЬНЫМИ И МЕНЯЮТ ПРАВИЛА ТАМ,
Dialogue: 0,0:05:57.42,0:06:00.38,Caption,,0,0,0,,ГДЕ ОНИ МЕШАЮТ АМЕРИКАНСКИМ ИНТЕРЕСАМ. ОБСУЖДАЕТСЯ
Dialogue: 0,0:06:00.46,0:06:02.70,Caption,,0,0,0,,ЮРИСДИКЦИЯ МЕЖДУНАРОДНОГО УГОЛОВНОГО СУДА В
Dialogue: 0,0:06:02.70,0:06:05.74,Caption,,0,0,0,,ОТНОШЕНИИ РУКОВОДИТЕЛЕЙ ГОСУДАРСТВ. РАНЕЕ ВАШИНГТОН
Dialogue: 0,0:06:05.74,0:06:08.14,Caption,,0,0,0,,ПЕРЕСМАТРИВАЛ ОТНОШЕНИЕ К ВСЕМИРНОЙ ОРГАНИЗАЦИИ
Dialogue: 0,0:06:08.14,0:06:12.46,Caption,,0,0,0,,ЗДРАВООХРАНЕНИЯ, ЮНЕСКО И ПАРИЖСКОМУ СОГЛАШЕНИЮ. ТРАМП НЕ ПЫТАЕТСЯ
Dialogue: 0,0:06:12.46,0:06:15.26,Caption,,0,0,0,,ВЫИГРАТЬ ОДИН СПОР. ОН РАЗБИРАЕТ МЕХАНИЗМЫ,
Dialogue: 0,0:06:15.47,0:06:17.66,Caption,,0,0,0,,КОТОРЫЕ СЧИТАЕТ ДЛЯ США НЕУДОБНЫМИ.
Dialogue: 0,0:06:19.94,0:06:22.02,Caption,,0,0,0,,ОСОБЕННО ХОРОШО ЭТО ВИДНО ВОКРУГ ИРАНА.
Dialogue: 0,0:06:24.30,0:06:27.18,Caption,,0,0,0,,ПОСЛЕ ПРЕЖНИХ УДАРОВ ЗВУЧАЛИ ЗАЯВЛЕНИЯ О РАЗРУШЕНИИ
Dialogue: 0,0:06:27.18,0:06:29.98,Caption,,0,0,0,,ЗНАЧИТЕЛЬНОЙ ЧАСТИ ИРАНСКОЙ ВОЕННОЙ ПРОМЫШЛЕННОСТИ.
Dialogue: 0,0:06:30.30,0:06:32.78,Caption,,0,0,0,,ОДНАКО ТЕГЕРАН, ПО ПРИВЕДЁННОЙ ОЦЕНКЕ,
Dialogue: 0,0:06:33.01,0:06:35.82,Caption,,0,0,0,,ПРОДОЛЖАЕТ ВЫПУСКАТЬ ОКОЛО ПЯТИДЕСЯТИ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:06:35.90,0:06:39.26,Caption,,0,0,0,,РАКЕТ В МЕСЯЦ. ТЕМП ПРИМЕРНО ВДВОЕ НИЖЕ ПРЕЖНЕГО,
Dialogue: 0,0:06:39.50,0:06:43.77,Caption,,0,0,0,,НО ПРОИЗВОДСТВО НЕ ИСЧЕЗЛО. ЗНАЧИТ,
Dialogue: 0,0:06:43.93,0:06:46.17,Caption,,0,0,0,,СЧИТАТЬ НУЖНО НЕ ПОВРЕЖДЁННЫЕ ЗДАНИЯ,
Dialogue: 0,0:06:46.33,0:06:49.53,Caption,,0,0,0,,А ДОСТИГНУТЫЙ РЕЗУЛЬТАТ. ЕСЛИ ГОСУДАРСТВО СОХРАНЯЕТ
Dialogue: 0,0:06:49.53,0:06:51.37,Caption,,0,0,0,,СПОСОБНОСТЬ ПРОИЗВОДИТЬ РАКЕТЫ,
Dialogue: 0,0:06:51.53,0:06:54.41,Caption,,0,0,0,,УГРОЖАТЬ АМЕРИКАНСКИМ БАЗАМ И ВЕСТИ ТОРГ С ПОЗИЦИИ
Dialogue: 0,0:06:54.49,0:06:57.77,Caption,,0,0,0,,СИЛЫ, ПОБЕДНЫЕ ПРОЦЕНТЫ ГОДЯТСЯ ДЛЯ ПРЕЗЕНТАЦИИ,
Dialogue: 0,0:06:58.01,0:07:00.09,Caption,,0,0,0,,НО НЕ ЗАКРЫВАЮТ СТРАТЕГИЧЕСКИЙ ВОПРОС.
Dialogue: 0,0:07:02.36,0:07:05.00,Caption,,0,0,0,,КАТАРСКОЕ ПРЕДЛОЖЕНИЕ ИРАНУ ПОКАЗЫВАЕТ МАСШТАБ
Dialogue: 0,0:07:05.00,0:07:09.08,Caption,,0,0,0,,СДЕЛКИ. ОБОГАЩЕНИЕ УРАНА, РАЗБАВЛЕНИЕ НАКОПЛЕННОГО МАТЕРИАЛА,
Dialogue: 0,0:07:09.32,0:07:12.52,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ ИНСПЕКЦИИ, СНЯТИЕ МОРСКОЙ БЛОКАДЫ,
Dialogue: 0,0:07:12.76,0:07:15.08,Caption,,0,0,0,,РАЗМОРОЗКА АКТИВОВ, ОРМУЗСКИЙ ПРОЛИВ,
Dialogue: 0,0:07:15.33,0:07:18.36,Caption,,0,0,0,,ОТНОШЕНИЯ САУДОВСКОЙ АРАВИИ С ХУСИТАМИ. АТОМНАЯ
Dialogue: 0,0:07:18.36,0:07:20.76,Caption,,0,0,0,,ПРОГРАММА СВЯЗАНА С ДЕНЬГАМИ, НЕФТЬЮ,
Dialogue: 0,0:07:20.92,0:07:24.28,Caption,,0,0,0,,СУДОХОДСТВОМ И РЕГИОНАЛЬНЫМИ СОЮЗНИКАМИ. ВЫДЕРНУТЬ
Dialogue: 0,0:07:24.36,0:07:27.16,Caption,,0,0,0,,ОДИН ПУНКТ И НАЗВАТЬ ВОПРОС РЕШЁННЫМ НЕ ПОЛУЧИТСЯ.
Dialogue: 0,0:07:29.45,0:07:32.49,Caption,,0,0,0,,ТЕГЕРАН ПРЕДУПРЕЖДАЕТ, ЧТО ЕВРОПЕЙСКАЯ ТЕРРИТОРИЯ,
Dialogue: 0,0:07:32.65,0:07:34.73,Caption,,0,0,0,,ПРЕДОСТАВЛЕННАЯ ДЛЯ АМЕРИКАНСКИХ АТАК,
Dialogue: 0,0:07:35.05,0:07:38.89,Caption,,0,0,0,,ПРЕВРАЩАЕТ РАСПОЛОЖЕННЫЕ ТАМ БАЗЫ США В ЦЕЛИ. ЕВРОПА
Dialogue: 0,0:07:38.97,0:07:41.85,Caption,,0,0,0,,ПРОСИТ ВАШИНГТОН НЕ РЕШАТЬ ВОПРОСЫ БЕЗ НЕЁ И
Dialogue: 0,0:07:41.85,0:07:44.41,Caption,,0,0,0,,ОДНОВРЕМЕННО РИСКУЕТ ПОЛУЧИТЬ ПОСЛЕДСТВИЯ ЧУЖОГО
Dialogue: 0,0:07:44.49,0:07:47.61,Caption,,0,0,0,,РЕШЕНИЯ НА СОБСТВЕННОЙ ЗЕМЛЕ. ГОЛОСА МОЖЕТ НЕ БЫТЬ,
Dialogue: 0,0:07:47.85,0:07:54.54,Caption,,0,0,0,,А ОТВЕТ ПРИЛЕТИТ ПО АДРЕСУ. КУБА СТАЛКИВАЕТСЯ С ТОЙ ЖЕ АМЕРИКАНСКОЙ ЛОГИКОЙ ЕЩЁ
Dialogue: 0,0:07:54.54,0:07:57.74,Caption,,0,0,0,,БЛИЖЕ К ГРАНИЦАМ США. ГАВАНА ПЕРЕВОДИТ СТРАНУ НА
Dialogue: 0,0:07:57.74,0:08:00.46,Caption,,0,0,0,,РЕГУЛЯРНЫЕ ОБОРОННЫЕ ТРЕНИРОВКИ И ПРИВЛЕКАЕТ
Dialogue: 0,0:08:00.54,0:08:03.34,Caption,,0,0,0,,ГРАЖДАНСКОЕ НАСЕЛЕНИЕ. ПОСЛЕ СОБЫТИЙ В ВЕНЕСУЭЛЕ
Dialogue: 0,0:08:03.34,0:08:06.86,Caption,,0,0,0,,КУБА ПОТЕРЯЛА ВАЖНУЮ ОПОРУ, ПОСТАВКИ НЕФТИ УХУДШИЛИСЬ,
Dialogue: 0,0:08:07.10,0:08:10.06,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ СИТУАЦИЯ ОСТАЁТСЯ ТЯЖЁЛОЙ. ТРАМП
Dialogue: 0,0:08:10.14,0:08:12.78,Caption,,0,0,0,,ХОЧЕТ РЕШИТЬ КУБИНСКИЙ ВОПРОС ДО ОКОНЧАНИЯ СВОЕГО
Dialogue: 0,0:08:12.78,0:08:16.14,Caption,,0,0,0,,ПРЕЗИДЕНТСКОГО СРОКА И НЕ ИСКЛЮЧАЕТ СИЛУ. МАРКО
Dialogue: 0,0:08:16.14,0:08:18.78,Caption,,0,0,0,,РУБИО ПРИДАЁТ ТЕМЕ ДОПОЛНИТЕЛЬНЫЙ ЛИЧНЫЙ И
Dialogue: 0,0:08:18.78,0:08:24.97,Caption,,0,0,0,,ВНУТРЕННИЙ ВЕС. ВАШИНГТОН СЧИТАЕТ ЕСТЕСТВЕННЫМ ЗАЩИЩАТЬ СОБСТВЕННУЮ
Dialogue: 0,0:08:24.97,0:08:28.49,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ВОЗЛЕ СВОИХ ГРАНИЦ. ИРАН МОЖНО ОКРУЖАТЬ
Dialogue: 0,0:08:28.49,0:08:32.81,Caption,,0,0,0,,АВИАЦИЕЙ, МОРСКОЙ БЛОКАДОЙ И ТРЕБОВАНИЯМИ. КУБУ МОЖНО ДУШИТЬ
Dialogue: 0,0:08:32.81,0:08:35.61,Caption,,0,0,0,,ЭКОНОМИЧЕСКИ И ПРЕДУПРЕЖДАТЬ О СИЛОВОМ СЦЕНАРИИ.
Dialogue: 0,0:08:37.89,0:08:40.45,Caption,,0,0,0,,НО ТОГДА ПРЕЖНИЙ ВОПРОС ВОЗВРАЩАЕТСЯ БЕЗ КРАСИВОЙ
Dialogue: 0,0:08:40.45,0:08:43.65,Caption,,0,0,0,,УПАКОВКИ. ПОЧЕМУ ПРАВО СЧИТАТЬ ОПАСНОЙ ВОЕННУЮ
Dialogue: 0,0:08:43.65,0:08:46.21,Caption,,0,0,0,,АКТИВНОСТЬ ВОЗЛЕ СВОИХ ГРАНИЦ ЕСТЬ ТОЛЬКО У США?
Dialogue: 0,0:08:46.60,0:08:49.49,Caption,,0,0,0,,КИТАЙ ГОВОРИТ О ТАЙВАНЕ. РОССИЯ ДЕСЯТИЛЕТИЯМИ
Dialogue: 0,0:08:49.57,0:08:52.45,Caption,,0,0,0,,ГОВОРИЛА О РАСШИРЕНИИ НАТО. МОЖНО ОТВЕРГАТЬ ИХ
Dialogue: 0,0:08:52.53,0:08:56.61,Caption,,0,0,0,,ДЕЙСТВИЯ И ПОЗИЦИИ, НО ОБЩАЯ СИСТЕМА БЕЗОПАСНОСТИ НЕ РАБОТАЕТ ПО
Dialogue: 0,0:08:56.61,0:08:59.25,Caption,,0,0,0,,ПРАВИЛУ, ГДЕ МОИ ОПАСЕНИЯ НАСТОЯЩИЕ,
Dialogue: 0,0:08:59.49,0:09:01.33,Caption,,0,0,0,,А ВАШИ СУЩЕСТВУЮТ ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:09:01.49,0:09:07.70,Caption,,0,0,0,,ЧТО ВЫ ПЛОХО ВОСПИТАНЫ. ИМЕННО ПОЭТОМУ ЕВРОПЕЙСКИЕ СТОЛИЦЫ НАЧАЛИ МЕНЯТЬ
Dialogue: 0,0:09:07.70,0:09:11.14,Caption,,0,0,0,,ТОН. ЛОНДОН ПЕРВЫМ ИЗ САМЫХ АКТИВНЫХ СТОРОННИКОВ
Dialogue: 0,0:09:11.14,0:09:14.10,Caption,,0,0,0,,ДАВЛЕНИЯ ЗАГОВОРИЛ О ЗАВЕРШЕНИИ КОНФЛИКТА ЧЕРЕЗ
Dialogue: 0,0:09:14.10,0:09:16.90,Caption,,0,0,0,,ПЕРЕГОВОРЫ. ПОСЛЕ МНОГОЛЕТНИХ ТРЕБОВАНИЙ УСИЛИВАТЬ
Dialogue: 0,0:09:16.90,0:09:20.90,Caption,,0,0,0,,САНКЦИИ, ВООРУЖАТЬ КИЕВ И ГОТОВИТЬСЯ К ДОЛГОМУ ПРОТИВОСТОЯНИЮ
Dialogue: 0,0:09:20.98,0:09:23.78,Caption,,0,0,0,,БРИТАНИЯ ДОБРАЛАСЬ ДО ОТКРЫТИЯ ВОЙНЫ ЗАКАНЧИВАЮТСЯ
Dialogue: 0,0:09:23.86,0:09:28.34,Caption,,0,0,0,,ЗА СТОЛОМ. ИНОГДА ДАЖЕ ТЕ, ДЛЯ КОТОРЫХ ЗАРАНЕЕ ЗАКАЗЫВАЛИ ЕЩЁ ОРУЖИЕ.
Dialogue: 0,0:09:30.61,0:09:33.33,Caption,,0,0,0,,БРИТАНЦАМ УЖЕ ПОНАДОБИЛСЯ ПРЯМОЙ ВОЕННЫЙ КАНАЛ СВЯЗИ
Dialogue: 0,0:09:33.41,0:09:36.45,Caption,,0,0,0,,С МОСКВОЙ. ЛОГИКА ОБРАЗЦОВАЯ СТАВКИ ПРОДОЛЖИМ
Dialogue: 0,0:09:36.45,0:09:38.61,Caption,,0,0,0,,ПОВЫШАТЬ, НО ТЕЛЕФОН ДЕРЖИТЕ РЯДОМ,
Dialogue: 0,0:09:38.92,0:09:41.25,Caption,,0,0,0,,ЧТОБЫ В КРИТИЧЕСКИЙ МОМЕНТ МОЖНО БЫЛО ОБЪЯСНИТЬ,
Dialogue: 0,0:09:41.41,0:09:48.41,Caption,,0,0,0,,ЧТО ВСЁ ПОЛУЧИЛОСЬ СЛУЧАЙНО. БРИТАНИЯ ПРИ ЭТОМ НЕ СТАЛА ГОЛУБЕМ МИРА. ВОЕННАЯ
Dialogue: 0,0:09:48.41,0:09:52.97,Caption,,0,0,0,,ПОДДЕРЖКА КИЕВА ПРОДОЛЖАЕТСЯ, ОБЯЗАТЕЛЬСТВА ИЗМЕРЯЮТСЯ ДЕСЯТКАМИ МИЛЛИАРДОВ
Dialogue: 0,0:09:52.97,0:09:56.81,Caption,,0,0,0,,ФУНТОВ, ОБУЧЕНИЕ УКРАИНСКИХ ВОЕННОСЛУЖАЩИХ НЕ ОСТАНОВЛЕНО,
Dialogue: 0,0:09:57.02,0:10:00.09,Caption,,0,0,0,,ЛОНДОН И ПАРИЖ ОБСУЖДАЮТ ГАРАНТИИ И ВОЗМОЖНОЕ
Dialogue: 0,0:10:00.09,0:10:02.89,Caption,,0,0,0,,ПРИСУТСТВИЕ ИНОСТРАННЫХ СИЛ ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ.
Dialogue: 0,0:10:03.37,0:10:05.93,Caption,,0,0,0,,ЯСТРЕБ НЕ ПЕРЕДУМАЛ. ОН ПРОСТО ПРОВЕРИЛ,
Dialogue: 0,0:10:06.01,0:10:11.56,Caption,,0,0,0,,ОТКРЫТА ЛИ ДВЕРЬ. НА ГРАНИЦАХ БЕЛАРУСИ ТЕМ ВРЕМЕНЕМ РАСШИРЯЕТСЯ
Dialogue: 0,0:10:11.56,0:10:14.84,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ВОЕННАЯ ИНФРАСТРУКТУРА. ВИКТОР ХРЕНИН
Dialogue: 0,0:10:14.84,0:10:17.48,Caption,,0,0,0,,ПЕРЕЧИСЛЯЕТ АЭРОДРОМЫ, БАЗЫ ХРАНЕНИЯ,
Dialogue: 0,0:10:17.64,0:10:23.40,Caption,,0,0,0,,ПУНКТЫ УПРАВЛЕНИЯ, МАРШРУТЫ, УЧЕНИЯ И РАЗВЕДЫВАТЕЛЬНУЮ АКТИВНОСТЬ. РЕЧЬ ПОЛИТИКА
Dialogue: 0,0:10:23.40,0:10:26.76,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ ВМЕСТЕ С ТРАНСЛЯЦИЕЙ. СКЛАД И АЭРОДРОМ
Dialogue: 0,0:10:26.83,0:10:31.05,Caption,,0,0,0,,ОСТАЮТСЯ НА МЕСТЕ. ЕВРОПА ГОВОРИТ,
Dialogue: 0,0:10:31.29,0:10:34.33,Caption,,0,0,0,,ЧТО УСИЛИВАЕТСЯ ИЗ ЗА РОССИИ И БЕЛАРУСИ. МОСКВА
Dialogue: 0,0:10:34.33,0:10:37.13,Caption,,0,0,0,,И МИНСК СМОТРЯТ НА ЕВРОПЕЙСКИЕ ПРИГОТОВЛЕНИЯ И
Dialogue: 0,0:10:37.13,0:10:40.25,Caption,,0,0,0,,ОТВЕЧАЮТ СОБСТВЕННЫМ УСИЛЕНИЕМ. ЗАТЕМ ЕВРОПЕЙЦЫ
Dialogue: 0,0:10:40.25,0:10:42.01,Caption,,0,0,0,,ПОКАЗЫВАЮТ НА ОТВЕТ И ЗАЯВЛЯЮТ,
Dialogue: 0,0:10:42.20,0:10:45.37,Caption,,0,0,0,,ЧТО ПРЕДУПРЕЖДАЛИ ОБ УГРОЗЕ. МЕХАНИЗМ РАБОТАЕТ БЕЗ
Dialogue: 0,0:10:45.37,0:10:49.45,Caption,,0,0,0,,ВЫХОДНЫХ. ГЛАВНОЕ, ЧТОБЫ ОДНАЖДЫ ЕГО НЕ РЕШИЛИ ПРОВЕРИТЬ В ДЕЛЕ.
Dialogue: 0,0:10:51.72,0:10:54.84,Caption,,0,0,0,,ОДНОВРЕМЕННО НАТО ОТМЕНИЛО САММИТ ЛИДЕРОВ В АЛБАНИИ,
Dialogue: 0,0:10:55.02,0:10:57.48,Caption,,0,0,0,,НАМЕЧАВШИЙСЯ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД.
Dialogue: 0,0:10:57.88,0:11:00.92,Caption,,0,0,0,,ОФИЦИАЛЬНАЯ ВЕРСИЯ СПОКОЙНА ГРАФИК СТАНЕТ ГИБЧЕ,
Dialogue: 0,0:11:01.16,0:11:03.88,Caption,,0,0,0,,ВСТРЕЧИ БУДУТ ПРОВОДИТЬ ПО НЕОБХОДИМОСТИ. ПРОСТО
Dialogue: 0,0:11:03.88,0:11:07.00,Caption,,0,0,0,,БОЛЬШАЯ КОМПАНИЯ РЕШИЛА ВИДЕТЬСЯ РЕЖЕ ИМЕННО ТОГДА,
Dialogue: 0,0:11:07.19,0:11:09.64,Caption,,0,0,0,,КОГДА ВНУТРИ НЕЁ СТАЛО ТРУДНЕЕ ДОГОВОРИТЬСЯ.
Dialogue: 0,0:11:11.91,0:11:13.99,Caption,,0,0,0,,СРЕДИ ПРИЧИН ФИГУРИРУЮТ УКРАИНА,
Dialogue: 0,0:11:14.14,0:11:17.11,Caption,,0,0,0,,ИРАН И РАСХОДЫ НА ОБОРОНУ. НО ЛУЧШЕ ВСЕГО
Dialogue: 0,0:11:17.19,0:11:20.55,Caption,,0,0,0,,СИТУАЦИЮ ОБЪЯСНЯЕТ ОДНА ЦИФРА. ПРЕДЛОЖЕНИЕ ЕЖЕГОДНО
Dialogue: 0,0:11:20.55,0:11:23.03,Caption,,0,0,0,,НАПРАВЛЯТЬ УКРАИНЕ ЧЕТВЕРТЬ ПРОЦЕНТА ВАЛОВОГО
Dialogue: 0,0:11:23.03,0:11:26.39,Caption,,0,0,0,,ВНУТРЕННЕГО ПРОДУКТА ПОДДЕРЖАЛИ СЕМЬ СТРАН НАТО ИЗ
Dialogue: 0,0:11:26.39,0:11:32.50,Caption,,0,0,0,,ТРИДЦАТИ ДВУХ. ВОЗЛЕ ФЛАГОВ ЕДИНСТВО БЕЗУПРЕЧНО. КОГДА НА СТОЛ
Dialogue: 0,0:11:32.58,0:11:35.46,Caption,,0,0,0,,КЛАДУТ СЧЁТ, ХОР СОКРАЩАЕТСЯ ДО СЕМИ ГОЛОСОВ.
Dialogue: 0,0:11:37.75,0:11:40.23,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПЫТАЕТСЯ СОБРАТЬ ТРИДЦАТЬ СЕМЬ СТРАН В
Dialogue: 0,0:11:40.23,0:11:44.47,Caption,,0,0,0,,КОАЛИЦИЮ ЖЕЛАЮЩИХ, ЧТОБЫ ВЫРАБОТАТЬ ОБЩУЮ ЕВРОПЕЙСКУЮ ПОЗИЦИЮ ПЕРЕД
Dialogue: 0,0:11:44.47,0:11:47.67,Caption,,0,0,0,,ПЕРЕГОВОРАМИ. ЭТИМ ГОСУДАРСТВАМ ОСТАЁТСЯ СОГЛАСОВАТЬ
Dialogue: 0,0:11:47.67,0:11:50.63,Caption,,0,0,0,,ТЕРРИТОРИИ, САНКЦИИ, ЧЛЕНСТВО В НАТО,
Dialogue: 0,0:11:50.86,0:11:55.43,Caption,,0,0,0,,ИНОСТРАННЫЕ ВОЙСКА, ГАРАНТИИ И ДЕНЬГИ. ПУСТЯКОВАЯ РАБОТА,
Dialogue: 0,0:11:55.66,0:12:01.14,Caption,,0,0,0,,КОФЕ ОСТЫТЬ НЕ УСПЕЕТ. БОЛЬШАЯ КОАЛИЦИЯ НУЖНА КИЕВУ,
Dialogue: 0,0:12:01.37,0:12:03.86,Caption,,0,0,0,,ЧТОБЫ РЕШЕНИЯ НЕ ПРЕВРАТИЛИСЬ В РАЗГОВОР МОСКВЫ И
Dialogue: 0,0:12:03.86,0:12:07.94,Caption,,0,0,0,,ВАШИНГТОНА, ПОСЛЕ КОТОРОГО УКРАИНЕ ПРИНЕСУТ ДОКУМЕНТ И УКАЖУТ
Dialogue: 0,0:12:07.94,0:12:10.82,Caption,,0,0,0,,МЕСТО ДЛЯ ПОДПИСИ. КИЕВ ХОЧЕТ БЫТЬ ЗА СТОЛОМ.
Dialogue: 0,0:12:11.14,0:12:14.26,Caption,,0,0,0,,ЕВРОПА ХОЧЕТ БЫТЬ ЗА СТОЛОМ. КРУПНЫЕ СТОЛИЦЫ ТОЖЕ
Dialogue: 0,0:12:14.34,0:12:17.70,Caption,,0,0,0,,ТРЕБУЮТ СТУЛ. СКОРО ПРИДЁТСЯ АРЕНДОВАТЬ СТАДИОН. НО
Dialogue: 0,0:12:17.78,0:12:20.34,Caption,,0,0,0,,КОЛИЧЕСТВО МЕБЕЛИ НЕ ЗАМЕНЯЕТ ОБЩЕЙ ПОЗИЦИИ.
Dialogue: 0,0:12:22.62,0:12:26.38,Caption,,0,0,0,,МАКРОН УТВЕРЖДАЕТ, ЧТО ПОДДЕРЖКА УКРАИНЫ НУЖНА ДЛЯ БЕЗОПАСНОСТИ
Dialogue: 0,0:12:26.38,0:12:29.66,Caption,,0,0,0,,ФРАНЦИИ. ФИЦО ГОТОВ УЧАСТВОВАТЬ В РАЗГОВОРЕ О МИРЕ,
Dialogue: 0,0:12:29.90,0:12:32.54,Caption,,0,0,0,,НО ОТКАЗЫВАЕТСЯ ПОДДЕРЖИВАТЬ НОВЫЙ ВОЕННЫЙ КРЕДИТ
Dialogue: 0,0:12:32.54,0:12:35.26,Caption,,0,0,0,,КИЕВУ. ОБА ГОВОРЯТ О МИРЕ И ПРЕДЛАГАЮТ
Dialogue: 0,0:12:35.26,0:12:41.30,Caption,,0,0,0,,ПРОТИВОПОЛОЖНЫЕ ДОРОГИ. У МАКРОНА ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ОДОБРЕНИЯ,
Dialogue: 0,0:12:41.62,0:12:44.42,Caption,,0,0,0,,А ВОСЕМЬДЕСЯТ ТРИ ПРОЦЕНТА ФРАНЦУЗОВ ОЦЕНИВАЮТ ЕГО
Dialogue: 0,0:12:44.42,0:12:47.78,Caption,,0,0,0,,РАБОТУ ОТРИЦАТЕЛЬНО. ГРАЖДАН БЕСПОКОЯТ ПОКУПАТЕЛЬНАЯ
Dialogue: 0,0:12:47.78,0:12:50.02,Caption,,0,0,0,,СПОСОБНОСТЬ, СОЦИАЛЬНАЯ СИСТЕМА,
Dialogue: 0,0:12:50.18,0:12:53.54,Caption,,0,0,0,,ДОЛГ И ДЕФИЦИТ БЮДЖЕТА. С ЭТОЙ ОПОРОЙ ПРЕЗИДЕНТ
Dialogue: 0,0:12:53.54,0:12:55.46,Caption,,0,0,0,,ПРОДОЛЖАЕТ ОБЪЯСНЯТЬ ВСЕЙ ЕВРОПЕ,
Dialogue: 0,0:12:55.62,0:12:58.74,Caption,,0,0,0,,СКОЛЬКО ЕЙ СЛЕДУЕТ ЗАПЛАТИТЬ. СОБСТВЕННЫЙ ИЗБИРАТЕЛЬ
Dialogue: 0,0:12:58.82,0:13:02.10,Caption,,0,0,0,,УЖЕ НЕ ВЕРИТ, ЗАТО СОСЕДЯМ ЕЩЁ МОЖНО ПРОЧИТАТЬ ЛЕКЦИЮ.
Dialogue: 0,0:13:04.29,0:13:06.13,Caption,,0,0,0,,ОЛАФ ШОЛЬЦ ПРИЗНАЁТ ОЧЕВИДНОЕ,
Dialogue: 0,0:13:06.30,0:13:09.49,Caption,,0,0,0,,КОТОРОЕ В ЕВРОПЕ ДОЛГО ПЫТАЛИСЬ НЕ ЗАМЕЧАТЬ. РОССИЯ
Dialogue: 0,0:13:09.57,0:13:12.29,Caption,,0,0,0,,НЕ ИСЧЕЗНЕТ. ЭТО КРУПНАЯ ЯДЕРНАЯ ДЕРЖАВА,
Dialogue: 0,0:13:12.53,0:13:15.33,Caption,,0,0,0,,И ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ ПРИДЁТСЯ ОБСУЖДАТЬ С ЕЁ
Dialogue: 0,0:13:15.33,0:13:18.77,Caption,,0,0,0,,УЧАСТИЕМ. ГЕОГРАФИЯ ОКАЗАЛАСЬ УПРЯМЕЕ САНКЦИОННЫХ
Dialogue: 0,0:13:18.77,0:13:22.97,Caption,,0,0,0,,ЗАЯВЛЕНИЙ. ШОЛЬЦ ТАКЖЕ НАПОМИНАЕТ,
Dialogue: 0,0:13:23.21,0:13:25.93,Caption,,0,0,0,,ЧТО БРЮССЕЛЬ СЛИШКОМ ДОЛГО РАЗГОВАРИВАЛ С ГЛОБАЛЬНЫМ
Dialogue: 0,0:13:26.01,0:13:28.49,Caption,,0,0,0,,ЮГОМ ТАК, БУДТО РЕШЕНИЕ УЖЕ ПРИНЯТО,
Dialogue: 0,0:13:28.78,0:13:32.97,Caption,,0,0,0,,А ИНДИИ, КИТАЮ, СТРАНАМ АФРИКИ И БЛИЖНЕГО ВОСТОКА ОСТАЛОСЬ
Dialogue: 0,0:13:32.97,0:13:35.05,Caption,,0,0,0,,РАСПИСАТЬСЯ. ЗАТЕМ ВЫЯСНИЛОСЬ,
Dialogue: 0,0:13:35.21,0:13:38.25,Caption,,0,0,0,,ЧТО У НИХ ЕСТЬ СОБСТВЕННЫЕ ИНТЕРЕСЫ. ДЛЯ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:13:38.25,0:13:40.97,Caption,,0,0,0,,БЮРОКРАТИИ ЭТО ПОЧТИ ОСКОРБЛЕНИЕ СТОЛЬКО ПОДГОТОВИЛИ
Dialogue: 0,0:13:40.97,0:13:43.53,Caption,,0,0,0,,ДОКУМЕНТОВ, А ЛЮДИ ВСЁ РАВНО ДУМАЮТ САМИ.
Dialogue: 0,0:13:45.80,0:13:48.76,Caption,,0,0,0,,ТЕПЕРЬ МОСКВА ПОДНИМАЕТ ВОПРОС О КОНФИГУРАЦИИ НАТО
Dialogue: 0,0:13:48.84,0:13:51.32,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО СЕДЬМОГО ГОДА. В
Dialogue: 0,0:13:51.32,0:13:53.64,Caption,,0,0,0,,ОБСУЖДАЕМОЙ ВЕРСИИ ТРЕБОВАНИЙ ФИГУРИРУЮТ
Dialogue: 0,0:13:53.64,0:13:56.04,Caption,,0,0,0,,ИНФРАСТРУКТУРА АЛЬЯНСА В ВОСТОЧНОЙ ЕВРОПЕ,
Dialogue: 0,0:13:56.28,0:13:59.48,Caption,,0,0,0,,ОТКАЗ УКРАИНЫ ОТ ЧЛЕНСТВА, ИНОСТРАННЫЕ ВОЙСКА,
Dialogue: 0,0:13:59.64,0:14:02.76,Caption,,0,0,0,,ЗАПАДНЫЕ ВООРУЖЕНИЯ И ДАЖЕ БРИТАНСКИЙ ЯДЕРНЫЙ ЩИТ.
Dialogue: 0,0:14:05.02,0:14:08.06,Caption,,0,0,0,,ДЛЯ РОССИИ БЕЗОПАСНОСТЬ ОЗНАЧАЕТ СОКРАЩЕНИЕ ВОЕННОГО
Dialogue: 0,0:14:08.14,0:14:10.86,Caption,,0,0,0,,ПРИСУТСТВИЯ НАТО У ЕЁ ГРАНИЦ. ДЛЯ АЛЬЯНСА
Dialogue: 0,0:14:10.86,0:14:13.26,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ОЗНАЧАЕТ ПРАВО СОХРАНЯТЬ ЭТО
Dialogue: 0,0:14:13.26,0:14:16.86,Caption,,0,0,0,,ПРИСУТСТВИЕ. СЛОВО ОДНО, СОДЕРЖАНИЕ ПРОТИВОПОЛОЖНОЕ.
Dialogue: 0,0:14:19.13,0:14:21.69,Caption,,0,0,0,,ЛОНДОН ЗАГОВОРИЛ О ПЕРЕГОВОРАХ ИМЕННО ПОТОМУ,
Dialogue: 0,0:14:21.93,0:14:23.93,Caption,,0,0,0,,ЧТО РЕЧЬ ИДЁТ УЖЕ НЕ ТОЛЬКО О ДОНБАССЕ.
Dialogue: 0,0:14:24.47,0:14:26.97,Caption,,0,0,0,,КАК ТОЛЬКО В ОБСУЖДЕНИЕ ВХОДИТ БРИТАНСКИЙ ЯДЕРНЫЙ
Dialogue: 0,0:14:26.97,0:14:30.73,Caption,,0,0,0,,ФАКТОР, ЧУЖОЙ КОНФЛИКТ СНИМАЕТ ПАЛЬТО И УСТРАИВАЕТСЯ В
Dialogue: 0,0:14:30.73,0:14:37.64,Caption,,0,0,0,,БРИТАНСКОЙ ГОСТИНОЙ. ЗЕЛЕНСКИЙ ОТВЕЧАЕТ ПРИВЫЧНЫМ НАБОРОМ. НОВЫЕ САНКЦИИ
Dialogue: 0,0:14:37.72,0:14:40.12,Caption,,0,0,0,,И АМЕРИКАНСКОЕ ОРУЖИЕ ДОЛЖНЫ ЗАСТАВИТЬ МОСКВУ
Dialogue: 0,0:14:40.12,0:14:43.00,Caption,,0,0,0,,УСТУПИТЬ. ПРЕДЫДУЩИЕ ПАКЕТЫ, ВИДИМО,
Dialogue: 0,0:14:43.15,0:14:46.36,Caption,,0,0,0,,СЧИТАЛИСЬ РАЗМИНКОЙ. ЕЩЁ ОДИН НАБОР ОГРАНИЧЕНИЙ,
Dialogue: 0,0:14:46.60,0:14:50.20,Caption,,0,0,0,,ЕЩЁ ОДНА ПОСТАВКА, И РОССИЯ НЕПРЕМЕННО СДЕЛАЕТ ТО,
Dialogue: 0,0:14:50.36,0:14:53.64,Caption,,0,0,0,,ЧЕГО НЕ СДЕЛАЛА ПОСЛЕ ВСЕХ ПРЕЖНИХ. СТУДИЯ КВАРТАЛА
Dialogue: 0,0:14:53.64,0:14:57.40,Caption,,0,0,0,,ПРОДОЛЖАЕТ ВЫДАВАТЬ СЕЗОНЫ, ХОТЯ СЮЖЕТ ДАВНО ХОДИТ КРУГАМИ.
Dialogue: 0,0:14:59.67,0:15:02.39,Caption,,0,0,0,,ДЛЯ ЗЕЛЕНСКОГО ЭТА АКТИВНОСТЬ РАЦИОНАЛЬНА. ЕМУ
Dialogue: 0,0:15:02.39,0:15:05.51,Caption,,0,0,0,,НЕЛЬЗЯ ИСЧЕЗНУТЬ ИЗ ПЕРЕГОВОРНОЙ КОНСТРУКЦИИ. ПОКА
Dialogue: 0,0:15:05.51,0:15:08.79,Caption,,0,0,0,,ВАШИНГТОН ГОВОРИТ С МОСКВОЙ, ЕВРОПА СПОРИТ О ДЕНЬГАХ,
Dialogue: 0,0:15:09.11,0:15:11.99,Caption,,0,0,0,,А КРУПНЫЕ ДЕРЖАВЫ ОБСУЖДАЮТ ПРАВИЛА БЕЗОПАСНОСТИ,
Dialogue: 0,0:15:12.31,0:15:15.35,Caption,,0,0,0,,КИЕВ ВЫНУЖДЕН НАПОМИНАТЬ О СЕБЕ НОВЫМИ УСЛОВИЯМИ И
Dialogue: 0,0:15:15.35,0:15:18.47,Caption,,0,0,0,,ТРЕБОВАНИЯМИ. ПРОДОЛЖЕНИЕ КОНФЛИКТА ПОЗВОЛЯЕТ ЕМУ
Dialogue: 0,0:15:18.47,0:15:23.83,Caption,,0,0,0,,СОХРАНЯТЬ ЦЕНТРАЛЬНУЮ РОЛЬ, ПОЛУЧАТЬ ОРУЖИЕ И ПОМОЩЬ. ЗАВЕРШЕНИЕ БОЕВЫХ ДЕЙСТВИЙ
Dialogue: 0,0:15:23.91,0:15:26.79,Caption,,0,0,0,,ЛИШАЕТ ЕГО ЭТИХ РЫЧАГОВ. ЭТО УЖЕ ПОНИМАЮТ И
Dialogue: 0,0:15:26.87,0:15:29.27,Caption,,0,0,0,,В ТВЕРИ, И В ОДЕССЕ, И В ИЗМАИЛЕ.
Dialogue: 0,0:15:31.46,0:15:34.34,Caption,,0,0,0,,ПЕРЕХОД ОТ ТРЕБОВАНИЙ К РЕАЛЬНОСТИ ЛУЧШЕ ВСЕГО ВИДЕН
Dialogue: 0,0:15:34.42,0:15:37.14,Caption,,0,0,0,,НА ЛИНИИ БОЕВЫХ ДЕЙСТВИЙ И В ТЫЛОВОЙ ИНФРАСТРУКТУРЕ.
Dialogue: 0,0:15:37.54,0:15:39.22,Caption,,0,0,0,,ТАМ СПОРЯТ НЕ О ФОРМУЛИРОВКАХ,
Dialogue: 0,0:15:39.54,0:15:42.10,Caption,,0,0,0,,А О ТОМ, СКОЛЬКО ЕЩЁ ВЫДЕРЖАТ ТРАНСПОРТ,
Dialogue: 0,0:15:42.26,0:15:49.33,Caption,,0,0,0,,ЭНЕРГЕТИКА, СВЯЗЬ И ЛЮДИ. УКРАИНА ПОТЕРЯЛА ШЕСТЬСОТ ТРИДЦАТЬ ЛОКОМОТИВОВ С
Dialogue: 0,0:15:49.33,0:15:53.49,Caption,,0,0,0,,НАЧАЛА КОНФЛИКТА, ПРИЧЁМ ОКОЛО ЧЕТЫРЁХСОТ ПРИШЛИСЬ НА НАИБОЛЕЕ ТЯЖЁЛЫЙ
Dialogue: 0,0:15:53.57,0:15:57.49,Caption,,0,0,0,,ЭТАП УДАРОВ. ДОПОЛНИТЕЛЬНО СООБЩАЕТСЯ О ПОВРЕЖДЁННЫХ МАШИНАХ,
Dialogue: 0,0:15:57.74,0:16:00.21,Caption,,0,0,0,,ЖЕЛЕЗНОДОРОЖНЫХ СТАНЦИЯХ, СКЛАДАХ,
Dialogue: 0,0:16:00.46,0:16:02.77,Caption,,0,0,0,,НЕФТЕБАЗАХ И ПОРТОВОЙ ИНФРАСТРУКТУРЕ.
Dialogue: 0,0:16:04.98,0:16:07.46,Caption,,0,0,0,,В ЗАПОРОЖЬЕ ПЕРЕКРЫВАЛИ ДВИЖЕНИЕ ПО МОСТУ ИМЕНИ
Dialogue: 0,0:16:07.46,0:16:09.86,Caption,,0,0,0,,ПРЕОБРАЖЕНСКОГО ПОСЛЕ ПОВРЕЖДЕНИЯ ПОЛОТНА И
Dialogue: 0,0:16:09.86,0:16:13.22,Caption,,0,0,0,,КОНСТРУКЦИЙ. ОБЪЕЗД ИДЁТ ЧЕРЕЗ ДАМБУ ДНЕПРОГЭС И
Dialogue: 0,0:16:13.22,0:16:17.06,Caption,,0,0,0,,ВАНТОВЫЙ МОСТ, НО ТЯЖЁЛЫЙ ТРАНСПОРТ СТАЛКИВАЕТСЯ С ОГРАНИЧЕНИЯМИ.
Dialogue: 0,0:16:17.37,0:16:19.94,Caption,,0,0,0,,СЛОВО "ОБЪЕЗД" ПРЕКРАСНО ЗВУЧИТ НА СОВЕЩАНИИ.
Dialogue: 0,0:16:20.25,0:16:22.82,Caption,,0,0,0,,ГРУЗОВИК ВСЁ РАВНО ИНТЕРЕСУЕТСЯ ДОПУСТИМОЙ МАССОЙ.
Dialogue: 0,0:16:25.09,0:16:28.05,Caption,,0,0,0,,УДАРУ ПОДВЕРГАЛСЯ И КРЫМСКИЙ МОСТ. ИНФРАСТРУКТУРУ
Dialogue: 0,0:16:28.05,0:16:30.93,Caption,,0,0,0,,АТАКУЮТ ОБЕ СТОРОНЫ. КИЕВ БЬЁТ ПО РОССИЙСКИМ
Dialogue: 0,0:16:30.93,0:16:34.53,Caption,,0,0,0,,ОБЪЕКТАМ, МОСКВА БЬЁТ ПО УКРАИНСКИМ. ВОПРОС НЕ В ТОМ,
Dialogue: 0,0:16:34.69,0:16:37.65,Caption,,0,0,0,,ЧЕЙ МОСТ ДАЛ БОЛЕЕ ЭФФЕКТНЫЙ КАДР ПОВРЕЖДЕНИЯ,
Dialogue: 0,0:16:37.97,0:16:40.69,Caption,,0,0,0,,А В СПОСОБНОСТИ СИСТЕМЫ СОХРАНЯТЬ ДВИЖЕНИЕ ПОСЛЕ
Dialogue: 0,0:16:40.69,0:16:45.61,Caption,,0,0,0,,КАЖДОГО УДАРА. КИЕВ ГОТОВИТ ПОНТОННЫЕ ПЕРЕПРАВЫ,
Dialogue: 0,0:16:45.85,0:16:48.41,Caption,,0,0,0,,НА СОЗДАНИЕ КОТОРЫХ ТРЕБУЕТСЯ НЕСКОЛЬКО МЕСЯЦЕВ.
Dialogue: 0,0:16:48.65,0:16:51.37,Caption,,0,0,0,,СОВЕТНИК ЗЕЛЕНСКОГО СЕРГЕЙ БЕСКРЕСТНОВ ПРИЗНАЁТ,
Dialogue: 0,0:16:51.53,0:16:54.41,Caption,,0,0,0,,ЧТО ПОНТОНЫ И ПАРОМЫ НЕ ЗАМЕНЯТ ОСНОВНЫЕ МОСТЫ.
Dialogue: 0,0:16:54.79,0:16:59.53,Caption,,0,0,0,,У ПАРОМА ЕСТЬ ПРИЧАЛ, ПОДЪЕЗД И МЕСТО ПОГРУЗКИ. ВСЕ ЭТИ ТОЧКИ ИЗВЕСТНЫ
Dialogue: 0,0:16:59.53,0:17:02.41,Caption,,0,0,0,,И УЯЗВИМЫ. ОДНОЙ "ГЕРАНИ", ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:17:02.65,0:17:04.97,Caption,,0,0,0,,МОЖЕТ ХВАТИТЬ ДЛЯ ВЫВОДА ПОНТОНА ИЗ СТРОЯ.
Dialogue: 0,0:17:07.25,0:17:10.21,Caption,,0,0,0,,СЛЕДУЮЩЕЕ ПРЕДЛОЖЕНИЕ ЕЩЁ ВЕСЕЛЕЕ. ЭТО ТОННЕЛЬ ПОД
Dialogue: 0,0:17:10.21,0:17:12.86,Caption,,0,0,0,,ДНЕПРОМ. ЕСЛИ ВРЕМЕННЫЙ МОСТ УЯЗВИМ,
Dialogue: 0,0:17:13.07,0:17:15.97,Caption,,0,0,0,,МОЖНО ПОТРАТИТЬ ГОДЫ И ПОСТРОИТЬ ПОДЗЕМНЫЙ. СКОРО
Dialogue: 0,0:17:15.97,0:17:19.10,Caption,,0,0,0,,ОЧЕРЕДЬ ДОЙДЁТ ДО КАНАТНОЙ ДОРОГИ. ВАРИАНТ ЗАКОНЧИТЬ
Dialogue: 0,0:17:19.18,0:17:21.49,Caption,,0,0,0,,ВОЙНУ И СОХРАНИТЬ СУЩЕСТВУЮЩИЕ МОСТЫ СРЕДИ
Dialogue: 0,0:17:21.49,0:17:23.90,Caption,,0,0,0,,ИНЖЕНЕРНОГО ЭНТУЗИАЗМА ВЫГЛЯДИТ НЕДОСТАТОЧНО
Dialogue: 0,0:17:23.90,0:17:28.26,Caption,,0,0,0,,ТВОРЧЕСКИМ. РОССИЙСКИЕ "ИСКАНДЕРЫ",
Dialogue: 0,0:17:28.41,0:17:33.14,Caption,,0,0,0,,ПО ДАННЫМ THE TELEGRAPH, ПОЛУЧАЮТ БОЛЕЕ ТОЧНЫЕ ОПТИЧЕСКИЕ И РАДИОЛОКАЦИОННЫЕ
Dialogue: 0,0:17:33.14,0:17:36.42,Caption,,0,0,0,,ГОЛОВКИ САМОНАВЕДЕНИЯ. НА КОНЕЧНОМ УЧАСТКЕ РАКЕТА
Dialogue: 0,0:17:36.42,0:17:39.06,Caption,,0,0,0,,МОЖЕТ КОРРЕКТИРОВАТЬ ТРАЕКТОРИЮ. ДЛЯ МОСТОВ ЭТО
Dialogue: 0,0:17:39.06,0:17:42.18,Caption,,0,0,0,,СУЩЕСТВЕННО. ПОПАСТЬ РЯДОМ С КРУПНОЙ КОНСТРУКЦИЕЙ И
Dialogue: 0,0:17:42.18,0:17:44.02,Caption,,0,0,0,,ВЫВЕСТИ ЕЁ ИЗ СТРОЯ НЕ ОДНО И ТО
Dialogue: 0,0:17:44.10,0:17:48.70,Caption,,0,0,0,,ЖЕ. НО МОСТЫ РАССМАТРИВАЮТСЯ ЛИШЬ КАК ЧАСТЬ БОЛЕЕ
Dialogue: 0,0:17:48.70,0:17:51.02,Caption,,0,0,0,,ШИРОКОЙ СТРАТЕГИИ РАЗДЕЛЕНИЯ УКРАИНСКОЙ
Dialogue: 0,0:17:51.02,0:17:53.98,Caption,,0,0,0,,ЭНЕРГОСИСТЕМЫ НА ОТДЕЛЬНЫЕ ОСТРОВА. КОГДА ЕДИНАЯ
Dialogue: 0,0:17:53.98,0:17:56.46,Caption,,0,0,0,,СЕТЬ РАСПАДАЕТСЯ НА ПЛОХО СВЯЗАННЫЕ УЧАСТКИ,
Dialogue: 0,0:17:56.71,0:17:58.94,Caption,,0,0,0,,У ОДНОГО РАЙОНА ОСТАЁТСЯ ЭЛЕКТРИЧЕСТВО,
Dialogue: 0,0:17:59.18,0:18:01.34,Caption,,0,0,0,,ДРУГОЙ ПОЛУЧАЕТ ЕГО НА НЕСКОЛЬКО ЧАСОВ,
Dialogue: 0,0:18:01.66,0:18:05.42,Caption,,0,0,0,,ТРЕТИЙ ТЕРЯЕТ ОТОПЛЕНИЕ, А ЧЕТВЁРТЫЙ РАСПОЛАГАЕТ ГЕНЕРАЦИЕЙ,
Dialogue: 0,0:18:05.58,0:18:08.22,Caption,,0,0,0,,КОТОРУЮ ТРУДНО ПЕРЕДАТЬ ПОТРЕБИТЕЛЮ. СЛЕДОМ
Dialogue: 0,0:18:08.22,0:18:11.10,Caption,,0,0,0,,СПОТЫКАЮТСЯ ВОДА, ТРАНСПОРТ И ПРОИЗВОДСТВО.
Dialogue: 0,0:18:13.37,0:18:16.17,Caption,,0,0,0,,УКРАИНСКУЮ СИСТЕМУ LIMA QUANT ПРИ ЭТОМ ОПИСЫВАЮТ
Dialogue: 0,0:18:16.17,0:18:20.01,Caption,,0,0,0,,ПОЧТИ КАК ВОЛШЕБНИКА, СПОСОБНОГО УБЕДИТЬ РОССИЙСКИЙ БЕСПИЛОТНИК,
Dialogue: 0,0:18:20.25,0:18:24.97,Caption,,0,0,0,,ЧТО ТОТ НАХОДИТСЯ В ПЕРУ. ПОДМЕНА СПУТНИКОВЫХ КООРДИНАТ СУЩЕСТВУЕТ ДАВНО.
Dialogue: 0,0:18:25.28,0:18:29.13,Caption,,0,0,0,,МОСКВИЧИ ПОМНЯТ, КАК НАВИГАТОР ВОЗЛЕ КРЕМЛЯ ОТПРАВЛЯЛ ПОЛЬЗОВАТЕЛЯ К
Dialogue: 0,0:18:29.13,0:18:32.57,Caption,,0,0,0,,АЭРОПОРТУ. ДЛЯ ТЕЛЕФОНА ЗАБАВНО. ДЛЯ ВОЕННОЙ ТЕХНИКИ
Dialogue: 0,0:18:32.57,0:18:34.73,Caption,,0,0,0,,ПРЕДУСМОТРЕНЫ ЗАЩИЩЁННЫЕ АНТЕННЫ,
Dialogue: 0,0:18:34.96,0:18:39.85,Caption,,0,0,0,,НЕСКОЛЬКО ПРИЁМНИКОВ, ИНЕРЦИАЛЬНАЯ НАВИГАЦИЯ И ДРУГИЕ СПОСОБЫ КОРРЕКЦИИ.
Dialogue: 0,0:18:42.13,0:18:45.25,Caption,,0,0,0,,ТАК ВЫГЛЯДИТ ТЕХНОЛОГИЧЕСКАЯ ГОНКА. ОДНА СТОРОНА
Dialogue: 0,0:18:45.25,0:18:49.65,Caption,,0,0,0,,ПРИДУМЫВАЕТ ПОМЕХУ, А ДРУГАЯ НАХОДИТ СПОСОБ ЕЁ ОБОЙТИ. ЧУДО КНОПКА
Dialogue: 0,0:18:49.73,0:18:52.61,Caption,,0,0,0,,РАБОТАЕТ РОВНО ДО ПОЯВЛЕНИЯ СЛЕДУЮЩЕГО ОБНОВЛЕНИЯ.
Dialogue: 0,0:18:54.88,0:18:58.08,Caption,,0,0,0,,И ЗДЕСЬ ВОПРОС ВАЖНЕЕ СПОРА О ПРОЦЕНТАХ. МОЖЕТ
Dialogue: 0,0:18:58.08,0:19:00.80,Caption,,0,0,0,,ЛИ АРМИЯ СЧИТАТЬ ПОЛНОСТЬЮ СВОИМ ИНСТРУМЕНТ,
Dialogue: 0,0:19:01.14,0:19:03.36,Caption,,0,0,0,,ПРАВИЛА ИСПОЛЬЗОВАНИЯ КОТОРОГО УСТАНАВЛИВАЕТ
Dialogue: 0,0:19:03.36,0:19:05.84,Caption,,0,0,0,,ИНОСТРАННАЯ КОМПАНИЯ И ЧУЖОЕ ГОСУДАРСТВО?
Dialogue: 0,0:19:08.12,0:19:10.92,Caption,,0,0,0,,НЕЗАВИСИМОСТЬ С УДЛИНИТЕЛЕМ ВЫГЛЯДИТ УБЕДИТЕЛЬНО,
Dialogue: 0,0:19:11.08,0:19:17.69,Caption,,0,0,0,,ПОКА НИКТО НЕ ТРОГАЕТ ВИЛКУ. ЭСТОНИЯ ПОКАЗАЛА ДРУГУЮ СТОРОНУ ОСТОРОЖНОСТИ.
Dialogue: 0,0:19:18.01,0:19:20.57,Caption,,0,0,0,,УКРАИНСКИЕ БЕСПИЛОТНИКИ ШЛИ ЧЕРЕЗ ЕЁ ВОЗДУШНОЕ
Dialogue: 0,0:19:20.57,0:19:23.77,Caption,,0,0,0,,ПРОСТРАНСТВО В НАПРАВЛЕНИИ УСТЬ ЛУГИ. ВОЕННЫЕ ИХ
Dialogue: 0,0:19:23.77,0:19:25.93,Caption,,0,0,0,,ВИДЕЛИ, САМОЛЁТЫ НАТО ПОДНЯЛИСЬ,
Dialogue: 0,0:19:26.25,0:19:28.65,Caption,,0,0,0,,НО ПЕРЕХВАТЫВАТЬ ЦЕЛИ НЕ СТАЛИ ИЗ ЗА ОПАСЕНИЯ
Dialogue: 0,0:19:28.65,0:19:31.13,Caption,,0,0,0,,ЭСКАЛАЦИИ И ПАДЕНИЯ ОБЛОМКОВ НА РОССИЙСКУЮ
Dialogue: 0,0:19:31.13,0:19:36.84,Caption,,0,0,0,,ТЕРРИТОРИЮ. В РЕЧАХ МАЛЕНЬКАЯ ЭСТОНИЯ ЛЕГКО СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:19:36.92,0:19:40.12,Caption,,0,0,0,,БОЛЬШОЙ. КОГДА БЕСПИЛОТНИК ДЕЙСТВИТЕЛЬНО ЛЕТИТ ЧЕРЕЗ
Dialogue: 0,0:19:40.20,0:19:44.12,Caption,,0,0,0,,ЕЁ НЕБО К РОССИИ, РАЗМЕРЫ БЫСТРО ВОЗВРАЩАЮТСЯ К ГЕОГРАФИЧЕСКИМ.
Dialogue: 0,0:19:44.44,0:19:47.00,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, ЭСКАЛАЦИЯ СУЩЕСТВУЕТ,
Dialogue: 0,0:19:47.21,0:19:49.32,Caption,,0,0,0,,А ОСТОРОЖНОСТЬ ПОЛЕЗНА НЕ ТОЛЬКО ТЕМ,
Dialogue: 0,0:19:49.48,0:19:51.08,Caption,,0,0,0,,КОГО ПРИЗЫВАЛИ БЫТЬ ОСТОРОЖНЕЕ.
Dialogue: 0,0:19:53.37,0:19:55.93,Caption,,0,0,0,,УКРАИНА ПРОДОЛЖАЕТ НАНОСИТЬ УДАРЫ ПО РОССИЙСКИМ
Dialogue: 0,0:19:55.93,0:19:58.73,Caption,,0,0,0,,НЕФТЕПЕРЕРАБАТЫВАЮЩИМ ЗАВОДАМ. СООБЩАЛОСЬ О
Dialogue: 0,0:19:58.81,0:20:01.53,Caption,,0,0,0,,НАРУШЕНИИ РАБОТЫ ДЕВЯТИ ИЗ ТРИДЦАТИ ПЯТИ КРУПНЕЙШИХ
Dialogue: 0,0:20:01.53,0:20:04.57,Caption,,0,0,0,,ПРЕДПРИЯТИЙ И СНИЖЕНИИ ОБЪЁМА ПЕРЕРАБОТКИ ПРИМЕРНО
Dialogue: 0,0:20:04.65,0:20:08.81,Caption,,0,0,0,,НА ТРИДЦАТЬ ПРОЦЕНТОВ, ДО ДВУХСОТ ТЫСЯЧ ТОНН В СУТКИ. ПОВРЕЖДЁННЫЕ
Dialogue: 0,0:20:08.81,0:20:11.13,Caption,,0,0,0,,УСТАНОВКИ ВТОРИЧНОЙ ПЕРЕРАБОТКИ МОГУТ
Dialogue: 0,0:20:11.13,0:20:13.37,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬСЯ ОТ ШЕСТИ ДО ВОСЬМИ МЕСЯЦЕВ.
Dialogue: 0,0:20:15.65,0:20:18.13,Caption,,0,0,0,,ТРАМП ПРОСИЛ КИЕВ ПРЕКРАТИТЬ ТАКИЕ АТАКИ,
Dialogue: 0,0:20:18.29,0:20:21.49,Caption,,0,0,0,,НО ОНИ ПРОДОЛЖАЮТСЯ. РЯДОМ С ИСТОРИЕЙ STARSHIELD ЭТО
Dialogue: 0,0:20:21.49,0:20:24.29,Caption,,0,0,0,,ВЫГЛЯДИТ ОСОБЕННО НАГЛЯДНО. КИЕВ ДЕМОНСТРИРУЕТ
Dialogue: 0,0:20:24.29,0:20:27.01,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТЬ ПРИ УДАРАХ ПО РОССИЙСКОЙ НЕФТЯНКЕ,
Dialogue: 0,0:20:27.25,0:20:29.97,Caption,,0,0,0,,А СБОИ АМЕРИКАНСКОЙ СПУТНИКОВОЙ СИСТЕМЫ ЗАСТАВЛЯЮТ
Dialogue: 0,0:20:29.97,0:20:33.89,Caption,,0,0,0,,ЕГО ПУБЛИЧНО ОБЪЯСНЯТЬ, НАСКОЛЬКО КРИТИЧНА ВНЕШНЯЯ ЗАВИСИМОСТЬ.
Dialogue: 0,0:20:36.08,0:20:38.72,Caption,,0,0,0,,К ТЕХНИЧЕСКИМ ПРОБЛЕМАМ ДОБАВЛЯЕТСЯ ЧЕЛОВЕЧЕСКИЙ
Dialogue: 0,0:20:38.72,0:20:40.96,Caption,,0,0,0,,РЕСУРС. ОДИН ИСТОЧНИК УТВЕРЖДАЕТ,
Dialogue: 0,0:20:41.20,0:20:43.92,Caption,,0,0,0,,ЧТО БАНКОВАЯ ТРЕБУЕТ СОХРАНЯТЬ ИНТЕНСИВНОСТЬ
Dialogue: 0,0:20:43.92,0:20:48.24,Caption,,0,0,0,,НАСТУПАТЕЛЬНЫХ ДЕЙСТВИЙ, НЕСМОТРЯ НА НЕБОЛЬШИЕ РЕЗУЛЬТАТЫ И БОЛЬШИЕ ПОТЕРИ
Dialogue: 0,0:20:48.24,0:20:51.28,Caption,,0,0,0,,ПЕХОТЫ. В ОТВЕТ НА ПРЕДУПРЕЖДЕНИЯ КОМАНДОВАНИЯ О
Dialogue: 0,0:20:51.28,0:20:53.84,Caption,,0,0,0,,НЕХВАТКЕ ЛЮДЕЙ ЯКОБЫ ПРЕДЛАГАЕТСЯ УСИЛИТЬ
Dialogue: 0,0:20:53.84,0:20:59.56,Caption,,0,0,0,,МОБИЛИЗАЦИЮ. ДРУГОЕ СООБЩЕНИЕ ИЗ ХЕРСОНСКОЙ ОБЛАСТИ ОПИСЫВАЕТ
Dialogue: 0,0:20:59.56,0:21:02.44,Caption,,0,0,0,,ВЫПЛАТЫ ЗА СВЕДЕНИЯ О МУЖЧИНАХ ПРИЗЫВНОГО ВОЗРАСТА,
Dialogue: 0,0:21:02.68,0:21:05.00,Caption,,0,0,0,,КОТОРЫХ ИЩУТ СОТРУДНИКИ ТЕРРИТОРИАЛЬНЫХ ЦЕНТРОВ
Dialogue: 0,0:21:05.00,0:21:08.12,Caption,,0,0,0,,КОМПЛЕКТОВАНИЯ. В РАССКАЗЕ ФИГУРИРУЮТ ДАЖЕ ПОДРОСТКИ
Dialogue: 0,0:21:08.20,0:21:11.24,Caption,,0,0,0,,НА МОПЕДАХ. ЭТИ СООБЩЕНИЯ ИМЕЮТ СЛУХОВОЙ ХАРАКТЕР,
Dialogue: 0,0:21:11.48,0:21:14.68,Caption,,0,0,0,,НО ИЗОБРАЖЁННАЯ ИМИ СИСТЕМА ПОНЯТНА. СВЕРХУ ТРЕБУЮТ
Dialogue: 0,0:21:14.68,0:21:17.24,Caption,,0,0,0,,ПРОДОЛЖАТЬ, СНИЗУ ЗАКАНЧИВАЮТСЯ ЛЮДИ,
Dialogue: 0,0:21:17.43,0:21:20.52,Caption,,0,0,0,,А ПОСЕРЕДИНЕ СТРОЯТ МЕХАНИЗМ ПОИСКА НОВОГО РЕСУРСА.
Dialogue: 0,0:21:22.81,0:21:25.85,Caption,,0,0,0,,ЖЕЛЕЗНОЙ ДОРОГЕ ТРЕБУЮТСЯ ЛОКОМОТИВЫ. ДЛЯ МОСТОВ
Dialogue: 0,0:21:25.93,0:21:28.97,Caption,,0,0,0,,НУЖНЫ РЕМОНТНЫЕ БРИГАДЫ. ЭНЕРГЕТИКЕ НЕОБХОДИМЫ
Dialogue: 0,0:21:28.97,0:21:32.09,Caption,,0,0,0,,СВЯЗАННЫЕ СЕТИ. БЕСПИЛОТНИКАМ ТРЕБУЕТСЯ СВЯЗЬ.
Dialogue: 0,0:21:32.35,0:21:35.21,Caption,,0,0,0,,ПЕХОТЕ НУЖНЫ СОЛДАТЫ. ВСЁ ТРЕБУЕТ ЗАМЕНЫ
Dialogue: 0,0:21:35.21,0:21:40.76,Caption,,0,0,0,,ОДНОВРЕМЕННО. ТА ЖЕ ЛОГИКА ДЕЙСТВУЕТ НА УРОВНЕ БОЛЬШИХ ДЕРЖАВ.
Dialogue: 0,0:21:41.16,0:21:43.40,Caption,,0,0,0,,ЕВРОПА ХОЧЕТ СОХРАНИТЬ ПРЕЖНИЙ ПОРЯДОК,
Dialogue: 0,0:21:43.62,0:21:45.72,Caption,,0,0,0,,НО УЖЕ НЕ МОЖЕТ ОПЛАЧИВАТЬ ЕГО С ПРЕЖНЕЙ
Dialogue: 0,0:21:45.72,0:21:48.44,Caption,,0,0,0,,УВЕРЕННОСТЬЮ. КИЕВ ХОЧЕТ ОСТАТЬСЯ ЦЕНТРОМ
Dialogue: 0,0:21:48.44,0:21:51.64,Caption,,0,0,0,,ПЕРЕГОВОРОВ, НО ВСЁ СИЛЬНЕЕ ЗАВИСИТ ОТ ЧУЖИХ ДЕНЕГ,
Dialogue: 0,0:21:51.72,0:21:54.92,Caption,,0,0,0,,ОРУЖИЯ И СВЯЗИ. ВАШИНГТОН ТРЕБУЕТ УЧИТЫВАТЬ
Dialogue: 0,0:21:54.92,0:21:59.24,Caption,,0,0,0,,СОБСТВЕННУЮ БЕЗОПАСНОСТЬ, ОТКАЗЫВАЯСЬ ПРИЗНАВАТЬ ТАКОЕ ЖЕ ПРАВО ЗА МОСКВОЙ И
Dialogue: 0,0:21:59.24,0:22:04.12,Caption,,0,0,0,,ПЕКИНОМ. КИТАЙ, РОССИЯ, ИРАН И КУБА ОТВЕЧАЮТ ПО РАЗНОМУ,
Dialogue: 0,0:22:04.44,0:22:06.28,Caption,,0,0,0,,НО ПО ОДНОЙ ПРИЧИНЕ НИКТО НЕ ХОЧЕТ ЖИТЬ
Dialogue: 0,0:22:06.28,0:22:08.92,Caption,,0,0,0,,ПО ПРАВИЛАМ, КОТОРЫЕ ДЛЯ НЕГО НАПИСАЛ ДРУГОЙ.
Dialogue: 0,0:22:11.19,0:22:13.59,Caption,,0,0,0,,БОРИС ДЖОНСОН ВСПОМИНАЛ ПЕРЕГОВОРЫ С СЕРГЕЕМ
Dialogue: 0,0:22:13.67,0:22:16.55,Caption,,0,0,0,,ЛАВРОВЫМ В ДВЕ ТЫСЯЧИ СЕМНАДЦАТОМ ГОДУ И ЖАЛОВАЛСЯ,
Dialogue: 0,0:22:16.87,0:22:19.35,Caption,,0,0,0,,ЧТО ЕГО ЗАСТАВЛЯЛИ ПИТЬ ВОДКУ ВОЗЛЕ РАСКАЛЁННОГО
Dialogue: 0,0:22:19.35,0:22:21.83,Caption,,0,0,0,,КАМИНА. МАРИЯ ЗАХАРОВА ОТВЕТИЛА,
Dialogue: 0,0:22:22.06,0:22:23.67,Caption,,0,0,0,,ЧТО ЗАСТАВЛЯТЬ ЕГО НЕ ПРИШЛОСЬ,
Dialogue: 0,0:22:23.83,0:22:26.95,Caption,,0,0,0,,ПОСКОЛЬКУ ДЖОНСОН САМ ПРОСИЛ ДОБАВКИ. ПОТОМ,
Dialogue: 0,0:22:27.03,0:22:29.51,Caption,,0,0,0,,ПО ЕЁ СЛОВАМ, ПРИЕХАЛА ЛИЗ ТРАСС,
Dialogue: 0,0:22:29.67,0:22:33.87,Caption,,0,0,0,,И СТАЛО ЕЩЁ ВЕСЕЛЕЕ. ЛЮДИ,
Dialogue: 0,0:22:34.11,0:22:36.67,Caption,,0,0,0,,КОТОРЫЕ ГОДАМИ ОПРЕДЕЛЯЛИ ОТНОШЕНИЯ ЕВРОПЫ С
Dialogue: 0,0:22:36.75,0:22:40.59,Caption,,0,0,0,,РОССИЕЙ, ТЕПЕРЬ СПОРЯТ, КТО КОМУ НАЛИВАЛ. ВОЗМОЖНО,
Dialogue: 0,0:22:40.83,0:22:43.15,Caption,,0,0,0,,В ЭТОМ И ЗАКЛЮЧАЛАСЬ ЗНАЧИТЕЛЬНАЯ ЧАСТЬ ПРЕЖНЕЙ
Dialogue: 0,0:22:43.15,0:22:49.02,Caption,,0,0,0,,СТРАТЕГИИ. НО ПОЛОЖЕНИЕ ИЗМЕНИЛОСЬ. ТЕЛЕФОН МЕЖДУ ЛОНДОНОМ И
Dialogue: 0,0:22:49.02,0:22:52.54,Caption,,0,0,0,,МОСКВОЙ УЖЕ ПОНАДОБИЛСЯ. ПЕРЕГОВОРЫ ТОЖЕ. ОСТАЛОСЬ
Dialogue: 0,0:22:52.54,0:22:55.26,Caption,,0,0,0,,ОСВОИТЬ САМУЮ ТРУДНУЮ ЧАСТЬ ЗА СТОЛОМ ПРИДЁТСЯ НЕ
Dialogue: 0,0:22:55.26,0:22:57.66,Caption,,0,0,0,,ТОЛЬКО ПРОИЗНОСИТЬ РЕЧИ, НО И УСТУПАТЬ.
Dialogue: 0,0:22:59.93,0:23:01.77,Caption,,0,0,0,,НЕ ЗАБУДЬТЕ ПОДПИСАТЬСЯ НА КАНАЛ,
Dialogue: 0,0:23:01.93,0:23:04.65,Caption,,0,0,0,,ЧТОБЫ ВИДЕТЬ ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ РЕАЛЬНЫЕ
Dialogue: 0,0:23:04.65,0:23:07.69,Caption,,0,0,0,,ИНТЕРЕСЫ, РЕСУРСЫ И ПОСЛЕДСТВИЯ РЕШЕНИЙ.
Dialogue: 0,0:23:09.89,0:23:12.53,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ СХОДЯТСЯ КИТАЙ, ИРАН,
Dialogue: 0,0:23:12.65,0:23:17.33,Caption,,0,0,0,,КУБА, НАТО, ЕВРОПА И УКРАИНСКИЙ ФРОНТ. ВСЕ УЧАСТНИКИ ХОТЯТ
Dialogue: 0,0:23:17.33,0:23:20.37,Caption,,0,0,0,,БЕЗОПАСНОСТИ НА СОБСТВЕННЫХ УСЛОВИЯХ. ОГРАНИЧЕНИЯ
Dialogue: 0,0:23:20.37,0:23:22.37,Caption,,0,0,0,,ТРЕБУЮТ ПРЕЖДЕ ВСЕГО ОТ ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:23:22.68,0:23:25.01,Caption,,0,0,0,,А СОБСТВЕННЫЕ ВОЗМОЖНОСТИ СТАРАЮТСЯ СОХРАНИТЬ.
Dialogue: 0,0:23:25.29,0:23:27.25,Caption,,0,0,0,,ПЛАТИТЬ ЗА КОМПРОМИСС НИКТО НЕ СПЕШИТ.
Dialogue: 0,0:23:29.45,0:23:31.93,Caption,,0,0,0,,ЖЕЛАЮЩИХ ВЕСТИ ПЕРЕГОВОРЫ СТАНОВИТСЯ БОЛЬШЕ.
Dialogue: 0,0:23:32.25,0:23:35.85,Caption,,0,0,0,,ЖЕЛАЮЩИХ ПРИЗНАТЬ, ЧТО ЧУЖАЯ БЕЗОПАСНОСТЬ ТОЖЕ СУЩЕСТВУЕТ,
Dialogue: 0,0:23:36.06,0:23:38.81,Caption,,0,0,0,,ПО ПРЕЖНЕМУ МАЛО. ПОКА ЭТО НЕ ИЗМЕНИТСЯ,
Dialogue: 0,0:23:39.06,0:23:42.01,Caption,,0,0,0,,ПОЛИТИКИ БУДУТ ОБЪЯВЛЯТЬ ОБ ОКОНЧАНИИ ОДНОГО КРИЗИСА
Dialogue: 0,0:23:42.01,0:23:46.09,Caption,,0,0,0,,РОВНО В ТОТ МОМЕНТ, КОГДА ПОД СТОЛОМ УЖЕ НАЧИНАЕТ ТИКАТЬ СЛЕДУЮЩИЙ.
