Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ОБЫЧНО ПРЕКРАЩЕНИЕ ОГНЯ ПРОДАЮТ КАК ПЕРВУЮ СТУПЕНЬ К
Dialogue: 0,0:00:03.08,0:00:05.88,Caption,,0,0,0,,МИРУ. СЕРГЕЙ ЛАВРОВ ЭТУ ЛЕСТНИЦУ ОСМОТРЕЛ И
Dialogue: 0,0:00:05.88,0:00:08.52,Caption,,0,0,0,,ПОДНИМАТЬСЯ ОТКАЗАЛСЯ. ПО ЕГО ЛОГИКЕ,
Dialogue: 0,0:00:08.76,0:00:10.76,Caption,,0,0,0,,ПОКА РОССИЯ БУДЕТ СОБЛЮДАТЬ ТИШИНУ,
Dialogue: 0,0:00:11.01,0:00:13.08,Caption,,0,0,0,,УКРАИНА ЗАЙМЁТСЯ РЕМОНТОМ АРМИИ,
Dialogue: 0,0:00:13.31,0:00:16.44,Caption,,0,0,0,,ПОЛУЧИТ НОВЫЕ ВООРУЖЕНИЯ И ПОДГОТОВИТСЯ ПРОДОЛЖАТЬ
Dialogue: 0,0:00:16.52,0:00:19.24,Caption,,0,0,0,,КОНФЛИКТ. ЕВРОПА ПРЕДЛАГАЕТ ОСТАНОВИТЬ СТРЕЛЬБУ
Dialogue: 0,0:00:19.32,0:00:22.92,Caption,,0,0,0,,СЕЙЧАС, А О ПРИЧИНАХ ПОГОВОРИТЬ ПОТОМ. МОСКВА ОТВЕЧАЕТ,
Dialogue: 0,0:00:23.08,0:00:25.64,Caption,,0,0,0,,ЧТО ПОТОМ НА СТОЛЕ ОКАЖЕТСЯ ТА ЖЕ ПРОБЛЕМА,
Dialogue: 0,0:00:25.80,0:00:30.36,Caption,,0,0,0,,ТОЛЬКО ОТДОХНУВШАЯ, ПОПОЛНЕННАЯ И ЛУЧШЕ ВООРУЖЁННАЯ. ПОДПИСЫВАЙТЕСЬ НА
Dialogue: 0,0:00:30.36,0:00:34.76,Caption,,0,0,0,,КАНАЛ. РАЗБЕРЁМСЯ, ПОЧЕМУ ОТКАЗ ЛАВРОВА ОТНОСИТСЯ НЕ ТОЛЬКО К УКРАИНЕ
Dialogue: 0,0:00:35.08,0:00:37.08,Caption,,0,0,0,,И ЗАЧЕМ ЗАПАДУ ПОНАДОБИЛИСЬ ПРАВИЛА,
Dialogue: 0,0:00:37.32,0:00:39.72,Caption,,0,0,0,,КОТОРЫЕ ОН КОГДА ТО САМ ОТПРАВИЛ В КЛАДОВКУ.
Dialogue: 0,0:00:41.99,0:00:44.87,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ФОРМУЛА ВЫГЛЯДИТ ПРОСТО. СНАЧАЛА ВСЕ
Dialogue: 0,0:00:44.87,0:00:47.11,Caption,,0,0,0,,УБИРАЮТ ПАЛЕЦ СО СПУСКОВОГО КРЮЧКА,
Dialogue: 0,0:00:47.28,0:00:50.55,Caption,,0,0,0,,ЗАТЕМ НАЧИНАЕТСЯ РАЗГОВОР. РОССИЙСКИЙ ВОПРОС ЗВУЧИТ
Dialogue: 0,0:00:50.55,0:00:53.59,Caption,,0,0,0,,НЕПРИЯТНЕЕ. ЧТО ПОМЕШАЕТ ЗА ВРЕМЯ ЭТОЙ ПАУЗЫ
Dialogue: 0,0:00:53.59,0:00:58.63,Caption,,0,0,0,,ЗАРЯДИТЬ ОРУЖИЕ ЗАНОВО, ПОДВЕЗТИ БОЕПРИПАСЫ И ЗАНЯТЬ БОЛЕЕ УДОБНУЮ ПОЗИЦИЮ?
Dialogue: 0,0:00:59.11,0:01:01.99,Caption,,0,0,0,,НА ЭТОТ ВОПРОС ВНЯТНОГО ОТВЕТА ПОКА НЕТ. ЗАТО
Dialogue: 0,0:01:01.99,0:01:04.87,Caption,,0,0,0,,СЛОВО "ПЕРЕМИРИЕ" ПРОИЗНОСЯТ ПОЧТИ ТОРЖЕСТВЕННО,
Dialogue: 0,0:01:05.03,0:01:07.11,Caption,,0,0,0,,СЛОВНО У НЕГО В КАРМАНЕ УЖЕ ЛЕЖАТ КЛЮЧИ
Dialogue: 0,0:01:07.19,0:01:12.42,Caption,,0,0,0,,ОТ МИРА. ДЛЯ МОСКВЫ ПРОИСХОДЯЩЕЕ ДАВНО НЕ ПОМЕЩАЕТСЯ В
Dialogue: 0,0:01:12.50,0:01:15.31,Caption,,0,0,0,,ГРАНИЦЫ ОДНОЙ СТРАНЫ. В ЦЕНТРЕ СПОРА НАХОДЯТСЯ
Dialogue: 0,0:01:15.39,0:01:17.78,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО, ВОЕННЫЕ ОБЪЕКТЫ,
Dialogue: 0,0:01:17.90,0:01:22.02,Caption,,0,0,0,,БАЗЫ, РАКЕТЫ И РАССТОЯНИЕ МЕЖДУ ЗАПАДНОЙ ИНФРАСТРУКТУРОЙ И
Dialogue: 0,0:01:22.10,0:01:24.90,Caption,,0,0,0,,РОССИЙСКОЙ ТЕРРИТОРИЕЙ. УКРАИНА СТАЛА МЕСТОМ,
Dialogue: 0,0:01:25.14,0:01:27.78,Caption,,0,0,0,,ГДЕ НАКОПИВШЕЕСЯ ПРОТИВОРЕЧИЕ ПЕРЕШЛО В БОЕВЫЕ
Dialogue: 0,0:01:27.78,0:01:31.06,Caption,,0,0,0,,ДЕЙСТВИЯ. НО САМО ПРОТИВОРЕЧИЕ ГОРАЗДО ШИРЕ ЛИНИИ
Dialogue: 0,0:01:31.06,0:01:36.38,Caption,,0,0,0,,ФРОНТА. ПОЭТОМУ ОСТАНОВКА ОГНЯ БЕЗ ОСТАЛЬНЫХ РЕШЕНИЙ
Dialogue: 0,0:01:36.38,0:01:39.18,Caption,,0,0,0,,ВОСПРИНИМАЕТСЯ В РОССИИ КАК БЕСПЛАТНОЕ ТЕХНИЧЕСКОЕ
Dialogue: 0,0:01:39.26,0:01:42.30,Caption,,0,0,0,,ОБСЛУЖИВАНИЕ УКРАИНСКОЙ АРМИИ. ОДНИ ПОДРАЗДЕЛЕНИЯ
Dialogue: 0,0:01:42.30,0:01:45.82,Caption,,0,0,0,,ПОЛУЧАЮТ ЛЮДЕЙ, ДРУГИЕ МЕНЯЮТ ПОВРЕЖДЁННУЮ ТЕХНИКУ,
Dialogue: 0,0:01:46.06,0:01:49.98,Caption,,0,0,0,,ПРЕДПРИЯТИЯ УСКОРЯЮТ РЕМОНТ, СКЛАДЫ ПРИНИМАЮТ НОВЫЕ ПАРТИИ,
Dialogue: 0,0:01:50.14,0:01:54.78,Caption,,0,0,0,,УКРЕПЛЕНИЯ ДОСТРАИВАЮТСЯ, МАРШРУТЫ СНАБЖЕНИЯ ПРИВОДЯТСЯ В ПОРЯДОК. НА
Dialogue: 0,0:01:54.86,0:01:59.34,Caption,,0,0,0,,ПЕРЕДОВОЙ ТИХО, ЗАТО ЗА НЕЙ КИПИТ РАБОТА. ОЧЕНЬ СВОЕОБРАЗНЫЙ ОТПУСК,
Dialogue: 0,0:01:59.50,0:02:01.18,Caption,,0,0,0,,КОГДА ОТДЫХАЮТ ТОЛЬКО ВЫСТРЕЛЫ.
Dialogue: 0,0:02:03.47,0:02:06.03,Caption,,0,0,0,,ПОСЛЕ ТАКОЙ ПЕРЕДЫШКИ МОСКВЕ ПРЕДЛАГАЮТ ПОВЕРИТЬ,
Dialogue: 0,0:02:06.34,0:02:08.99,Caption,,0,0,0,,ЧТО НИКТО НЕ ВОСПОЛЬЗУЕТСЯ РЕЗУЛЬТАТОМ ПОДГОТОВКИ.
Dialogue: 0,0:02:09.39,0:02:12.19,Caption,,0,0,0,,ДЛЯ ЭТОГО ТРЕБУЕТСЯ ДОВОЛЬНО РЕДКИЙ ТАЛАНТ. НУЖНО
Dialogue: 0,0:02:12.19,0:02:17.15,Caption,,0,0,0,,ЗАБЫТЬ ПРЕЖНИЕ ПОСТАВКИ, НЕ СМОТРЕТЬ НА ДВИЖЕНИЕ ВООРУЖЕНИЙ И УБЕДИТЬ СЕБЯ,
Dialogue: 0,0:02:17.39,0:02:20.11,Caption,,0,0,0,,ЧТО ВОЕННАЯ ТЕХНИКА ПРИЕЗЖАЕТ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:02:20.11,0:02:23.71,Caption,,0,0,0,,ПОЛЮБОВАТЬСЯ ПЕЙЗАЖЕМ. ЕСЛИ ПОСТАВИТЬ У КАРТЫ ШИРМУ,
Dialogue: 0,0:02:23.88,0:02:27.15,Caption,,0,0,0,,ГЕОГРАФИЯ, ВЕРОЯТНО, ТОЖЕ ПОСТЕСНЯЕТСЯ МЕШАТЬ.
Dialogue: 0,0:02:29.44,0:02:31.92,Caption,,0,0,0,,РОССИЯ ОТ СВОЕГО ПОНИМАНИЯ ПРИЧИН КОНФЛИКТА
Dialogue: 0,0:02:32.00,0:02:34.56,Caption,,0,0,0,,ОТКАЗЫВАТЬСЯ НЕ НАМЕРЕНА. МОЖНО СЧИТАТЬ ЕЁ
Dialogue: 0,0:02:34.56,0:02:39.60,Caption,,0,0,0,,ТРЕБОВАНИЯ ЗАВЫШЕННЫМИ, ЖЁСТКИМИ ИЛИ НЕПРИЕМЛЕМЫМИ. ОДНАКО ОНИ ОТ ЭТОГО НЕ
Dialogue: 0,0:02:39.60,0:02:42.40,Caption,,0,0,0,,ИСЧЕЗАЮТ. ПЕРЕГОВОРЫ ВООБЩЕ ПЛОХО РАБОТАЮТ,
Dialogue: 0,0:02:42.64,0:02:44.40,Caption,,0,0,0,,КОГДА ОДНОМУ УЧАСТНИКУ СООБЩАЮТ,
Dialogue: 0,0:02:44.64,0:02:46.96,Caption,,0,0,0,,ЧТО ЕГО ПРЕДСТАВЛЕНИЕ О СОБСТВЕННОЙ БЕЗОПАСНОСТИ
Dialogue: 0,0:02:46.96,0:02:50.08,Caption,,0,0,0,,СЧИТАЕТСЯ ДУРНОЙ ПРИВЫЧКОЙ И ОБСУЖДЕНИЮ НЕ ПОДЛЕЖИТ.
Dialogue: 0,0:02:50.29,0:02:53.20,Caption,,0,0,0,,ЕСЛИ МОСКВА СВЯЗЫВАЕТ ВОЙНУ СО ВСЕЙ ПРЕЖНЕЙ МОДЕЛЬЮ
Dialogue: 0,0:02:53.20,0:02:57.12,Caption,,0,0,0,,ОТНОШЕНИЙ С НАТО, ОДНОЙ ТИШИНОЙ НА ФРОНТЕ ЭТУ МОДЕЛЬ НЕ ЗАМЕНИТЬ.
Dialogue: 0,0:02:59.40,0:03:01.80,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ЛАВРОВ ГОВОРИТ УЖЕ НЕ О ЧАСТНОЙ
Dialogue: 0,0:03:01.88,0:03:03.64,Caption,,0,0,0,,ДОГОВОРЁННОСТИ МОСКВЫ И КИЕВА,
Dialogue: 0,0:03:03.84,0:03:07.16,Caption,,0,0,0,,А О СИСТЕМЕ БЕЗОПАСНОСТИ ДЛЯ ЕВРАЗИИ. ЕВРОПЕЙСКУЮ
Dialogue: 0,0:03:07.24,0:03:10.12,Caption,,0,0,0,,ИДЕЮ НЕМЕДЛЕННО ПРЕКРАТИТЬ ОГОНЬ ОН ОТВЕРГ ПРЯМО.
Dialogue: 0,0:03:10.44,0:03:14.12,Caption,,0,0,0,,ПАУЗА, ПО ЕГО СЛОВАМ, ПОЗВОЛИТ КИЕВУ ВОССТАНОВИТЬ ВОЙСКА,
Dialogue: 0,0:03:14.36,0:03:16.76,Caption,,0,0,0,,ПРИНЯТЬ НОВЫЕ ПОСТАВКИ И ПОДГОТОВИТЬСЯ К
Dialogue: 0,0:03:16.76,0:03:21.80,Caption,,0,0,0,,ПРОДОЛЖЕНИЮ. ПОЛУЧАЕТСЯ, РОССИЯ УСЛЫШАЛА ПРЕДЛОЖЕНИЕ НЕ ЗАКОНЧИТЬ КОНФЛИКТ,
Dialogue: 0,0:03:21.96,0:03:28.24,Caption,,0,0,0,,А ПОСТАВИТЬ ЕГО НА ЗАРЯДКУ. ДЕПУТАТ ВЕРХОВНОЙ РАДЫ ЕГОР ЧЕРНЕВ СООБЩИЛ,
Dialogue: 0,0:03:28.48,0:03:30.64,Caption,,0,0,0,,ЧТО УКРАИНСКАЯ СТОРОНА ПРЕДЛАГАЛА НЕСКОЛЬКО
Dialogue: 0,0:03:30.64,0:03:33.44,Caption,,0,0,0,,ВАРИАНТОВ. СРЕДИ НИХ БЫЛИ ПРЕКРАЩЕНИЕ УДАРОВ ПО
Dialogue: 0,0:03:33.44,0:03:38.40,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИМ ОБЪЕКТАМ, ОТДЕЛЬНЫЙ РЕЖИМ ДЛЯ ЧЁРНОГО МОРЯ И ПОЛНАЯ ОСТАНОВКА
Dialogue: 0,0:03:38.40,0:03:41.76,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ. ОЖИДАЕМОГО СОГЛАСИЯ МОСКВЫ КИЕВ НЕ
Dialogue: 0,0:03:41.76,0:03:47.31,Caption,,0,0,0,,ПОЛУЧИЛ. ОТКАЗ ОТ УДАРОВ ПО ЭНЕРГЕТИКЕ НИЧЕГО НЕ ГОВОРИТ
Dialogue: 0,0:03:47.39,0:03:50.19,Caption,,0,0,0,,О ПОСТАВКАХ ОРУЖИЯ. РЕЖИМ В ЧЁРНОМ МОРЕ НЕ
Dialogue: 0,0:03:50.19,0:03:53.31,Caption,,0,0,0,,ОПРЕДЕЛЯЕТ СУДЬБУ ИНФРАСТРУКТУРЫ НАТО. ВСЕОБЩАЯ
Dialogue: 0,0:03:53.31,0:03:55.79,Caption,,0,0,0,,ОСТАНОВКА ОГНЯ НЕ УСТАНАВЛИВАЕТ ПРЕДЕЛОВ ДЛЯ
Dialogue: 0,0:03:55.87,0:03:59.15,Caption,,0,0,0,,БУДУЩЕГО РАЗМЕЩЕНИЯ ВОЙСК И РАКЕТ. КИЕВ ПРЕДЛАГАЕТ
Dialogue: 0,0:03:59.15,0:04:02.11,Caption,,0,0,0,,ПЕРЕКРЫТЬ НЕСКОЛЬКО ВЕНТИЛЕЙ. РОССИЯ ИНТЕРЕСУЕТСЯ
Dialogue: 0,0:04:02.11,0:04:05.15,Caption,,0,0,0,,ВСЕЙ СХЕМОЙ ВОДОСНАБЖЕНИЯ, ВКЛЮЧАЯ ТОГО МАСТЕРА,
Dialogue: 0,0:04:05.31,0:04:07.63,Caption,,0,0,0,,КОТОРЫЙ ПРОВЁЛ ТРУБУ ПРЯМО ЧЕРЕЗ СПАЛЬНЮ.
Dialogue: 0,0:04:09.90,0:04:11.90,Caption,,0,0,0,,РАЗГОВОР ПОЭТОМУ ИДЁТ ОДНОВРЕМЕННО,
Dialogue: 0,0:04:12.14,0:04:15.18,Caption,,0,0,0,,НО СЛОВНО ПО ДВУМ РАЗНЫМ АДРЕСАМ. КИЕВ ПЫТАЕТСЯ
Dialogue: 0,0:04:15.18,0:04:17.74,Caption,,0,0,0,,ПОСТАВИТЬ ТОЧКУ ХОТЯ БЫ В НЫНЕШНЕЙ ФАЗЕ ВОЙНЫ.
Dialogue: 0,0:04:18.06,0:04:20.70,Caption,,0,0,0,,МОСКВА ОБСУЖДАЕТ БУДУЩИЕ ОТНОШЕНИЯ С ЗАПАДОМ.
Dialogue: 0,0:04:21.03,0:04:24.06,Caption,,0,0,0,,ТЕРМИНЫ ЗВУЧАТ ОДИНАКОВО, ПЕРЕВОД НЕ ТРЕБУЕТСЯ,
Dialogue: 0,0:04:24.27,0:04:28.22,Caption,,0,0,0,,УЧАСТНИКИ КИВАЮТ, А ОТВЕЧАЮТ КАЖДЫЙ НА СВОЙ ВОПРОС. ПОЛУЧАЕТСЯ
Dialogue: 0,0:04:28.22,0:04:30.86,Caption,,0,0,0,,СОВЕЩАНИЕ, ГДЕ ОДИН ЗАКАЗЫВАЕТ УЖИН,
Dialogue: 0,0:04:31.02,0:04:33.02,Caption,,0,0,0,,ДРУГОЙ ТРЕБУЕТ ПРОВЕРИТЬ ПРОВОДКУ,
Dialogue: 0,0:04:33.18,0:04:35.42,Caption,,0,0,0,,И ОБА УДИВЛЕНЫ ОТСУТСТВИЕМ РЕЗУЛЬТАТА.
Dialogue: 0,0:04:37.70,0:04:41.62,Caption,,0,0,0,,СЛЕДОМ США, ЕВРОСОЮЗ И УКРАИНА ВЫСТУПИЛИ С СОВМЕСТНЫМ
Dialogue: 0,0:04:41.70,0:04:44.50,Caption,,0,0,0,,ЗАЯВЛЕНИЕМ. В НЁМ ГОВОРИТСЯ О СУВЕРЕНИТЕТЕ,
Dialogue: 0,0:04:44.66,0:04:49.62,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНОЙ ЦЕЛОСТНОСТИ, СВОБОДЕ ВЫБОРА И НАДЁЖНЫХ ГАРАНТИЯХ. СТИВ УИТКОФФ
Dialogue: 0,0:04:49.70,0:04:53.30,Caption,,0,0,0,,РАССКАЗАЛ, ЧТО ДЛЯ ЗАЩИТЫ УКРАИНЫ РАССМАТРИВАЕТСЯ ИСПОЛЬЗОВАНИЕ
Dialogue: 0,0:04:53.30,0:04:56.02,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ИНСТИТУТОВ И УЖЕ СУЩЕСТВУЮЩИХ
Dialogue: 0,0:04:56.02,0:05:01.65,Caption,,0,0,0,,СОГЛАШЕНИЙ. ПРИ ЭТОМ В ВАШИНГТОНЕ НАЧАЛИ ВСЛУХ ПРИЗНАВАТЬ ВЕЩЬ,
Dialogue: 0,0:05:01.89,0:05:04.61,Caption,,0,0,0,,КОТОРУЮ РАНЬШЕ СТАРАЛИСЬ ОБХОДИТЬ. МАРКО РУБИО
Dialogue: 0,0:05:04.61,0:05:08.69,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО ГАРАНТИИ ДОЛЖНЫ ЗАЩИЩАТЬ УКРАИНУ И ОДНОВРЕМЕННО
Dialogue: 0,0:05:08.77,0:05:11.65,Caption,,0,0,0,,ОСТАВАТЬСЯ ПРИЕМЛЕМЫМИ ДЛЯ РОССИИ. ИНАЧЕ ОНИ НЕ
Dialogue: 0,0:05:11.73,0:05:14.93,Caption,,0,0,0,,СТАНУТ РАБОЧИМ МЕХАНИЗМОМ. ГОТОВОГО РЕШЕНИЯ ПОКА
Dialogue: 0,0:05:15.01,0:05:18.69,Caption,,0,0,0,,НЕТ, НО САМА ПОСТАНОВКА ВОПРОСА УЖЕ ЗАМЕТНО ОТЛИЧАЕТСЯ ОТ
Dialogue: 0,0:05:18.77,0:05:24.33,Caption,,0,0,0,,ПРЕЖНЕЙ. ЛОГИКА ЗДЕСЬ ПОЧТИ ВЫЗЫВАЮЩЕ НОРМАЛЬНАЯ. ЕСЛИ
Dialogue: 0,0:05:24.33,0:05:26.97,Caption,,0,0,0,,СОГЛАШЕНИЕ ДОЛЖНО ЗАВЕРШИТЬ КОНФЛИКТ С РОССИЕЙ,
Dialogue: 0,0:05:27.21,0:05:28.89,Caption,,0,0,0,,ЕГО ТРУДНО ПОДГОТОВИТЬ ВТРОЁМ,
Dialogue: 0,0:05:29.05,0:05:31.93,Caption,,0,0,0,,А МОСКВЕ ОСТАВИТЬ ТОЛЬКО МЕСТО ДЛЯ ПОДПИСИ. ЭТО
Dialogue: 0,0:05:32.01,0:05:34.17,Caption,,0,0,0,,УЖЕ НЕ ПЕРЕГОВОРЫ, А СЕМЕЙНЫЙ СОВЕТ,
Dialogue: 0,0:05:34.49,0:05:36.33,Caption,,0,0,0,,НА КОТОРОМ ЧЕЛОВЕКУ ВЫБРАЛИ РАБОТУ,
Dialogue: 0,0:05:36.42,0:05:40.17,Caption,,0,0,0,,КВАРТИРУ И ДАТУ ПЕРЕЕЗДА. ЕГО УЧАСТИЕ ПРЕДПОЛАГАЕТСЯ
Dialogue: 0,0:05:40.25,0:05:43.21,Caption,,0,0,0,,В САМОМ КОНЦЕ, КОГДА ПОТРЕБУЕТСЯ ОПЛАТИТЬ ГРУЗЧИКОВ.
Dialogue: 0,0:05:45.48,0:05:50.28,Caption,,0,0,0,,УКРАИНЕ, РАЗУМЕЕТСЯ, НУЖНЫ ГАРАНТИИ. КИЕВ ЗАХОЧЕТ ПОЛУЧИТЬ СИСТЕМУ,
Dialogue: 0,0:05:50.52,0:05:53.08,Caption,,0,0,0,,КОТОРАЯ НЕ ИСЧЕЗНЕТ ПОСЛЕ ВЫБОРОВ ИЛИ СМЕНЫ
Dialogue: 0,0:05:53.08,0:05:55.80,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА В ОЧЕРЕДНОЙ ЗАПАДНОЙ СТОЛИЦЕ. НО
Dialogue: 0,0:05:55.80,0:05:58.52,Caption,,0,0,0,,СОДЕРЖАНИЕ ТАКИХ ОБЯЗАТЕЛЬСТВ ИМЕЕТ РЕШАЮЩЕЕ
Dialogue: 0,0:05:58.52,0:06:02.44,Caption,,0,0,0,,ЗНАЧЕНИЕ. ТО, ЧТО УКРАИНСКАЯ СТОРОНА НАЗОВЁТ ЗАЩИТОЙ,
Dialogue: 0,0:06:02.77,0:06:05.32,Caption,,0,0,0,,МОСКВА МОЖЕТ РАСЦЕНИТЬ КАК ЗАРАНЕЕ ОБОРУДОВАННУЮ
Dialogue: 0,0:06:05.32,0:06:11.69,Caption,,0,0,0,,ПЛОЩАДКУ ДЛЯ НОВОЙ УГРОЗЫ. ЕСЛИ ГАРАНТИИ ПРЕДУСМАТРИВАЮТ РАЗМЕЩЕНИЕ СИЛ,
Dialogue: 0,0:06:11.85,0:06:14.57,Caption,,0,0,0,,НЕПРИЕМЛЕМОЕ ДЛЯ РОССИИ, СОГЛАСИЯ НЕ БУДЕТ.
Dialogue: 0,0:06:15.13,0:06:18.01,Caption,,0,0,0,,ЕСЛИ НАТО ОСТАВЛЯЕТ БЕЗ ОГРАНИЧЕНИЙ ИНФРАСТРУКТУРУ У
Dialogue: 0,0:06:18.01,0:06:22.49,Caption,,0,0,0,,РОССИЙСКИХ ГРАНИЦ, ГЛАВНАЯ ПРИЧИНА СПОРА СОХРАНЯЕТСЯ. ЕСЛИ КИЕВУ
Dialogue: 0,0:06:22.49,0:06:26.73,Caption,,0,0,0,,ОБЕЩАЮТ ПОМОЩЬ, А СПОСОБ ЕЁ ОКАЗАНИЯ ОЗНАЧАЕТ ДАЛЬНЕЙШЕЕ ПРОДВИЖЕНИЕ
Dialogue: 0,0:06:26.81,0:06:31.37,Caption,,0,0,0,,ВОЕННОГО СОЮЗА, НОВАЯ УПАКОВКА НИЧЕГО НЕ МЕНЯЕТ. КОРОБКА БЛЕСТИТ,
Dialogue: 0,0:06:31.59,0:06:35.21,Caption,,0,0,0,,ЛЕНТОЧКА ЗАВЯЗАНА, ВНУТРИ ЛЕЖИТ ТОТ ЖЕ СТАРЫЙ КОНФЛИКТ.
Dialogue: 0,0:06:37.50,0:06:40.14,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ОДНОЙ СТОРОНЫ НЕЛЬЗЯ УСТРОИТЬ ТАК,
Dialogue: 0,0:06:40.36,0:06:42.94,Caption,,0,0,0,,ЧТОБЫ ДРУГАЯ НЕМЕДЛЕННО ПОЧУВСТВОВАЛА СЕБЯ В БОЛЬШЕЙ
Dialogue: 0,0:06:43.02,0:06:45.74,Caption,,0,0,0,,ОПАСНОСТИ. РОССИЯ В ТАКОМ СЛУЧАЕ НАРАЩИВАЕТ
Dialogue: 0,0:06:45.74,0:06:49.50,Caption,,0,0,0,,ВОЗМОЖНОСТИ. НАТО ОТВЕЧАЕТ УСИЛЕНИЕМ. МОСКВА ДЕЛАЕТ
Dialogue: 0,0:06:49.50,0:06:52.14,Caption,,0,0,0,,СЛЕДУЮЩИЙ ШАГ. В РЕЗУЛЬТАТЕ БЮДЖЕТЫ СТАНОВЯТСЯ
Dialogue: 0,0:06:52.14,0:06:54.38,Caption,,0,0,0,,ТЯЖЕЛЕЕ, РАКЕТ СТАНОВИТСЯ БОЛЬШЕ,
Dialogue: 0,0:06:54.69,0:06:57.58,Caption,,0,0,0,,А СПОКОЙСТВИЯ МЕНЬШЕ. ВСЕ БОДРО ДОКЛАДЫВАЮТ ОБ
Dialogue: 0,0:06:57.58,0:07:00.54,Caption,,0,0,0,,УКРЕПЛЕНИИ ЗАЩИТЫ И НАЧИНАЮТ НЕРВНИЧАТЬ ДАЖЕ ОТ
Dialogue: 0,0:07:00.54,0:07:06.81,Caption,,0,0,0,,ХЛОПНУВШЕЙ ДВЕРИ. ДЕЙСТВУЮЩАЯ СИСТЕМА СТРОИТСЯ НА ПОДРОБНОСТЯХ. ГДЕ
Dialogue: 0,0:07:06.89,0:07:10.01,Caption,,0,0,0,,МОГУТ НАХОДИТЬСЯ ВООРУЖЕНИЯ. КАКИЕ КОМПЛЕКСЫ НЕЛЬЗЯ
Dialogue: 0,0:07:10.01,0:07:13.29,Caption,,0,0,0,,РАЗМЕЩАТЬ. КАКАЯ ДИСТАНЦИЯ ДОЛЖНА СОХРАНЯТЬСЯ МЕЖДУ
Dialogue: 0,0:07:13.29,0:07:16.65,Caption,,0,0,0,,СИЛАМИ. КТО ПРОВОДИТ ПРОВЕРКИ. ЗА СКОЛЬКО ВРЕМЕНИ
Dialogue: 0,0:07:16.65,0:07:19.93,Caption,,0,0,0,,СООБЩАЮТ ОБ УЧЕНИЯХ. КАКИМ КАНАЛОМ СВЯЗЫВАЮТСЯ ПРИ
Dialogue: 0,0:07:19.93,0:07:23.21,Caption,,0,0,0,,ОПАСНОМ СБЛИЖЕНИИ САМОЛЁТОВ. КАК ОТЛИЧАЮТ ПЛАНОВОЕ
Dialogue: 0,0:07:23.21,0:07:25.77,Caption,,0,0,0,,ПЕРЕМЕЩЕНИЕ ТЕХНИКИ ОТ ПОДГОТОВКИ УДАРА.
Dialogue: 0,0:07:28.04,0:07:30.60,Caption,,0,0,0,,НА ТОРЖЕСТВЕННОЙ СЦЕНЕ ТАКИЕ ПУНКТЫ ЗВУЧАТ КУДА
Dialogue: 0,0:07:30.68,0:07:34.12,Caption,,0,0,0,,СКУЧНЕЕ КРАСИВЫХ РЕЧЕЙ. ЗАТО ИМЕННО ОНИ НЕ ДАЮТ
Dialogue: 0,0:07:34.12,0:07:37.08,Caption,,0,0,0,,ОШИБКЕ ПРЕВРАТИТЬСЯ В КАТАСТРОФУ. СОВМЕСТНАЯ
Dialogue: 0,0:07:37.08,0:07:39.40,Caption,,0,0,0,,ФОТОГРАФИЯ ЛИДЕРОВ ПОЛЕЗНА ГЛАВНЫМ ОБРАЗОМ
Dialogue: 0,0:07:39.40,0:07:42.76,Caption,,0,0,0,,ФОТОГРАФУ. ПРОЦЕДУРА СРОЧНОЙ СВЯЗИ ИНОГДА ПОЛЕЗНА
Dialogue: 0,0:07:42.76,0:07:48.07,Caption,,0,0,0,,ЦЕЛОМУ ГОРОДУ. НА ЭТОМ ФОНЕ ОСОБЕННО ВЫРАЗИТЕЛЬНО ВЫГЛЯДИТ
Dialogue: 0,0:07:48.07,0:07:51.59,Caption,,0,0,0,,СООБЩЕНИЕ FINANCIAL TIMES. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА
Dialogue: 0,0:07:51.59,0:07:54.47,Caption,,0,0,0,,ОБСУЖДАЮТ ВОЗВРАЩЕНИЕ К ИНСТРУМЕНТАМ ВРЕМЁН ХОЛОДНОЙ
Dialogue: 0,0:07:54.47,0:07:57.35,Caption,,0,0,0,,ВОЙНЫ. РЕЧЬ ИДЁТ О КОНТРОЛЕ НАД ВООРУЖЕНИЯМИ,
Dialogue: 0,0:07:57.64,0:07:59.99,Caption,,0,0,0,,МЕРАХ ПРОТИВ ОПАСНЫХ ВОЕННЫХ ИНЦИДЕНТОВ,
Dialogue: 0,0:08:00.23,0:08:03.11,Caption,,0,0,0,,ВЗАИМНОМ НАБЛЮДЕНИИ И НЕКОТОРЫХ ЭЛЕМЕНТАХ ДОГОВОРА
Dialogue: 0,0:08:03.11,0:08:09.54,Caption,,0,0,0,,"ОТКРЫТОЕ НЕБО". ВОТ И СТАРЫЕ ЗНАКОМЫЕ. ЕЩЁ НЕДАВНО ЭТИ МЕХАНИЗМЫ
Dialogue: 0,0:08:09.62,0:08:11.30,Caption,,0,0,0,,СЧИТАЛИСЬ ПЕРЕЖИТКОМ ПРОШЛОГО,
Dialogue: 0,0:08:11.50,0:08:14.18,Caption,,0,0,0,,А ТЕПЕРЬ ИХ СНОВА ПРИГЛАШАЮТ К СТОЛУ. ОНИ,
Dialogue: 0,0:08:14.31,0:08:17.22,Caption,,0,0,0,,КОНЕЧНО, СЛЕГКА ЗАПЫЛИЛИСЬ В КОРИДОРЕ ИСТОРИИ,
Dialogue: 0,0:08:17.54,0:08:20.02,Caption,,0,0,0,,НО ДРУГИХ СПЕЦИАЛИСТОВ ПО ПРЕДОТВРАЩЕНИЮ БОЛЬШОЙ
Dialogue: 0,0:08:20.10,0:08:27.25,Caption,,0,0,0,,ВОЙНЫ ВНЕЗАПНО НЕ НАШЛОСЬ. СМЫСЛ "ОТКРЫТОГО НЕБА" БЫЛ ВПОЛНЕ ЗЕМНЫМ. УЧАСТНИКИ
Dialogue: 0,0:08:27.33,0:08:30.13,Caption,,0,0,0,,МОГЛИ НАБЛЮДАТЬ ЗА ВОЕННЫМИ ОБЪЕКТАМИ ДРУГ ДРУГА И
Dialogue: 0,0:08:30.13,0:08:32.69,Caption,,0,0,0,,УМЕНЬШАТЬ ПРОСТРАНСТВО ДЛЯ ОПАСНЫХ ПРЕДПОЛОЖЕНИЙ.
Dialogue: 0,0:08:33.09,0:08:35.49,Caption,,0,0,0,,КОГДА ВИДНО, ЧТО ПРОИСХОДИТ У СОСЕДА,
Dialogue: 0,0:08:35.73,0:08:38.05,Caption,,0,0,0,,ОБЫЧНЫЙ ГРУЗОВИК ТРУДНЕЕ ПРИНЯТЬ ЗА РАКЕТНЫЙ
Dialogue: 0,0:08:38.05,0:08:40.45,Caption,,0,0,0,,КОМПЛЕКС, ТРЕНИРОВКУ ЗА НАЧАЛО АТАКИ,
Dialogue: 0,0:08:40.69,0:08:43.49,Caption,,0,0,0,,А ОТКРЫТЫЕ ВОРОТА АНГАРА ЗА ПОСЛЕДНИЕ МИНУТЫ
Dialogue: 0,0:08:43.49,0:08:49.05,Caption,,0,0,0,,ЧЕЛОВЕЧЕСТВА. СНАЧАЛА ДОГОВОР ПОКИНУЛИ СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:08:49.29,0:08:52.09,Caption,,0,0,0,,ЗАТЕМ ИЗ НЕГО ВЫШЛА РОССИЯ. ВОЗМОЖНОСТЕЙ ДЛЯ
Dialogue: 0,0:08:52.09,0:08:56.49,Caption,,0,0,0,,ПРОВЕРКИ СТАЛО МЕНЬШЕ, А ПОДОЗРЕНИЙ ПРИБАВИЛОСЬ. ТЕПЕРЬ ЕВРОПА ОБСУЖДАЕТ
Dialogue: 0,0:08:56.57,0:08:59.37,Caption,,0,0,0,,ПОХОЖИЕ РЕШЕНИЯ СНОВА. ПОЛУЧИЛАСЬ ПРЕКРАСНАЯ
Dialogue: 0,0:08:59.37,0:09:02.49,Caption,,0,0,0,,ИННОВАЦИЯ ПО ЕВРОПЕЙСКОМУ РЕЦЕПТУ. СНАЧАЛА ВЫБРОСИТЬ
Dialogue: 0,0:09:02.49,0:09:06.49,Caption,,0,0,0,,РАБОЧИЙ ПРИБОР, ЗАТЕМ ИСПУГАТЬСЯ ТЕМНОТЫ И ТОРЖЕСТВЕННО ПРЕДСТАВИТЬ
Dialogue: 0,0:09:06.57,0:09:08.73,Caption,,0,0,0,,ТОТ ЖЕ ПРИБОР КАК ПЕРСПЕКТИВНЫЙ ПРОЕКТ.
Dialogue: 0,0:09:11.02,0:09:13.66,Caption,,0,0,0,,МОСКВА ПРЕДЛАГАЛА ОБСУЖДАТЬ РАСШИРЕНИЕ НАТО,
Dialogue: 0,0:09:13.83,0:09:17.26,Caption,,0,0,0,,РАЗМЕЩЕНИЕ ВООРУЖЕНИЙ, ДЕЯТЕЛЬНОСТЬ ВОЕННЫХ СОЮЗОВ,
Dialogue: 0,0:09:17.42,0:09:21.02,Caption,,0,0,0,,ИНФРАСТРУКТУРУ И ВЗАИМНЫЕ ОГРАНИЧЕНИЯ. ЗАПАД ОТВЕРГ
Dialogue: 0,0:09:21.02,0:09:23.58,Caption,,0,0,0,,ОСНОВНЫЕ РОССИЙСКИЕ ТРЕБОВАНИЯ. СОДЕРЖАНИЕ
Dialogue: 0,0:09:23.66,0:09:28.46,Caption,,0,0,0,,ПРЕДЛОЖЕНИЙ БЫЛО ИЗВЕСТНО, ОТВЕТ ТОЖЕ ПРОЗВУЧАЛ ЯСНО. ПОТЕРЯТЬ ПИСЬМО В ЭТОМ
Dialogue: 0,0:09:28.54,0:09:31.50,Caption,,0,0,0,,СЛУЧАЕ НЕ ПОЛУЧИТСЯ. НА НЁМ ДАЖЕ ПОЧЕРК РАЗБИРАТЬ
Dialogue: 0,0:09:31.50,0:09:37.30,Caption,,0,0,0,,НЕ ТРЕБОВАЛОСЬ. ПОЧТИ ЧЕРЕЗ ПЯТЬ ЛЕТ ЕВРОПЕЙСКИЕ СТОЛИЦЫ СНОВА
Dialogue: 0,0:09:37.38,0:09:39.30,Caption,,0,0,0,,ГОВОРЯТ О КОНТРОЛЕ, ПРОВЕРКАХ,
Dialogue: 0,0:09:39.44,0:09:42.50,Caption,,0,0,0,,ПРЕДОТВРАЩЕНИИ ИНЦИДЕНТОВ И ВОССТАНОВЛЕНИИ ДОВЕРИЯ.
Dialogue: 0,0:09:42.77,0:09:46.98,Caption,,0,0,0,,ЭТО НЕ ОЗНАЧАЕТ, ЧТО ОНИ ПРИНЯЛИ РОССИЙСКИЙ ПРОЕКТ. НАТО НЕ ПООБЕЩАЛО
Dialogue: 0,0:09:46.98,0:09:49.06,Caption,,0,0,0,,ВЕРНУТЬСЯ К РУБЕЖАМ ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО
Dialogue: 0,0:09:49.06,0:09:52.10,Caption,,0,0,0,,СЕДЬМОГО ГОДА. НИКТО В ЕВРОПЕ НЕ НАЧАЛ СВОРАЧИВАТЬ
Dialogue: 0,0:09:52.18,0:09:54.42,Caption,,0,0,0,,БАЗЫ И ЗАКАЗЫВАТЬ ГРУЗОВИКИ ДЛЯ ПЕРЕЕЗДА.
Dialogue: 0,0:09:56.70,0:09:59.26,Caption,,0,0,0,,НО НА СТОЛ ВЕРНУЛИСЬ САМИ ВОПРОСЫ. И ЭТО
Dialogue: 0,0:09:59.34,0:10:05.94,Caption,,0,0,0,,УЖЕ ВАЖНОЕ ИЗМЕНЕНИЕ. ДО ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА РОССИЯ
Dialogue: 0,0:10:05.94,0:10:08.98,Caption,,0,0,0,,НАСТАИВАЛА НА ОБСУЖДЕНИИ ОБЩЕЙ СИСТЕМЫ ОТНОШЕНИЙ С
Dialogue: 0,0:10:08.98,0:10:12.66,Caption,,0,0,0,,НАТО. ТЕПЕРЬ ЕВРОПЕЙЦЫ САМИ ИЩУТ ОГРАНИЧЕНИЯ ВОЕННОЙ
Dialogue: 0,0:10:12.66,0:10:16.02,Caption,,0,0,0,,АКТИВНОСТИ, СПОСОБЫ ПРОВЕРКИ И ЗАЩИТУ ОТ СЛУЧАЙНОГО
Dialogue: 0,0:10:16.02,0:10:19.70,Caption,,0,0,0,,СТОЛКНОВЕНИЯ. МЕТОДИЧКА ВСЁ ВРЕМЯ ЛЕЖАЛА В ШКАФУ. ЕЁ
Dialogue: 0,0:10:19.78,0:10:22.98,Caption,,0,0,0,,ДОСТАЛИ ПОСЛЕ ТОГО, КАК ЭКЗАМЕН ЗАКОНЧИЛСЯ ПОЖАРОМ,
Dialogue: 0,0:10:23.19,0:10:26.74,Caption,,0,0,0,,АУДИТОРИЮ ЗАЛИЛО ВОДОЙ, А ДЕКАН ДОЛГО УВЕРЯЛ ВСЕХ,
Dialogue: 0,0:10:26.90,0:10:33.18,Caption,,0,0,0,,ЧТО ПРЕДМЕТ УСТАРЕЛ. ТОЛЬКО ВЕСТИ ТОТ ЖЕ РАЗГОВОР ТЕПЕРЬ ГОРАЗДО ТРУДНЕЕ.
Dialogue: 0,0:10:33.61,0:10:36.78,Caption,,0,0,0,,НЕДОВЕРИЕ СТАЛО ГЛУБЖЕ. ЧИСЛО ПОГИБШИХ И МАСШТАБ
Dialogue: 0,0:10:36.86,0:10:40.06,Caption,,0,0,0,,РАЗРУШЕНИЙ ВЫРОСЛИ. ПОЯВИЛИСЬ НОВЫЕ ОБЯЗАТЕЛЬСТВА,
Dialogue: 0,0:10:40.22,0:10:43.02,Caption,,0,0,0,,НОВЫЕ УЧАСТНИКИ И НОВЫЕ ПРИЧИНЫ ПОДОЗРЕВАТЬ ДРУГ
Dialogue: 0,0:10:43.02,0:10:45.34,Caption,,0,0,0,,ДРУГА. РАНЬШЕ МОЖНО БЫЛО ОБСУЖДАТЬ,
Dialogue: 0,0:10:45.58,0:10:48.30,Caption,,0,0,0,,КАК ИЗБЕЖАТЬ БЕДСТВИЯ. ТЕПЕРЬ ТЕ ЖЕ ПРАВИЛА
Dialogue: 0,0:10:48.30,0:10:51.42,Caption,,0,0,0,,ПРИХОДИТСЯ СОГЛАСОВЫВАТЬ СРЕДИ ЕГО ПОСЛЕДСТВИЙ. ЗА
Dialogue: 0,0:10:51.42,0:10:53.26,Caption,,0,0,0,,ОПОЗДАНИЕ ВЫСТАВИЛИ ТАКОЙ СЧЁТ,
Dialogue: 0,0:10:53.54,0:10:55.66,Caption,,0,0,0,,ЧТО ОФИЦИАНТ ПРИНЁС ЕГО ОБЕИМИ РУКАМИ.
Dialogue: 0,0:10:57.94,0:11:00.90,Caption,,0,0,0,,В ЭТУ ОБСТАНОВКУ ПРИЕЗЖАЕТ ДЖАРЕД КУШНЕР. ПОСЛЕ
Dialogue: 0,0:11:00.90,0:11:03.22,Caption,,0,0,0,,КОНТАКТОВ С ВЛАДИМИРОМ ПУТИНЫМ ОН СООБЩАЕТ,
Dialogue: 0,0:11:03.46,0:11:06.10,Caption,,0,0,0,,ЧТО АМЕРИКАНСКАЯ СТОРОНА ВИДИТ ГОТОВНОСТЬ РОССИИ
Dialogue: 0,0:11:06.10,0:11:08.58,Caption,,0,0,0,,ЗАКЛЮЧИТЬ МИРНОЕ СОГЛАШЕНИЕ ПРИ СОБЛЮДЕНИИ
Dialogue: 0,0:11:08.58,0:11:15.35,Caption,,0,0,0,,ОПРЕДЕЛЁННЫХ УСЛОВИЙ. НАБЛЮДЕНИЕ ВПЕЧАТЛЯЮЩЕЕ. ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:11:15.43,0:11:17.67,Caption,,0,0,0,,ПЕРВОМ ГОДУ МОСКВА ПРЕДСТАВИЛА ПРОЕКТЫ,
Dialogue: 0,0:11:17.85,0:11:21.11,Caption,,0,0,0,,ПЕРЕЧИСЛИЛА ТРЕБОВАНИЯ И ПРЕДЛОЖИЛА ОБСУЖДЕНИЕ. ЕЙ
Dialogue: 0,0:11:21.11,0:11:23.67,Caption,,0,0,0,,ОТКАЗАЛИ. ТЕПЕРЬ АМЕРИКАНСКИЙ ПРЕДСТАВИТЕЛЬ
Dialogue: 0,0:11:23.67,0:11:25.51,Caption,,0,0,0,,ПОГОВОРИЛ С ПУТИНЫМ И УСТАНОВИЛ,
Dialogue: 0,0:11:25.66,0:11:27.83,Caption,,0,0,0,,ЧТО РОССИЯ СОГЛАСНА ДОГОВАРИВАТЬСЯ,
Dialogue: 0,0:11:28.07,0:11:31.11,Caption,,0,0,0,,ЕСЛИ ДОГОВОРЁННОСТЬ БУДЕТ УЧИТЫВАТЬ ЕЁ УСЛОВИЯ. ЕЩЁ
Dialogue: 0,0:11:31.11,0:11:33.27,Caption,,0,0,0,,НЕСКОЛЬКО ВСТРЕЧ, И МИРУ СООБЩАТ,
Dialogue: 0,0:11:33.47,0:11:36.15,Caption,,0,0,0,,ЧТО НА ПЕРЕГОВОРАХ СТОРОНЫ ИНОГДА ХОТЯТ ПОЛУЧИТЬ ЧТО
Dialogue: 0,0:11:36.23,0:11:41.69,Caption,,0,0,0,,ТО ВЗАМЕН. ГОТОВНОСТЬ МОСКВЫ К РАЗГОВОРУ САМА ПО СЕБЕ ДАВНО
Dialogue: 0,0:11:41.77,0:11:44.97,Caption,,0,0,0,,НЕ СЕНСАЦИЯ. НАСТОЯЩЕЕ ИЗМЕНЕНИЕ МОЖЕТ СОСТОЯТЬ В
Dialogue: 0,0:11:44.97,0:11:49.29,Caption,,0,0,0,,ДРУГОМ. ВАШИНГТОН, ВОЗМОЖНО, НАЧИНАЕТ РАССМАТРИВАТЬ ВОПРОСЫ,
Dialogue: 0,0:11:49.45,0:11:51.93,Caption,,0,0,0,,КОТОРЫЕ ПРЕЖДЕ ДАЖЕ НЕ ДОПУСКАЛ К ОБСУЖДЕНИЮ.
Dialogue: 0,0:11:54.20,0:11:56.92,Caption,,0,0,0,,ЧТО ИМЕННО АМЕРИКАНЦЫ ГОТОВЫ ВКЛЮЧИТЬ В ПОВЕСТКУ?
Dialogue: 0,0:11:57.14,0:11:59.48,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО? РАКЕТНЫЕ СИСТЕМЫ?
Dialogue: 0,0:11:59.80,0:12:02.04,Caption,,0,0,0,,ВОЕННЫЕ ОБЪЕКТЫ ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ?
Dialogue: 0,0:12:02.36,0:12:06.44,Caption,,0,0,0,,ПРЕДЕЛЫ АКТИВНОСТИ СОЮЗОВ? ВОЗВРАЩЕНИЕ КОНТРОЛЯ И ВЗАИМНЫХ ПРОВЕРОК?
Dialogue: 0,0:12:07.06,0:12:09.48,Caption,,0,0,0,,ЕСЛИ ПРЕЖНИЕ ЗАПРЕТЫ ДЕЙСТВИТЕЛЬНО ОСЛАБЛИ,
Dialogue: 0,0:12:09.72,0:12:12.76,Caption,,0,0,0,,ТОГДА ПЕРЕГОВОРЫ ПОЛУЧИЛИ НОВОЕ СОДЕРЖАНИЕ. ЕСЛИ
Dialogue: 0,0:12:12.76,0:12:15.56,Caption,,0,0,0,,НЕТ, ПЕРЕД НАМИ ЛИШЬ ЕЩЁ ОДНА НОВОСТЬ О ТОМ,
Dialogue: 0,0:12:15.72,0:12:17.88,Caption,,0,0,0,,ЧТО ЛЮДИ ГОТОВЫ ВСТРЕТИТЬСЯ И СНОВА НИ О
Dialogue: 0,0:12:17.96,0:12:24.17,Caption,,0,0,0,,ЧЁМ НЕ ДОГОВОРИТЬСЯ. ФРАЗА О ГОТОВНОСТИ ПУТИНА К СОГЛАШЕНИЮ ПОЧТИ НИЧЕГО
Dialogue: 0,0:12:24.17,0:12:27.21,Caption,,0,0,0,,НЕ ОБЪЯСНЯЕТ БЕЗ ПЕРЕЧНЯ ДОПУСТИМЫХ ТЕМ. МОСКВА
Dialogue: 0,0:12:27.21,0:12:29.93,Caption,,0,0,0,,СОГЛАШАЛАСЬ РАЗГОВАРИВАТЬ И РАНЬШЕ. РАЗГОВОР НЕ
Dialogue: 0,0:12:30.01,0:12:34.49,Caption,,0,0,0,,ПРИВЁЛ К ДОГОВОРЁННОСТИ, А ЦЕНУ ПРОВАЛА ЗАТЕМ УВИДЕЛИ ВСЕ. ПОЭТОМУ ВАЖЕН
Dialogue: 0,0:12:34.49,0:12:37.61,Caption,,0,0,0,,НЕ САМ ВХОД РОССИИ В КОМНАТУ, А СПИСОК ВОПРОСОВ,
Dialogue: 0,0:12:37.80,0:12:40.25,Caption,,0,0,0,,КОТОРЫЕ ВАШИНГТОН ПОЗВОЛИТ ПОЛОЖИТЬ НА СТОЛ,
Dialogue: 0,0:12:40.33,0:12:46.69,Caption,,0,0,0,,НЕ ВЫЗЫВАЯ ОХРАНУ. У США ОСТАЁТСЯ ЕВРОПЕЙСКАЯ ПРОБЛЕМА. ЧАСТЬ
Dialogue: 0,0:12:46.69,0:12:49.41,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ГОСУДАРСТВ ОЦЕНИВАЕТ БУДУЩУЮ СДЕЛКУ
Dialogue: 0,0:12:49.49,0:12:52.29,Caption,,0,0,0,,ЧЕРЕЗ ИНТЕРЕСЫ УКРАИНЫ И БОИТСЯ РЕЗУЛЬТАТА,
Dialogue: 0,0:12:52.45,0:12:54.61,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ ВЫГЛЯДЕТЬ НАГРАДОЙ РОССИИ ЗА
Dialogue: 0,0:12:54.69,0:12:58.05,Caption,,0,0,0,,ПРИМЕНЕНИЕ СИЛЫ. ДЛЯ МОСКВЫ ИСХОДНОЙ ТОЧКОЙ ОСТАЮТСЯ
Dialogue: 0,0:12:58.05,0:13:01.09,Caption,,0,0,0,,ПРИЧИНЫ КОНФЛИКТА И ПРЕЖНЕЕ УСТРОЙСТВО ОТНОШЕНИЙ С
Dialogue: 0,0:13:01.09,0:13:03.81,Caption,,0,0,0,,НАТО. ЭТИ ПОЗИЦИИ НЕ СХОДЯТСЯ ОТТОГО,
Dialogue: 0,0:13:03.96,0:13:05.97,Caption,,0,0,0,,ЧТО ИХ НАПЕЧАТАЛИ НА КРАСИВОЙ БУМАГЕ.
Dialogue: 0,0:13:08.23,0:13:10.63,Caption,,0,0,0,,ВАШИНГТОН ОКАЗЫВАЕТСЯ МЕЖДУ СОЮЗНИЧЕСКИМИ
Dialogue: 0,0:13:10.63,0:13:13.35,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВАМИ И НЕОБХОДИМОСТЬЮ ПОЛУЧИТЬ СОГЛАСИЕ
Dialogue: 0,0:13:13.35,0:13:16.79,Caption,,0,0,0,,РОССИИ. ПАРТНЁРОВ НУЖНО ПОДДЕРЖИВАТЬ. НО СОГЛАШЕНИЕ
Dialogue: 0,0:13:16.87,0:13:20.55,Caption,,0,0,0,,С МОСКВОЙ НЕВОЗМОЖНО, ЕСЛИ ЗАРАНЕЕ ЗАПРЕТИТЬ ОБСУЖДАТЬ ВСЁ,
Dialogue: 0,0:13:20.71,0:13:23.43,Caption,,0,0,0,,РАДИ ЧЕГО ОНА ВООБЩЕ ПРИХОДИТ. МОЖНО ПРОВОДИТЬ
Dialogue: 0,0:13:23.43,0:13:27.59,Caption,,0,0,0,,ЗАСЕДАНИЯ БЕЗ НЕЁ, РАССТАВЛЯТЬ ТАБЛИЧКИ И РАЗЛИВАТЬ ВОДУ ПО СТАКАНАМ.
Dialogue: 0,0:13:27.85,0:13:30.23,Caption,,0,0,0,,ПУСТОЕ КРЕСЛО ВСЁ РАВНО БУДЕТ ЗАНЯТО РОССИЙСКИМИ
Dialogue: 0,0:13:30.23,0:13:32.87,Caption,,0,0,0,,ТРЕБОВАНИЯМИ, ПРОСТО ОНИ НЕ СТАНУТ ПИТЬ ВОДУ.
Dialogue: 0,0:13:35.14,0:13:37.78,Caption,,0,0,0,,ИСХОДНАЯ ПОЗИЦИЯ МОСКВЫ ПРИ ЭТОМ ОСТАЁТСЯ ПОЧТИ
Dialogue: 0,0:13:37.78,0:13:41.06,Caption,,0,0,0,,ПРЕЖНЕЙ. БУДУЩИЙ ПОРЯДОК ДОЛЖЕН УЧИТЫВАТЬ РОССИЙСКОЕ
Dialogue: 0,0:13:41.06,0:13:44.34,Caption,,0,0,0,,ПОНИМАНИЕ СОБСТВЕННОЙ БЕЗОПАСНОСТИ. ВОКРУГ МОЖНО
Dialogue: 0,0:13:44.34,0:13:47.14,Caption,,0,0,0,,ВЫПУСКАТЬ ЗАЯВЛЕНИЯ, СОБИРАТЬ КОАЛИЦИИ,
Dialogue: 0,0:13:47.23,0:13:50.58,Caption,,0,0,0,,УТВЕРЖДАТЬ ПАКЕТЫ ПОМОЩИ И СОЗДАВАТЬ ГАРАНТИИ. НО
Dialogue: 0,0:13:50.58,0:13:53.14,Caption,,0,0,0,,НЕРЕШЁННЫЙ ОСНОВНОЙ ВОПРОС ВЕРНЁТСЯ В СЛЕДУЮЩИЙ
Dialogue: 0,0:13:53.22,0:13:55.94,Caption,,0,0,0,,ПРОЕКТ. ОБЫЧНО ОН ПОЯВЛЯЕТСЯ ИМЕННО ТАМ,
Dialogue: 0,0:13:56.20,0:13:58.58,Caption,,0,0,0,,ГДЕ СОСТАВИТЕЛИ НАДЕЯЛИСЬ ПОСТАВИТЬ ПРИЛОЖЕНИЕ
Dialogue: 0,0:13:58.58,0:14:02.53,Caption,,0,0,0,,МЕЛКИМ ШРИФТОМ. ЭТО НЕ ЗНАЧИТ,
Dialogue: 0,0:14:02.77,0:14:05.25,Caption,,0,0,0,,ЧТО ЗАПАДУ ОСТАЁТСЯ ПРИНЯТЬ РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:14:05.25,0:14:08.29,Caption,,0,0,0,,ЦЕЛИКОМ. ТОГДА ТОРГ БЫЛ БЫ НЕ НУЖЕН. ОДНИ
Dialogue: 0,0:14:08.29,0:14:12.05,Caption,,0,0,0,,УСЛОВИЯ СМЯГЧАЮТ, ДРУГИЕ СВЯЗЫВАЮТ СО ВСТРЕЧНЫМИ ШАГАМИ,
Dialogue: 0,0:14:12.22,0:14:16.93,Caption,,0,0,0,,ТРЕТЬИ ОБМЕНИВАЮТ, ЧЕТВЁРТЫЕ ОТКЛАДЫВАЮТ. НО ТОРГ НАЧИНАЕТСЯ ЛИШЬ ПОСЛЕ
Dialogue: 0,0:14:16.93,0:14:20.45,Caption,,0,0,0,,ПРИЗНАНИЯ, ЧТО ТРЕБОВАНИЯ ВТОРОЙ СТОРОНЫ ЯВЛЯЮТСЯ ЧАСТЬЮ
Dialogue: 0,0:14:20.45,0:14:24.13,Caption,,0,0,0,,СДЕЛКИ. ПУСТУЮ ПАПКУ ДЛЯ ЦЕРЕМОНИИ МОЖНО ВРУЧИТЬ И
Dialogue: 0,0:14:24.21,0:14:29.52,Caption,,0,0,0,,БЕЗ ПЕРЕГОВОРЩИКОВ. УКРАИНА ОТ ЭТОГО НЕ УХОДИТ НА ВТОРОЙ ПЛАН.
Dialogue: 0,0:14:29.92,0:14:32.08,Caption,,0,0,0,,БОЕВЫЕ ДЕЙСТВИЯ ИДУТ НА ЕЁ ТЕРРИТОРИИ,
Dialogue: 0,0:14:32.32,0:14:35.36,Caption,,0,0,0,,ОНА НЕСЁТ ОГРОМНЫЕ ПОТЕРИ И ХОЧЕТ ПОЛУЧИТЬ ЗАЩИТУ
Dialogue: 0,0:14:35.36,0:14:38.32,Caption,,0,0,0,,ПОСЛЕ ОКОНЧАНИЯ ВОЙНЫ. ОДНАКО БУДУЩАЯ СИСТЕМА
Dialogue: 0,0:14:38.32,0:14:41.20,Caption,,0,0,0,,НЕИЗБЕЖНО ВЫХОДИТ ЗА УКРАИНСКИЕ ГРАНИЦЫ. В НЕЙ
Dialogue: 0,0:14:41.20,0:14:44.88,Caption,,0,0,0,,ОКАЗЫВАЮТСЯ РОССИЯ И НАТО, ЕВРОПЕЙСКИЕ ВОЕННЫЕ ОБЪЕКТЫ,
Dialogue: 0,0:14:45.04,0:14:49.28,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА США, КОНТРОЛЬ НАД ВООРУЖЕНИЯМИ И ПРАВИЛА ПОВЕДЕНИЯ
Dialogue: 0,0:14:49.28,0:14:56.04,Caption,,0,0,0,,ГОСУДАРСТВ С ЯДЕРНЫМИ СИЛАМИ. ПОЭТОМУ ФОРМУЛА "СНАЧАЛА ПРЕКРАТИМ ОГОНЬ" НЕ
Dialogue: 0,0:14:56.04,0:14:59.24,Caption,,0,0,0,,ЗАКРЫВАЕТ РОССИЙСКИЕ ТРЕБОВАНИЯ. ДЛЯ КИЕВА ТИШИНА
Dialogue: 0,0:14:59.32,0:15:02.44,Caption,,0,0,0,,МОЖЕТ СТАТЬ НАЧАЛОМ БЕЗОПАСНОСТИ. ДЛЯ МОСКВЫ ТАКАЯ
Dialogue: 0,0:15:02.44,0:15:04.84,Caption,,0,0,0,,ЖЕ ТИШИНА СПОСОБНА ОЗНАЧАТЬ ВОССТАНОВЛЕНИЕ
Dialogue: 0,0:15:04.84,0:15:07.48,Caption,,0,0,0,,УКРАИНСКИХ ВОЗМОЖНОСТЕЙ ПРИ СОХРАНЕНИИ ВСЕГО,
Dialogue: 0,0:15:07.65,0:15:10.36,Caption,,0,0,0,,ЧТО РОССИЙСКОЕ РУКОВОДСТВО СЧИТАЕТ ПРИЧИНОЙ ВОЙНЫ.
Dialogue: 0,0:15:12.66,0:15:14.90,Caption,,0,0,0,,ЧЕРЕЗ ГОД ИЛИ НЕСКОЛЬКО ЛЕТ СПОР В ТАКОМ
Dialogue: 0,0:15:14.90,0:15:18.42,Caption,,0,0,0,,СЛУЧАЕ ВОЗВРАЩАЕТСЯ. ТОЛЬКО УКРЕПЛЕНИЯ УЖЕ ПРОЧНЕЕ,
Dialogue: 0,0:15:18.53,0:15:21.06,Caption,,0,0,0,,СКЛАДЫ ПОЛНЕЕ, ПЛАНЫ ОБНОВЛЕНЫ,
Dialogue: 0,0:15:21.30,0:15:24.42,Caption,,0,0,0,,А СПИСОК ВЗАИМНЫХ ОБВИНЕНИЙ ЗАНИМАЕТ ЕЩЁ ОДИН ШКАФ.
Dialogue: 0,0:15:24.82,0:15:28.26,Caption,,0,0,0,,ЭТО НЕ ОКОНЧАНИЕ КОНФЛИКТА, А ПЕРЕРЫВ МЕЖДУ ДЕЙСТВИЯМИ,
Dialogue: 0,0:15:28.50,0:15:30.98,Caption,,0,0,0,,ВО ВРЕМЯ КОТОРОГО ОРКЕСТР НЕ УХОДИТ ПИТЬ ЧАЙ.
Dialogue: 0,0:15:31.34,0:15:34.26,Caption,,0,0,0,,ОН МЕНЯЕТ НОТНЫЕ ПЮПИТРЫ НА ЯЩИКИ С БОЕПРИПАСАМИ.
Dialogue: 0,0:15:36.53,0:15:39.09,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:15:39.24,0:15:41.97,Caption,,0,0,0,,СМОГУТ ЛИ США И ЕВРОПА СОГЛАСОВАТЬ С РОССИЕЙ
Dialogue: 0,0:15:41.97,0:15:44.77,Caption,,0,0,0,,ВЗАИМНЫЕ ОГРАНИЧЕНИЯ ИЛИ ОПЯТЬ ПРИНЕСУТ ЕЙ
Dialogue: 0,0:15:44.77,0:15:48.93,Caption,,0,0,0,,ЗАПОЛНЕННЫЙ ДОГОВОР, ГДЕ СВОБОДНОЙ ОСТАВИЛИ ТОЛЬКО СТРОКУ ДЛЯ ПОДПИСИ.
Dialogue: 0,0:15:51.13,0:15:53.45,Caption,,0,0,0,,МИР НАЧИНАЕТСЯ НЕ С ПЕРВОЙ МИНУТЫ ТИШИНЫ,
Dialogue: 0,0:15:53.67,0:15:57.29,Caption,,0,0,0,,А С ИСЧЕЗНОВЕНИЯ ПРИЧИН СНОВА ОТКРЫТЬ ОГОНЬ. УКРАИНЕ
Dialogue: 0,0:15:57.37,0:16:00.97,Caption,,0,0,0,,НУЖНЫ ГАРАНТИИ, КОТОРЫЕ ПЕРЕЖИВУТ СМЕНУ ЗАПАДНЫХ ПРАВИТЕЛЬСТВ.
Dialogue: 0,0:16:01.27,0:16:05.61,Caption,,0,0,0,,РОССИИ НУЖНЫ ПРАВИЛА, КОТОРЫЕ ОНА НЕ ВОСПРИНИМАЕТ КАК ПОДГОТОВКУ УГРОЗЫ.
Dialogue: 0,0:16:06.01,0:16:08.65,Caption,,0,0,0,,ЕВРОПЕ ПРИДЁТСЯ ПОНИМАТЬ СТОИМОСТЬ СОБСТВЕННЫХ
Dialogue: 0,0:16:08.65,0:16:11.77,Caption,,0,0,0,,ОБЕЩАНИЙ. СОЕДИНЁННЫМ ШТАТАМ ПОТРЕБУЕТСЯ РЕШИТЬ,
Dialogue: 0,0:16:11.98,0:16:14.97,Caption,,0,0,0,,КАКИЕ ОБЯЗАТЕЛЬСТВА ОНИ ГОТОВЫ ВЫПОЛНЯТЬ ЧЕРЕЗ ПЯТЬ,
Dialogue: 0,0:16:15.12,0:16:18.89,Caption,,0,0,0,,ДЕСЯТЬ И ПЯТНАДЦАТЬ ЛЕТ, А НЕ ТОЛЬКО ДО СЛЕДУЮЩЕГО ГОЛОСОВАНИЯ.
Dialogue: 0,0:16:21.17,0:16:24.14,Caption,,0,0,0,,ПРИДЁТСЯ СОГЛАСОВАТЬ РАЙОНЫ РАЗМЕЩЕНИЯ СИЛ И РАКЕТ,
Dialogue: 0,0:16:24.42,0:16:26.62,Caption,,0,0,0,,ДОПУСТИМЫЕ ВИДЫ ВОЕННОЙ ДЕЯТЕЛЬНОСТИ,
Dialogue: 0,0:16:26.82,0:16:30.30,Caption,,0,0,0,,СПОСОБЫ НАБЛЮДЕНИЯ И ПОСЛЕДСТВИЯ НАРУШЕНИЙ. НУЖНЫ
Dialogue: 0,0:16:30.30,0:16:33.42,Caption,,0,0,0,,СРОЧНЫЕ ЛИНИИ СВЯЗИ, УВЕДОМЛЕНИЯ ОБ УЧЕНИЯХ,
Dialogue: 0,0:16:33.56,0:16:37.66,Caption,,0,0,0,,ИНСПЕКЦИИ И ЯСНЫЕ ДЕЙСТВИЯ ПРИ ОПАСНОМ ИНЦИДЕНТЕ. НА
Dialogue: 0,0:16:37.66,0:16:40.78,Caption,,0,0,0,,ЦЕРЕМОНИИ ЭТО НЕ ВЫЗЫВАЕТ АПЛОДИСМЕНТОВ. ЗАТО В
Dialogue: 0,0:16:40.78,0:16:43.74,Caption,,0,0,0,,МОМЕНТ КРИЗИСА ПОДОБНАЯ СКУКА ОКАЗЫВАЕТСЯ ПОЛЕЗНЕЕ
Dialogue: 0,0:16:43.82,0:16:50.33,Caption,,0,0,0,,САМЫХ ВДОХНОВЕННЫХ РЕЧЕЙ. ПАУЗА БЕЗ ТАКИХ РЕШЕНИЙ СОХРАНЯЕТ ВЕСЬ МЕХАНИЗМ
Dialogue: 0,0:16:50.33,0:16:55.05,Caption,,0,0,0,,ВОЙНЫ. ЕГО МОЖНО ЗАГЛУШИТЬ, ЗАКРЫТЬ ДВЕРЦУ И ПОВЕСИТЬ ТАБЛИЧКУ "НЕ ВКЛЮЧАТЬ".
Dialogue: 0,0:16:55.37,0:16:57.37,Caption,,0,0,0,,ОДНАКО ДЕТАЛИ ОСТАНУТСЯ НА МЕСТАХ,
Dialogue: 0,0:16:57.60,0:17:01.93,Caption,,0,0,0,,ТОПЛИВО БУДЕТ РЯДОМ, А ИНСТРУКЦИЯ НИКУДА НЕ ДЕНЕТСЯ. ДОСТАТОЧНО ОДНОМУ
Dialogue: 0,0:17:02.01,0:17:04.41,Caption,,0,0,0,,УЧАСТНИКУ РЕШИТЬ, ЧТО МОМЕНТ ПОДХОДЯЩИЙ,
Dialogue: 0,0:17:04.65,0:17:11.02,Caption,,0,0,0,,И АППАРАТ СНОВА ЗАРАБОТАЕТ. ПОЭТОМУ ОТКАЗ ЛАВРОВА НАПРАВЛЕН НЕ ТОЛЬКО ПРОТИВ
Dialogue: 0,0:17:11.02,0:17:14.46,Caption,,0,0,0,,КОНКРЕТНОГО ПРЕДЛОЖЕНИЯ О ПРЕКРАЩЕНИИ ОГНЯ. МОСКВА
Dialogue: 0,0:17:14.46,0:17:16.94,Caption,,0,0,0,,НЕ ПРИНИМАЕТ УКРАИНСКИЙ КОНФЛИКТ ЗА ОТДЕЛЬНУЮ
Dialogue: 0,0:17:16.94,0:17:20.86,Caption,,0,0,0,,НЕИСПРАВНОСТЬ, КОТОРУЮ МОЖНО УСТРАНИТЬ ОДНИМ ВЫКЛЮЧАТЕЛЕМ. ОНА
Dialogue: 0,0:17:20.86,0:17:24.22,Caption,,0,0,0,,ТРЕБУЕТ ИЗМЕНИТЬ ВСЮ СИСТЕМУ ОТНОШЕНИЙ С НАТО. НА
Dialogue: 0,0:17:24.22,0:17:26.94,Caption,,0,0,0,,ЭТОМ ТРЕБОВАНИИ И БУДЕТ ДЕРЖАТЬСЯ ГЛАВНЫЙ СПОР
Dialogue: 0,0:17:27.02,0:17:33.06,Caption,,0,0,0,,ВОКРУГ БУДУЩЕЙ СДЕЛКИ. ВОЗВРАЩЕНИЕ ЕВРОПЕЙЦЕВ К СТАРЫМ ИНСТРУМЕНТАМ,
Dialogue: 0,0:17:33.36,0:17:36.58,Caption,,0,0,0,,СЛОВА РУБИО О ПРИЕМЛЕМОСТИ ГАРАНТИЙ ДЛЯ РОССИИ И
Dialogue: 0,0:17:36.58,0:17:39.06,Caption,,0,0,0,,СООБЩЕНИЕ КУШНЕРА ОБ УСЛОВИЯХ ПОКАЗЫВАЮТ,
Dialogue: 0,0:17:39.46,0:17:42.18,Caption,,0,0,0,,ЧТО ОСТАЛЬНЫЕ УЧАСТНИКИ МЕДЛЕННО ПОДХОДЯТ К ТОЙ ЖЕ
Dialogue: 0,0:17:42.26,0:17:45.30,Caption,,0,0,0,,ТЕМЕ. КАЖДЫЙ ДЕЛАЕТ ЭТО ОСТОРОЖНО И С ВЫРАЖЕНИЕМ
Dialogue: 0,0:17:45.30,0:17:48.90,Caption,,0,0,0,,ЧЕЛОВЕКА, КОТОРЫЙ ТОЛЬКО ЧТО САМОСТОЯТЕЛЬНО ОТКРЫЛ КОЛЕСО.
Dialogue: 0,0:17:49.37,0:17:51.70,Caption,,0,0,0,,ХОТЯ РОССИЙСКИЕ ПРОЕКТЫ ЛЕЖАЛИ ПЕРЕД НИМИ ЕЩЁ В
Dialogue: 0,0:17:51.78,0:17:53.86,Caption,,0,0,0,,ДЕКАБРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА.
Dialogue: 0,0:17:56.13,0:17:59.17,Caption,,0,0,0,,ТОГДА ОСНОВНЫЕ ПРЕДЛОЖЕНИЯ МОСКВЫ ОТКЛОНИЛИ. ТЕПЕРЬ
Dialogue: 0,0:17:59.17,0:18:01.89,Caption,,0,0,0,,ОБСУЖДЕНИЕ ВОЗВРАЩАЕТСЯ К ПОХОЖИМ ВОПРОСАМ ПОСЛЕ
Dialogue: 0,0:18:01.89,0:18:05.09,Caption,,0,0,0,,НЕСКОЛЬКИХ ЛЕТ ВОЙНЫ. ПОВТОРИТЬ ПРЕЖНИЙ ОТВЕТ УЖЕ НЕ
Dialogue: 0,0:18:05.09,0:18:08.29,Caption,,0,0,0,,ПОЛУЧИТСЯ ТАК ЖЕ ЛЕГКО. СЛИШКОМ ЗАМЕТНО ИЗМЕНИЛАСЬ
Dialogue: 0,0:18:08.29,0:18:12.61,Caption,,0,0,0,,СТОИМОСТЬ ОЧЕРЕДНОГО ОТКАЗА, И СПРЯТАТЬ ЕЁ СРЕДИ РАСХОДОВ НА КАНЦЕЛЯРИЮ НЕ
Dialogue: 0,0:18:12.61,0:18:18.66,Caption,,0,0,0,,УДАСТСЯ. ИРОНИЯ ЗДЕСЬ ВЫШЛА МРАЧНОЙ. ЧТОБЫ СНОВА ВСПОМНИТЬ О
Dialogue: 0,0:18:18.66,0:18:21.38,Caption,,0,0,0,,КОНТРОЛЕ НАД ВООРУЖЕНИЯМИ И ОБЩЕЙ БЕЗОПАСНОСТИ,
Dialogue: 0,0:18:21.77,0:18:24.42,Caption,,0,0,0,,УЧАСТНИКАМ ПРИШЛОСЬ РАЗОБРАТЬ ПРЕЖНИЕ МЕХАНИЗМЫ,
Dialogue: 0,0:18:24.67,0:18:27.14,Caption,,0,0,0,,ПРОЙТИ ЧЕРЕЗ ОГРОМНЫЙ КОНФЛИКТ И УБЕДИТЬСЯ,
Dialogue: 0,0:18:27.38,0:18:29.62,Caption,,0,0,0,,ЧТО КАРТА НЕ МЕНЯЕТСЯ ОТ НЕЖЕЛАНИЯ НА НЕЁ
Dialogue: 0,0:18:29.62,0:18:33.54,Caption,,0,0,0,,СМОТРЕТЬ. РОССИЯ И НАТО ОСТАЛИСЬ СОСЕДЯМИ. ДАЛЬНОСТЬ
Dialogue: 0,0:18:33.54,0:18:36.98,Caption,,0,0,0,,РАКЕТ НЕ УМЕНЬШИЛАСЬ. БАЗЫ НЕ ИСПАРИЛИСЬ. НЕДОВЕРИЕ
Dialogue: 0,0:18:36.98,0:18:39.30,Caption,,0,0,0,,ТОЖЕ НЕ СОБРАЛО ЧЕМОДАН И НЕ УЕХАЛО НА
Dialogue: 0,0:18:39.30,0:18:44.71,Caption,,0,0,0,,ЗАСЛУЖЕННЫЙ ОТДЫХ. ТЕПЕРЬ ПРИДЁТСЯ ОБСУЖДАТЬ НЕ ТОЛЬКО МОМЕНТ
Dialogue: 0,0:18:44.71,0:18:47.19,Caption,,0,0,0,,ПРЕКРАЩЕНИЯ СТРЕЛЬБЫ, НО И УСТРОЙСТВО,
Dialogue: 0,0:18:47.35,0:18:50.63,Caption,,0,0,0,,ПРИ КОТОРОМ ЕЁ НЕ ЗАХОЧЕТСЯ ВОЗОБНОВЛЯТЬ. ИМЕННО ОТ
Dialogue: 0,0:18:50.71,0:18:53.51,Caption,,0,0,0,,ЭТОГО РАЗГОВОРА КОГДА ТО ОТКАЗАЛИСЬ. ЧЕМ ДОЛЬШЕ
Dialogue: 0,0:18:53.51,0:18:55.75,Caption,,0,0,0,,ПЕРЕГОВОРЩИКИ БУДУТ РАЗЫГРЫВАТЬ УДИВЛЕНИЕ,
Dialogue: 0,0:18:55.99,0:18:58.79,Caption,,0,0,0,,ТЕМ ВЫШЕ СТАНЕТ ЦЕНА СЛЕДУЮЩЕГО ВОЗВРАЩЕНИЯ К ТЕМ
Dialogue: 0,0:18:58.79,0:19:01.75,Caption,,0,0,0,,ЖЕ ДОКУМЕНТАМ. ПАПКА ВСЁ ЕЩЁ ЛЕЖИТ НА СТОЛЕ.
Dialogue: 0,0:19:02.07,0:19:04.15,Caption,,0,0,0,,ТОЛЬКО ТЕПЕРЬ РЯДОМ С НЕЙ ЛЕЖИТ СЧЁТ ЗА
Dialogue: 0,0:19:04.15,0:19:05.19,Caption,,0,0,0,,ПОТЕРЯННЫЕ ГОДЫ.
