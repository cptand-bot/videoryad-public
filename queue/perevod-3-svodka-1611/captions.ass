Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,ШЕСТНАДЦАТОЕ НОЯБРЯ УСТРОИЛО ЕВРОПЕ ПРОВЕРКУ,
Dialogue: 0,0:00:03.00,0:00:05.00,Caption,,0,0,0,,ДЛЯ КОТОРОЙ НЕ ПОНАДОБИЛИСЬ НИ САММИТ,
Dialogue: 0,0:00:05.24,0:00:08.36,Caption,,0,0,0,,НИ ТОРЖЕСТВЕННАЯ ДЕКЛАРАЦИЯ. ДОСТАТОЧНО БЫЛО ОТКРЫТЬ
Dialogue: 0,0:00:08.44,0:00:11.24,Caption,,0,0,0,,ТРИ ДВЕРИ. ЗА ПЕРВОЙ ВАШИНГТОН ПРЕДЛАГАЛ КИЕВУ
Dialogue: 0,0:00:11.24,0:00:16.68,Caption,,0,0,0,,СДЕЛКУ, СОСТАВЛЕННУЮ ТАК, БУДТО ВАЖНЕЕ ПОДПИСИ БЫЛ ОТКАЗ. ЗА ВТОРОЙ ЕВРОПЕЙЦЫ
Dialogue: 0,0:00:16.68,0:00:18.52,Caption,,0,0,0,,СНОВА ТЯНУЛИСЬ К РОССИЙСКИМ АКТИВАМ,
Dialogue: 0,0:00:18.76,0:00:21.72,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРОДОЛЖАЯ ПЛАТИТЬ РОССИИ ЗА ГАЗ. ЗА
Dialogue: 0,0:00:21.72,0:00:26.28,Caption,,0,0,0,,ТРЕТЬЕЙ ВЫЯСНЯЛИ, КТО ОПЛАТИТ УКРАИНЕ СЛЕДУЮЩИЙ КРУГ ПОМОЩИ. К ВЕЧЕРУ
Dialogue: 0,0:00:26.28,0:00:29.48,Caption,,0,0,0,,ОБЩАЯ КАРТИНА СТАЛА НЕПРИЯТНО ЯСНОЙ. КИЕВ ВСЁ ЕЩЁ
Dialogue: 0,0:00:29.56,0:00:33.56,Caption,,0,0,0,,СЛЫШИТ ГРОМКИЕ ОБЕЩАНИЯ, НО ЗА КАЖДЫМ ОБЕЩАНИЕМ УЖЕ СТОИТ ЧЕЛОВЕК С
Dialogue: 0,0:00:33.56,0:00:36.76,Caption,,0,0,0,,КАЛЬКУЛЯТОРОМ, А ЕВРОПА ВСЁ ЧАЩЕ ИЩЕТ НЕ НОВЫЙ ПУТЬ
Dialogue: 0,0:00:36.76,0:00:39.72,Caption,,0,0,0,,К ПОБЕДЕ, А НОВЫЙ КАРМАН, ЖЕЛАТЕЛЬНО ЧУЖОЙ.
Dialogue: 0,0:00:41.99,0:00:45.35,Caption,,0,0,0,,НАЧАЛОСЬ С ВОПРОСА, КОТОРЫЙ АМЕРИКАНСКИЕ ПРЕДСТАВИТЕЛИ ЗАДАЛИ
Dialogue: 0,0:00:45.35,0:00:48.55,Caption,,0,0,0,,ЗЕЛЕНСКОМУ. ГОТОВА ЛИ УКРАИНА ОСТАВИТЬ ДОНБАСС,
Dialogue: 0,0:00:48.79,0:00:50.87,Caption,,0,0,0,,ЕСЛИ ВЗАМЕН ПОЛУЧИТ ЧЛЕНСТВО В НАТО?
Dialogue: 0,0:00:51.20,0:00:53.91,Caption,,0,0,0,,ФОРМУЛА ВЫГЛЯДИТ ЩЕДРО РОВНО ДО ТОЙ СЕКУНДЫ,
Dialogue: 0,0:00:54.15,0:00:58.31,Caption,,0,0,0,,ПОКА НЕ НАЧИНАЕШЬ ВЫЯСНЯТЬ, КОМУ И ЗАЧЕМ ОНА БЫЛА НУЖНА. КИЕВ НЕ
Dialogue: 0,0:00:58.39,0:01:01.03,Caption,,0,0,0,,ОТВЕТИЛ КОРОТКИМ СОГЛАСИЕМ. ЗЕЛЕНСКИЙ ПЕРЕЧИСЛИЛ
Dialogue: 0,0:01:01.03,0:01:04.79,Caption,,0,0,0,,ГАРАНТИИ ОТ НАТО И ЕВРОСОЮЗА, ПОСТОЯННОЕ ФИНАНСИРОВАНИЕ,
Dialogue: 0,0:01:04.87,0:01:07.03,Caption,,0,0,0,,ОРУЖИЕ, ВОССТАНОВЛЕНИЕ СТРАНЫ,
Dialogue: 0,0:01:07.20,0:01:10.47,Caption,,0,0,0,,ОТКАЗ ОТ НЕЙТРАЛЬНОГО СТАТУСА И НЕЖЕЛАНИЕ ЮРИДИЧЕСКИ
Dialogue: 0,0:01:10.47,0:01:12.79,Caption,,0,0,0,,ПРИЗНАВАТЬ РОССИЙСКИЙ КОНТРОЛЬ НАД ПОТЕРЯННЫМИ
Dialogue: 0,0:01:12.87,0:01:15.83,Caption,,0,0,0,,ТЕРРИТОРИЯМИ. АМЕРИКАНЦЫ ПРИНЕСЛИ ОДНУ КОНСТРУКЦИЮ,
Dialogue: 0,0:01:16.14,0:01:17.99,Caption,,0,0,0,,А В ОТВЕТ ПОЛУЧИЛИ ПЕРЕЧЕНЬ УСЛОВИЙ,
Dialogue: 0,0:01:18.31,0:01:20.63,Caption,,0,0,0,,ДЛЯ КОТОРОГО ВПОРУ ЗАКАЗЫВАТЬ ОТДЕЛЬНЫЙ СТОЛ.
Dialogue: 0,0:01:22.90,0:01:25.86,Caption,,0,0,0,,САМОЕ ВАЖНОЕ ЗДЕСЬ НЕ СОДЕРЖАНИЕ УКРАИНСКОГО СПИСКА.
Dialogue: 0,0:01:26.10,0:01:29.38,Caption,,0,0,0,,ОНО ДАВНО ИЗВЕСТНО. ВАЖНЕЕ ДРУГОЕ. ВАШИНГТОН
Dialogue: 0,0:01:29.38,0:01:33.86,Caption,,0,0,0,,ПРЕКРАСНО ПРЕДСТАВЛЯЛ, ЧТО ИМЕННО СКАЖЕТ ЗЕЛЕНСКИЙ. ЕГО ОТНОШЕНИЕ К
Dialogue: 0,0:01:33.86,0:01:38.26,Caption,,0,0,0,,НЕЙТРАЛИТЕТУ, ДОНБАССУ И ЮРИДИЧЕСКОМУ ПРИЗНАНИЮ ТЕРРИТОРИЙ НЕ
Dialogue: 0,0:01:38.26,0:01:40.98,Caption,,0,0,0,,ХРАНИЛОСЬ В СЕЙФЕ С ТРЕМЯ ЗАМКАМИ. ТОГДА ЗАЧЕМ
Dialogue: 0,0:01:40.98,0:01:45.22,Caption,,0,0,0,,ПРЕДЛАГАТЬ КОМБИНАЦИЮ, НА КОТОРУЮ КИЕВ ПОЧТИ НАВЕРНЯКА НЕ СОГЛАСИТСЯ БЕЗ
Dialogue: 0,0:01:45.30,0:01:47.14,Caption,,0,0,0,,ДЛИННОГО НАБОРА ВСТРЕЧНЫХ ТРЕБОВАНИЙ?
Dialogue: 0,0:01:47.45,0:01:52.26,Caption,,0,0,0,,ВОЗМОЖНО, ПОТОМУ, ЧТО СОГЛАСИЕ И НЕ БЫЛО ЦЕЛЬЮ. ИНОГДА ПЕРЕГОВОРЩИКУ
Dialogue: 0,0:01:52.34,0:01:55.86,Caption,,0,0,0,,НУЖНА НЕ ПОДПИСЬ ПАРТНЁРА, А АККУРАТНО ПОЛУЧЕННОЕ СЛОВО "НЕТ",
Dialogue: 0,0:01:56.18,0:01:58.42,Caption,,0,0,0,,КОТОРОЕ ПОТОМ МОЖНО ПРИНЕСТИ НАЧАЛЬСТВУ КАК
Dialogue: 0,0:01:58.42,0:02:05.34,Caption,,0,0,0,,САМОСТОЯТЕЛЬНЫЙ РЕЗУЛЬТАТ. ЕСТЬ И ЕЩЁ ОДНА НЕЛОВКОСТЬ. ЕСЛИ АМЕРИКАНЦЫ ВСЕРЬЁЗ
Dialogue: 0,0:02:05.34,0:02:09.02,Caption,,0,0,0,,РАССЧИТЫВАЛИ НА ДОГОВОР, КТО ЗАРАНЕЕ ПОЛУЧИЛ СОГЛАСИЕ МОСКВЫ?
Dialogue: 0,0:02:09.32,0:02:12.46,Caption,,0,0,0,,РОССИЯ ГОДАМИ ТРЕБУЕТ ВНЕБЛОКОВОГО ПОЛОЖЕНИЯ УКРАИНЫ
Dialogue: 0,0:02:12.54,0:02:15.18,Caption,,0,0,0,,И ОГРАНИЧЕНИЯ АКТИВНОСТИ НАТО У СВОИХ ГРАНИЦ.
Dialogue: 0,0:02:15.41,0:02:18.14,Caption,,0,0,0,,ПРЕДЛОЖИТЬ КИЕВУ ВСТУПЛЕНИЕ В АЛЬЯНС КАК ЧАСТЬ МИРА
Dialogue: 0,0:02:18.14,0:02:21.10,Caption,,0,0,0,,ОЗНАЧАЕТ ПООБЕЩАТЬ ОДНОМУ УЧАСТНИКУ ИМЕННО ТО,
Dialogue: 0,0:02:21.26,0:02:24.14,Caption,,0,0,0,,ЧТО ДРУГОЙ СЧИТАЕТ ПРИЧИНОЙ КОНФЛИКТА. СДЕЛКА
Dialogue: 0,0:02:24.14,0:02:28.62,Caption,,0,0,0,,НАПОМИНАЕТ ПРОДАЖУ ДАЧИ, НА КОТОРУЮ ПРОДАВЕЦ ИМЕЕТ ПРЕКРАСНЫЙ ВИД ИЗ ОКНА,
Dialogue: 0,0:02:28.87,0:02:31.74,Caption,,0,0,0,,НО НИКАКИХ ПРАВ. ПОКУПАТЕЛЯ УЖЕ ПРИГЛАШАЮТ ЗА
Dialogue: 0,0:02:31.74,0:02:34.54,Caption,,0,0,0,,КЛЮЧАМИ, ХОЗЯИНА ПОКА РЕШИЛИ НЕ ТРЕВОЖИТЬ.
Dialogue: 0,0:02:36.75,0:02:39.87,Caption,,0,0,0,,ОТВЕТ ЗЕЛЕНСКОГО ОКАЗАЛСЯ УДОБНЫМ СРАЗУ ДЛЯ ВСЕХ. ОН
Dialogue: 0,0:02:39.95,0:02:42.83,Caption,,0,0,0,,НЕ ЗАХЛОПНУЛ ДВЕРЬ, ДОПУСТИЛ ОБСУЖДЕНИЕ И РЕФЕРЕНДУМ,
Dialogue: 0,0:02:43.23,0:02:45.31,Caption,,0,0,0,,НО ПОСТАВИЛ ПЕРЕД ВХОДОМ СТОЛЬКО УСЛОВИЙ,
Dialogue: 0,0:02:45.47,0:02:48.11,Caption,,0,0,0,,ЧТО ПРОЙТИ ТУДА МОЖНО ЛИШЬ ПОСЛЕ ПОЛНОЙ ПЕРЕСТРОЙКИ
Dialogue: 0,0:02:48.11,0:02:51.23,Caption,,0,0,0,,ЗДАНИЯ. ФОРМАЛЬНО ЭТО НЕ ОТКАЗ. ПРАКТИЧЕСКИ ЭТО
Dialogue: 0,0:02:51.23,0:02:54.51,Caption,,0,0,0,,СОГЛАСИЕ, КОТОРОЕ НАСТУПИТ ПОСЛЕ ВЫПОЛНЕНИЯ ПОЧТИ ВСЕЙ
Dialogue: 0,0:02:54.59,0:02:57.39,Caption,,0,0,0,,ПРОГРАММЫ КИЕВА. ОЧЕНЬ ВЕЖЛИВЫЙ СПОСОБ ОСТАВИТЬ
Dialogue: 0,0:02:57.39,0:02:59.79,Caption,,0,0,0,,РАЗГОВОР ОТКРЫТЫМ И САМОГО СЕБЯ СНАРУЖИ.
Dialogue: 0,0:03:02.06,0:03:04.94,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ ЕВРОПЕЙСКИЕ СОЮЗНИКИ НАЧАЛИ ОБЪЯСНЯТЬ,
Dialogue: 0,0:03:05.26,0:03:07.98,Caption,,0,0,0,,КАКИЕ ЧАСТИ БУДУЩЕЙ ДОГОВОРЁННОСТИ ОНИ ОБСУЖДАТЬ
Dialogue: 0,0:03:07.98,0:03:10.78,Caption,,0,0,0,,ВООБЩЕ НЕ НАМЕРЕНЫ. КАЯ КАЛЛАС НАСТАИВАЕТ,
Dialogue: 0,0:03:11.10,0:03:13.66,Caption,,0,0,0,,ЧТО РАЗГОВОР О РОССИЙСКИХ ТРЕБОВАНИЯХ К ЕВРОПЕЙСКОЙ
Dialogue: 0,0:03:13.66,0:03:16.62,Caption,,0,0,0,,БЕЗОПАСНОСТИ ОТВЛЕКАЕТ ОТ ПРЕКРАЩЕНИЯ БОЕВЫХ
Dialogue: 0,0:03:16.62,0:03:19.42,Caption,,0,0,0,,ДЕЙСТВИЙ. В ХЕЛЬСИНКИ ТРЕБОВАНИЯ МОСКВЫ К НАТО
Dialogue: 0,0:03:19.42,0:03:22.70,Caption,,0,0,0,,НАЗЫВАЮТ НЕПРИЕМЛЕМЫМИ. МАРК КАРНИ НЕ СОБИРАЕТСЯ
Dialogue: 0,0:03:22.70,0:03:25.82,Caption,,0,0,0,,ПЕРЕСМАТРИВАТЬ УЧАСТИЕ КАНАДЫ В АЛЬЯНСЕ И ВОЕННОЕ
Dialogue: 0,0:03:25.90,0:03:28.86,Caption,,0,0,0,,ПРИСУТСТВИЕ В ЛАТВИИ. КИЕВУ ПРЕДЛАГАЮТ НАТО,
Dialogue: 0,0:03:29.18,0:03:32.22,Caption,,0,0,0,,А ДЕЙСТВУЮЩИЕ УЧАСТНИКИ АЛЬЯНСА ЗАРАНЕЕ СООБЩАЮТ,
Dialogue: 0,0:03:32.53,0:03:35.34,Caption,,0,0,0,,ЧТО СОБСТВЕННЫЕ ПОЗИЦИИ ВОЗЛЕ РОССИИ НЕ СДВИНУТ НИ
Dialogue: 0,0:03:35.42,0:03:39.02,Caption,,0,0,0,,НА САНТИМЕТР. ЗА СТОЛОМ УЖЕ РАЗЛОЖЕНЫ КРАСНЫЕ ЛИНИИ,
Dialogue: 0,0:03:39.26,0:03:41.74,Caption,,0,0,0,,ТОЛЬКО СВОБОДНОГО МЕСТА ДЛЯ СОГЛАШЕНИЯ ПОЧТИ НЕ
Dialogue: 0,0:03:41.74,0:03:47.39,Caption,,0,0,0,,ОСТАЛОСЬ. НА ЭТОМ ФОНЕ ОСОБЕННО БОДРО ВЫСТУПИЛ РИШИ СУНАК.
Dialogue: 0,0:03:47.79,0:03:50.19,Caption,,0,0,0,,БЫВШИЙ БРИТАНСКИЙ ПРЕМЬЕР ПРИЗВАЛ ГОТОВИТЬСЯ К
Dialogue: 0,0:03:50.19,0:03:52.75,Caption,,0,0,0,,УДАРАМ ПО РОССИЙСКИМ БАЗАМ НА КОЛЬСКОМ ПОЛУОСТРОВЕ,
Dialogue: 0,0:03:52.99,0:03:55.63,Caption,,0,0,0,,ГДЕ НАХОДЯТСЯ СЕВЕРНЫЙ ФЛОТ И ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:03:55.63,0:03:58.43,Caption,,0,0,0,,ЯДЕРНЫХ СИЛ. СОВЕТ ГРОЗНЫЙ. ЖАЛЬ,
Dialogue: 0,0:03:58.51,0:04:01.23,Caption,,0,0,0,,СРОК ГОДНОСТИ ПРЕМЬЕРСКИХ ПОЛНОМОЧИЙ ЗАКОНЧИЛСЯ
Dialogue: 0,0:04:01.31,0:04:04.67,Caption,,0,0,0,,РАНЬШЕ, ЧЕМ ПОЯВИЛАСЬ ЭТА РЕШИТЕЛЬНОСТЬ. КОГДА У СУНАКА БЫЛИ
Dialogue: 0,0:04:04.67,0:04:08.83,Caption,,0,0,0,,КАБИНЕТ, РАЗВЕДКА, АРМИЯ И ОТВЕТСТВЕННОСТЬ ЗА РОССИЙСКИЙ ОТВЕТ,
Dialogue: 0,0:04:09.14,0:04:11.71,Caption,,0,0,0,,ДО ПОДОБНОГО ПРИКАЗА ДЕЛО НЕ ДОШЛО. ТЕПЕРЬ
Dialogue: 0,0:04:11.71,0:04:13.79,Caption,,0,0,0,,ПОСЛЕДСТВИЯ БУДЕТ ПРИНИМАТЬ ДРУГОЙ ЧЕЛОВЕК,
Dialogue: 0,0:04:14.11,0:04:16.43,Caption,,0,0,0,,ПОЭТОМУ ХРАБРОСТЬ ОБХОДИТСЯ ЗАМЕТНО ДЕШЕВЛЕ.
Dialogue: 0,0:04:18.71,0:04:21.03,Caption,,0,0,0,,ВООБЩЕ БЫВШИЕ ЧИНОВНИКИ В ЭТОТ ДЕНЬ НАСТУПАЛИ
Dialogue: 0,0:04:21.03,0:04:25.27,Caption,,0,0,0,,ОСОБЕННО УВЕРЕННО, ГЛАВНЫМ ОБРАЗОМ НА МИКРОФОНЫ. ДМИТРИЙ КУЛЕБА,
Dialogue: 0,0:04:25.43,0:04:28.15,Caption,,0,0,0,,УЖЕ НЕ ВОЗГЛАВЛЯЮЩИЙ УКРАИНСКОЕ ВНЕШНЕПОЛИТИЧЕСКОЕ
Dialogue: 0,0:04:28.15,0:04:31.91,Caption,,0,0,0,,ВЕДОМСТВО, НАЗВАЛ ЕДИНСТВЕННОЙ СТРАТЕГИЕЙ УКРАИНЫ СПОСОБНОСТЬ
Dialogue: 0,0:04:31.91,0:04:35.11,Caption,,0,0,0,,ПРОДЕРЖАТЬСЯ МАКСИМАЛЬНО ДОЛГО. НО ДЛИТЕЛЬНОСТЬ САМА
Dialogue: 0,0:04:35.19,0:04:37.75,Caption,,0,0,0,,ПО СЕБЕ НЕ ОТВЕЧАЕТ НА ГЛАВНЫЙ ВОПРОС. РАДИ
Dialogue: 0,0:04:37.75,0:04:40.79,Caption,,0,0,0,,КАКОГО РЕЗУЛЬТАТА СТРАНА ДОЛЖНА ВЫДЕРЖАТЬ ЕЩЁ ГОД,
Dialogue: 0,0:04:40.95,0:04:44.55,Caption,,0,0,0,,ДВА ИЛИ ТРИ? ЧТО ДОЛЖНО ИЗМЕНИТЬСЯ В КОНЦЕ ЭТОГО СРОКА?
Dialogue: 0,0:04:44.79,0:04:47.27,Caption,,0,0,0,,РОССИЙСКИЕ ТРЕБОВАНИЯ, ПОЛОЖЕНИЕ НА ФРОНТЕ,
Dialogue: 0,0:04:47.51,0:04:50.95,Caption,,0,0,0,,ОБЪЁМ ЗАПАДНЫХ ПОСТАВОК, СОСТОЯНИЕ РОССИЙСКОЙ ЭКОНОМИКИ?
Dialogue: 0,0:04:51.40,0:04:53.27,Caption,,0,0,0,,ЕСЛИ КОНЕЧНАЯ ТОЧКА НЕ НАЗВАНА,
Dialogue: 0,0:04:53.59,0:04:56.31,Caption,,0,0,0,,ПЕРЕД НАМИ НЕ МАРШРУТ, А ОЖИДАНИЕ СОБЫТИЯ,
Dialogue: 0,0:04:56.47,0:04:59.27,Caption,,0,0,0,,КОТОРОЕ ОДНАЖДЫ ДОЛЖНО САМО НАЙТИ НУЖНЫЙ АДРЕС.
Dialogue: 0,0:05:01.47,0:05:03.79,Caption,,0,0,0,,И ЗДЕСЬ МАРЬЯНА БЕЗУГЛАЯ ОКАЗЫВАЕТСЯ КУДА
Dialogue: 0,0:05:03.79,0:05:06.91,Caption,,0,0,0,,ПРАКТИЧНЕЕ. ОНА ПЕРЕВОДИТ СЛОВО "ДЕРЖАТЬСЯ" НА ЯЗЫК
Dialogue: 0,0:05:06.91,0:05:09.79,Caption,,0,0,0,,РЕСУРСОВ. НУЖНЫ ДЕНЬГИ, БОЕПРИПАСЫ,
Dialogue: 0,0:05:09.94,0:05:13.07,Caption,,0,0,0,,ТЕХНИКА И ЛЮДИ. ИМЕННО ЛЮДЕЙ НЕЛЬЗЯ ПОЛУЧИТЬ
Dialogue: 0,0:05:13.07,0:05:16.19,Caption,,0,0,0,,БАНКОВСКИМ ПЕРЕВОДОМ. ПОЭТОМУ ПОЯВЛЯЮТСЯ ПРЕДЛОЖЕНИЯ
Dialogue: 0,0:05:16.19,0:05:18.03,Caption,,0,0,0,,РАСШИРЯТЬ ВОИНСКИЙ УЧЁТ ЖЕНЩИН,
Dialogue: 0,0:05:18.27,0:05:20.11,Caption,,0,0,0,,ОХВАТЫВАТЬ СПЕЦИАЛИСТОВ СВЯЗИ,
Dialogue: 0,0:05:20.26,0:05:22.59,Caption,,0,0,0,,ИНЖЕНЕРИИ И ИНФОРМАЦИОННЫХ ТЕХНОЛОГИЙ,
Dialogue: 0,0:05:22.82,0:05:25.63,Caption,,0,0,0,,СОКРАЩАТЬ БРОНИРОВАНИЕ И УСИЛИВАТЬ ПОДГОТОВКУ
Dialogue: 0,0:05:25.63,0:05:28.83,Caption,,0,0,0,,ШКОЛЬНИКОВ. КУЛЕБА ГОВОРИТ О ВРЕМЕНИ. БЕЗУГЛАЯ
Dialogue: 0,0:05:28.83,0:05:32.67,Caption,,0,0,0,,ПОКАЗЫВАЕТ, КЕМ ЭТО ВРЕМЯ ПРИДЁТСЯ ОПЛАЧИВАТЬ. ДОПОЛНИТЕЛЬНОЕ
Dialogue: 0,0:05:32.67,0:05:35.79,Caption,,0,0,0,,ПОДРАЗДЕЛЕНИЕ НЕ ВЫПРЫГИВАЕТ ИЗ ПРЕЗЕНТАЦИИ. У НЕГО
Dialogue: 0,0:05:35.79,0:05:38.59,Caption,,0,0,0,,ВСЕГДА ЕСТЬ ИМЕНА, СЕМЬИ И ПРОФЕССИИ,
Dialogue: 0,0:05:38.83,0:05:40.51,Caption,,0,0,0,,ИЗ КОТОРЫХ ЭТИХ ЛЮДЕЙ ВЫНИМАЮТ.
Dialogue: 0,0:05:42.79,0:05:45.75,Caption,,0,0,0,,ТАК ПЕРВАЯ ИСТОРИЯ ДНЯ ЗАКОНЧИЛАСЬ НЕ ПРЕДЛОЖЕНИЕМ О
Dialogue: 0,0:05:45.75,0:05:48.15,Caption,,0,0,0,,НАТО, А ВОПРОСОМ О ЦЕНЕ ОТКАЗА.
Dialogue: 0,0:05:48.71,0:05:51.11,Caption,,0,0,0,,ЕСЛИ ВАШИНГТОНУ ТРЕБОВАЛОСЬ ПРОВЕРИТЬ ГОТОВНОСТЬ
Dialogue: 0,0:05:51.11,0:05:55.83,Caption,,0,0,0,,ЗЕЛЕНСКОГО СКАЗАТЬ "НЕТ", ПРОВЕРКА ПРОШЛА УДАЧНО. СУНАК ПРЕДЛОЖИЛ ЧУЖОМУ
Dialogue: 0,0:05:55.83,0:05:58.63,Caption,,0,0,0,,ПРАВИТЕЛЬСТВУ РИСКНУТЬ СТОЛКНОВЕНИЕМ ЯДЕРНЫХ ДЕРЖАВ.
Dialogue: 0,0:05:58.99,0:06:01.51,Caption,,0,0,0,,КУЛЕБА ПОСОВЕТОВАЛ ЖДАТЬ ПЕРЕМЕНЫ ОБСТОЯТЕЛЬСТВ.
Dialogue: 0,0:06:01.83,0:06:06.79,Caption,,0,0,0,,БЕЗУГЛАЯ УЖЕ СЧИТАЕТ ТЕХ, КТО ДОЛЖЕН КУПИТЬ ЭТО ОЖИДАНИЕ СОБСТВЕННОЙ ЖИЗНЬЮ. У
Dialogue: 0,0:06:06.87,0:06:09.91,Caption,,0,0,0,,КАЖДОГО ЕСТЬ ТВЁРДАЯ ИНТОНАЦИЯ. ТОЛЬКО СЧЁТ ОПЯТЬ
Dialogue: 0,0:06:09.99,0:06:14.43,Caption,,0,0,0,,ПРИХОДИТ КИЕВУ. ПОДПИШИТЕСЬ НА КАНАЛ,
Dialogue: 0,0:06:14.59,0:06:16.43,Caption,,0,0,0,,ЕСЛИ ВАМ НУЖЕН РАЗБОР РЕШЕНИЙ,
Dialogue: 0,0:06:16.67,0:06:19.71,Caption,,0,0,0,,А НЕ ЦЕРЕМОНИЯ ВОКРУГ ЗАЯВЛЕНИЙ. ДАЛЬШЕ ЕВРОПЕЙСКИЙ
Dialogue: 0,0:06:19.79,0:06:22.03,Caption,,0,0,0,,КАЛЬКУЛЯТОР ОТКРЫВАЕТ ЕЩЁ ОДНУ СТРАНИЦУ,
Dialogue: 0,0:06:22.27,0:06:24.43,Caption,,0,0,0,,И ТАМ УЖЕ СЧИТАЮТ НЕ УКРАИНСКИХ ЛЮДЕЙ,
Dialogue: 0,0:06:24.53,0:06:31.18,Caption,,0,0,0,,А РОССИЙСКИЕ ДЕНЬГИ. ЕВРОПА ВНОВЬ ОБСУЖДАЕТ КОНФИСКАЦИЮ АКТИВОВ РОССИИ.
Dialogue: 0,0:06:31.50,0:06:34.06,Caption,,0,0,0,,ЛАТВИЙСКИЕ ПОЛИТИКИ ТРЕБУЮТ БОЛЬШЕЙ СМЕЛОСТИ,
Dialogue: 0,0:06:34.38,0:06:37.02,Caption,,0,0,0,,ПОТОМУ ЧТО СОБСТВЕННЫЕ СРЕДСТВА НА ПОДДЕРЖКУ УКРАИНЫ
Dialogue: 0,0:06:37.10,0:06:41.74,Caption,,0,0,0,,ДАВАТЬ ВСЁ ТЯЖЕЛЕЕ, А ЧУЖАЯ СУММА ЛЕЖИТ СОВСЕМ РЯДОМ. УДОБСТВО ПОЗИЦИИ
Dialogue: 0,0:06:41.82,0:06:45.10,Caption,,0,0,0,,ПОЧТИ БЕЗУПРЕЧНО. ГРОМКИЙ ПРИЗЫВ ИСХОДИТ ИЗ РИГИ,
Dialogue: 0,0:06:45.34,0:06:48.06,Caption,,0,0,0,,ОСНОВНАЯ МАССА ДЕНЕГ ХРАНИТСЯ В ДРУГИХ МЕСТАХ,
Dialogue: 0,0:06:48.34,0:06:51.10,Caption,,0,0,0,,А ЮРИДИЧЕСКИЕ ПОСЛЕДСТВИЯ ПРИДЁТСЯ РАЗБИРАТЬ ТЕМ,
Dialogue: 0,0:06:51.26,0:06:54.38,Caption,,0,0,0,,У КОГО НАХОДИТСЯ КАССА. МАЛЕНЬКАЯ СТРАНА НАЖИМАЕТ
Dialogue: 0,0:06:54.46,0:06:56.38,Caption,,0,0,0,,БОЛЬШУЮ КНОПКУ И ОЧЕНЬ НАДЕЕТСЯ,
Dialogue: 0,0:06:56.61,0:07:03.79,Caption,,0,0,0,,ЧТО ПРОВОД УХОДИТ К СОСЕДУ. РУКОВОДИТЕЛЬ ЕВРОКЛИР ВАЛЕРИ УРБЕН ГОВОРИТ УЖЕ БЕЗ
Dialogue: 0,0:07:03.79,0:07:06.67,Caption,,0,0,0,,УПРАЖНЕНИЙ В ХРАБРОСТИ. ЕЁ ВОЛНУЕТ ДОВЕРИЕ
Dialogue: 0,0:07:06.67,0:07:10.67,Caption,,0,0,0,,ИНВЕСТОРОВ. ЕСЛИ СЕГОДНЯ ЕВРОПЕЙСКАЯ СИСТЕМА ПО РЕШЕНИЮ ВЛАСТЕЙ
Dialogue: 0,0:07:10.67,0:07:12.83,Caption,,0,0,0,,ЗАБИРАЕТ СОБСТВЕННОСТЬ ОДНОГО ВЛАДЕЛЬЦА,
Dialogue: 0,0:07:13.15,0:07:15.31,Caption,,0,0,0,,ЗАВТРА ЛЮБОЙ КРУПНЫЙ ВКЛАДЧИК СПРОСИТ,
Dialogue: 0,0:07:15.47,0:07:20.27,Caption,,0,0,0,,ЧЕМ ЗАЩИЩЁН ОН САМ. КАПИТАЛ СПОСОБЕН ТЕРПЕТЬ НАЛОГИ И ЖЁСТКИЕ УСЛОВИЯ,
Dialogue: 0,0:07:20.43,0:07:24.51,Caption,,0,0,0,,ОБЪЯВЛЕННЫЕ ЗАРАНЕЕ, НО ПОСЛЕ ВЛОЖЕНИЯ ДЕНЕГ ИХ ПЕРЕСМОТР ЗАСТАВЛЯЕТ
Dialogue: 0,0:07:24.51,0:07:27.15,Caption,,0,0,0,,ИНВЕСТОРА УЙТИ. ОН ПРОСТО УХОДИТ ТУДА,
Dialogue: 0,0:07:27.40,0:07:29.47,Caption,,0,0,0,,ГДЕ СЮРПРИЗЫ ХОТЯ БЫ НЕ ВХОДЯТ В БАЗОВЫЙ
Dialogue: 0,0:07:29.47,0:07:34.62,Caption,,0,0,0,,ТАРИФ. К РОССИЙСКИМ АКТИВАМ ВОЗВРАЩАЮТСЯ СНОВА НЕ ОТ
Dialogue: 0,0:07:34.70,0:07:39.18,Caption,,0,0,0,,ИЗБЫТКА ВАРИАНТОВ, А ОТ ИХ ИСТОЩЕНИЯ. ДВАДЦАТЬ ПЯТЫЙ САНКЦИОННЫЙ ПАКЕТ
Dialogue: 0,0:07:39.18,0:07:40.78,Caption,,0,0,0,,МОЖНО СМЕНИТЬ ДВАДЦАТЬ ШЕСТЫМ,
Dialogue: 0,0:07:41.10,0:07:43.50,Caption,,0,0,0,,ЗАТЕМ ИЗГОТОВИТЬ ТРИСТА ДВАДЦАТЬ ПЯТЫЙ И
Dialogue: 0,0:07:43.50,0:07:46.38,Caption,,0,0,0,,ТОРЖЕСТВЕННО ПЕРЕРЕЗАТЬ ЛЕНТОЧКУ. НО НОМЕР НЕ
Dialogue: 0,0:07:46.38,0:07:49.90,Caption,,0,0,0,,ОБЪЯСНЯЕТ, КАКОЙ НОВЫЙ ПОТОК ПЕРЕКРЫТ И КАКОЙ РЕЗУЛЬТАТ
Dialogue: 0,0:07:49.90,0:07:53.02,Caption,,0,0,0,,ДОСТИГНУТ. ЕСЛИ ОГРАНИЧЕНИЯ ДАВНО ВСТРОЕНЫ РОССИЕЙ В
Dialogue: 0,0:07:53.02,0:07:56.86,Caption,,0,0,0,,ХОЗЯЙСТВЕННЫЕ РАСЧЁТЫ, ОЧЕРЕДНОЙ СПИСОК ЗАПРЕТОВ СОЗДАЁТ РАБОТУ
Dialogue: 0,0:07:56.86,0:08:00.46,Caption,,0,0,0,,СОСТАВИТЕЛЯМ СПИСКА, НО НЕ ОБЯЗАТЕЛЬНО НОВУЮ БОЛЬ АДРЕСАТУ.
Dialogue: 0,0:08:02.73,0:08:07.85,Caption,,0,0,0,,МОСКВА ИСХОДИТ ИЗ ТОГО, ЧТО САНКЦИИ СОХРАНЯТСЯ ЕЩЁ ШЕСТЬ ЛЕТ. ЭТО ПРЕВРАЩАЕТ
Dialogue: 0,0:08:07.93,0:08:11.29,Caption,,0,0,0,,ВРЕМЕННОЕ НАКАЗАНИЕ В ПОСТОЯННУЮ СРЕДУ. КОГДА ДРУГАЯ
Dialogue: 0,0:08:11.29,0:08:13.93,Caption,,0,0,0,,СТОРОНА УЖЕ УЧИТСЯ ЖИТЬ ВНУТРИ ОГРАНИЧЕНИЙ,
Dialogue: 0,0:08:14.17,0:08:16.97,Caption,,0,0,0,,ПРЕЖНИЙ ПРИЁМ НЕЛЬЗЯ БЕСКОНЕЧНО ПРОДАВАТЬ КАК СВЕЖУЮ
Dialogue: 0,0:08:17.05,0:08:21.85,Caption,,0,0,0,,УГРОЗУ. МОЖНО, КОНЕЧНО, ПЕРЕКРЫТЬ ДЕНЕЖНЫЙ ПОТОК БАБЫ МАНИ В ДАЛЬНЕМ ПОСЁЛКЕ
Dialogue: 0,0:08:22.09,0:08:24.65,Caption,,0,0,0,,И ОТЧИТАТЬСЯ О СОКРУШИТЕЛЬНОМ УСПЕХЕ. ТОЛЬКО
Dialogue: 0,0:08:24.65,0:08:27.21,Caption,,0,0,0,,ЕВРОПЕЙСКОМУ БЮДЖЕТУ ОТ ТАКОГО ПОДВИГА ЛЕГЧЕ НЕ
Dialogue: 0,0:08:27.29,0:08:30.81,Caption,,0,0,0,,СТАНЕТ, А РОССИЙСКАЯ ЭКОНОМИКА УТРОМ НЕПОНЯТНО ПОЧЕМУ СНОВА
Dialogue: 0,0:08:30.81,0:08:36.46,Caption,,0,0,0,,ОТКРОЕТСЯ. ОСОБЕННО УБЕДИТЕЛЬНО ЕВРОПЕЙСКОЕ ДАВЛЕНИЕ ВЫГЛЯДИТ
Dialogue: 0,0:08:36.54,0:08:39.34,Caption,,0,0,0,,ВОЗЛЕ ГАЗОВОГО ТЕРМИНАЛА. ЗА ПЕРИОД С ЯНВАРЯ ПО
Dialogue: 0,0:08:39.42,0:08:42.06,Caption,,0,0,0,,ОКТЯБРЬ НЫНЕШНЕГО ГОДА ПОКУПАТЕЛИ В ЕВРОСОЮЗЕ
Dialogue: 0,0:08:42.06,0:08:45.10,Caption,,0,0,0,,ПЕРЕЧИСЛИЛИ ЗА РОССИЙСКИЙ СЖИЖЕННЫЙ ГАЗ ОКОЛО ВОСЬМИ
Dialogue: 0,0:08:45.18,0:08:48.06,Caption,,0,0,0,,ЦЕЛЫХ СЕМИ ДЕСЯТЫХ МИЛЛИАРДА ЕВРО. РАСХОДЫ ЗА
Dialogue: 0,0:08:48.06,0:08:50.70,Caption,,0,0,0,,НЕПОЛНЫЙ ГОД УЖЕ ПРЕВЫСИЛИ ПРОШЛОГОДНИЕ НА ДВАДЦАТЬ
Dialogue: 0,0:08:50.78,0:08:53.90,Caption,,0,0,0,,ОДИН ПРОЦЕНТ. В ОКТЯБРЕ ФИЗИЧЕСКИЙ ОБЪЁМ СОКРАТИЛСЯ,
Dialogue: 0,0:08:54.22,0:08:56.78,Caption,,0,0,0,,ЗАТО СУММА ВЫРОСЛА ВМЕСТЕ С ЦЕНОЙ. В ЧИСЛЕ
Dialogue: 0,0:08:56.78,0:08:58.70,Caption,,0,0,0,,ПОКУПАТЕЛЕЙ ОСТАЮТСЯ НИДЕРЛАНДЫ,
Dialogue: 0,0:08:58.78,0:09:03.66,Caption,,0,0,0,,ФРАНЦИЯ, ПОРТУГАЛИЯ, ИСПАНИЯ И БЕЛЬГИЯ. ОДНОЙ РУКОЙ ДОХОДЫ РОССИИ
Dialogue: 0,0:09:03.66,0:09:07.10,Caption,,0,0,0,,ПЕРЕКРЫВАЮТ, ДРУГОЙ ОПЛАЧИВАЮТ СЧЁТ. ВИДИМО,
Dialogue: 0,0:09:07.18,0:09:09.50,Caption,,0,0,0,,РУКИ РАБОТАЮТ В РАЗНЫХ ВЕДОМСТВАХ И ПОКА НЕ
Dialogue: 0,0:09:09.58,0:09:16.01,Caption,,0,0,0,,ПРЕДСТАВЛЕНЫ ДРУГ ДРУГУ. ТУРЦИЯ ДЕЙСТВУЕТ БЕЗ ТОРЖЕСТВЕННЫХ ФОРМУЛ. АНКАРА
Dialogue: 0,0:09:16.01,0:09:18.89,Caption,,0,0,0,,СЧИТАЕТ РОССИЙСКИЙ ГАЗ ДОРОГИМ И ОБЕЩАЕТ ИСКАТЬ
Dialogue: 0,0:09:18.89,0:09:22.73,Caption,,0,0,0,,ЗАМЕНУ, ЕСЛИ ЦЕНА НЕ СНИЗИТСЯ. ВЕНГРИЯ ПРИСМАТРИВАЕТСЯ К
Dialogue: 0,0:09:22.73,0:09:26.81,Caption,,0,0,0,,РУМЫНСКИМ ПОСТАВКАМ, НО АЛЬТЕРНАТИВНЫЙ СЖИЖЕННЫЙ ГАЗ ТОЖЕ КУСАЕТСЯ.
Dialogue: 0,0:09:27.14,0:09:30.09,Caption,,0,0,0,,МОЛДОВА ОБЪЯВЛЯЕТ ОТКАЗ ОТ РОССИЙСКОГО ТОПЛИВА И
Dialogue: 0,0:09:30.09,0:09:33.53,Caption,,0,0,0,,СОЕДИНЯЕТ СВОЮ ЭНЕРГОСИСТЕМУ С РУМЫНИЕЙ. ЛИНИЯ МЕЖДУ
Dialogue: 0,0:09:33.53,0:09:35.53,Caption,,0,0,0,,ВУЛКАНЕШТАМИ И КИШИНЁВОМ РАБОТАЕТ,
Dialogue: 0,0:09:35.77,0:09:38.97,Caption,,0,0,0,,НОВЫЕ СОЕДИНЕНИЯ ГОТОВЯТСЯ. ПЕРЕМЕНЫ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:09:39.05,0:09:40.97,Caption,,0,0,0,,СДЕЛАНЫ ИЗ ПРОВОДОВ И ОБОРУДОВАНИЯ,
Dialogue: 0,0:09:41.13,0:09:43.77,Caption,,0,0,0,,НО НОВАЯ СХЕМА ОБХОДИТСЯ ПОТРЕБИТЕЛЮ ДОРОЖЕ.
Dialogue: 0,0:09:44.17,0:09:48.81,Caption,,0,0,0,,ПОСТАВЩИКА МОЖНО ЗАМЕНИТЬ, ПОБЕДУ ОБЪЯВИТЬ. КВИТАНЦИЯ ВСЁ РАВНО ПРИХОДИТ БЕЗ
Dialogue: 0,0:09:48.81,0:09:54.46,Caption,,0,0,0,,АПЛОДИСМЕНТОВ. ПОЭТОМУ РОССИЙСКИЕ АКТИВЫ И ВЫГЛЯДЯТ ПОСЛЕДНИМ
Dialogue: 0,0:09:54.46,0:09:58.54,Caption,,0,0,0,,КРУПНЫМ РЫЧАГОМ, ДО КОТОРОГО ЛЕГКО ДОТЯНУТЬСЯ. НЕ НУЖНО ПРИДУМЫВАТЬ
Dialogue: 0,0:09:58.54,0:10:02.22,Caption,,0,0,0,,НОВЫЙ НАЛОГ, ЗАНИМАТЬ У ГРАЖДАН ОЧЕРЕДНЫЕ ДЕСЯТКИ МИЛЛИАРДОВ ИЛИ
Dialogue: 0,0:10:02.22,0:10:06.14,Caption,,0,0,0,,ЖДАТЬ, ПОКА СВЕЖИЙ ПАКЕТ САНКЦИЙ СОВЕРШИТ ЧУДО. ДЕНЬГИ УЖЕ
Dialogue: 0,0:10:06.14,0:10:09.50,Caption,,0,0,0,,ВНУТРИ ЕВРОПЕЙСКОЙ СИСТЕМЫ. И ЕСЛИ ЕВРОСОЮЗ НАМЕРЕН
Dialogue: 0,0:10:09.58,0:10:12.22,Caption,,0,0,0,,ДОЛГО ФИНАНСИРОВАТЬ КИЕВ ПРИ СОКРАЩАЮЩЕМСЯ НАБОРЕ
Dialogue: 0,0:10:12.22,0:10:15.34,Caption,,0,0,0,,СРЕДСТВ ДАВЛЕНИЯ, ЭТИ АКТИВЫ, СКОРЕЕ ВСЕГО,
Dialogue: 0,0:10:15.42,0:10:19.02,Caption,,0,0,0,,ЗАБЕРУТ. РИСК ОТТОКА КАПИТАЛА ПОНИМАЮТ. УДАР ПО
Dialogue: 0,0:10:19.02,0:10:21.98,Caption,,0,0,0,,ДОВЕРИЮ ПОНИМАЮТ. ПРОСТО ДОСТУПНОГО ИНСТРУМЕНТА
Dialogue: 0,0:10:21.98,0:10:24.46,Caption,,0,0,0,,СОПОСТАВИМОГО МАСШТАБА ПОЧТИ НЕ ОСТАЛОСЬ.
Dialogue: 0,0:10:26.74,0:10:29.38,Caption,,0,0,0,,КОНФИСКАЦИЯ НЕ ВЫКЛЮЧИТ РОССИЮ ОДНОЙ БАНКОВСКОЙ
Dialogue: 0,0:10:29.38,0:10:34.02,Caption,,0,0,0,,ОПЕРАЦИЕЙ. МОСКВА ЗАЯВЛЯЕТ, ЧТО ПОДГОТОВИЛА ОТВЕТНЫЕ МЕРЫ. ЗНАЧИТ,
Dialogue: 0,0:10:34.26,0:10:36.58,Caption,,0,0,0,,НАЧНЁТСЯ ПОИСК ЕВРОПЕЙСКОГО ИМУЩЕСТВА,
Dialogue: 0,0:10:36.68,0:10:42.02,Caption,,0,0,0,,ПРОЕКТОВ, ПРАВ И ОПЕРАЦИЙ, КОТОРЫЕ МОЖНО ОГРАНИЧИТЬ ИЛИ ИЗЪЯТЬ. ОБЕ СТОРОНЫ
Dialogue: 0,0:10:42.02,0:10:44.98,Caption,,0,0,0,,БУДУТ ГОВОРИТЬ О ЗАКОНЕ, ОДНОВРЕМЕННО ПРИГЛЯДЫВАЯ,
Dialogue: 0,0:10:45.16,0:10:48.26,Caption,,0,0,0,,ГДЕ У ПРОТИВНИКА ЛЕЖАТ ЦЕННЫЕ АКТИВЫ. ФИНАНСОВАЯ
Dialogue: 0,0:10:48.26,0:10:50.10,Caption,,0,0,0,,ДРАКА ВСЕГДА ВЫГЛЯДИТ СОЛИДНО,
Dialogue: 0,0:10:50.29,0:10:54.02,Caption,,0,0,0,,ПОКА НЕ ЗАМЕЧАЕШЬ, ЧТО УЧАСТНИКИ ПРОСТО ТЯНУТ ДРУГ У ДРУГА КОШЕЛЬКИ
Dialogue: 0,0:10:54.10,0:11:00.38,Caption,,0,0,0,,ЧЕРЕЗ СТОЙКУ. НО ГЕРМАНИЯ ГОТОВИТ РЫЧАГ ДРУГОГО РОДА. БУНДЕСТАГ
Dialogue: 0,0:11:00.38,0:11:03.18,Caption,,0,0,0,,РАСШИРИЛ ВОЗМОЖНОСТИ ВНЕШНЕЙ РАЗВЕДКИ И ВЕДОМСТВА ПО
Dialogue: 0,0:11:03.18,0:11:06.62,Caption,,0,0,0,,ЗАЩИТЕ КОНСТИТУЦИИ. ЗА РЕФОРМУ ПРОГОЛОСОВАЛИ ТРИСТА
Dialogue: 0,0:11:06.70,0:11:09.34,Caption,,0,0,0,,ВОСЕМЬ ДЕПУТАТОВ, ПРОТИВ БЫЛИ СТО ДЕВЯНОСТО,
Dialogue: 0,0:11:09.58,0:11:12.62,Caption,,0,0,0,,ЕЩЁ СЕМЬДЕСЯТ ОДИН ВОЗДЕРЖАЛСЯ. НОВЫЕ ПОЛНОМОЧИЯ
Dialogue: 0,0:11:12.62,0:11:14.86,Caption,,0,0,0,,ПОЗВОЛЯЮТ АКТИВНЕЕ ДЕЙСТВОВАТЬ ЗА РУБЕЖОМ,
Dialogue: 0,0:11:15.10,0:11:17.10,Caption,,0,0,0,,ПРОНИКАТЬ В ИНФОРМАЦИОННЫЕ СИСТЕМЫ,
Dialogue: 0,0:11:17.39,0:11:20.70,Caption,,0,0,0,,НАРУШАТЬ РАБОТУ СЕРВЕРОВ, ВМЕШИВАТЬСЯ В ПРЕДПРИЯТИЯ,
Dialogue: 0,0:11:20.79,0:11:25.18,Caption,,0,0,0,,СВЯЗАННЫЕ С БЕСПИЛОТНИКАМИ, И ВОЗДЕЙСТВОВАТЬ НА ОРУЖЕЙНЫЕ ЦЕПОЧКИ ПОСТАВОК.
Dialogue: 0,0:11:27.45,0:11:30.41,Caption,,0,0,0,,ВНЕШНЕЙ УГРОЗОЙ ДЕЛО НЕ ОГРАНИЧИВАЕТСЯ. СЛУЖБЫ
Dialogue: 0,0:11:30.41,0:11:33.37,Caption,,0,0,0,,ПОЛУЧАЮТ ДОПОЛНИТЕЛЬНЫЕ ВОЗМОЖНОСТИ ВНУТРИ ГЕРМАНИИ,
Dialogue: 0,0:11:33.53,0:11:36.01,Caption,,0,0,0,,ВКЛЮЧАЯ ДОСТУП В ПОМЕЩЕНИЯ ДЛЯ ВМЕШАТЕЛЬСТВА В
Dialogue: 0,0:11:36.01,0:11:38.97,Caption,,0,0,0,,ТЕХНИЧЕСКИЕ УСТРОЙСТВА. ВОЗНИКАЮТ СПОРЫ О РАБОТЕ С
Dialogue: 0,0:11:38.97,0:11:42.09,Caption,,0,0,0,,НЕСОВЕРШЕННОЛЕТНИМИ И ОБ ОГРАНИЧЕНИИ ОБМЕНА ДАННЫМИ
Dialogue: 0,0:11:42.17,0:11:44.73,Caption,,0,0,0,,МЕЖДУ ФЕДЕРАЛЬНЫМ ЦЕНТРОМ И ЗЕМЛЯМИ. ТУТ ЖЕ
Dialogue: 0,0:11:44.73,0:11:48.97,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ АДГ, ПОСКОЛЬКУ СТРАХ УТЕЧКИ СЕКРЕТОВ ЛЕГКО СОЕДИНЯЕТСЯ С
Dialogue: 0,0:11:48.97,0:11:51.29,Caption,,0,0,0,,ВНУТРЕННЕЙ БОРЬБОЙ ПРОТИВ НЕУДОБНОЙ ПАРТИИ.
Dialogue: 0,0:11:51.60,0:11:54.49,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА УХОДЯТ, КОАЛИЦИИ РАСПАДАЮТСЯ,
Dialogue: 0,0:11:54.67,0:11:59.05,Caption,,0,0,0,,А ПОЛНОМОЧИЯ, АРХИВЫ И ТЕХНИКА ОСТАЮТСЯ. ВОЗМОЖНОСТИ ТАЙНОЙ
Dialogue: 0,0:11:59.05,0:12:01.69,Caption,,0,0,0,,СЛУЖБЫ, ОДНАЖДЫ ПОЛОЖЕННЫЕ ЕЙ В КАРМАН,
Dialogue: 0,0:12:01.93,0:12:04.57,Caption,,0,0,0,,ОБРАТНО ИЗВЛЕКАЮТСЯ ТОЛЬКО ВМЕСТЕ С ПОДКЛАДКОЙ.
Dialogue: 0,0:12:06.84,0:12:09.57,Caption,,0,0,0,,ВТОРОЙ ИТОГ ДНЯ ДЛЯ ЕВРОПЫ ПРОСТ. СТАРЫЕ
Dialogue: 0,0:12:09.57,0:12:11.81,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЕ РЫЧАГИ ДАЮТ ВСЁ МЕНЬШЕ НОВОГО
Dialogue: 0,0:12:11.81,0:12:14.77,Caption,,0,0,0,,РЕЗУЛЬТАТА. ЗА РОССИЙСКИЙ ГАЗ ПРОДОЛЖАЮТ ПЛАТИТЬ,
Dialogue: 0,0:12:15.04,0:12:17.17,Caption,,0,0,0,,ЗАМЕНА ПОСТАВЩИКА ПОВЫШАЕТ РАСХОДЫ,
Dialogue: 0,0:12:17.49,0:12:20.21,Caption,,0,0,0,,КОНФИСКАЦИЯ КАПИТАЛА УГРОЖАЕТ САМОЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:12:20.21,0:12:24.69,Caption,,0,0,0,,ФИНАНСОВОЙ РЕПУТАЦИИ, А УСИЛЕНИЕ СПЕЦСЛУЖБ ВОЗВРАЩАЕТСЯ ВНУТРЬ ГЕРМАНИИ.
Dialogue: 0,0:12:24.99,0:12:28.13,Caption,,0,0,0,,ИНСТРУМЕНТЫ ЕЩЁ ЕСТЬ. БЕСПЛАТНЫХ СРЕДИ НИХ УЖЕ НЕТ.
Dialogue: 0,0:12:28.35,0:12:30.61,Caption,,0,0,0,,И ЧЕМ СИЛЬНЕЕ БРЮССЕЛЬ ДАВИТ НАРУЖУ,
Dialogue: 0,0:12:30.77,0:12:33.57,Caption,,0,0,0,,ТЕМ ЧАЩЕ ЦЕНА ВЫЛЕЗАЕТ ИЗ СОБСТВЕННОГО КАРМАНА.
Dialogue: 0,0:12:35.84,0:12:38.80,Caption,,0,0,0,,ТРЕТИЙ СЮЖЕТ ДЕЛАЕТ ЭТУ ЦЕНУ СОВСЕМ КОНКРЕТНОЙ.
Dialogue: 0,0:12:39.12,0:12:42.72,Caption,,0,0,0,,ПОЛЬША, МНОГО ЛЕТ ТРЕБОВАВШАЯ ОТ ЕВРОПЫ ЖЁСТКОСТИ И БОЛЬШЕЙ
Dialogue: 0,0:12:42.72,0:12:46.40,Caption,,0,0,0,,ПОМОЩИ КИЕВУ, ОТКАЗАЛАСЬ ПОКА ДАВАТЬ ДОПОЛНИТЕЛЬНЫЙ ВЗНОС В
Dialogue: 0,0:12:46.48,0:12:49.12,Caption,,0,0,0,,ПРОГРАММУ ЗАКУПКИ АМЕРИКАНСКОГО ОРУЖИЯ ДЛЯ УКРАИНЫ.
Dialogue: 0,0:12:49.41,0:12:52.16,Caption,,0,0,0,,ДОНАЛЬД ТУСК ОБЪЯСНИЛ РЕШЕНИЕ КРУПНЫМ БЮДЖЕТНЫМ
Dialogue: 0,0:12:52.24,0:12:55.60,Caption,,0,0,0,,ДЕФИЦИТОМ И РАСХОДАМИ НА ПОЛЬСКУЮ ОБОРОНУ. РОССИЯ НЕ
Dialogue: 0,0:12:55.60,0:12:57.52,Caption,,0,0,0,,СТАЛА ДЛЯ ВАРШАВЫ МЕНЕЕ ОПАСНОЙ,
Dialogue: 0,0:12:57.74,0:12:59.68,Caption,,0,0,0,,УКРАИНА НЕ ПРЕВРАТИЛАСЬ ВО ВРАГА,
Dialogue: 0,0:12:59.84,0:13:02.88,Caption,,0,0,0,,ПРЕЖНЯЯ РИТОРИКА НИКУДА НЕ ДЕЛАСЬ. ПРОСТО В МОМЕНТ
Dialogue: 0,0:13:02.88,0:13:06.24,Caption,,0,0,0,,НОВОГО ПЛАТЕЖА СОБСТВЕННАЯ АРМИЯ ОКАЗАЛАСЬ В ОЧЕРЕДИ
Dialogue: 0,0:13:06.24,0:13:12.61,Caption,,0,0,0,,РАНЬШЕ КИЕВА. ИМЕННО ПОЛЬША СТАЛА ВАЖНЕЙШИМ СИГНАЛОМ. ОТ ВЕНГРИИ
Dialogue: 0,0:13:12.69,0:13:15.65,Caption,,0,0,0,,ИЛИ СЛОВАКИИ ВОЗРАЖЕНИЙ ЖДАЛИ БЫ ЗАРАНЕЕ. ТУСКА
Dialogue: 0,0:13:15.73,0:13:18.37,Caption,,0,0,0,,ТРУДНО ПРЕДСТАВИТЬ ПРОТИВНИКОМ ЕВРОПЕЙСКОГО КУРСА.
Dialogue: 0,0:13:18.69,0:13:20.85,Caption,,0,0,0,,ЕГО КАБИНЕТ ПРИНАДЛЕЖИТ К ТОМУ ЛАГЕРЮ,
Dialogue: 0,0:13:21.09,0:13:23.49,Caption,,0,0,0,,КОТОРЫЙ ОБЫЧНО ОБЪЯСНЯЕТ ДРУГИМ ЦЕННОСТЬ ОБЩЕЙ
Dialogue: 0,0:13:23.49,0:13:26.53,Caption,,0,0,0,,СОЛИДАРНОСТИ. ЕСЛИ УЖЕ ТАКОЕ ПРАВИТЕЛЬСТВО ГОВОРИТ,
Dialogue: 0,0:13:26.77,0:13:28.77,Caption,,0,0,0,,ЧТО ДОПОЛНИТЕЛЬНЫХ ДЕНЕГ СЕЙЧАС НЕ БУДЕТ,
Dialogue: 0,0:13:29.08,0:13:31.57,Caption,,0,0,0,,УДОБНАЯ ССЫЛКА НА ОРБАНА ПЕРЕСТАЁТ РАБОТАТЬ.
Dialogue: 0,0:13:31.82,0:13:34.21,Caption,,0,0,0,,БУХГАЛТЕРИЯ ПРОНИКЛА ДАЖЕ В ПРАВИЛЬНЫЙ КАБИНЕТ И
Dialogue: 0,0:13:34.29,0:13:40.90,Caption,,0,0,0,,СЕЛА ТАМ БЕЗ ПРИГЛАШЕНИЯ. ПОХОЖАЯ ИСТОРИЯ ПРОИСХОДИТ В БОЛГАРИИ. РУМЕН РАДЕВ
Dialogue: 0,0:13:40.98,0:13:45.22,Caption,,0,0,0,,ССЫЛАЕТСЯ НА ДЕФИЦИТ, ПОКА ЕВРОКОМИССИЯ ТРЕБУЕТ ОТ СОФИИ СОКРАЩАТЬ
Dialogue: 0,0:13:45.30,0:13:48.18,Caption,,0,0,0,,РАСХОДЫ. СНАЧАЛА СТРАНЕ ВЕЛЯТ СТРОЖЕ СОБЛЮДАТЬ
Dialogue: 0,0:13:48.18,0:13:52.34,Caption,,0,0,0,,БЮДЖЕТНЫЕ ОГРАНИЧЕНИЯ, ЗАТЕМ ПРОСЯТ НАЙТИ ЕЩЁ СРЕДСТВА ДЛЯ УКРАИНЫ.
Dialogue: 0,0:13:52.72,0:13:55.22,Caption,,0,0,0,,ПОТАЙНОГО ЯЩИКА В КАЗНАЧЕЙСТВЕ НЕ ОБНАРУЖИЛОСЬ.
Dialogue: 0,0:13:55.54,0:13:57.62,Caption,,0,0,0,,ПОЭТОМУ ФИНАНСОВЫЙ ВЗНОС СОКРАЩАЮТ,
Dialogue: 0,0:13:57.85,0:14:02.02,Caption,,0,0,0,,ХОТЯ ПОМОЩЬ ЭЛЕКТРОЭНЕРГИЕЙ, ВОССТАНОВЛЕНИЕМ ЭНЕРГЕТИКИ И ЖЕЛЕЗНЫХ ДОРОГ
Dialogue: 0,0:14:02.02,0:14:05.06,Caption,,0,0,0,,СОХРАНЯЮТ. ЕВРОПА НЕ БРОСАЕТ КИЕВ ОДНИМ ОБЩИМ
Dialogue: 0,0:14:05.06,0:14:08.02,Caption,,0,0,0,,РЕШЕНИЕМ. ИССЯКАЕТ ГОТОВНОСТЬ ПРИНИМАТЬ НОВЫЕ
Dialogue: 0,0:14:08.02,0:14:14.20,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА. ФРИДРИХ МЕРЦ ХОЧЕТ УБРАТЬ ЕЖЕГОДНЫЙ ТОРГ И ЗАКРЕПИТЬ
Dialogue: 0,0:14:14.20,0:14:16.84,Caption,,0,0,0,,УКРАИНСКОЕ ФИНАНСИРОВАНИЕ В СЛЕДУЮЩЕМ СЕМИЛЕТНЕМ
Dialogue: 0,0:14:16.84,0:14:20.28,Caption,,0,0,0,,БЮДЖЕТЕ ЕВРОСОЮЗА. ЕСЛИ РАСХОДЫ ЗАРАНЕЕ ВСТРОЕНЫ В
Dialogue: 0,0:14:20.36,0:14:23.96,Caption,,0,0,0,,ОБЩУЮ СИСТЕМУ, НЕ ПРИДЁТСЯ КАЖДЫЙ ГОД СОБИРАТЬ СОГЛАСИЯ ДВАДЦАТИ
Dialogue: 0,0:14:24.04,0:14:26.92,Caption,,0,0,0,,СЕМИ СТОЛИЦ. НО ОБЩИЙ БЮДЖЕТ НАПОЛНЯЮТ ТЕ ЖЕ
Dialogue: 0,0:14:27.00,0:14:30.52,Caption,,0,0,0,,СТРАНЫ. ДОПОЛНИТЕЛЬНАЯ СУММА ДЛЯ КИЕВА ОЗНАЧАЕТ ЛИБО
Dialogue: 0,0:14:30.60,0:14:34.36,Caption,,0,0,0,,БОЛЬШИЕ ВЗНОСЫ, ЛИБО СОКРАЩЕНИЕ ДРУГИХ ПРОГРАММ. БРЮССЕЛЬСКОГО
Dialogue: 0,0:14:34.36,0:14:37.32,Caption,,0,0,0,,СУНДУКА, КОТОРЫЙ НОЧЬЮ САМ РОЖДАЕТ ЕВРО,
Dialogue: 0,0:14:37.41,0:14:42.73,Caption,,0,0,0,,ПОКА НЕ ПРЕДЪЯВИЛИ. ПОЭТОМУ СПОРЯТ НЕ ТОЛЬКО ВЕНГРИЯ,
Dialogue: 0,0:14:42.84,0:14:47.61,Caption,,0,0,0,,БОЛГАРИЯ, ЧЕХИЯ И СЛОВАКИЯ. ВОЗРАЖАЮТ СЛОВЕНИЯ И ИРЛАНДИЯ,
Dialogue: 0,0:14:47.92,0:14:50.25,Caption,,0,0,0,,КОТОРЫХ ТРУДНО ЗАПИСАТЬ В ПРОТИВНИКИ УКРАИНЫ.
Dialogue: 0,0:14:50.49,0:14:53.13,Caption,,0,0,0,,УВЕЛИЧЕННЫЙ УКРАИНСКИЙ КУСОК УМЕНЬШИТ ФОНДЫ ДЛЯ
Dialogue: 0,0:14:53.21,0:14:56.01,Caption,,0,0,0,,МЕНЕЕ БОГАТЫХ ЧЛЕНОВ СОЮЗА. А ЭТО ДОРОГИ,
Dialogue: 0,0:14:56.10,0:14:59.85,Caption,,0,0,0,,РЕГИОНЫ, ХОЗЯЙСТВЕННЫЕ ПРОЕКТЫ И ОБЕЩАНИЯ СОБСТВЕННЫМ
Dialogue: 0,0:14:59.85,0:15:02.65,Caption,,0,0,0,,ИЗБИРАТЕЛЯМ. НА ОБЩЕЙ ФОТОГРАФИИ МЕСТО ДЛЯ ВСЕХ
Dialogue: 0,0:15:02.73,0:15:05.93,Caption,,0,0,0,,НАХОДИТСЯ ЛЕГКО. В БЮДЖЕТНОЙ ТАБЛИЦЕ КРЕСЛА ВНЕЗАПНО
Dialogue: 0,0:15:05.93,0:15:11.48,Caption,,0,0,0,,ПЛАТНЫЕ. ЭММАНУЭЛЬ МАКРОН НАЗЫВАЕТ СОКРАЩЕНИЕ РЕСУРСОВ ДЛЯ
Dialogue: 0,0:15:11.56,0:15:13.88,Caption,,0,0,0,,КИЕВА ПОРАЖЕНЧЕСТВОМ И ПРЕДУПРЕЖДАЕТ О
Dialogue: 0,0:15:13.88,0:15:17.00,Caption,,0,0,0,,НЕСПРАВЕДЛИВОМ МИРЕ И БУДУЩЕЙ ВОЙНЕ. ЕГО РАСЧЁТ
Dialogue: 0,0:15:17.00,0:15:20.60,Caption,,0,0,0,,ЯСЕН. МЕНЬШЕ ДЕНЕГ И ОРУЖИЯ ОЗНАЧАЕТ СЛАБЕЕ ПОЗИЦИЮ
Dialogue: 0,0:15:20.68,0:15:25.08,Caption,,0,0,0,,УКРАИНЫ НА ПЕРЕГОВОРАХ, А РЕЗУЛЬТАТ РОССИИ СИЛОЙ МОЖЕТ СОЗДАТЬ НОВУЮ УГРОЗУ
Dialogue: 0,0:15:25.08,0:15:27.72,Caption,,0,0,0,,ЕВРОПЕ. ТОЛЬКО ФРАНЦУЗСКИЙ ПРЕЗИДЕНТ ГОВОРИТ О
Dialogue: 0,0:15:27.72,0:15:29.64,Caption,,0,0,0,,БЕЗОПАСНОСТИ КОНТИНЕНТА ЦЕЛИКОМ,
Dialogue: 0,0:15:29.96,0:15:33.32,Caption,,0,0,0,,А ТУСК СВОДИТ ПОЛЬСКУЮ КАЗНУ, РАДЕВ БОЛГАРСКУЮ,
Dialogue: 0,0:15:33.48,0:15:35.88,Caption,,0,0,0,,ОСТАЛЬНЫЕ ЗАЩИЩАЮТ СВОИ ФОНДЫ. СЛОВОМ
Dialogue: 0,0:15:35.88,0:15:38.60,Caption,,0,0,0,,"ПОРАЖЕНЧЕСТВО" ДЕФИЦИТ НЕ ЗАКРОЕШЬ. ОНО ЗВУЧИТ
Dialogue: 0,0:15:38.60,0:15:41.40,Caption,,0,0,0,,ВНУШИТЕЛЬНО, НО КАССИР ВСЁ РАВНО ПРОСИТ КАРТУ.
Dialogue: 0,0:15:43.61,0:15:45.45,Caption,,0,0,0,,И ТУТ ВОЗВРАЩАЕТСЯ АНГЕЛА МЕРКЕЛЬ,
Dialogue: 0,0:15:45.72,0:15:48.49,Caption,,0,0,0,,СЛОВНО НАПОМИНАНИЕ О ПРЕДЫДУЩЕМ ЕВРОПЕЙСКОМ СПОСОБЕ
Dialogue: 0,0:15:48.49,0:15:51.61,Caption,,0,0,0,,КУПИТЬ ВРЕМЯ. ОНА ЗАЩИЩАЕТ ПЕРЕГОВОРЫ С ПУТИНЫМ И
Dialogue: 0,0:15:51.61,0:15:54.73,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО БЕЗ ДИАЛОГА В ХОДЕ СОБЫТИЙ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:15:54.73,0:15:57.61,Caption,,0,0,0,,ПЯТНАДЦАТОГО ГОДА УКРАИНА МОГЛА НЕ СОХРАНИТЬСЯ В
Dialogue: 0,0:15:57.61,0:16:00.81,Caption,,0,0,0,,НЫНЕШНЕМ ВИДЕ. РАНЬШЕ БЫВШИЙ КАНЦЛЕР УЖЕ ОБЪЯСНЯЛА,
Dialogue: 0,0:16:01.05,0:16:03.61,Caption,,0,0,0,,ЧТО МИНСКИЕ СОГЛАШЕНИЯ ДАЛИ КИЕВУ ВОЗМОЖНОСТЬ
Dialogue: 0,0:16:03.61,0:16:06.65,Caption,,0,0,0,,УКРЕПИТЬСЯ. МОСКВА УСЛЫШАЛА В ЭТИХ СЛОВАХ ПРИЗНАНИЕ
Dialogue: 0,0:16:06.65,0:16:09.05,Caption,,0,0,0,,ОБМАНА. ПУТИН ГОВОРИЛ О РАЗОЧАРОВАНИИ,
Dialogue: 0,0:16:09.37,0:16:11.21,Caption,,0,0,0,,РОССИЙСКИЕ ПРЕДСТАВИТЕЛИ ПОВТОРЯЛИ,
Dialogue: 0,0:16:11.45,0:16:13.77,Caption,,0,0,0,,ЧТО ДОГОВОРЁННОСТИ ИСПОЛЬЗОВАЛИ ДЛЯ ПОДГОТОВКИ
Dialogue: 0,0:16:13.77,0:16:18.20,Caption,,0,0,0,,УКРАИНЫ. НО БЕСКОНЕЧНЫЙ РАССКАЗ О ТОМ,
Dialogue: 0,0:16:18.44,0:16:23.32,Caption,,0,0,0,,КАК ТЕБЯ СНОВА ПЕРЕХИТРИЛИ, ПЛОХО РЕКЛАМИРУЕТ НЕ ТОЛЬКО ХИТРОСТЬ ПАРТНЁРА. ОДИН
Dialogue: 0,0:16:23.32,0:16:26.60,Caption,,0,0,0,,РАЗ МОЖНО ВИНИТЬ ЧУЖУЮ ЛОВКОСТЬ. ПОСЛЕ ВТОРОГО СТОИТ
Dialogue: 0,0:16:26.68,0:16:29.08,Caption,,0,0,0,,ПРОВЕРИТЬ СОБСТВЕННУЮ ДЕЛЕГАЦИЮ. ЕСЛИ
Dialogue: 0,0:16:29.08,0:16:33.00,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ АППАРАТ, РАЗВЕДКА И ОПЫТНЫЕ ПЕРЕГОВОРЩИКИ РЕГУЛЯРНО
Dialogue: 0,0:16:33.00,0:16:35.08,Caption,,0,0,0,,ВОЗВРАЩАЮТСЯ С ОДИНАКОВЫМ УДИВЛЕНИЕМ,
Dialogue: 0,0:16:35.47,0:16:38.36,Caption,,0,0,0,,ВОЗЛЕ НИХ УЖЕ НУЖЕН СОТРУДНИК С БЛОКНОТОМ. ЕГО
Dialogue: 0,0:16:38.36,0:16:40.52,Caption,,0,0,0,,ЕДИНСТВЕННАЯ ОБЯЗАННОСТЬ БУДЕТ СОСТОЯТЬ В
Dialogue: 0,0:16:40.52,0:16:43.88,Caption,,0,0,0,,НАПОМИНАНИИ, ЧЕМ ЗАКОНЧИЛСЯ ПРОШЛЫЙ ВЕЛИКИЙ КОМПРОМИСС.
Dialogue: 0,0:16:46.17,0:16:48.89,Caption,,0,0,0,,СЛОВА МЕРКЕЛЬ ВАЖНЫ КАК СИМВОЛ ПОДХОДА ДВЕ ТЫСЯЧИ
Dialogue: 0,0:16:48.89,0:16:51.85,Caption,,0,0,0,,ПЯТНАДЦАТОГО ГОДА. ТОГДА ДОГОВОРЁННОСТЬ ДАЛА ВРЕМЯ,
Dialogue: 0,0:16:52.17,0:16:54.25,Caption,,0,0,0,,НО НЕ СНЯЛА ПРОТИВОРЕЧИЯ. ТЕПЕРЬ,
Dialogue: 0,0:16:54.49,0:16:56.73,Caption,,0,0,0,,КОГДА СВОБОДНЫХ ДЕНЕГ ДЛЯ ПРОДОЛЖЕНИЯ ВОЙНЫ
Dialogue: 0,0:16:56.81,0:17:01.21,Caption,,0,0,0,,СТАНОВИТСЯ МЕНЬШЕ, РАЗГОВОР О ПЕРЕГОВОРАХ НЕИЗБЕЖНО УСИЛИТСЯ. И ГЛАВНЫЙ
Dialogue: 0,0:17:01.29,0:17:03.85,Caption,,0,0,0,,ВОПРОС БУДЕТ НЕ В КРАСИВОЙ ЦЕРЕМОНИИ ПОДПИСАНИЯ.
Dialogue: 0,0:17:04.17,0:17:06.65,Caption,,0,0,0,,ИЗВЛЕКЛИ ЛИ УЧАСТНИКИ УРОКИ ПОСЛЕ МИНСКА?
Dialogue: 0,0:17:06.81,0:17:11.37,Caption,,0,0,0,,ЗАПАД, РОССИЯ, УКРАИНА? ИЛИ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ОДНА СТОРОНА ОПЯТЬ
Dialogue: 0,0:17:11.37,0:17:14.73,Caption,,0,0,0,,ПОХВАЛИТСЯ ВЫИГРАННОЙ ПАУЗОЙ, А ДРУГАЯ СНОВА ОБНАРУЖИТ,
Dialogue: 0,0:17:15.01,0:17:17.21,Caption,,0,0,0,,ЧТО ЧИТАЛА МЕЛКИЙ ШРИФТ УЖЕ ПОСЛЕ СДЕЛКИ?
Dialogue: 0,0:17:19.48,0:17:21.32,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ХОТИТЕ ВИДЕТЬ,
Dialogue: 0,0:17:21.51,0:17:23.64,Caption,,0,0,0,,КАК ОБЕЩАНИЯ МЕНЯЮТСЯ В ТОТ МОМЕНТ,
Dialogue: 0,0:17:23.85,0:17:27.00,Caption,,0,0,0,,КОГДА ДОХОДЯТ ДО БЮДЖЕТА. ИМЕННО ТАМ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:17:27.00,0:17:29.16,Caption,,0,0,0,,ЕДИНСТВО ПЕРЕВОДИТСЯ НА ЯЗЫК СУММ,
Dialogue: 0,0:17:29.26,0:17:32.76,Caption,,0,0,0,,СРОКОВ И ТЕХ ПРОГРАММ, КОТОРЫМИ ПРИДЁТСЯ ПОЖЕРТВОВАТЬ.
Dialogue: 0,0:17:35.05,0:17:38.01,Caption,,0,0,0,,ДЛЯ ЕВРОПЫ ИТОГ ЕЩЁ НЕПРИЯТНЕЕ. ОНА ПЫТАЕТСЯ
Dialogue: 0,0:17:38.01,0:17:39.69,Caption,,0,0,0,,ОДНОВРЕМЕННО ДАВИТЬ НА МОСКВУ,
Dialogue: 0,0:17:39.85,0:17:43.13,Caption,,0,0,0,,ОПЛАЧИВАТЬ КИЕВ, ЗАМЕНЯТЬ РОССИЙСКИЕ ЭНЕРГОНОСИТЕЛИ,
Dialogue: 0,0:17:43.29,0:17:46.33,Caption,,0,0,0,,УДЕРЖИВАТЬ КАПИТАЛ И УБЕЖДАТЬ СОБСТВЕННЫХ ГРАЖДАН
Dialogue: 0,0:17:46.33,0:17:49.45,Caption,,0,0,0,,СОГЛАСИТЬСЯ НА НОВЫЕ РАСХОДЫ. ЭТИ ЗАДАЧИ СПОРЯТ ЗА
Dialogue: 0,0:17:49.53,0:17:52.17,Caption,,0,0,0,,ОДНИ И ТЕ ЖЕ ДЕНЬГИ. ПОЭТОМУ ДЕНЬ ЗАВЕРШИЛСЯ
Dialogue: 0,0:17:52.25,0:17:55.21,Caption,,0,0,0,,СМЕНОЙ ПРИОРИТЕТОВ. СОБСТВЕННАЯ АРМИЯ РАНЬШЕ
Dialogue: 0,0:17:55.21,0:17:58.81,Caption,,0,0,0,,УКРАИНСКОГО ВЗНОСА. ДОРОГАЯ ЭНЕРГИЯ РАНЬШЕ КРАСИВОГО
Dialogue: 0,0:17:58.81,0:18:02.25,Caption,,0,0,0,,ОТКАЗА ОТ РОССИИ. ВНУТРЕННИЕ ФОНДЫ РАНЬШЕ СЕМИЛЕТНЕЙ
Dialogue: 0,0:18:02.25,0:18:07.97,Caption,,0,0,0,,ЩЕДРОСТИ. САМАЯ ОПАСНАЯ ДЛЯ КИЕВА ПЕРЕМЕНА ПРОИСХОДИТ БЕЗ
Dialogue: 0,0:18:07.97,0:18:10.77,Caption,,0,0,0,,ГРОМКОГО ПРЕДАТЕЛЬСТВА. СОЮЗНИКИ ОСТАЮТСЯ
Dialogue: 0,0:18:10.77,0:18:14.61,Caption,,0,0,0,,СОЮЗНИКАМИ, НО ВСЁ ЧАЩЕ ПРЕДЛАГАЮТ ПОДДЕРЖКУ ПОСЛЕ ВЫПОЛНЕНИЯ
Dialogue: 0,0:18:14.61,0:18:17.73,Caption,,0,0,0,,СОБСТВЕННЫХ УСЛОВИЙ. ВАШИНГТОН СОБИРАЕТ ПОЛЕЗНЫЙ
Dialogue: 0,0:18:17.73,0:18:21.33,Caption,,0,0,0,,ОТКАЗ. ВАРШАВА БЕРЕЖЁТ БЮДЖЕТ. БРЮССЕЛЬ СМОТРИТ НА
Dialogue: 0,0:18:21.33,0:18:24.93,Caption,,0,0,0,,РОССИЙСКУЮ КАССУ. БЕРЛИН РАСШИРЯЕТ ПОЛНОМОЧИЯ СЛУЖБ.
Dialogue: 0,0:18:25.13,0:18:28.45,Caption,,0,0,0,,А УКРАИНА ДОЛЖНА ДЕРЖАТЬСЯ, ПОКА ВСЕ ОСТАЛЬНЫЕ РЕШАЮТ,
Dialogue: 0,0:18:28.61,0:18:31.41,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ГОТОВЫ ЗАПЛАТИТЬ ЗА ЭТО СЛОВО. ВОТ
Dialogue: 0,0:18:31.41,0:18:34.45,Caption,,0,0,0,,ЧЕМ ЗАКОНЧИЛСЯ ДЕНЬ. ЕВРОПА НЕ ОТКАЗАЛАСЬ ОТ КИЕВА.
Dialogue: 0,0:18:34.77,0:18:36.53,Caption,,0,0,0,,ОНА НАЧАЛА СЧИТАТЬ ЕГО ЦЕНУ ВСЛУХ.
