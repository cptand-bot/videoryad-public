Dialogue: 0,0:00:00.11,0:00:02.36,Caption,,0,0,0,,ПЯТЬ ЛЕТ НАЗАД ВСЕ УЖЕ СТОЯЛИ ПРИМЕРНО У
Dialogue: 0,0:00:02.44,0:00:04.60,Caption,,0,0,0,,ЭТОЙ ЖЕ ДВЕРИ. ТОГДА ОТКРЫТЬ ЕЁ ТАК И
Dialogue: 0,0:00:04.68,0:00:06.60,Caption,,0,0,0,,НЕ СМОГЛИ. А ДАЛЬШЕ БЫЛО УЖЕ НЕ ДО
Dialogue: 0,0:00:06.60,0:00:10.92,Caption,,0,0,0,,ДВЕРЕЙ. НАЧАЛАСЬ ВОЙНА, И ЗА ЭТИ ГОДЫ ЧУБЫ ПОТРЕПАЛО ВСЕХ ТАК,
Dialogue: 0,0:00:11.16,0:00:13.80,Caption,,0,0,0,,ЧТО ТЕПЕРЬ СНОВА ПРИШЛОСЬ СОБИРАТЬСЯ И ВСПОМИНАТЬ,
Dialogue: 0,0:00:13.96,0:00:16.52,Caption,,0,0,0,,С ЧЕГО ВООБЩЕ ВСЁ НАЧИНАЛОСЬ. И ВОТ ТУТ
Dialogue: 0,0:00:16.52,0:00:19.40,Caption,,0,0,0,,ВОПРОС ЕСЛИ ПЯТЬ ЛЕТ НАЗАД ДОГОВОРИТЬСЯ НЕ СМОГЛИ,
Dialogue: 0,0:00:19.72,0:00:24.20,Caption,,0,0,0,,ЧТО ТАКОГО ИЗМЕНИЛОСЬ СЕЙЧАС? ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ТОЛЬКО ГРОМКИЕ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:24.46,0:00:29.08,Caption,,0,0,0,,НО И ТО, ЧТО ЗА НИМИ СТОИТ, ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО СЕЙЧАС КАК РАЗ ТОТ
Dialogue: 0,0:00:29.08,0:00:31.96,Caption,,0,0,0,,СЛУЧАЙ, КОГДА СМОТРЕТЬ НАДО НЕ СТОЛЬКО НА СЛОВА,
Dialogue: 0,0:00:32.19,0:00:34.84,Caption,,0,0,0,,СКОЛЬКО НА ТО, ЧТО НАЧНЁТ ПРОИСХОДИТЬ ПОТОМ.
Dialogue: 0,0:00:35.64,0:00:38.04,Caption,,0,0,0,,В АБУ ДАБИ ИДУТ ПЕРЕГОВОРЫ. НУ ИДУТ И
Dialogue: 0,0:00:38.04,0:00:40.76,Caption,,0,0,0,,ИДУТ. ЗА ДВА ДНЯ ТАМ СЕЙЧАС НАГОВОРЯТ СТОЛЬКО,
Dialogue: 0,0:00:41.00,0:00:43.00,Caption,,0,0,0,,ЧТО ПОТОМ ЕЩЁ НЕДЕЛЮ БУДУТ ПЕРЕВОДИТЬ С
Dialogue: 0,0:00:43.00,0:00:45.80,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКОГО НА ЧЕЛОВЕЧЕСКИЙ. ОДИН СКАЖЕТ,
Dialogue: 0,0:00:45.89,0:00:48.28,Caption,,0,0,0,,ЧТО РАЗГОВОР БЫЛ ПОЛЕЗНЫМ. ВТОРОЙ СКАЖЕТ,
Dialogue: 0,0:00:48.52,0:00:51.48,Caption,,0,0,0,,ЧТО СТОРОНЫ УСЛЫШАЛИ ДРУГ ДРУГА. ТРЕТИЙ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:00:51.48,0:00:54.36,Caption,,0,0,0,,НАЙДЁТ ИСТОРИЧЕСКИЙ ПРОГРЕСС. ЧЕТВЁРТЫЙ ОБЪЯВИТ,
Dialogue: 0,0:00:54.52,0:00:59.64,Caption,,0,0,0,,ЧТО МИР УЖЕ ГДЕ ТО РЯДОМ, БУКВАЛЬНО ЗА УГЛОМ. ВСЕ БУДУТ МОЛОДЦЫ. ВСЕ ПОБЕДИЛИ.
Dialogue: 0,0:00:59.82,0:01:02.84,Caption,,0,0,0,,ВСЕ НИКОМУ НЕ УСТУПИЛИ. КРАСОТА. ТОЛЬКО НАМ С
Dialogue: 0,0:01:02.84,0:01:04.60,Caption,,0,0,0,,ВАМИ ОТ ЭТОГО НИ ХОЛОДНО НИ ЖАРКО.
Dialogue: 0,0:01:06.89,0:01:09.37,Caption,,0,0,0,,ПОТОМУ ЧТО НИКТО ПОСЛЕ ЗАКРЫТОЙ ВСТРЕЧИ НЕ ВЫЙДЕТ
Dialogue: 0,0:01:09.45,0:01:11.05,Caption,,0,0,0,,К ЖУРНАЛИСТАМ И НЕ СКАЖЕТ РЕБЯТА,
Dialogue: 0,0:01:11.38,0:01:14.01,Caption,,0,0,0,,ВОТ ЗДЕСЬ МЫ УСТУПИЛИ, ЗДЕСЬ НАС ПРОДАВИЛИ,
Dialogue: 0,0:01:14.29,0:01:18.09,Caption,,0,0,0,,ЗДЕСЬ МЫ СОГЛАСИЛИСЬ, А ЗДЕСЬ НАС ВООБЩЕ ПОСЛАЛИ. ТАК НЕ РАБОТАЕТ.
Dialogue: 0,0:01:18.41,0:01:20.97,Caption,,0,0,0,,ПОЭТОМУ САМИ ПЕРЕГОВОРЫ СЕЙЧАС ИНТЕРЕСНЫ ТОЛЬКО В
Dialogue: 0,0:01:21.05,0:01:23.93,Caption,,0,0,0,,ОДНОМ СМЫСЛЕ. КТО ТУДА ПРИЕХАЛ. КТО ПЫТАЕТСЯ
Dialogue: 0,0:01:24.01,0:01:26.89,Caption,,0,0,0,,ПРОЛЕЗТЬ ЗА СТОЛ. КАКИЕ ВОПРОСЫ ПЫТАЮТСЯ ВЫНЕСТИ
Dialogue: 0,0:01:26.89,0:01:29.69,Caption,,0,0,0,,НАВЕРХ. И ЧТО КАЖДЫЙ УЧАСТНИК ХОЧЕТ НЕ ДАТЬ
Dialogue: 0,0:01:29.69,0:01:32.97,Caption,,0,0,0,,ДРУГОМУ СДЕЛАТЬ. А НАСТОЯЩАЯ ИСТОРИЯ НАЧНЁТСЯ ПОСЛЕ.
Dialogue: 0,0:01:33.18,0:01:36.33,Caption,,0,0,0,,ВОТ ТОГДА И ПОСМОТРИМ. ТЕМ БОЛЕЕ FINANCIAL TIMES
Dialogue: 0,0:01:36.33,0:01:40.17,Caption,,0,0,0,,ПИШЕТ, ЧТО ЕВРОПЕЙЦЫ РЕШИЛИ НЕ СТОЯТЬ В КОРИДОРЕ. СОВЕТНИКИ
Dialogue: 0,0:01:40.17,0:01:45.53,Caption,,0,0,0,,ФРАНЦИИ, ГЕРМАНИИ И БРИТАНИИ, ПРЕДСТАВИТЕЛИ ЕВРОКОМИССИИ И НАТО СОБИРАЮТСЯ
Dialogue: 0,0:01:45.61,0:01:48.25,Caption,,0,0,0,,УЧАСТВОВАТЬ В ОТДЕЛЬНЫХ ЧАСТЯХ ПЕРЕГОВОРОВ. ПРИЧИНА
Dialogue: 0,0:01:48.25,0:01:52.89,Caption,,0,0,0,,ПОНЯТНАЯ. ЕВРОПА БОИТСЯ, ЧТО АМЕРИКАНЦЫ С РУССКИМИ НАЧНУТ ОБСУЖДАТЬ ТАКИЕ
Dialogue: 0,0:01:52.97,0:01:55.37,Caption,,0,0,0,,ВЕЩИ, КОТОРЫЕ ЕВРОПА СЧИТАЕТ СВОИМИ.
Dialogue: 0,0:01:55.92,0:02:00.09,Caption,,0,0,0,,УЧЕНИЯ НАТО. РАЗМЕЩЕНИЕ ВОЙСК. ВООРУЖЕНИЯ. ВОЕННАЯ
Dialogue: 0,0:02:00.09,0:02:02.49,Caption,,0,0,0,,ИНФРАСТРУКТУРА. ВСЯ ТА КОНСТРУКЦИЯ,
Dialogue: 0,0:02:02.73,0:02:04.97,Caption,,0,0,0,,ВОКРУГ КОТОРОЙ МОСКВА СПОРИТ С ЗАПАДОМ УЖЕ НЕ
Dialogue: 0,0:02:05.05,0:02:08.01,Caption,,0,0,0,,ПЕРВЫЙ ГОД. И ТУТ НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ.
Dialogue: 0,0:02:08.33,0:02:11.13,Caption,,0,0,0,,ЕВРОПА ГОВОРИТ НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ НАМ НЕ
Dialogue: 0,0:02:11.13,0:02:13.85,Caption,,0,0,0,,НАДО. У НАС УЖЕ ВСЁ ЕСТЬ. ПРЕКРАСНО. А
Dialogue: 0,0:02:13.93,0:02:16.25,Caption,,0,0,0,,ЧТО ИМЕННО У ВАС ЕСТЬ? ТА СИСТЕМА,
Dialogue: 0,0:02:16.49,0:02:18.89,Caption,,0,0,0,,ПРИ КОТОРОЙ ЕВРОПА ПРИШЛА К КРУПНЕЙШЕМУ ВОЕННОМУ
Dialogue: 0,0:02:18.89,0:02:20.81,Caption,,0,0,0,,КОНФЛИКТУ ЗА ПОСЛЕДНИЕ ДЕСЯТИЛЕТИЯ?
Dialogue: 0,0:02:23.01,0:02:25.49,Caption,,0,0,0,,ВОТ ОНА, ЗНАЧИТ, ПРЕКРАСНО РАБОТАЕТ?
Dialogue: 0,0:02:25.72,0:02:28.77,Caption,,0,0,0,,НИЧЕГО МЕНЯТЬ НЕ НАДО? ЭТО КАК ЕСЛИ У ЧЕЛОВЕКА ДОМ ПЯТЬ ЛЕТ
Dialogue: 0,0:02:28.77,0:02:31.97,Caption,,0,0,0,,ГОРИТ, А ОН ГОВОРИТ СИСТЕМУ ПОЖАРНОЙ БЕЗОПАСНОСТИ ТРОГАТЬ
Dialogue: 0,0:02:31.97,0:02:34.69,Caption,,0,0,0,,НЕЛЬЗЯ. ОНА У НАС ХОРОШАЯ. ПРОСТО ДОМ ПОЧЕМУ
Dialogue: 0,0:02:34.77,0:02:37.01,Caption,,0,0,0,,ТО СГОРЕЛ. ФОН ДЕР ЛЯЙЕН ТОЖЕ ГОВОРИТ ПРИМЕРНО
Dialogue: 0,0:02:37.01,0:02:39.73,Caption,,0,0,0,,В ТОМ ЖЕ НАПРАВЛЕНИИ. СНАЧАЛА ПРЕКРАЩЕНИЕ ОГНЯ НА
Dialogue: 0,0:02:39.73,0:02:43.65,Caption,,0,0,0,,УКРАИНЕ, ПОТОМ РАЗГОВОРЫ О НОВОЙ СИСТЕМЕ БЕЗОПАСНОСТИ. ГЛАВА
Dialogue: 0,0:02:43.65,0:02:46.37,Caption,,0,0,0,,МИД ГЕРМАНИИ ВАДЕФУЛЬ ВООБЩЕ ГОВОРИТ ЕЩЁ ПРОЩЕ.
Dialogue: 0,0:02:46.68,0:02:49.65,Caption,,0,0,0,,НОВОЙ АРХИТЕКТУРЫ НЕ НАДО. НАДО ВОССТАНОВИТЬ СТАРУЮ.
Dialogue: 0,0:02:50.13,0:02:52.77,Caption,,0,0,0,,ВОТ ТОЛЬКО ЗДЕСЬ И ВОЗНИКАЕТ НЕПРИЯТНЫЙ ВОПРОС. А
Dialogue: 0,0:02:52.77,0:02:56.93,Caption,,0,0,0,,ПОЧЕМУ СТАРАЯ НЕ СРАБОТАЛА? ПОТОМУ ЧТО ПЯТЬ ЛЕТ НАЗАД МОСКВА УЖЕ ГОВОРИЛА
Dialogue: 0,0:02:56.93,0:02:59.97,Caption,,0,0,0,,ПРИМЕРНО ОБ ЭТОМ ЖЕ. О НАТО. О ВООРУЖЕНИЯХ.
Dialogue: 0,0:03:00.22,0:03:02.45,Caption,,0,0,0,,О ВОЕННОЙ ИНФРАСТРУКТУРЕ. О ТОМ,
Dialogue: 0,0:03:02.61,0:03:05.57,Caption,,0,0,0,,ЧТО ОНА СЧИТАЕТ УГРОЗОЙ ВОЗЛЕ СВОИХ ГРАНИЦ. ЕЙ
Dialogue: 0,0:03:05.57,0:03:08.69,Caption,,0,0,0,,ТОГДА ОБЪЯСНИЛИ, ЧТО НИЧЕГО ТАКОГО ПЕРЕСМАТРИВАТЬ НИКТО НЕ
Dialogue: 0,0:03:08.69,0:03:12.13,Caption,,0,0,0,,СОБИРАЕТСЯ. НУ ХОРОШО. НЕ ПЕРЕСМОТРЕЛИ. ДАЛЬШЕ МЫ
Dialogue: 0,0:03:12.13,0:03:14.21,Caption,,0,0,0,,ВСЕ ПРЕКРАСНО ЗНАЕМ. И ТЕПЕРЬ,
Dialogue: 0,0:03:14.36,0:03:18.69,Caption,,0,0,0,,СПУСТЯ ПЯТЬ ЛЕТ ВОЙНЫ, ЕВРОПА СНОВА ГОВОРИТ ДАВАЙТЕ ОСТАВИМ ВСЁ ПРИМЕРНО
Dialogue: 0,0:03:18.69,0:03:21.97,Caption,,0,0,0,,ТАК, КАК БЫЛО. ЛОГИКА ЖЕЛЕЗНАЯ. ГЛАВНОЕ,
Dialogue: 0,0:03:22.13,0:03:25.01,Caption,,0,0,0,,ВТОРОЙ РАЗ НАСТУПИТЬ ТОЧНО ТУДА ЖЕ. ВДРУГ ТЕПЕРЬ
Dialogue: 0,0:03:25.01,0:03:28.29,Caption,,0,0,0,,СРАБОТАЕТ. НО ВЕДЬ ПРОБЛЕМА ЕЩЁ ШИРЕ. УКРАИНЕ НУЖНЫ
Dialogue: 0,0:03:28.37,0:03:31.33,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ. ПОНЯТНО. ЕВРОПЕ НУЖНЫ
Dialogue: 0,0:03:31.33,0:03:34.85,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ. ТОЖЕ ПОНЯТНО. РОССИЯ ГОВОРИТ,
Dialogue: 0,0:03:35.00,0:03:36.93,Caption,,0,0,0,,ЧТО ЕЙ НУЖНЫ ГАРАНТИИ БЕЗОПАСНОСТИ.
Dialogue: 0,0:03:39.21,0:03:41.53,Caption,,0,0,0,,БЕЛОРУССИЯ ТОЖЕ НЕ НАХОДИТСЯ ГДЕ ТО НА МАРСЕ.
Dialogue: 0,0:03:41.93,0:03:44.49,Caption,,0,0,0,,ТУРЦИЯ ВООБЩЕ ЧЛЕН НАТО И ОДНОВРЕМЕННО ЖИВЁТ СО
Dialogue: 0,0:03:44.49,0:03:48.01,Caption,,0,0,0,,СВОИМИ ИНТЕРЕСАМИ, КОТОРЫЕ ДАЛЕКО НЕ ВСЕГДА СОВПАДАЮТ С ИНТЕРЕСАМИ
Dialogue: 0,0:03:48.01,0:03:50.81,Caption,,0,0,0,,БРЮССЕЛЯ. А ДАЛЬШЕ КИТАЙ. ОН ВРОДЕ БЫ НЕ
Dialogue: 0,0:03:50.81,0:03:54.89,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ СТРАНА, НО ЕСЛИ КРУПНЕЙШИЕ ДЕРЖАВЫ НАЧИНАЮТ ПЕРЕКРАИВАТЬ
Dialogue: 0,0:03:54.89,0:03:57.37,Caption,,0,0,0,,ПРАВИЛА БЕЗОПАСНОСТИ НА ОГРОМНОМ ПРОСТРАНСТВЕ,
Dialogue: 0,0:03:57.62,0:03:59.61,Caption,,0,0,0,,ПЕКИН ЯВНО НЕ БУДЕТ СМОТРЕТЬ НА ЭТО КАК
Dialogue: 0,0:03:59.69,0:04:02.65,Caption,,0,0,0,,НА ЧЕМПИОНАТ ПО КЕРЛИНГУ. ВСЕ ЗАИНТЕРЕСОВАНЫ. ВОТ
Dialogue: 0,0:04:02.65,0:04:05.29,Caption,,0,0,0,,ТОЛЬКО КАЖДЫЙ ХОЧЕТ ГАРАНТИЙ ПРЕЖДЕ ВСЕГО ДЛЯ СЕБЯ.
Dialogue: 0,0:04:05.85,0:04:08.33,Caption,,0,0,0,,И ТУТ РУБИО СКАЗАЛ ОЧЕНЬ ПРОСТУЮ ВЕЩЬ. БЕЗ
Dialogue: 0,0:04:08.33,0:04:11.85,Caption,,0,0,0,,ДЛИННОЙ ЛЕКЦИИ. БЕЗ ТРЁХ ПАПОК ДОКУМЕНТОВ. ГАРАНТИИ
Dialogue: 0,0:04:11.85,0:04:14.09,Caption,,0,0,0,,БЕЗОПАСНОСТИ УКРАИНЫ ДОЛЖНЫ БЫТЬ ТАКИМИ,
Dialogue: 0,0:04:14.32,0:04:17.13,Caption,,0,0,0,,ЧТОБЫ С НИМИ СОГЛАСИЛАСЬ РОССИЯ. ВСЁ. ВОТ ВАМ
Dialogue: 0,0:04:17.13,0:04:19.13,Caption,,0,0,0,,ВСЯ ФОРМУЛА. ХОЧЕТ КИЕВ ГАРАНТИЙ?
Dialogue: 0,0:04:19.13,0:04:22.09,Caption,,0,0,0,,ХОРОШО. НО ЕСЛИ МОСКВА СМОТРИТ НА ЭТИ ГАРАНТИИ
Dialogue: 0,0:04:22.09,0:04:26.17,Caption,,0,0,0,,И ГОВОРИТ РЕБЯТА, ВЫ ПОД ВИДОМ БЕЗОПАСНОСТИ УКРАИНЫ СНОВА СТАВИТЕ МНЕ
Dialogue: 0,0:04:26.17,0:04:28.73,Caption,,0,0,0,,ПОД БОК ТО, ПРОТИВ ЧЕГО МЫ ПЯТЬ ЛЕТ СПОРИМ,
Dialogue: 0,0:04:29.05,0:04:31.61,Caption,,0,0,0,,ТО НИКАКОЙ ГАРАНТИИ НЕ ПОЛУЧИЛОСЬ. ПОЛУЧИЛАСЬ НОВАЯ
Dialogue: 0,0:04:31.61,0:04:34.33,Caption,,0,0,0,,ПРИЧИНА ДЛЯ СЛЕДУЮЩЕГО КОНФЛИКТА. И ТО ЖЕ САМОЕ
Dialogue: 0,0:04:34.33,0:04:36.97,Caption,,0,0,0,,РАБОТАЕТ В ОБРАТНУЮ СТОРОНУ. РОССИЯ НЕ МОЖЕТ
Dialogue: 0,0:04:36.97,0:04:39.69,Caption,,0,0,0,,НАПИСАТЬ СЕБЕ НА БУМАГЕ ВСЁ, ЧТО ЕЙ НРАВИТСЯ,
Dialogue: 0,0:04:39.93,0:04:42.09,Caption,,0,0,0,,ПОЛОЖИТЬ ДОКУМЕНТ НА СТОЛ И СКАЗАТЬ ЕВРОПЕ
Dialogue: 0,0:04:42.09,0:04:45.29,Caption,,0,0,0,,РАСПИШИТЕСЬ ВОТ ЗДЕСЬ. ЕВРОПА ТОЖЕ ДОЛЖНА ПОНИМАТЬ,
Dialogue: 0,0:04:45.45,0:04:48.17,Caption,,0,0,0,,С ЧЕМ ОНА СОГЛАШАЕТСЯ. ВОТ И ВСЯ АРИФМЕТИКА.
Dialogue: 0,0:04:50.44,0:04:53.40,Caption,,0,0,0,,НЕ НАДО ЗДЕСЬ ДИССЕРТАЦИЮ ПИСАТЬ. ОДНОМУ ДОЛЖНО БЫТЬ
Dialogue: 0,0:04:53.40,0:04:56.20,Caption,,0,0,0,,СПОКОЙНО, И ВТОРОЙ ПРИ ЭТОМ НЕ ДОЛЖЕН ХВАТАТЬСЯ ЗА
Dialogue: 0,0:04:56.29,0:04:59.80,Caption,,0,0,0,,РАКЕТУ. ТОГДА ЭТО ЕЩЁ МОЖНО НАЗВАТЬ БЕЗОПАСНОСТЬЮ. А
Dialogue: 0,0:04:59.88,0:05:01.64,Caption,,0,0,0,,ЕСЛИ ОДНОМУ ХОРОШО ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:05:01.80,0:05:06.04,Caption,,0,0,0,,ЧТО ВТОРОМУ СТРАШНО, ТО ЭТО НЕ ГАРАНТИЯ. ЭТО ПАУЗА ДО СЛЕДУЮЩЕГО
Dialogue: 0,0:05:06.04,0:05:09.64,Caption,,0,0,0,,РАУНДА. КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР БЕЗ КИЛОМЕТРОВ
Dialogue: 0,0:05:09.64,0:05:13.96,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКОГО ТУМАНА, ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ КАК РАЗ ПЫТАЕМСЯ СМОТРЕТЬ НЕ
Dialogue: 0,0:05:14.04,0:05:17.24,Caption,,0,0,0,,НА КРАСИВЫЕ СЛОВА, А НА ТО, ЧТО ЗА НИМИ ПОСЛЕДУЕТ.
Dialogue: 0,0:05:18.05,0:05:20.44,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ВОЗВРАЩАЕМСЯ К ЕВРОПЕ. ПОТОМУ ЧТО
Dialogue: 0,0:05:20.52,0:05:23.73,Caption,,0,0,0,,ВНУТРИ САМОЙ ЕВРОПЫ УЖЕ НЕТ КРАСИВОГО ЕДИНОГО ХОРА.
Dialogue: 0,0:05:24.29,0:05:27.56,Caption,,0,0,0,,ПРЕМЬЕР НОРВЕГИИ ЙОНАС ГАР СТЁРЕ ФАКТИЧЕСКИ ПРИЗНАЛ
Dialogue: 0,0:05:27.56,0:05:30.60,Caption,,0,0,0,,ПРОСТУЮ ВЕЩЬ. ИЗОЛИРОВАТЬ РОССИЮ НЕ ПОЛУЧИЛОСЬ. И
Dialogue: 0,0:05:30.60,0:05:33.96,Caption,,0,0,0,,ДАЛЬШЕ ОН ГОВОРИТ ЕЩЁ ИНТЕРЕСНЕЕ. ЕСЛИ ЕВРОПА САМА
Dialogue: 0,0:05:34.04,0:05:36.44,Caption,,0,0,0,,С МОСКВОЙ НЕ РАЗГОВАРИВАЕТ, ТО ГОЛОС,
Dialogue: 0,0:05:36.60,0:05:41.00,Caption,,0,0,0,,КОТОРЫЙ МОСКВА СЛЫШИТ, ИДЁТ ИЗ ВАШИНГТОНА. ПРЕКРАСНАЯ СИТУАЦИЯ. СНАЧАЛА
Dialogue: 0,0:05:41.00,0:05:43.24,Caption,,0,0,0,,ЕВРОПА ГОВОРИТ МЫ С НИМИ РАЗГОВАРИВАТЬ НЕ БУДЕМ.
Dialogue: 0,0:05:43.48,0:05:46.12,Caption,,0,0,0,,ПОТОМ АМЕРИКА НАЧИНАЕТ РАЗГОВАРИВАТЬ. ПОСЛЕ ЭТОГО
Dialogue: 0,0:05:46.12,0:05:48.28,Caption,,0,0,0,,ЕВРОПА ВОЗМУЩАЕТСЯ А ЧЕГО ЭТО ВЫ ТАМ БЕЗ
Dialogue: 0,0:05:48.36,0:05:50.20,Caption,,0,0,0,,НАС РАЗГОВАРИВАЕТЕ? НУ А КАК ЕЩЁ?
Dialogue: 0,0:05:50.52,0:05:52.12,Caption,,0,0,0,,ЕСЛИ ВЫ САМИ ВЫШЛИ ИЗ КОМНАТЫ,
Dialogue: 0,0:05:52.28,0:05:54.76,Caption,,0,0,0,,СТУЛ ПУСТЫМ ДОЛГО НЕ СТОИТ. И НОРВЕГИЯ КАК
Dialogue: 0,0:05:54.76,0:05:56.76,Caption,,0,0,0,,РАЗ ГОВОРИТ ХОТИТЕ ВЛИЯТЬ НА РЕЗУЛЬТАТ,
Dialogue: 0,0:05:56.84,0:05:59.40,Caption,,0,0,0,,ПРИДЁТСЯ РАЗГОВАРИВАТЬ. А ГЕРМАНИЯ ОТВЕЧАЕТ
Dialogue: 0,0:05:59.47,0:06:02.12,Caption,,0,0,0,,РАЗГОВАРИВАТЬ МОЖНО, ТОЛЬКО СИСТЕМУ НЕ ТРОГАЙТЕ.
Dialogue: 0,0:06:04.40,0:06:07.20,Caption,,0,0,0,,ВОТ ТАКАЯ ЕВРОПЕЙСКАЯ ГАРМОНИЯ. ОДИН ГОВОРИТ,
Dialogue: 0,0:06:07.40,0:06:10.48,Caption,,0,0,0,,ЧТО БЕЗ ПРЯМОГО ДИАЛОГА НИЧЕГО НЕ ЗАКОНЧИТСЯ. ДРУГОЙ
Dialogue: 0,0:06:10.48,0:06:14.88,Caption,,0,0,0,,ГОВОРИТ, ЧТО ГЛАВНУЮ ТЕМУ, ИЗ ЗА КОТОРОЙ МОСКВА ВООБЩЕ ХОЧЕТ ЭТОГО ДИАЛОГА,
Dialogue: 0,0:06:15.11,0:06:17.52,Caption,,0,0,0,,ПЕРЕСМАТРИВАТЬ НЕ НАДО. И ВСЁ ЭТО ПРОИСХОДИТ
Dialogue: 0,0:06:17.52,0:06:20.48,Caption,,0,0,0,,ОДНОВРЕМЕННО. НА ЭТОМ ФОНЕ РУБИО ВЫГЛЯДИТ ЧУТЬ ЛИ
Dialogue: 0,0:06:20.56,0:06:23.04,Caption,,0,0,0,,НЕ САМЫМ ПОНЯТНЫМ ЧЕЛОВЕКОМ В КОМНАТЕ. ОН ХОТЯ
Dialogue: 0,0:06:23.12,0:06:27.28,Caption,,0,0,0,,БЫ ФОРМУЛИРУЕТ ПРАВИЛО, КОТОРОЕ ТРУДНО НЕ ПОНЯТЬ. ЕСЛИ ВЫ ХОТИТЕ,
Dialogue: 0,0:06:27.38,0:06:31.20,Caption,,0,0,0,,ЧТОБЫ СОГЛАШЕНИЕ РАБОТАЛО, ОНО ДОЛЖНО УСТРАИВАТЬ НЕ ТОЛЬКО ТОГО,
Dialogue: 0,0:06:31.28,0:06:33.52,Caption,,0,0,0,,КОМУ НРАВИТСЯ БУМАГА, НО И ТОГО,
Dialogue: 0,0:06:33.60,0:06:36.80,Caption,,0,0,0,,ПРОТИВ КОГО ЭТА БУМАГА ПОТОМ БУДЕТ РАБОТАТЬ. ИМЕННО
Dialogue: 0,0:06:36.80,0:06:39.52,Caption,,0,0,0,,ПОЭТОМУ НЫНЕШНИЙ РАЗГОВОР НАМНОГО БОЛЬШЕ УКРАИНЫ.
Dialogue: 0,0:06:39.83,0:06:42.96,Caption,,0,0,0,,УКРАИНА ЗДЕСЬ ЦЕНТРАЛЬНАЯ ЧАСТЬ КОНФЛИКТА. НО СПОР
Dialogue: 0,0:06:42.96,0:06:47.44,Caption,,0,0,0,,ИДЁТ УЖЕ НЕ ТОЛЬКО О ТОМ, ГДЕ ЗАКОНЧИТСЯ ЛИНИЯ БОЕВЫХ ДЕЙСТВИЙ. СПОР ИДЁТ О
Dialogue: 0,0:06:47.44,0:06:51.60,Caption,,0,0,0,,ТОМ, ЧТО БУДЕТ ПОСЛЕ. ГДЕ БУДУТ ВОЙСКА. КАКИЕ ВООРУЖЕНИЯ
Dialogue: 0,0:06:51.60,0:06:54.72,Caption,,0,0,0,,БУДУТ РАЗМЕЩАТЬСЯ. КАКИЕ УЧЕНИЯ БУДУТ ПРОВОДИТЬСЯ.
Dialogue: 0,0:06:54.90,0:06:57.92,Caption,,0,0,0,,ЧТО РОССИЯ СЧИТАЕТ УГРОЗОЙ. ЧТО ЕВРОПА СЧИТАЕТ
Dialogue: 0,0:06:58.00,0:07:00.96,Caption,,0,0,0,,УГРОЗОЙ. ЧТО УКРАИНА СЧИТАЕТ ГАРАНТИЕЙ. И ГДЕ
Dialogue: 0,0:07:00.96,0:07:04.96,Caption,,0,0,0,,ПРОХОДИТ ТА САМАЯ ЧЕРТА, ПОСЛЕ КОТОРОЙ ОЧЕРЕДНАЯ ГАРАНТИЯ ОДНОЙ СТОРОНЫ
Dialogue: 0,0:07:04.96,0:07:07.84,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ ДЛЯ ДРУГОЙ В КРАСНУЮ ТРЯПКУ. И ВОТ
Dialogue: 0,0:07:07.84,0:07:10.48,Caption,,0,0,0,,ЗДЕСЬ НА СЦЕНУ ВЫХОДИТ РЯБКОВ. ПРИЧЁМ ВЫХОДИТ ОН
Dialogue: 0,0:07:10.48,0:07:14.32,Caption,,0,0,0,,НЕ С УЛЫБКОЙ ЧЕЛОВЕКА, КОТОРЫЙ СОБИРАЕТСЯ ОБСУЖДАТЬ ЦВЕТ СКАТЕРТИ НА
Dialogue: 0,0:07:14.32,0:07:20.21,Caption,,0,0,0,,СЛЕДУЮЩЕЙ ВСТРЕЧЕ. ОН ГОВОРИТ РОССИЯ НАПАДАТЬ НА ЕВРОПУ НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:07:20.51,0:07:22.29,Caption,,0,0,0,,НО ЕСЛИ СТОЛКНЁТСЯ С АГРЕССИЕЙ,
Dialogue: 0,0:07:22.37,0:07:25.01,Caption,,0,0,0,,ОТВЕТИТ. И ОТДЕЛЬНО ЗВУЧИТ ФОРМУЛИРОВКА,
Dialogue: 0,0:07:25.25,0:07:27.97,Caption,,0,0,0,,ЧТО ТАКОЙ КОНФЛИКТ БУДЕТ ДРУГИМ И ОЧЕНЬ КОРОТКИМ.
Dialogue: 0,0:07:28.52,0:07:30.85,Caption,,0,0,0,,ВОТ ПОСЛЕ ТАКИХ СЛОВ СЛОВО "КОРОТКИМ" УЖЕ КАК
Dialogue: 0,0:07:30.93,0:07:33.09,Caption,,0,0,0,,ТО СОВСЕМ НЕ РАДУЕТ. ПОТОМУ ЧТО НИКТО НЕ
Dialogue: 0,0:07:33.09,0:07:35.73,Caption,,0,0,0,,ГОВОРИТ ПРО КОРОТКИЙ ФУТБОЛЬНЫЙ МАТЧ. РЕЧЬ ИДЁТ О
Dialogue: 0,0:07:35.73,0:07:38.61,Caption,,0,0,0,,ПРЯМОМ ВОЕННОМ СТОЛКНОВЕНИИ РОССИИ И ЕВРОПЕЙСКИХ
Dialogue: 0,0:07:38.69,0:07:40.77,Caption,,0,0,0,,СТРАН НАТО. А ЗДЕСЬ УЖЕ ОБЪЯСНЯТЬ,
Dialogue: 0,0:07:40.90,0:07:43.97,Caption,,0,0,0,,ПОЧЕМУ ЭТО ОПАСНО, ДУМАЮ, НИКОМУ НЕ НАДО.
Dialogue: 0,0:07:44.52,0:07:47.25,Caption,,0,0,0,,НЕБЕНЗЯ СЛЕДОМ ГОВОРИТ ПРИМЕРНО О ТОМ ЖЕ. РОССИЯ
Dialogue: 0,0:07:47.33,0:07:49.81,Caption,,0,0,0,,НЕ СТРЕМИТСЯ К ПРЯМОМУ СТОЛКНОВЕНИЮ С ЕВРОПОЙ,
Dialogue: 0,0:07:50.05,0:07:54.37,Caption,,0,0,0,,НО ЕСЛИ ДЕЛО ДО НЕГО ДОЙДЁТ, СОБЫТИЯ МОГУТ РАЗВИВАТЬСЯ СТРЕМИТЕЛЬНО. ДВА
Dialogue: 0,0:07:54.37,0:07:56.85,Caption,,0,0,0,,ВЫСОКОПОСТАВЛЕННЫХ РОССИЙСКИХ ДИПЛОМАТА ПРАКТИЧЕСКИ
Dialogue: 0,0:07:56.85,0:07:59.65,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОВОРЯТ ЕВРОПЕ ДАЛЬШЕ МОЖНО ОЧЕНЬ
Dialogue: 0,0:07:59.73,0:08:03.41,Caption,,0,0,0,,БЫСТРО ПРИЕХАТЬ ТУДА, ОТКУДА НАЗАД ДОРОГИ УЖЕ НЕ БУДЕТ. И ВОТ
Dialogue: 0,0:08:03.49,0:08:05.81,Caption,,0,0,0,,ЗДЕСЬ МЫ СНОВА ВОЗВРАЩАЕМСЯ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:05.81,0:08:08.93,Caption,,0,0,0,,ПЕРВЫЙ ГОД. ТОГДА РОССИЯ УЖЕ ВЫСТАВЛЯЛА ЗАПАДУ СВОИ
Dialogue: 0,0:08:08.93,0:08:11.49,Caption,,0,0,0,,ТРЕБОВАНИЯ ПО БЕЗОПАСНОСТИ. ТОГДА ИХ МНОГИЕ
Dialogue: 0,0:08:11.57,0:08:14.37,Caption,,0,0,0,,ВОСПРИНИМАЛИ КАК УЛЬТИМАТУМ. СЕГОДНЯ МЫ СНОВА ПРИШЛИ
Dialogue: 0,0:08:14.37,0:08:16.93,Caption,,0,0,0,,К ТЕМ ЖЕ ВОПРОСАМ. ТОЛЬКО ЦЕНА РАЗГОВОРА ТЕПЕРЬ
Dialogue: 0,0:08:16.93,0:08:19.49,Caption,,0,0,0,,СОВЕРШЕННО ДРУГАЯ. ТОГДА СПОРИЛИ О ТОМ,
Dialogue: 0,0:08:19.63,0:08:22.77,Caption,,0,0,0,,ЧТО МОЖЕТ СЛУЧИТЬСЯ. ТЕПЕРЬ СПОРЯТ ПОСЛЕ ПЯТИ ЛЕТ
Dialogue: 0,0:08:22.85,0:08:25.65,Caption,,0,0,0,,ВОЙНЫ. ВОТ ПОЧЕМУ ЭТО УЖЕ ПОХОЖЕ НА УЛЬТИМАТУМ
Dialogue: 0,0:08:25.65,0:08:31.78,Caption,,0,0,0,,ДВА НОЛЬ. ТА ЖЕ ОСНОВА. ТЕ ЖЕ ВОПРОСЫ БЕЗОПАСНОСТИ. ТЕ ЖЕ СПОРЫ О
Dialogue: 0,0:08:31.78,0:08:34.42,Caption,,0,0,0,,НАТО. ТЕ ЖЕ ПРЕТЕНЗИИ К РАЗМЕЩЕНИЮ ВОЕННОЙ
Dialogue: 0,0:08:34.42,0:08:36.90,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. ТОЛЬКО МЕЖДУ ПЕРВОЙ И ВТОРОЙ
Dialogue: 0,0:08:36.90,0:08:38.98,Caption,,0,0,0,,ПОПЫТКОЙ ДОГОВОРИТЬСЯ ЛЕЖАТ ГОДЫ ВОЙНЫ,
Dialogue: 0,0:08:39.14,0:08:42.34,Caption,,0,0,0,,ОГРОМНЫЕ ПОТЕРИ И СОВЕРШЕННО ДРУГОЙ УРОВЕНЬ ВЗАИМНОЙ
Dialogue: 0,0:08:42.34,0:08:45.38,Caption,,0,0,0,,НЕНАВИСТИ. И ПОЭТОМУ ЗДЕСЬ УЖЕ ПРОСИТСЯ ЕЩЁ ОДНО
Dialogue: 0,0:08:45.38,0:08:48.90,Caption,,0,0,0,,СРАВНЕНИЕ. КАРИБСКИЙ КРИЗИС ДВА НОЛЬ. НЕ ПОТОМУ,
Dialogue: 0,0:08:49.05,0:08:52.10,Caption,,0,0,0,,ЧТО СОБЫТИЯ ПОЛНОСТЬЮ ОДИНАКОВЫЕ. ОНИ РАЗНЫЕ. НО
Dialogue: 0,0:08:52.10,0:08:55.38,Caption,,0,0,0,,САМА ЧЕРТА ВЫГЛЯДИТ ОЧЕНЬ ЗНАКОМО. КОГДА СТОРОНЫ ЕЩЁ
Dialogue: 0,0:08:55.38,0:08:58.82,Caption,,0,0,0,,РАЗГОВАРИВАЮТ, НО ОДНОВРЕМЕННО УЖЕ ОБЪЯСНЯЮТ ДРУГ ДРУГУ,
Dialogue: 0,0:08:58.92,0:09:02.66,Caption,,0,0,0,,ЧТО БУДЕТ, ЕСЛИ РАЗГОВОР ЗАКОНЧИТСЯ ПЛОХО. КОГДА ВОЕННЫЕ
Dialogue: 0,0:09:02.66,0:09:05.38,Caption,,0,0,0,,СЦЕНАРИИ ПЕРЕСТАЮТ БЫТЬ ТЕОРИЕЙ И ИХ НАЧИНАЮТ
Dialogue: 0,0:09:05.38,0:09:08.42,Caption,,0,0,0,,ОБСУЖДАТЬ ВСЛУХ. КОГДА ОДИН НЕВЕРНЫЙ ШАГ МОЖЕТ
Dialogue: 0,0:09:08.42,0:09:12.18,Caption,,0,0,0,,ЗАПУСТИТЬ ЦЕПОЧКУ, КОТОРУЮ ПОТОМ НИКТО НЕ СМОЖЕТ ОСТАНОВИТЬ ОДНОЙ
Dialogue: 0,0:09:12.18,0:09:14.90,Caption,,0,0,0,,КРАСИВОЙ ПРЕСС КОНФЕРЕНЦИЕЙ. И МОЙ ПРОГНОЗ ЗДЕСЬ
Dialogue: 0,0:09:14.90,0:09:17.62,Caption,,0,0,0,,ПРЕДЕЛЬНО ЖЁСТКИЙ ЕСЛИ ЭТОТ КРИЗИС НЕ ПРЕОДОЛЕТЬ,
Dialogue: 0,0:09:18.02,0:09:20.90,Caption,,0,0,0,,ОН НЕИЗБЕЖНО ПЕРЕРАСТЁТ В ЯДЕРНУЮ ВОЙНУ В ЕВРОПЕ.
Dialogue: 0,0:09:21.47,0:09:23.94,Caption,,0,0,0,,И ВОТ ЭТО СЕГОДНЯ НАМНОГО ВАЖНЕЕ ВСЕЙ МИШУРЫ
Dialogue: 0,0:09:23.94,0:09:26.98,Caption,,0,0,0,,ВОКРУГ ПЕРЕГОВОРОВ. ПУСТЬ ПОСЛЕ АБУ ДАБИ КАЖДЫЙ
Dialogue: 0,0:09:26.98,0:09:29.46,Caption,,0,0,0,,ОБЪЯВИТ СЕБЯ ПОБЕДИТЕЛЕМ. ПУСТЬ РАССКАЗЫВАЮТ О
Dialogue: 0,0:09:29.46,0:09:31.78,Caption,,0,0,0,,КОНСТРУКТИВНОЙ АТМОСФЕРЕ. ПУСТЬ ГОВОРЯТ,
Dialogue: 0,0:09:31.95,0:09:34.42,Caption,,0,0,0,,ЧТО СТОРОНЫ ПРИБЛИЗИЛИСЬ ДРУГ К ДРУГУ. МЫ ЭТО
Dialogue: 0,0:09:34.42,0:09:37.54,Caption,,0,0,0,,УЖЕ СЛЫШАЛИ. СМОТРЕТЬ НАДО НА ДРУГОЕ. НАЧНУТ ЛИ
Dialogue: 0,0:09:37.54,0:09:40.10,Caption,,0,0,0,,ЕВРОПЕЙЦЫ СНОВА ГОВОРИТЬ С МОСКВОЙ НАПРЯМУЮ.
Dialogue: 0,0:09:42.36,0:09:45.56,Caption,,0,0,0,,ИЗМЕНИТСЯ ЛИ РАЗГОВОР ОБ УЧЕНИЯХ НАТО. ИЗМЕНИТСЯ ЛИ
Dialogue: 0,0:09:45.56,0:09:48.68,Caption,,0,0,0,,ПОДХОД К РАЗМЕЩЕНИЮ ВОЙСК И ВООРУЖЕНИЙ. ПОЯВИТСЯ ЛИ
Dialogue: 0,0:09:48.68,0:09:52.36,Caption,,0,0,0,,ХОТЬ КАКАЯ ТО ФОРМУЛА, ПРИ КОТОРОЙ УКРАИНА ПОЛУЧАЕТ ЗАЩИТУ,
Dialogue: 0,0:09:52.69,0:09:55.32,Caption,,0,0,0,,РОССИЯ НЕ СЧИТАЕТ ЭТУ ЗАЩИТУ НОВОЙ УГРОЗОЙ,
Dialogue: 0,0:09:55.49,0:09:58.20,Caption,,0,0,0,,А ЕВРОПА НЕ СЧИТАЕТ РОССИЙСКИЕ ГАРАНТИИ УГРОЗОЙ
Dialogue: 0,0:09:58.20,0:10:00.44,Caption,,0,0,0,,СЕБЕ. ВОТ ТОГДА МОЖНО ГОВОРИТЬ,
Dialogue: 0,0:10:00.60,0:10:03.08,Caption,,0,0,0,,ЧТО ЧТО ТО СДВИНУЛОСЬ. А ЕСЛИ ПОСЛЕ ДВУХ
Dialogue: 0,0:10:03.16,0:10:05.48,Caption,,0,0,0,,ДНЕЙ ПЕРЕГОВОРОВ ВСЕ ВЫЙДУТ, УЛЫБНУТСЯ,
Dialogue: 0,0:10:05.72,0:10:08.20,Caption,,0,0,0,,ОБЪЯВЯТ УСПЕХ И ПРОДОЛЖАТ ДЕЛАТЬ РОВНО ТО ЖЕ
Dialogue: 0,0:10:08.20,0:10:11.00,Caption,,0,0,0,,САМОЕ, ЧТО ДЕЛАЛИ ДО ВСТРЕЧИ, ЗНАЧИТ,
Dialogue: 0,0:10:11.23,0:10:14.92,Caption,,0,0,0,,НЕ ИЗМЕНИЛОСЬ НИЧЕГО. ТОЛЬКО ЧАСЫ ПРОДОЛЖАЮТ ИДТИ. И
Dialogue: 0,0:10:15.00,0:10:19.48,Caption,,0,0,0,,ЭТО, ПОЖАЛУЙ, САМОЕ НЕПРИЯТНОЕ ВО ВСЕЙ ИСТОРИИ. ПЯТЬ ЛЕТ НАЗАД
Dialogue: 0,0:10:19.52,0:10:22.44,Caption,,0,0,0,,ДВЕРЬ УЖЕ НЕ ОТКРЫЛИ. ПОСЛЕ ЭТОГО НАЧАЛАСЬ ВОЙНА.
Dialogue: 0,0:10:22.76,0:10:25.08,Caption,,0,0,0,,ТЕПЕРЬ ВСЕ СНОВА СТОЯТ ВОЗЛЕ ТОЙ ЖЕ ДВЕРИ.
Dialogue: 0,0:10:25.38,0:10:27.40,Caption,,0,0,0,,ТОЛЬКО ТЕПЕРЬ ЗА СПИНОЙ УЖЕ НЕ ПРОСТО СПОР
Dialogue: 0,0:10:27.40,0:10:30.68,Caption,,0,0,0,,ДИПЛОМАТОВ. ЗА СПИНОЙ ПЯТЬ ЛЕТ ВОЙНЫ. И ЕСЛИ
Dialogue: 0,0:10:30.68,0:10:33.48,Caption,,0,0,0,,СЕЙЧАС ОПЯТЬ РЕШИТЬ, ЧТО НИЧЕГО МЕНЯТЬ НЕ НАДО,
Dialogue: 0,0:10:33.72,0:10:36.36,Caption,,0,0,0,,СЛЕДУЮЩАЯ ВСТРЕЧА МОЖЕТ УЖЕ НИКОМУ НЕ ПОНАДОБИТЬСЯ.
