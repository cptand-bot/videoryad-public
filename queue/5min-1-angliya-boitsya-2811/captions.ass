Dialogue: 0,0:09:34.62,0:09:37.53,Caption,,0,0,0,,ПРОТЕСТОВ И ЦВЕТНЫХ РЕВОЛЮЦИЙ. ПРАВА ЧЕЛОВЕКА В
Dialogue: 0,0:09:37.53,0:09:40.03,Caption,,0,0,0,,СПОРЫ О СВОБОДЕ СЛОВА, ОППОЗИЦИИ,
Dialogue: 0,0:09:40.27,0:09:44.11,Caption,,0,0,0,,ПОЛОЖЕНИИ РУССКОЯЗЫЧНЫХ, РОССИЙСКИХ СМИ И КАНОНИЧЕСКОЙ ЦЕРКВИ.
Dialogue: 0,0:09:44.51,0:09:46.68,Caption,,0,0,0,,САМООПРЕДЕЛЕНИЕ НАРОДОВ КАЖДАЯ СТОРОНА
Dialogue: 0,0:09:46.68,0:09:49.58,Caption,,0,0,0,,ТРАКТУЕТ ПО СВОЕМУ. МЕЖДУНАРОДНОЕ СОТРУДНИЧЕСТВО
Dialogue: 0,0:09:49.58,0:09:52.83,Caption,,0,0,0,,УПИРАЕТСЯ В РАБОТУ ОБСЕ, САНКЦИИ,
Dialogue: 0,0:09:52.99,0:09:56.11,Caption,,0,0,0,,ВИЗОВЫЕ ОГРАНИЧЕНИЯ И СПОР О РАВНОПРАВНОМ ДИАЛОГЕ.
Dialogue: 0,0:09:56.59,0:09:58.67,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ ОБЯЗАТЕЛЬСТВА В УСТАВ
Dialogue: 0,0:09:58.67,0:10:00.90,Caption,,0,0,0,,ООН, БУДАПЕШТСКИЙ МЕМОРАНДУМ И ДРУГИЕ
Dialogue: 0,0:10:00.90,0:10:03.47,Caption,,0,0,0,,ДОГОВОРЫ С ОДНОЙ СТОРОНЫ, ЮГОСЛАВИЮ,
Dialogue: 0,0:10:03.54,0:10:05.70,Caption,,0,0,0,,КОСОВО И ВЫХОД США ИЗ СОГЛАШЕНИЙ ПО
Dialogue: 0,0:10:05.70,0:10:08.30,Caption,,0,0,0,,КОНТРОЛЮ НАД ВООРУЖЕНИЯМИ С ДРУГОЙ. И ПОСЛЕ
Dialogue: 0,0:10:08.30,0:10:11.26,Caption,,0,0,0,,ЭТОГО СИКОРСКИЙ ЁРНИЧАЕТ РОССИЯ НАРУШИЛА СТАРЫЕ
Dialogue: 0,0:10:11.26,0:10:13.31,Caption,,0,0,0,,ПРАВИЛА, А ТЕПЕРЬ ПРОСИТ ПОВЕРИТЬ,
Dialogue: 0,0:10:13.39,0:10:17.30,Caption,,0,0,0,,ЧТО БУДЕТ СОБЛЮДАТЬ НОВЫЕ. НО ЕСЛИ СТАРАЯ СИСТЕМА БЕЗОПАСНОСТИ
Dialogue: 0,0:10:17.30,0:10:21.12,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО ВСЕХ УСТРАИВАЛА, ОТКУДА ВЗЯЛСЯ НЫНЕШНИЙ СПОР О НОВОЙ
Dialogue: 0,0:10:21.12,0:10:23.47,Caption,,0,0,0,,АРХИТЕКТУРЕ? А ЕСЛИ НЕ УСТРАИВАЛА,
Dialogue: 0,0:10:23.71,0:10:25.58,Caption,,0,0,0,,РАЗГОВОР ВСЁ РАВНО ПРИДЁТСЯ ВЕСТИ О
Dialogue: 0,0:10:25.58,0:10:27.39,Caption,,0,0,0,,ТОМ, ЧТО ДОЛЖНО РАБОТАТЬ ДАЛЬШЕ.
Dialogue: 0,0:10:28.02,0:10:30.11,Caption,,0,0,0,,ЕЩЁ ОДИН ПОКАЗАТЕЛЬНЫЙ ЭПИЗОД ПРИШЁЛ
Dialogue: 0,0:10:30.11,0:10:32.75,Caption,,0,0,0,,ИЗ ЭСТОНИИ. ПРЕМЬЕР КРИСТЕН МИХАЛ ОБЪЯВИЛ,
Dialogue: 0,0:10:32.91,0:10:34.68,Caption,,0,0,0,,ЧТО УКРАИНА НЕ ДОЛЖНА ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:10:34.68,0:10:38.27,Caption,,0,0,0,,ВОЗДУШНОЕ ПРОСТРАНСТВО, ТЕРРИТОРИАЛЬНЫЕ ВОДЫ И СУШУ ЭСТОНИИ
Dialogue: 0,0:10:38.27,0:10:43.63,Caption,,0,0,0,,ДЛЯ УДАРОВ ПО РОССИИ. ОН ПРЕДУПРЕДИЛ И О РИСКЕ НЕФТЯНОГО
Dialogue: 0,0:10:43.63,0:10:46.64,Caption,,0,0,0,,ЗАГРЯЗНЕНИЯ БАЛТИКИ ПРИ АТАКАХ НА ТАНКЕРЫ. И ВСЁ
Dialogue: 0,0:10:46.64,0:10:49.71,Caption,,0,0,0,,БЫ НИЧЕГО, ЕСЛИ БЫ СОВСЕМ НЕЗАДОЛГО ДО ЭТОГО ТОТ
Dialogue: 0,0:10:49.71,0:10:51.90,Caption,,0,0,0,,ЖЕ МИХАЛ НЕ ПРИЗЫВАЛ ПРИВЫКАТЬ К ГОРЯЩИМ
Dialogue: 0,0:10:51.90,0:10:54.43,Caption,,0,0,0,,РОССИЙСКИМ СУДАМ ВОЗЛЕ ЭСТОНИИ ПОСЛЕ АТАК НА
Dialogue: 0,0:10:54.43,0:10:57.01,Caption,,0,0,0,,КОРВЕТ БАЛТИЙСКОГО ФЛОТА И СУДНО "СПАРТА ДВА" В
Dialogue: 0,0:10:57.01,0:11:01.05,Caption,,0,0,0,,ЭКОНОМИЧЕСКОЙ ЗОНЕ СТРАНЫ. ПОТОМ МИД РОССИИ ВЫЗВАЛ ЭСТОНСКОГО
Dialogue: 0,0:11:01.05,0:11:03.90,Caption,,0,0,0,,ДИПЛОМАТА И ВРУЧИЛ НОТУ ПРОТЕСТА. В ПРЕТЕНЗИЯХ
Dialogue: 0,0:11:03.90,0:11:06.71,Caption,,0,0,0,,БЫЛИ ПОДОЗРЕНИЯ В ПРЕДОСТАВЛЕНИИ НЕБА УКРАИНСКИМ
Dialogue: 0,0:11:06.71,0:11:09.71,Caption,,0,0,0,,БЕСПИЛОТНИКАМ, ПРЕПЯТСТВИЯ РОССИЙСКОМУ СУДОХОДСТВУ И
Dialogue: 0,0:11:09.71,0:11:12.38,Caption,,0,0,0,,ТРАНЗИТУ ЗЕРНА, ПОЛОЖЕНИЕ РУССКОЯЗЫЧНЫХ,
Dialogue: 0,0:11:12.62,0:11:14.63,Caption,,0,0,0,,ДАВЛЕНИЕ НА ПРАВОСЛАВНУЮ ЦЕРКОВЬ И
Dialogue: 0,0:11:14.63,0:11:16.77,Caption,,0,0,0,,ЗАКРЫТИЕ АВТОМОБИЛЬНЫХ ПЕРЕХОДОВ С ПЕРВОГО
Dialogue: 0,0:11:16.77,0:11:20.65,Caption,,0,0,0,,ДЕКАБРЯ. ГЛАВА МИД ЭСТОНИИ МАРГУС ЦАХКНА ПОСЛЕ
Dialogue: 0,0:11:20.65,0:11:23.83,Caption,,0,0,0,,РОССИЙСКОГО ПРЕДУПРЕЖДЕНИЯ ПРИЛЕТЕЛ В КИЕВ. ЕЩЁ
Dialogue: 0,0:11:23.83,0:11:27.11,Caption,,0,0,0,,НЕДАВНО ГОРЯЩИЕ КОРАБЛИ ПРЕДЛАГАЛИ ВОСПРИНИМАТЬ ПОЧТИ
Dialogue: 0,0:11:27.11,0:11:28.94,Caption,,0,0,0,,ФИЛОСОФСКИ. А ПОТОМ ВЫЯСНИЛОСЬ,
Dialogue: 0,0:11:29.17,0:11:30.81,Caption,,0,0,0,,ЧТО ОГОНЬ У СОБСТВЕННОГО БЕРЕГА
Dialogue: 0,0:11:30.81,0:11:33.93,Caption,,0,0,0,,ВЫГЛЯДИТ НЕМНОГО ИНАЧЕ. С НИДЕРЛАНДСКОЙ КОМПАНИЕЙ
Dialogue: 0,0:11:33.93,0:11:36.74,Caption,,0,0,0,,DESTINUS ЭТОТ ВОПРОС УЖЕ ВОЗНИК ПОСЛЕ СООБЩЕНИЙ ОБ
Dialogue: 0,0:11:36.74,0:11:39.46,Caption,,0,0,0,,ИСПОЛЬЗОВАНИИ ЕЁ РАКЕТ И БЕСПИЛОТНИКОВ ПРИ АТАКЕ НА
Dialogue: 0,0:11:39.46,0:11:42.25,Caption,,0,0,0,,КРЫМСКИЙ МОСТ. НО ЕСЛИ СОТРУДНИКИ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:11:42.25,0:11:44.61,Caption,,0,0,0,,КОМПАНИИ НЕПОСРЕДСТВЕННО ПОМОГАЮТ УПРАВЛЯТЬ
Dialogue: 0,0:11:44.61,0:11:47.22,Caption,,0,0,0,,ВООРУЖЕНИЕМ, ГДЕ ЗАКАНЧИВАЕТСЯ ТЕХНИЧЕСКАЯ
Dialogue: 0,0:11:47.22,0:11:49.90,Caption,,0,0,0,,ПОДДЕРЖКА И НАЧИНАЕТСЯ УЧАСТИЕ В БОЕВЫХ ДЕЙСТВИЯХ?
Dialogue: 0,0:11:52.17,0:11:54.03,Caption,,0,0,0,,ВО ФРАНЦИИ ЭТОТ ВОПРОС УЖЕ ВЫШЕЛ НА
Dialogue: 0,0:11:54.03,0:11:56.80,Caption,,0,0,0,,ПАРЛАМЕНТСКИЙ УРОВЕНЬ. ФРАНЦУЗСКИЕ ВОЕННОСЛУЖАЩИЕ
Dialogue: 0,0:11:56.80,0:11:59.09,Caption,,0,0,0,,УЧАСТВУЮТ В ОБУЧЕНИИ УКРАИНСКИХ ВОЕННЫХ И
Dialogue: 0,0:11:59.09,0:12:02.02,Caption,,0,0,0,,ОБСЛУЖИВАНИИ ПОСТАВЛЕННОЙ ТЕХНИКИ В РАМКАХ МИССИИ
Dialogue: 0,0:12:02.02,0:12:04.41,Caption,,0,0,0,,"ВОЛЯ" ПОД КОМАНДОВАНИЕМ ФРАНЦУЗСКОГО ГЕНЕРАЛА.
Dialogue: 0,0:12:04.96,0:12:07.43,Caption,,0,0,0,,ЗАММИНИСТРА ОБОРОНЫ АЛИС РУФО ВЫЗВАЛИ
Dialogue: 0,0:12:07.43,0:12:10.73,Caption,,0,0,0,,НА ЗАКРЫТЫЕ СЛУШАНИЯ В СЕНАТ. ОППОЗИЦИЯ ОПАСАЕТСЯ,
Dialogue: 0,0:12:10.97,0:12:13.12,Caption,,0,0,0,,ЧТО ДАЖЕ ФОРМАЛЬНО НЕБОЕВОЕ УЧАСТИЕ
Dialogue: 0,0:12:13.12,0:12:15.68,Caption,,0,0,0,,СПОСОБНО ПРИВЕСТИ К ПРЯМОМУ СТОЛКНОВЕНИЮ С
Dialogue: 0,0:12:15.68,0:12:18.35,Caption,,0,0,0,,РОССИЕЙ И ОБВИНЯЕТ АДМИНИСТРАЦИЮ ПРЕЗИДЕНТА В
Dialogue: 0,0:12:18.35,0:12:20.74,Caption,,0,0,0,,НЕДОСТАТОЧНОМ ИНФОРМИРОВАНИИ ПАРЛАМЕНТА.
Dialogue: 0,0:12:20.74,0:12:24.29,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО ОТВЕЧАЕТ, ЧТО УВЕДОМЛЕНИЕ ПАРЛАМЕНТА ПО ТРИДЦАТЬ
Dialogue: 0,0:12:24.29,0:12:27.58,Caption,,0,0,0,,ПЯТОЙ СТАТЬЕ КОНСТИТУЦИИ НЕ ТРЕБУЕТСЯ. ТО ЕСТЬ СПОР
Dialogue: 0,0:12:27.58,0:12:31.39,Caption,,0,0,0,,УЖЕ НЕ О ТОМ, ЕСТЬ ЛИ ФРАНЦУЗСКИЕ ВОЕННЫЕ. СПОР О
Dialogue: 0,0:12:31.39,0:12:34.62,Caption,,0,0,0,,ТОМ, ГДЕ ЗАКАНЧИВАЕТСЯ ПОМОЩЬ И НАЧИНАЕТСЯ
Dialogue: 0,0:12:34.62,0:12:37.50,Caption,,0,0,0,,УЧАСТИЕ. И ПОЧТИ ОДНОВРЕМЕННО ГЛАВА ФРАНЦУЗСКОГО
Dialogue: 0,0:12:37.50,0:12:40.59,Caption,,0,0,0,,МИД ЖАН НОЭЛЬ БАРРО КОММЕНТИРУЕТ АТАКИ УКРАИНЫ НА
Dialogue: 0,0:12:40.59,0:12:43.85,Caption,,0,0,0,,ДВА РОССИЙСКИХ СУДНА У БЕРЕГОВ ЛИВИИ. ОДНО ИЗ НИХ,
Dialogue: 0,0:12:43.93,0:12:47.04,Caption,,0,0,0,,СОГЛАСНО ПУБЛИКАЦИИ, БЫЛО ПОТОПЛЕНО. КИЕВ ВЗЯЛ
Dialogue: 0,0:12:47.04,0:12:51.16,Caption,,0,0,0,,ОТВЕТСТВЕННОСТЬ НА СЕБЯ. БАРРО ГОВОРИТ ПОСТАВЬТЕ СЕБЯ НА МЕСТО
Dialogue: 0,0:12:51.16,0:12:53.85,Caption,,0,0,0,,УКРАИНЦЕВ. ЕСЛИ БЫ ВАС БОМБИЛИ КАЖДЫЙ ДЕНЬ И
Dialogue: 0,0:12:53.85,0:12:57.03,Caption,,0,0,0,,КАЖДУЮ НОЧЬ, ВЫ БЫ ЗАЩИЩАЛИСЬ. ФРАНЦИЯ СЧИТАЕТ ЭТИ
Dialogue: 0,0:12:57.03,0:12:59.35,Caption,,0,0,0,,ДЕЙСТВИЯ РЕАЛИЗАЦИЕЙ ПРАВА УКРАИНЫ НА
Dialogue: 0,0:12:59.35,0:13:02.66,Caption,,0,0,0,,САМООБОРОНУ. ПРИ ЭТОМ МИНИСТР НЕ СЧИТАЕТ ПРОИСХОДЯЩЕЕ
Dialogue: 0,0:13:02.66,0:13:04.89,Caption,,0,0,0,,ПРИНЦИПИАЛЬНО НОВЫМ ЭТАПОМ ЭСКАЛАЦИИ.
Dialogue: 0,0:13:07.16,0:13:10.06,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, МОСКВА УЖЕ НЕСКОЛЬКО ЛЕТ ОКАЗЫВАЕТ
Dialogue: 0,0:13:10.06,0:13:11.72,Caption,,0,0,0,,ДАВЛЕНИЕ НЕ ТОЛЬКО НА УКРАИНУ,
Dialogue: 0,0:13:11.96,0:13:15.74,Caption,,0,0,0,,НО И НА ЕВРОПЕЙСКИЕ СТРАНЫ, ПЫТАЯСЬ ОСЛАБИТЬ ИХ ЕДИНСТВО. И ВОТ
Dialogue: 0,0:13:15.74,0:13:18.74,Caption,,0,0,0,,ТЕПЕРЬ СОБЕРИТЕ ВСЁ ЭТО В ОДНУ КАРТИНУ. СИКОРСКИЙ
Dialogue: 0,0:13:18.74,0:13:21.35,Caption,,0,0,0,,ГОВОРИТ, ЧТО РОССИЯ НЕ МОЖЕТ ПОБЕДИТЬ НА
Dialogue: 0,0:13:21.35,0:13:23.40,Caption,,0,0,0,,ДОНБАССЕ И ТЕМ БОЛЕЕ НЕ ПОБЕДИТ НАТО.
Dialogue: 0,0:13:23.96,0:13:27.10,Caption,,0,0,0,,ДЖОНСОН УВЕРЯЕТ, ЧТО ИНОСТРАННЫЕ ВОЙСКА НА УКРАИНЕ НЕ
Dialogue: 0,0:13:27.10,0:13:29.58,Caption,,0,0,0,,ПРИВЕДУТ К ПРЯМОЙ ВОЙНЕ С РОССИЕЙ. ПРЕЗИДЕНТ
Dialogue: 0,0:13:29.58,0:13:32.55,Caption,,0,0,0,,ЛАТВИИ УЖЕ ВИДИТ ПЕРЕЛОМ ВЕСНОЙ ИЛИ ЛЕТОМ. ГЕРМАНИЯ
Dialogue: 0,0:13:32.55,0:13:35.96,Caption,,0,0,0,,НАПОМИНАЕТ СТАРЫЕ ПРАВИЛА БЕЗОПАСНОСТИ. ФРАНЦИЯ СЧИТАЕТ
Dialogue: 0,0:13:35.96,0:13:38.89,Caption,,0,0,0,,УДАРАМИ ПО РОССИЙСКИМ СУДАМ У ЛИВИИ УКРАИНСКУЮ
Dialogue: 0,0:13:38.89,0:13:42.04,Caption,,0,0,0,,САМООБОРОНУ. А ВОЕННЫЕ ТЕМ ВРЕМЕНЕМ ПРЯЧУТ САМОЛЁТЫ,
Dialogue: 0,0:13:42.28,0:13:45.88,Caption,,0,0,0,,ПИШУТ РЕЗЕРВИСТАМ, МЕНЯЮТ ПОРЯДОК ИДЕНТИФИКАЦИИ ЦЕЛЕЙ,
Dialogue: 0,0:13:46.04,0:13:48.90,Caption,,0,0,0,,СПОРЯТ, МОЖНО ЛИ СБИВАТЬ РОССИЙСКИЕ РАКЕТЫ НАД
Dialogue: 0,0:13:48.90,0:13:50.92,Caption,,0,0,0,,УКРАИНОЙ, И ВНИМАТЕЛЬНО СЛЕДЯТ,
Dialogue: 0,0:13:51.16,0:13:53.43,Caption,,0,0,0,,ЧТОБЫ ДЕЙСТВИЯ СОЮЗНИКОВ НЕ ПЕРЕСЕКЛИ
Dialogue: 0,0:13:53.43,0:13:55.67,Caption,,0,0,0,,ЧЕРТУ, ЗА КОТОРОЙ НАЧИНАЕТСЯ УЖЕ СОВСЕМ
Dialogue: 0,0:13:55.67,0:13:58.84,Caption,,0,0,0,,ДРУГОЙ РАЗГОВОР. ПОЭТОМУ ГЛАВНЫЙ ВОПРОС ЗДЕСЬ НЕ В ТОМ,
Dialogue: 0,0:13:59.00,0:14:01.13,Caption,,0,0,0,,КТО ПРОИЗНЁС САМУЮ ГРОМКУЮ ФРАЗУ.
Dialogue: 0,0:14:01.13,0:14:03.85,Caption,,0,0,0,,ГОРАЗДО ИНТЕРЕСНЕЕ ДРУГОЕ. ЕСЛИ УВЕРЕННОСТЬ В
Dialogue: 0,0:14:03.85,0:14:05.80,Caption,,0,0,0,,ПРЕВОСХОДСТВЕ НАСТОЛЬКО ВЕЛИКА,
Dialogue: 0,0:14:06.04,0:14:07.75,Caption,,0,0,0,,ПОЧЕМУ РЕАЛЬНЫЕ ВОЕННЫЕ РЕШЕНИЯ
Dialogue: 0,0:14:07.75,0:14:10.76,Caption,,0,0,0,,СТАНОВЯТСЯ ВСЁ ОСТОРОЖНЕЕ, СЛОЖНЕЕ И ДОРОЖЕ?
Dialogue: 0,0:14:11.16,0:14:13.07,Caption,,0,0,0,,ВОТ ЭТОТ РАЗРЫВ МЕЖДУ СЛОВАМИ И
Dialogue: 0,0:14:13.07,0:14:15.00,Caption,,0,0,0,,ДЕЙСТВИЯМИ И ЕСТЬ САМОЕ ВАЖНОЕ,
Dialogue: 0,0:14:15.16,0:14:17.16,Caption,,0,0,0,,ЧТО СЕЙЧАС ПРОИСХОДИТ ВОКРУГ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:14:17.16,0:14:17.96,Caption,,0,0,0,,БЕЗОПАСНОСТИ.
