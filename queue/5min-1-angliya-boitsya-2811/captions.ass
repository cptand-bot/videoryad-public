Dialogue: 0,0:05:00.22,0:05:02.88,Caption,,0,0,0,,СПОСОБНА ПОБЕДИТЬ ДАЖЕ НА ДОНБАССЕ. А КОГДА
Dialogue: 0,0:05:02.88,0:05:05.63,Caption,,0,0,0,,ДЕЛО ДОХОДИТ ДО ПРЯМОГО ПЕРЕХВАТА РОССИЙСКИХ РАКЕТ
Dialogue: 0,0:05:05.63,0:05:08.55,Caption,,0,0,0,,СИЛАМИ НАТО, ЖЕЛАЮЩИХ ПРЕВРАТИТЬ ТЕОРИЮ В ПРАКТИКУ
Dialogue: 0,0:05:08.55,0:05:11.00,Caption,,0,0,0,,СТАНОВИТСЯ МЕНЬШЕ. ПОЛЬША ПРИ ЭТОМ СОБИРАЕТСЯ
Dialogue: 0,0:05:11.00,0:05:13.46,Caption,,0,0,0,,СОЗДАТЬ СОБСТВЕННУЮ ЗОНУ ОГРАНИЧЕНИЯ ПОЛЁТОВ
