Dialogue: 0,0:00:00.12,0:00:04.36,Caption,,0,0,0,,КАК ГОВОРИТСЯ СОВА НЕ ТАКТИК, СОВА СТРАТЕГ. В ЕВРОПЕ УЖЕ НАЗВАЛИ
Dialogue: 0,0:00:04.36,0:00:07.44,Caption,,0,0,0,,ДАЖЕ ВРЕМЯ, КОГДА ДОЛЖЕН НАСТУПИТЬ ПЕРЕЛОМ В ЭТОЙ
Dialogue: 0,0:00:07.44,0:00:10.34,Caption,,0,0,0,,ВОЙНЕ. НУ ХОРОШО, СО СРОКАМИ ОПРЕДЕЛИЛИСЬ. ТЕПЕРЬ
Dialogue: 0,0:00:10.34,0:00:13.45,Caption,,0,0,0,,ХОТЕЛОСЬ БЫ ПОНЯТЬ, ЧТО КОНКРЕТНО ЗА ЭТО ВРЕМЯ ДОЛЖНО
Dialogue: 0,0:00:13.45,0:00:15.88,Caption,,0,0,0,,ПРОИЗОЙТИ. АВТОМАТЫ НАЧНУТ РЖАВЕТЬ?
Dialogue: 0,0:00:16.11,0:00:20.31,Caption,,0,0,0,,РАКЕТЫ ПЕРЕСТАНУТ СТРЕЛЯТЬ? ИЛИ ЕВРОПЕЙСКИЕ СТРАТЕГИ ЗНАЮТ ЧТО ТО
Dialogue: 0,0:00:20.31,0:00:22.20,Caption,,0,0,0,,ТАКОЕ, О ЧЁМ ПОКА НЕ РАССКАЗЫВАЮТ?
Dialogue: 0,0:00:22.59,0:00:25.69,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНО, ЧТО НА САМОМ ДЕЛЕ СТОИТ ЗА ГРОМКИМИ
Dialogue: 0,0:00:25.69,0:00:27.56,Caption,,0,0,0,,ЗАЯВЛЕНИЯМИ ЕВРОПЕЙСКИХ ПОЛИТИКОВ,
Dialogue: 0,0:00:27.80,0:00:29.63,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО
Dialogue: 0,0:00:29.63,0:00:32.44,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ ЗАНЯТНОЕ. ПОХОЖЕ,
Dialogue: 0,0:00:32.66,0:00:34.73,Caption,,0,0,0,,У КАИ КАЛЛАС ПОЯВИЛСЯ КОНКУРЕНТ.
Dialogue: 0,0:00:34.73,0:00:38.17,Caption,,0,0,0,,РАДОСЛАВ СИКОРСКИЙ. ПО ЧАСТИ БЕЗРАССУДНЫХ И БРЕДОВЫХ
Dialogue: 0,0:00:38.17,0:00:41.15,Caption,,0,0,0,,ЗАЯВЛЕНИЙ ОН СЕЙЧАС ЯВНО РЕШИЛ НЕ ОТСТАВАТЬ. ПОЛЬСКИЙ
Dialogue: 0,0:00:41.15,0:00:43.28,Caption,,0,0,0,,МИНИСТР ИНОСТРАННЫХ ДЕЛ ГОВОРИТ ЕВРОПА В
Dialogue: 0,0:00:43.28,0:00:47.04,Caption,,0,0,0,,ДЕСЯТЬ РАЗ БОГАЧЕ РОССИИ, ЕВРОПА ВО ГЛАВЕ С ПОЛЬШЕЙ НАРАЩИВАЕТ
Dialogue: 0,0:00:47.04,0:00:50.24,Caption,,0,0,0,,РАСХОДЫ НА ОБОРОНУ, РОССИЯ НЕ СПОСОБНА ПОБЕДИТЬ НА
Dialogue: 0,0:00:50.24,0:00:52.68,Caption,,0,0,0,,ДОНБАССЕ, А ЗНАЧИТ УЖ НАТО ОНА ТЕМ БОЛЕЕ НЕ
Dialogue: 0,0:00:52.68,0:00:55.56,Caption,,0,0,0,,ПОБЕДИТ. НУ ТАК ПОКАЖИТЕ. НАПАДАЙТЕ.
Dialogue: 0,0:00:55.56,0:00:58.84,Caption,,0,0,0,,ЕСЛИ ВЫ НАСТОЛЬКО СИЛЬНЫЕ, СМЕЛЫЕ И УВЕРЕННЫЕ,
Dialogue: 0,0:00:59.00,0:01:01.17,Caption,,0,0,0,,ЧТО СПОСОБНЫ РАЗГРОМИТЬ РОССИЮ НА ПОЛЕ
Dialogue: 0,0:01:01.17,0:01:03.43,Caption,,0,0,0,,БОЯ, ПОЧЕМУ ТОГДА ТАК БОИТЕСЬ ПРЯМОГО
Dialogue: 0,0:01:03.43,0:01:06.21,Caption,,0,0,0,,СТОЛКНОВЕНИЯ? ИЛИ ВСЯ ЭТА СМЕЛОСТЬ ЗАКАНЧИВАЕТСЯ
Dialogue: 0,0:01:06.21,0:01:08.60,Caption,,0,0,0,,РОВНО ТАМ, ГДЕ ЗА ГРОМКИЕ СЛОВА ПРИДЁТСЯ
Dialogue: 0,0:01:08.60,0:01:11.37,Caption,,0,0,0,,ОТВЕЧАТЬ? ВЕДЬ БОГАТСТВО САМО ПО СЕБЕ ЕЩЁ НЕ
Dialogue: 0,0:01:11.37,0:01:16.88,Caption,,0,0,0,,ОЗНАЧАЕТ ВОЕННУЮ ПОБЕДУ. МОЖНО БЫТЬ В ДЕСЯТЬ РАЗ БОГАЧЕ И ПРИ
Dialogue: 0,0:01:16.88,0:01:19.12,Caption,,0,0,0,,ЭТОМ ПРЕКРАСНО ПОНИМАТЬ, ЧЕМ РИСКУЕШЬ,
Dialogue: 0,0:01:19.34,0:01:22.88,Caption,,0,0,0,,НАЧИНАЯ БОЛЬШУЮ ВОЙНУ. И ЕЩЁ. СИКОРСКИЙ ГОВОРИТ,
Dialogue: 0,0:01:23.12,0:01:24.98,Caption,,0,0,0,,ЧТО РОССИЯ НЕ МОЖЕТ ПОБЕДИТЬ НА
Dialogue: 0,0:01:24.98,0:01:28.00,Caption,,0,0,0,,ДОНБАССЕ. ХОРОШО. А ЧТО ИМЕННО СЧИТАЕТСЯ ПОБЕДОЙ?
Dialogue: 0,0:01:28.40,0:01:31.12,Caption,,0,0,0,,СНАЧАЛА НАДО ОПРЕДЕЛИТЬ ЦЕЛЬ, А ПОТОМ ОБЪЯВЛЯТЬ,
Dialogue: 0,0:01:31.20,0:01:33.72,Caption,,0,0,0,,ВЫПОЛНИЛ ЕЁ ПРОТИВНИК ИЛИ НЕТ. ИНАЧЕ
Dialogue: 0,0:01:33.72,0:01:35.84,Caption,,0,0,0,,МОЖНО САМОМУ ПРИДУМАТЬ ЧУЖУЮ ЦЕЛЬ,
Dialogue: 0,0:01:36.00,0:01:38.03,Caption,,0,0,0,,САМОМУ ОБЪЯВИТЬ ЕЁ НЕВЫПОЛНЕННОЙ И
Dialogue: 0,0:01:38.03,0:01:41.27,Caption,,0,0,0,,САМОМУ ЖЕ ВРУЧИТЬ СЕБЕ МЕДАЛЬ. СИКОРСКИЙ ТАКЖЕ ОБВИНИЛ
Dialogue: 0,0:01:41.27,0:01:44.24,Caption,,0,0,0,,РОССИЮ В НАРУШЕНИИ ВСЕХ ДЕСЯТИ ПРИНЦИПОВ ОБСЕ,
Dialogue: 0,0:01:44.56,0:01:46.51,Caption,,0,0,0,,НАПОМНИЛ О БУДАПЕШТСКОМ МЕМОРАНДУМЕ И
Dialogue: 0,0:01:46.51,0:01:49.09,Caption,,0,0,0,,ДОГОВОРЕ О ГРАНИЦЕ С УКРАИНОЙ. И ПРАКТИЧЕСКИ
Dialogue: 0,0:01:49.09,0:01:51.89,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРЕДЛОЖИЛ СБИВАТЬ РОССИЙСКИЕ РАКЕТЫ И
Dialogue: 0,0:01:51.89,0:01:54.79,Caption,,0,0,0,,БЕСПИЛОТНИКИ НАД УКРАИНОЙ СИЛАМИ НАТО. ОДНО ДЕЛО
Dialogue: 0,0:01:54.79,0:01:57.80,Caption,,0,0,0,,РАССКАЗЫВАТЬ О ПРЕВОСХОДСТВЕ АЛЬЯНСА. ДРУГОЕ ДЕЛО
Dialogue: 0,0:01:57.80,0:02:00.42,Caption,,0,0,0,,ПРЕДЛАГАТЬ СИЛАМ ЭТОГО АЛЬЯНСА НЕПОСРЕДСТВЕННО
Dialogue: 0,0:02:00.42,0:02:03.91,Caption,,0,0,0,,УНИЧТОЖАТЬ РОССИЙСКИЕ ВОЕННЫЕ ЦЕЛИ. БОРИС ДЖОНСОН СМОТРИТ НА
Dialogue: 0,0:02:03.91,0:02:06.48,Caption,,0,0,0,,ЭТО ПРИМЕРНО С ТОЙ ЖЕ ВЫСОТЫ. ЕГО СПРОСИЛИ,
Dialogue: 0,0:02:06.78,0:02:08.63,Caption,,0,0,0,,НЕ ПРИВЕДЁТ ЛИ ПОЯВЛЕНИЕ ИНОСТРАННЫХ
Dialogue: 0,0:02:08.63,0:02:11.27,Caption,,0,0,0,,ВОЙСК НА УКРАИНЕ К ГОРЯЧЕЙ ВОЙНЕ С РОССИЕЙ.
Dialogue: 0,0:02:11.27,0:02:13.60,Caption,,0,0,0,,ДЖОНСОН ОТВЕТИЛ, ЧТО НЕТ. НАТО,
Dialogue: 0,0:02:13.68,0:02:16.47,Caption,,0,0,0,,ГОВОРИТ, НЕСРАВНЕННО СИЛЬНЕЕ РОССИИ. А ВСЯ
Dialogue: 0,0:02:16.47,0:02:19.44,Caption,,0,0,0,,ПРОБЛЕМА ПОСЛЕДНИХ ПОЧТИ ПЯТИ ЛЕТ ЗАКЛЮЧАЛАСЬ В ТОМ,
Dialogue: 0,0:02:19.68,0:02:22.32,Caption,,0,0,0,,ЧТО ЛЮДИ СЛИШКОМ БОЯЛИСЬ СПРОВОЦИРОВАТЬ ПУТИНА.
Dialogue: 0,0:02:22.66,0:02:24.90,Caption,,0,0,0,,КРАСИВО. УВЕРЕННО. ПРЯМ ХОЧЕТСЯ
Dialogue: 0,0:02:24.90,0:02:29.97,Caption,,0,0,0,,РАССЛАБИТЬСЯ. ТОЛЬКО БРИТАНСКИЕ ВОЕННЫЕ ПОЧЕМУ ТО НЕ
Dialogue: 0,0:02:29.97,0:02:32.39,Caption,,0,0,0,,РАССЛАБЛЯЮТСЯ. ВВС БРИТАНИИ НАЧАЛИ НА
Dialogue: 0,0:02:32.39,0:02:35.28,Caption,,0,0,0,,НОЧЬ ПРЯТАТЬ САМОЛЁТЫ В АНГАРЫ И УКРЕПЛЁННЫЕ
Dialogue: 0,0:02:35.28,0:02:38.37,Caption,,0,0,0,,УКРЫТИЯ. МАШИНЫ, КОТОРЫМ МЕСТА ПОД КРЫШЕЙ НЕ ХВАТАЕТ,
Dialogue: 0,0:02:38.61,0:02:40.41,Caption,,0,0,0,,СОБИРАЮТСЯ ЗАЩИЩАТЬ КЕВЛАРОВЫМИ
Dialogue: 0,0:02:40.41,0:02:43.63,Caption,,0,0,0,,АНТИДРОНОВЫМИ СЕТЯМИ. ПРИЧИНА НАЗВАНА ПРЯМО УГРОЗА
Dialogue: 0,0:02:43.63,0:02:46.53,Caption,,0,0,0,,РОССИЙСКИХ И ИРАНСКИХ БЕСПИЛОТНИКОВ. НУ ПОНЯТНО,
Dialogue: 0,0:02:46.77,0:02:49.01,Caption,,0,0,0,,САМОЛЁТЫ НАДО ЗАЩИЩАТЬ. ТОЛЬКО ВСЕМ
Dialogue: 0,0:02:49.01,0:02:52.49,Caption,,0,0,0,,ХВАТИТ АНГАРОВ? ЕСЛИ НАТО НЕСРАВНЕННО СИЛЬНЕЕ РОССИИ И
Dialogue: 0,0:02:52.49,0:02:56.44,Caption,,0,0,0,,ГОРЯЧЕЙ ВОЙНЫ НЕ БУДЕТ, ЗАЧЕМ ГЛАВКОМ ВВС ХАРВ СМИТ ТРЕБУЕТ
Dialogue: 0,0:02:56.44,0:02:58.53,Caption,,0,0,0,,РАССРЕДОТОЧИВАТЬ САМОЛЁТЫ ПО СТРАНЕ,
Dialogue: 0,0:02:58.71,0:03:00.68,Caption,,0,0,0,,ЧТОБЫ ОДНИМ УДАРОМ НЕЛЬЗЯ БЫЛО ВЫВЕСТИ
Dialogue: 0,0:03:00.68,0:03:03.73,Caption,,0,0,0,,ИЗ СТРОЯ НЕСКОЛЬКО МАШИН? ОН ОПИСЫВАЕТ СЦЕНАРИЙ,
Dialogue: 0,0:03:03.89,0:03:06.06,Caption,,0,0,0,,ПРИ КОТОРОМ НА РОДИНЕ НЕТ БЕЗОПАСНОГО
Dialogue: 0,0:03:06.06,0:03:08.69,Caption,,0,0,0,,УБЕЖИЩА, БОЕВЫЕ ДЕЙСТВИЯ ВЕДУТСЯ С ТЕРРИТОРИИ
Dialogue: 0,0:03:08.69,0:03:11.84,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ, А АВИАЦИИ ПРИХОДИТСЯ ПЕРЕМЕЩАТЬСЯ.
Dialogue: 0,0:03:11.84,0:03:13.73,Caption,,0,0,0,,ОПЫТ УКРАИНЫ ПОКАЗАЛ БРИТАНЦАМ,
Dialogue: 0,0:03:13.89,0:03:16.10,Caption,,0,0,0,,ЗАЧЕМ ЭТО НУЖНО. РАССРЕДОТОЧЕНИЕ
Dialogue: 0,0:03:16.10,0:03:19.08,Caption,,0,0,0,,АВИАЦИИ И МОБИЛЬНОЙ ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ ПОМОГЛО
Dialogue: 0,0:03:19.08,0:03:21.54,Caption,,0,0,0,,ИЗБЕЖАТЬ ИХ УНИЧТОЖЕНИЯ НА ПОСТОЯННЫХ БАЗАХ В
Dialogue: 0,0:03:21.54,0:03:24.77,Caption,,0,0,0,,НАЧАЛЕ БОЕВЫХ ДЕЙСТВИЙ. И ЭТО НЕ ВСЁ. МИНИСТЕРСТВО
Dialogue: 0,0:03:24.77,0:03:27.81,Caption,,0,0,0,,ОБОРОНЫ РАЗОСЛАЛО ОКОЛО СТА ТЫСЯЧ ПИСЕМ БЫВШИМ
Dialogue: 0,0:03:27.81,0:03:29.84,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИМ. ВПЕРВЫЕ СО ВРЕМЁН
Dialogue: 0,0:03:29.84,0:03:32.61,Caption,,0,0,0,,ХОЛОДНОЙ ВОЙНЫ. ЭТО СТРАТЕГИЧЕСКИЙ РЕЗЕРВ,
Dialogue: 0,0:03:32.85,0:03:34.53,Caption,,0,0,0,,КОТОРЫЙ В ИСКЛЮЧИТЕЛЬНОЙ СИТУАЦИИ
Dialogue: 0,0:03:34.53,0:03:39.67,Caption,,0,0,0,,МОЖНО СНОВА ПРИЗВАТЬ. ЛЮДЕЙ ПРОСЯТ ОБНОВИТЬ ДАННЫЕ И
Dialogue: 0,0:03:39.67,0:03:43.12,Caption,,0,0,0,,ПРИГЛАШАЮТ НА УЧЕНИЯ, В ТОМ ЧИСЛЕ НА КРУПНЫЕ МАНЁВРЫ НАТО
Dialogue: 0,0:03:43.12,0:03:45.05,Caption,,0,0,0,,ВЕСНОЙ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА.
Dialogue: 0,0:03:45.60,0:03:47.58,Caption,,0,0,0,,ЛОНДОН ПЛАНИРУЕТ ПОДГОТОВИТЬ АРМИЮ К
Dialogue: 0,0:03:47.58,0:03:50.18,Caption,,0,0,0,,ВОЗМОЖНОЙ ВОЙНЕ К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ ГОДУ.
Dialogue: 0,0:03:50.18,0:03:52.81,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАБАВНО. ПОЛИТИКИ ОБЪЯСНЯЮТ,
Dialogue: 0,0:03:52.89,0:03:55.14,Caption,,0,0,0,,ЧТО БОЯТЬСЯ ОСОБО НЕЧЕГО. ВОЕННЫЕ
Dialogue: 0,0:03:55.14,0:03:57.61,Caption,,0,0,0,,СЧИТАЮТ АНГАРЫ, НАТЯГИВАЮТ СЕТКИ,
Dialogue: 0,0:03:57.85,0:04:00.04,Caption,,0,0,0,,РАССРЕДОТОЧИВАЮТ САМОЛЁТЫ И ВСПОМИНАЮТ
Dialogue: 0,0:04:00.04,0:04:03.53,Caption,,0,0,0,,ТЕЛЕФОНЫ СТА ТЫСЯЧ БЫВШИХ ВОЕННОСЛУЖАЩИХ. НАВЕРНОЕ,
Dialogue: 0,0:04:03.67,0:04:08.07,Caption,,0,0,0,,ПРОСТО ОЧЕНЬ ЛЮБЯТ ПОРЯДОК. А ТЕПЕРЬ ПОЛЬША. ВАРШАВА ПОПРОСИЛА
Dialogue: 0,0:04:08.07,0:04:10.62,Caption,,0,0,0,,СОЮЗНИКОВ РАССМОТРЕТЬ ПЕРЕХВАТ РОССИЙСКИХ РАКЕТ
Dialogue: 0,0:04:10.62,0:04:13.44,Caption,,0,0,0,,НАД УКРАИНОЙ, ЕСЛИ ОНИ ДВИЖУТСЯ В СТОРОНУ СТРАН
Dialogue: 0,0:04:13.44,0:04:16.34,Caption,,0,0,0,,АЛЬЯНСА. НЕКОТОРЫЕ ГОСУДАРСТВА ИДЕЮ ПОДДЕРЖАЛИ.
Dialogue: 0,0:04:16.34,0:04:19.29,Caption,,0,0,0,,ДВАДЦАТОГО НОЯБРЯ, СОГЛАСНО ОПУБЛИКОВАННЫМ ДАННЫМ,
Dialogue: 0,0:04:19.61,0:04:21.72,Caption,,0,0,0,,ТРИ КРЫЛАТЫЕ РАКЕТЫ ВОШЛИ В ВОЗДУШНОЕ
Dialogue: 0,0:04:21.72,0:04:24.33,Caption,,0,0,0,,ПРОСТРАНСТВО ПОЛЬШИ И УПАЛИ В НОВОМ ЛИПОВЦЕ,
Dialogue: 0,0:04:24.49,0:04:28.48,Caption,,0,0,0,,РУДНИКЕ И МОЛОДИЧЕ. ПОСЛЕ ЭКСТРЕННОГО ЗАСЕДАНИЯ НАТО БЫЛО
Dialogue: 0,0:04:28.48,0:04:30.82,Caption,,0,0,0,,РЕШЕНО НАПРАВИТЬ В ПОЛЬШУ САМОЛЁТ АВАКС.
Dialogue: 0,0:04:30.82,0:04:33.89,Caption,,0,0,0,,ДВАДЦАТЬ ТРЕТЬЕГО НОЯБРЯ ИНИЦИАТИВУ ОБСУЖДАЛИ ПОСЛЫ В
Dialogue: 0,0:04:33.89,0:04:36.76,Caption,,0,0,0,,БРЮССЕЛЕ. ДВАДЦАТЬ ПЯТОГО НОЯБРЯ СИКОРСКИЙ
Dialogue: 0,0:04:36.76,0:04:39.60,Caption,,0,0,0,,ПУБЛИЧНО ПРИЗВАЛ ПЕРЕХВАТЫВАТЬ РОССИЙСКИЕ ЦЕЛИ НАД
Dialogue: 0,0:04:39.60,0:04:43.09,Caption,,0,0,0,,УКРАИНОЙ. А ДАЛЬШЕ НАТО СКАЗАЛО НЕТ. ЗАММИНИСТРА ОБОРОНЫ
Dialogue: 0,0:04:43.09,0:04:47.37,Caption,,0,0,0,,ПОЛЬШИ ЦЕЗАРИЙ ТОМЧИК ЗАЯВИЛ, ЧТО АЛЬЯНС ИНИЦИАТИВУ НЕ ПОДДЕРЖИВАЕТ.
Dialogue: 0,0:04:49.64,0:04:52.12,Caption,,0,0,0,,ТАКУЮ ДИСКУССИЮ УЖЕ ПРОВОДИЛИ НЕСКОЛЬКО МЕСЯЦЕВ
Dialogue: 0,0:04:52.12,0:04:54.08,Caption,,0,0,0,,НАЗАД И ТОГДА РЕШИЛИ ПРОЦЕДУРУ НЕ
Dialogue: 0,0:04:54.08,0:04:57.42,Caption,,0,0,0,,РАССМАТРИВАТЬ. ДЛЯ ИЗМЕНЕНИЯ ПОЗИЦИИ НУЖНО СОГЛАСИЕ ВСЕХ
