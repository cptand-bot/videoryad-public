Dialogue: 0,0:05:33.39,0:05:35.56,Caption,,0,0,0,,ОПРЕДЕЛЯТЬ ПО РАДАРАМ И ДРУГИМ ПАРАМЕТРАМ,
Dialogue: 0,0:05:35.79,0:05:37.66,Caption,,0,0,0,,ПОСЛЕ ЧЕГО ПРИНИМАТЬ РЕШЕНИЕ ОБ
