Dialogue: 0,0:09:13.97,0:09:16.31,Caption,,0,0,0,,ПРИЗНАЁТ КРЫМ И ЧЕТЫРЕ РЕГИОНА РОССИЙСКИМИ,
Dialogue: 0,0:09:16.55,0:09:18.44,Caption,,0,0,0,,МОСКВА ССЫЛАЕТСЯ НА РЕФЕРЕНДУМЫ И
Dialogue: 0,0:09:18.44,0:09:21.62,Caption,,0,0,0,,САМООПРЕДЕЛЕНИЕ. МИРНОЕ УРЕГУЛИРОВАНИЕ УПИРАЕТСЯ ВО
Dialogue: 0,0:09:21.62,0:09:24.07,Caption,,0,0,0,,ВЗАИМНЫЕ ОБВИНЕНИЯ ВОКРУГ МИНСКИХ СОГЛАШЕНИЙ.
Dialogue: 0,0:09:26.35,0:09:28.39,Caption,,0,0,0,,НЕВМЕШАТЕЛЬСТВО В ОБВИНЕНИЯ РОССИИ В
