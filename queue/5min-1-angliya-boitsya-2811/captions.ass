Dialogue: 0,0:05:40.24,0:05:43.80,Caption,,0,0,0,,УВЕРЕННОСТЬЮ И АРМЕЙСКОЙ ИНСТРУКЦИЕЙ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:05:43.90,0:05:46.17,Caption,,0,0,0,,ЧТО ЗДЕСЬ ВАЖНЕЕ СЛОВА ПОЛИТИКОВ ИЛИ
Dialogue: 0,0:05:46.17,0:05:48.92,Caption,,0,0,0,,ТО, ЧТО ПОСЛЕ ЭТИХ СЛОВ ДЕЛАЮТ ВОЕННЫЕ. И
Dialogue: 0,0:05:48.92,0:05:51.77,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ТЕПЕРЬ
