Dialogue: 0,0:08:55.90,0:08:57.83,Caption,,0,0,0,,УКРАИНЫ И ГРУЗИИ ВЫБИРАТЬ СОЮЗЫ,
Dialogue: 0,0:08:58.04,0:09:00.27,Caption,,0,0,0,,МОСКВА ОТВЕЧАЕТ ПРИНЦИПОМ НЕДЕЛИМОСТИ
Dialogue: 0,0:09:00.27,0:09:03.46,Caption,,0,0,0,,БЕЗОПАСНОСТИ И РАСШИРЕНИЕМ НАТО. НЕПРИМЕНЕНИЕ СИЛЫ
Dialogue: 0,0:09:03.46,0:09:06.23,Caption,,0,0,0,,ЗАПАД ГОВОРИТ О НАРУШЕНИИ МЕЖДУНАРОДНОГО ПРАВА,
Dialogue: 0,0:09:06.39,0:09:09.51,Caption,,0,0,0,,МОСКВА О САМООБОРОНЕ И ЗАЩИТЕ РУССКОЯЗЫЧНЫХ И
Dialogue: 0,0:09:09.51,0:09:11.99,Caption,,0,0,0,,ОБВИНЯЕТ ЗАПАД В ЭСКАЛАЦИИ. ГРАНИЦЫ И
