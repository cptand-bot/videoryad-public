Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,УКРАИНА ДОЛЖНА ПОЛУЧИТЬ ШЕСТЬСОТ РАКЕТ ПИ ЭЙ СИ
Dialogue: 0,0:00:02.84,0:00:05.24,Caption,,0,0,0,,ДВА НЕМЕЦКОГО ПРОИЗВОДСТВА В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:00:05.24,0:00:07.40,Caption,,0,0,0,,СЕДЬМОМ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДАХ.
Dialogue: 0,0:00:07.83,0:00:10.36,Caption,,0,0,0,,ОДНОВРЕМЕННО В ПОЛЬШЕ ЗАЯВЛЕН ПРОЕКТ ПО ВЫПУСКУ
Dialogue: 0,0:00:10.44,0:00:15.16,Caption,,0,0,0,,РАКЕТ ПИ ЭЙ СИ ТРИ. НА ЕВРОПЕЙСКУЮ СЦЕНУ ВЫХОДИТ ФРИДРИХ МЕРЦ С ПЛАНАМИ
Dialogue: 0,0:00:15.24,0:00:17.40,Caption,,0,0,0,,НА ГОДЫ ВПЕРЁД. ГЕРМАНИЯ ТРЕБУЕТ,
Dialogue: 0,0:00:17.56,0:00:20.52,Caption,,0,0,0,,ЧТОБЫ ДАЛЬНЕЙШЕЕ ФИНАНСИРОВАНИЕ УКРАИНЫ СТАЛО ОБЩИМ
Dialogue: 0,0:00:20.52,0:00:23.40,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВОМ СТРАН ЕВРОСОЮЗА. НЕ ЖЕЛАНИЕМ
Dialogue: 0,0:00:23.40,0:00:27.64,Caption,,0,0,0,,ОТДЕЛЬНЫХ ПРАВИТЕЛЬСТВ, НЕ ДОБРОВОЛЬНЫМ ВКЛАДОМ И НЕ РЕШЕНИЕМ ТЕХ,
Dialogue: 0,0:00:27.87,0:00:30.36,Caption,,0,0,0,,КТО ГОТОВ ПЛАТИТЬ. УЧАСТВОВАТЬ ДОЛЖНЫ ВСЕ.
Dialogue: 0,0:00:30.73,0:00:33.08,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. СЕЙЧАС РАЗБЕРЁМСЯ,
Dialogue: 0,0:00:33.32,0:00:35.80,Caption,,0,0,0,,ПОЧЕМУ У ЕВРОПЫ КАЛЕНДАРЬ ОТКРЫТ НА ДВЕ ТЫСЯЧИ
Dialogue: 0,0:00:35.88,0:00:39.96,Caption,,0,0,0,,ТРИДЦАТЬ ЧЕТВЁРТОМ ГОДУ, А У ЖИТЕЛЕЙ КИЕВА ПЛАНЫ МОГУТ ЗАКОНЧИТЬСЯ УЖЕ
Dialogue: 0,0:00:39.96,0:00:44.60,Caption,,0,0,0,,БЛИЖАЙШИМ ВЕЧЕРОМ. ДЛЯ ОСОБЕННО ЗАДУМЧИВЫХ ПАРТНЁРОВ МЕРЦ ПРИПАС
Dialogue: 0,0:00:44.60,0:00:47.48,Caption,,0,0,0,,УБЕДИТЕЛЬНЫЙ ДОВОД. ЕСЛИ СОГЛАСИЯ НЕ БУДЕТ,
Dialogue: 0,0:00:47.80,0:00:50.36,Caption,,0,0,0,,БЕРЛИН МОЖЕТ ЗАБЛОКИРОВАТЬ СЛЕДУЮЩИЙ СЕМИЛЕТНИЙ
Dialogue: 0,0:00:50.36,0:00:54.44,Caption,,0,0,0,,БЮДЖЕТ ЕВРОСОЮЗА, РАССЧИТАННЫЙ С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ
Dialogue: 0,0:00:54.44,0:00:57.56,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ ГОД. ПО СУЩЕСТВУ ГЕРМАНИЯ
Dialogue: 0,0:00:57.56,0:01:00.12,Caption,,0,0,0,,ПРЕДЛАГАЕТ ПРОСТОЙ ОБМЕН. ВЫ СОГЛАШАЕТЕСЬ
Dialogue: 0,0:01:00.12,0:01:04.36,Caption,,0,0,0,,ФИНАНСИРОВАТЬ КИЕВ, А БЕРЛИН НЕ МЕШАЕТ ПРИНИМАТЬ БЮДЖЕТ. НАЗВАТЬ ЭТО
Dialogue: 0,0:01:04.36,0:01:08.84,Caption,,0,0,0,,ДРУЖЕСКОЙ ПРОСЬБОЙ МОЖНО, НО ТОГДА И НАЛОГОВОГО ИНСПЕКТОРА ПРИДЁТСЯ СЧИТАТЬ
Dialogue: 0,0:01:08.92,0:01:12.20,Caption,,0,0,0,,ЧЕЛОВЕКОМ, КОТОРЫЙ ПРОСТО ОЧЕНЬ ИНТЕРЕСУЕТСЯ ВАШИМИ ДОХОДАМИ.
Dialogue: 0,0:01:14.49,0:01:17.53,Caption,,0,0,0,,ВЕС ГЕРМАНИИ ПОЗВОЛЯЕТ МЕРЦУ ГОВОРИТЬ ИМЕННО ТАК.
Dialogue: 0,0:01:17.76,0:01:22.09,Caption,,0,0,0,,ЭТО НЕ ГОСУДАРСТВО, ЧЬЁ ВОЗРАЖЕНИЕ МОЖНО ВЫСЛУШАТЬ МЕЖДУ КОФЕ И ОБЕДОМ,
Dialogue: 0,0:01:22.33,0:01:27.37,Caption,,0,0,0,,А ПОТОМ АККУРАТНО ЗАБЫТЬ. НЕМЕЦКАЯ ЭКОНОМИКА ОСТАЁТСЯ ОДНОЙ ИЗ ОПОР ЕВРОСОЮЗА,
Dialogue: 0,0:01:27.60,0:01:30.81,Caption,,0,0,0,,ПОЭТОМУ УГРОЗА БЮДЖЕТУ ИМЕЕТ ВЕС. ОДНАКО САМА
Dialogue: 0,0:01:30.81,0:01:33.93,Caption,,0,0,0,,НЕОБХОДИМОСТЬ ТАКОЙ УГРОЗЫ ВЫДАЁТ ПОЛОЖЕНИЕ ЛУЧШЕ
Dialogue: 0,0:01:33.93,0:01:36.57,Caption,,0,0,0,,ЛЮБЫХ ЗАЯВЛЕНИЙ. ЕСЛИ ЕДИНСТВО ПРИХОДИТСЯ
Dialogue: 0,0:01:36.65,0:01:38.25,Caption,,0,0,0,,ОБЕСПЕЧИВАТЬ ВЫКРУЧИВАНИЕМ РУК,
Dialogue: 0,0:01:38.49,0:01:41.45,Caption,,0,0,0,,ЗНАЧИТ ДОБРОВОЛЬНОГО ЕДИНСТВА УЖЕ НЕТ. ЕСТЬ ОБЩИЙ
Dialogue: 0,0:01:41.53,0:01:44.57,Caption,,0,0,0,,СТОЛ, ОБЩАЯ ФОТОГРАФИЯ И НЕСКОЛЬКО УЧАСТНИКОВ,
Dialogue: 0,0:01:44.75,0:01:47.69,Caption,,0,0,0,,КОТОРЫЕ ВСЁ ЧАЩЕ ТЯНУТСЯ К ВЫХОДУ. ВЕНГРИЯ И
Dialogue: 0,0:01:47.77,0:01:50.65,Caption,,0,0,0,,СЛОВАКИЯ НЕ ХОТЯТ ПРИНИМАТЬ НОВЫЕ ОБЯЗАТЕЛЬСТВА ПО
Dialogue: 0,0:01:50.65,0:01:53.53,Caption,,0,0,0,,ФИНАНСИРОВАНИЮ КИЕВА. НЕДОВОЛЬНЫХ БЕСКОНЕЧНЫМИ
Dialogue: 0,0:01:53.53,0:01:57.69,Caption,,0,0,0,,РАСХОДАМИ БОЛЬШЕ, ПРОСТО НЕ ВСЕ ГОТОВЫ ПЕРВЫМИ ПОДНЯТЬСЯ И СКАЗАТЬ,
Dialogue: 0,0:01:58.03,0:02:00.49,Caption,,0,0,0,,ЧТО БАНКЕТ ЗАТЯНУЛСЯ, СЧЁТ РАСТЁТ,
Dialogue: 0,0:02:00.74,0:02:03.93,Caption,,0,0,0,,А ОФИЦИАНТ УЖЕ НЕСЁТ СЛЕДУЮЩУЮ БУТЫЛКУ. БЕРЛИН
Dialogue: 0,0:02:03.93,0:02:06.17,Caption,,0,0,0,,ПЫТАЕТСЯ РЕШИТЬ ПРОБЛЕМУ НЕ УБЕЖДЕНИЕМ,
Dialogue: 0,0:02:06.34,0:02:09.61,Caption,,0,0,0,,А ИЗМЕНЕНИЕМ ПОРЯДКА ПРИНЯТИЯ РЕШЕНИЙ. ГЕРМАНИЯ
Dialogue: 0,0:02:09.61,0:02:13.45,Caption,,0,0,0,,ДОБИВАЕТСЯ, ЧТОБЫ ДАЛЬНЕЙШУЮ ПОМОЩЬ УТВЕРЖДАЛИ КВАЛИФИЦИРОВАННЫМ
Dialogue: 0,0:02:13.45,0:02:17.21,Caption,,0,0,0,,БОЛЬШИНСТВОМ, А НЕ ЕДИНОГЛАСНО. СМЫСЛ ПОНЯТЕН БЕЗ СЛОВАРЯ
Dialogue: 0,0:02:17.21,0:02:20.09,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ПРАВА. ЕСЛИ НЕСКОЛЬКО ГОСУДАРСТВ
Dialogue: 0,0:02:20.09,0:02:24.89,Caption,,0,0,0,,ОТКАЗЫВАЮТСЯ ПЛАТИТЬ, ИХ ГОЛОСА ПЕРЕСТАЮТ БЫТЬ ПРЕПЯТСТВИЕМ. НЕСОГЛАСНЫЕ
Dialogue: 0,0:02:24.89,0:02:29.05,Caption,,0,0,0,,СОХРАНЯЮТ ПРАВО ВЫСКАЗАТЬСЯ, А ОСТАЛЬНЫЕ СОХРАНЯЮТ ПРАВО ПОСТУПИТЬ ТАК,
Dialogue: 0,0:02:29.33,0:02:35.50,Caption,,0,0,0,,БУДТО НИЧЕГО НЕ УСЛЫШАЛИ. СНАРУЖИ ВСЁ БУДЕТ ВЫГЛЯДЕТЬ ПРИЛИЧНО. ЗАСЕДАНИЕ
Dialogue: 0,0:02:35.50,0:02:37.66,Caption,,0,0,0,,ПРОВЕДЕНО, ПРОТОКОЛ СОСТАВЛЕН,
Dialogue: 0,0:02:37.82,0:02:40.06,Caption,,0,0,0,,БОЛЬШИНСТВО НАБРАНО. ТОЛЬКО СОЮЗ,
Dialogue: 0,0:02:40.46,0:02:42.78,Caption,,0,0,0,,ГДЕ МЕНЬШИНСТВО СИСТЕМАТИЧЕСКИ ОБХОДЯТ ПО ВОПРОСУ
Dialogue: 0,0:02:42.86,0:02:47.02,Caption,,0,0,0,,МИЛЛИАРДНЫХ РАСХОДОВ, УЖЕ НАПОМИНАЕТ ТОВАРИЩЕСТВО СОБСТВЕННИКОВ ЖИЛЬЯ,
Dialogue: 0,0:02:47.18,0:02:50.78,Caption,,0,0,0,,В КОТОРОМ ПРЕДСЕДАТЕЛЬ САМ НАЗНАЧАЕТ ВЗНОСЫ И САМ
Dialogue: 0,0:02:50.78,0:02:52.94,Caption,,0,0,0,,ОБЪЯВЛЯЕТ ВОЗРАЖЕНИЯ НЕКОНСТРУКТИВНЫМИ.
Dialogue: 0,0:02:53.53,0:02:56.54,Caption,,0,0,0,,МЕРЦ ПРЕДСТАВЛЯЕТ САМУЮ НЕПРИМИРИМУЮ ЧАСТЬ ЕВРОПЫ.
Dialogue: 0,0:02:56.84,0:03:00.06,Caption,,0,0,0,,ЭТА ГРУППА НЕ ПРОСТО ОТКАЗЫВАЕТСЯ ОТСТУПАТЬ. ОНА
Dialogue: 0,0:03:00.14,0:03:02.94,Caption,,0,0,0,,СТАРАЕТСЯ ПРИСТЕГНУТЬ К ПРЕЖНЕМУ КУРСУ ОСТАЛЬНЫХ,
Dialogue: 0,0:03:03.18,0:03:05.90,Caption,,0,0,0,,ЧТОБЫ ДАЖЕ ЖЕЛАЮЩИЕ ВЫЙТИ НЕ СМОГЛИ ОТКРЫТЬ ДВЕРЬ.
Dialogue: 0,0:03:06.50,0:03:09.66,Caption,,0,0,0,,РАСЧЁТ, КОТОРЫЙ НЕСКОЛЬКО ЛЕТ НАЗАД ПОДАВАЛИ ПОЧТИ КАК
Dialogue: 0,0:03:09.74,0:03:11.74,Caption,,0,0,0,,ГОТОВЫЙ РЕЗУЛЬТАТ, НЕ СРАБОТАЛ.
Dialogue: 0,0:03:12.30,0:03:15.02,Caption,,0,0,0,,ТЕПЕРЬ ОДНИ УЧАСТНИКИ ИЩУТ ВЫХОД И ПРОВЕРЯЮТ,
Dialogue: 0,0:03:15.18,0:03:18.06,Caption,,0,0,0,,ГДЕ ЕЩЁ МОЖНО ПОВЕРНУТЬ. ДРУГИЕ ДЕЛАЮТ ВИД,
Dialogue: 0,0:03:18.29,0:03:22.94,Caption,,0,0,0,,ЧТО МАРШРУТ ПРЕКРАСЕН, НУЖНО ТОЛЬКО СИЛЬНЕЕ ДАВИТЬ НА ПЕДАЛЬ. МЕРЦ СИДИТ
Dialogue: 0,0:03:22.94,0:03:25.90,Caption,,0,0,0,,ИМЕННО ЗА РУЛЁМ ВТОРОЙ МАШИНЫ. ПОКА БЕРЛИН СОБИРАЕТ
Dialogue: 0,0:03:25.98,0:03:27.50,Caption,,0,0,0,,СРЕДСТВА НА ПРОДОЛЖЕНИЕ КУРСА,
Dialogue: 0,0:03:27.82,0:03:30.54,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ВОЕННЫЕ СТРУКТУРЫ ОТКРЫВАЮТ КАЛЕНДАРЬ НА
Dialogue: 0,0:03:30.62,0:03:33.74,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ ГОД. СОВЕТ ЕВРОСОЮЗА
Dialogue: 0,0:03:33.74,0:03:35.82,Caption,,0,0,0,,ПРОДЛИЛ МИССИЮ ПО ПОДГОТОВКЕ УКРАИНСКИХ
Dialogue: 0,0:03:35.82,0:03:39.02,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ ДО НОЯБРЯ ЭТОГО ГОДА. НА ПРОГРАММУ
Dialogue: 0,0:03:39.02,0:03:42.14,Caption,,0,0,0,,ВЫДЕЛЕНО ПОЧТИ ТРИСТА МИЛЛИОНОВ ЕВРО. РЕЧЬ ИДЁТ НЕ
Dialogue: 0,0:03:42.14,0:03:48.01,Caption,,0,0,0,,ТОЛЬКО ОБ ОБУЧЕНИИ. МИССИЯ ДОЛЖНА АНАЛИЗИРОВАТЬ БОЕВОЙ ОПЫТ,
Dialogue: 0,0:03:48.17,0:03:50.89,Caption,,0,0,0,,ОБНОВЛЯТЬ ПОДГОТОВКУ И КООРДИНИРОВАТЬ РАБОТУ С
Dialogue: 0,0:03:50.89,0:03:53.77,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЕЙ, КАНАДОЙ, НОРВЕГИЕЙ,
Dialogue: 0,0:03:53.87,0:03:56.33,Caption,,0,0,0,,СОЕДИНЁННЫМИ ШТАТАМИ И СТРУКТУРАМИ НАТО.
Dialogue: 0,0:03:56.97,0:03:59.69,Caption,,0,0,0,,ТАК ВЫГЛЯДИТ НАСТОЯЩИЙ ОТВЕТ ТОЙ ЧАСТИ ЕВРОПЫ,
Dialogue: 0,0:03:59.93,0:04:03.05,Caption,,0,0,0,,КОТОРУЮ ОЛИЦЕТВОРЯЕТ МЕРЦ. ПЕРЕГОВОРЫ МОГУТ ИДТИ,
Dialogue: 0,0:04:03.28,0:04:06.89,Caption,,0,0,0,,УСЛОВИЯ МОГУТ МЕНЯТЬСЯ, УЧАСТНИКИ МОГУТ ОБСУЖДАТЬ УСТУПКИ,
Dialogue: 0,0:04:07.13,0:04:09.85,Caption,,0,0,0,,НО ВОЕННЫЕ ПРОГРАММЫ ПРОДОЛЖАЮТ РАСКЛАДЫВАТЬ ПО
Dialogue: 0,0:04:09.93,0:04:12.41,Caption,,0,0,0,,ГОДАМ. ИХ НЕ СВОРАЧИВАЮТ И ДАЖЕ НЕ СТАВЯТ
Dialogue: 0,0:04:12.49,0:04:15.21,Caption,,0,0,0,,НА ПАУЗУ. ТЕМ ВРЕМЕНЕМ ПЕРЕГОВОРНЫЙ ПРОЦЕСС ТОЖЕ
Dialogue: 0,0:04:15.21,0:04:19.53,Caption,,0,0,0,,ДВИЖЕТСЯ, ХОТЯ ИМЕННО ОН НЕ ОБЪЯСНЯЕТ ГЛАВНОГО НАПРЯЖЕНИЯ. ПО
Dialogue: 0,0:04:19.53,0:04:23.45,Caption,,0,0,0,,ДАННЫМ ГАЗЕТЫ ТЕЛЕГРАФ, КИЕВ ГОТОВ ОБСУЖДАТЬ ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ.
Dialogue: 0,0:04:23.76,0:04:26.33,Caption,,0,0,0,,АМЕРИКАНСКИЕ ИСТОЧНИКИ ГОВОРЯТ О НЕКОТОРОЙ ГИБКОСТИ
Dialogue: 0,0:04:26.41,0:04:28.73,Caption,,0,0,0,,МОСКВЫ И КИЕВА. ТЕРРИТОРИАЛЬНЫЙ ВОПРОС
Dialogue: 0,0:04:28.73,0:04:31.21,Caption,,0,0,0,,ПРЕДПОЛАГАЕТСЯ ОСТАВИТЬ НА БОЛЕЕ ПОЗДНИЙ ЭТАП,
Dialogue: 0,0:04:31.45,0:04:34.57,Caption,,0,0,0,,СНАЧАЛА ЗАНЯВШИСЬ ГАРАНТИЯМИ БЕЗОПАСНОСТИ. ЗНАЧИТ,
Dialogue: 0,0:04:34.89,0:04:38.17,Caption,,0,0,0,,ПРОСТРАНСТВО ДЛЯ РАЗГОВОРА СУЩЕСТВУЕТ. СТОРОНЫ ИЩУТ
Dialogue: 0,0:04:38.17,0:04:42.89,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ РЕШЕНИЙ, ПРИ КОТОРОЙ САМЫЕ ТЯЖЁЛЫЕ ВОПРОСЫ НЕ ЛОМАЮТ ДИАЛОГ
Dialogue: 0,0:04:42.97,0:04:45.93,Caption,,0,0,0,,СРАЗУ. НО ПОКА ОДНИ ПРОБУЮТ ПОДОБРАТЬ УСЛОВИЯ
Dialogue: 0,0:04:45.93,0:04:49.05,Caption,,0,0,0,,ВЫХОДА, МЕРЦ И ЕГО СТОРОННИКИ ГОТОВЯТ ДЕНЬГИ,
Dialogue: 0,0:04:49.14,0:04:54.81,Caption,,0,0,0,,ОБУЧЕНИЕ И ПРОИЗВОДСТВО ТАК, БУДТО ВПЕРЕДИ ЕЩЁ МНОГО ЛЕТ ПРЕЖНЕГО КУРСА. ИМЕННО
Dialogue: 0,0:04:54.81,0:04:57.45,Caption,,0,0,0,,ЗДЕСЬ ДОЛГОСРОЧНЫЕ ПЛАНЫ УПИРАЮТСЯ В ПРЕДЕЛЫ,
Dialogue: 0,0:04:57.69,0:04:59.77,Caption,,0,0,0,,КОТОРЫЕ НЕВОЗМОЖНО ОБОЙТИ ГОЛОСОВАНИЕМ.
Dialogue: 0,0:05:02.04,0:05:05.72,Caption,,0,0,0,,ПРЕДСТАВЬТЕ ГОРОД, КОТОРОМУ ПРЕДЛАГАЮТ ПОТЕРПЕТЬ БЕЗ СВЕТА ДО ДВУХ
Dialogue: 0,0:05:05.72,0:05:09.64,Caption,,0,0,0,,НЕДЕЛЬ, ЗАТО УВЕРЕННО ОБЕЩАЮТ РАКЕТЫ ЧЕРЕЗ ДВА ГОДА. В
Dialogue: 0,0:05:09.72,0:05:12.36,Caption,,0,0,0,,КВАРТИРЕ ХОЛОДНО, НАСОСЫ ОСТАНОВИЛИСЬ,
Dialogue: 0,0:05:12.61,0:05:15.64,Caption,,0,0,0,,СВЯЗЬ ЛЕГЛА, А ИЗ БРЮССЕЛЯ БОДРО СООБЩАЮТ,
Dialogue: 0,0:05:15.80,0:05:18.76,Caption,,0,0,0,,ЧТО СТРАТЕГИЧЕСКИЙ ГОРИЗОНТ ВЫГЛЯДИТ ОБНАДЁЖИВАЮЩЕ.
Dialogue: 0,0:05:19.23,0:05:21.56,Caption,,0,0,0,,СТРАТЕГИЧЕСКИЙ ГОРИЗОНТ ВООБЩЕ УДОБНАЯ ВЕЩЬ.
Dialogue: 0,0:05:21.96,0:05:24.44,Caption,,0,0,0,,ОСОБЕННО КОГДА СМОТРЕТЬ НА НЕГО ИЗ ТЁПЛОГО КАБИНЕТА.
Dialogue: 0,0:05:24.72,0:05:27.48,Caption,,0,0,0,,ДЕПУТАТ ВЕРХОВНОЙ РАДЫ СЕРГЕЙ НАГОРНЯК ПРЕДУПРЕДИЛ
Dialogue: 0,0:05:27.56,0:05:30.28,Caption,,0,0,0,,ЕСЛИ КИЕВ НАДОЛГО ОСТАНЕТСЯ БЕЗ ЭЛЕКТРИЧЕСТВА,
Dialogue: 0,0:05:30.38,0:05:34.60,Caption,,0,0,0,,ВОДЫ И ТЕПЛА, ЛЮДИ СПОСОБНЫ СМЕСТИ ВЛАСТЬ. ПРИЧЁМ РАЗБИРАТЬСЯ В
Dialogue: 0,0:05:34.60,0:05:37.08,Caption,,0,0,0,,ДОЛЖНОСТЯХ ОНИ НЕ СТАНУТ. ПОД РАЗДАЧУ,
Dialogue: 0,0:05:37.16,0:05:40.28,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, МОГУТ ПОПАСТЬ ЦЕНТРАЛЬНОЕ РУКОВОДСТВО,
Dialogue: 0,0:05:40.36,0:05:43.56,Caption,,0,0,0,,ПАРЛАМЕНТ, ИСПОЛНИТЕЛЬНАЯ ВЛАСТЬ И МЕСТНЫЕ ЧИНОВНИКИ.
Dialogue: 0,0:05:43.87,0:05:46.52,Caption,,0,0,0,,ПОЛУЧАЕТСЯ РЕДКИЙ СЛУЧАЙ ПОЛНОГО ГОСУДАРСТВЕННОГО
Dialogue: 0,0:05:46.52,0:05:50.52,Caption,,0,0,0,,ЕДИНСТВА. КОГДА ВСЁ РАБОТАЕТ, ВЕДОМСТВА ГОДАМИ ВЫЯСНЯЮТ,
Dialogue: 0,0:05:50.64,0:05:53.16,Caption,,0,0,0,,КТО ЗА ЧТО ОТВЕЧАЕТ. КОГДА В ДОМАХ ТЕМНО
Dialogue: 0,0:05:53.24,0:05:57.56,Caption,,0,0,0,,И ХОЛОДНО, ВИНОВАТЫМИ ВНЕЗАПНО СТАНОВЯТСЯ ВСЕ СРАЗУ. ЭНЕРГЕТИКИ
Dialogue: 0,0:05:57.56,0:05:59.88,Caption,,0,0,0,,ОПИСЫВАЮТ ВПОЛНЕ КОНКРЕТНЫЙ СЦЕНАРИЙ. ПРИ
Dialogue: 0,0:05:59.88,0:06:02.12,Caption,,0,0,0,,ПОВРЕЖДЕНИИ КЛЮЧЕВЫХ СОЕДИНЕНИЙ КИЕВ,
Dialogue: 0,0:06:02.24,0:06:05.40,Caption,,0,0,0,,ОДЕССА И ДНЕПР МОГУТ ЛИШИТЬСЯ ЭЛЕКТРИЧЕСТВА НА ТРИ
Dialogue: 0,0:06:05.48,0:06:08.28,Caption,,0,0,0,,ИЛИ ПЯТЬ ДНЕЙ. ЕСЛИ СОБЫТИЯ ПОЙДУТ ПО САМОМУ
Dialogue: 0,0:06:08.28,0:06:12.28,Caption,,0,0,0,,ТЯЖЁЛОМУ ВАРИАНТУ, ОТКЛЮЧЕНИЕ СПОСОБНО РАСТЯНУТЬСЯ НА ОДНУ ИЛИ ДВЕ
Dialogue: 0,0:06:12.28,0:06:17.51,Caption,,0,0,0,,НЕДЕЛИ. ДВЕ НЕДЕЛИ ДЛЯ БОЛЬШОГО ГОРОДА ОЗНАЧАЮТ УЖЕ НЕ
Dialogue: 0,0:06:17.51,0:06:19.59,Caption,,0,0,0,,НЕУДОБСТВО И НЕ ИСПОРЧЕННЫЙ ВЕЧЕР.
Dialogue: 0,0:06:20.14,0:06:22.71,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ТЯНЕТ ЗА СОБОЙ ВОДОСНАБЖЕНИЕ,
Dialogue: 0,0:06:22.82,0:06:28.63,Caption,,0,0,0,,СВЯЗЬ, ТРАНСПОРТ, ОТОПЛЕНИЕ, РАБОТУ МАГАЗИНОВ И БЫТОВУЮ ИНФРАСТРУКТУРУ. СТОИТ
Dialogue: 0,0:06:28.63,0:06:31.43,Caption,,0,0,0,,ВЫБИТЬ ГЛАВНЫЕ СОЕДИНЕНИЯ С ОБЩЕЙ ЭНЕРГОСИСТЕМОЙ,
Dialogue: 0,0:06:31.66,0:06:34.87,Caption,,0,0,0,,И МЕГАПОЛИС ПРЕВРАЩАЕТСЯ В ОГРОМНЫЙ ОСТРОВ. ТОЛЬКО
Dialogue: 0,0:06:34.87,0:06:37.59,Caption,,0,0,0,,ПАЛЬМ ТАМ НЕТ, ЗАТО ЕСТЬ МНОГОЭТАЖКИ,
Dialogue: 0,0:06:37.72,0:06:40.71,Caption,,0,0,0,,ЗАМЁРЗШИЕ ТРУБЫ И НЕСКОЛЬКО МИЛЛИОНОВ ОЧЕНЬ
Dialogue: 0,0:06:40.71,0:06:45.27,Caption,,0,0,0,,НЕДОВОЛЬНЫХ ЛЮДЕЙ. ЭКСПЕРТ АНДРИАН ПРОКИП ОТДЕЛЬНО ГОВОРИТ О
Dialogue: 0,0:06:45.27,0:06:49.03,Caption,,0,0,0,,СОЕДИНЕНИЯХ, ЧЕРЕЗ КОТОРЫЕ КРУПНЫЕ ГОРОДА ПОЛУЧАЮТ ЭНЕРГИЮ ИЗ
Dialogue: 0,0:06:49.03,0:06:51.43,Caption,,0,0,0,,ОБЪЕДИНЁННОЙ СЕТИ. ПОКА ОНИ РАБОТАЮТ,
Dialogue: 0,0:06:51.67,0:06:54.55,Caption,,0,0,0,,СИСТЕМУ МОЖНО ПОДДЕРЖИВАТЬ. КОГДА ИХ ПОВРЕЖДАЮТ,
Dialogue: 0,0:06:54.83,0:06:58.07,Caption,,0,0,0,,ПРОБЛЕМА ПЕРЕСТАЁТ БЫТЬ МЕСТНОЙ. ВСЯ ГОРОДСКАЯ ЖИЗНЬ
Dialogue: 0,0:06:58.07,0:07:01.51,Caption,,0,0,0,,НАЧИНАЕТ ОСТАНАВЛИВАТЬСЯ ЗВЕНО ЗА ЗВЕНОМ. ВОТ ПОЧЕМУ
Dialogue: 0,0:07:01.51,0:07:04.47,Caption,,0,0,0,,СЛОВА НАГОРНЯКА ЗВУЧАТ НЕРВНО. ОН ГОВОРИТ НЕ О
Dialogue: 0,0:07:04.47,0:07:07.03,Caption,,0,0,0,,ДАЛЁКОЙ ТЕОРИИ И НЕ О КРАСИВОЙ РЕВОЛЮЦИОННОЙ
Dialogue: 0,0:07:07.03,0:07:09.67,Caption,,0,0,0,,ЛЕГЕНДЕ. ОН ПРЕДУПРЕЖДАЕТ О МОМЕНТЕ,
Dialogue: 0,0:07:09.91,0:07:11.83,Caption,,0,0,0,,КОГДА ЛЮДИ ПЕРЕСТАНУТ ВЫЯСНЯТЬ,
Dialogue: 0,0:07:12.07,0:07:15.75,Caption,,0,0,0,,КАКОЕ ИМЕННО УЧРЕЖДЕНИЕ НЕ СПРАВИЛОСЬ. ДОЛЖНОСТНУЮ
Dialogue: 0,0:07:15.83,0:07:18.23,Caption,,0,0,0,,ИНСТРУКЦИЮ У КОСТРА ВО ДВОРЕ ОБЫЧНО НЕ ЧИТАЮТ.
Dialogue: 0,0:07:18.55,0:07:21.43,Caption,,0,0,0,,ДЛЯ ОБОРОННЫХ ПРОГРАММ ВРЕМЯ ИЗМЕРЯЕТСЯ ГОДАМИ.
Dialogue: 0,0:07:21.73,0:07:24.87,Caption,,0,0,0,,НУЖНО ОТКРЫТЬ НОВЫЕ ЛИНИИ, ЗАКЛЮЧИТЬ ДОГОВОРЫ,
Dialogue: 0,0:07:25.03,0:07:27.83,Caption,,0,0,0,,НАЛАДИТЬ ПРОИЗВОДСТВО И ПОДГОТОВИТЬ СПЕЦИАЛИСТОВ.
Dialogue: 0,0:07:30.10,0:07:32.26,Caption,,0,0,0,,ДЛЯ ЧЕЛОВЕКА В ОБЕСТОЧЕННОЙ КВАРТИРЕ ВРЕМЯ
Dialogue: 0,0:07:32.26,0:07:36.42,Caption,,0,0,0,,ИЗМЕРЯЕТСЯ ТЕМ, СКОЛЬКО ЧАСОВ ОСТАЛОСЬ ДО ПОЛНОГО ОСТЫВАНИЯ ДОМА.
Dialogue: 0,0:07:36.98,0:07:39.86,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ УЧРЕЖДЕНИЯ ОБСУЖДАЮТ НОЯБРЬ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:39.86,0:07:43.14,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОГО ГОДА. ПРОИЗВОДИТЕЛИ СЧИТАЮТ ОБЪЁМЫ
Dialogue: 0,0:07:43.14,0:07:46.02,Caption,,0,0,0,,НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ И ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:46.02,0:07:49.30,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОЙ ГОДЫ. МЕРЦ СМОТРИТ НА БЮДЖЕТ ДО
Dialogue: 0,0:07:49.38,0:07:52.18,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТОГО ГОДА. ЛЮДЯМ НУЖЕН
Dialogue: 0,0:07:52.18,0:07:56.42,Caption,,0,0,0,,СВЕТ, ЧТОБЫ РАБОТАЛИ НАСОСЫ И СВЯЗЬ. НУЖНА ВОДА. НУЖНО
Dialogue: 0,0:07:56.42,0:07:59.38,Caption,,0,0,0,,ТЕПЛО. И ТОЛЬКО ПОСЛЕ ЭТОГО ПОЯВЛЯЕТСЯ ЖЕЛАНИЕ
Dialogue: 0,0:07:59.38,0:08:02.10,Caption,,0,0,0,,РАССУЖДАТЬ О БУДУЩЕЙ СИСТЕМЕ БЕЗОПАСНОСТИ,
Dialogue: 0,0:08:02.34,0:08:05.22,Caption,,0,0,0,,НОВЫХ ПРЕДПРИЯТИЯХ И РАСПРЕДЕЛЕНИИ РАСХОДОВ МЕЖДУ
Dialogue: 0,0:08:05.22,0:08:09.14,Caption,,0,0,0,,СОЮЗНИКАМИ. ЕСЛИ СЕМЬЯ СУТКАМИ СИДИТ В ХОЛОДНОЙ КВАРТИРЕ,
Dialogue: 0,0:08:09.50,0:08:12.26,Caption,,0,0,0,,ЕЁ ПРИОРИТЕТЫ БЫСТРО ОЧИЩАЮТСЯ ОТ ВСЕГО ЛИШНЕГО.
Dialogue: 0,0:08:12.66,0:08:14.98,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ КОНФЛИКТА ПЕРЕСТАЁТ БЫТЬ КРАСИВОЙ
Dialogue: 0,0:08:14.98,0:08:18.50,Caption,,0,0,0,,ФОРМУЛОЙ, А ТРЕБОВАНИЕ ЕГО ЗАКОНЧИТЬ СТАНОВИТСЯ ВОПРОСОМ
Dialogue: 0,0:08:18.50,0:08:21.14,Caption,,0,0,0,,ВОЗВРАЩЕНИЯ НОРМАЛЬНОЙ ЖИЗНИ. ГОЛОСОВАНИЕ
Dialogue: 0,0:08:21.22,0:08:23.86,Caption,,0,0,0,,ЕВРОПЕЙСКОГО СОВЕТА НЕ СПОСОБНО ПРИКАЗАТЬ ЖИТЕЛЯМ
Dialogue: 0,0:08:23.86,0:08:26.74,Caption,,0,0,0,,КИЕВА СПОКОЙНО ПРОЖИТЬ ДВЕ НЕДЕЛИ БЕЗ ЭЛЕКТРИЧЕСТВА.
Dialogue: 0,0:08:27.06,0:08:29.78,Caption,,0,0,0,,НЕЛЬЗЯ ПРОДЛИТЬ ТЕРПЕНИЕ ОТДЕЛЬНЫМ ПОСТАНОВЛЕНИЕМ.
Dialogue: 0,0:08:30.18,0:08:32.58,Caption,,0,0,0,,НЕ ПОЛУЧИТСЯ ВКЛЮЧИТЬ ОТОПЛЕНИЕ КВАЛИФИЦИРОВАННЫМ
Dialogue: 0,0:08:32.58,0:08:35.14,Caption,,0,0,0,,БОЛЬШИНСТВОМ. ДАЖЕ ГЕРМАНИЯ ПОКА НЕ НАУЧИЛАСЬ
Dialogue: 0,0:08:35.14,0:08:37.95,Caption,,0,0,0,,ПОДАВАТЬ ВОДУ ЧЕРЕЗ БЮДЖЕТНУЮ РЕЗОЛЮЦИЮ. ПОЭТОМУ
Dialogue: 0,0:08:37.95,0:08:40.66,Caption,,0,0,0,,ДОЛГИЕ ПЛАНЫ СТАЛКИВАЮТСЯ НЕ ТОЛЬКО С СОПРОТИВЛЕНИЕМ
Dialogue: 0,0:08:40.66,0:08:46.78,Caption,,0,0,0,,ВЕНГРИИ ИЛИ СЛОВАКИИ. ОНИ СТАЛКИВАЮТСЯ С ПОВСЕДНЕВНОСТЬЮ ВНУТРИ САМОЙ
Dialogue: 0,0:08:46.86,0:08:50.05,Caption,,0,0,0,,УКРАИНЫ. И ЭТА ПОВСЕДНЕВНОСТЬ СПОСОБНА ИЗМЕНИТЬ
Dialogue: 0,0:08:50.05,0:08:53.98,Caption,,0,0,0,,СИТУАЦИЮ РАНЬШЕ, ЧЕМ ЗАРАБОТАЮТ НОВЫЕ ЗАВОДЫ И ПРИБУДУТ ОБЕЩАННЫЕ
Dialogue: 0,0:08:54.05,0:08:56.86,Caption,,0,0,0,,РАКЕТЫ. ПОЛИТИЧЕСКИЕ ПРОГРАММЫ СУЩЕСТВУЮТ,
Dialogue: 0,0:08:57.12,0:08:59.66,Caption,,0,0,0,,ПОКА ЛЮДИ СОГЛАСНЫ ПЛАТИТЬ ЗА НИХ ДЕНЬГАМИ,
Dialogue: 0,0:08:59.81,0:09:03.02,Caption,,0,0,0,,БЕЗОПАСНОСТЬЮ И СОБСТВЕННЫМ ТЕРПЕНИЕМ. КОГДА ЦЕНА
Dialogue: 0,0:09:03.02,0:09:04.78,Caption,,0,0,0,,СТАНОВИТСЯ ХОЛОДНОЙ КВАРТИРОЙ,
Dialogue: 0,0:09:04.93,0:09:07.50,Caption,,0,0,0,,НЕРАБОТАЮЩИМ ТРАНСПОРТОМ И ОТСУТСТВИЕМ ВОДЫ,
Dialogue: 0,0:09:07.79,0:09:09.98,Caption,,0,0,0,,СОГЛАСИЕ ЗАКАНЧИВАЕТСЯ БЫСТРЕЕ,
Dialogue: 0,0:09:10.06,0:09:13.02,Caption,,0,0,0,,ЧЕМ ЗАСЕДАНИЕ ЕВРОПЕЙСКИХ МИНИСТРОВ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:09:13.16,0:09:17.10,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ДАЛЬШЕ ОСОБЕННО ХОРОШО ВИДНО,
Dialogue: 0,0:09:17.27,0:09:19.42,Caption,,0,0,0,,КАК РАЗНЫЕ ЧАСЫ ИДУТ В ОДНОМ И ТОМ
Dialogue: 0,0:09:19.42,0:09:23.02,Caption,,0,0,0,,ЖЕ КОНФЛИКТЕ. С РАКЕТАМИ КАРТИНА ЕЩЁ НАГЛЯДНЕЕ. ПО
Dialogue: 0,0:09:23.02,0:09:27.66,Caption,,0,0,0,,ДАННЫМ АГЕНТСТВА БЛУМБЕРГ, РОССИЯ ПРОИЗВОДИТ БАЛЛИСТИЧЕСКИЕ РАКЕТЫ БЫСТРЕЕ,
Dialogue: 0,0:09:27.89,0:09:30.46,Caption,,0,0,0,,ЧЕМ ВСЕ МИРОВЫЕ ИЗГОТОВИТЕЛИ ПЕРЕХВАТЧИКОВ ДЛЯ
Dialogue: 0,0:09:30.54,0:09:33.82,Caption,,0,0,0,,СИСТЕМ ПЭТРИОТ УСПЕВАЮТ ВЫПУСКАТЬ ПРОТИВОРАКЕТЫ. ТУТ
Dialogue: 0,0:09:33.90,0:09:35.98,Caption,,0,0,0,,УЖЕ НЕ ПОМОЖЕТ ОСОБЕННО СУРОВОЕ ЗАЯВЛЕНИЕ У
Dialogue: 0,0:09:35.98,0:09:38.54,Caption,,0,0,0,,МИКРОФОНА. ЕСЛИ РАКЕТ СТАНОВИТСЯ БОЛЬШЕ,
Dialogue: 0,0:09:38.85,0:09:43.17,Caption,,0,0,0,,ЧЕМ СРЕДСТВ ПЕРЕХВАТА, ДЕФИЦИТ НЕ ИСПУГАЕТСЯ РЕШИТЕЛЬНОЙ ИНТОНАЦИИ. ОН
Dialogue: 0,0:09:43.26,0:09:45.82,Caption,,0,0,0,,ВООБЩЕ ПЛОХО ПОНИМАЕТ ВЫСТУПЛЕНИЯ ЧИНОВНИКОВ. НА
Dialogue: 0,0:09:45.90,0:09:48.29,Caption,,0,0,0,,ФОНЕ ЭТИХ СРОКОВ УКРАИНСКАЯ ДИПЛОМАТИЯ РЕШИЛА
Dialogue: 0,0:09:48.29,0:09:50.29,Caption,,0,0,0,,ДОБАВИТЬ ПРОИСХОДЯЩЕМУ ДЕКОРАЦИЙ.
Dialogue: 0,0:09:52.58,0:09:55.06,Caption,,0,0,0,,ПОСТОЯННЫЙ ПРЕДСТАВИТЕЛЬ УКРАИНЫ ПРИ ООН АНДРЕЙ
Dialogue: 0,0:09:55.14,0:09:58.50,Caption,,0,0,0,,МЕЛЬНИК ЗАЯВИЛ, ЧТО ЗЕЛЕНСКИЙ ГОТОВ ВСТРЕТИТЬСЯ С ПУТИНЫМ ГДЕ
Dialogue: 0,0:09:58.50,0:10:01.06,Caption,,0,0,0,,УГОДНО, ХОТЬ В АНТАРКТИДЕ, ТОЛЬКО НЕ В МОСКВЕ.
Dialogue: 0,0:10:02.06,0:10:04.18,Caption,,0,0,0,,ДЕВЯНОСТО ПЯТЫЙ КВАРТАЛ, ПОХОЖЕ,
Dialogue: 0,0:10:04.33,0:10:07.70,Caption,,0,0,0,,РАСШИРИЛ ГАСТРОЛЬНЫЙ ГРАФИК. ТУРЦИЯ УЖЕ БЫЛА,
Dialogue: 0,0:10:07.86,0:10:09.86,Caption,,0,0,0,,ДРУГИЕ ПЛОЩАДКИ ТОЖЕ ОБСУЖДАЛИСЬ,
Dialogue: 0,0:10:10.04,0:10:11.86,Caption,,0,0,0,,ТЕПЕРЬ ОЧЕРЕДЬ ДОШЛА ДО ПИНГВИНОВ.
Dialogue: 0,0:10:12.41,0:10:13.94,Caption,,0,0,0,,ЖИВОТНЫЕ НИ В ЧЁМ НЕ ВИНОВАТЫ,
Dialogue: 0,0:10:14.14,0:10:18.42,Caption,,0,0,0,,НО ИХ МНЕНИЕМ, КАК ОБЫЧНО, НИКТО НЕ ПОИНТЕРЕСОВАЛСЯ. АНТАРКТИДА,
Dialogue: 0,0:10:18.65,0:10:21.22,Caption,,0,0,0,,КОНЕЧНО, ВЫГЛЯДИТ ЭФФЕКТНО. ЛЁД,
Dialogue: 0,0:10:21.30,0:10:25.38,Caption,,0,0,0,,ВЕТЕР, СУРОВЫЕ ЛИЦА И НИ ОДНОГО СЛУЧАЙНОГО ПРОХОЖЕГО,
Dialogue: 0,0:10:25.46,0:10:28.02,Caption,,0,0,0,,КОТОРЫЙ ИСПОРТИТ КАДР. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:10:28.26,0:10:30.50,Caption,,0,0,0,,И К СТОЛУ ПЕРЕГОВОРОВ ПРИСТАВЯТ ПОЛЯРНИКА,
Dialogue: 0,0:10:30.66,0:10:34.50,Caption,,0,0,0,,ЧТОБЫ ОН СЛЕДИЛ, НЕ ПРИМЕРЗАЮТ ЛИ РУЧКИ К ДОКУМЕНТАМ. ТОЛЬКО МЕСТО
Dialogue: 0,0:10:34.58,0:10:37.30,Caption,,0,0,0,,ВСТРЕЧИ НЕ ОТМЕНЯЕТ СОДЕРЖАНИЯ. ТЕРРИТОРИИ,
Dialogue: 0,0:10:37.46,0:10:40.02,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ И УСЛОВИЯ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:10:40.02,0:10:42.42,Caption,,0,0,0,,КОНФЛИКТА ПРИДЁТСЯ ОБСУЖДАТЬ И В МОСКВЕ,
Dialogue: 0,0:10:42.63,0:10:45.94,Caption,,0,0,0,,И В АБУ ДАБИ, И ВОЗЛЕ ОСОБЕННО ТЕРПЕЛИВОГО ПИНГВИНА.
Dialogue: 0,0:10:46.65,0:10:49.06,Caption,,0,0,0,,ВЫБОР ДЕКОРАЦИЙ ЛИШЬ ПОДЧЁРКИВАЕТ СТРАННОСТЬ
Dialogue: 0,0:10:49.06,0:10:51.78,Caption,,0,0,0,,МОМЕНТА. КИЕВ ГОВОРИТ О ВОЗМОЖНЫХ УСТУПКАХ,
Dialogue: 0,0:10:52.02,0:10:54.02,Caption,,0,0,0,,АМЕРИКАНЦЫ ОТМЕЧАЮТ ГИБКОСТЬ СТОРОН,
Dialogue: 0,0:10:54.26,0:10:57.06,Caption,,0,0,0,,А ЕВРОПЕЙСКАЯ ГРУППА МЕРЦА ОДНОВРЕМЕННО ВЫСТРАИВАЕТ
Dialogue: 0,0:10:57.06,0:11:00.10,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ И ВОЕННЫЕ ПРОГРАММЫ НА ГОДЫ. НАВЕРХУ
Dialogue: 0,0:11:00.10,0:11:03.22,Caption,,0,0,0,,ОБСУЖДАЮТ, КАКИМ БОЛЬШИНСТВОМ ПРИНИМАТЬ РЕШЕНИЯ,
Dialogue: 0,0:11:03.49,0:11:08.34,Caption,,0,0,0,,КТО ВЫДЕЛИТ ДЕНЬГИ, ГДЕ ОТКРОЕТСЯ ПРОИЗВОДСТВО И В КАКОЙ ТОЧКЕ ПЛАНЕТЫ
Dialogue: 0,0:11:08.34,0:11:14.55,Caption,,0,0,0,,ПОСТАВИТЬ СТОЛ ДЛЯ ЛИДЕРОВ. НА ВЕРХНЕМ УРОВНЕ МОЖНО ПЕРЕНЕСТИ ЗАСЕДАНИЕ,
Dialogue: 0,0:11:14.71,0:11:17.59,Caption,,0,0,0,,ПЕРЕПИСАТЬ ПРОЕКТ БЮДЖЕТА ИЛИ НАЙТИ НОВУЮ ПЛОЩАДКУ.
Dialogue: 0,0:11:18.03,0:11:21.11,Caption,,0,0,0,,НА НИЖНЕМ УРОВНЕ ПЕРЕНОСИТЬ УЖЕ НЕЧЕГО. ХОЛОД НЕ
Dialogue: 0,0:11:21.11,0:11:23.03,Caption,,0,0,0,,ИНТЕРЕСУЕТСЯ ГРАФИКОМ ПЕРЕГОВОРОВ,
Dialogue: 0,0:11:23.32,0:11:27.59,Caption,,0,0,0,,ВОДА НЕ ТЕЧЁТ ОТ ОБЕЩАНИЙ, А ТЕЛЕФОН НЕ ЗАРЯЖАЕТСЯ ОТ ВЫРАЖЕНИЯ ГЛУБОКОЙ
Dialogue: 0,0:11:27.59,0:11:30.63,Caption,,0,0,0,,СОЛИДАРНОСТИ. МЕРЦ МОЖЕТ НАДАВИТЬ НА БУДАПЕШТ И
Dialogue: 0,0:11:30.63,0:11:33.59,Caption,,0,0,0,,БРАТИСЛАВУ. ОН СПОСОБЕН ИСПОЛЬЗОВАТЬ ЭКОНОМИЧЕСКИЙ
Dialogue: 0,0:11:33.59,0:11:37.59,Caption,,0,0,0,,ВЕС ГЕРМАНИИ, УГРОЖАТЬ БЛОКИРОВКОЙ БЮДЖЕТА И ДОБИВАТЬСЯ ИЗМЕНЕНИЯ
Dialogue: 0,0:11:37.59,0:11:42.71,Caption,,0,0,0,,ПРАВИЛ ГОЛОСОВАНИЯ. ВОЗМОЖНО, ЧАСТЬ СОПРОТИВЛЕНИЯ ТАКИМ СПОСОБОМ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:11:42.71,0:11:46.87,Caption,,0,0,0,,УДАСТСЯ СЛОМАТЬ. НО ЗАСТАВИТЬ НАСЕЛЕНИЕ УКРАИНЫ ГОДАМИ ТЕРПЕТЬ
Dialogue: 0,0:11:46.87,0:11:49.75,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ПРЕЖНЕГО КУРСА ЗНАЧИТЕЛЬНО СЛОЖНЕЕ.
Dialogue: 0,0:11:50.20,0:11:52.79,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ БЛИЖАЙШАЯ ЗИМА ПРИНЕСЁТ ДЛИТЕЛЬНЫЕ
Dialogue: 0,0:11:52.79,0:11:55.83,Caption,,0,0,0,,ОТКЛЮЧЕНИЯ В КРУПНЕЙШИХ ГОРОДАХ. ГРАНИЦА ПРОХОДИТ НЕ
Dialogue: 0,0:11:55.83,0:11:58.87,Caption,,0,0,0,,СРЕДИ ЛЬДОВ АНТАРКТИДЫ И НЕ ЗА ДВЕРЬЮ ОЧЕРЕДНОГО
Dialogue: 0,0:11:58.87,0:12:01.91,Caption,,0,0,0,,БРЮССЕЛЬСКОГО КАБИНЕТА. ОНА ВОЗНИКАЕТ МЕЖДУ ТЕМИ,
Dialogue: 0,0:12:02.07,0:12:05.03,Caption,,0,0,0,,КТО ПРИЗНАЛ НЕУДАЧУ ПРЕЖНЕГО РАСЧЁТА И ИЩЕТ ИНОЙ
Dialogue: 0,0:12:05.03,0:12:07.75,Caption,,0,0,0,,ПУТЬ, И ТЕМИ, КТО ТРЕБУЕТ ПРОДОЛЖАТЬ,
Dialogue: 0,0:12:07.99,0:12:10.47,Caption,,0,0,0,,ПОТОМУ ЧТО СЛИШКОМ МНОГОЕ УЖЕ ПОСТАВЛЕНО НА КОН.
Dialogue: 0,0:12:11.21,0:12:14.39,Caption,,0,0,0,,МЕРЦ СТАЛ ГОЛОСОМ ВТОРОЙ ГРУППЫ. ГРОМКИМ,
Dialogue: 0,0:12:14.53,0:12:17.67,Caption,,0,0,0,,ЖЁСТКИМ И ГОТОВЫМ ЗАСТАВЛЯТЬ ОСТАЛЬНЫХ ИДТИ ВМЕСТЕ.
Dialogue: 0,0:12:17.96,0:12:19.99,Caption,,0,0,0,,НО ГРОМКОСТЬ НЕ МЕНЯЕТ РЕЗУЛЬТАТА,
Dialogue: 0,0:12:20.23,0:12:24.15,Caption,,0,0,0,,ЕСЛИ ВЕСЬ ЗАЛ УЖЕ ПОНЯЛ, ЧТО ПРЕЖНЯЯ МЕЛОДИЯ НЕ СРАБОТАЛА.
Dialogue: 0,0:12:24.85,0:12:28.55,Caption,,0,0,0,,ЕСТЬ ЕЩЁ ОДНА СТОРОНА, КОТОРУЮ ПОЧТИ НЕ СЛЫШНО НА СОВЕЩАНИЯХ.
Dialogue: 0,0:12:30.75,0:12:33.07,Caption,,0,0,0,,У НЕЁ НЕТ МЕСТА ЗА ЕВРОПЕЙСКИМ СТОЛОМ,
Dialogue: 0,0:12:33.22,0:12:36.03,Caption,,0,0,0,,ПРАВА ВЕТО И СОБСТВЕННОГО ПУНКТА В МНОГОЛЕТНЕМ
Dialogue: 0,0:12:36.03,0:12:40.91,Caption,,0,0,0,,БЮДЖЕТЕ. ЭТО ЖИТЕЛИ ГОРОДОВ, КОТОРЫМ ОБЕЩАЮТ ВОЗМОЖНЫЕ ОТКЛЮЧЕНИЯ НА НЕСКОЛЬКО
Dialogue: 0,0:12:40.91,0:12:43.71,Caption,,0,0,0,,ДНЕЙ ИЛИ ДАЖЕ НЕДЕЛЬ. ПОКА ОНИ МОЛЧАТ,
Dialogue: 0,0:12:43.95,0:12:46.59,Caption,,0,0,0,,ЧИНОВНИКИ МОГУТ СПОРИТЬ О ПРАВИЛАХ ГОЛОСОВАНИЯ,
Dialogue: 0,0:12:46.75,0:12:49.95,Caption,,0,0,0,,РАКЕТАХ И ПЛОЩАДКАХ ДЛЯ ВСТРЕЧИ. ЕСЛИ В КВАРТИРАХ
Dialogue: 0,0:12:50.03,0:12:52.59,Caption,,0,0,0,,НАДОЛГО ИСЧЕЗНУТ СВЕТ, ВОДА И ТЕПЛО,
Dialogue: 0,0:12:52.82,0:12:56.19,Caption,,0,0,0,,СПОР ПОЛУЧИТ НОВОГО УЧАСТНИКА. И ПРИГЛАШЕНИЯ ЕМУ НЕ
Dialogue: 0,0:12:56.19,0:12:58.35,Caption,,0,0,0,,ПОТРЕБУЕТСЯ. НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:12:58.58,0:13:00.99,Caption,,0,0,0,,ЧТО ЗАКОНЧИТСЯ РАНЬШЕ ТЕРПЕНИЕ ЕВРОПЕЙСКИХ
Dialogue: 0,0:13:00.99,0:13:05.07,Caption,,0,0,0,,ПЛАТЕЛЬЩИКОВ, ТЕРПЕНИЕ ЖИТЕЛЕЙ УКРАИНЫ ИЛИ ЗАПАС ПЛОЩАДОК,
Dialogue: 0,0:13:05.23,0:13:07.79,Caption,,0,0,0,,НА КОТОРЫХ ЕЩЁ НЕ ПРЕДЛАГАЛИ ПРОВЕСТИ ПЕРЕГОВОРЫ.
Dialogue: 0,0:13:08.19,0:13:10.59,Caption,,0,0,0,,БЕРЛИН МОЖЕТ РАСПИСАТЬ РАСХОДЫ ДО ДВЕ ТЫСЯЧИ
Dialogue: 0,0:13:10.67,0:13:13.47,Caption,,0,0,0,,ТРИДЦАТЬ ЧЕТВЁРТОГО ГОДА. БРЮССЕЛЬ МОЖЕТ ПРОДЛИТЬ
Dialogue: 0,0:13:13.55,0:13:16.03,Caption,,0,0,0,,ВОЕННУЮ ПОДГОТОВКУ ДО НОЯБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:13:16.03,0:13:18.83,Caption,,0,0,0,,ВОСЬМОГО. ПРОИЗВОДИТЕЛИ МОГУТ ПООБЕЩАТЬ ШЕСТЬСОТ
Dialogue: 0,0:13:18.83,0:13:21.55,Caption,,0,0,0,,РАКЕТ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ. НО БЛИЖАЙШУЮ ЗИМУ
Dialogue: 0,0:13:21.63,0:13:24.67,Caption,,0,0,0,,ПРИДЁТСЯ ПРОЖИТЬ СЕЙЧАС. И ЕСЛИ ГОРОДА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:13:24.67,0:13:29.31,Caption,,0,0,0,,ПОГРУЗЯТСЯ ВО ТЬМУ И ХОЛОД, НИКАКОЙ МИКРОФОН ЛЮДЯМ УЖЕ НЕ ПОНАДОБИТСЯ. ИХ
Dialogue: 0,0:13:29.39,0:13:31.55,Caption,,0,0,0,,УСЛЫШАТ И В КИЕВЕ, И В БЕРЛИНЕ,
Dialogue: 0,0:13:31.79,0:13:32.75,Caption,,0,0,0,,И ДАЖЕ В АНТАРКТИДЕ.
