Dialogue: 0,0:00:00.11,0:00:03.88,Caption,,0,0,0,,КАЗАЛОСЬ БЫ, НУ ВСЁ, ТРАМП СДУЛСЯ. ЗЕЛЕНСКИЙ ЕГО НИ В КАКУЮ НЕ
Dialogue: 0,0:00:03.88,0:00:06.20,Caption,,0,0,0,,СЛУШАЕТ, ЕВРОПА ДЕЛАЕТ ЧТО ХОЧЕТ,
Dialogue: 0,0:00:06.45,0:00:08.68,Caption,,0,0,0,,А ОН ОПЯТЬ РАССКАЗЫВАЕТ ПРО КАКУЮ ТО БОЛЬШУЮ
Dialogue: 0,0:00:08.68,0:00:11.32,Caption,,0,0,0,,СДЕЛКУ. НУ КАКУЮ, БЛИН, СДЕЛКУ,
Dialogue: 0,0:00:11.40,0:00:14.68,Caption,,0,0,0,,ДОНАЛЬД? ТОЛЬКО ЕСТЬ ОДНА МАЛЕНЬКАЯ ПРОБЛЕМА. В АБУ ДАБИ
Dialogue: 0,0:00:14.68,0:00:17.32,Caption,,0,0,0,,ПОЧЕМУ ТО УЖЕ СОБИРАЮТСЯ СОВСЕМ НЕ ТУРИСТЫ. И
Dialogue: 0,0:00:17.32,0:00:20.12,Caption,,0,0,0,,ВОТ ТУТ ВОПРОС. ЕСЛИ ЗАСТАВИТЬ НИКОГО НЕЛЬЗЯ,
Dialogue: 0,0:00:20.36,0:00:24.60,Caption,,0,0,0,,ЧЕГО ОНИ ВСЕ ТУДА ПРУТСЯ? ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ЗДЕСЬ СЕЙЧАС САМОЕ
Dialogue: 0,0:00:24.60,0:00:27.00,Caption,,0,0,0,,ИНТЕРЕСНОЕ НЕ В ТОМ, ЧТО ТРАМП СКАЗАЛ.
Dialogue: 0,0:00:27.56,0:00:30.76,Caption,,0,0,0,,А В ТОМ, ЧТО ВОКРУГ ЕГО СЛОВ ВДРУГ НАЧАЛИ ДЕЛАТЬ СОВСЕМ
Dialogue: 0,0:00:30.76,0:00:33.80,Caption,,0,0,0,,ДРУГИЕ ЛЮДИ. ТРАМП ВСТРЕТИЛСЯ С КИРИЛЛОМ ДМИТРИЕВЫМ.
Dialogue: 0,0:00:34.04,0:00:35.96,Caption,,0,0,0,,ПРИЧЁМ С УКРАИНСКОЙ ДЕЛЕГАЦИЕЙ В ТОТ ЖЕ ДЕНЬ
Dialogue: 0,0:00:35.96,0:00:38.76,Caption,,0,0,0,,ВСТРЕЧАТЬСЯ НЕ СТАЛ. ПОТОМ ВЫШЕЛ К ЖУРНАЛИСТАМ И
Dialogue: 0,0:00:38.76,0:00:42.28,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО СОГЛАШЕНИЕ БУДЕТ БОЛЬШИМ. НАСТОЛЬКО БОЛЬШИМ,
Dialogue: 0,0:00:42.44,0:00:44.20,Caption,,0,0,0,,ЧТО ЗАТРОНЕТ НЕ ТОЛЬКО УКРАИНУ,
Dialogue: 0,0:00:44.38,0:00:46.52,Caption,,0,0,0,,НО ЕДВА ЛИ НЕ ВСЮ ЕВРОПУ. А ЧЕРЕЗ
Dialogue: 0,0:00:46.52,0:00:50.92,Caption,,0,0,0,,НЕСКОЛЬКО ДНЕЙ АМЕРИКАНЦЫ, УКРАИНЦЫ И РОССИЯНЕ ДОЛЖНЫ СНОВА ВСТРЕТИТЬСЯ В АБУ
Dialogue: 0,0:00:50.92,0:00:54.12,Caption,,0,0,0,,ДАБИ. ДМИТРИЕВ ЧЕРЕЗ ПОЛМИРА НЕ ЛЕТИТ ЗА МАГНИТИКОМ
Dialogue: 0,0:00:54.12,0:00:57.16,Caption,,0,0,0,,НА ХОЛОДИЛЬНИК. УКРАИНСКАЯ ДЕЛЕГАЦИЯ ТОЖЕ СОБИРАЕТ
Dialogue: 0,0:00:57.16,0:01:00.20,Caption,,0,0,0,,ЧЕМОДАНЫ НЕ РАДИ ЭКСКУРСИИ ПО ЭМИРАТАМ. МОЖНО,
Dialogue: 0,0:01:00.28,0:01:02.68,Caption,,0,0,0,,КОНЕЧНО, ОБМЕНИВАТЬСЯ БЛАГОДАРНОСТЯМИ,
Dialogue: 0,0:01:02.92,0:01:05.56,Caption,,0,0,0,,ВРУЧАТЬ ПИСЬМА И УЛЫБАТЬСЯ В КАМЕРЫ. НО НА
Dialogue: 0,0:01:05.64,0:01:09.00,Caption,,0,0,0,,ТАКОМ УРОВНЕ КУДА ИНТЕРЕСНЕЕ, КОГО ПРИГЛАШАЮТ К ПРЕЗИДЕНТУ,
Dialogue: 0,0:01:09.08,0:01:14.88,Caption,,0,0,0,,А КОМУ ПРИХОДИТСЯ ЖДАТЬ. И ТУТ УЖЕ ВАЖНЕЕ НЕ КРАСИВАЯ ФОТОГРАФИЯ,
Dialogue: 0,0:01:15.03,0:01:18.00,Caption,,0,0,0,,А ТО, КОГО ДОПУСТИЛИ К РАЗГОВОРУ С ПРЕЗИДЕНТОМ,
Dialogue: 0,0:01:18.24,0:01:21.20,Caption,,0,0,0,,КОМУ ПРИШЛОСЬ ЖДАТЬ И КАКИЕ ВОПРОСЫ ВООБЩЕ ВЫНЕСЛИ
Dialogue: 0,0:01:21.20,0:01:24.48,Caption,,0,0,0,,ЗА ПРЕДЕЛЫ УКРАИНЫ. ЕСЛИ НОВАЯ КОНСТРУКЦИЯ КАСАЕТСЯ
Dialogue: 0,0:01:24.48,0:01:28.96,Caption,,0,0,0,,БЕЗОПАСНОСТИ КОНТИНЕНТА, ОДИН КИЕВ ЭТУ КОНСТРУКЦИЮ НЕ УТВЕРДИТ. ДА И
Dialogue: 0,0:01:28.96,0:01:31.28,Caption,,0,0,0,,МОСКВА НЕ СТАНЕТ ПРИЕЗЖАТЬ ТОЛЬКО РАДИ ТОГО,
Dialogue: 0,0:01:31.44,0:01:34.24,Caption,,0,0,0,,ЧТОБЫ ВЫСЛУШАТЬ ПРЕЖНИЙ СПИСОК ПОЖЕЛАНИЙ. И ВОТ
Dialogue: 0,0:01:34.24,0:01:36.72,Caption,,0,0,0,,ЗДЕСЬ ОЧЕНЬ КСТАТИ ВСПОМИНАЕТСЯ ЛУКАШЕНКО. ОН
Dialogue: 0,0:01:36.72,0:01:39.20,Caption,,0,0,0,,НЕДАВНО СФОРМУЛИРОВАЛ РАЗВИЛКУ БЕЗ ВОСЬМИДЕСЯТИ
Dialogue: 0,0:01:39.20,0:01:41.92,Caption,,0,0,0,,СТРАНИЦ ДИПЛОМАТИЧЕСКОГО ТЕКСТА. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:01:42.24,0:01:44.96,Caption,,0,0,0,,ЛИБО ЭТОТ КОНФЛИКТ ЗАКАНЧИВАЕТСЯ В БЛИЖАЙШИЕ МЕСЯЦЫ,
Dialogue: 0,0:01:45.36,0:01:47.92,Caption,,0,0,0,,ЛИБО ДАЛЬШЕ МОЖНО ПРИЕХАТЬ УЖЕ К ЯДЕРНОЙ ИСТОРИИ.
Dialogue: 0,0:01:48.21,0:01:50.72,Caption,,0,0,0,,И ЕСЛИ СМОТРЕТЬ НА НЫНЕШНЮЮ СПЕШКУ ВАШИНГТОНА,
Dialogue: 0,0:01:51.04,0:01:53.68,Caption,,0,0,0,,ТРАМП ЯВНО ПЫТАЕТСЯ НЕ ДОПУСТИТЬ ВТОРОГО ВАРИАНТА.
Dialogue: 0,0:01:53.84,0:01:56.48,Caption,,0,0,0,,НЕ ПОТОМУ, ЧТО ВНЕЗАПНО ПОЛЮБИЛ ЗЕЛЕНСКОГО,
Dialogue: 0,0:01:56.57,0:01:59.20,Caption,,0,0,0,,ПУТИНА ИЛИ ЕВРОПЕЙСКИХ ПЕНСИОНЕРОВ. ЕМУ НУЖНО
Dialogue: 0,0:01:59.20,0:02:02.16,Caption,,0,0,0,,ЗАКРЫТЬ ПРОБЛЕМУ. ПРИЧЁМ БЫСТРО. ТОЛЬКО АМЕРИКАНСКИЙ
Dialogue: 0,0:02:02.16,0:02:04.32,Caption,,0,0,0,,ПРЕЗИДЕНТ НЕ МОЖЕТ ЗАКОНЧИТЬ ЭТОТ КОНФЛИКТ
Dialogue: 0,0:02:04.32,0:02:09.12,Caption,,0,0,0,,СОБСТВЕННЫМ УКАЗОМ. А ЗНАЧИТ, ТРАМПУ ПРИДЁТСЯ НЕ ПРОСТО ПРИДУМАТЬ УСЛОВИЯ. ЕМУ
Dialogue: 0,0:02:09.12,0:02:11.68,Caption,,0,0,0,,ПРИДЁТСЯ ЗАСТАВИТЬ ОСТАЛЬНЫХ СЧИТАТЬ ЭТИ УСЛОВИЯ
Dialogue: 0,0:02:11.68,0:02:14.88,Caption,,0,0,0,,ВЫГОДНЕЕ ПРОДОЛЖЕНИЯ КОНФЛИКТА. МОСКВА ХОЧЕТ СВОЁ.
Dialogue: 0,0:02:15.20,0:02:18.48,Caption,,0,0,0,,КИЕВ ХОЧЕТ СВОЁ. ЕВРОПА ВООБЩЕ ХОЧЕТ ОТДЕЛЬНОЕ СВОЁ.
Dialogue: 0,0:02:18.78,0:02:22.48,Caption,,0,0,0,,И ВСЕ ПОЧЕМУ ТО УВЕРЕНЫ, ЧТО ИМЕННО ОСТАЛЬНЫЕ ДОЛЖНЫ УСТУПИТЬ.
Dialogue: 0,0:02:24.68,0:02:27.56,Caption,,0,0,0,,ПРЕКРАСНАЯ КОМПАНИЯ СОБРАЛАСЬ ЗА СТОЛОМ. С МОСКВОЙ
Dialogue: 0,0:02:27.56,0:02:30.84,Caption,,0,0,0,,ХОТЯ БЫ ПОНЯТНО, ЧЕГО ОНА ДОБИВАЕТСЯ. ТЕРРИТОРИИ,
Dialogue: 0,0:02:31.00,0:02:33.96,Caption,,0,0,0,,СТАТУС УКРАИНЫ, НАТО, САНКЦИИ,
Dialogue: 0,0:02:34.04,0:02:37.48,Caption,,0,0,0,,БЕЗОПАСНОСТЬ В ЕВРОПЕ. СПИСОК СТАРЫЙ. ТОРГОВАТЬСЯ
Dialogue: 0,0:02:37.48,0:02:39.72,Caption,,0,0,0,,БУДУТ НЕ О ТОМ, СУЩЕСТВУЕТ ОН ИЛИ НЕТ,
Dialogue: 0,0:02:39.88,0:02:43.56,Caption,,0,0,0,,А О ТОМ, СКОЛЬКО ИЗ НЕГО ПОПАДЁТ В ИТОГОВУЮ БУМАГУ. И
Dialogue: 0,0:02:43.56,0:02:46.12,Caption,,0,0,0,,ЕСЛИ ТРАМП ДЕЙСТВИТЕЛЬНО РЕШИЛ ЗАКАНЧИВАТЬ КОНФЛИКТ
Dialogue: 0,0:02:46.12,0:02:49.80,Caption,,0,0,0,,СЕЙЧАС, ЕМУ ПРИДЁТСЯ ИСХОДИТЬ ИЗ РЕАЛЬНОГО ПОЛОЖЕНИЯ ВЕЩЕЙ,
Dialogue: 0,0:02:50.04,0:02:53.48,Caption,,0,0,0,,А НЕ ИЗ ТОГО, ЧТО КРАСИВО ЗВУЧАЛО БЫ В ПРЕСС РЕЛИЗЕ. НО
Dialogue: 0,0:02:53.48,0:02:56.52,Caption,,0,0,0,,ПЕРЕЧИСЛИТЬ УСЛОВИЯ НА БУМАГЕ МАЛО. ЧТОБЫ БУМАГА
Dialogue: 0,0:02:56.52,0:02:59.56,Caption,,0,0,0,,СТАЛА СОГЛАШЕНИЕМ, КТО ТО ДОЛЖЕН ПРИНЯТЬ УСЛОВИЯ,
Dialogue: 0,0:02:59.72,0:03:03.00,Caption,,0,0,0,,КОТОРЫЕ ВЧЕРА ОТВЕРГАЛ. И ЗДЕСЬ ВОЗНИКАЕТ КУДА БОЛЕЕ
Dialogue: 0,0:03:03.00,0:03:06.04,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС. ЕСЛИ РОССИЙСКИЕ УСЛОВИЯ ЯВЛЯЮТСЯ
Dialogue: 0,0:03:06.12,0:03:09.72,Caption,,0,0,0,,ЧАСТЬЮ БУДУЩЕГО СОГЛАШЕНИЯ, КТО ТОГДА ДОЛЖЕН ДВИГАТЬСЯ НАВСТРЕЧУ?
Dialogue: 0,0:03:09.95,0:03:12.44,Caption,,0,0,0,,МОСКВА САМА СЕБЕ УСТУПАТЬ НЕ БУДЕТ. ЗНАЧИТ,
Dialogue: 0,0:03:12.52,0:03:15.40,Caption,,0,0,0,,ДВИГАТЬ ПРИДЁТСЯ КИЕВ. А ВОТ ТУТ НАМ НЕСКОЛЬКО
Dialogue: 0,0:03:15.48,0:03:19.40,Caption,,0,0,0,,ЛЕТ ОБЪЯСНЯЛИ, ЧТО ЗЕЛЕНСКОГО УЖЕ ОСОБО НИЧЕМ НЕ ПРИЖМЁШЬ. АМЕРИКА
Dialogue: 0,0:03:19.40,0:03:22.84,Caption,,0,0,0,,ДАВИТ, ОН СОПРОТИВЛЯЕТСЯ. ТРАМП ТРЕБУЕТ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:03:23.07,0:03:25.56,Caption,,0,0,0,,КИЕВ ТРЕБУЕТ ГАРАНТИЙ. ВАШИНГТОН ГОВОРИТ ПРО
Dialogue: 0,0:03:25.56,0:03:29.80,Caption,,0,0,0,,КОМПРОМИСС, КИЕВ ПРОСИТ ЕЩЁ ОРУЖИЯ. ЕВРОПЕЙЦЫ ТУТ ЖЕ ПРИЕЗЖАЮТ,
Dialogue: 0,0:03:30.04,0:03:32.84,Caption,,0,0,0,,ОБНИМАЮТ ЗЕЛЕНСКОГО, ОБЕЩАЮТ ПОДДЕРЖКУ,
Dialogue: 0,0:03:33.01,0:03:35.80,Caption,,0,0,0,,И КАРУСЕЛЬ СНОВА НАЧИНАЕТ КРУТИТЬСЯ. ОТСЮДА И
Dialogue: 0,0:03:35.80,0:03:39.67,Caption,,0,0,0,,КАРТИНКА. ТРАМП ЗЛИТСЯ,
Dialogue: 0,0:03:39.82,0:03:42.23,Caption,,0,0,0,,ТРАМП РУГАЕТСЯ, ТРАМП УГРОЖАЕТ,
Dialogue: 0,0:03:42.47,0:03:44.95,Caption,,0,0,0,,А КИЕВ ВСЁ РАВНО ДЕЛАЕТ ПО СВОЕМУ. ЗНАЧИТ,
Dialogue: 0,0:03:45.04,0:03:48.79,Caption,,0,0,0,,РЫЧАГОВ НЕТ. НУ ДА. ЕСЛИ СМОТРЕТЬ ТОЛЬКО ТЕЛЕВИЗОР.
Dialogue: 0,0:03:49.18,0:03:52.87,Caption,,0,0,0,,А ЕСЛИ ПОСМОТРЕТЬ НА ТО, ЧТО ПРОИСХОДИТ ВНУТРИ САМОЙ УКРАИНЫ,
Dialogue: 0,0:03:53.19,0:03:56.23,Caption,,0,0,0,,КАРТИНА СТАНОВИТСЯ КУДА ВЕСЕЛЕЕ. АНТИКОРРУПЦИОННЫЕ
Dialogue: 0,0:03:56.23,0:03:58.71,Caption,,0,0,0,,ОРГАНЫ ПРОДОЛЖАЮТ ЛЕЗТЬ В ЧУВСТВИТЕЛЬНЫЕ МЕСТА.
Dialogue: 0,0:03:58.95,0:04:01.27,Caption,,0,0,0,,ВСПЛЫВАЮТ ЧИНОВНИКИ, ПРОКУРОРЫ,
Dialogue: 0,0:04:01.35,0:04:04.95,Caption,,0,0,0,,СИЛОВИКИ, ЛЮДИ ИЗ БОЛЬШИХ КАБИНЕТОВ. И ДЛЯ ТРАМПА ЗДЕСЬ
Dialogue: 0,0:04:05.03,0:04:07.83,Caption,,0,0,0,,ВАЖЕН НЕ САМ ОЧЕРЕДНОЙ СКАНДАЛ. ВАЖНО ДРУГОЕ
Dialogue: 0,0:04:07.83,0:04:09.99,Caption,,0,0,0,,НАСКОЛЬКО КРЕПКОЙ ОСТАЁТСЯ ВЕРТИКАЛЬ,
Dialogue: 0,0:04:10.23,0:04:12.87,Caption,,0,0,0,,КОГДА ЕЁ ЛЮДИ НАЧИНАЮТ БОЯТЬСЯ УЖЕ ЗА СЕБЯ.
Dialogue: 0,0:04:13.08,0:04:17.99,Caption,,0,0,0,,ПОКА У НАЧАЛЬНИКА ВСЁ ХОРОШО, ВОКРУГ НЕГО ПОЛНО ВЕРНЫХ ДРУЗЕЙ. ВСЕ СТОЯТ ПЛЕЧОМ
Dialogue: 0,0:04:18.07,0:04:21.99,Caption,,0,0,0,,К ПЛЕЧУ, ВСЕ ОДНА КОМАНДА. НО СТОИТ ЧИНОВНИКУ ПОЧУВСТВОВАТЬ,
Dialogue: 0,0:04:22.23,0:04:24.95,Caption,,0,0,0,,ЧТО ЗАВТРА МОГУТ ЗАБЛОКИРОВАТЬ ИМЕННО ЕГО СЧЁТ,
Dialogue: 0,0:04:25.11,0:04:28.87,Caption,,0,0,0,,К НЕМУ ПРИЙТИ С ОБЫСКОМ, А ЕГО КАРЬЕРУ ЗАКОНЧИТЬ УГОЛОВНЫМ ДЕЛОМ,
Dialogue: 0,0:04:29.19,0:04:31.59,Caption,,0,0,0,,И ПРЕДСТАВЛЕНИЕ О КОМАНДНОЙ ВЕРНОСТИ СТАНОВИТСЯ
Dialogue: 0,0:04:31.59,0:04:34.47,Caption,,0,0,0,,ГОРАЗДО МЕНЕЕ РОМАНТИЧНЫМ. ТУТ УЖЕ ВСПОМИНАЮТ,
Dialogue: 0,0:04:34.68,0:04:37.59,Caption,,0,0,0,,КОМУ МОЖНО ПОЗВОНИТЬ И ЧТО ЛУЧШЕ РАССКАЗАТЬ ПЕРВЫМ.
Dialogue: 0,0:04:37.83,0:04:40.55,Caption,,0,0,0,,А МАТЕРИАЛА ДЛЯ ТАКИХ РАЗГОВОРОВ ЗА ГОДЫ НАКОПИЛОСЬ
Dialogue: 0,0:04:40.63,0:04:43.35,Caption,,0,0,0,,ДОСТАТОЧНО ЗАКУПКИ, СХЕМЫ, ДЕНЬГИ,
Dialogue: 0,0:04:43.43,0:04:48.47,Caption,,0,0,0,,ДОЛЖНОСТИ, ИМУЩЕСТВО, СВЯЗИ. ЗЕЛЕНСКОМУ НИКТО НЕ ПОДПИСЫВАЛ ПОЖИЗНЕННУЮ
Dialogue: 0,0:04:48.47,0:04:54.03,Caption,,0,0,0,,ВЕРНОСТЬ. ОСОБЕННО ЕСЛИ ВНУТРИ АППАРАТА ПОЯВИТСЯ ОЩУЩЕНИЕ,
Dialogue: 0,0:04:54.27,0:04:57.07,Caption,,0,0,0,,ЧТО ВНЕШНЯЯ КРЫША НАД ПРЕЖНЕЙ КОНСТРУКЦИЕЙ НАЧИНАЕТ
Dialogue: 0,0:04:57.07,0:04:59.71,Caption,,0,0,0,,ПРОТЕКАТЬ. НЕ ОБЯЗАТЕЛЬНО ЗВОНИТЬ ЗЕЛЕНСКОМУ И
Dialogue: 0,0:04:59.71,0:05:02.83,Caption,,0,0,0,,ГОВОРИТЬ ВЛАДИМИР, У ВАС ДО ПЯТНИЦЫ. ДОСТАТОЧНО,
Dialogue: 0,0:05:02.99,0:05:05.07,Caption,,0,0,0,,ЧТОБЫ ЛЮДИ РЯДОМ С НИМ НАЧАЛИ СЧИТАТЬ НЕ
Dialogue: 0,0:05:05.07,0:05:07.07,Caption,,0,0,0,,ТОЛЬКО ПОЛИТИЧЕСКИЕ РИСКИ ПРЕЗИДЕНТА,
Dialogue: 0,0:05:07.38,0:05:10.03,Caption,,0,0,0,,НО И СОБСТВЕННЫЕ. ТОГДА ДАВЛЕНИЕ МОЖЕТ ПРИЙТИ
Dialogue: 0,0:05:10.03,0:05:12.83,Caption,,0,0,0,,ИЗНУТРИ. И ВАШИНГТОНУ ДЛЯ ЭТОГО НЕ НУЖНО КОМАНДОВАТЬ
Dialogue: 0,0:05:12.83,0:05:14.91,Caption,,0,0,0,,СЛЕДОВАТЕЛЯМИ. ДОСТАТОЧНО ПОНИМАТЬ,
Dialogue: 0,0:05:15.06,0:05:17.63,Caption,,0,0,0,,КАК РЕЗУЛЬТАТЫ ЭТИХ ДЕЛ МЕНЯЮТ ПОВЕДЕНИЕ ЛЮДЕЙ
Dialogue: 0,0:05:17.63,0:05:21.87,Caption,,0,0,0,,ВНУТРИ СИСТЕМЫ. ВОПРОС В ТОМ, НАСКОЛЬКО УСТОЙЧИВО ОКРУЖЕНИЕ,
Dialogue: 0,0:05:22.01,0:05:24.19,Caption,,0,0,0,,КОГДА ЦЕНА ЛОЯЛЬНОСТИ РЕЗКО ВОЗРАСТАЕТ?
Dialogue: 0,0:05:24.90,0:05:28.03,Caption,,0,0,0,,ТЕПЕРЬ ПЕТРОПАВЛОВСКАЯ БОРЩАГОВКА. ОБЫЧНОЕ СЕЛО ПОД
Dialogue: 0,0:05:28.11,0:05:29.95,Caption,,0,0,0,,КИЕВОМ ВНЕЗАПНО СТАНОВИТСЯ МЕСТОМ,
Dialogue: 0,0:05:30.24,0:05:32.35,Caption,,0,0,0,,КУДА СТЯГИВАЮТСЯ ЛЮДИ, ВОЕННЫЕ,
Dialogue: 0,0:05:32.43,0:05:36.67,Caption,,0,0,0,,СИЛОВИКИ, СЛЕДОВАТЕЛИ. ВОКРУГ ДОМА ИДУТ ОБВИНЕНИЯ В НЕЗАКОННОМ
Dialogue: 0,0:05:36.67,0:05:39.71,Caption,,0,0,0,,УДЕРЖАНИИ ЛЮДЕЙ И ПЫТКАХ. ТОЛПА ПЫТАЕТСЯ ПОПАСТЬ
Dialogue: 0,0:05:39.79,0:05:43.15,Caption,,0,0,0,,ВНУТРЬ. НАЧИНАЕТСЯ ДРАКА. ПОДКЛЮЧАЮТСЯ СБУ,
Dialogue: 0,0:05:43.30,0:05:48.11,Caption,,0,0,0,,НАЦГВАРДИЯ, СЛЕДСТВИЕ, РУКОВОДСТВО ПРЕЗИДЕНТСКОЙ ВЕРТИКАЛИ. ОЧЕНЬ МНОГО
Dialogue: 0,0:05:48.11,0:05:50.99,Caption,,0,0,0,,СЕРЬЁЗНЫХ ЛЮДЕЙ ДЛЯ ОДНОГО ЧАСТНОГО ДОМА. НО ДЛЯ
Dialogue: 0,0:05:50.99,0:05:53.55,Caption,,0,0,0,,НАС ЗДЕСЬ ВАЖНЕЕ ДРУГОЕ НАСКОЛЬКО БЫСТРО ОДИН
Dialogue: 0,0:05:53.55,0:05:55.55,Caption,,0,0,0,,ЛОКАЛЬНЫЙ КОНФЛИКТ ВТЯНУЛ ТОЛПУ,
Dialogue: 0,0:05:55.73,0:05:59.31,Caption,,0,0,0,,ВОЕННЫХ, СПЕЦСЛУЖБЫ И ПРЕДСТАВИТЕЛЕЙ ПРЕЗИДЕНТСКОЙ ВЕРТИКАЛИ.
Dialogue: 0,0:05:59.70,0:06:02.83,Caption,,0,0,0,,ОБЫЧНЫЙ АДРЕС ПОД КИЕВОМ ВНЕЗАПНО СТАНОВИТСЯ ТОЧКОЙ,
Dialogue: 0,0:06:03.15,0:06:05.15,Caption,,0,0,0,,ГДЕ СТАЛКИВАЮТСЯ СРАЗУ НЕСКОЛЬКО СИЛ.
Dialogue: 0,0:06:07.43,0:06:11.03,Caption,,0,0,0,,И ВСЁ ЭТО В МОМЕНТ, КОГДА У ВЛАСТИ И БЕЗ ТОГО ХВАТАЕТ ПРОБЛЕМ.
Dialogue: 0,0:06:11.24,0:06:14.55,Caption,,0,0,0,,А ТЕПЕРЬ КИЕВ. ЭЛЕКТРИЧЕСТВА НЕТ ЧАСАМИ И СУТКАМИ,
Dialogue: 0,0:06:14.79,0:06:18.31,Caption,,0,0,0,,ПРОБЛЕМЫ С ВОДОЙ, ЛЮДИ ПЕРЕКРЫВАЮТ ДОРОГИ И ТРЕБУЮТ ХОТЯ БЫ
Dialogue: 0,0:06:18.31,0:06:20.55,Caption,,0,0,0,,ОБЪЯСНЕНИЙ. ЭТО НЕ ТО ЖЕ САМОЕ,
Dialogue: 0,0:06:20.69,0:06:23.35,Caption,,0,0,0,,ЧТО КОНФЛИКТ ВОКРУГ ДОМА В БОРЩАГОВКЕ. ПРИЧИНЫ
Dialogue: 0,0:06:23.35,0:06:25.91,Caption,,0,0,0,,РАЗНЫЕ. НО НЕПРИЯТНОСТЬ ДЛЯ ВЛАСТИ В ТОМ,
Dialogue: 0,0:06:26.19,0:06:28.55,Caption,,0,0,0,,ЧТО РАЗНЫЕ КРИЗИСЫ НЕ СПРАШИВАЮТ ДРУГ У ДРУГА
Dialogue: 0,0:06:28.55,0:06:31.75,Caption,,0,0,0,,РАЗРЕШЕНИЯ НАЧАТЬСЯ ОДНОВРЕМЕННО. В ОДНОМ МЕСТЕ ЛЮДИ
Dialogue: 0,0:06:31.75,0:06:34.39,Caption,,0,0,0,,ЗЛЯТСЯ ИЗ ЗА СВЕТА. В ДРУГОМ ИДЁТ КОНФЛИКТ
Dialogue: 0,0:06:34.39,0:06:37.19,Caption,,0,0,0,,С МОБИЛИЗАЦИОННОЙ СИСТЕМОЙ. В ТРЕТЬЕМ ГРОМКОЕ
Dialogue: 0,0:06:37.19,0:06:39.75,Caption,,0,0,0,,УГОЛОВНОЕ ДЕЛО ЗАСТАВЛЯЕТ ЧИНОВНИКОВ НЕРВНО
Dialogue: 0,0:06:39.75,0:06:42.79,Caption,,0,0,0,,ВСПОМИНАТЬ СТАРЫЕ ЗНАКОМСТВА. И ВЧЕРАШНЯЯ МОНОЛИТНАЯ
Dialogue: 0,0:06:42.79,0:06:44.95,Caption,,0,0,0,,ВЕРТИКАЛЬ НАЧИНАЕТ СКРИПЕТЬ НЕ ПОТОМУ,
Dialogue: 0,0:06:45.11,0:06:47.35,Caption,,0,0,0,,ЧТО КТО ТО ОДНИМ ДВИЖЕНИЕМ ВЫБИЛ ИЗ НЕЁ
Dialogue: 0,0:06:47.35,0:06:51.99,Caption,,0,0,0,,ОПОРУ, А ПОТОМУ, ЧТО НАГРУЗКА ПРИХОДИТ СРАЗУ С НЕСКОЛЬКИХ СТОРОН. А
Dialogue: 0,0:06:51.99,0:06:55.03,Caption,,0,0,0,,ТЕПЕРЬ ПОСМОТРИМ, КАКИЕ ВОЗМОЖНОСТИ ЕСТЬ У ВАШИНГТОНА.
Dialogue: 0,0:06:55.64,0:06:57.99,Caption,,0,0,0,,ВАШИНГТОН ДЕСЯТИЛЕТИЯМИ РАБОТАЛ С УКРАИНСКИМИ
Dialogue: 0,0:06:57.99,0:07:00.63,Caption,,0,0,0,,ПОЛИТИКАМИ, ЧИНОВНИКАМИ, ВОЕННЫМИ,
Dialogue: 0,0:07:00.66,0:07:05.35,Caption,,0,0,0,,СИЛОВИКАМИ, БИЗНЕСОМ И ОБЩЕСТВЕННЫМИ ОРГАНИЗАЦИЯМИ. ПЛЮС ДЕНЬГИ,
Dialogue: 0,0:07:05.43,0:07:07.99,Caption,,0,0,0,,ВООРУЖЕНИЕ, РАЗВЕДЫВАТЕЛЬНЫЕ ДАННЫЕ,
Dialogue: 0,0:07:08.15,0:07:10.71,Caption,,0,0,0,,ФИНАНСОВЫЕ ОГРАНИЧЕНИЯ, САНКЦИИ,
Dialogue: 0,0:07:10.84,0:07:15.03,Caption,,0,0,0,,ВИЗЫ, ЛИЧНЫЕ СВЯЗИ И МЕЖДУНАРОДНАЯ ПОЛИТИЧЕСКАЯ ПОДДЕРЖКА.
Dialogue: 0,0:07:15.27,0:07:18.23,Caption,,0,0,0,,ЭТО НЕ ОДИН РЫЧАГ. ЭТО ЦЕЛАЯ ПАНЕЛЬ РЫЧАГОВ,
Dialogue: 0,0:07:18.45,0:07:21.03,Caption,,0,0,0,,И КАЖДЫЙ ДАВИТ НА СВОЁ МЕСТО. ПРИЧЁМ РАЗНЫЕ
Dialogue: 0,0:07:21.03,0:07:27.79,Caption,,0,0,0,,РЫЧАГИ БЬЮТ ПО РАЗНЫМ ЛЮДЯМ. ВОЕННОМУ КОМАНДОВАНИЮ ВАЖНЫ ПОСТАВКИ И РАЗВЕДДАННЫЕ.
Dialogue: 0,0:07:28.11,0:07:30.99,Caption,,0,0,0,,ФИНАНСОВОМУ БЛОКУ ВАЖНЫ ДЕНЬГИ И ДОСТУП К ЗАПАДНЫМ
Dialogue: 0,0:07:30.99,0:07:34.19,Caption,,0,0,0,,МЕХАНИЗМАМ. ПОЛИТИЧЕСКОЙ ВЕРХУШКЕ ВАЖНЫ ОТНОШЕНИЯ С
Dialogue: 0,0:07:34.19,0:07:37.23,Caption,,0,0,0,,ВАШИНГТОНОМ И МЕЖДУНАРОДНАЯ ЛЕГИТИМНОСТЬ. ЕСЛИ
Dialogue: 0,0:07:37.23,0:07:41.95,Caption,,0,0,0,,ОСЛАБНЕТ ОДНА ОПОРА, ПРОБЛЕМЫ ПОЯВЛЯЮТСЯ НЕ ОБЯЗАТЕЛЬНО У ВСЕХ СРАЗУ. НО
Dialogue: 0,0:07:41.95,0:07:44.27,Caption,,0,0,0,,ЛЮДИ ВНУТРИ СИСТЕМЫ УЖЕ НАЧИНАЮТ СЧИТАТЬ,
Dialogue: 0,0:07:44.51,0:07:46.43,Caption,,0,0,0,,КОГО ИМЕННО ЭТО КОСНЁТСЯ ПЕРВЫМ.
Dialogue: 0,0:07:46.98,0:07:50.03,Caption,,0,0,0,,ТРАМП НЕ ВЛАДЕЕТ ВСЕМИ ЭТИМИ ИНСТРУМЕНТАМИ ЛИЧНО. НО
Dialogue: 0,0:07:50.03,0:07:52.59,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ТЕМ БОЛЕЕ НЕ СПОСОБЕН ОДНИМ ВЫСТУПЛЕНИЕМ
Dialogue: 0,0:07:52.59,0:07:56.59,Caption,,0,0,0,,ЗАМЕНИТЬ ТО, ОТ ЧЕГО ЗАВИСИТ ГОСУДАРСТВЕННАЯ МАШИНА. ПОЭТОМУ
Dialogue: 0,0:07:56.67,0:07:59.79,Caption,,0,0,0,,РАЗГОВОРЫ, БУДТО У ВАШИНГТОНА ВООБЩЕ НЕТ СПОСОБОВ ДАВИТЬ НА
Dialogue: 0,0:07:59.79,0:08:03.79,Caption,,0,0,0,,КИЕВ, ЗВУЧАТ СЛИШКОМ САМОУВЕРЕННО. ВОПРОС В ДРУГОМ КАКОЙ
Dialogue: 0,0:08:03.79,0:08:06.35,Caption,,0,0,0,,РЫЧАГ ТРАМП ДЕЙСТВИТЕЛЬНО ГОТОВ ИСПОЛЬЗОВАТЬ И
Dialogue: 0,0:08:06.35,0:08:08.19,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО ОН ГОТОВ ЗАЙТИ?
Dialogue: 0,0:08:08.40,0:08:10.91,Caption,,0,0,0,,ПОТОМУ ЧТО НАЖАТЬ НА СОЮЗНИКА И ПОТОМ ПРОДОЛЖАТЬ
Dialogue: 0,0:08:10.91,0:08:13.55,Caption,,0,0,0,,ОТНОШЕНИЯ КАК ПРЕЖДЕ ПОЛУЧАЕТСЯ ДАЛЕКО НЕ ВСЕГДА.
Dialogue: 0,0:08:13.75,0:08:16.91,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ТЕПЕРЬ ВОПРОС ЕЩЁ ШИРЕ А
Dialogue: 0,0:08:16.91,0:08:18.91,Caption,,0,0,0,,ЧТО ТРАМП СМОЖЕТ СДЕЛАТЬ С ЕВРОПОЙ?
Dialogue: 0,0:08:19.47,0:08:21.79,Caption,,0,0,0,,ПОСЛЕ ПРОМЕЖУТОЧНЫХ ВЫБОРОВ У ТРАМПА ДОБАВИЛИСЬ
Dialogue: 0,0:08:21.79,0:08:24.83,Caption,,0,0,0,,ВНУТРЕННИЕ ПОЛИТИЧЕСКИЕ ПРОБЛЕМЫ. БРИТАНСКАЯ ПРЕССА
Dialogue: 0,0:08:24.91,0:08:28.03,Caption,,0,0,0,,УЖЕ ОБСУЖДАЕТ УСИЛЕНИЕ ДАВЛЕНИЯ НА КИЕВ. А ЗНАЧИТ,
Dialogue: 0,0:08:28.11,0:08:31.95,Caption,,0,0,0,,ЗАТЯЖНОЙ ПРОЦЕСС, КОТОРЫЙ НЕЛЬЗЯ ПРЕДЪЯВИТЬ ИЗБИРАТЕЛЮ КАК РЕЗУЛЬТАТ,
Dialogue: 0,0:08:32.27,0:08:34.75,Caption,,0,0,0,,СТАНОВИТСЯ ДЛЯ БЕЛОГО ДОМА ВСЁ МЕНЕЕ УДОБНЫМ.
Dialogue: 0,0:08:36.95,0:08:39.43,Caption,,0,0,0,,ТРАМПУ НУЖЕН НЕ ЕЩЁ ОДИН РАУНД ПЕРЕГОВОРОВ,
Dialogue: 0,0:08:39.65,0:08:42.87,Caption,,0,0,0,,А ВЕЩЬ, КОТОРУЮ МОЖНО ПОЛОЖИТЬ НА СТОЛ И НАЗВАТЬ СВОЕЙ
Dialogue: 0,0:08:42.95,0:08:45.67,Caption,,0,0,0,,ПОБЕДОЙ. И УКРАИНА ЗДЕСЬ ДЛЯ НЕГО НЕ СВЯЩЕННАЯ
Dialogue: 0,0:08:45.67,0:08:50.55,Caption,,0,0,0,,КОРОВА. ЕСЛИ ОН СЧИТАЕТ, ЧТО ДАЛЬНЕЙШЕЕ ПРОТИВОСТОЯНИЕ ПОВЫШАЕТ РИСК ПРЯМОГО
Dialogue: 0,0:08:50.55,0:08:55.19,Caption,,0,0,0,,СТОЛКНОВЕНИЯ РОССИИ И ЗАПАДА, У НЕГО ПОЯВИТСЯ СВОЙ НЕПРИЯТНЫЙ ВОПРОС К ЗЕЛЕНСКОМУ
Dialogue: 0,0:08:55.27,0:08:56.95,Caption,,0,0,0,,А ЧЕРЕЗ ГОД УСЛОВИЯ БУДУТ ЛУЧШЕ?
Dialogue: 0,0:08:57.19,0:08:59.75,Caption,,0,0,0,,ЕЩЁ ГОД МОБИЛИЗАЦИИ, РАЗРУШЕНИЙ,
Dialogue: 0,0:08:59.84,0:09:02.39,Caption,,0,0,0,,РАСХОДОВ И ЗАВИСИМОСТИ ОТ ПОМОЩИ. А ТО И
Dialogue: 0,0:09:02.39,0:09:05.27,Caption,,0,0,0,,ДВА. И ВСЁ ЭТО НА ФОНЕ ПРЕДУПРЕЖДЕНИЯ ЛУКАШЕНКО
Dialogue: 0,0:09:05.35,0:09:08.79,Caption,,0,0,0,,О ТОМ, ЧТО СТАВКИ МОГУТ ПОДНЯТЬСЯ ДО ЯДЕРНОГО УРОВНЯ. ТАК
Dialogue: 0,0:09:08.87,0:09:13.03,Caption,,0,0,0,,ЧТО СПОР УЖЕ НЕ ТОЛЬКО О ТОМ, КАКИЕ УСЛОВИЯ ПЛОХИЕ СЕГОДНЯ. ОН ЕЩЁ И О
Dialogue: 0,0:09:13.03,0:09:16.71,Caption,,0,0,0,,ТОМ, КАКИЕ ВАРИАНТЫ ОСТАНУТСЯ ЗАВТРА. НО ДАЖЕ ЕСЛИ ТРАМП
Dialogue: 0,0:09:16.71,0:09:20.07,Caption,,0,0,0,,ПРОДАВИТ КИЕВ, ЭТОГО ВСЁ РАВНО МАЛО. ПОТОМУ ЧТО ЗА СПИНОЙ
Dialogue: 0,0:09:20.07,0:09:22.87,Caption,,0,0,0,,ЗЕЛЕНСКОГО СТОИТ ЕВРОПА. ОТТУДА ПРОДОЛЖАЮТ ИДТИ
Dialogue: 0,0:09:22.87,0:09:27.27,Caption,,0,0,0,,ДЕНЬГИ И ВООРУЖЕНИЯ, ТАМ ОБСУЖДАЮТ ГАРАНТИИ И БУДУЩИЕ КОНТИНГЕНТЫ,
Dialogue: 0,0:09:27.51,0:09:30.47,Caption,,0,0,0,,НАРАЩИВАЮТ ВОЕННЫЕ БЮДЖЕТЫ. И КИЕВ МОЖЕТ СКАЗАТЬ
Dialogue: 0,0:09:30.47,0:09:32.47,Caption,,0,0,0,,ВАШИНГТОНУ СПАСИБО ЗА ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:09:32.71,0:09:36.79,Caption,,0,0,0,,НО У НАС ЕСТЬ ЕЩЁ ДРУЗЬЯ. ПОЭТОМУ ТРАМПУ НЕДОСТАТОЧНО ПРОДАВИТЬ ОДНУ
Dialogue: 0,0:09:36.79,0:09:39.59,Caption,,0,0,0,,УКРАИНСКУЮ ПОДПИСЬ. ЕСЛИ ЕВРОПЕЙСКИЕ СТОЛИЦЫ
Dialogue: 0,0:09:39.59,0:09:43.99,Caption,,0,0,0,,ПРОДОЛЖАТ ПРЕЖНЮЮ ЛИНИЮ, У КИЕВА ОСТАНЕТСЯ АЛЬТЕРНАТИВА. А ЗНАЧИТ,
Dialogue: 0,0:09:44.23,0:09:47.19,Caption,,0,0,0,,СПОР О ЗАВЕРШЕНИИ КОНФЛИКТА СНОВА УПРЁТСЯ В ТО,
Dialogue: 0,0:09:47.51,0:09:50.07,Caption,,0,0,0,,КТО И КАКИЕ ОБЯЗАТЕЛЬСТВА ГОТОВ БРАТЬ НА СЕБЯ.
Dialogue: 0,0:09:52.34,0:09:55.06,Caption,,0,0,0,,И ТУТ ПОЯВЛЯЕТСЯ КУШНЕР. ПРИЧЁМ ГОВОРИТ ОН УЖЕ
Dialogue: 0,0:09:55.06,0:10:00.18,Caption,,0,0,0,,НЕ ПРОСТО О ПРЕКРАЩЕНИИ ОГНЯ, А О НОВОЙ АРХИТЕКТУРЕ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ТО
Dialogue: 0,0:10:00.18,0:10:03.06,Caption,,0,0,0,,ЕСТЬ СТОЛ ВНЕЗАПНО СТАНОВИТСЯ НАМНОГО ШИРЕ САМОЙ
Dialogue: 0,0:10:03.06,0:10:05.86,Caption,,0,0,0,,УКРАИНЫ. ПОТОМУ ЧТО ПРЕКРАТИТЬ ОГОНЬ НА БУМАГЕ И
Dialogue: 0,0:10:05.86,0:10:08.42,Caption,,0,0,0,,ДОГОВОРИТЬСЯ О ПРАВИЛАХ БЕЗОПАСНОСТИ ПОСЛЕ КОНФЛИКТА
Dialogue: 0,0:10:08.42,0:10:11.70,Caption,,0,0,0,,ВОВСЕ НЕ ОДНА ЗАДАЧА. КТО ДАЁТ УКРАИНЕ ГАРАНТИИ?
Dialogue: 0,0:10:11.95,0:10:14.02,Caption,,0,0,0,,КАКИЕ ОБЯЗАТЕЛЬСТВА СОХРАНЯЮТ США?
Dialogue: 0,0:10:14.32,0:10:17.22,Caption,,0,0,0,,ГДЕ ПРОХОДЯТ ОГРАНИЧЕНИЯ, КОТОРЫХ ТРЕБУЕТ МОСКВА?
Dialogue: 0,0:10:17.68,0:10:20.42,Caption,,0,0,0,,ВОТ ЭТО УЖЕ НЕ ПРЕКРАЩЕНИЕ ОГНЯ. ЭТО ПОПЫТКА
Dialogue: 0,0:10:20.50,0:10:23.38,Caption,,0,0,0,,ДОГОВОРИТЬСЯ О ПРАВИЛАХ ПОСЛЕ НЕГО. ВОТ ЗДЕСЬ
Dialogue: 0,0:10:23.38,0:10:26.34,Caption,,0,0,0,,ИНТЕРЕСЫ РАСХОДЯТСЯ ОСОБЕННО СИЛЬНО. КИЕВУ НУЖНА
Dialogue: 0,0:10:26.34,0:10:29.54,Caption,,0,0,0,,ЗАЩИТА ОТ БУДУЩЕГО ДАВЛЕНИЯ. МОСКВА ХОЧЕТ ЗАКРЕПИТЬ
Dialogue: 0,0:10:29.54,0:10:32.58,Caption,,0,0,0,,СОБСТВЕННЫЕ УСЛОВИЯ БЕЗОПАСНОСТИ. ЕВРОПЕЙЦЫ ХОТЯТ
Dialogue: 0,0:10:32.58,0:10:36.66,Caption,,0,0,0,,УЧАСТВОВАТЬ В РЕШЕНИЯХ, КОТОРЫЕ БУДУТ КАСАТЬСЯ ИХ ГРАНИЦ И АРМИЙ. А
Dialogue: 0,0:10:36.66,0:10:39.06,Caption,,0,0,0,,ВАШИНГТОНУ НУЖНО СОБРАТЬ ВСЁ ЭТО В ОДНУ СДЕЛКУ.
Dialogue: 0,0:10:39.29,0:10:41.46,Caption,,0,0,0,,НЕ СЛУЧАЙНО ТРАМП ЗАГОВОРИЛ О СОГЛАШЕНИИ,
Dialogue: 0,0:10:41.70,0:10:44.66,Caption,,0,0,0,,КОТОРОЕ ВЫХОДИТ ДАЛЕКО ЗА ПРЕДЕЛЫ УКРАИНЫ. И ВОТ
Dialogue: 0,0:10:44.66,0:10:46.66,Caption,,0,0,0,,ЗДЕСЬ У ТРАМПА ПОЯВЛЯЕТСЯ АРГУМЕНТ,
Dialogue: 0,0:10:46.89,0:10:49.22,Caption,,0,0,0,,КОТОРЫЙ В ЕВРОПЕ СЛУШАТЬ ОСОБЕННО НЕПРИЯТНО.
Dialogue: 0,0:10:49.46,0:10:52.42,Caption,,0,0,0,,АМЕРИКА. ЕВРОПА ПОСЛЕДНИЕ ГОДЫ ОЧЕНЬ БОДРО
Dialogue: 0,0:10:52.42,0:10:54.50,Caption,,0,0,0,,РАССКАЗЫВАЕТ О СТРАТЕГИЧЕСКОЙ АВТОНОМИИ.
Dialogue: 0,0:10:54.67,0:10:57.30,Caption,,0,0,0,,ПЕРЕВООРУЖАЕТСЯ, НАРАЩИВАЕТ БЮДЖЕТЫ,
Dialogue: 0,0:10:57.54,0:11:02.18,Caption,,0,0,0,,ЗАКУПАЕТ ТЕХНИКУ, ВСПОМИНАЕТ ПРО СОБСТВЕННЫЕ АРМИИ И ЯДЕРНЫЕ СИЛЫ. ВСЁ
Dialogue: 0,0:11:02.18,0:11:05.46,Caption,,0,0,0,,ВЫГЛЯДИТ СОЛИДНО. ДО ОДНОГО ВОПРОСА. А БЕЗ США?
Dialogue: 0,0:11:07.73,0:11:10.61,Caption,,0,0,0,,ЗА ЕВРОПЕЙСКИМИ ПЛАНАМИ СТОЯТ АМЕРИКАНСКАЯ РАЗВЕДКА,
Dialogue: 0,0:11:10.76,0:11:13.01,Caption,,0,0,0,,ЛОГИСТИКА, ВОЕННОЕ ПРИСУТСТВИЕ,
Dialogue: 0,0:11:13.09,0:11:17.97,Caption,,0,0,0,,ВООРУЖЕНИЕ, БАЗЫ, ЯДЕРНОЕ СДЕРЖИВАНИЕ И ПОЛИТИЧЕСКИЕ ОБЯЗАТЕЛЬСТВА
Dialogue: 0,0:11:17.97,0:11:20.93,Caption,,0,0,0,,ВАШИНГТОНА. СОБСТВЕННЫЕ АРМИИ И ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:11:20.93,0:11:24.13,Caption,,0,0,0,,ЕВРОПА СПОСОБНА УСИЛИВАТЬ. НО УСИЛИВАТЬ СВОЁ И
Dialogue: 0,0:11:24.13,0:11:26.53,Caption,,0,0,0,,НЕМЕДЛЕННО ЗАМЕНИТЬ ВСЮ АМЕРИКАНСКУЮ СИСТЕМУ
Dialogue: 0,0:11:26.53,0:11:29.01,Caption,,0,0,0,,ПОДДЕРЖКИ СОВСЕМ НЕ ОДНО И ТО ЖЕ. И
Dialogue: 0,0:11:29.01,0:11:31.17,Caption,,0,0,0,,ТРАМПУ ДАЖЕ НЕ ОБЯЗАТЕЛЬНО ГРОЗИТЬ ПАЛЬЦЕМ.
Dialogue: 0,0:11:31.34,0:11:33.97,Caption,,0,0,0,,ДОСТАТОЧНО СПРОСИТЬ ХОТИТЕ ПРОДОЛЖАТЬ ПРЕЖНИЙ КУРС?
Dialogue: 0,0:11:34.15,0:11:36.13,Caption,,0,0,0,,ПРОДОЛЖАЙТЕ. ТОЛЬКО ПЕРЕЧИСЛИТЕ,
Dialogue: 0,0:11:36.30,0:11:39.33,Caption,,0,0,0,,ЧТО ИМЕННО ОБЕСПЕЧИТЕ САМИ. ВЫ ЖЕ СТРАТЕГИЧЕСКИ
Dialogue: 0,0:11:39.33,0:11:41.81,Caption,,0,0,0,,АВТОНОМНЫЕ. ГДЕ СОБСТВЕННЫЕ ВОЗМОЖНОСТИ?
Dialogue: 0,0:11:41.81,0:11:45.41,Caption,,0,0,0,,ГДЕ ДЕНЬГИ? ГДЕ ГАРАНТИИ? И КТО БУДЕТ ОБЪЯСНЯТЬ ИЗБИРАТЕЛЮ,
Dialogue: 0,0:11:45.57,0:11:49.89,Caption,,0,0,0,,ЗАЧЕМ ЗА ВСЁ ЭТО ПЛАТИТЬ? ВОТ ТЕПЕРЬ РЕШИТЕЛЬНОСТЬ ПРИХОДИТСЯ ПЕРЕВОДИТЬ ИЗ
Dialogue: 0,0:11:49.89,0:11:51.89,Caption,,0,0,0,,ПРЕСС РЕЛИЗОВ В ВОЕННЫЕ БЮДЖЕТЫ,
Dialogue: 0,0:11:52.05,0:11:56.29,Caption,,0,0,0,,ЛОГИСТИКУ, ПОСТАВКИ И ОБЯЗАТЕЛЬСТВА. ОДНО ДЕЛО ОБЕЩАТЬ КИЕВУ
Dialogue: 0,0:11:56.29,0:12:00.61,Caption,,0,0,0,,ПОДДЕРЖКУ, ЗНАЯ, ЧТО ЗА СПИНОЙ СТОИТ АМЕРИКА. И СОВСЕМ ДРУГОЕ,
Dialogue: 0,0:12:00.85,0:12:03.57,Caption,,0,0,0,,КОГДА ВАШИНГТОН ПЕРЕСТАЁТ ПОДДЕРЖИВАТЬ ИМЕННО ТОТ
Dialogue: 0,0:12:03.57,0:12:06.93,Caption,,0,0,0,,КУРС, КОТОРЫЙ ПРЕДПОЧИТАЮТ ОТДЕЛЬНЫЕ ЕВРОПЕЙСКИЕ СТОЛИЦЫ.
Dialogue: 0,0:12:07.17,0:12:10.53,Caption,,0,0,0,,А ДАЛЬШЕ ПОЯВЛЯЕТСЯ РИСК КУДА СЕРЬЁЗНЕЕ. РОССИЯ
Dialogue: 0,0:12:10.53,0:12:13.01,Caption,,0,0,0,,ОСТАЁТСЯ ЯДЕРНОЙ ДЕРЖАВОЙ. ЕСЛИ ПРЯМОЕ
Dialogue: 0,0:12:13.01,0:12:15.41,Caption,,0,0,0,,ПРОТИВОСТОЯНИЕ С ЗАПАДОМ ВЫЙДЕТ ЗА ОПРЕДЕЛЁННУЮ
Dialogue: 0,0:12:15.41,0:12:19.89,Caption,,0,0,0,,ЧЕРТУ, УДОБНОГО СЦЕНАРИЯ, В КОТОРОМ РАКЕТЫ ЗАКАНЧИВАЮТСЯ К УЖИНУ И ВСЕ
Dialogue: 0,0:12:19.89,0:12:21.81,Caption,,0,0,0,,РАСХОДЯТСЯ ПО ДОМАМ, НЕ БУДЕТ.
Dialogue: 0,0:12:24.09,0:12:26.57,Caption,,0,0,0,,ВОТ НА ЭТОМ ПРОТИВОРЕЧИИ ТРАМП И МОЖЕТ СТРОИТЬ
Dialogue: 0,0:12:26.57,0:12:29.69,Caption,,0,0,0,,ДАВЛЕНИЕ. ЕВРОПА ХОЧЕТ УЧАСТВОВАТЬ В РЕШЕНИИ СУДЬБЫ
Dialogue: 0,0:12:29.69,0:12:33.13,Caption,,0,0,0,,УКРАИНЫ, НО ДЛЯ ПРОДОЛЖЕНИЯ ПРЕЖНЕЙ ЛИНИИ ЕЙ ПО ПРЕЖНЕМУ
Dialogue: 0,0:12:33.13,0:12:36.65,Caption,,0,0,0,,НУЖНЫ ВОЗМОЖНОСТИ США. И ЕСЛИ ВАШИНГТОН ПЕРЕСМОТРИТ
Dialogue: 0,0:12:36.65,0:12:40.49,Caption,,0,0,0,,СОБСТВЕННУЮ ПОДДЕРЖКУ, БРЮССЕЛЮ ПРИДЁТСЯ РЕШАТЬ НЕ ТЕОРЕТИЧЕСКИЙ,
Dialogue: 0,0:12:40.73,0:12:43.69,Caption,,0,0,0,,А ВПОЛНЕ ПРИЗЕМЛЁННЫЙ ВОПРОС ЧЕМ ИМЕННО ЗАМЕНИТЬ
Dialogue: 0,0:12:43.69,0:12:48.01,Caption,,0,0,0,,АМЕРИКАНСКОЕ УЧАСТИЕ? И ВОТ ТЕПЕРЬ АБУ ДАБИ ВЫГЛЯДИТ СОВСЕМ ИНАЧЕ.
Dialogue: 0,0:12:48.23,0:12:52.09,Caption,,0,0,0,,ТАМ СОБИРАЮТСЯ СТОРОНЫ, КОТОРЫЕ ЕЩЁ НЕДАВНО НЕ МОГЛИ ДОГОВОРИТЬСЯ ДАЖЕ О
Dialogue: 0,0:12:52.09,0:12:54.81,Caption,,0,0,0,,ПОРЯДКЕ ВЗАИМНЫХ УСТУПОК. А РЕЧЬ УЖЕ ИДЁТ НЕ
Dialogue: 0,0:12:54.81,0:12:58.81,Caption,,0,0,0,,ТОЛЬКО ОБ УКРАИНЕ, НО И О БУДУЩИХ ПРАВИЛАХ ДЛЯ ЕВРОПЫ. РЕШИТЬ
Dialogue: 0,0:12:58.81,0:13:01.53,Caption,,0,0,0,,ВОПРОС БЕЗ ЕВРОПЕЙЦЕВ ТРУДНО. НО ЕСЛИ КАЖДЫЙ
Dialogue: 0,0:13:01.53,0:13:04.01,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ КАБИНЕТ ПОЛУЧИТ ПРАВО ОСТАНОВИТЬ ВСЮ
Dialogue: 0,0:13:04.01,0:13:07.77,Caption,,0,0,0,,КОНСТРУКЦИЮ, БОЛЬШОЙ СДЕЛКИ ПРОСТО НЕ ПОЛУЧИТСЯ. И ТРАМП ЭТО
Dialogue: 0,0:13:07.77,0:13:10.57,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЕТ. МЕЖДУ ОБЕЩАНИЕМ БОЛЬШОГО
Dialogue: 0,0:13:10.57,0:13:13.45,Caption,,0,0,0,,СОГЛАШЕНИЯ И ЕГО ВЫПОЛНЕНИЕМ ЛЕЖАТ ОБЯЗАТЕЛЬСТВА,
Dialogue: 0,0:13:13.73,0:13:16.81,Caption,,0,0,0,,КОТОРЫЕ КОМУ ТО ПРИДЁТСЯ ПРИНЯТЬ НА СЕБЯ. ГРОМКОГО
Dialogue: 0,0:13:16.81,0:13:19.93,Caption,,0,0,0,,ЗАЯВЛЕНИЯ И КРАСИВОЙ ФОТОГРАФИИ ЗДЕСЬ МАЛО. ЕСЛИ
Dialogue: 0,0:13:19.93,0:13:22.33,Caption,,0,0,0,,ПОСЛЕ НИХ СОХРАНЯТСЯ ПРЕЖНИЕ ПРАВИЛА ИГРЫ,
Dialogue: 0,0:13:22.49,0:13:25.21,Caption,,0,0,0,,ЧЕРЕЗ НЕСКОЛЬКО МЕСЯЦЕВ ВСЁ ПОЕДЕТ ПО СТАРОМУ КРУГУ.
Dialogue: 0,0:13:25.44,0:13:27.93,Caption,,0,0,0,,ЗНАЧИТ, ТРАМПУ НУЖЕН НЕ ТОЛЬКО МОМЕНТ,
Dialogue: 0,0:13:28.17,0:13:31.13,Caption,,0,0,0,,КОГДА ВСЕ КИВАЮТ ПЕРЕД КАМЕРАМИ. ЕМУ НУЖНО ДОБИТЬСЯ
Dialogue: 0,0:13:31.13,0:13:34.25,Caption,,0,0,0,,ТОГО, ЧТОБЫ ПОСЛЕ ВСТРЕЧИ УЧАСТНИКИ НЕ СМОГЛИ ПРОСТО
Dialogue: 0,0:13:34.25,0:13:40.76,Caption,,0,0,0,,ВЕРНУТЬСЯ К ПРЕЖНИМ ПОЗИЦИЯМ. И ЗДЕСЬ НАЧИНАЕТСЯ БОРЬБА УЖЕ ЗА ЦЕНУ СОГЛАШЕНИЯ.
Dialogue: 0,0:13:41.16,0:13:44.12,Caption,,0,0,0,,МОСКВА СВОИ ТРЕБОВАНИЯ ОБОЗНАЧИЛА. КИЕВ НЕ ХОЧЕТ
Dialogue: 0,0:13:44.12,0:13:47.08,Caption,,0,0,0,,БРАТЬ НА СЕБЯ НЕПРИЯТНЫЕ УСТУПКИ. ЕВРОПА НЕ ХОЧЕТ
Dialogue: 0,0:13:47.08,0:13:50.28,Caption,,0,0,0,,ТЕРЯТЬ ВЛИЯНИЕ. ВАШИНГТОН ХОЧЕТ БЫСТРЫЙ РЕЗУЛЬТАТ С
Dialogue: 0,0:13:50.36,0:13:53.32,Caption,,0,0,0,,ФАМИЛИЕЙ ТРАМПА НА ПЕРВОЙ СТРАНИЦЕ. БОЛЬШАЯ СДЕЛКА
Dialogue: 0,0:13:53.40,0:13:56.04,Caption,,0,0,0,,НЕ ПОЯВЛЯЕТСЯ БЕСПЛАТНО. КАЖДЫЙ УЧАСТНИК БУДЕТ
Dialogue: 0,0:13:56.04,0:13:59.08,Caption,,0,0,0,,ПЫТАТЬСЯ ПЕРЕДАТЬ СЧЁТ ДРУГОМУ. И ВОТ ТЕПЕРЬ САМЫЙ
Dialogue: 0,0:13:59.08,0:14:01.56,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС КОГДА НАЧНУТ ВЫСТАВЛЯТЬ СЧЁТ ЗА
Dialogue: 0,0:14:01.64,0:14:04.44,Caption,,0,0,0,,ЭТУ БОЛЬШУЮ СДЕЛКУ, КОМУ ЕГО ПРИНЕСУТ ПЕРВЫМ?
