Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,ТРАМП НАЗЫВАЕТ ПУТИНА ДРУГОМ. ВСТРЕЧАЮТСЯ,
Dialogue: 0,0:00:03.00,0:00:08.12,Caption,,0,0,0,,РАЗГОВАРИВАЮТ, УЛЫБАЮТСЯ, ФОТОГРАФИИ ДЕЛАЮТ. СИ ЦЗИНЬПИН ТОЖЕ ОКАЗЫВАЕТ
Dialogue: 0,0:00:08.12,0:00:11.16,Caption,,0,0,0,,РОССИЙСКОМУ ГОСТЮ ОСОБОЕ ВНИМАНИЕ. КРАСОТА,
Dialogue: 0,0:00:11.32,0:00:14.76,Caption,,0,0,0,,ДРУЖБА НАРОДОВ, ХОТЬ ОТКРЫТКИ ПЕЧАТАЙ. ТОЛЬКО ПУТИН,
Dialogue: 0,0:00:14.90,0:00:18.60,Caption,,0,0,0,,КАК СООБЩАЛОСЬ, ПРИВЁЗ С СОБОЙ ЯДЕРНЫЙ ЧЕМОДАНЧИК. ВОТ ТАКАЯ
Dialogue: 0,0:00:18.60,0:00:21.24,Caption,,0,0,0,,ИНТЕРЕСНАЯ ПОЛУЧАЕТСЯ ДРУЖБА. И НА ЭТОМ ФОНЕ
Dialogue: 0,0:00:21.24,0:00:25.08,Caption,,0,0,0,,ПРОЗВУЧАЛО ПРЕДЛОЖЕНИЕ, КОТОРОЕ ЗАСТАВЛЯЕТ СОВСЕМ ИНАЧЕ ПОСМОТРЕТЬ НА
Dialogue: 0,0:00:25.08,0:00:28.12,Caption,,0,0,0,,РАЗГОВОРЫ О ВСЕОБЩЕМ ДОВЕРИИ. ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ
Dialogue: 0,0:00:28.12,0:00:31.08,Caption,,0,0,0,,САМИ ЗАГОЛОВКИ, А ТО, ЧТО ЗА НИМИ СТОИТ,
Dialogue: 0,0:00:31.24,0:00:33.64,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:33.96,0:00:36.68,Caption,,0,0,0,,КОГДА САМОЕ ВАЖНОЕ НАЧИНАЕТСЯ ПОСЛЕ ОФИЦИАЛЬНОЙ
Dialogue: 0,0:00:36.68,0:00:39.00,Caption,,0,0,0,,ЧАСТИ. СИКОРСКИ ВОЗМУТИЛСЯ ТЕМ,
Dialogue: 0,0:00:39.16,0:00:41.96,Caption,,0,0,0,,ЧТО РОССИЯ ВООБЩЕ ОКАЗАЛАСЬ В ТАКОМ ФОРМАТЕ. ПО
Dialogue: 0,0:00:41.96,0:00:44.44,Caption,,0,0,0,,ЕГО ЛОГИКЕ РОССИЯ ЭКОНОМИЧЕСКИЙ КАРЛИК,
Dialogue: 0,0:00:44.68,0:00:46.92,Caption,,0,0,0,,КОТОРОГО ЗАЧЕМ ТО УСАДИЛИ РЯДОМ С США И
Dialogue: 0,0:00:46.92,0:00:49.80,Caption,,0,0,0,,КИТАЕМ И ТЕМ САМЫМ ИСКУССТВЕННО ПОДНЯЛИ ДО УРОВНЯ
Dialogue: 0,0:00:49.80,0:00:54.84,Caption,,0,0,0,,МИРОВОЙ СВЕРХДЕРЖАВЫ. ХОРОШО. ТОГДА ДАВАЙТЕ СОВСЕМ ПРОСТО. ЕСЛИ ЕВРОПА
Dialogue: 0,0:00:54.84,0:00:58.28,Caption,,0,0,0,,ТАКОЙ ЭКОНОМИЧЕСКИЙ МОНСТР, ПОЧЕМУ С КАРЛИКОМ РАЗГОВАРИВАЮТ,
Dialogue: 0,0:00:58.36,0:01:01.00,Caption,,0,0,0,,А С МОНСТРАМИ НЕТ? МОЖЕТ, РАДОСЛАВ,
Dialogue: 0,0:01:01.16,0:01:04.36,Caption,,0,0,0,,ТЫ ЧТО ТО ПЕРЕПУТАЛ? ПОТОМУ ЧТО ЗА СТОЛОМ СИДЕЛИ РОССИЯ,
Dialogue: 0,0:01:04.44,0:01:07.24,Caption,,0,0,0,,США И КИТАЙ. А ЕВРОПА СМОТРЕЛА НА ВСЁ
Dialogue: 0,0:01:07.24,0:01:11.72,Caption,,0,0,0,,ЭТО СО СТОРОНЫ И ОБЪЯСНЯЛА, ПОЧЕМУ БЕЗ НЕЁ НЕЛЬЗЯ РЕШАТЬ ЕВРОПЕЙСКИЕ ВОПРОСЫ.
Dialogue: 0,0:01:12.13,0:01:14.76,Caption,,0,0,0,,ЗДЕСЬ СПОР УЖЕ О РЕАЛЬНОМ ВЕСЕ. ДЕНЬГИ ЭТО
Dialogue: 0,0:01:14.76,0:01:17.00,Caption,,0,0,0,,ВЕС. РАЗМЕР ЭКОНОМИКИ ЭТО ВЕС.
Dialogue: 0,0:01:19.27,0:01:21.83,Caption,,0,0,0,,НО ЕСТЬ ЕЩЁ ЯДЕРНОЕ ОРУЖИЕ, АРМИЯ,
Dialogue: 0,0:01:21.94,0:01:26.39,Caption,,0,0,0,,РЕСУРСЫ, ТЕРРИТОРИЯ, ВЛИЯНИЕ НА МИРОВУЮ БЕЗОПАСНОСТЬ И СПОСОБНОСТЬ
Dialogue: 0,0:01:26.39,0:01:29.11,Caption,,0,0,0,,СОРВАТЬ ЛЮБОЕ КРУПНОЕ РЕШЕНИЕ. И ВОТ В ЭТОЙ
Dialogue: 0,0:01:29.11,0:01:31.91,Caption,,0,0,0,,ТАБЛИЦЕ РОССИЯ ВНЕЗАПНО УЖЕ НЕ ВЫГЛЯДИТ КАРЛИКОМ,
Dialogue: 0,0:01:32.15,0:01:34.47,Caption,,0,0,0,,КАК БЫ СИКОРСКОМУ НИ ХОТЕЛОСЬ ИЗМЕРЯТЬ ВСЁ ОДНИМ
Dialogue: 0,0:01:34.47,0:01:37.35,Caption,,0,0,0,,КОШЕЛЬКОМ. ПРИЧЁМ РЮТТЕ В ЭТОМ МЕСТЕ СКАЗАЛ ДОВОЛЬНО
Dialogue: 0,0:01:37.35,0:01:39.75,Caption,,0,0,0,,НЕПРИЯТНУЮ ДЛЯ ЕВРОПЕЙСКИХ ОБИЖЕННЫХ ВЕЩЬ.
Dialogue: 0,0:01:39.94,0:01:44.39,Caption,,0,0,0,,ПЕРЕГОВОРЫ РОССИИ, США И КИТАЯ ОН НАЗВАЛ НОРМАЛЬНЫМ И НЕОБХОДИМЫМ
Dialogue: 0,0:01:44.47,0:01:48.31,Caption,,0,0,0,,ЯВЛЕНИЕМ. ПОЧЕМУ? ПОТОМУ ЧТО ЭТО КРУПНЕЙШИЕ ЯДЕРНЫЕ ДЕРЖАВЫ,
Dialogue: 0,0:01:48.71,0:01:51.03,Caption,,0,0,0,,А КИТАЙ БЫСТРО НАРАЩИВАЕТ СВОЙ СТРАТЕГИЧЕСКИЙ
Dialogue: 0,0:01:51.03,0:01:53.67,Caption,,0,0,0,,ПОТЕНЦИАЛ. ТО ЕСТЬ ДАЖЕ ГЛАВА НАТО НЕ СТАЛ
Dialogue: 0,0:01:53.67,0:01:56.47,Caption,,0,0,0,,ИЗОБРАЖАТЬ ИЗ СЕБЯ ЧЕЛОВЕКА, КОТОРЫЙ НЕ ПОНИМАЕТ,
Dialogue: 0,0:01:56.55,0:01:59.83,Caption,,0,0,0,,ЗАЧЕМ ЭТИ ТРОЕ ВООБЩЕ РАЗГОВАРИВАЮТ. ДО НАСТОЯЩЕЙ
Dialogue: 0,0:01:59.91,0:02:02.31,Caption,,0,0,0,,ЯЛТЫ ДВА НОЛЬ ДЕЛО НЕ ДОШЛО. МИР НИКТО
Dialogue: 0,0:02:02.39,0:02:05.59,Caption,,0,0,0,,НЕ ПОДЕЛИЛ, ГРАНИЦЫ СФЕР ВЛИЯНИЯ НЕ НАРИСОВАЛ,
Dialogue: 0,0:02:05.78,0:02:08.39,Caption,,0,0,0,,НОВУЮ КАРТУ НА СТОЛЕ НЕ РАЗЛОЖИЛ. ТАК ЧТО
Dialogue: 0,0:02:08.39,0:02:11.27,Caption,,0,0,0,,ОБЪЯВЛЯТЬ, ЧТО ВСЁ УЖЕ РЕШЕНО И ВСЕМ ОСТАЛЬНЫМ ОСТАЛОСЬ
Dialogue: 0,0:02:11.35,0:02:15.99,Caption,,0,0,0,,ТОЛЬКО РАСПИСАТЬСЯ, БЫЛО БЫ СЛИШКОМ РАНО. НО НАМЁТКИ ПОЯВИЛИСЬ. ПРИЧЁМ
Dialogue: 0,0:02:16.07,0:02:18.23,Caption,,0,0,0,,ПОЯВИЛИСЬ НЕ НА УРОВНЕ КРАСИВЫХ ФОТОГРАФИЙ,
Dialogue: 0,0:02:18.63,0:02:23.03,Caption,,0,0,0,,А НА УРОВНЕ ТЕМ, КОТОРЫЕ ТРОЕ РЕШИЛИ ВЫНЕСТИ В ОБЩИЙ ДОКУМЕНТ. ПЕРВЫЙ
Dialogue: 0,0:02:23.11,0:02:25.27,Caption,,0,0,0,,ПУНКТ ВООБЩЕ ПРЕКРАСЕН. РОССИЯ,
Dialogue: 0,0:02:25.36,0:02:28.63,Caption,,0,0,0,,США И КИТАЙ ЗАЯВЛЯЮТ О НЕОБХОДИМОСТИ РЕФОРМИРОВАТЬ
Dialogue: 0,0:02:28.63,0:02:32.07,Caption,,0,0,0,,ООН. СТОП. А ГДЕ ФРАНЦИЯ? ГДЕ ВЕЛИКОБРИТАНИЯ?
Dialogue: 0,0:02:34.35,0:02:37.07,Caption,,0,0,0,,ЭТО ВЕДЬ НЕ СЛУЧАЙНЫЕ ПРОХОЖИЕ ВОЗЛЕ ЗДАНИЯ ООН.
Dialogue: 0,0:02:37.39,0:02:40.03,Caption,,0,0,0,,ЭТО ДВА ПОСТОЯННЫХ ЧЛЕНА СОВЕТА БЕЗОПАСНОСТИ С
Dialogue: 0,0:02:40.03,0:02:43.55,Caption,,0,0,0,,ПРАВОМ ВЕТО. ВСЕГО ТАКИХ ГОСУДАРСТВ ПЯТЬ. И ТРОЕ
Dialogue: 0,0:02:43.55,0:02:46.35,Caption,,0,0,0,,ИЗ ПЯТИ ОБСУЖДАЮТ РЕФОРМУ ОРГАНИЗАЦИИ БЕЗ ДВУХ
Dialogue: 0,0:02:46.35,0:02:49.87,Caption,,0,0,0,,ОСТАЛЬНЫХ. ВОТ ВАМ СНОВА КАРЛИКИ И МОНСТРЫ. РОССИЯ
Dialogue: 0,0:02:49.87,0:02:54.19,Caption,,0,0,0,,У СИКОРСКОГО КАРЛИК, НО КАРЛИК УЧАСТВУЕТ. ФРАНЦИЯ И БРИТАНИЯ ВХОДЯТ В
Dialogue: 0,0:02:54.19,0:02:56.67,Caption,,0,0,0,,ТОТ ЖЕ САМЫЙ ПРИВИЛЕГИРОВАННЫЙ КЛУБ ПОСТОЯННЫХ
Dialogue: 0,0:02:56.75,0:03:00.59,Caption,,0,0,0,,ЧЛЕНОВ СОВБЕЗА, НО РАЗГОВОР О РЕФОРМЕ ПРОХОДИТ БЕЗ НИХ. МЕСТА
Dialogue: 0,0:03:00.67,0:03:04.11,Caption,,0,0,0,,У НИХ ПОСТОЯННЫЕ. ПРАВО ВЕТО ПОСТОЯННОЕ. А ВОТ
Dialogue: 0,0:03:04.11,0:03:06.67,Caption,,0,0,0,,МЕСТО ЗА КОНКРЕТНЫМ СТОЛОМ, КАК ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:03:06.87,0:03:09.79,Caption,,0,0,0,,СОВСЕМ НЕ ПОСТОЯННОЕ. И ЗДЕСЬ УЖЕ ВОПРОС ГОРАЗДО
Dialogue: 0,0:03:09.79,0:03:12.59,Caption,,0,0,0,,ШИРЕ ЕВРОПЕЙСКОЙ ОБИДЫ. ЕСЛИ ТРИ ГОСУДАРСТВА
Dialogue: 0,0:03:12.59,0:03:15.23,Caption,,0,0,0,,НАЧИНАЮТ ОБСУЖДАТЬ, КАКОЙ ДОЛЖНА БЫТЬ ООН,
Dialogue: 0,0:03:15.47,0:03:17.39,Caption,,0,0,0,,КАК ОНА ДОЛЖНА РАБОТАТЬ И НА ЧТО ДОЛЖНА
Dialogue: 0,0:03:17.39,0:03:20.67,Caption,,0,0,0,,РЕАГИРОВАТЬ, ЭТО ПРЯМОЙ ВЫЗОВ СТАРОЙ ПРИВЫЧКЕ СЧИТАТЬ,
Dialogue: 0,0:03:20.83,0:03:23.63,Caption,,0,0,0,,ЧТО ФОРМАЛЬНЫЙ СТАТУС АВТОМАТИЧЕСКИ ГАРАНТИРУЕТ
Dialogue: 0,0:03:23.63,0:03:26.43,Caption,,0,0,0,,РЕАЛЬНОЕ ВЛИЯНИЕ. НЕ ГАРАНТИРУЕТ. МОЖНО
Dialogue: 0,0:03:26.43,0:03:28.35,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯМИ СИДЕТЬ В СОВБЕЗЕ,
Dialogue: 0,0:03:28.66,0:03:30.99,Caption,,0,0,0,,ИМЕТЬ ПРАВО ВЕТО И ВСЁ РАВНО ОБНАРУЖИТЬ,
Dialogue: 0,0:03:31.14,0:03:34.19,Caption,,0,0,0,,ЧТО ВАЖНЫЙ РАЗГОВОР НАЧАЛСЯ БЕЗ ТЕБЯ. СЛЕДУЮЩИЙ
Dialogue: 0,0:03:34.27,0:03:37.23,Caption,,0,0,0,,ПУНКТ ЕЩЁ ИНТЕРЕСНЕЕ. ТРОЕ ОТДЕЛЬНО ЗАГОВОРИЛИ О
Dialogue: 0,0:03:37.23,0:03:41.23,Caption,,0,0,0,,ГОСУДАРСТВЕННОМ СУВЕРЕНИТЕТЕ, ИММУНИТЕТАХ ОФИЦИАЛЬНЫХ ЛИЦ И О ТОМ,
Dialogue: 0,0:03:41.47,0:03:44.27,Caption,,0,0,0,,ЧТО МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ СУД И ПОХОЖИЕ СТРУКТУРЫ
Dialogue: 0,0:03:44.51,0:03:46.99,Caption,,0,0,0,,НЕ ДОЛЖНЫ ЗЛОУПОТРЕБЛЯТЬ СВОИМИ ПОЛНОМОЧИЯМИ.
Dialogue: 0,0:03:49.27,0:03:52.07,Caption,,0,0,0,,ВОТ ЗДЕСЬ И ПОЯВЛЯЕТСЯ ТО, О ЧЁМ ГОВОРИЛ ТРАМП,
Dialogue: 0,0:03:52.22,0:03:54.23,Caption,,0,0,0,,КРИТИКУЯ НАДГОСУДАРСТВЕННЫЕ СТРУКТУРЫ,
Dialogue: 0,0:03:54.54,0:03:57.27,Caption,,0,0,0,,КОТОРЫЕ НАЧИНАЮТ ЖИТЬ СВОЕЙ ЖИЗНЬЮ И КОМАНДОВАТЬ
Dialogue: 0,0:03:57.27,0:04:01.19,Caption,,0,0,0,,ГОСУДАРСТВАМИ ТАК, БУДТО САМИ ГОСУДАРСТВА СУЩЕСТВУЮТ УЖЕ ДЛЯ ИХ
Dialogue: 0,0:04:01.27,0:04:04.31,Caption,,0,0,0,,УДОБСТВА. ОЧЕНЬ УДОБНАЯ СИСТЕМА. ГОСУДАРСТВА
Dialogue: 0,0:04:04.31,0:04:06.95,Caption,,0,0,0,,ВЫБИРАЮТ ПРЕЗИДЕНТОВ И ПРАВИТЕЛЬСТВА. ГРАЖДАНЕ
Dialogue: 0,0:04:06.95,0:04:10.07,Caption,,0,0,0,,ГОЛОСУЮТ. ПАРЛАМЕНТЫ ПРИНИМАЮТ ЗАКОНЫ. А ПОТОМ
Dialogue: 0,0:04:10.07,0:04:13.51,Caption,,0,0,0,,ВОЗНИКАЕТ НАДСТРОЙКА, КОТОРАЯ ОБЪЯСНЯЕТ ИЗБРАННЫМ ВЛАСТЯМ,
Dialogue: 0,0:04:13.59,0:04:17.67,Caption,,0,0,0,,ЧТО ИМ МОЖНО, ЧТО НЕЛЬЗЯ И КОГО СЕГОДНЯ РАЗРЕШЕНО СЧИТАТЬ ЗАКОННЫМ
Dialogue: 0,0:04:17.67,0:04:20.55,Caption,,0,0,0,,ПАРТНЁРОМ. И В КАКОЙ ТО МОМЕНТ КРУПНЫМ ГОСУДАРСТВАМ
Dialogue: 0,0:04:20.63,0:04:23.51,Caption,,0,0,0,,ЭТО НАЧИНАЕТ НАДОЕДАТЬ. ПРИЧЁМ РАЗДРАЖЕНИЕ ЗДЕСЬ НЕ
Dialogue: 0,0:04:23.59,0:04:26.31,Caption,,0,0,0,,ТОЛЬКО РОССИЙСКОЕ И НЕ ТОЛЬКО АМЕРИКАНСКОЕ. КИТАЙ
Dialogue: 0,0:04:26.39,0:04:28.47,Caption,,0,0,0,,ВООБЩЕ КРАЙНЕ РЕВНИВО ОТНОСИТСЯ К ВОПРОСУ
Dialogue: 0,0:04:28.47,0:04:30.95,Caption,,0,0,0,,СУВЕРЕНИТЕТА. ДЛЯ ПЕКИНА САМА ИДЕЯ,
Dialogue: 0,0:04:31.19,0:04:33.83,Caption,,0,0,0,,ЧТО КАКАЯ ТО ВНЕШНЯЯ СТРУКТУРА МОЖЕТ ПОЛУЧИТЬ ПРАВО
Dialogue: 0,0:04:33.83,0:04:36.23,Caption,,0,0,0,,ВМЕШИВАТЬСЯ В ЧУВСТВИТЕЛЬНЫЕ ВНУТРЕННИЕ ВОПРОСЫ,
Dialogue: 0,0:04:36.63,0:04:39.19,Caption,,0,0,0,,ЗВУЧИТ ПРИМЕРНО КАК ПРИГЛАШЕНИЕ ЧУЖОГО ЧЕЛОВЕКА
Dialogue: 0,0:04:39.19,0:04:41.59,Caption,,0,0,0,,ПОРЫТЬСЯ У ВАС ДОМА В ШКАФУ. СПАСИБО,
Dialogue: 0,0:04:41.67,0:04:45.11,Caption,,0,0,0,,НЕ НАДО. В ПЕРЕВОДЕ НА НОРМАЛЬНЫЙ ЯЗЫК ЭТО ТЕ САМЫЕ
Dialogue: 0,0:04:45.19,0:04:47.19,Caption,,0,0,0,,ОФИГЕВШИЕ ГЛОБАЛИСТИЧЕСКИЕ НАДСТРОЙКИ,
Dialogue: 0,0:04:47.43,0:04:49.59,Caption,,0,0,0,,НАДГОСУДАРСТВЕННЫЕ И УЖЕ ПОЧТИ НИКЕМ НЕ
Dialogue: 0,0:04:49.59,0:04:52.39,Caption,,0,0,0,,КОНТРОЛИРУЕМЫЕ. МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ СУД ЗАВТРА
Dialogue: 0,0:04:52.47,0:04:54.95,Caption,,0,0,0,,ОТ ЭТОГО НЕ ИСЧЕЗНЕТ. НО СРАЗУ ТРИ ДЕРЖАВЫ
Dialogue: 0,0:04:54.95,0:04:56.79,Caption,,0,0,0,,ОБОЗНАЧИЛИ ОБЩИЙ РАЗДРАЖИТЕЛЬ.
Dialogue: 0,0:04:58.99,0:05:01.71,Caption,,0,0,0,,НАДГОСУДАРСТВЕННЫЕ СТРУКТУРЫ НЕ ДОЛЖНЫ ПРЕВРАЩАТЬСЯ
Dialogue: 0,0:05:01.79,0:05:04.59,Caption,,0,0,0,,В НАЧАЛЬСТВО НАД ГОСУДАРСТВАМИ. И ТУТ ЕВРОПА СНОВА
Dialogue: 0,0:05:04.59,0:05:07.07,Caption,,0,0,0,,ПОПАДАЕТ В НЕУДОБНОЕ ПОЛОЖЕНИЕ. ПОТОМУ ЧТО
Dialogue: 0,0:05:07.07,0:05:09.79,Caption,,0,0,0,,ЗНАЧИТЕЛЬНАЯ ЧАСТЬ СОВРЕМЕННОЙ ЕВРОПЕЙСКОЙ ПОЛИТИКИ
Dialogue: 0,0:05:10.18,0:05:12.75,Caption,,0,0,0,,КАК РАЗ ПОСТРОЕНА НА ПЕРЕДАЧЕ ОГРОМНОГО КОЛИЧЕСТВА
Dialogue: 0,0:05:12.75,0:05:14.91,Caption,,0,0,0,,ПОЛНОМОЧИЙ НАВЕРХ. В БРЮССЕЛЬ,
Dialogue: 0,0:05:15.15,0:05:20.27,Caption,,0,0,0,,В ОБЩЕЕВРОПЕЙСКИЕ ОРГАНЫ, В НАДНАЦИОНАЛЬНЫЕ МЕХАНИЗМЫ. А РЯДОМ ТРИ КРУПНЕЙШИХ
Dialogue: 0,0:05:20.27,0:05:22.91,Caption,,0,0,0,,ИГРОКА НАЧИНАЮТ ГОВОРИТЬ В ПРОТИВОПОЛОЖНУЮ СТОРОНУ.
Dialogue: 0,0:05:23.36,0:05:26.03,Caption,,0,0,0,,СУВЕРЕНИТЕТ ГОСУДАРСТВА ДОЛЖЕН ОСТАВАТЬСЯ ОСНОВОЙ.
Dialogue: 0,0:05:26.35,0:05:28.75,Caption,,0,0,0,,СИКОРСКИ МОЖЕТ СКОЛЬКО УГОДНО СЧИТАТЬ РОССИЙСКУЮ
Dialogue: 0,0:05:28.75,0:05:31.15,Caption,,0,0,0,,ЭКОНОМИКУ СЛИШКОМ МАЛЕНЬКОЙ ДЛЯ БОЛЬШОГО СТОЛА.
Dialogue: 0,0:05:31.57,0:05:34.03,Caption,,0,0,0,,ТОЛЬКО ЕСЛИ ЗА ЭТИМ СТОЛОМ ОБСУЖДАЮТ ИМЕННО ТО,
Dialogue: 0,0:05:34.27,0:05:36.59,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО МОГУТ ЗАХОДИТЬ МЕЖДУНАРОДНЫЕ
Dialogue: 0,0:05:36.59,0:05:40.03,Caption,,0,0,0,,СТРУКТУРЫ, ТО РАЗМЕР ВВП УЖЕ НЕ ЕДИНСТВЕННЫЙ БИЛЕТ НА
Dialogue: 0,0:05:40.03,0:05:43.15,Caption,,0,0,0,,ВХОД. ЕВРОПА ПРИ ЭТОМ САМА НЕ ДЕМОНСТРИРУЕТ ОСОБОГО
Dialogue: 0,0:05:43.15,0:05:45.79,Caption,,0,0,0,,ЕДИНСТВА. ФРЕДЕРИКСЕН ТРЕБУЕТ НЕ ПРИНИМАТЬ
Dialogue: 0,0:05:45.79,0:05:48.11,Caption,,0,0,0,,РОССИЙСКИЕ УСЛОВИЯ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:05:48.41,0:05:51.55,Caption,,0,0,0,,СИКОРСКИ ВОЗМУЩЁН САМИМ ФОРМАТОМ. РЮТТЕ ГОВОРИТ,
Dialogue: 0,0:05:51.70,0:05:53.95,Caption,,0,0,0,,ЧТО ВСТРЕЧА НОРМАЛЬНА. ФРАНЦИЯ,
Dialogue: 0,0:05:54.04,0:05:56.99,Caption,,0,0,0,,ГЕРМАНИЯ И ВЕЛИКОБРИТАНИЯ ПАРАЛЛЕЛЬНО ОБСУЖДАЮТ
Dialogue: 0,0:05:56.99,0:05:59.63,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ПРЯМЫХ КОНТАКТОВ С МОСКВОЙ. ТО ЕСТЬ
Dialogue: 0,0:05:59.65,0:06:02.83,Caption,,0,0,0,,ОБЩИЙ ХОР ОПЯТЬ ПОЛУЧИЛСЯ ЗАМЕЧАТЕЛЬНЫЙ. ОДИН УЖЕ
Dialogue: 0,0:06:02.83,0:06:06.27,Caption,,0,0,0,,ЗАПЕЛ, ВТОРОЙ ЕЩЁ ИЩЕТ НОТЫ, ТРЕТИЙ СПРАШИВАЕТ,
Dialogue: 0,0:06:06.39,0:06:08.83,Caption,,0,0,0,,КТО ВООБЩЕ ДИРИЖЁР. И ВЕДЬ МОСКВА ГОВОРИТ НЕ
Dialogue: 0,0:06:08.91,0:06:14.72,Caption,,0,0,0,,ТОЛЬКО ОБ УКРАИНЕ. ПУТИН ПРЯМО ВЫНОСИТ НА СТОЛ РОССИЙСКИЕ ТРЕБОВАНИЯ К
Dialogue: 0,0:06:14.72,0:06:17.44,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. А ФРЕДЕРИКСЕН САМА
Dialogue: 0,0:06:17.44,0:06:20.56,Caption,,0,0,0,,ПРИЗНАЁТ, ЧТО ЭТИ ТРЕБОВАНИЯ ГОРАЗДО ШИРЕ УКРАИНСКОГО
Dialogue: 0,0:06:20.56,0:06:24.80,Caption,,0,0,0,,КОНФЛИКТА. ВОТ ЗДЕСЬ ВСЁ СТАНОВИТСЯ НА СВОИ МЕСТА. ДОНБАСС
Dialogue: 0,0:06:24.88,0:06:27.12,Caption,,0,0,0,,ОСТАЁТСЯ ТЯЖЁЛЫМ И ПРИНЦИПИАЛЬНЫМ ВОПРОСОМ,
Dialogue: 0,0:06:27.44,0:06:29.92,Caption,,0,0,0,,НО СПОР ИДЁТ НЕ ТОЛЬКО О ДОНБАССЕ. РОССИЯ
Dialogue: 0,0:06:29.92,0:06:33.04,Caption,,0,0,0,,МНОГО ЛЕТ УПИРАЕТСЯ В БОЛЕЕ ШИРОКИЙ ВОПРОС. ГДЕ
Dialogue: 0,0:06:33.04,0:06:36.16,Caption,,0,0,0,,БУДЕТ ВОЕННАЯ ИНФРАСТРУКТУРА НАТО. КАКИЕ СТРАНЫ
Dialogue: 0,0:06:36.24,0:06:38.48,Caption,,0,0,0,,БУДУТ ВТЯНУТЫ В НЕЁ ГЛУБЖЕ. ЧТО БУДЕТ С
Dialogue: 0,0:06:38.48,0:06:43.20,Caption,,0,0,0,,РАКЕТАМИ, БАЗАМИ, ВОЙСКАМИ И СРЕДСТВАМИ ПОРАЖЕНИЯ. УКРАИНА В ЭТОЙ
Dialogue: 0,0:06:43.20,0:06:47.60,Caption,,0,0,0,,ИСТОРИИ ОГРОМНЫЙ КУСОК, НО ВСЁ РАВНО КУСОК. ПОЭТОМУ ПОСЛЕ ЛЮБЫХ РАЗГОВОРОВ
Dialogue: 0,0:06:47.68,0:06:50.24,Caption,,0,0,0,,О ТЕРРИТОРИЯХ СПОР НЕ ЗАКАНЧИВАЕТСЯ. ОН ПРОСТО
Dialogue: 0,0:06:50.24,0:06:53.36,Caption,,0,0,0,,ПЕРЕХОДИТ НА СЛЕДУЮЩИЙ ЭТАЖ. И ВОТ ЕВРОПЕЙЦАМ ЭТО
Dialogue: 0,0:06:53.36,0:06:56.08,Caption,,0,0,0,,ОСОБЕННО НЕПРИЯТНО. ПОТОМУ ЧТО ЕСЛИ РАЗГОВОР ИДЁТ О
Dialogue: 0,0:06:56.08,0:07:01.12,Caption,,0,0,0,,БЕЗОПАСНОСТИ ВСЕЙ ЕВРОПЫ, ОНИ СЧИТАЮТ СЕБЯ ЕСТЕСТВЕННЫМИ УЧАСТНИКАМИ. ЛОГИЧНО.
Dialogue: 0,0:07:01.36,0:07:04.80,Caption,,0,0,0,,ТОЛЬКО У КРУПНЕЙШИХ ДЕРЖАВ СВОЯ ЛОГИКА. СНАЧАЛА ТЕ,
Dialogue: 0,0:07:04.96,0:07:07.36,Caption,,0,0,0,,У КОГО ЕСТЬ ВОЗМОЖНОСТЬ ГАРАНТИРОВАТЬ ИЛИ РАЗРУШИТЬ
Dialogue: 0,0:07:07.44,0:07:11.76,Caption,,0,0,0,,СТРАТЕГИЧЕСКУЮ СТАБИЛЬНОСТЬ, ДОГОВАРИВАЮТСЯ МЕЖДУ СОБОЙ. А ЕСЛИ ДОГОВОРЯТСЯ ПО
Dialogue: 0,0:07:11.76,0:07:15.12,Caption,,0,0,0,,КРУПНОМУ, НА ВОЗМУЩЕНИЕ ОСТАЛЬНЫХ ОНИ ПРОСТО ЧИХАТЬ ХОТЕЛИ.
Dialogue: 0,0:07:15.44,0:07:18.40,Caption,,0,0,0,,ПОТОМ УЖЕ НАЧИНАЕТСЯ РАЗГОВОР С ОСТАЛЬНЫМИ. МЫ ЭТО
Dialogue: 0,0:07:18.48,0:07:21.36,Caption,,0,0,0,,УЖЕ ВИДЕЛИ В ИСТОРИИ. НО ПОЛНОЦЕННОЙ ЯЛТЫ СЕЙЧАС
Dialogue: 0,0:07:21.44,0:07:24.72,Caption,,0,0,0,,НЕ ПРОИЗОШЛО. И ХОРОШО, ЧТО НЕ НАДО ПРИДУМЫВАТЬ ЛИШНЕГО.
Dialogue: 0,0:07:27.00,0:07:30.28,Caption,,0,0,0,,ИНТЕРЕСНЕЕ ДРУГОЕ. ТРОЕ УЖЕ НАЧАЛИ ОБОЗНАЧАТЬ ТЕМЫ,
Dialogue: 0,0:07:30.60,0:07:33.48,Caption,,0,0,0,,ПО КОТОРЫМ ГОТОВЫ ИСКАТЬ ОБЩИЕ ПРАВИЛА. ООН,
Dialogue: 0,0:07:33.71,0:07:36.12,Caption,,0,0,0,,СУВЕРЕНИТЕТ, МЕЖДУНАРОДНЫЕ СУДЫ,
Dialogue: 0,0:07:36.20,0:07:40.28,Caption,,0,0,0,,ЭНЕРГЕТИКА, ЯДЕРНЫЕ РИСКИ. ЭТО УЖЕ НЕ ПРОСТО РАЗГОВОР О ТОМ,
Dialogue: 0,0:07:40.60,0:07:43.00,Caption,,0,0,0,,КОМУ КАКОЙ РАЙОН ДОСТАНЕТСЯ НА КАРТЕ УКРАИНЫ.
Dialogue: 0,0:07:43.23,0:07:47.00,Caption,,0,0,0,,КСТАТИ, ЭНЕРГЕТИКА В ДЕКЛАРАЦИИ ВЫГЛЯДИТ ПОЧТИ СМЕШНО. СИДЯТ
Dialogue: 0,0:07:47.08,0:07:49.64,Caption,,0,0,0,,ТРИ ЛИДЕРА, ГОВОРЯТ О МИРОВОЙ БЕЗОПАСНОСТИ,
Dialogue: 0,0:07:49.72,0:07:54.76,Caption,,0,0,0,,ЯДЕРНОМ ОРУЖИИ, ООН. И ТУТ ВНЕЗАПНО ПРОДУКТЫ НЕФТЕПЕРЕРАБОТКИ. КАК
Dialogue: 0,0:07:54.76,0:07:57.16,Caption,,0,0,0,,БУДТО КТО ТО В СЕРЕДИНЕ ЗАСЕДАНИЯ ВСПОМНИЛ,
Dialogue: 0,0:07:57.32,0:08:00.68,Caption,,0,0,0,,ЧТО САМОЛЁТЫ САМИ НЕ ЛЕТАЮТ, ЗАВОДЫ САМИ НЕ РАБОТАЮТ,
Dialogue: 0,0:08:00.92,0:08:03.32,Caption,,0,0,0,,А ЭКОНОМИКА БЕЗ ЭНЕРГИИ БЫСТРО СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:08:03.32,0:08:06.12,Caption,,0,0,0,,ФИЛОСОФСКОЙ. НО ДЛЯ ЕВРОПЫ ЭТО СОВСЕМ НЕ МЕЛОЧЬ.
Dialogue: 0,0:08:06.44,0:08:09.16,Caption,,0,0,0,,ГЕРМАНИЯ УЖЕ НЕСКОЛЬКО ЛЕТ ПЛАТИТ ЗА ДОРОГУЮ ЭНЕРГИЮ
Dialogue: 0,0:08:09.16,0:08:12.84,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬЮ, КОНКУРЕНТОСПОСОБНОСТЬЮ И РОСТОМ ЦЕН. И ТУТ
Dialogue: 0,0:08:12.84,0:08:15.88,Caption,,0,0,0,,ВСПОМИНАЕТСЯ ЕЩЁ ОДНА НЕПРИЯТНАЯ МЫСЛЬ. КОЛОНИЯ ХОТЯ
Dialogue: 0,0:08:15.96,0:08:19.24,Caption,,0,0,0,,БЫ ЦЕННА РЕСУРСАМИ. А ЕСЛИ ЕВРОПА ТЕРЯЕТ ДЕШЁВУЮ
Dialogue: 0,0:08:19.24,0:08:22.68,Caption,,0,0,0,,ЭНЕРГИЮ, ЧАСТЬ ПРОМЫШЛЕННОГО ПРЕИМУЩЕСТВА И ПОЛИТИЧЕСКИЙ ВЕС,
Dialogue: 0,0:08:23.00,0:08:25.96,Caption,,0,0,0,,МОЖНО ДОКАТИТЬСЯ ДО ПОЛОЖЕНИЯ ЕЩЁ ХУЖЕ. ПРЕТЕНЗИЙ
Dialogue: 0,0:08:25.96,0:08:29.40,Caption,,0,0,0,,МНОГО, А РЫЧАГОВ ВСЁ МЕНЬШЕ. И КОГДА НЕМЕЦКИЙ МИНИСТР
Dialogue: 0,0:08:29.40,0:08:32.52,Caption,,0,0,0,,ОБЪЯСНЯЕТ ЛЮДЯМ, ЧТО ЧАСТЬ НЫНЕШНИХ ТРУДНОСТЕЙ СВЯЗАНА С
Dialogue: 0,0:08:32.52,0:08:36.44,Caption,,0,0,0,,ПРОТИВОСТОЯНИЕМ С РОССИЕЙ, ЭТО ЗВУЧИТ УЖЕ НЕ КАК АБСТРАКТНЫЙ СПОР О
Dialogue: 0,0:08:36.44,0:08:38.44,Caption,,0,0,0,,ЦЕННОСТЯХ. СЧЁТ ПРИХОДИТ ДОМОЙ.
Dialogue: 0,0:08:40.71,0:08:45.59,Caption,,0,0,0,,В ЭЛЕКТРИЧЕСТВЕ, ОТОПЛЕНИИ, ЦЕНЕ ПРОИЗВОДСТВА И РАБОЧИХ МЕСТАХ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:08:45.83,0:08:48.39,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ДАЛЬШЕ РАЗБИРАТЬ ИМЕННО ТАКИЕ СВЯЗИ.
Dialogue: 0,0:08:48.79,0:08:51.35,Caption,,0,0,0,,ПОТОМУ ЧТО СЕЙЧАС БУДЕТ САМЫЙ ВЕСЁЛЫЙ КУСОК ЭТОЙ
Dialogue: 0,0:08:51.35,0:08:55.51,Caption,,0,0,0,,БОЛЬШОЙ ДРУЖБЫ. СИ ЦЗИНЬПИН ПРЕДЛОЖИЛ ПОЛНОСТЬЮ ОТКАЗАТЬСЯ ОТ
Dialogue: 0,0:08:55.51,0:08:58.55,Caption,,0,0,0,,ЯДЕРНОГО ОРУЖИЯ. КРАСИВОЕ ПРЕДЛОЖЕНИЕ. МИР,
Dialogue: 0,0:08:58.63,0:09:02.55,Caption,,0,0,0,,ГОЛУБИ, ДЕТИ РИСУЮТ СОЛНЦЕ. ТОЛЬКО ЕСТЬ ОДНА МАЛЕНЬКАЯ
Dialogue: 0,0:09:02.55,0:09:05.91,Caption,,0,0,0,,ДЕТАЛЬ. ИЗ ЭТОЙ ТРОИЦЫ ИМЕННО КИТАЙ ОБЛАДАЕТ САМЫМ
Dialogue: 0,0:09:05.91,0:09:09.11,Caption,,0,0,0,,МАЛЕНЬКИМ ЯДЕРНЫМ ПОТЕНЦИАЛОМ. МОЯ ВЕРСИЯ ПРОСТАЯ.
Dialogue: 0,0:09:09.38,0:09:12.63,Caption,,0,0,0,,КИТАЙ РЕШИЛ СХИТРИТЬ. РОССИЯ И США ДЕСЯТИЛЕТИЯМИ
Dialogue: 0,0:09:12.63,0:09:15.67,Caption,,0,0,0,,НАКОПИЛИ ОГРОМНЫЙ ЯДЕРНЫЙ АРСЕНАЛ И ПОСТРОИЛИ ВОКРУГ
Dialogue: 0,0:09:15.75,0:09:18.23,Caption,,0,0,0,,НЕГО ЗНАЧИТЕЛЬНУЮ ЧАСТЬ СВОЕГО СТРАТЕГИЧЕСКОГО ВЕСА.
Dialogue: 0,0:09:18.63,0:09:20.95,Caption,,0,0,0,,А КИТАЙ ГОВОРИТ ДАВАЙТЕ ВСЁ ЭТО УНИЧТОЖИМ. ВСЕМ
Dialogue: 0,0:09:20.95,0:09:24.23,Caption,,0,0,0,,СРАЗУ. ЧТОБЫ ЧЕСТНО. ПРЕКРАСНО. РОССИЯ И США
Dialogue: 0,0:09:24.31,0:09:26.95,Caption,,0,0,0,,ОБНУЛЯЮТ ОГРОМНОЕ ПРЕИМУЩЕСТВО. КИТАЙ ТОЖЕ
Dialogue: 0,0:09:27.03,0:09:30.79,Caption,,0,0,0,,УНИЧТОЖАЕТ СВОЙ АРСЕНАЛ, ТОЛЬКО ЕГО ПОТЕРИ ОТНОСИТЕЛЬНО ДВУХ ОСТАЛЬНЫХ
Dialogue: 0,0:09:30.79,0:09:33.51,Caption,,0,0,0,,ГОРАЗДО МЕНЬШЕ. А ДАЛЬШЕ ЧТО ОСТАЁТСЯ НА СТОЛЕ?
Dialogue: 0,0:09:33.75,0:09:37.35,Caption,,0,0,0,,ЭКОНОМИКА. ПРОМЫШЛЕННОСТЬ. ПРОИЗВОДСТВО. ТЕХНОЛОГИИ.
Dialogue: 0,0:09:37.63,0:09:40.23,Caption,,0,0,0,,ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ. И ВОТ ЗДЕСЬ КИТАЙ УЖЕ
Dialogue: 0,0:09:40.23,0:09:43.03,Caption,,0,0,0,,СОВСЕМ НЕ БЕДНЫЙ РОДСТВЕННИК. ТО ЕСТЬ ПРЕДЛАГАЕТСЯ
Dialogue: 0,0:09:43.12,0:09:45.75,Caption,,0,0,0,,ОЧЕНЬ ИЗЯЩНЫЙ ОБМЕН. ВЫ УБИРАЕТЕ ТО,
Dialogue: 0,0:09:45.91,0:09:47.99,Caption,,0,0,0,,В ЧЁМ У ВАС ПРЕИМУЩЕСТВО НАД НАМИ. А
Dialogue: 0,0:09:48.07,0:09:49.75,Caption,,0,0,0,,ПОТОМ ДАВАЙТЕ СОРЕВНОВАТЬСЯ В ТОМ,
Dialogue: 0,0:09:49.99,0:09:52.47,Caption,,0,0,0,,ГДЕ У НАС САМИХ ВСЁ ОЧЕНЬ НЕПЛОХО. НУ
Dialogue: 0,0:09:52.47,0:09:54.23,Caption,,0,0,0,,КТО ЖЕ ОТКАЖЕТСЯ ОТ ТАКОЙ КРАСОТЫ.
Dialogue: 0,0:09:56.52,0:09:59.48,Caption,,0,0,0,,И ТУТ САМА СОБОЙ НАПРАШИВАЕТСЯ ИРОНИЯ. ВСЕ ЗА
Dialogue: 0,0:09:59.48,0:10:02.76,Caption,,0,0,0,,ЯДЕРНОЕ РАЗОРУЖЕНИЕ. ОТЛИЧНО. КТО ПЕРВЫЙ ПОНЕСЁТ
Dialogue: 0,0:10:02.76,0:10:06.92,Caption,,0,0,0,,СВОИ РАКЕТЫ НА МЕТАЛЛОЛОМ? ЧТО ТО ОЧЕРЕДЬ НЕ ВЫСТРАИВАЕТСЯ. И ВОТ ТУТ
Dialogue: 0,0:10:06.92,0:10:09.40,Caption,,0,0,0,,ОСОБЕННО ХОРОШО СМОТРИТСЯ ЯДЕРНЫЙ ЧЕМОДАНЧИК,
Dialogue: 0,0:10:09.60,0:10:12.28,Caption,,0,0,0,,КОТОРЫЙ ПУТИН ПРИВЁЗ С СОБОЙ. С ЭТИМИ ДРУЗЬЯМИ
Dialogue: 0,0:10:12.28,0:10:15.00,Caption,,0,0,0,,ЯДЕРНЫЙ ЧЕМОДАНЧИК ЛУЧШЕ ДЕРЖАТЬ РЯДОМ. ТРАМП
Dialogue: 0,0:10:15.00,0:10:18.04,Caption,,0,0,0,,УЛЫБАЕТСЯ. СИ ГОВОРИТ О МИРЕ. ПУТИН ГОВОРИТ О
Dialogue: 0,0:10:18.04,0:10:20.52,Caption,,0,0,0,,СТАБИЛЬНОСТИ. А ЧЕМОДАНЧИК ЕДЕТ ВМЕСТЕ С
Dialogue: 0,0:10:20.52,0:10:24.20,Caption,,0,0,0,,ПРЕЗИДЕНТОМ. НА ЭТОМ ФОНЕ И СООБЩЕНИЯ О САМОЛЁТЕ СУДНОГО
Dialogue: 0,0:10:24.28,0:10:27.00,Caption,,0,0,0,,ДНЯ ВЫГЛЯДЯТ ОЧЕНЬ ПО ЧЕЛОВЕЧЕСКИ. ВСЕ ДРУГ ДРУГУ
Dialogue: 0,0:10:27.00,0:10:30.68,Caption,,0,0,0,,ДРУЗЬЯ. ВСЕ ХОТЯТ МИРА. ВСЕ ГОТОВЫ ГОВОРИТЬ. НО
Dialogue: 0,0:10:30.68,0:10:33.80,Caption,,0,0,0,,СРЕДСТВА НА СЛУЧАЙ, ЕСЛИ ДРУЖБА ВНЕЗАПНО ЗАКОНЧИТСЯ,
Dialogue: 0,0:10:34.14,0:10:37.16,Caption,,0,0,0,,НИКТО ДАЛЕКО НЕ УБИРАЕТ. ТАК ЧТО КИТАЙСКАЯ ХИТРОСТЬ
Dialogue: 0,0:10:37.16,0:10:39.80,Caption,,0,0,0,,НЕ ПРОШЛА. ДА И НЕ ПРОЙДЁТ. РОССИЯ И
Dialogue: 0,0:10:39.80,0:10:44.92,Caption,,0,0,0,,США ПРЕКРАСНО ПОНИМАЮТ, ЧТО ЯДЕРНОЕ ОРУЖИЕ ЭТО НЕ ДОРОГАЯ КОЛЛЕКЦИЯ ЖЕЛЕЗА,
Dialogue: 0,0:10:45.08,0:10:47.08,Caption,,0,0,0,,ОТ КОТОРОЙ МОЖНО ОТКАЗАТЬСЯ РАДИ КРАСИВОЙ
Dialogue: 0,0:10:47.08,0:10:50.12,Caption,,0,0,0,,ФОТОГРАФИИ. ЭТО СТРАХОВКА ПОСЛЕДНЕЙ ИНСТАНЦИИ.
Dialogue: 0,0:10:50.46,0:10:53.00,Caption,,0,0,0,,ОСОБЕННО КОГДА ЗА ОДНИМ СТОЛОМ СИДЯТ ГОСУДАРСТВА,
Dialogue: 0,0:10:53.24,0:10:55.00,Caption,,0,0,0,,КОТОРЫЕ ОДНОВРЕМЕННО ПАРТНЁРЫ,
Dialogue: 0,0:10:55.09,0:10:58.44,Caption,,0,0,0,,КОНКУРЕНТЫ И ПОТЕНЦИАЛЬНЫЕ ПРОТИВНИКИ. И ЗДЕСЬ,
Dialogue: 0,0:10:58.62,0:11:01.64,Caption,,0,0,0,,КСТАТИ, ОЧЕНЬ ХОРОШО ВИДНО НАСТОЯЩЕЕ СОДЕРЖАНИЕ ВСЕЙ
Dialogue: 0,0:11:01.64,0:11:05.40,Caption,,0,0,0,,ВСТРЕЧИ. ТРАМП НАЗЫВАЕТ ПУТИНА ДРУГОМ. СИ ЛИЧНО
Dialogue: 0,0:11:05.40,0:11:08.52,Caption,,0,0,0,,ПРОВОЖАЕТ ПУТИНА. ЗАПАДНЫЕ ЛИДЕРЫ ФОТОГРАФИРУЮТСЯ
Dialogue: 0,0:11:08.60,0:11:10.04,Caption,,0,0,0,,РЯДОМ С РОССИЙСКИМ ПРЕЗИДЕНТОМ,
Dialogue: 0,0:11:10.28,0:11:16.72,Caption,,0,0,0,,А ПОТОМ ОБЪЯСНЯЮТСЯ ДОМА. ВСЕ УЛЫБАЮТСЯ. НО НИ ОДИН СЕРЬЁЗНЫЙ ИГРОК ОТ
Dialogue: 0,0:11:16.72,0:11:19.68,Caption,,0,0,0,,СВОИХ РЫЧАГОВ НЕ ОТКАЗЫВАЕТСЯ. ВОТ ПОЧЕМУ СПОР
Dialogue: 0,0:11:19.68,0:11:23.84,Caption,,0,0,0,,СИКОРСКОГО О ТОМ, ДОСТОИН ЛИ РОССИЙСКИЙ КАРЛИК СИДЕТЬ РЯДОМ С ВЕЛИКИМИ
Dialogue: 0,0:11:23.84,0:11:27.52,Caption,,0,0,0,,ДЕРЖАВАМИ, ЗВУЧИТ НЕМНОГО СМЕШНО. ДОСТОИНСТВО ЗДЕСЬ ВООБЩЕ НИ
Dialogue: 0,0:11:27.60,0:11:29.76,Caption,,0,0,0,,ПРИ ЧЁМ. ЗА ТАКОЙ СТОЛ НЕ ПРИГЛАШАЮТ ЗА
Dialogue: 0,0:11:29.84,0:11:32.56,Caption,,0,0,0,,ХОРОШЕЕ ПОВЕДЕНИЕ И КРАСИВУЮ СТАТИСТИКУ. ТУДА
Dialogue: 0,0:11:32.64,0:11:36.32,Caption,,0,0,0,,ПОПАДАЮТ ТЕ, БЕЗ КОГО ОПРЕДЕЛЁННЫЕ ВОПРОСЫ ПРОСТО НЕ РЕШАЮТСЯ.
Dialogue: 0,0:11:36.52,0:11:39.76,Caption,,0,0,0,,МОЖНО СЧИТАТЬ РОССИЮ БЕДНЕЕ ЕВРОСОЮЗА. ОНА И ЕСТЬ
Dialogue: 0,0:11:39.76,0:11:42.72,Caption,,0,0,0,,БЕДНЕЕ ПО РАЗМЕРУ ЭКОНОМИКИ. МОЖНО СЧИТАТЬ ЕВРОПУ
Dialogue: 0,0:11:42.72,0:11:45.68,Caption,,0,0,0,,КРУПНЕЙШИМ ЭКОНОМИЧЕСКИМ ЦЕНТРОМ. ОНА ИМ И ОСТАЁТСЯ.
Dialogue: 0,0:11:46.16,0:11:48.56,Caption,,0,0,0,,НО ЕСЛИ ВОПРОС КАСАЕТСЯ ЯДЕРНОГО СДЕРЖИВАНИЯ,
Dialogue: 0,0:11:48.65,0:11:53.84,Caption,,0,0,0,,БЕЗОПАСНОСТИ, РЕСУРСОВ, СОВБЕЗА ООН И СПОСОБНОСТИ СОРВАТЬ ЧУЖОЕ РЕШЕНИЕ,
Dialogue: 0,0:11:54.23,0:11:56.88,Caption,,0,0,0,,ТОГДА АРИФМЕТИКА СТАНОВИТСЯ ДРУГОЙ. И ОСОБЕННО
Dialogue: 0,0:11:56.96,0:11:59.60,Caption,,0,0,0,,НЕПРИЯТНО ЭТО ВЫГЛЯДИТ ДЛЯ ФРАНЦИИ И ВЕЛИКОБРИТАНИИ.
Dialogue: 0,0:11:59.89,0:12:02.48,Caption,,0,0,0,,ОНИ ВЕДЬ НЕ ПРОСТО ЕВРОПЕЙСКИЕ ГОСУДАРСТВА. ОНИ
Dialogue: 0,0:12:02.48,0:12:05.60,Caption,,0,0,0,,ПОСТОЯННЫЕ ЧЛЕНЫ СОВБЕЗА. ОНИ ВХОДЯТ В ТУ САМУЮ
Dialogue: 0,0:12:05.60,0:12:08.96,Caption,,0,0,0,,ПЯТЁРКУ, КОТОРАЯ ПОСЛЕ ВТОРОЙ МИРОВОЙ ВОЙНЫ ПОЛУЧИЛА ОСОБОЕ
Dialogue: 0,0:12:08.96,0:12:12.00,Caption,,0,0,0,,МЕСТО В МИРОВОЙ СИСТЕМЕ. НО ЗАЯВЛЕНИЕ О РЕФОРМЕ
Dialogue: 0,0:12:12.00,0:12:14.00,Caption,,0,0,0,,ООН СПОКОЙНО ПОЯВИЛОСЬ В ФОРМАТЕ,
Dialogue: 0,0:12:14.15,0:12:16.32,Caption,,0,0,0,,ГДЕ ИХ НЕ БЫЛО. ВОТ ВАМ И НАМЁТКИ
Dialogue: 0,0:12:16.32,0:12:19.60,Caption,,0,0,0,,НОВОЙ ЯЛТЫ. НЕ ГОТОВЫЙ РАЗДЕЛ МИРА. НЕ НОВЫЙ
Dialogue: 0,0:12:19.68,0:12:21.68,Caption,,0,0,0,,ГЛОБУС С ТРЕМЯ ЦВЕТАМИ. ПОКА НЕТ.
Dialogue: 0,0:12:23.96,0:12:25.72,Caption,,0,0,0,,НО УЖЕ ЕСТЬ ПОПЫТКА ОПРЕДЕЛИТЬ,
Dialogue: 0,0:12:25.81,0:12:29.00,Caption,,0,0,0,,КАКИЕ ПРАВИЛА ТРОЕ СЧИТАЮТ ПРИЕМЛЕМЫМИ И КАКИЕ
Dialogue: 0,0:12:29.00,0:12:32.20,Caption,,0,0,0,,СТРУКТУРЫ СЧИТАЮТ СЛИШКОМ ЗАРВАВШИМИСЯ. СУВЕРЕНИТЕТ
Dialogue: 0,0:12:32.20,0:12:34.84,Caption,,0,0,0,,ГОСУДАРСТВА ПРОТИВ НАДГОСУДАРСТВЕННОГО ДАВЛЕНИЯ.
Dialogue: 0,0:12:35.09,0:12:37.48,Caption,,0,0,0,,ИММУНИТЕТЫ ОФИЦИАЛЬНЫХ ЛИЦ ПРОТИВ РАСШИРЕНИЯ
Dialogue: 0,0:12:37.48,0:12:40.28,Caption,,0,0,0,,ПОЛНОМОЧИЙ МЕЖДУНАРОДНЫХ СУДОВ. ЭНЕРГЕТИЧЕСКИЕ
Dialogue: 0,0:12:40.28,0:12:44.36,Caption,,0,0,0,,ИНТЕРЕСЫ ПРОТИВ ПОЛИТИКИ, КОТОРАЯ ДЕЛАЕТ СОБСТВЕННУЮ ПРОМЫШЛЕННОСТЬ ДОРОЖЕ.
Dialogue: 0,0:12:44.58,0:12:47.16,Caption,,0,0,0,,ЯДЕРНОЕ СДЕРЖИВАНИЕ ПРОТИВ КРАСИВЫХ ПРИЗЫВОВ ВСЁ
Dialogue: 0,0:12:47.16,0:12:50.84,Caption,,0,0,0,,УНИЧТОЖИТЬ. И РЯДОМ ЕВРОПА, КОТОРАЯ ВСЁ ЕЩЁ ДОКАЗЫВАЕТ,
Dialogue: 0,0:12:51.05,0:12:53.64,Caption,,0,0,0,,ЧТО БЕЗ НЕЁ НИЧЕГО НЕЛЬЗЯ РЕШАТЬ. А РЕШАЮТ.
Dialogue: 0,0:12:53.85,0:12:56.28,Caption,,0,0,0,,НЕ ВСЁ. НЕ ОКОНЧАТЕЛЬНО. НЕ ТАК,
Dialogue: 0,0:12:56.36,0:12:58.68,Caption,,0,0,0,,КАК КОМУ ТО ХОТЕЛОСЬ БЫ. НО САМ ФАКТ
Dialogue: 0,0:12:58.68,0:13:02.12,Caption,,0,0,0,,ТОГО, ЧТО ТРОЕ НАЧАЛИ ФОРМУЛИРОВАТЬ ОБЩИЕ ПРИНЦИПЫ БЕЗ
Dialogue: 0,0:13:02.12,0:13:04.68,Caption,,0,0,0,,ФРАНЦИИ, БРИТАНИИ И ЕВРОСОЮЗА,
Dialogue: 0,0:13:04.93,0:13:08.12,Caption,,0,0,0,,УЖЕ ПОКАЗЫВАЕТ ОДНУ ПРОСТУЮ ВЕЩЬ. СТАРОГО МЕСТА ЗА
Dialogue: 0,0:13:08.20,0:13:11.08,Caption,,0,0,0,,СТОЛОМ НЕДОСТАТОЧНО. СТАРОЙ ТАБЛИЧКИ НА ДВЕРИ
Dialogue: 0,0:13:11.08,0:13:14.28,Caption,,0,0,0,,НЕДОСТАТОЧНО. ДАЖЕ СТАРОГО ПРАВА ВЕТО НЕДОСТАТОЧНО,
Dialogue: 0,0:13:14.52,0:13:17.64,Caption,,0,0,0,,ЕСЛИ ДРУГИЕ НАЧИНАЮТ ДОГОВАРИВАТЬСЯ РАНЬШЕ ТЕБЯ. И
Dialogue: 0,0:13:17.72,0:13:20.44,Caption,,0,0,0,,ВОТ ЭТО ДЛЯ ЕВРОПЫ КУДА БОЛЕЗНЕННЕЕ ЛЮБОЙ ФОТОГРАФИИ
Dialogue: 0,0:13:20.44,0:13:23.32,Caption,,0,0,0,,ПУТИНА С ЗАПАДНЫМИ ЛИДЕРАМИ. ФОТОГРАФИЮ МОЖНО
Dialogue: 0,0:13:23.32,0:13:26.12,Caption,,0,0,0,,ОБЪЯСНИТЬ ПРОТОКОЛОМ. РУКОПОЖАТИЕ МОЖНО ОБЪЯСНИТЬ
Dialogue: 0,0:13:26.12,0:13:29.16,Caption,,0,0,0,,ВЕЖЛИВОСТЬЮ. ДАЖЕ СЛОВО ДРУГ МОЖНО СПИСАТЬ НА СТИЛЬ
Dialogue: 0,0:13:29.16,0:13:34.41,Caption,,0,0,0,,ТРАМПА. А ВОТ ЕСЛИ КРУПНЫЕ ДЕРЖАВЫ НАЧИНАЮТ ОБСУЖДАТЬ
Dialogue: 0,0:13:34.41,0:13:37.05,Caption,,0,0,0,,ПРАВИЛА, ПО КОТОРЫМ ДАЛЬШЕ БУДУТ РАБОТАТЬ ООН,
Dialogue: 0,0:13:37.29,0:13:41.13,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ СУДЫ, ЭНЕРГЕТИКА И СТРАТЕГИЧЕСКАЯ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:13:41.50,0:13:44.01,Caption,,0,0,0,,ТУТ ОБЪЯСНЯТЬСЯ УЖЕ ПРИДЁТСЯ НЕ ПЕРЕД ФОТОГРАФАМИ.
Dialogue: 0,0:13:44.33,0:13:47.93,Caption,,0,0,0,,ПРИДЁТСЯ ОБЪЯСНЯТЬ, ПОЧЕМУ ЭКОНОМИЧЕСКИЙ МОНСТР ТРЕБУЕТ,
Dialogue: 0,0:13:48.09,0:13:52.81,Caption,,0,0,0,,ЧТОБЫ ЕГО ПУСТИЛИ ЗА СТОЛ, А ЭКОНОМИЧЕСКИЙ КАРЛИК УЖЕ СИДИТ ТАМ. И,
Dialogue: 0,0:13:52.89,0:13:56.49,Caption,,0,0,0,,ПОХОЖЕ, ИМЕННО ЭТОТ ВОПРОС СИКОРСКОМУ ПОНРАВИТСЯ МЕНЬШЕ
Dialogue: 0,0:13:56.57,0:13:56.89,Caption,,0,0,0,,ВСЕГО.
