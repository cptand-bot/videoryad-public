Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,ЧТО ТО У НАШИХ ЕВРОПЕЙСКИХ ДРУЗЕЙ НАЧАЛИСЬ ПРОБЛЕМЫ
Dialogue: 0,0:00:02.76,0:00:05.88,Caption,,0,0,0,,С ДОВЕРИЕМ. РАНЬШЕ ОНИ ВНИМАТЕЛЬНО СЛЕДИЛИ ЗА КАЖДЫМ
Dialogue: 0,0:00:05.88,0:00:08.76,Caption,,0,0,0,,ШАГОМ ПУТИНА. ТЕПЕРЬ ПРИХОДИТСЯ ЕЩЁ И ЗА ТРАМПОМ
Dialogue: 0,0:00:08.76,0:00:11.80,Caption,,0,0,0,,ПРИСМАТРИВАТЬ. МЕРЦ УЖЕ ПРОСИТ АМЕРИКАНЦЕВ НЕ ДЕЛАТЬ
Dialogue: 0,0:00:11.88,0:00:15.08,Caption,,0,0,0,,РЕЗКИХ ДВИЖЕНИЙ И НЕ УСТРАИВАТЬ СЮРПРИЗОВ. СКОРО,
Dialogue: 0,0:00:15.24,0:00:18.36,Caption,,0,0,0,,ГЛЯДИШЬ, ПОТРЕБУЮТ ЗАРАНЕЕ СОГЛАСОВЫВАТЬ ДАЖЕ ТЕЛЕФОННЫЕ
Dialogue: 0,0:00:18.44,0:00:22.28,Caption,,0,0,0,,ЗВОНКИ. СМЕШНО, КОНЕЧНО. ТОЛЬКО ВОТ ПОЧЕМУ СОЮЗНИКИ ВДРУГ НАЧАЛИ
Dialogue: 0,0:00:22.28,0:00:24.20,Caption,,0,0,0,,ОПАСАТЬСЯ СОБСТВЕННЫХ СОЮЗНИКОВ?
Dialogue: 0,0:00:24.60,0:00:27.96,Caption,,0,0,0,,И ЧТО ТАКОГО ИЗМЕНИЛОСЬ, ЧТО ПРЕЖНИЕ ДОГОВОРЁННОСТИ УЖЕ НИКОГО НЕ
Dialogue: 0,0:00:27.96,0:00:30.12,Caption,,0,0,0,,УСПОКАИВАЮТ? ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:00:30.29,0:00:32.28,Caption,,0,0,0,,КОГДА МЫ НЕ ПРОСТО ПЕРЕСКАЗЫВАЕМ НОВОСТИ,
Dialogue: 0,0:00:32.52,0:00:35.40,Caption,,0,0,0,,А ПЫТАЕМСЯ ПОНЯТЬ, КАК ОНИ СВЯЗАНЫ МЕЖДУ СОБОЙ,
Dialogue: 0,0:00:35.58,0:00:38.36,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:38.52,0:00:40.92,Caption,,0,0,0,,КОГДА ОТДЕЛЬНЫЕ КУСОЧКИ НАЧИНАЮТ СКЛАДЫВАТЬСЯ В
Dialogue: 0,0:00:41.00,0:00:44.20,Caption,,0,0,0,,ДОВОЛЬНО ЗАНЯТНУЮ КАРТИНУ. ФРИДРИХ МЕРЦ СОВЕРШЕННО
Dialogue: 0,0:00:44.28,0:00:47.24,Caption,,0,0,0,,ОТКРЫТО ГОВОРИТ О СТРАХЕ ВТОРОГО АНКОРИДЖА. ТРАМП
Dialogue: 0,0:00:47.24,0:00:50.68,Caption,,0,0,0,,СОБИРАЕТСЯ В КИТАЙ, ТАМ ОЖИДАЮТСЯ ЕГО КОНТАКТЫ С ПУТИНЫМ,
Dialogue: 0,0:00:50.94,0:00:53.72,Caption,,0,0,0,,И НЕМЕЦКИЙ КАНЦЛЕР ОБРАЩАЕТСЯ К ВАШИНГТОНУ ПОЧТИ ПО
Dialogue: 0,0:00:53.72,0:00:55.88,Caption,,0,0,0,,СЕМЕЙНОМУ. ДОНАЛЬД, ПОЖАЛУЙСТА,
Dialogue: 0,0:00:56.02,0:00:58.60,Caption,,0,0,0,,ТОЛЬКО БЕЗ СЮРПРИЗОВ. ПРОДОЛЖАЙТЕ ИГРАТЬ ВМЕСТЕ С
Dialogue: 0,0:00:58.60,0:01:01.56,Caption,,0,0,0,,ЕВРОПОЙ И УКРАИНОЙ. ФРАЗА ЗАМЕЧАТЕЛЬНАЯ УЖЕ САМА ПО
Dialogue: 0,0:01:01.56,0:01:04.60,Caption,,0,0,0,,СЕБЕ. КОГДА СОЮЗНИКУ ПРИХОДИТСЯ ОТДЕЛЬНО НАПОМИНАТЬ,
Dialogue: 0,0:01:04.84,0:01:06.60,Caption,,0,0,0,,ЧТО ОН НАХОДИТСЯ В ВАШЕЙ КОМАНДЕ,
Dialogue: 0,0:01:06.84,0:01:09.56,Caption,,0,0,0,,ЗНАЧИТ, С КОМАНДНОЙ ИГРОЙ ЧТО ТО ПОШЛО НЕ СОВСЕМ
Dialogue: 0,0:01:09.64,0:01:14.96,Caption,,0,0,0,,ПО ПЛАНУ. И ВОТ ЧТО ЗДЕСЬ ВАЖНО. ЕВРОПЕЙЦЕВ ТРЕВОЖИТ НЕ
Dialogue: 0,0:01:15.04,0:01:18.24,Caption,,0,0,0,,ТО, ДАДУТ ИМ ЕЩЁ ОДИН СТУЛ ВОЗЛЕ ПЕРЕГОВОРНОГО СТОЛА
Dialogue: 0,0:01:18.32,0:01:21.04,Caption,,0,0,0,,ИЛИ ЗАСТАВЯТ ПОСТОЯТЬ В КОРИДОРЕ. ЭТО ВСЁ ВНЕШНЯЯ
Dialogue: 0,0:01:21.04,0:01:24.88,Caption,,0,0,0,,МИШУРА. ГОРАЗДО ВАЖНЕЕ ДРУГОЕ. СОЕДИНЁННЫЕ ШТАТЫ ПРИ
Dialogue: 0,0:01:24.96,0:01:27.60,Caption,,0,0,0,,ТРАМПЕ НАЧИНАЮТ СМОТРЕТЬ НА ПЕРЕГОВОРЫ С РОССИЕЙ НЕ
Dialogue: 0,0:01:27.60,0:01:31.36,Caption,,0,0,0,,ТАК, КАК СМОТРЕЛА ЕВРОПА ПОСЛЕДНИЕ ГОДЫ. ЕВРОПА ПРИВЫКЛА
Dialogue: 0,0:01:31.36,0:01:34.48,Caption,,0,0,0,,ИСХОДИТЬ ИЗ ОДНОЙ КОНСТРУКЦИИ. РОССИЮ НУЖНО ДАВИТЬ,
Dialogue: 0,0:01:34.57,0:01:37.84,Caption,,0,0,0,,ОГРАНИЧИВАТЬ, ОСЛАБЛЯТЬ, ОБКЛАДЫВАТЬ САНКЦИЯМИ,
Dialogue: 0,0:01:38.00,0:01:42.64,Caption,,0,0,0,,ВООРУЖАТЬ УКРАИНУ И ЖДАТЬ, КОГДА НАКОПЛЕННЫЙ ЭФФЕКТ ДАСТ НУЖНЫЙ РЕЗУЛЬТАТ.
Dialogue: 0,0:01:43.04,0:01:45.92,Caption,,0,0,0,,АМЕРИКА ДОЛГО БЫЛА ГЛАВНЫМ МОТОРОМ ЭТОЙ КОНСТРУКЦИИ.
Dialogue: 0,0:01:46.08,0:01:49.68,Caption,,0,0,0,,ДЕНЬГИ, ОРУЖИЕ, РАЗВЕДКА, ПОЛИТИЧЕСКИЙ ВЕС,
Dialogue: 0,0:01:49.83,0:01:53.28,Caption,,0,0,0,,НАТО. БЕЗ США ЕВРОПЕЙСКАЯ МАШИНА ВЫГЛЯДИТ УЖЕ НЕ
Dialogue: 0,0:01:53.28,0:01:55.92,Caption,,0,0,0,,ТАК БОДРО. И ВОТ ТЕПЕРЬ ГЛАВНЫЙ МОТОР ВДРУГ
Dialogue: 0,0:01:56.00,0:02:00.72,Caption,,0,0,0,,НАЧИНАЕТ РАЗГОВАРИВАТЬ С ТЕМ, ПРОТИВ КОГО ВСЯ МАШИНА СОБИРАЛАСЬ ЕХАТЬ. ОТСЮДА И
Dialogue: 0,0:02:00.72,0:02:02.48,Caption,,0,0,0,,ЭТИ ПРОСЬБЫ МЕРЦА. ПОЖАЛУЙСТА,
Dialogue: 0,0:02:02.57,0:02:05.76,Caption,,0,0,0,,НИКАКИХ СЮРПРИЗОВ. НО САМОЕ ИНТЕРЕСНОЕ ДАЖЕ НЕ ЭТО.
Dialogue: 0,0:02:06.10,0:02:08.08,Caption,,0,0,0,,ИЗ МОСКВЫ МНОГО ЛЕТ ЗВУЧИТ ОДНА И ТА
Dialogue: 0,0:02:08.16,0:02:11.44,Caption,,0,0,0,,ЖЕ ФОРМУЛА. НУЖНО УСТРАНИТЬ ПЕРВОПРИЧИНЫ КОНФЛИКТА.
Dialogue: 0,0:02:11.76,0:02:16.48,Caption,,0,0,0,,СЛЫШАЛИ ЕЁ УЖЕ СТОЛЬКО РАЗ, ЧТО ОНА ПРЕВРАТИЛАСЬ ПОЧТИ В ФОН. ПЕРВОПРИЧИНЫ,
Dialogue: 0,0:02:16.56,0:02:20.88,Caption,,0,0,0,,ПЕРВОПРИЧИНЫ, ПЕРВОПРИЧИНЫ. УХО ПРИВЫКЛО И ДАЛЬШЕ УЖЕ ОСОБО НЕ
Dialogue: 0,0:02:20.88,0:02:23.44,Caption,,0,0,0,,СЛУШАЕТ. И КОГДА ПРОИЗНОСЯТ ЭТИ СЛОВА,
Dialogue: 0,0:02:23.52,0:02:25.84,Caption,,0,0,0,,РАЗГОВОР ОБЫЧНО СРАЗУ УХОДИТ НА УКРАИНУ.
Dialogue: 0,0:02:26.12,0:02:28.80,Caption,,0,0,0,,ДЕНАЦИФИКАЦИЯ. ДЕМИЛИТАРИЗАЦИЯ.
Dialogue: 0,0:02:31.08,0:02:34.28,Caption,,0,0,0,,ПОЛОЖЕНИЕ РУССКОГО ЯЗЫКА. ТЕРРИТОРИИ. УКРАИНСКАЯ
Dialogue: 0,0:02:34.36,0:02:37.40,Caption,,0,0,0,,АРМИЯ. КИЕВСКАЯ ВЛАСТЬ. ТОЛЬКО ЗДЕСЬ ЕСТЬ ВАЖНЫЙ
Dialogue: 0,0:02:37.48,0:02:40.44,Caption,,0,0,0,,МОМЕНТ. ЕСЛИ СМОТРЕТЬ НА РОССИЙСКУЮ ПОЗИЦИЮ ТАК,
Dialogue: 0,0:02:40.63,0:02:43.48,Caption,,0,0,0,,КАК МОСКВА ФОРМУЛИРОВАЛА ЕЁ ЕЩЁ ДО НАЧАЛА СВО,
Dialogue: 0,0:02:43.88,0:02:46.28,Caption,,0,0,0,,ТО ПЕРВОПРИЧИНОЙ НАЗЫВАЛАСЬ СОВСЕМ НЕ УКРАИНСКАЯ
Dialogue: 0,0:02:46.28,0:02:49.56,Caption,,0,0,0,,ЯЗЫКОВАЯ ПОЛИТИКА. ГЛАВНЫМ ВОПРОСОМ БЫЛО РАСШИРЕНИЕ
Dialogue: 0,0:02:49.56,0:02:52.36,Caption,,0,0,0,,НАТО И ПРИБЛИЖЕНИЕ ВОЕННОЙ ИНФРАСТРУКТУРЫ АЛЬЯНСА К
Dialogue: 0,0:02:52.44,0:02:55.16,Caption,,0,0,0,,РОССИЙСКИМ ГРАНИЦАМ. УКРАИНСКАЯ ЧАСТЬ ПОЯВИЛАСЬ УЖЕ
Dialogue: 0,0:02:55.16,0:02:57.96,Caption,,0,0,0,,ВНУТРИ ЭТОГО БОЛЬШОГО КОНФЛИКТА БЕЗОПАСНОСТИ. ТО
Dialogue: 0,0:02:58.04,0:03:01.24,Caption,,0,0,0,,ЕСТЬ СНАЧАЛА БЫЛ СПОР О НАТО, ГРАНИЦАХ ЕГО РАСШИРЕНИЯ,
Dialogue: 0,0:03:01.47,0:03:03.72,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЕ И ПРИНЦИПЕ НЕДЕЛИМОЙ
Dialogue: 0,0:03:03.72,0:03:07.00,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ПОТОМ ЭТОТ СПОР ДОШЁЛ ДО УКРАИНЫ. И
Dialogue: 0,0:03:07.08,0:03:09.24,Caption,,0,0,0,,УЖЕ ВНУТРИ УКРАИНСКОГО КОНФЛИКТА ПОЯВИЛИСЬ
Dialogue: 0,0:03:09.24,0:03:12.04,Caption,,0,0,0,,КОНКРЕТНЫЕ ЦЕЛИ СВО, ТЕРРИТОРИИ,
Dialogue: 0,0:03:12.20,0:03:15.32,Caption,,0,0,0,,ДЕМИЛИТАРИЗАЦИЯ И ВСЁ ОСТАЛЬНОЕ. ЭТО ДВЕ РАЗНЫЕ
Dialogue: 0,0:03:15.32,0:03:18.20,Caption,,0,0,0,,СТУПЕНИ ОДНОЙ ИСТОРИИ. И ВОТ ТЕПЕРЬ ПОСМОТРИТЕ,
Dialogue: 0,0:03:18.36,0:03:20.84,Caption,,0,0,0,,ЧТО РАССКАЗАЛ УШАКОВ ПОСЛЕ РАЗГОВОРА ПУТИНА С
Dialogue: 0,0:03:20.84,0:03:23.48,Caption,,0,0,0,,УИТКОФФОМ И КУШНЕРОМ. ОБСУЖДАЛАСЬ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:03:23.48,0:03:26.92,Caption,,0,0,0,,УКРАИНА. ОБСУЖДАЛАСЬ ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ. ПУТИН
Dialogue: 0,0:03:27.00,0:03:29.56,Caption,,0,0,0,,СНОВА ПОДНЯЛ ПРИНЦИП НЕДЕЛИМОЙ БЕЗОПАСНОСТИ И
Dialogue: 0,0:03:29.64,0:03:32.76,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО. МОСКВА ЗАЯВИЛА О ГОТОВНОСТИ ВМЕСТЕ
Dialogue: 0,0:03:32.84,0:03:35.16,Caption,,0,0,0,,С ВАШИНГТОНОМ ПРОРАБАТЫВАТЬ ПРЕДЛОЖЕНИЯ ПО ЭТОМУ
Dialogue: 0,0:03:35.16,0:03:37.64,Caption,,0,0,0,,ВОПРОСУ. ВОТ ЭТО УЖЕ СОВСЕМ ДРУГОЙ МАСШТАБ
Dialogue: 0,0:03:37.64,0:03:43.05,Caption,,0,0,0,,РАЗГОВОРА. МОЖНО СКОЛЬКО УГОДНО ОБСУЖДАТЬ ЛИНИЮ ФРОНТА,
Dialogue: 0,0:03:43.29,0:03:46.41,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЕ ПЕРЕМИРИЕ И ОБМЕН ПЛЕННЫМИ. ВСЁ ЭТО
Dialogue: 0,0:03:46.41,0:03:49.45,Caption,,0,0,0,,ВАЖНО. НО ЕСЛИ СТОРОНЫ ДЕЙСТВИТЕЛЬНО ВОЗВРАЩАЮТСЯ К
Dialogue: 0,0:03:49.45,0:03:52.97,Caption,,0,0,0,,ВОПРОСУ РОССИЯ И НАТО, ТО ОНИ ВОЗВРАЩАЮТСЯ ТУДА,
Dialogue: 0,0:03:53.11,0:03:55.29,Caption,,0,0,0,,ОТКУДА ВСЯ ЭТА ИСТОРИЯ КОГДА ТО НАЧАЛА
Dialogue: 0,0:03:55.29,0:03:58.33,Caption,,0,0,0,,РАСКРУЧИВАТЬСЯ. И ВОТ ЗДЕСЬ ДЛЯ ЕВРОПЫ ОТКРЫВАЕТСЯ
Dialogue: 0,0:03:58.33,0:04:01.69,Caption,,0,0,0,,НАСТОЯЩИЙ ЯЩИК ПАНДОРЫ. УИТКОФФ И КУШНЕР ВКЛЮЧИЛИ В
Dialogue: 0,0:04:01.77,0:04:04.57,Caption,,0,0,0,,ПЕРЕГОВОРНУЮ ПОВЕСТКУ ПЕРЕСМОТР ЕВРОПЕЙСКОЙ СИСТЕМЫ
Dialogue: 0,0:04:04.57,0:04:07.77,Caption,,0,0,0,,БЕЗОПАСНОСТИ. В ЭТОЙ ЛОГИКЕ АМЕРИКАНЦЫ ДАЮТ МОСКВЕ
Dialogue: 0,0:04:07.77,0:04:11.93,Caption,,0,0,0,,ИМЕННО ТО, ЧЕГО ОНА ДАВНО ДОБИВАЛАСЬ. ВОЗМОЖНОСТЬ ОБСУЖДАТЬ НЕ
Dialogue: 0,0:04:11.93,0:04:16.73,Caption,,0,0,0,,ТОЛЬКО УКРАИНСКИЙ КОНФЛИКТ, НО И УСТРОЙСТВО БЕЗОПАСНОСТИ ВСЕГО КОНТИНЕНТА. И
Dialogue: 0,0:04:16.73,0:04:19.45,Caption,,0,0,0,,ЗДЕСЬ ОЧЕНЬ ИНТЕРЕСНОЕ ПРОТИВОРЕЧИЕ. ЕВРОПЕЙСКАЯ
Dialogue: 0,0:04:19.45,0:04:22.65,Caption,,0,0,0,,ПОЗИЦИЯ ЗВУЧИТ ПРИМЕРНО ТАК. СНАЧАЛА ПРЕКРАЩЕНИЕ
Dialogue: 0,0:04:22.65,0:04:25.93,Caption,,0,0,0,,ОГНЯ НА УКРАИНЕ. ПОТОМ ВСЁ ОСТАЛЬНОЕ. НО ЕСТЬ
Dialogue: 0,0:04:25.93,0:04:29.13,Caption,,0,0,0,,И ДРУГАЯ ЛОГИКА. ЕСЛИ ПРОТИВОРЕЧИЯ МЕЖДУ РОССИЕЙ И
Dialogue: 0,0:04:29.21,0:04:33.21,Caption,,0,0,0,,НАТО ОСТАНУТСЯ НА МЕСТЕ, ТО НАСКОЛЬКО УСТОЙЧИВЫМ ВООБЩЕ БУДЕТ ЛЮБОЕ
Dialogue: 0,0:04:33.21,0:04:37.29,Caption,,0,0,0,,УКРАИНСКОЕ СОГЛАШЕНИЕ? ЗАКЛЮЧИЛИ ПЕРЕМИРИЕ. ПОЗДРАВИЛИ ДРУГ ДРУГА.
Dialogue: 0,0:04:37.46,0:04:40.81,Caption,,0,0,0,,СФОТОГРАФИРОВАЛИСЬ. ПОЖАЛИ РУКИ. РАЗЪЕХАЛИСЬ. А
Dialogue: 0,0:04:40.81,0:04:43.93,Caption,,0,0,0,,ГЛАВНЫЙ КОНФЛИКТ БЕЗОПАСНОСТИ НИКУДА НЕ ДЕЛСЯ. ЧЕРЕЗ
Dialogue: 0,0:04:43.93,0:04:47.77,Caption,,0,0,0,,ГОД, ДВА ИЛИ ПЯТЬ СНОВА НАЧИНАЮТСЯ СПОРЫ О БАЗАХ,
Dialogue: 0,0:04:47.85,0:04:53.29,Caption,,0,0,0,,КОНТИНГЕНТАХ, ВООРУЖЕНИЯХ, ГРАНИЦАХ РАСШИРЕНИЯ НАТО. И ПРИЕЗЖАЕМ ТУДА ЖЕ,
Dialogue: 0,0:04:53.38,0:04:56.01,Caption,,0,0,0,,ОТКУДА УЕХАЛИ. ОЧЕНЬ ЭФФЕКТИВНАЯ СИСТЕМА.
Dialogue: 0,0:04:58.20,0:05:00.76,Caption,,0,0,0,,МОЖНО КАЖДЫЕ НЕСКОЛЬКО ЛЕТ ПРОВОДИТЬ НОВЫЙ МИРНЫЙ
Dialogue: 0,0:05:00.76,0:05:05.48,Caption,,0,0,0,,САММИТ И СНОВА СПАСАТЬ МИР. КУШНЕР ПРИ ЭТОМ ГОВОРИТ ЕЩЁ ОДНУ ВАЖНУЮ ВЕЩЬ.
Dialogue: 0,0:05:05.80,0:05:08.36,Caption,,0,0,0,,ПУБЛИЧНО СТОРОНЫ ЗАНИМАЮТ ЖЁСТКИЕ ПОЗИЦИИ,
Dialogue: 0,0:05:08.62,0:05:11.00,Caption,,0,0,0,,А ЗА ЗАКРЫТЫМИ ДВЕРЯМИ ПОНИМАЮТ НЕОБХОДИМОСТЬ
Dialogue: 0,0:05:11.00,0:05:13.96,Caption,,0,0,0,,ПРАКТИЧЕСКИХ КОМПРОМИССОВ. ВОТ ЭТО УЖЕ ПОХОЖЕ НА
Dialogue: 0,0:05:14.04,0:05:16.76,Caption,,0,0,0,,РЕАЛЬНЫЕ ПЕРЕГОВОРЫ. ПОТОМУ ЧТО ПЕРЕД ТЕЛЕКАМЕРАМИ
Dialogue: 0,0:05:16.76,0:05:19.96,Caption,,0,0,0,,ПОЛИТИК ОБЯЗАН ВЫГЛЯДЕТЬ ЖЕЛЕЗНЫМ ЧЕЛОВЕКОМ. НИКАКИХ
Dialogue: 0,0:05:19.96,0:05:23.72,Caption,,0,0,0,,УСТУПОК. НИ ШАГУ НАЗАД. ВСЁ НАШЕ. ПОБЕДА НЕИЗБЕЖНА.
Dialogue: 0,0:05:24.04,0:05:26.68,Caption,,0,0,0,,А ПОТОМ ДВЕРЬ ЗАКРЫВАЕТСЯ, ЖУРНАЛИСТЫ УХОДЯТ,
Dialogue: 0,0:05:27.00,0:05:30.20,Caption,,0,0,0,,И НАЧИНАЕТСЯ СКУЧНАЯ ВЗРОСЛАЯ РАБОТА. ЧТО ОТДАЁМ.
Dialogue: 0,0:05:30.44,0:05:34.04,Caption,,0,0,0,,ЧТО ПОЛУЧАЕМ. ГДЕ ПРОХОДИТ ГРАНИЦА. КТО ГАРАНТИРУЕТ.
Dialogue: 0,0:05:34.33,0:05:37.32,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ С САНКЦИЯМИ. КТО ПОДПИСЫВАЕТ. КТО
Dialogue: 0,0:05:37.32,0:05:40.28,Caption,,0,0,0,,ОТВЕЧАЕТ, ЕСЛИ ДОГОВОР НАРУШЕН. ПОДПИШИТЕСЬ,
Dialogue: 0,0:05:40.40,0:05:42.84,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ СДЕЛАЛИ ЭТОГО. ДАЛЬШЕ КАК РАЗ
Dialogue: 0,0:05:42.84,0:05:47.32,Caption,,0,0,0,,НАЧИНАЕТСЯ ТА ЧАСТЬ, ГДЕ УКРАИНСКИЙ ВОПРОС ВДРУГ ОКАЗЫВАЕТСЯ ТОЛЬКО ОДНИМ
Dialogue: 0,0:05:47.32,0:05:50.44,Caption,,0,0,0,,ЭТАЖОМ ГОРАЗДО БОЛЬШЕГО ЗДАНИЯ. ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:05:50.68,0:05:53.40,Caption,,0,0,0,,ЧТО РОССИЯ ОТКАЗАЛАСЬ ОТ ЭНЕРГЕТИЧЕСКОГО ПЕРЕМИРИЯ.
Dialogue: 0,0:05:53.64,0:05:55.56,Caption,,0,0,0,,ОДНОВРЕМЕННО ОБСУЖДАЮТСЯ ТЕРРИТОРИИ,
Dialogue: 0,0:05:55.80,0:06:01.00,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ, НАТО, ОБМЕН ПЛЕННЫМИ. АМЕРИКАНЦЫ ЗАДАЮТ ВОПРОСЫ О ТОМ,
Dialogue: 0,0:06:01.24,0:06:04.36,Caption,,0,0,0,,НА КАКИЕ ТЕРРИТОРИАЛЬНЫЕ РЕШЕНИЯ ГОТОВ КИЕВ. КУШНЕР
Dialogue: 0,0:06:04.36,0:06:07.40,Caption,,0,0,0,,ГОВОРИТ О ПРАКТИЧЕСКИХ КОМПРОМИССАХ. И ЗДЕСЬ ВАЖНО
Dialogue: 0,0:06:07.40,0:06:09.56,Caption,,0,0,0,,НЕ ПОТЕРЯТЬСЯ В КАЖДОЙ ОТДЕЛЬНОЙ НОВОСТИ.
Dialogue: 0,0:06:11.76,0:06:13.68,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ВЫТАЩИТЬ ОДИН ВОПРОС,
Dialogue: 0,0:06:13.76,0:06:18.32,Caption,,0,0,0,,НАПРИМЕР ЭНЕРГЕТИКУ, ПОЛУЧИТСЯ ОДНА КАРТИНА. ЕСЛИ ВЫТАЩИТЬ ТЕРРИТОРИИ,
Dialogue: 0,0:06:18.48,0:06:20.80,Caption,,0,0,0,,ПОЛУЧИТСЯ ДРУГАЯ. ЕСЛИ ВЗЯТЬ НАТО,
Dialogue: 0,0:06:20.96,0:06:23.52,Caption,,0,0,0,,ТРЕТЬЯ. А ПЕРЕГОВОРЫ КАК РАЗ И СОСТОЯТ В
Dialogue: 0,0:06:23.52,0:06:26.64,Caption,,0,0,0,,ТОМ, ЧТО ВСЁ ЭТО СВЯЗЫВАЕТСЯ МЕЖДУ СОБОЙ. КОМУ ТО
Dialogue: 0,0:06:26.72,0:06:30.16,Caption,,0,0,0,,НУЖНЫ ТЕРРИТОРИИ. КОМУ ТО ГАРАНТИИ. КОМУ ТО САНКЦИИ.
Dialogue: 0,0:06:30.40,0:06:32.80,Caption,,0,0,0,,КОМУ ТО ОТСУТСТВИЕ ИНОСТРАННЫХ ВОЙСК. КОМУ ТО
Dialogue: 0,0:06:32.80,0:06:35.36,Caption,,0,0,0,,ЧЛЕНСТВО В НАТО. КОМУ ТО, НАОБОРОТ,
Dialogue: 0,0:06:35.52,0:06:38.80,Caption,,0,0,0,,НЕРАСШИРЕНИЕ НАТО. ИМЕННО ПОЭТОМУ ВОПРОС О ТОМ,
Dialogue: 0,0:06:38.91,0:06:43.44,Caption,,0,0,0,,КОМУ НУЖЕН БЫСТРЫЙ МИР, САМ ПО СЕБЕ НЕМНОГО ЛУКАВЫЙ. БЫСТРЫЙ МИР НА
Dialogue: 0,0:06:43.52,0:06:47.52,Caption,,0,0,0,,КАКИХ УСЛОВИЯХ? ПОДПИСАТЬ БУМАГУ БЫСТРО МОЖНО. ГОРАЗДО СЛОЖНЕЕ
Dialogue: 0,0:06:47.52,0:06:50.72,Caption,,0,0,0,,СДЕЛАТЬ ТАК, ЧТОБЫ ЧЕРЕЗ ПОЛГОДА ВСЕ УЧАСТНИКИ НЕ НАЧАЛИ
Dialogue: 0,0:06:50.72,0:06:52.80,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО ИХ НЕПРАВИЛЬНО ПОНЯЛИ.
Dialogue: 0,0:06:53.43,0:06:56.40,Caption,,0,0,0,,А ТЕПЕРЬ КИТАЙ. ДЕВЯТНАДЦАТОГО НОЯБРЯ В ШЭНЬЧЖЭНЕ
Dialogue: 0,0:06:56.40,0:07:00.80,Caption,,0,0,0,,ОЖИДАЕТСЯ ВСТРЕЧА ТРАМПА, ПУТИНА И СИ ЦЗИНЬПИНА. И ВОКРУГ ЕЁ ПОВЕСТКИ
Dialogue: 0,0:07:00.88,0:07:04.08,Caption,,0,0,0,,УЖЕ НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ. ПО ОДНОМУ СЦЕНАРИЮ
Dialogue: 0,0:07:04.08,0:07:07.28,Caption,,0,0,0,,ЭТО ПОЧТИ НОВАЯ ЯЛТА. СНАЧАЛА ТРИ БОЛЬШИЕ ДЕРЖАВЫ
Dialogue: 0,0:07:07.28,0:07:12.16,Caption,,0,0,0,,РАЗГОВАРИВАЮТ МЕЖДУ СОБОЙ, ПОТОМ ЕВРОПА И УКРАИНА ПОЛУЧАЮТ СВОЮ ОЧЕРЕДЬ. ЕСТЬ
Dialogue: 0,0:07:12.24,0:07:14.72,Caption,,0,0,0,,И ДРУГАЯ ВЕРСИЯ. УКРАИНСКИЙ КОНФЛИКТ НА
Dialogue: 0,0:07:14.72,0:07:17.44,Caption,,0,0,0,,ТРЁХСТОРОННЕЙ ВСТРЕЧЕ ОБСУЖДАТЬ НЕ ПЛАНИРУЮТ. ДЛЯ
Dialogue: 0,0:07:17.44,0:07:20.16,Caption,,0,0,0,,УКРАИНЫ СУЩЕСТВУЕТ ОТДЕЛЬНЫЙ ДИПЛОМАТИЧЕСКИЙ КАНАЛ.
Dialogue: 0,0:07:20.56,0:07:24.40,Caption,,0,0,0,,А ПУТИН, ТРАМП И СИ СОБИРАЮТСЯ ГОВОРИТЬ ПРЕЖДЕ ВСЕГО О
Dialogue: 0,0:07:24.40,0:07:26.72,Caption,,0,0,0,,ЯДЕРНОМ ОРУЖИИ И ИРАНЕ. И ЗНАЕТЕ ЧТО?
Dialogue: 0,0:07:29.01,0:07:32.05,Caption,,0,0,0,,ВТОРАЯ ВЕРСИЯ НИЧУТЬ НЕ ДЕЛАЕТ ВСТРЕЧУ МЕНЕЕ ВАЖНОЙ.
Dialogue: 0,0:07:32.20,0:07:35.57,Caption,,0,0,0,,СКОРЕЕ НАОБОРОТ. ЕСЛИ ТРИ КРУПНЕЙШИЕ ДЕРЖАВЫ САДЯТСЯ
Dialogue: 0,0:07:35.57,0:07:40.13,Caption,,0,0,0,,ОБСУЖДАТЬ ЯДЕРНОЕ ОРУЖИЕ, ИРАН И ПРАВИЛА ПОВЕДЕНИЯ В СТРАТЕГИЧЕСКОЙ СФЕРЕ,
Dialogue: 0,0:07:40.50,0:07:43.09,Caption,,0,0,0,,ТО УКРАИНА ДЕЙСТВИТЕЛЬНО ПЕРЕСТАЁТ БЫТЬ ЕДИНСТВЕННЫМ
Dialogue: 0,0:07:43.09,0:07:45.97,Caption,,0,0,0,,ЦЕНТРОМ МИРОВОЙ ПОЛИТИКИ. ОНА ОСТАЁТСЯ ОГРОМНЫМ
Dialogue: 0,0:07:45.97,0:07:49.33,Caption,,0,0,0,,КОНФЛИКТОМ. НО РЯДОМ СУЩЕСТВУЮТ ЯДЕРНОЕ СДЕРЖИВАНИЕ,
Dialogue: 0,0:07:49.49,0:07:52.13,Caption,,0,0,0,,КИТАЙ, ИРАН, ТАЙВАНЬ, НАТО,
Dialogue: 0,0:07:52.29,0:07:55.09,Caption,,0,0,0,,БЛИЖНИЙ ВОСТОК. И КАЖДОМУ ИЗ ЭТИХ ВОПРОСОВ НУЖЕН
Dialogue: 0,0:07:55.09,0:07:58.61,Caption,,0,0,0,,СВОЙ КУСОК ОБЩЕЙ КОНСТРУКЦИИ БЕЗОПАСНОСТИ. ВОТ ЗДЕСЬ
Dialogue: 0,0:07:58.61,0:08:01.41,Caption,,0,0,0,,И ВОЗНИКАЕТ СЦЕНАРИЙ "ЯЛТА ДВА НОЛЬ". НЕ В
Dialogue: 0,0:08:01.41,0:08:03.89,Caption,,0,0,0,,ТОМ СМЫСЛЕ, ЧТО ТРОЕ ЛЮДЕЙ СЯДУТ ЗА СТОЛ,
Dialogue: 0,0:08:04.13,0:08:05.73,Caption,,0,0,0,,РАЗРЕЖУТ КАРТУ НОЖОМ И СКАЖУТ,
Dialogue: 0,0:08:05.88,0:08:09.89,Caption,,0,0,0,,ЭТО МНЕ, ЭТО ТЕБЕ, А ЭТО ЗАВЕРНИТЕ СИ С СОБОЙ. МИР ТАК
Dialogue: 0,0:08:09.89,0:08:12.61,Caption,,0,0,0,,УЖЕ НЕ РАБОТАЕТ. НО ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:08:12.77,0:08:15.65,Caption,,0,0,0,,РОССИЯ И КИТАЙ НАЧНУТ РЕГУЛЯРНО ДОГОВАРИВАТЬСЯ МЕЖДУ
Dialogue: 0,0:08:15.65,0:08:19.25,Caption,,0,0,0,,СОБОЙ ПО ВОПРОСАМ, КОТОРЫЕ КАСАЮТСЯ СТРАТЕГИЧЕСКОГО ОРУЖИЯ,
Dialogue: 0,0:08:19.46,0:08:21.65,Caption,,0,0,0,,БЕЗОПАСНОСТИ И РЕГИОНАЛЬНЫХ КОНФЛИКТОВ,
Dialogue: 0,0:08:22.12,0:08:24.29,Caption,,0,0,0,,ТО ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. А ГДЕ В ЭТОЙ
Dialogue: 0,0:08:24.37,0:08:28.53,Caption,,0,0,0,,СИСТЕМЕ ЕВРОПА? МЕРЦ КАК РАЗ ПОЭТОМУ И НЕРВНИЧАЕТ. ПОТОМУ ЧТО
Dialogue: 0,0:08:28.61,0:08:31.09,Caption,,0,0,0,,ОДНА ВЕЩЬ, КОГДА ЕВРОПА СПОРИТ С РОССИЕЙ,
Dialogue: 0,0:08:31.26,0:08:34.05,Caption,,0,0,0,,ИМЕЯ ЗА СПИНОЙ ВСЮ МОЩЬ СОЕДИНЁННЫХ ШТАТОВ. И
Dialogue: 0,0:08:34.05,0:08:37.57,Caption,,0,0,0,,СОВСЕМ ДРУГАЯ, КОГДА ВАШИНГТОН САМ РАЗГОВАРИВАЕТ С МОСКВОЙ И
Dialogue: 0,0:08:37.57,0:08:40.29,Caption,,0,0,0,,ПЕКИНОМ О ПРАВИЛАХ ИГРЫ. ПРИ ЭТОМ КИТАЙ НА
Dialogue: 0,0:08:40.29,0:08:42.37,Caption,,0,0,0,,ПЕРЕГОВОРЫ ПРИХОДИТ НЕ С ПУСТЫМИ РУКАМИ.
Dialogue: 0,0:08:44.66,0:08:47.46,Caption,,0,0,0,,ТАЙВАНЬ СООБЩИЛ БОЛЕЕ ЧЕМ О СОТНЕ КИТАЙСКИХ ВОЕННЫХ
Dialogue: 0,0:08:47.54,0:08:50.26,Caption,,0,0,0,,КОРАБЛЕЙ И СУДОВ БЕРЕГОВОЙ ОХРАНЫ В ЗАПАДНОЙ ЧАСТИ
Dialogue: 0,0:08:50.26,0:08:53.54,Caption,,0,0,0,,ТИХОГО ОКЕАНА. АВИАНОСНАЯ ГРУППА "ЛЯОНИН" ПРОВОДИТ
Dialogue: 0,0:08:53.62,0:08:57.30,Caption,,0,0,0,,УЧЕНИЯ. "ФУЦЗЯНЬ" ЗАМЕЧЕН В ЮЖНО КИТАЙСКОМ МОРЕ. ЗА
Dialogue: 0,0:08:57.30,0:08:59.78,Caption,,0,0,0,,СУТКИ ФИКСИРОВАЛИСЬ ДЕСЯТКИ ВЫЛЕТОВ КИТАЙСКОЙ
Dialogue: 0,0:08:59.78,0:09:03.06,Caption,,0,0,0,,ВОЕННОЙ АВИАЦИИ. СВЯЗЫВАТЬ ЭТИ ДЕЙСТВИЯ НАПРЯМУЮ СО
Dialogue: 0,0:09:03.06,0:09:05.70,Caption,,0,0,0,,ВСТРЕЧЕЙ ЛИДЕРОВ ОСНОВАНИЙ У НАС НЕТ. НО ОНИ
Dialogue: 0,0:09:05.70,0:09:08.50,Caption,,0,0,0,,ХОРОШО ПОКАЗЫВАЮТ ДРУГОЕ. КОГДА КИТАЙ ГОВОРИТ О
Dialogue: 0,0:09:08.50,0:09:12.74,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ЗА ЕГО СЛОВАМИ СТОИТ РЕАЛЬНАЯ ВОЕННАЯ СИЛА. И
Dialogue: 0,0:09:12.74,0:09:15.30,Caption,,0,0,0,,ТАЙВАНЬ ДЛЯ ПЕКИНА НЕ ГАЗЕТНАЯ ТЕМА. И ВОТ
Dialogue: 0,0:09:15.38,0:09:17.62,Caption,,0,0,0,,ЗДЕСЬ НАЧИНАЕТСЯ ОЧЕНЬ НЕУДОБНЫЙ РАЗГОВОР О
Dialogue: 0,0:09:17.62,0:09:20.90,Caption,,0,0,0,,ПРАВИЛАХ. СОЕДИНЁННЫЕ ШТАТЫ ИМЕЮТ СВОИ ПРЕДСТАВЛЕНИЯ
Dialogue: 0,0:09:20.90,0:09:24.02,Caption,,0,0,0,,О ТОМ, ЧТО ЯВЛЯЕТСЯ УГРОЗОЙ АМЕРИКАНСКОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:09:24.20,0:09:27.78,Caption,,0,0,0,,КИТАЙ ИМЕЕТ СВОИ. РОССИЯ ИМЕЕТ СВОИ. НО ПОЧЕМУ
Dialogue: 0,0:09:27.86,0:09:30.26,Caption,,0,0,0,,ТО УНИВЕРСАЛЬНОГО ПРАВИЛА ДО СИХ ПОР НЕ ПРИДУМАЛИ.
Dialogue: 0,0:09:30.42,0:09:34.50,Caption,,0,0,0,,КОГДА АМЕРИКАНЦЫ СЧИТАЮТ, ЧТО ГДЕ ТО РЯДОМ ВОЗНИКЛА УГРОЗА ИХ ИНТЕРЕСАМ,
Dialogue: 0,0:09:34.82,0:09:37.70,Caption,,0,0,0,,ОНИ ДЕЙСТВУЮТ ДОВОЛЬНО РЕШИТЕЛЬНО. ПОСЛЕ КИТАЯ ОЧЕНЬ
Dialogue: 0,0:09:37.70,0:09:40.26,Caption,,0,0,0,,КСТАТИ ПОЯВЛЯЕТСЯ МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ СУД.
Dialogue: 0,0:09:40.66,0:09:43.46,Caption,,0,0,0,,ОБСУЖДАЕТСЯ ВОЗМОЖНОЕ ИЗМЕНЕНИЕ ПРАВИЛ ЮРИСДИКЦИИ
Dialogue: 0,0:09:43.46,0:09:45.62,Caption,,0,0,0,,МЕЖДУНАРОДНОГО УГОЛОВНОГО СУДА В ОТНОШЕНИИ
Dialogue: 0,0:09:45.62,0:09:50.34,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ ГОСУДАРСТВ. В ЭТОМ РАЗГОВОРЕ ФИГУРИРУЮТ ВАШИНГТОН И НИДЕРЛАНДЫ.
Dialogue: 0,0:09:50.74,0:09:53.06,Caption,,0,0,0,,И ЗДЕСЬ ПРОСМАТРИВАЕТСЯ ГОРАЗДО БОЛЕЕ ШИРОКАЯ
Dialogue: 0,0:09:53.06,0:09:58.46,Caption,,0,0,0,,ЛОГИКА. ТРАМП ПОСЛЕДОВАТЕЛЬНО РАЗБИРАЕТ МЕХАНИЗМЫ СТАРОГО
Dialogue: 0,0:09:58.46,0:10:01.66,Caption,,0,0,0,,МЕЖДУНАРОДНОГО ПОРЯДКА. ДО ЭТОГО ВАШИНГТОН УЖЕ МЕНЯЛ
Dialogue: 0,0:10:01.66,0:10:06.70,Caption,,0,0,0,,ОТНОШЕНИЕ К ВОЗ, ЮНЕСКО, ПАРИЖСКОМУ СОГЛАШЕНИЮ. ТЕПЕРЬ РЕЧЬ ИДЁТ ЕЩЁ И О
Dialogue: 0,0:10:06.78,0:10:10.06,Caption,,0,0,0,,ГААГЕ. НАСКОЛЬКО ДАЛЕКО ЗАЙДУТ ИЗМЕНЕНИЯ ВОКРУГ МУС,
Dialogue: 0,0:10:10.17,0:10:13.18,Caption,,0,0,0,,ПОКАЖУТ САМИ РЕШЕНИЯ. НО НАПРАВЛЕНИЕ ИНТЕРЕСНО.
Dialogue: 0,0:10:13.50,0:10:16.38,Caption,,0,0,0,,ТРАМП НЕ ПРОСТО ПЫТАЕТСЯ ВЫИГРАТЬ ОДИН СПОР. ОН
Dialogue: 0,0:10:16.38,0:10:20.30,Caption,,0,0,0,,МЕНЯЕТ ТЕ ПРАВИЛА, КОТОРЫЕ СЧИТАЕТ НЕУДОБНЫМИ ИЛИ ВРЕДНЫМИ ДЛЯ
Dialogue: 0,0:10:20.30,0:10:22.70,Caption,,0,0,0,,АМЕРИКАНСКИХ ИНТЕРЕСОВ. А ТЕПЕРЬ СМОТРИМ,
Dialogue: 0,0:10:22.94,0:10:28.22,Caption,,0,0,0,,КАК ЭТА ЛОГИКА РАБОТАЕТ ТАМ, ГДЕ АМЕРИКАНСКИЕ ИНТЕРЕСЫ ЗАТРОНУТЫ НАПРЯМУЮ. ИРАН.
Dialogue: 0,0:10:29.02,0:10:31.34,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ СООБЩЕНИЯ О ЗНАЧИТЕЛЬНОМ УСИЛЕНИИ
Dialogue: 0,0:10:31.34,0:10:33.74,Caption,,0,0,0,,АМЕРИКАНСКОЙ АВИАЦИОННОЙ ИНФРАСТРУКТУРЫ ВОКРУГ
Dialogue: 0,0:10:33.74,0:10:36.46,Caption,,0,0,0,,ИРАНА. РЕЧЬ ИДЁТ О БОЛЬШОМ КОЛИЧЕСТВЕ САМОЛЁТОВ
Dialogue: 0,0:10:36.46,0:10:39.74,Caption,,0,0,0,,ЗАПРАВЩИКОВ И РАЗВЕДЫВАТЕЛЬНОЙ АВИАЦИИ. САМО НАЛИЧИЕ
Dialogue: 0,0:10:39.74,0:10:42.30,Caption,,0,0,0,,ЭТИХ СИЛ ЕЩЁ НЕ ОЗНАЧАЕТ АВТОМАТИЧЕСКОГО НАЧАЛА
Dialogue: 0,0:10:42.38,0:10:44.62,Caption,,0,0,0,,НОВОЙ ОПЕРАЦИИ. НО ОНО ПОКАЗЫВАЕТ,
Dialogue: 0,0:10:44.79,0:10:47.58,Caption,,0,0,0,,ЧТО ТЕХНИЧЕСКИЕ ВОЗМОЖНОСТИ ДЛЯ СЕРЬЁЗНОЙ КАМПАНИИ
Dialogue: 0,0:10:47.58,0:10:51.82,Caption,,0,0,0,,СОЗДАЮТСЯ ЗАРАНЕЕ. И ТУТ ВОЗНИКАЕТ ГОРАЗДО БОЛЕЕ ИНТЕРЕСНЫЙ ВОПРОС.
Dialogue: 0,0:10:52.22,0:10:54.78,Caption,,0,0,0,,ПОСЛЕ ПРЕДЫДУЩИХ АМЕРИКАНСКИХ И ИЗРАИЛЬСКИХ УДАРОВ
Dialogue: 0,0:10:54.86,0:10:57.58,Caption,,0,0,0,,ПО ИРАНУ ЗВУЧАЛИ ОЧЕНЬ ГРОМКИЕ ЗАЯВЛЕНИЯ ОБ
Dialogue: 0,0:10:57.58,0:11:00.06,Caption,,0,0,0,,УНИЧТОЖЕНИИ ОГРОМНОЙ ЧАСТИ ИРАНСКОЙ ВОЕННОЙ
Dialogue: 0,0:11:00.06,0:11:02.70,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ. ПРИ ЭТОМ ЗВУЧИТ ОЦЕНКА ИРАН
Dialogue: 0,0:11:02.70,0:11:05.50,Caption,,0,0,0,,ПРОДОЛЖАЕТ ВЫПУСКАТЬ ОКОЛО ПЯТИДЕСЯТИ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:11:05.50,0:11:09.20,Caption,,0,0,0,,РАКЕТ ЕЖЕМЕСЯЧНО. ДА,
Dialogue: 0,0:11:09.35,0:11:12.56,Caption,,0,0,0,,ТЕМП НИЖЕ ДОВОЕННОГО ПРИМЕРНО ВДВОЕ. НО ПРОИЗВОДСТВО
Dialogue: 0,0:11:12.56,0:11:15.36,Caption,,0,0,0,,НЕ ИСЧЕЗЛО. ЗНАЧИТ, ВОПРОС УЖЕ НЕ В ТОМ,
Dialogue: 0,0:11:15.52,0:11:18.08,Caption,,0,0,0,,СКОЛЬКО ЗДАНИЙ РАЗРУШИЛИ. ВОПРОС В ТОМ,
Dialogue: 0,0:11:18.25,0:11:21.52,Caption,,0,0,0,,ДОСТИГНУТА ЛИ СТРАТЕГИЧЕСКАЯ ЦЕЛЬ. ЕСЛИ ПРОТИВНИК
Dialogue: 0,0:11:21.52,0:11:23.84,Caption,,0,0,0,,ПОСЛЕ УДАРОВ СОХРАНЯЕТ СПОСОБНОСТЬ ПРОИЗВОДИТЬ
Dialogue: 0,0:11:23.84,0:11:27.28,Caption,,0,0,0,,РАКЕТЫ, УГРОЖАТЬ АМЕРИКАНСКИМ БАЗАМ И ВЕСТИ ПЕРЕГОВОРЫ С
Dialogue: 0,0:11:27.28,0:11:30.32,Caption,,0,0,0,,ПОЗИЦИИ ГОСУДАРСТВА, КОТОРОЕ ЕЩЁ СПОСОБНО ОТВЕЧАТЬ,
Dialogue: 0,0:11:30.83,0:11:33.36,Caption,,0,0,0,,ТО ОДНОЙ КРАСИВОЙ ЦИФРЫ ПРО ПРОЦЕНТЫ РАЗРУШЕННОЙ
Dialogue: 0,0:11:33.36,0:11:36.16,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ ЯВНО НЕДОСТАТОЧНО. ПАРАЛЛЕЛЬНО
Dialogue: 0,0:11:36.16,0:11:39.36,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ КАТАРСКОЕ ПРЕДЛОЖЕНИЕ ИРАНУ. И ВОТ ТАМ
Dialogue: 0,0:11:39.36,0:11:44.96,Caption,,0,0,0,,ОСОБЕННО ХОРОШО ВИДНО, НАСКОЛЬКО ВСЁ СВЯЗАНО. ОБОГАЩЕНИЕ УРАНА. РАЗБАВЛЕНИЕ
Dialogue: 0,0:11:44.96,0:11:47.36,Caption,,0,0,0,,НАКОПЛЕННОГО ВЫСОКООБОГАЩЁННОГО МАТЕРИАЛА.
Dialogue: 0,0:11:47.73,0:11:50.96,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ ИНСПЕКЦИИ. СНЯТИЕ АМЕРИКАНСКОЙ МОРСКОЙ
Dialogue: 0,0:11:50.96,0:11:53.84,Caption,,0,0,0,,БЛОКАДЫ. РАЗМОРОЗКА ЧАСТИ ИРАНСКИХ АКТИВОВ.
Dialogue: 0,0:11:54.16,0:11:57.12,Caption,,0,0,0,,ОРМУЗСКИЙ ПРОЛИВ. ОТНОШЕНИЯ САУДОВСКОЙ АРАВИИ С
Dialogue: 0,0:11:57.12,0:12:00.08,Caption,,0,0,0,,ХУСИТАМИ. ТО ЕСТЬ ЯДЕРНЫЙ ВОПРОС УЖЕ НЕ ЛЕЖИТ
Dialogue: 0,0:12:00.08,0:12:03.12,Caption,,0,0,0,,ОТДЕЛЬНО В КРАСИВОЙ КОРОБОЧКЕ С НАДПИСЬЮ "АТОМ". ОН
Dialogue: 0,0:12:03.12,0:12:05.84,Caption,,0,0,0,,СВЯЗАН С ДЕНЬГАМИ, МОРСКИМИ КОММУНИКАЦИЯМИ,
Dialogue: 0,0:12:06.00,0:12:10.64,Caption,,0,0,0,,РЕГИОНАЛЬНЫМИ СОЮЗНИКАМИ, НЕФТЬЮ И БЕЗОПАСНОСТЬЮ СОСЕДЕЙ. ИРАН В ОТВЕТ
Dialogue: 0,0:12:10.64,0:12:14.16,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ, ЧТО ЕСЛИ ЕВРОПЕЙСКИЕ СТРАНЫ РАЗРЕШАТ ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:12:14.16,0:12:16.32,Caption,,0,0,0,,СВОЮ ТЕРРИТОРИЮ ДЛЯ АМЕРИКАНСКИХ АТАК,
Dialogue: 0,0:12:16.64,0:12:19.36,Caption,,0,0,0,,ТО АМЕРИКАНСКИЕ ВОЕННЫЕ БАЗЫ В ЕВРОПЕ МОГУТ СТАТЬ
Dialogue: 0,0:12:19.36,0:12:22.24,Caption,,0,0,0,,ЦЕЛЯМИ. ВОТ И ЕЩЁ ОДНА ПРЕКРАСНАЯ ЕВРОПЕЙСКАЯ
Dialogue: 0,0:12:22.32,0:12:26.04,Caption,,0,0,0,,ИСТОРИЯ. ЕВРОПА ПЕРЕЖИВАЕТ,
Dialogue: 0,0:12:26.28,0:12:29.08,Caption,,0,0,0,,ЧТО ТРАМП ДОГОВОРИТСЯ С ПУТИНЫМ БЕЗ НЕЁ. НО
Dialogue: 0,0:12:29.08,0:12:31.40,Caption,,0,0,0,,ОДНОВРЕМЕННО ЕВРОПЕЙСКАЯ ТЕРРИТОРИЯ СПОСОБНА
Dialogue: 0,0:12:31.40,0:12:34.52,Caption,,0,0,0,,ОКАЗАТЬСЯ ЧАСТЬЮ АМЕРИКАНСКОГО КОНФЛИКТА С ИРАНОМ. С
Dialogue: 0,0:12:34.60,0:12:39.16,Caption,,0,0,0,,ОДНОЙ СТОРОНЫ, ПОЖАЛУЙСТА, НЕ ПРИНИМАЙТЕ РЕШЕНИЯ БЕЗ НАС. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:12:39.33,0:12:41.96,Caption,,0,0,0,,ЕСЛИ США ИСПОЛЬЗУЮТ БАЗЫ НА ВАШЕЙ ТЕРРИТОРИИ,
Dialogue: 0,0:12:42.20,0:12:45.08,Caption,,0,0,0,,ПОСЛЕДСТВИЯ УЖЕ СТАНОВЯТСЯ ВАШИМИ. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:12:45.08,0:12:48.12,Caption,,0,0,0,,КОНСТРУКЦИЯ. А ТЕПЕРЬ КУБА. КУБИНСКИЕ ВЛАСТИ
Dialogue: 0,0:12:48.12,0:12:50.76,Caption,,0,0,0,,ПЕРЕВОДЯТ СТРАНУ НА РЕГУЛЯРНЫЕ ОБОРОННЫЕ ТРЕНИРОВКИ.
Dialogue: 0,0:12:51.08,0:12:53.56,Caption,,0,0,0,,ГРАЖДАНСКОЕ НАСЕЛЕНИЕ ПРИВЛЕКАЮТ К ПОДГОТОВКЕ.
Dialogue: 0,0:12:54.04,0:12:58.44,Caption,,0,0,0,,ГАВАНА ИСХОДИТ ИЗ ТОГО, ЧТО АМЕРИКАНСКАЯ УГРОЗА РЕАЛЬНА. ПОСЛЕ СОБЫТИЙ В
Dialogue: 0,0:12:58.44,0:13:01.24,Caption,,0,0,0,,ВЕНЕСУЭЛЕ КУБА ПОТЕРЯЛА ВАЖНЕЙШУЮ ОПОРУ. С
Dialogue: 0,0:13:01.24,0:13:04.52,Caption,,0,0,0,,ПОСТАВКАМИ НЕФТИ СТАЛО ХУЖЕ. ЭНЕРГЕТИЧЕСКАЯ СИТУАЦИЯ
Dialogue: 0,0:13:04.52,0:13:06.84,Caption,,0,0,0,,ТЯЖЁЛАЯ. НА ЭТОМ ФОНЕ ТРАМП ГОВОРИТ,
Dialogue: 0,0:13:07.08,0:13:09.32,Caption,,0,0,0,,ЧТО ХОТЕЛ БЫ РЕШИТЬ КУБИНСКИЙ ВОПРОС ДО КОНЦА
Dialogue: 0,0:13:09.40,0:13:11.80,Caption,,0,0,0,,СВОЕГО ПРЕЗИДЕНТСКОГО СРОКА И НЕ ИСКЛЮЧАЕТ
Dialogue: 0,0:13:11.80,0:13:15.00,Caption,,0,0,0,,ПРИМЕНЕНИЯ СИЛЫ. ОТДЕЛЬНО ПОЯВЛЯЕТСЯ МАРКО РУБИО,
Dialogue: 0,0:13:15.32,0:13:17.72,Caption,,0,0,0,,У КОТОРОГО КУБИНСКАЯ ТЕМА ИМЕЕТ ЕЩЁ И ЛИЧНЫЙ
Dialogue: 0,0:13:17.72,0:13:20.60,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ВЕС. И ВОТ ЗДЕСЬ ВСЯ ИСТОРИЯ НАКОНЕЦ
Dialogue: 0,0:13:20.60,0:13:25.40,Caption,,0,0,0,,ЗАМЫКАЕТСЯ. АМЕРИКА СЧИТАЕТ, ЧТО ИМЕЕТ ПРАВО ЗАНИМАТЬСЯ УГРОЗАМИ СОБСТВЕННОЙ
Dialogue: 0,0:13:25.40,0:13:28.36,Caption,,0,0,0,,БЕЗОПАСНОСТИ. И ЭТО НОРМАЛЬНО С ТОЧКИ ЗРЕНИЯ САМОЙ
Dialogue: 0,0:13:28.44,0:13:31.40,Caption,,0,0,0,,АМЕРИКИ. ИРАН ПРЕДСТАВЛЯЕТ УГРОЗУ. ЗНАЧИТ,
Dialogue: 0,0:13:31.64,0:13:33.72,Caption,,0,0,0,,ВОКРУГ НЕГО МОЖНО СОБИРАТЬ АВИАЦИЮ,
Dialogue: 0,0:13:33.80,0:13:37.24,Caption,,0,0,0,,ВВОДИТЬ БЛОКАДУ, ТРЕБОВАТЬ ОГРАНИЧЕНИЯ ЯДЕРНОЙ ПРОГРАММЫ.
Dialogue: 0,0:13:39.53,0:13:41.69,Caption,,0,0,0,,КУБА ПРЕДСТАВЛЯЕТ ПРОБЛЕМУ ДЛЯ АМЕРИКАНСКИХ
Dialogue: 0,0:13:41.69,0:13:45.45,Caption,,0,0,0,,ИНТЕРЕСОВ. ЗНАЧИТ, НА НЕЁ МОЖНО ДАВИТЬ ЭКОНОМИЧЕСКИ И ПУБЛИЧНО
Dialogue: 0,0:13:45.45,0:13:48.41,Caption,,0,0,0,,РАССУЖДАТЬ О СИЛОВОМ СЦЕНАРИИ. НО ТОГДА ВОЗНИКАЕТ
Dialogue: 0,0:13:48.41,0:13:51.45,Caption,,0,0,0,,ВОПРОС, ОТ КОТОРОГО УЖЕ НЕ ПОЛУЧИТСЯ ОТДЕЛАТЬСЯ ПРИВЫЧНЫМИ
Dialogue: 0,0:13:51.45,0:13:54.49,Caption,,0,0,0,,ЛОЗУНГАМИ. ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ ИМЕЮТ ПРАВО
Dialogue: 0,0:13:54.49,0:13:57.29,Caption,,0,0,0,,СЧИТАТЬ ОПАСНОЙ СИТУАЦИЮ ВОЗЛЕ СОБСТВЕННЫХ ГРАНИЦ,
Dialogue: 0,0:13:57.61,0:14:00.01,Caption,,0,0,0,,ПОЧЕМУ ТАКОЕ ПРАВО АВТОМАТИЧЕСКИ ИСЧЕЗАЕТ У
Dialogue: 0,0:14:00.01,0:14:03.53,Caption,,0,0,0,,ОСТАЛЬНЫХ? КИТАЙ ДЕСЯТИЛЕТИЯМИ ГОВОРИТ О ТАЙВАНЕ КАК О ВОПРОСЕ
Dialogue: 0,0:14:03.53,0:14:05.61,Caption,,0,0,0,,СОБСТВЕННОЙ БЕЗОПАСНОСТИ И ТЕРРИТОРИАЛЬНОЙ
Dialogue: 0,0:14:05.61,0:14:08.49,Caption,,0,0,0,,ЦЕЛОСТНОСТИ. РОССИЯ ДЕСЯТИЛЕТИЯМИ ГОВОРИЛА О
Dialogue: 0,0:14:08.57,0:14:10.97,Caption,,0,0,0,,РАСШИРЕНИИ НАТО И ВОЕННОЙ ИНФРАСТРУКТУРЕ У СВОИХ
Dialogue: 0,0:14:10.97,0:14:14.65,Caption,,0,0,0,,ГРАНИЦ. МОЖНО СПОРИТЬ С ЭТИМИ ПОЗИЦИЯМИ. МОЖНО ИХ НЕ
Dialogue: 0,0:14:14.65,0:14:17.69,Caption,,0,0,0,,ПРИНИМАТЬ. МОЖНО СЧИТАТЬ ДЕЙСТВИЯ МОСКВЫ ИЛИ ПЕКИНА
Dialogue: 0,0:14:17.69,0:14:20.17,Caption,,0,0,0,,НЕПРАВИЛЬНЫМИ. НО ЕСЛИ МЫ ДЕЙСТВИТЕЛЬНО ХОТИМ
Dialogue: 0,0:14:20.17,0:14:22.49,Caption,,0,0,0,,ПОЛУЧИТЬ РАБОТАЮЩУЮ СИСТЕМУ БЕЗОПАСНОСТИ,
Dialogue: 0,0:14:22.88,0:14:25.29,Caption,,0,0,0,,ПРАВИЛО ДОЛЖНО БЫТЬ ХОТЯ БЫ ПОНЯТНЫМ ДЛЯ ВСЕХ.
Dialogue: 0,0:14:25.61,0:14:28.41,Caption,,0,0,0,,ПОТОМУ ЧТО КОНСТРУКЦИЯ "МОИ УГРОЗЫ НАСТОЯЩИЕ,
Dialogue: 0,0:14:28.57,0:14:31.69,Caption,,0,0,0,,А ТВОИ ПРИДУМАННЫЕ" ПРЕКРАСНО РАБОТАЕТ РОВНО ДО ТОГО
Dialogue: 0,0:14:31.77,0:14:34.97,Caption,,0,0,0,,МОМЕНТА, ПОКА ВТОРАЯ СТОРОНА НЕ РЕШАЕТ ДЕЙСТВОВАТЬ ПО ТЕМ
Dialogue: 0,0:14:34.97,0:14:38.49,Caption,,0,0,0,,ЖЕ ПРАВИЛАМ, ТОЛЬКО УЖЕ В СОБСТВЕННЫХ ИНТЕРЕСАХ. И ВОТ ПОЭТОМУ
Dialogue: 0,0:14:38.49,0:14:41.13,Caption,,0,0,0,,РАЗГОВОР РОССИИ И США ОБ УСТРАНЕНИИ ПЕРВОПРИЧИН
Dialogue: 0,0:14:41.21,0:14:43.61,Caption,,0,0,0,,ГОРАЗДО ВАЖНЕЕ, ЧЕМ ВЫГЛЯДИТ НА ПЕРВЫЙ ВЗГЛЯД.
Dialogue: 0,0:14:45.88,0:14:48.68,Caption,,0,0,0,,ЕСЛИ ПОД ПЕРВОПРИЧИНАМИ ПОНИМАЕТСЯ ТОЛЬКО УКРАИНА,
Dialogue: 0,0:14:48.92,0:14:51.56,Caption,,0,0,0,,СТОРОНЫ ОПЯТЬ БУДУТ БЕСКОНЕЧНО ТОРГОВАТЬСЯ ВОКРУГ
Dialogue: 0,0:14:51.56,0:14:53.96,Caption,,0,0,0,,ТЕРРИТОРИЙ, ПЕРЕМИРИЙ И ФОРМУЛИРОВОК.
Dialogue: 0,0:14:54.52,0:14:56.92,Caption,,0,0,0,,ЕСЛИ РАЗГОВОР ДЕЙСТВИТЕЛЬНО ДОШЁЛ ДО НАТО,
Dialogue: 0,0:14:57.09,0:14:59.96,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ, ЯДЕРНЫХ ПРАВИЛ,
Dialogue: 0,0:15:00.25,0:15:02.84,Caption,,0,0,0,,КИТАЯ, ИРАНА И ВЗАИМНЫХ ОГРАНИЧЕНИЙ,
Dialogue: 0,0:15:03.16,0:15:05.40,Caption,,0,0,0,,ТОГДА РЕЧЬ ИДЁТ УЖЕ О ДРУГОЙ ЗАДАЧЕ. НЕ
Dialogue: 0,0:15:05.48,0:15:08.28,Caption,,0,0,0,,ЗАКОНЧИТЬ ОДИН КОНФЛИКТ. А ДОГОВОРИТЬСЯ,
Dialogue: 0,0:15:08.58,0:15:11.24,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЕТСЯ БЕЗОПАСНОСТЬ ОДНОЙ ДЕРЖАВЫ И
Dialogue: 0,0:15:11.24,0:15:14.20,Caption,,0,0,0,,НАЧИНАЕТСЯ БЕЗОПАСНОСТЬ ДРУГОЙ. ПОТОМУ ЧТО ПОКА
Dialogue: 0,0:15:14.20,0:15:17.08,Caption,,0,0,0,,КАЖДЫЙ ИМЕЕТ ПРАВО НА БЕЗОПАСНОСТЬ ТОЛЬКО ТОГДА,
Dialogue: 0,0:15:17.32,0:15:19.88,Caption,,0,0,0,,КОГДА ЭТО УСТРАИВАЕТ САМОГО СИЛЬНОГО ИГРОКА,
Dialogue: 0,0:15:20.21,0:15:22.76,Caption,,0,0,0,,НОВЫЕ КОНФЛИКТЫ БУДУТ ПОЯВЛЯТЬСЯ БЫСТРЕЕ,
Dialogue: 0,0:15:22.95,0:15:25.80,Caption,,0,0,0,,ЧЕМ ПОЛИТИКИ УСПЕВАЮТ ОБЪЯВЛЯТЬ ОБ ОКОНЧАНИИ СТАРЫХ.
