Dialogue: 0,0:00:00.07,0:00:02.04,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРИЕХАЛ УЧИТЬ НЕМЦЕВ
Dialogue: 0,0:00:02.04,0:00:05.31,Caption,,0,0,0,,ИСТОРИИ. ДА ЕЩЁ И ИСТОРИИ ПОСЛЕДНИХ СТА ЛЕТ. ВОТ УЖ
Dialogue: 0,0:00:05.31,0:00:08.04,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО НАШЁЛ КОМУ И О ЧЁМ РАССКАЗЫВАТЬ!
Dialogue: 0,0:00:08.19,0:00:12.53,Caption,,0,0,0,,НЕМЦЫ, НАДО ПОЛАГАТЬ, СЛУШАЛИ ОЧЕНЬ ВНИМАТЕЛЬНО. НО ИСТОРИЯ
Dialogue: 0,0:00:12.53,0:00:15.07,Caption,,0,0,0,,ИСТОРИЕЙ, А ВОТ С ГЕОГРАФИЕЙ У ЭТОЙ КОМПАНИИ
Dialogue: 0,0:00:15.07,0:00:18.04,Caption,,0,0,0,,ОБНАРУЖИЛАСЬ ЕЩЁ БОЛЕЕ ЗАНЯТНАЯ ШТУКА. КСТАТИ,
Dialogue: 0,0:00:18.36,0:00:19.96,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР,
Dialogue: 0,0:00:20.20,0:00:22.19,Caption,,0,0,0,,ГДЕ МЫ НЕ ПЕРЕСКАЗЫВАЕМ ЗАЯВЛЕНИЯ ПО
Dialogue: 0,0:00:22.19,0:00:24.84,Caption,,0,0,0,,КРУГУ, А ПЫТАЕМСЯ ПОНЯТЬ, ЧТО ЗА НИМИ СТОИТ,
Dialogue: 0,0:00:24.99,0:00:27.40,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:27.64,0:00:29.61,Caption,,0,0,0,,КОГДА ОДНА ФРАЗА ПОЛИТИКА НАЧИНАЕТ
Dialogue: 0,0:00:29.61,0:00:31.32,Caption,,0,0,0,,ИГРАТЬ СОВСЕМ ДРУГИМИ КРАСКАМИ,
Dialogue: 0,0:00:31.64,0:00:33.57,Caption,,0,0,0,,ЕСЛИ ПОСТАВИТЬ РЯДОМ С НЕЙ ДРУГУЮ.
Dialogue: 0,0:00:33.57,0:00:35.16,Caption,,0,0,0,,ЗЕЛЕНСКИЙ В БЕРЛИНЕ РАССКАЗАЛ,
Dialogue: 0,0:00:35.32,0:00:37.44,Caption,,0,0,0,,ЧТО УКРАИНА ДЕСЯТКИ РАЗ ПРЕДЛАГАЛА
Dialogue: 0,0:00:37.44,0:00:39.48,Caption,,0,0,0,,СНИЗИТЬ ИНТЕНСИВНОСТЬ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:00:39.64,0:00:43.66,Caption,,0,0,0,,А РОССИЯ, ПО ЕГО СЛОВАМ, НЕ ДАЛА НИ ОДНОГО МИРНОГО ОТВЕТА. НУ
Dialogue: 0,0:00:43.66,0:00:46.90,Caption,,0,0,0,,ХОРОШО. ДОПУСТИМ, СЛУШАЕМ ДАЛЬШЕ. А ДАЛЬШЕ ТОТ ЖЕ
Dialogue: 0,0:00:46.90,0:00:48.60,Caption,,0,0,0,,ЗЕЛЕНСКИЙ НАЧИНАЕТ РАССКАЗЫВАТЬ,
Dialogue: 0,0:00:48.90,0:00:51.16,Caption,,0,0,0,,КАК РОССИЯ ОЩУЩАЕТ УКРАИНСКИЙ ОТВЕТ ОТ
Dialogue: 0,0:00:51.16,0:00:54.41,Caption,,0,0,0,,ЗАПАДНОЙ СИБИРИ, ГДЕ ГОРЯТ НЕФТЕПЕРЕРАБАТЫВАЮЩИЕ
Dialogue: 0,0:00:54.41,0:00:56.76,Caption,,0,0,0,,ЗАВОДЫ, ДО ПОБЕРЕЖЬЯ ЛИВИИ, ГДЕ,
Dialogue: 0,0:00:56.84,0:00:59.76,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ТОНУТ РОССИЙСКИЕ КОРАБЛИ. ТО ЕСТЬ
Dialogue: 0,0:00:59.76,0:01:03.52,Caption,,0,0,0,,ТОЛЬКО ЧТО ЧЕЛОВЕК ЖАЛОВАЛСЯ, ЧТО МОСКВА НЕ ОТВЕЧАЕТ НА МИРНЫЕ
Dialogue: 0,0:01:03.52,0:01:05.86,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯ, А ЧЕРЕЗ НЕСКОЛЬКО МИНУТ УЖЕ
Dialogue: 0,0:01:05.86,0:01:09.16,Caption,,0,0,0,,ПЕРЕЧИСЛЯЕТ ГЕОГРАФИЮ УДАРОВ. ОТЛИЧНАЯ ПЕРЕГОВОРНАЯ ШКОЛА.
Dialogue: 0,0:01:11.43,0:01:14.87,Caption,,0,0,0,,ПРИШЁЛ ДОГОВАРИВАТЬСЯ, ПОЛОЖИЛ НА СТОЛ МИРНОЕ ПРЕДЛОЖЕНИЕ,
Dialogue: 0,0:01:15.16,0:01:16.87,Caption,,0,0,0,,А РЯДОМ АККУРАТНО ПОЛОЖИЛ КАРТУ,
Dialogue: 0,0:01:17.03,0:01:19.01,Caption,,0,0,0,,КУДА ЕЩЁ СОБИРАЕШЬСЯ ДОТЯНУТЬСЯ.
Dialogue: 0,0:01:19.01,0:01:21.71,Caption,,0,0,0,,ТОЛЬКО ДЛЯ САМОЙ УКРАИНЫ ЦЕНА ТАКОЙ ИГРЫ МОЖЕТ
Dialogue: 0,0:01:21.71,0:01:25.48,Caption,,0,0,0,,ОКАЗАТЬСЯ ЕЩЁ ТЯЖЕЛЕЕ. ВМЕСТО УСЛОВИЙ МИРА ПРИДЁТСЯ ОБСУЖДАТЬ
Dialogue: 0,0:01:25.48,0:01:28.49,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ОЧЕРЕДНОЙ АВАНТЮРЫ. ПРИЧЁМ УЖЕ НА КУДА
Dialogue: 0,0:01:28.49,0:01:30.51,Caption,,0,0,0,,ХУДШИХ УСЛОВИЯХ. И ВЕДЬ ЭТИМ ДЕЛО НЕ
Dialogue: 0,0:01:30.51,0:01:33.03,Caption,,0,0,0,,ОГРАНИЧИВАЕТСЯ. ПОСТОЯННО ЗВУЧАТ УГРОЗЫ,
Dialogue: 0,0:01:33.19,0:01:34.96,Caption,,0,0,0,,В ТОМ ЧИСЛЕ ПРЯМЫЕ УГРОЗЫ ЖИЗНИ
Dialogue: 0,0:01:34.96,0:01:38.02,Caption,,0,0,0,,ПУТИНА, ЖИЗНИ ПРЕЗИДЕНТА РОССИИ. НО ИСТОЧНИК
Dialogue: 0,0:01:38.02,0:01:41.02,Caption,,0,0,0,,УГРОЗЫ ПОЧЕМУ ТО ОПЯТЬ РОССИЯ. ВОТ ЭТО УДОБНАЯ
Dialogue: 0,0:01:41.02,0:01:43.67,Caption,,0,0,0,,КОНСТРУКЦИЯ. ТЫ УГРОЖАЕШЬ, ТЫ РАССКАЗЫВАЕШЬ,
Dialogue: 0,0:01:43.84,0:01:46.39,Caption,,0,0,0,,КУДА ДОСТАЁШЬ, ТЫ ОБЕЩАЕШЬ ПРОДОЛЖЕНИЕ,
Dialogue: 0,0:01:46.71,0:01:48.50,Caption,,0,0,0,,А ПОТОМ ПОВОРАЧИВАЕШЬСЯ К ЕВРОПЕЙЦАМ И
Dialogue: 0,0:01:48.50,0:01:52.06,Caption,,0,0,0,,ГОВОРИШЬ СМОТРИТЕ, КАКАЯ ОПАСНАЯ СТРАНА НАПРОТИВ. И ВСЕ
Dialogue: 0,0:01:52.06,0:01:54.39,Caption,,0,0,0,,СЕРЬЁЗНО КИВАЮТ. МНЕ ВОТ ИНТЕРЕСНО,
Dialogue: 0,0:01:54.48,0:01:57.35,Caption,,0,0,0,,ЕСЛИ БЫ ПУТИН ВЫШЕЛ И НАЧАЛ РАССКАЗЫВАТЬ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:01:57.35,0:02:00.25,Caption,,0,0,0,,АУДИТОРИИ, ГДЕ КОНКРЕТНО МОГУТ ГОРЕТЬ ОБЪЕКТЫ ОТ
Dialogue: 0,0:02:00.25,0:02:02.07,Caption,,0,0,0,,ОДНОГО КРАЯ ЕВРОПЫ ДО ДРУГОГО,
Dialogue: 0,0:02:02.37,0:02:05.51,Caption,,0,0,0,,А ПОТОМ ДОБАВИЛ БЫ, ЧТО ВООБЩЕ ТО ЭТО РОССИЯ ХОЧЕТ МИРА,
Dialogue: 0,0:02:05.86,0:02:07.59,Caption,,0,0,0,,СКОЛЬКО СЕКУНД ПОНАДОБИЛОСЬ БЫ,
Dialogue: 0,0:02:07.85,0:02:09.73,Caption,,0,0,0,,ЧТОБЫ ЗАГОЛОВКИ ЗАПОЛНИЛИСЬ СЛОВОМ
Dialogue: 0,0:02:09.73,0:02:13.20,Caption,,0,0,0,,"УГРОЗА"? ДУМАЮ, СЕКУНДОМЕР МОЖНО БЫЛО БЫ ДАЖЕ НЕ
Dialogue: 0,0:02:13.20,0:02:16.27,Caption,,0,0,0,,ВКЛЮЧАТЬ. НО ЗЕЛЕНСКИЙ ПОШЁЛ ДАЛЬШЕ. ЗА ПОСЛЕДНИЕ
Dialogue: 0,0:02:16.27,0:02:19.63,Caption,,0,0,0,,СТО ЛЕТ, ГОВОРИТ ОН, РОССИЯ ТОЛЬКО НЕСКОЛЬКО ЛЕТ НЕ
Dialogue: 0,0:02:19.63,0:02:24.90,Caption,,0,0,0,,ПРЕДСТАВЛЯЛА УГРОЗЫ. И НЕТ НИКАКИХ ОСНОВАНИЙ РАССЧИТЫВАТЬ,
Dialogue: 0,0:02:25.22,0:02:27.07,Caption,,0,0,0,,ЧТО ЧЕРЕЗ ГОД ИЛИ ПЯТЬ РОССИЯ ВДРУГ
Dialogue: 0,0:02:27.07,0:02:30.74,Caption,,0,0,0,,СТАНЕТ ДРУГОЙ. ВОЛОДЯ, А ПОЧЕМУ ЖЕ ТЫ НЕ ВСПОМНИЛ О ТОМ,
Dialogue: 0,0:02:30.98,0:02:32.94,Caption,,0,0,0,,КТО В ПОСЛЕДНИЕ СТО ЛЕТ РАЗВЯЗЫВАЛ
Dialogue: 0,0:02:32.94,0:02:34.74,Caption,,0,0,0,,КРУПНЕЙШИЕ ВОЙНЫ В САМОЙ ЕВРОПЕ?
Dialogue: 0,0:02:35.06,0:02:37.94,Caption,,0,0,0,,ЭТО НЕ ТЕ СОЮЗНИКИ, С КОТОРЫМИ ТЫ СЕЙЧАС ВАСЬ ВАСЬ?
Dialogue: 0,0:02:38.34,0:02:40.21,Caption,,0,0,0,,ТЫ СТОИШЬ В БЕРЛИНЕ И РАССКАЗЫВАЕШЬ
Dialogue: 0,0:02:40.21,0:02:43.01,Caption,,0,0,0,,НЕМЦАМ ПРО СТО ЛЕТ РОССИЙСКОЙ УГРОЗЫ. ПРЕКРАСНОЕ
Dialogue: 0,0:02:43.01,0:02:45.66,Caption,,0,0,0,,МЕСТО ДЛЯ ИСТОРИЧЕСКОЙ ЛЕКЦИИ. ТОЛЬКО УЧЕБНИК
Dialogue: 0,0:02:45.66,0:02:49.29,Caption,,0,0,0,,НАДО ОТКРЫВАТЬ НЕ НА ОДНОЙ УДОБНОЙ СТРАНИЦЕ. ПЕРВАЯ
Dialogue: 0,0:02:49.29,0:02:54.02,Caption,,0,0,0,,МИРОВАЯ. ВТОРАЯ МИРОВАЯ. ГЕРМАНИЯ. ФРАНЦИЯ. СОЮЗЫ,
Dialogue: 0,0:02:54.23,0:02:58.18,Caption,,0,0,0,,КОТОРЫЕ МЕНЯЛИСЬ. СТРАНЫ, КОТОРЫЕ ВЧЕРА ВОЕВАЛИ ДРУГ С ДРУГОМ,
Dialogue: 0,0:02:58.34,0:03:00.58,Caption,,0,0,0,,А СЕГОДНЯ СИДЯТ ЗА ОДНИМ СТОЛОМ. И
Dialogue: 0,0:03:00.58,0:03:03.18,Caption,,0,0,0,,ТОГДА ВОЗНИКАЕТ ОЧЕНЬ ПРОСТОЙ ВОПРОС. ЕСЛИ
Dialogue: 0,0:03:03.18,0:03:04.90,Caption,,0,0,0,,ИСТОРИЯ ДЕЙСТВИТЕЛЬНО ДОКАЗЫВАЕТ,
Dialogue: 0,0:03:05.00,0:03:08.79,Caption,,0,0,0,,ЧТО ГОСУДАРСТВА НЕ МЕНЯЮТСЯ, ТОГДА КАК ВООБЩЕ ПОЯВИЛИСЬ НЫНЕШНИЕ
Dialogue: 0,0:03:08.79,0:03:12.31,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СОЮЗЫ? ФРАНЦИЯ И ГЕРМАНИЯ ПО ЭТОЙ ЛОГИКЕ ТОЖЕ
Dialogue: 0,0:03:12.31,0:03:14.34,Caption,,0,0,0,,ДОЛЖНЫ БЫЛИ ДО СИХ ПОР СМОТРЕТЬ ДРУГ НА ДРУГА
Dialogue: 0,0:03:14.42,0:03:16.86,Caption,,0,0,0,,ЧЕРЕЗ ПРИЦЕЛ. НО ПОЧЕМУ ТО НЕ СМОТРЯТ.
Dialogue: 0,0:03:16.86,0:03:18.67,Caption,,0,0,0,,ТО ЕСТЬ КОГДА РЕЧЬ ИДЁТ О СОБСТВЕННЫХ
Dialogue: 0,0:03:18.67,0:03:20.82,Caption,,0,0,0,,СОЮЗНИКАХ, ИСТОРИЯ МОЖЕТ ЗАКОНЧИТЬСЯ,
Dialogue: 0,0:03:20.92,0:03:24.26,Caption,,0,0,0,,ВРАЖДА МОЖЕТ ЗАКОНЧИТЬСЯ, ИНТЕРЕСЫ МОГУТ ПОМЕНЯТЬСЯ,
Dialogue: 0,0:03:24.41,0:03:26.55,Caption,,0,0,0,,ПОКОЛЕНИЯ МОГУТ ПОМЕНЯТЬСЯ. А КОГДА
Dialogue: 0,0:03:26.55,0:03:30.28,Caption,,0,0,0,,РЕЧЬ ИДЁТ О РОССИИ, НАМ ПРЕДЛАГАЮТ ФОРМУЛУ НА СТО ЛЕТ
Dialogue: 0,0:03:30.28,0:03:34.54,Caption,,0,0,0,,ВПЕРЁД БЫЛА УГРОЗОЙ, ЯВЛЯЕТСЯ УГРОЗОЙ И ОСТАНЕТСЯ УГРОЗОЙ.
Dialogue: 0,0:03:34.54,0:03:38.02,Caption,,0,0,0,,УДОБНАЯ ИСТОРИЯ. ГЛАВНОЕ, СТРАНИЦЫ ПРАВИЛЬНО ВЫБРАТЬ.
Dialogue: 0,0:03:40.23,0:03:41.83,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ОСОБЕННО ИНТЕРЕСНО,
Dialogue: 0,0:03:42.06,0:03:43.83,Caption,,0,0,0,,ЧТО ПАРАЛЛЕЛЬНО ЗЕЛЕНСКИЙ СНОВА
Dialogue: 0,0:03:43.83,0:03:47.01,Caption,,0,0,0,,ПОДНИМАЕТ ТЕМУ ГАРАНТИЙ БЕЗОПАСНОСТИ. ПРИЧЁМ ГАРАНТИИ
Dialogue: 0,0:03:47.01,0:03:49.91,Caption,,0,0,0,,ПО ТИПУ ПЯТОЙ СТАТЬИ НАТО ЕГО УЖЕ НЕ УСТРАИВАЮТ
Dialogue: 0,0:03:49.91,0:03:52.40,Caption,,0,0,0,,ПРОСТО КАК КРАСИВОЕ ОБЕЩАНИЕ. ОН ЗАДАЁТ
Dialogue: 0,0:03:52.40,0:03:56.01,Caption,,0,0,0,,КОНКРЕТНЫЕ ВОПРОСЫ. КАКИЕ СТРАНЫ РЕАЛЬНО ПОДДЕРЖАТ
Dialogue: 0,0:03:56.01,0:03:58.15,Caption,,0,0,0,,УКРАИНУ, ЕСЛИ КОНФЛИКТ ПОВТОРИТСЯ?
Dialogue: 0,0:03:58.30,0:04:01.65,Caption,,0,0,0,,ЧТО ОНИ БУДУТ ДЕЛАТЬ? КАКИЕ ВОЙСКА ЗАРАНЕЕ РАЗМЕСТЯТ НА
Dialogue: 0,0:04:01.65,0:04:04.31,Caption,,0,0,0,,УКРАИНСКОЙ ТЕРРИТОРИИ? СКОЛЬКО ЭТО БУДЕТ СТОИТЬ?
Dialogue: 0,0:04:04.52,0:04:06.24,Caption,,0,0,0,,И БУДЕТ ЛИ ВООБЩЕ ЭТА КОНСТРУКЦИЯ
Dialogue: 0,0:04:06.24,0:04:09.82,Caption,,0,0,0,,РАБОТАТЬ? ВОПРОСЫ, КСТАТИ, НОРМАЛЬНЫЕ. ПОТОМУ ЧТО ЕСЛИ ВЫ
Dialogue: 0,0:04:09.82,0:04:12.71,Caption,,0,0,0,,НАЗЫВАЕТЕ ЧТО ТО ГАРАНТИЕЙ, НЕПЛОХО БЫ ПОНИМАТЬ,
Dialogue: 0,0:04:12.85,0:04:17.18,Caption,,0,0,0,,КТО ИМЕННО ГАРАНТИРУЕТ И ЧЕМ. НО ДАЛЬШЕ ЗЕЛЕНСКИЙ ДЕЛАЕТ ЗНАКОМЫЙ
Dialogue: 0,0:04:17.18,0:04:20.47,Caption,,0,0,0,,ПОВОРОТ. А ЗАЧЕМ, МОЛ, ВООБЩЕ ГОРОДИТЬ ВЕСЬ ЭТОТ ОГОРОД?
Dialogue: 0,0:04:20.79,0:04:23.27,Caption,,0,0,0,,НЕ ПРОЩЕ ЛИ ПРИНЯТЬ УКРАИНУ НЕПОСРЕДСТВЕННО В НАТО?
Dialogue: 0,0:04:23.49,0:04:26.27,Caption,,0,0,0,,ДЕШЕВЛЕ. НАДЁЖНЕЕ. ЭФФЕКТИВНЕЕ. НУ
Dialogue: 0,0:04:26.27,0:04:29.11,Caption,,0,0,0,,КОНЕЧНО. СТОЛЬКО ЛЕТ ОБСУЖДАЛИ ОДНУ ИЗ САМЫХ
Dialogue: 0,0:04:29.11,0:04:31.11,Caption,,0,0,0,,БОЛЕЗНЕННЫХ ТЕМ МЕЖДУ МОСКВОЙ И НАТО,
Dialogue: 0,0:04:31.35,0:04:33.59,Caption,,0,0,0,,СТОЛЬКО ЛЕТ ВОКРУГ НЕЁ ЛОМАЛИ КОПЬЯ,
Dialogue: 0,0:04:33.82,0:04:35.97,Caption,,0,0,0,,А РЕШЕНИЕ ОКАЗАЛОСЬ ПРОСТОЕ. НАДО ЕЩЁ
Dialogue: 0,0:04:35.97,0:04:39.93,Caption,,0,0,0,,РАЗ ПРЕДЛОЖИТЬ РОВНО ТО, ПРОТИВ ЧЕГО МОСКВА ВЫСТУПАЕТ. ВОТ
Dialogue: 0,0:04:39.93,0:04:42.91,Caption,,0,0,0,,ТОГДА ТОЧНО ДОГОВОРИМСЯ. И ОДНОВРЕМЕННО ЕВРОСОЮЗ
Dialogue: 0,0:04:42.91,0:04:45.29,Caption,,0,0,0,,ОТКАЗЫВАЕТСЯ ЕХАТЬ В МОСКВУ НА ДВУСТОРОННИЕ
Dialogue: 0,0:04:45.29,0:04:48.31,Caption,,0,0,0,,КОНСУЛЬТАЦИИ ПО ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ЕВРОПЕЙЦЫ
Dialogue: 0,0:04:48.31,0:04:51.01,Caption,,0,0,0,,ХОТЯТ ОБСУЖДАТЬ УКРАИНСКИЙ ВОПРОС В МНОГОСТОРОННЕМ
Dialogue: 0,0:04:51.01,0:04:57.17,Caption,,0,0,0,,ФОРМАТЕ. ПОЛУЧАЕТСЯ ЗАНЯТНО. УКРАИНА ТРЕБУЕТ НАТО И ЗАПАДНЫЕ ВОЙСКА
Dialogue: 0,0:04:57.17,0:04:59.84,Caption,,0,0,0,,НА СВОЕЙ ТЕРРИТОРИИ. ЕВРОПА НЕ ХОЧЕТ ОТДЕЛЬНО
Dialogue: 0,0:04:59.84,0:05:02.16,Caption,,0,0,0,,ОБСУЖДАТЬ С РОССИЕЙ ПРАВИЛА ЕВРОПЕЙСКОЙ
Dialogue: 0,0:05:02.16,0:05:06.10,Caption,,0,0,0,,БЕЗОПАСНОСТИ. НО МИР ПРИ ЭТОМ НУЖЕН СРОЧНО. КРАСИВО СОБРАНО.
Dialogue: 0,0:05:06.10,0:05:08.59,Caption,,0,0,0,,ГЛАВНОЕ, НИЧЕГО НЕ МЕНЯТЬ В ТЕХ ПУНКТАХ,
Dialogue: 0,0:05:08.80,0:05:10.75,Caption,,0,0,0,,ИЗ ЗА КОТОРЫХ СТОРОНЫ ГОДАМИ СПОРЯТ,
Dialogue: 0,0:05:10.91,0:05:13.46,Caption,,0,0,0,,И УДИВЛЯТЬСЯ, ПОЧЕМУ СПОР НЕ ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:05:13.46,0:05:15.95,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. А ТЕПЕРЬ ПОСМОТРИТЕ,
Dialogue: 0,0:05:16.19,0:05:18.24,Caption,,0,0,0,,НА СКОЛЬКО ЛЕТ ВПЕРЁД КОЕ КТО УЖЕ
Dialogue: 0,0:05:18.24,0:05:21.71,Caption,,0,0,0,,РАССЧИТЫВАЕТ ПРОДОЛЖЕНИЕ ЭТОЙ ИСТОРИИ. ЕСТЬ ВЕРСИЯ,
Dialogue: 0,0:05:21.79,0:05:23.59,Caption,,0,0,0,,ЧТО ПОЗИЦИЯ ЗЕЛЕНСКОГО ПО МИРНОМУ
Dialogue: 0,0:05:23.59,0:05:26.10,Caption,,0,0,0,,ТРЕКУ СТАЛА ЗАМЕТНО ЖЁСТЧЕ ПОСЛЕ НОВЫХ ДЕНЕЖНЫХ
Dialogue: 0,0:05:26.10,0:05:29.08,Caption,,0,0,0,,ПОСТУПЛЕНИЙ, А В КИЕВЕ РАССЧИТЫВАЮТ ТЯНУТЬ ВРЕМЯ ДО
Dialogue: 0,0:05:29.08,0:05:31.72,Caption,,0,0,0,,ИЗМЕНЕНИЯ ПОЛИТИЧЕСКОЙ СИТУАЦИИ В СОЕДИНЁННЫХ
Dialogue: 0,0:05:31.72,0:05:34.11,Caption,,0,0,0,,ШТАТАХ. РАСЧЁТ ПРОСТОЙ. ПО ЭТОЙ ВЕРСИИ,
Dialogue: 0,0:05:34.35,0:05:36.06,Caption,,0,0,0,,НА БАНКОВОЙ ДАЖЕ ДОРОЖНУЮ КАРТУ
Dialogue: 0,0:05:36.06,0:05:38.60,Caption,,0,0,0,,ПЕРЕГОВОРОВ ОБСУЖДАТЬ НЕ ХОТЯТ. ЗЕЛЕНСКИЙ УЖЕ
Dialogue: 0,0:05:38.60,0:05:41.28,Caption,,0,0,0,,ПОРУЧИЛ КАБМИНУ ПЕРЕСТРОИТЬ ЭКОНОМИЧЕСКУЮ ПОЛИТИКУ
Dialogue: 0,0:05:41.28,0:05:44.19,Caption,,0,0,0,,УКРАИНЫ ПОД ЗАТЯЖНОЙ КОНФЛИКТ. РАСЧЁТ НА ТО,
Dialogue: 0,0:05:44.35,0:05:46.20,Caption,,0,0,0,,ЧТОБЫ ПРОТЯНУТЬ ДО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:05:46.20,0:05:48.57,Caption,,0,0,0,,ДЕВЯТОГО ГОДА И ДОЖДАТЬСЯ УСИЛЕНИЯ ДЕМОКРАТОВ В
Dialogue: 0,0:05:48.57,0:05:51.88,Caption,,0,0,0,,КОНГРЕССЕ. ОБРАТИТЕ ВНИМАНИЕ НА САМ ГОРИЗОНТ. НЕ
Dialogue: 0,0:05:51.88,0:05:55.55,Caption,,0,0,0,,СЛЕДУЮЩИЙ РАУНД ПЕРЕГОВОРОВ. НЕ БЛИЖАЙШАЯ ВЕСНА.
Dialogue: 0,0:05:55.55,0:05:58.58,Caption,,0,0,0,,НЕ ЛЕТО. ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ДЕВЯТЫЙ ГОД. ТО ЕСТЬ
Dialogue: 0,0:05:58.58,0:06:01.72,Caption,,0,0,0,,ОДНОВРЕМЕННО С РАЗГОВОРАМИ О МИРЕ ВНУТРИ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:06:01.72,0:06:03.68,Caption,,0,0,0,,КУХНИ РАССМАТРИВАЕТСЯ СЦЕНАРИЙ ЕЩЁ
Dialogue: 0,0:06:03.68,0:06:09.19,Caption,,0,0,0,,НЕСКОЛЬКИХ ЛЕТ КОНФЛИКТА. ВОТ ТУТ УЖЕ СТАНОВИТСЯ ПОНЯТНЕЕ,
Dialogue: 0,0:06:09.35,0:06:11.56,Caption,,0,0,0,,ПОЧЕМУ КАЖДОЕ НОВОЕ МИРНОЕ ПРЕДЛОЖЕНИЕ
Dialogue: 0,0:06:11.56,0:06:13.91,Caption,,0,0,0,,ИНОГДА ВЫГЛЯДИТ КАК ЕЩЁ ОДИН КРУГ ПО ТОМУ ЖЕ
Dialogue: 0,0:06:13.91,0:06:17.83,Caption,,0,0,0,,СТАДИОНУ. ВСЕ БЕГУТ К ФИНИШУ, НО ФИНИШ ПОЧЕМУ ТО КАЖДЫЙ РАЗ
Dialogue: 0,0:06:17.83,0:06:20.96,Caption,,0,0,0,,ПЕРЕНОСЯТ ЕЩЁ КИЛОМЕТРОВ НА ПЯТЬ. И ПРИЧИНА ЗДЕСЬ
Dialogue: 0,0:06:20.96,0:06:24.28,Caption,,0,0,0,,ПРОСТАЯ. ПОТОМУ ЧТО МИРА ГЛОБАЛИСТЫ НЕ ХОТЯТ. ОНИ НЕ
Dialogue: 0,0:06:24.28,0:06:27.49,Caption,,0,0,0,,СВЕРНУТ. ЭТО У НИХ ПОСЛЕДНИЙ ДОВОД КОРОЛЕЙ.
Dialogue: 0,0:06:27.49,0:06:30.47,Caption,,0,0,0,,ВОЙНА, ПОСЛЕДНИЙ ДОВОД КОРОЛЕЙ. ВСЁ. БОЛЬШЕ У
Dialogue: 0,0:06:30.47,0:06:33.30,Caption,,0,0,0,,НИХ НИЧЕГО НЕ ОСТАЁТСЯ ДЕЛАТЬ. ПОСМОТРИТЕ НЕ НА
Dialogue: 0,0:06:33.30,0:06:36.09,Caption,,0,0,0,,СЛОВА, А НА КОНСТРУКЦИЮ. ЗЕЛЕНСКИЙ СНОВА
Dialogue: 0,0:06:36.09,0:06:39.25,Caption,,0,0,0,,ТАЩИТ НАТО. ЕВРОКОМИССИЯ НЕ ГОТОВА К ДВУСТОРОННИМ
Dialogue: 0,0:06:39.25,0:06:42.35,Caption,,0,0,0,,КОНСУЛЬТАЦИЯМ С РОССИЕЙ. РЮТТЕ ОТВЕРГАЕТ ВОЗВРАЩЕНИЕ
Dialogue: 0,0:06:42.35,0:06:44.60,Caption,,0,0,0,,НАТО К ГРАНИЦАМ ДЕВЯНОСТО СЕДЬМОГО ГОДА И
Dialogue: 0,0:06:44.60,0:06:46.92,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОВОРИТ О ДАЛЬНЕЙШЕМ НАРАЩИВАНИИ
Dialogue: 0,0:06:46.92,0:06:49.70,Caption,,0,0,0,,ПРОИЗВОДСТВА БОЕПРИПАСОВ. МЕРЦ ВРОДЕ БЫ ГОВОРИТ О
Dialogue: 0,0:06:49.70,0:06:52.17,Caption,,0,0,0,,ГОТОВНОСТИ РАЗГОВАРИВАТЬ С МОСКВОЙ. А СЛЕДОМ
Dialogue: 0,0:06:52.17,0:06:55.03,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ УТОЧНЕНИЕ СНАЧАЛА ПРЕКРАЩЕНИЕ ОГНЯ,
Dialogue: 0,0:06:55.27,0:06:57.05,Caption,,0,0,0,,ПОТОМ БУДЕМ ОБСУЖДАТЬ ЕВРОПЕЙСКУЮ
Dialogue: 0,0:06:57.05,0:06:59.86,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. ГЛАВА ГЕРМАНСКОГО МИД ВООБЩЕ
Dialogue: 0,0:06:59.86,0:07:02.71,Caption,,0,0,0,,ОБЪЯСНЯЕТ, ЧТО МИР И СТАБИЛЬНОСТЬ В ЕВРОПЕ ДОЛЖНЫ
Dialogue: 0,0:07:02.71,0:07:06.47,Caption,,0,0,0,,СТРОИТЬСЯ ПРОТИВ РОССИИ, А НЕ ВМЕСТЕ С РОССИЕЙ. ВОТ ЭТО МНЕ
Dialogue: 0,0:07:06.47,0:07:08.30,Caption,,0,0,0,,ОСОБЕННО НРАВИТСЯ СВОЕЙ ЖЕЛЕЗНОЙ
Dialogue: 0,0:07:08.30,0:07:10.78,Caption,,0,0,0,,ЛОГИКОЙ. МЫ ХОТИМ ДОГОВОРИТЬСЯ С РОССИЕЙ. НО
Dialogue: 0,0:07:10.78,0:07:13.98,Caption,,0,0,0,,БЕЗОПАСНОСТЬ БУДЕМ СТРОИТЬ ПРОТИВ РОССИИ. МЫ ХОТИМ
Dialogue: 0,0:07:13.98,0:07:17.30,Caption,,0,0,0,,ПЕРЕГОВОРОВ. НО СНАЧАЛА РОССИЯ ВЫПОЛНИТ УСЛОВИЯ. МЫ
Dialogue: 0,0:07:17.30,0:07:23.45,Caption,,0,0,0,,ХОТИМ СНИЗИТЬ НАПРЯЖЕНИЕ. НО ПРОИЗВОДСТВО БОЕПРИПАСОВ УВЕЛИЧИМ.
Dialogue: 0,0:07:23.45,0:07:26.26,Caption,,0,0,0,,И ПОСЛЕ ЭТОГО ВСЕ С СЕРЬЁЗНЫМИ ЛИЦАМИ ОБСУЖДАЮТ,
Dialogue: 0,0:07:26.56,0:07:28.66,Caption,,0,0,0,,ПОЧЕМУ ПЕРЕГОВОРЫ ИДУТ ТЯЖЕЛО. ДА
Dialogue: 0,0:07:28.66,0:07:30.90,Caption,,0,0,0,,ПОТОМУ ЧТО ЭТО УЖЕ НАПОМИНАЕТ ЧЕЛОВЕКА,
Dialogue: 0,0:07:31.22,0:07:33.06,Caption,,0,0,0,,КОТОРЫЙ ПРИШЁЛ МИРИТЬСЯ С СОСЕДОМ,
Dialogue: 0,0:07:33.31,0:07:35.02,Caption,,0,0,0,,НО НА ВСЯКИЙ СЛУЧАЙ ПРИВЁЛ С СОБОЙ
Dialogue: 0,0:07:35.02,0:07:37.56,Caption,,0,0,0,,ТРЁХ КРЕПКИХ ДРУЗЕЙ И ПОСТАВИЛ ИХ У ДВЕРИ.
Dialogue: 0,0:07:37.56,0:07:39.57,Caption,,0,0,0,,А ПОТОМ УДИВЛЯЕТСЯ ЧЕГО СОСЕД ТАКОЙ
Dialogue: 0,0:07:39.57,0:07:42.44,Caption,,0,0,0,,НЕРВНЫЙ? И ВСЁ ЭТО ОСОБЕННО ЗАБАВНО ВЫГЛЯДИТ НА
Dialogue: 0,0:07:42.44,0:07:44.67,Caption,,0,0,0,,ФОНЕ ЗАЯВЛЕНИЙ ЗЕЛЕНСКОГО О НЕНАВИСТИ МЕЖДУ
Dialogue: 0,0:07:44.67,0:07:46.98,Caption,,0,0,0,,УКРАИНЦАМИ И РОССИЯНАМИ. ОН ГОВОРИТ,
Dialogue: 0,0:07:47.15,0:07:49.28,Caption,,0,0,0,,ЧТО СЕЙЧАС НИКАКОЙ ДРУЖБЫ БЫТЬ НЕ
Dialogue: 0,0:07:49.28,0:07:51.94,Caption,,0,0,0,,МОЖЕТ. ГОВОРИТ ОБ ОТВЕТСТВЕННОСТИ. ГОВОРИТ,
Dialogue: 0,0:07:52.18,0:07:54.06,Caption,,0,0,0,,ЧТО НЕЛЬЗЯ ПРОСТО ВЗЯТЬ И ПРОСТИТЬ. И
Dialogue: 0,0:07:54.06,0:07:57.05,Caption,,0,0,0,,ОДНОВРЕМЕННО ПРИЗНАЁТ ВАЖНЕЙШУЮ ВЕЩЬ. ОН САМ НЕ
Dialogue: 0,0:07:57.05,0:07:59.79,Caption,,0,0,0,,УВЕРЕН, ЧТО ВОПРОС ВОССТАНОВЛЕНИЯ ОТНОШЕНИЙ
Dialogue: 0,0:07:59.79,0:08:03.14,Caption,,0,0,0,,ВООБЩЕ ОТНОСИТСЯ К НЫНЕШНЕМУ ПОКОЛЕНИЮ. А ВОТ ЗДЕСЬ Я С
Dialogue: 0,0:08:03.14,0:08:05.25,Caption,,0,0,0,,ЗЕЛЕНСКИМ ЧАСТИЧНО СОГЛАШУСЬ. ВПОЛНЕ
Dialogue: 0,0:08:05.25,0:08:07.93,Caption,,0,0,0,,МОЖЕТ ОКАЗАТЬСЯ, ЧТО ЭТО ДЕЙСТВИТЕЛЬНО НЕ ДЕЛО
Dialogue: 0,0:08:07.93,0:08:11.54,Caption,,0,0,0,,НЫНЕШНЕГО ПОКОЛЕНИЯ. НО УЖ СЛЕДУЮЩЕГО ТОЧНО. ПОТОМУ ЧТО
Dialogue: 0,0:08:11.54,0:08:14.65,Caption,,0,0,0,,ЧЕЛОВЕК ВООБЩЕ СУЩЕСТВО С ОЧЕНЬ КОРОТКОЙ ПАМЯТЬЮ.
Dialogue: 0,0:08:14.65,0:08:17.78,Caption,,0,0,0,,ЧУТЬ ДЛИННЕЕ, ЧЕМ У РЫБКИ. МЫ СЕЙЧАС СМОТРИМ НА ВСЁ
Dialogue: 0,0:08:17.78,0:08:20.01,Caption,,0,0,0,,ПРОИСХОДЯЩЕЕ КАК НА ОДНУ ОГРОМНУЮ
Dialogue: 0,0:08:20.01,0:08:23.19,Caption,,0,0,0,,ОБЩУЮ ТРАГЕДИЮ. НО ДЛЯ КАЖДОГО ОТДЕЛЬНОГО ЧЕЛОВЕКА ЭТА
Dialogue: 0,0:08:23.19,0:08:25.70,Caption,,0,0,0,,ТРАГЕДИЯ СОВЕРШЕННО РАЗНАЯ. КТО ТО ПОТЕРЯЛ
Dialogue: 0,0:08:25.70,0:08:29.94,Caption,,0,0,0,,БЛИЗКОГО ЧЕЛОВЕКА. КТО ТО ПОТЕРЯЛ ДОМ. КТО ТО УЕХАЛ. КТО
Dialogue: 0,0:08:30.02,0:08:35.29,Caption,,0,0,0,,ТО ПОТЕРЯЛ РАБОТУ. А КТО ТО ВООБЩЕ ПРАКТИЧЕСКИ НИЧЕГО
Dialogue: 0,0:08:35.29,0:08:38.22,Caption,,0,0,0,,ЛИЧНО НЕ ПОТЕРЯЛ. И ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ ЭТИ ЛЮДИ
Dialogue: 0,0:08:38.22,0:08:40.63,Caption,,0,0,0,,БУДУТ ПОМНИТЬ СОВЕРШЕННО РАЗНОЕ. ТЕ,
Dialogue: 0,0:08:40.73,0:08:42.71,Caption,,0,0,0,,КОГО КОНФЛИКТ УДАРИЛ ПРЯМО ПО СЕМЬЕ,
Dialogue: 0,0:08:42.95,0:08:45.06,Caption,,0,0,0,,МОГУТ НЕ ПРОСТИТЬ НИКОГДА. И ТАКИЕ
Dialogue: 0,0:08:45.06,0:08:48.39,Caption,,0,0,0,,ЛЮДИ ОСТАНУТСЯ. НО БУДЕТ ОГРОМНОЕ КОЛИЧЕСТВО ДРУГИХ,
Dialogue: 0,0:08:48.71,0:08:51.27,Caption,,0,0,0,,ДЛЯ КОТОРЫХ НЫНЕШНИЕ СОБЫТИЯ ПОСТЕПЕННО СТАНУТ
Dialogue: 0,0:08:51.35,0:08:54.04,Caption,,0,0,0,,ПРОШЛЫМ. ПОЯВЯТСЯ НОВЫЕ ПРОБЛЕМЫ.
Dialogue: 0,0:08:54.04,0:08:57.72,Caption,,0,0,0,,НОВЫЕ СЕМЬИ. НОВЫЕ ДЕТИ. НОВАЯ РАБОТА. НОВЫЕ
Dialogue: 0,0:08:57.72,0:09:01.96,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА. НОВЫЕ ИНТЕРЕСЫ. И БОЛЬШИНСТВО ПРОСТО ПОЙДЁТ
Dialogue: 0,0:09:01.96,0:09:04.88,Caption,,0,0,0,,ДАЛЬШЕ. ТАК ЧЕЛОВЕЧЕСТВО ВСЕГДА И ЖИЛО. ЕСЛИ БЫ
Dialogue: 0,0:09:04.88,0:09:07.59,Caption,,0,0,0,,НАРОДЫ НАВЕЧНО НАСЛЕДОВАЛИ НЕНАВИСТЬ ПРЕДЫДУЩЕГО
Dialogue: 0,0:09:07.59,0:09:10.10,Caption,,0,0,0,,ПОКОЛЕНИЯ, ЕВРОПА ДО СИХ ПОР ПРЕДСТАВЛЯЛА БЫ
Dialogue: 0,0:09:10.10,0:09:11.83,Caption,,0,0,0,,СОБОЙ НЕСКОЛЬКО ДЕСЯТКОВ СТРАН,
Dialogue: 0,0:09:12.07,0:09:16.25,Caption,,0,0,0,,КОТОРЫЕ ТОЛЬКО И ДЕЛАЮТ, ЧТО СВОДЯТ СТАРЫЕ СЧЁТЫ. НО ТУТ ЕСТЬ
Dialogue: 0,0:09:16.25,0:09:18.35,Caption,,0,0,0,,ЕЩЁ ОДНА НЕПРИЯТНАЯ ДЕТАЛЬ. ИЗ СЛОВ
Dialogue: 0,0:09:18.35,0:09:21.70,Caption,,0,0,0,,ЗЕЛЕНСКОГО ВЫХОДИТ, ЧТО БУДУЩАЯ ДРУЖБА ДОЛЖНА НАЧАТЬСЯ
Dialogue: 0,0:09:21.70,0:09:25.31,Caption,,0,0,0,,ПОСЛЕ НЕКИХ ШАГОВ, ОТВЕТСТВЕННОСТИ И РАСЧЁТА ЗА ПРОШЛОЕ.
Dialogue: 0,0:09:25.31,0:09:27.11,Caption,,0,0,0,,А ДАЛЬШЕ УЖЕ ВОЗНИКАЕТ ВОПРОС,
Dialogue: 0,0:09:27.43,0:09:29.10,Caption,,0,0,0,,НЕ ПРЕВРАЩАЕТСЯ ЛИ ПРИМИРЕНИЕ В
Dialogue: 0,0:09:29.10,0:09:31.51,Caption,,0,0,0,,СВОЕОБРАЗНЫЙ ПРЕЙСКУРАНТ. ЗАПЛАТИЛИ,
Dialogue: 0,0:09:31.61,0:09:34.95,Caption,,0,0,0,,ВЫПОЛНИЛИ УСЛОВИЯ, ТОГДА ПОГОВОРИМ О ДРУЖБЕ. ТОЛЬКО
Dialogue: 0,0:09:34.95,0:09:37.56,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКИЕ ОТНОШЕНИЯ ТАК НЕ РАБОТАЮТ. ЛЮДИ
Dialogue: 0,0:09:37.56,0:09:40.85,Caption,,0,0,0,,НАЧИНАЮТ ОБЩАТЬСЯ НЕ ПОСЛЕ ПОДПИСАНИЯ СПРАВКИ О МОРАЛЬНОМ
Dialogue: 0,0:09:40.85,0:09:42.63,Caption,,0,0,0,,РАСЧЁТЕ. ОНИ НАЧИНАЮТ ОБЩАТЬСЯ,
Dialogue: 0,0:09:42.87,0:09:44.95,Caption,,0,0,0,,КОГДА ИМ СНОВА СТАНОВИТСЯ ВЫГОДНО,
Dialogue: 0,0:09:45.03,0:09:48.47,Caption,,0,0,0,,УДОБНО, ИНТЕРЕСНО И ПРОСТО НОРМАЛЬНО ОБЩАТЬСЯ.
Dialogue: 0,0:09:50.75,0:09:52.71,Caption,,0,0,0,,ПОЛИТИКИ МОГУТ ЕЩЁ ДЕСЯТЬ ЛЕТ ЧИТАТЬ
Dialogue: 0,0:09:52.71,0:09:55.49,Caption,,0,0,0,,РЕЧИ ПРО ИСТОРИЧЕСКУЮ ПАМЯТЬ. А ОБЫЧНЫЙ ЧЕЛОВЕК
Dialogue: 0,0:09:55.49,0:09:58.43,Caption,,0,0,0,,ЧЕРЕЗ ГРАНИЦУ КУПИТ МАШИНУ, СДАСТ КВАРТИРУ,
Dialogue: 0,0:09:58.66,0:10:02.94,Caption,,0,0,0,,УСТРОИТСЯ НА РАБОТУ, ЖЕНИТСЯ, ПОЕДЕТ ОТДЫХАТЬ. И ВСЯ БОЛЬШАЯ
Dialogue: 0,0:10:02.94,0:10:05.47,Caption,,0,0,0,,ГЕОПОЛИТИЧЕСКАЯ КОНСТРУКЦИЯ ВДРУГ ОБНАРУЖИТ,
Dialogue: 0,0:10:05.71,0:10:08.15,Caption,,0,0,0,,ЧТО ЖИЗНЬ УЖЕ ТИХОНЬКО УШЛА ВПЕРЁД. А
Dialogue: 0,0:10:08.15,0:10:10.94,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ВСЁ ЕЩЁ СОРЕВНУЮТСЯ В ПРЕДВАРИТЕЛЬНЫХ
Dialogue: 0,0:10:10.94,0:10:13.82,Caption,,0,0,0,,УСЛОВИЯХ. КТО ПРИНЕСЁТ СПИСОК ПОТОЛЩЕ. А ТЕПЕРЬ
Dialogue: 0,0:10:13.82,0:10:16.51,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ. ПОКА ЕВРОПЕЙЦЫ СПОРЯТ,
Dialogue: 0,0:10:16.72,0:10:18.59,Caption,,0,0,0,,КАК ИМЕННО ИМ РАЗГОВАРИВАТЬ С МОСКВОЙ,
Dialogue: 0,0:10:18.91,0:10:21.09,Caption,,0,0,0,,КУШНЕР ФОРМУЛИРУЕТ АМЕРИКАНСКУЮ ЛОГИКУ
Dialogue: 0,0:10:21.09,0:10:23.79,Caption,,0,0,0,,ГАРАНТИЙ БЕЗОПАСНОСТИ ДЛЯ УКРАИНЫ. ТРАМП,
Dialogue: 0,0:10:24.03,0:10:26.99,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ПОДДЕРЖИТ ГАРАНТИИ ТОЛЬКО ТОГДА,
Dialogue: 0,0:10:27.23,0:10:29.38,Caption,,0,0,0,,КОГДА ОНИ РЕАЛЬНО УМЕНЬШАЮТ РИСК
Dialogue: 0,0:10:29.38,0:10:31.87,Caption,,0,0,0,,НОВОГО КОНФЛИКТА И НЕ СОЗДАЮТ СИТУАЦИЮ,
Dialogue: 0,0:10:32.11,0:10:34.27,Caption,,0,0,0,,В КОТОРОЙ СОЕДИНЁННЫЕ ШТАТЫ АВТОМАТИЧЕСКИ
Dialogue: 0,0:10:34.27,0:10:37.31,Caption,,0,0,0,,ОКАЗЫВАЮТСЯ ВТЯНУТЫ В ПРЯМОЕ ПРОТИВОСТОЯНИЕ. ВОТ ЭТО
Dialogue: 0,0:10:37.39,0:10:39.20,Caption,,0,0,0,,УЖЕ СОВЕРШЕННО ДРУГОЙ РАЗГОВОР. НЕ
Dialogue: 0,0:10:39.20,0:10:42.22,Caption,,0,0,0,,ПРОСТО ДАТЬ БУМАГУ С КРАСИВЫМ НАЗВАНИЕМ. А ЗАРАНЕЕ
Dialogue: 0,0:10:42.22,0:10:46.57,Caption,,0,0,0,,ПОНЯТЬ, ЧТО ПРОИЗОЙДЁТ, ЕСЛИ ДОГОВОР НАРУШАТ. КТО ВМЕШИВАЕТСЯ.
Dialogue: 0,0:10:46.57,0:10:48.94,Caption,,0,0,0,,КТО НЕ ВМЕШИВАЕТСЯ. КАКИЕ СУЩЕСТВУЮТ
Dialogue: 0,0:10:48.94,0:10:52.12,Caption,,0,0,0,,МЕХАНИЗМЫ КОНСУЛЬТАЦИЙ. КАК ОСТАНОВИТЬ ЭСКАЛАЦИЮ
Dialogue: 0,0:10:52.12,0:10:54.99,Caption,,0,0,0,,РАНЬШЕ, ЧЕМ ОНА СНОВА ПРЕВРАТИТСЯ В БОЛЬШУЮ
Dialogue: 0,0:10:54.99,0:10:58.16,Caption,,0,0,0,,БОЙНЮ. КУШНЕР ВООБЩЕ ВЫВОДИТ ЭТУ ТЕМУ ГОРАЗДО ШИРЕ
Dialogue: 0,0:10:58.16,0:11:00.91,Caption,,0,0,0,,УКРАИНЫ. ПРИЧЁМ В ИЗЛОЖЕННОЙ ВЕРСИИ РОССИЯ ГОТОВА
Dialogue: 0,0:11:00.91,0:11:03.76,Caption,,0,0,0,,ОБСУЖДАТЬ ДАЖЕ ГАРАНТИИ ДЛЯ УКРАИНЫ ПО ТИПУ ПЯТОЙ
Dialogue: 0,0:11:03.76,0:11:08.40,Caption,,0,0,0,,СТАТЬИ НАТО. НО ОБСУЖДАТЬ ИХ ПРЕДЛАГАЕТСЯ НЕ
Dialogue: 0,0:11:08.40,0:11:11.26,Caption,,0,0,0,,ОТДЕЛЬНО, А ВМЕСТЕ СО ВСЕЙ СИСТЕМОЙ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:11:11.26,0:11:14.24,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ОН ГОВОРИТ ОБ ОБЩЕЙ СИСТЕМЕ
Dialogue: 0,0:11:14.24,0:11:17.66,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. О ВЗАИМОДЕЙСТВИИ НАТО. О
Dialogue: 0,0:11:17.66,0:11:20.13,Caption,,0,0,0,,ПОСТОЯННЫХ КОНСУЛЬТАЦИЯХ. О МЕХАНИЗМАХ
Dialogue: 0,0:11:20.13,0:11:22.75,Caption,,0,0,0,,ПРЕДОТВРАЩЕНИЯ КОНФЛИКТОВ. О НЕОБХОДИМОСТИ
Dialogue: 0,0:11:22.75,0:11:25.67,Caption,,0,0,0,,РАЗОБРАТЬСЯ, ГДЕ ИМЕННО ПРОИЗОШЁЛ ТОТ СБОЙ,
Dialogue: 0,0:11:25.91,0:11:28.01,Caption,,0,0,0,,КОТОРЫЙ ВООБЩЕ ПРИВЁЛ К НЫНЕШНЕЙ
Dialogue: 0,0:11:28.01,0:11:31.18,Caption,,0,0,0,,СИТУАЦИИ. И ЛОГИКА НА БУМАГЕ ВЫГЛЯДИТ ВПОЛНЕ ЗДРАВО.
Dialogue: 0,0:11:31.18,0:11:34.11,Caption,,0,0,0,,УКРАИНА ДОЛЖНА ПОЛУЧИТЬ БЕЗОПАСНОСТЬ. ЕВРОПА ДОЛЖНА
Dialogue: 0,0:11:34.11,0:11:36.71,Caption,,0,0,0,,СТАТЬ СТАБИЛЬНЕЕ. РОССИЯ ДОЛЖНА ПОНИМАТЬ,
Dialogue: 0,0:11:36.88,0:11:39.25,Caption,,0,0,0,,ЧТО НАТО НЕ ИЩЕТ С НЕЙ КОНФРОНТАЦИИ.
Dialogue: 0,0:11:39.25,0:11:40.87,Caption,,0,0,0,,НАТО ДОЛЖНО ПОЛУЧИТЬ УВЕРЕННОСТЬ,
Dialogue: 0,0:11:41.03,0:11:42.96,Caption,,0,0,0,,ЧТО РОССИЯ УВАЖАЕТ СУВЕРЕНИТЕТ
Dialogue: 0,0:11:42.96,0:11:46.37,Caption,,0,0,0,,СОСЕДЕЙ. ТО ЕСТЬ ВПЕРВЫЕ ПОЯВЛЯЕТСЯ ПОПЫТКА СОБРАТЬ НЕ
Dialogue: 0,0:11:46.37,0:11:48.95,Caption,,0,0,0,,ОДНУ УКРАИНСКУЮ ЗАПЛАТКУ, А СИСТЕМУ,
Dialogue: 0,0:11:49.11,0:11:51.22,Caption,,0,0,0,,ГДЕ БЕЗОПАСНОСТЬ ОДНОЙ СТОРОНЫ СВЯЗАНА
Dialogue: 0,0:11:51.22,0:11:53.34,Caption,,0,0,0,,С БЕЗОПАСНОСТЬЮ ДРУГОЙ. ПОТОМУ ЧТО ПО
Dialogue: 0,0:11:53.34,0:11:56.13,Caption,,0,0,0,,ДРУГОМУ ОНА ПРОСТО НЕ РАБОТАЕТ. НЕЛЬЗЯ ПОСТАВИТЬ
Dialogue: 0,0:11:56.13,0:11:58.95,Caption,,0,0,0,,ОДНОМУ СОСЕДУ ПОД ОКНО ПУЛЕМЁТ И ОБЪЯСНИТЬ ВТОРОМУ,
Dialogue: 0,0:11:59.03,0:12:00.98,Caption,,0,0,0,,ЧТО ЭТО ИСКЛЮЧИТЕЛЬНО ДЛЯ СОБСТВЕННОГО
Dialogue: 0,0:12:00.98,0:12:03.79,Caption,,0,0,0,,СПОКОЙСТВИЯ. СОСЕД ПОЧЕМУ ТО ВСЁ РАВНО НАЧНЁТ
Dialogue: 0,0:12:03.79,0:12:06.40,Caption,,0,0,0,,НЕРВНИЧАТЬ. И ВОТ КУШНЕР ЗАКАНЧИВАЕТ СВОЮ
Dialogue: 0,0:12:06.40,0:12:10.46,Caption,,0,0,0,,КОНСТРУКЦИЮ. СУВЕРЕННАЯ УКРАИНА. ПРОЦВЕТАЮЩАЯ УКРАИНА.
Dialogue: 0,0:12:10.46,0:12:15.20,Caption,,0,0,0,,СВОБОДНАЯ УКРАИНА. БОЛЕЕ СИЛЬНАЯ ЕВРОПА. БОЛЕЕ СТАБИЛЬНАЯ
Dialogue: 0,0:12:15.20,0:12:19.17,Caption,,0,0,0,,ЕВРОПА. СОГЛАШЕНИЕ, КОТОРОЕ НЕ ПОЗВОЛИТ КОНФЛИКТУ НАЧАТЬСЯ
Dialogue: 0,0:12:19.17,0:12:24.43,Caption,,0,0,0,,СНОВА. КРАСИВО. ТОЛЬКО ОДНОГО УЧАСТНИКА В КАРТИНКЕ
Dialogue: 0,0:12:24.43,0:12:28.28,Caption,,0,0,0,,БУДУЩЕГО ПОЧЕМУ ТО НЕТ. РОССИИ. ПРО УКРАИНУ НАПИСАЛИ,
Dialogue: 0,0:12:28.36,0:12:30.57,Caption,,0,0,0,,КАКОЙ ОНА ДОЛЖНА СТАТЬ. ПРО ЕВРОПУ
Dialogue: 0,0:12:30.57,0:12:33.52,Caption,,0,0,0,,НАПИСАЛИ, КАКОЙ ОНА ДОЛЖНА СТАТЬ. ПРО БУДУЩИЙ
Dialogue: 0,0:12:33.52,0:12:37.24,Caption,,0,0,0,,КОНФЛИКТ НАПИСАЛИ, ЧТО ЕГО НЕ ДОЛЖНО БЫТЬ. А ЧТО ПОЛУЧАЕТ
Dialogue: 0,0:12:37.32,0:12:39.17,Caption,,0,0,0,,РОССИЯ В ТОЙ САМОЙ БУДУЩЕЙ СИСТЕМЕ
Dialogue: 0,0:12:39.17,0:12:43.11,Caption,,0,0,0,,БЕЗОПАСНОСТИ? ТИШИНА. ВОТ ЗДЕСЬ И НАХОДИТСЯ ГЛАВНЫЙ ВОПРОС.
Dialogue: 0,0:12:43.11,0:12:45.08,Caption,,0,0,0,,ПОТОМУ ЧТО СИСТЕМА БЕЗОПАСНОСТИ,
Dialogue: 0,0:12:45.32,0:12:47.34,Caption,,0,0,0,,В КОТОРОЙ ПОДРОБНО РАСПИСАНО ХОРОШЕЕ
Dialogue: 0,0:12:47.34,0:12:50.20,Caption,,0,0,0,,БУДУЩЕЕ ДЛЯ ОДНОЙ СТОРОНЫ И НЕ СФОРМУЛИРОВАНО,
Dialogue: 0,0:12:50.41,0:12:54.21,Caption,,0,0,0,,ЧТО ПОЛУЧАЕТ ДРУГАЯ, УЖЕ СТОИТ КРИВО. МОЖНО СКОЛЬКО УГОДНО
Dialogue: 0,0:12:54.21,0:12:57.10,Caption,,0,0,0,,НАЗВАТЬ ЕЁ НОВОЙ АРХИТЕКТУРОЙ. НО ЕСЛИ ОДИН ИЗ
Dialogue: 0,0:12:57.10,0:12:59.31,Caption,,0,0,0,,НЕСУЩИХ ЭЛЕМЕНТОВ ИЗ НЕЁ ПРОСТО ЗАБЫЛИ
Dialogue: 0,0:12:59.31,0:13:02.36,Caption,,0,0,0,,ДОРИСОВАТЬ, ДОЛГО ТАКАЯ КОНСТРУКЦИЯ НЕ ПРОСТОИТ.
