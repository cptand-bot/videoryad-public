Dialogue: 0,0:00:00.12,0:00:02.44,Caption,,0,0,0,,ВОТ И ПРИШЛА РАСПЛАТА. ДОЛГО МОЖНО БЫЛО
Dialogue: 0,0:00:02.44,0:00:04.84,Caption,,0,0,0,,РАССКАЗЫВАТЬ, ЧТО ВСЁ ИДЁТ ПО ПЛАНУ,
Dialogue: 0,0:00:05.07,0:00:08.84,Caption,,0,0,0,,ЧТО КУРС ПРАВИЛЬНЫЙ, ЧТО НАДО ЕЩЁ НЕМНОГО ПОТЕРПЕТЬ И ПОТОМ СТАНЕТ
Dialogue: 0,0:00:08.92,0:00:12.20,Caption,,0,0,0,,ЛУЧШЕ. ТОЛЬКО ЭТО "ПОТОМ" НАКОНЕЦ НАСТУПИЛО. И
Dialogue: 0,0:00:12.20,0:00:14.28,Caption,,0,0,0,,ТЕПЕРЬ СЧЁТ УЖЕ НЕ ГДЕ ТО В БУДУЩЕМ,
Dialogue: 0,0:00:14.51,0:00:16.92,Caption,,0,0,0,,ОН ЛЕЖИТ НА СТОЛЕ. САМОЕ СМЕШНОЕ,
Dialogue: 0,0:00:17.06,0:00:20.44,Caption,,0,0,0,,ЧТО ТЕ, КТО ВСЁ ЭТО ЗАТЕВАЛ, ПО ПРЕЖНЕМУ ДЕЛАЮТ ВИД,
Dialogue: 0,0:00:20.52,0:00:22.84,Caption,,0,0,0,,БУДТО ПЛАТИТЬ БУДУТ НЕ ОНИ. МЫ ВЕДЬ УЖЕ
Dialogue: 0,0:00:22.92,0:00:27.08,Caption,,0,0,0,,ГОВОРИЛИ О ТОМ, ЧТО ПРОИСХОДИТ С ОБЫЧНОЙ ЖИЗНЬЮ В ЕВРОПЕ. МОЛОДЫМ
Dialogue: 0,0:00:27.16,0:00:29.80,Caption,,0,0,0,,ВСЁ ТЯЖЕЛЕЕ ДОБРАТЬСЯ ДО СОБСТВЕННОГО ЖИЛЬЯ. ДЛЯ
Dialogue: 0,0:00:29.80,0:00:32.20,Caption,,0,0,0,,МНОГИХ КВАРТИРА ПРЕВРАЩАЕТСЯ УЖЕ НЕ В НОРМАЛЬНЫЙ
Dialogue: 0,0:00:32.20,0:00:36.44,Caption,,0,0,0,,ЖИЗНЕННЫЙ ПЛАН, А ПОЧТИ В ПРЕДМЕТ РОСКОШИ. ДЕСЯТКИ МИЛЛИОНОВ ЛЮДЕЙ
Dialogue: 0,0:00:36.44,0:00:39.56,Caption,,0,0,0,,НАЧИНАЮТ СЧИТАТЬ ОТОПЛЕНИЕ. СЧИТАЮТ ЭЛЕКТРИЧЕСТВО.
Dialogue: 0,0:00:39.82,0:00:44.68,Caption,,0,0,0,,СЧИТАЮТ ПРОДУКТЫ. СЧИТАЮТ, ХВАТИТ ЛИ ДО СЛЕДУЮЩЕЙ ЗАРПЛАТЫ. И КАЖДЫЙ РАЗ
Dialogue: 0,0:00:44.68,0:00:47.48,Caption,,0,0,0,,ЗВУЧИТ ПРИМЕРНО ОДНА И ТА ЖЕ ПЕСНЯ. ПОТЕРПИТЕ.
Dialogue: 0,0:00:47.64,0:00:50.84,Caption,,0,0,0,,СЕЙЧАС ТРУДНО. СЕЙЧАС ОСОБОЕ ВРЕМЯ. СЕЙЧАС НАДО
Dialogue: 0,0:00:50.84,0:00:54.12,Caption,,0,0,0,,ПРОЯВИТЬ СОЛИДАРНОСТЬ. ПОТОМ СТАНЕТ ЛЕГЧЕ. НУ ВОТ.
Dialogue: 0,0:00:54.44,0:00:57.48,Caption,,0,0,0,,ПОТОМ ПРИШЛО. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:57.56,0:01:01.80,Caption,,0,0,0,,ПОДПИШИТЕСЬ. В ГЕРМАНИИ ДЕПУТАТ БУНДЕСТАГА МАРКУС ФРОНМАЙЕР ИЗ
Dialogue: 0,0:01:01.88,0:01:05.24,Caption,,0,0,0,,АДГ ЗАДАЛ ГЛАВЕ МИД ЙОХАННУ ВАДЕФУЛЮ ДОВОЛЬНО ПРОСТОЙ
Dialogue: 0,0:01:05.24,0:01:08.04,Caption,,0,0,0,,ВОПРОС. ЗЕЛЕНСКОМУ, ПРИЕХАВШЕМУ В БЕРЛИН,
Dialogue: 0,0:01:08.28,0:01:11.08,Caption,,0,0,0,,ГЕРМАНИЯ ВЫДЕЛЯЕТ ЕЩЁ ДВЕСТИ МИЛЛИОНОВ ЕВРО ТАК
Dialogue: 0,0:01:11.08,0:01:13.64,Caption,,0,0,0,,НАЗЫВАЕМОЙ ЗИМНЕЙ ПОМОЩИ. А ЧТО С НЕМЦАМИ?
Dialogue: 0,0:01:15.93,0:01:19.53,Caption,,0,0,0,,ФРОНМАЙЕР НАПОМНИЛ, ЧТО ДО ПЯТИ МИЛЛИОНОВ ЧЕЛОВЕК В ГЕРМАНИИ ЭТОЙ
Dialogue: 0,0:01:19.53,0:01:22.01,Caption,,0,0,0,,ЗИМОЙ СНОВА МОГУТ СТОЛКНУТЬСЯ С СИТУАЦИЕЙ,
Dialogue: 0,0:01:22.25,0:01:25.29,Caption,,0,0,0,,КОГДА ПРИХОДИТСЯ ЭКОНОМИТЬ НА ОТОПЛЕНИИ. И СПРОСИЛ,
Dialogue: 0,0:01:25.56,0:01:28.57,Caption,,0,0,0,,КОГДА ЗИМНЯЯ ПОМОЩЬ ПОЯВИТСЯ ДЛЯ СОБСТВЕННЫХ ГРАЖДАН
Dialogue: 0,0:01:28.57,0:01:33.85,Caption,,0,0,0,,ГЕРМАНИИ. КАЗАЛОСЬ БЫ, ВОПРОС ВПОЛНЕ БЫТОВОЙ. НЕ ПРО ГЕОПОЛИТИКУ. НЕ ПРО
Dialogue: 0,0:01:33.93,0:01:36.81,Caption,,0,0,0,,ВЫСОКУЮ СТРАТЕГИЮ. НЕ ПРО МИРОВУЮ БЕЗОПАСНОСТЬ.
Dialogue: 0,0:01:37.05,0:01:40.01,Caption,,0,0,0,,ЛЮДЯМ ХОЛОДНО. ЧТО ГОСУДАРСТВО СОБИРАЕТСЯ ДЕЛАТЬ?
Dialogue: 0,0:01:40.40,0:01:43.05,Caption,,0,0,0,,НО ВАДЕФУЛЬ ОТВЕТИЛ СОВСЕМ В ДРУГОМ ЖАНРЕ. ПО
Dialogue: 0,0:01:43.13,0:01:46.89,Caption,,0,0,0,,ЕГО СЛОВАМ, ФРОНМАЙЕР ЧРЕЗМЕРНО УВЛЕКАЕТСЯ ВНЕШНЕЙ ПОЛИТИКОЙ В
Dialogue: 0,0:01:46.97,0:01:50.25,Caption,,0,0,0,,УЩЕРБ ИНТЕРЕСАМ ГЕРМАНИИ. А САМА ПОСТАНОВКА ВОПРОСА
Dialogue: 0,0:01:50.33,0:01:52.57,Caption,,0,0,0,,О ПОМОЩИ НЕМЦАМ РЯДОМ С ПОМОЩЬЮ УКРАИНЕ,
Dialogue: 0,0:01:52.89,0:01:55.61,Caption,,0,0,0,,ПО СЛОВАМ МИНИСТРА, ЧУТЬ ЛИ НЕ ПОЩЁЧИНА ТЕМ,
Dialogue: 0,0:01:55.74,0:01:58.49,Caption,,0,0,0,,КТО СТРАДАЕТ ОТ КОНФЛИКТА. КРАСИВО ПОЛУЧИЛОСЬ.
Dialogue: 0,0:01:58.73,0:02:00.97,Caption,,0,0,0,,ЧЕЛОВЕК СПРАШИВАЕТ А СОБСТВЕННЫХ ГРАЖДАН ГРЕТЬ
Dialogue: 0,0:02:00.97,0:02:04.17,Caption,,0,0,0,,БУДЕМ? ЕМУ ОТВЕЧАЮТ ВЫ НЕПРАВИЛЬНО ПОНИМАЕТЕ ИНТЕРЕСЫ
Dialogue: 0,0:02:04.17,0:02:08.81,Caption,,0,0,0,,ГЕРМАНИИ. ТО ЕСТЬ, ВИДИМО, ИНТЕРЕСЫ ГЕРМАНИИ ТЕПЕРЬ НАДО ПОНИМАТЬ ОЧЕНЬ
Dialogue: 0,0:02:08.81,0:02:12.57,Caption,,0,0,0,,ПРАВИЛЬНО. НЕМЕЦ, КОТОРЫЙ СПРАШИВАЕТ ПРО СВОЙ ДОМ И СВОЙ СЧЁТ
Dialogue: 0,0:02:12.65,0:02:16.57,Caption,,0,0,0,,ЗА ОТОПЛЕНИЕ, РИСКУЕТ ОКАЗАТЬСЯ НЕДОСТАТОЧНО ПАТРИОТИЧНЫМ. А
Dialogue: 0,0:02:16.57,0:02:20.25,Caption,,0,0,0,,ПОЛИТИК, КОТОРЫЙ ВЫДЕЛЯЕТ ОЧЕРЕДНЫЕ ДЕНЬГИ ЗА ПРЕДЕЛЫ СТРАНЫ,
Dialogue: 0,0:02:20.49,0:02:23.45,Caption,,0,0,0,,КАК РАЗ ИНТЕРЕСЫ ГЕРМАНИИ ПОНИМАЕТ ПРАВИЛЬНО. И ТУТ
Dialogue: 0,0:02:23.45,0:02:26.01,Caption,,0,0,0,,ДАЖЕ СПОРИТЬ ОСОБО НЕ НАДО. ЦИФРЫ САМИ ВСЁ
Dialogue: 0,0:02:26.01,0:02:31.82,Caption,,0,0,0,,РАССКАЗЫВАЮТ. ЕВРОПЕЙСКАЯ КОМИССИЯ ОБЪЯВИЛА ЕЩЁ ОБ ОДНОМ ПАКЕТЕ
Dialogue: 0,0:02:31.82,0:02:35.02,Caption,,0,0,0,,ПОМОЩИ УКРАИНЕ НА ЧЕТЫРЕ МИЛЛИАРДА ТРИСТА ШЕСТЬДЕСЯТ
Dialogue: 0,0:02:35.02,0:02:38.30,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО. ГЕРМАНИЯ ОТДЕЛЬНО ДОБАВЛЯЕТ ДВЕСТИ
Dialogue: 0,0:02:38.30,0:02:41.26,Caption,,0,0,0,,МИЛЛИОНОВ НА УКРАИНСКУЮ ЭНЕРГЕТИКУ. А ОБЩИЙ ОБЪЁМ
Dialogue: 0,0:02:41.26,0:02:43.74,Caption,,0,0,0,,НЕМЕЦКОЙ ПОМОЩИ УКРАИНЕ С НАЧАЛА КОНФЛИКТА,
Dialogue: 0,0:02:43.97,0:02:49.10,Caption,,0,0,0,,СОГЛАСНО ПРИВЕДЁННОЙ ОЦЕНКЕ, ДОСТИГ ПРИМЕРНО СТА МИЛЛИАРДОВ ЕВРО. СТО МИЛЛИАРДОВ.
Dialogue: 0,0:02:49.34,0:02:53.98,Caption,,0,0,0,,ЧТОБЫ МАСШТАБ БЫЛ ПОНЯТНЕЕ, ЭТО СТО ТЫСЯЧ РАЗ ПО МИЛЛИОНУ ЕВРО. И
Dialogue: 0,0:02:54.06,0:02:57.10,Caption,,0,0,0,,ТУТ РЕЧЬ НЕ О ТОМ, ЧТО ЭТИ ДЕНЬГИ МОЖНО БЫЛО ПРОСТО ВЗЯТЬ И
Dialogue: 0,0:02:57.10,0:02:59.90,Caption,,0,0,0,,РАЗДАТЬ КАЖДОМУ НЕМЦУ ПО КОНВЕРТУ. ГОСУДАРСТВЕННЫЙ
Dialogue: 0,0:02:59.90,0:03:03.18,Caption,,0,0,0,,БЮДЖЕТ ТАК НЕ РАБОТАЕТ. ТУТ ДРУГОЕ ИНТЕРЕСНО. КОГДА
Dialogue: 0,0:03:03.18,0:03:05.34,Caption,,0,0,0,,РЕЧЬ ИДЁТ О БОЛЬШИХ ПОЛИТИЧЕСКИХ ЦЕЛЯХ,
Dialogue: 0,0:03:05.66,0:03:09.26,Caption,,0,0,0,,ДЕНЬГИ НАХОДЯТСЯ. МИЛЛИАРДЫ НАХОДЯТСЯ. НОВЫЕ ПАКЕТЫ
Dialogue: 0,0:03:09.26,0:03:12.38,Caption,,0,0,0,,НАХОДЯТСЯ. ДОПОЛНИТЕЛЬНЫЕ ПРОГРАММЫ НАХОДЯТСЯ. А
Dialogue: 0,0:03:12.46,0:03:14.78,Caption,,0,0,0,,КОГДА РАЗГОВОР ЗАХОДИТ О СОБСТВЕННОМ ЧЕЛОВЕКЕ,
Dialogue: 0,0:03:14.94,0:03:19.10,Caption,,0,0,0,,КОТОРЫЙ СЧИТАЕТ ОТОПЛЕНИЕ, НАЧИНАЕТСЯ УДИВИТЕЛЬНО СЛОЖНАЯ ФИЛОСОФИЯ ПРО
Dialogue: 0,0:03:19.10,0:03:23.18,Caption,,0,0,0,,ОТВЕТСТВЕННОСТЬ, ИНТЕРЕСЫ ГОСУДАРСТВА И НЕОБХОДИМОСТЬ ПОТЕРПЕТЬ. И
Dialogue: 0,0:03:23.26,0:03:25.90,Caption,,0,0,0,,ВЕДЬ ОТОПЛЕНИЕМ ДЕЛО УЖЕ НЕ ЗАКАНЧИВАЕТСЯ. ТЕПЕРЬ
Dialogue: 0,0:03:25.90,0:03:28.46,Caption,,0,0,0,,ДОБРАЛИСЬ ДО ПЕНСИЙ. В НЕСКОЛЬКИХ ЕВРОПЕЙСКИХ
Dialogue: 0,0:03:28.54,0:03:30.86,Caption,,0,0,0,,СТРАНАХ ПРАВИТЕЛЬСТВА НАЧИНАЮТ МЕНЯТЬ ПЕНСИОННЫЕ
Dialogue: 0,0:03:30.86,0:03:32.94,Caption,,0,0,0,,РАСХОДЫ. ПРИЧЁМ СПОСОБЫ РАЗНЫЕ,
Dialogue: 0,0:03:33.18,0:03:35.74,Caption,,0,0,0,,А НАПРАВЛЕНИЕ ОЧЕНЬ ЗНАКОМОЕ. СЧИТАТЬ БУДУТ
Dialogue: 0,0:03:35.74,0:03:38.94,Caption,,0,0,0,,ВНИМАТЕЛЬНЕЕ. ПЛАТИТЬ БУДУТ ОСТОРОЖНЕЕ. ПОЛУЧАТЬ
Dialogue: 0,0:03:38.94,0:03:44.90,Caption,,0,0,0,,ЛЮДЯМ СТАНЕТ ВЕСЕЛЕЕ. В ВЕЛИКОБРИТАНИИ ПРЕДЛОЖЕНО ИЗМЕНИТЬ МЕХАНИЗМ
Dialogue: 0,0:03:44.90,0:03:47.70,Caption,,0,0,0,,ИНДЕКСАЦИИ ПЕНСИЙ С ДВЕ ТЫСЯЧИ ТРИДЦАТОГО ГОДА И
Dialogue: 0,0:03:47.70,0:03:50.82,Caption,,0,0,0,,УБРАТЬ ОТТУДА ПОКАЗАТЕЛЬ РОСТА ЗАРПЛАТ. РУМЫНИЯ
Dialogue: 0,0:03:50.90,0:03:53.78,Caption,,0,0,0,,ЗАМОРОЗИЛА ГОСУДАРСТВЕННЫЕ ПЕНСИИ НА ДВА ГОДА. В
Dialogue: 0,0:03:53.78,0:03:57.06,Caption,,0,0,0,,ЧЕХИИ УРЕЗАЛИ ДОПОЛНИТЕЛЬНУЮ ИНДЕКСАЦИЮ. ВО ФРАНЦИИ
Dialogue: 0,0:03:57.06,0:03:59.94,Caption,,0,0,0,,ОБСУЖДАЛОСЬ ОГРАНИЧЕНИЕ ИНДЕКСАЦИИ ДЛЯ ПЕНСИОНЕРОВ С
Dialogue: 0,0:03:59.94,0:04:02.58,Caption,,0,0,0,,ВЫПЛАТАМИ ДО ТЫСЯЧИ ДВУХСОТ ШЕСТИДЕСЯТИ ЕВРО В
Dialogue: 0,0:04:02.58,0:04:05.54,Caption,,0,0,0,,МЕСЯЦ. В СЛОВАКИИ ХОТЯТ ЖЁСТЧЕ ПРИВЯЗАТЬ ПЕНСИОННЫЙ
Dialogue: 0,0:04:05.54,0:04:08.66,Caption,,0,0,0,,ВОЗРАСТ К ОЖИДАЕМОЙ ПРОДОЛЖИТЕЛЬНОСТИ ЖИЗНИ. ХОРОШАЯ
Dialogue: 0,0:04:08.66,0:04:11.38,Caption,,0,0,0,,ЗАБОТА О СТАРШЕМ ПОКОЛЕНИИ. ЧЕЛОВЕК ВСЮ ЖИЗНЬ
Dialogue: 0,0:04:11.46,0:04:14.50,Caption,,0,0,0,,РАБОТАЕТ. ВСЮ ЖИЗНЬ ПЛАТИТ НАЛОГИ. ВСЮ ЖИЗНЬ ЕМУ
Dialogue: 0,0:04:14.50,0:04:16.66,Caption,,0,0,0,,РАССКАЗЫВАЮТ ТЫ СЕЙЧАС ПЛАТИШЬ В СИСТЕМУ,
Dialogue: 0,0:04:16.90,0:04:19.62,Caption,,0,0,0,,ЗАТО ПОТОМ ГОСУДАРСТВО ТЕБЯ НЕ БРОСИТ. А ПОТОМ
Dialogue: 0,0:04:19.62,0:04:22.50,Caption,,0,0,0,,НАСТУПАЕТ ЭТО САМОЕ ПОТОМ. И ГОСУДАРСТВО ДОСТАЁТ
Dialogue: 0,0:04:22.50,0:04:25.06,Caption,,0,0,0,,КАЛЬКУЛЯТОР. ПРИЧЁМ ПЕНСИОНЕР ЗДЕСЬ ИДЕАЛЬНЫЙ
Dialogue: 0,0:04:25.06,0:04:28.02,Caption,,0,0,0,,КЛИЕНТ. МОЛОДОЙ ЕЩЁ МОЖЕТ СМЕНИТЬ РАБОТУ. МОЖЕТ
Dialogue: 0,0:04:28.02,0:04:31.22,Caption,,0,0,0,,УЕХАТЬ. МОЖЕТ ПОПРОБОВАТЬ ЗАРАБОТАТЬ БОЛЬШЕ. МОЖЕТ
Dialogue: 0,0:04:31.22,0:04:33.62,Caption,,0,0,0,,НАЧАТЬ ЧТО ТО ЗАНОВО. А ПЕНСИОНЕРУ КУДА?
Dialogue: 0,0:04:33.94,0:04:36.90,Caption,,0,0,0,,ЕМУ В СЕМЬДЕСЯТ ЛЕТ ОБЪЯСНЯТ, ЧТО РЫНОК ИЗМЕНИЛСЯ,
Dialogue: 0,0:04:37.06,0:04:39.46,Caption,,0,0,0,,БЮДЖЕТ НАПРЯЖЁННЫЙ И НАДО ПРОЯВИТЬ ФИНАНСОВУЮ
Dialogue: 0,0:04:39.46,0:04:42.50,Caption,,0,0,0,,ГИБКОСТЬ? ПОЙТИ ВЕЧЕРОМ ЕЩЁ ОДНУ СМЕНУ ОТРАБОТАТЬ?
Dialogue: 0,0:04:42.95,0:04:45.86,Caption,,0,0,0,,ТАК И ВИДИТСЯ ОБЪЯВЛЕНИЕ ТРЕБУЕТСЯ ПЕНСИОНЕР. ОПЫТ
Dialogue: 0,0:04:45.86,0:04:48.58,Caption,,0,0,0,,РАБОТЫ СОРОК ПЯТЬ ЛЕТ. ВОЗРАСТ ОТ СЕМИДЕСЯТИ.
Dialogue: 0,0:04:48.86,0:04:51.22,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО КРЕПКОЕ ЗДОРОВЬЕ. ПЕНСИЯ НЕ
Dialogue: 0,0:04:51.22,0:04:56.39,Caption,,0,0,0,,ГАРАНТИРУЕТСЯ. И ВЕДЬ ЭТО УЖЕ НЕ ОДНА ГЕРМАНИЯ. НЕ
Dialogue: 0,0:04:56.47,0:04:59.03,Caption,,0,0,0,,ОДНА ФРАНЦИЯ. НЕ ОДНА РУМЫНИЯ. НЕ ОДНА
Dialogue: 0,0:04:59.03,0:05:01.27,Caption,,0,0,0,,ВЕЛИКОБРИТАНИЯ. СПОСОБЫ РАЗНЫЕ,
Dialogue: 0,0:05:01.54,0:05:03.91,Caption,,0,0,0,,НО ПРОБЛЕМА В ЕВРОПЕ СТАНОВИТСЯ ВСЁ ЗАМЕТНЕЕ.
Dialogue: 0,0:05:04.23,0:05:08.23,Caption,,0,0,0,,ГОСУДАРСТВА ИЩУТ, ГДЕ СОКРАТИТЬ НАГРУЗКУ НА БЮДЖЕТ. И СОЦИАЛЬНЫЕ
Dialogue: 0,0:05:08.23,0:05:10.71,Caption,,0,0,0,,РАСХОДЫ ПОСТЕПЕННО ПЕРЕСТАЮТ БЫТЬ ТОЙ СВЯЩЕННОЙ
Dialogue: 0,0:05:10.71,0:05:14.47,Caption,,0,0,0,,КОРОВОЙ, КОТОРУЮ НИКТО НЕ ТРОГАЕТ. СНАЧАЛА ДОРОЖАЕТ ЖИЗНЬ.
Dialogue: 0,0:05:14.71,0:05:17.11,Caption,,0,0,0,,ПОТОМ МОЛОДЁЖЬ ВСЁ ДАЛЬШЕ ОТ СОБСТВЕННОГО ЖИЛЬЯ.
Dialogue: 0,0:05:17.44,0:05:20.31,Caption,,0,0,0,,ПОТОМ ЛЮДИ НАЧИНАЮТ ЭКОНОМИТЬ НА ОТОПЛЕНИИ. ТЕПЕРЬ
Dialogue: 0,0:05:20.31,0:05:22.63,Caption,,0,0,0,,ГОСУДАРСТВО НАЧИНАЕТ ВНИМАТЕЛЬНЕЕ СМОТРЕТЬ НА
Dialogue: 0,0:05:22.63,0:05:26.71,Caption,,0,0,0,,ПЕНСИИ. ВОТ ОНА, РАСПЛАТА. НЕ ОБЯЗАТЕЛЬНО В ВИДЕ ОДНОГО БОЛЬШОГО
Dialogue: 0,0:05:26.71,0:05:29.75,Caption,,0,0,0,,ВЗРЫВА. ОНА ПРИХОДИТ ЧАСТЯМИ. КВИТАНЦИЕЙ.
Dialogue: 0,0:05:29.90,0:05:33.35,Caption,,0,0,0,,ИНДЕКСАЦИЕЙ. ПЕНСИОННЫМ ВОЗРАСТОМ. ЦЕНОЙ ГАЗА.
Dialogue: 0,0:05:33.59,0:05:36.23,Caption,,0,0,0,,РЕЙТИНГОМ ПРАВИТЕЛЬСТВА. А С РЕЙТИНГАМИ ВООБЩЕ
Dialogue: 0,0:05:36.31,0:05:38.95,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОТДЕЛЬНАЯ КОМЕДИЯ. ФРИДРИХОМ МЕРЦЕМ
Dialogue: 0,0:05:38.95,0:05:41.35,Caption,,0,0,0,,СЕЙЧАС НЕДОВОЛЬНЫ ВОСЕМЬДЕСЯТ ДВА ПРОЦЕНТА
Dialogue: 0,0:05:41.43,0:05:44.55,Caption,,0,0,0,,ОПРОШЕННЫХ НЕМЦЕВ. ВОСЕМЬДЕСЯТ ДВА. ДОВОЛЬНЫ ЕГО
Dialogue: 0,0:05:44.63,0:05:47.03,Caption,,0,0,0,,РАБОТОЙ ТРИНАДЦАТЬ ПРОЦЕНТОВ. ДАВАЙТЕ ПРОСТО
Dialogue: 0,0:05:47.03,0:05:49.91,Caption,,0,0,0,,ПРЕДСТАВИМ СТО ЧЕЛОВЕК В КОМНАТЕ. ТРИНАДЦАТЬ ГОВОРЯТ
Dialogue: 0,0:05:49.91,0:05:52.71,Caption,,0,0,0,,НОРМАЛЬНО РАБОТАЕТ. ВОСЕМЬДЕСЯТ ДВА ГОВОРЯТ НЕТ,
Dialogue: 0,0:05:52.80,0:05:55.75,Caption,,0,0,0,,НАС ЭТО НЕ УСТРАИВАЕТ. И МЕРЦ ПРОДОЛЖАЕТ СПОКОЙНО
Dialogue: 0,0:05:55.83,0:06:00.23,Caption,,0,0,0,,РУКОВОДИТЬ СТРАНОЙ. ДА, В ГЕРМАНИИ ПАРЛАМЕНТСКАЯ СИСТЕМА. ПЛОХОЙ ОПРОС
Dialogue: 0,0:06:00.23,0:06:03.43,Caption,,0,0,0,,АВТОМАТИЧЕСКИ КАНЦЛЕРА НЕ СНИМАЕТ. ЕСТЬ ПАРЛАМЕНТ,
Dialogue: 0,0:06:03.51,0:06:07.03,Caption,,0,0,0,,КОАЛИЦИЯ, ПРОЦЕДУРЫ, ВЫБОРЫ. ВСЁ ПРАВИЛЬНО.
Dialogue: 0,0:06:09.31,0:06:11.63,Caption,,0,0,0,,НО ГЛАВНЫЙ ВОПРОС ОТ ЭТОГО НИКУДА НЕ ИСЧЕЗАЕТ.
Dialogue: 0,0:06:11.97,0:06:14.67,Caption,,0,0,0,,ДЕМОКРАТИЯ ОЗНАЧАЕТ ВЛАСТЬ НАРОДА. А ЕСЛИ
Dialogue: 0,0:06:14.67,0:06:17.07,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ДВА ПРОЦЕНТА ОПРОШЕННЫХ НЕДОВОЛЬНЫ
Dialogue: 0,0:06:17.07,0:06:19.47,Caption,,0,0,0,,КАНЦЛЕРОМ, А ОН ПРОДОЛЖАЕТ РУКОВОДИТЬ,
Dialogue: 0,0:06:19.71,0:06:23.47,Caption,,0,0,0,,ЧТО ЭТО ЗА ВЛАСТЬ НАРОДА? НА БУМАГЕ ВСЁ КРАСИВО. А В ЖИЗНИ?
Dialogue: 0,0:06:23.79,0:06:25.95,Caption,,0,0,0,,ТРИНАДЦАТЬ ПРОЦЕНТОВ ДОВОЛЬНЫХ НЕДОСТАТОЧНО?
Dialogue: 0,0:06:26.17,0:06:28.51,Caption,,0,0,0,,А СКОЛЬКО НАДО? ДЕСЯТЬ? ПЯТЬ? ТРИ?
Dialogue: 0,0:06:28.83,0:06:30.75,Caption,,0,0,0,,ИЛИ МОЖНО ВООБЩЕ ОСТАВИТЬ ОДНОГО ДОВОЛЬНОГО
Dialogue: 0,0:06:30.75,0:06:35.23,Caption,,0,0,0,,ЧЕЛОВЕКА. ГЛАВНОЕ, ЧТОБЫ ОН СИДЕЛ В НУЖНОМ КАБИНЕТЕ. ОСОБЕННО ВЕСЕЛО
Dialogue: 0,0:06:35.31,0:06:38.11,Caption,,0,0,0,,ВСЁ ВЫГЛЯДИТ РЯДОМ С ПАРТИЙНЫМИ РЕЙТИНГАМИ. АДГ В
Dialogue: 0,0:06:38.19,0:06:40.67,Caption,,0,0,0,,ТОМ ЖЕ ОПРОСЕ ПОЛУЧАЕТ ДВАДЦАТЬ ДЕВЯТЬ ПРОЦЕНТОВ.
Dialogue: 0,0:06:40.98,0:06:46.59,Caption,,0,0,0,,ХДС И ХСС, БЛОК МЕРЦА, ДЕВЯТНАДЦАТЬ. СОЦИАЛ ДЕМОКРАТЫ ЧЕТЫРНАДЦАТЬ. ТО ЕСТЬ
Dialogue: 0,0:06:46.63,0:06:49.63,Caption,,0,0,0,,АДГ ОПЕРЕЖАЕТ БЛОК КАНЦЛЕРА СРАЗУ НА ДЕСЯТЬ
Dialogue: 0,0:06:49.63,0:06:53.15,Caption,,0,0,0,,ПРОЦЕНТНЫХ ПУНКТОВ. АДГ НЕ ТОЛЬКО РАСТЁТ. ВОКРУГ НЕЁ
Dialogue: 0,0:06:53.15,0:06:55.95,Caption,,0,0,0,,УЖЕ ДЕЙСТВУЕТ ПОЛИТИЧЕСКИЙ БАРЬЕР. С НЕЙ НЕ ХОТЯТ
Dialogue: 0,0:06:55.95,0:06:58.99,Caption,,0,0,0,,СТРОИТЬ КОАЛИЦИИ. ЕЁ СТАРАЮТСЯ ДЕРЖАТЬ ПОДАЛЬШЕ ОТ
Dialogue: 0,0:06:59.07,0:07:01.87,Caption,,0,0,0,,РЕАЛЬНОГО ДОСТУПА К ВЛАСТИ. И ПОЛУЧАЕТСЯ ИНТЕРЕСНАЯ
Dialogue: 0,0:07:01.87,0:07:05.31,Caption,,0,0,0,,ДЕМОКРАТИЯ. ГОЛОСОВАТЬ МОЖНО. РЕЙТИНГ РАСТИ МОЖЕТ.
Dialogue: 0,0:07:05.55,0:07:08.27,Caption,,0,0,0,,ПЕРВОЕ МЕСТО В ОПРОСАХ ЗАНИМАТЬ МОЖНО. НО ЕСТЬ
Dialogue: 0,0:07:08.35,0:07:11.79,Caption,,0,0,0,,ЕЩЁ ОДИН МАЛЕНЬКИЙ ПУНКТ. ПРАВИТЬ НЕЛЬЗЯ. НУ ХОРОШО.
Dialogue: 0,0:07:12.10,0:07:14.19,Caption,,0,0,0,,А ЕСЛИ ЧЕЛОВЕК ГОЛОСУЕТ ИМЕННО ЗА НИХ?
Dialogue: 0,0:07:14.51,0:07:16.35,Caption,,0,0,0,,ЕСЛИ ТАКИХ ЛЮДЕЙ СТАНОВИТСЯ БОЛЬШЕ?
Dialogue: 0,0:07:16.75,0:07:19.23,Caption,,0,0,0,,ЕСЛИ ДЕЙСТВУЮЩИМ КАНЦЛЕРОМ НЕДОВОЛЬНЫ ВОСЕМЬДЕСЯТ
Dialogue: 0,0:07:19.23,0:07:23.90,Caption,,0,0,0,,ДВА ПРОЦЕНТА? ЧТО ДОЛЖЕН СДЕЛАТЬ ИЗБИРАТЕЛЬ,
Dialogue: 0,0:07:24.14,0:07:26.86,Caption,,0,0,0,,ЧТОБЫ ЕГО МНЕНИЕ НАКОНЕЦ НАЧАЛО МЕНЯТЬ НАПРАВЛЕНИЕ
Dialogue: 0,0:07:26.86,0:07:28.94,Caption,,0,0,0,,ПОЛИТИКИ? ПРОГОЛОСОВАТЬ ЕЩЁ РАЗ?
Dialogue: 0,0:07:29.07,0:07:33.34,Caption,,0,0,0,,ЕЩЁ СИЛЬНЕЕ? ДВУМЯ РУКАМИ? ВОТ ТУТ УЖЕ ВОПРОС ДАЖЕ НЕ ПРО МЕРЦА.
Dialogue: 0,0:07:33.48,0:07:38.38,Caption,,0,0,0,,МЕРЦ СЕГОДНЯ ЕСТЬ, ЗАВТРА БУДЕТ ДРУГОЙ КАНЦЛЕР. РЕЧЬ О МЕХАНИЗМЕ. ЕСЛИ
Dialogue: 0,0:07:38.38,0:07:41.42,Caption,,0,0,0,,ГРАЖДАНИНУ ГОВОРЯТ, ЧТО ИСТОЧНИК ВЛАСТИ ЭТО ОН,
Dialogue: 0,0:07:41.73,0:07:44.22,Caption,,0,0,0,,А ПОТОМ ЕГО ВЫБОР УПИРАЕТСЯ В ЗАРАНЕЕ ПОСТРОЕННУЮ
Dialogue: 0,0:07:44.30,0:07:46.86,Caption,,0,0,0,,СТЕНУ, РАНО ИЛИ ПОЗДНО ЧЕЛОВЕК СПРОСИТ РЕБЯТА,
Dialogue: 0,0:07:47.09,0:07:49.02,Caption,,0,0,0,,А ЗАЧЕМ ТОГДА ВООБЩЕ НУЖЕН МОЙ ГОЛОС?
Dialogue: 0,0:07:49.42,0:07:51.98,Caption,,0,0,0,,И ЭТО ОЧЕНЬ ОПАСНЫЙ ВОПРОС ДЛЯ ЛЮБОЙ ПОЛИТИЧЕСКОЙ
Dialogue: 0,0:07:51.98,0:07:54.46,Caption,,0,0,0,,СИСТЕМЫ. ПОТОМУ ЧТО ПОКА ЧЕЛОВЕК ЗЛИТСЯ НА
Dialogue: 0,0:07:54.46,0:07:58.86,Caption,,0,0,0,,КОНКРЕТНОГО КАНЦЛЕРА, МОЖНО ПОМЕНЯТЬ КАНЦЛЕРА. ПОКА ЗЛИТСЯ НА КОНКРЕТНУЮ
Dialogue: 0,0:07:58.86,0:08:01.74,Caption,,0,0,0,,ПАРТИЮ, МОЖНО ПОМЕНЯТЬ ПАРТИЮ. ХУЖЕ,
Dialogue: 0,0:08:01.84,0:08:04.30,Caption,,0,0,0,,КОГДА ОН НАЧИНАЕТ ЗЛИТЬСЯ УЖЕ НА САМ МЕХАНИЗМ.
Dialogue: 0,0:08:04.51,0:08:06.54,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ.
Dialogue: 0,0:08:07.33,0:08:09.82,Caption,,0,0,0,,В РОССИИ УСКОРИЛАСЬ ПЕРЕДАЧА АКТИВОВ ИНОСТРАННЫХ
Dialogue: 0,0:08:09.82,0:08:12.38,Caption,,0,0,0,,КОМПАНИЙ ПОД ВРЕМЕННОЕ УПРАВЛЕНИЕ. ОДНОЙ ИЗ
Dialogue: 0,0:08:12.38,0:08:14.62,Caption,,0,0,0,,ПОСЛЕДНИХ СТАЛА ЯПОНСКАЯ JAPAN TOBACCO
Dialogue: 0,0:08:14.62,0:08:17.18,Caption,,0,0,0,,INTERNATIONAL. ПОД КОНТРОЛЬ РОССИЙСКОЙ СТРУКТУРЫ
Dialogue: 0,0:08:17.18,0:08:20.30,Caption,,0,0,0,,ПЕРЕДАЮТСЯ ДОЛИ СРАЗУ В ЧЕТЫРЁХ КОМПАНИЯХ. КОМПАНИЯ
Dialogue: 0,0:08:20.30,0:08:24.22,Caption,,0,0,0,,БОЛЬШАЯ. БРЕНДЫ ИЗВЕСТНЫЕ. WINSTON. CAMEL. AMERICAN
Dialogue: 0,0:08:24.30,0:08:27.66,Caption,,0,0,0,,SPIRIT. BENSON AND HEDGES. И ЭТО НЕ ОДИНОЧНАЯ
Dialogue: 0,0:08:27.66,0:08:30.14,Caption,,0,0,0,,ИСТОРИЯ. ДО НЕЁ ПОД ВРЕМЕННОЕ УПРАВЛЕНИЕ УЖЕ
Dialogue: 0,0:08:30.14,0:08:32.38,Caption,,0,0,0,,ПОПАДАЛИ АКТИВЫ NESTLÉ, METRO,
Dialogue: 0,0:08:32.58,0:08:34.93,Caption,,0,0,0,,AUCHAN И ДРУГИХ ИНОСТРАННЫХ КОМПАНИЙ.
Dialogue: 0,0:08:37.21,0:08:39.05,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ ЕВРОПЕЙСКОГО БИЗНЕСА,
Dialogue: 0,0:08:39.21,0:08:41.21,Caption,,0,0,0,,КОТОРЫХ ЦИТИРУЕТ LE MONDE, ГОВОРЯТ,
Dialogue: 0,0:08:41.45,0:08:43.77,Caption,,0,0,0,,ЧТО ЗА ПОСЛЕДНИЕ ДВА МЕСЯЦА ПРОЦЕСС ЗАМЕТНО
Dialogue: 0,0:08:43.77,0:08:46.65,Caption,,0,0,0,,УСКОРИЛСЯ. ОДИН ИЗ НИХ СФОРМУЛИРОВАЛ ВООБЩЕ
Dialogue: 0,0:08:46.73,0:08:49.61,Caption,,0,0,0,,ПРЕКРАСНО. НАМ ГОВОРЯТ ВОЗВРАЩАТЬСЯ В РОССИЮ,
Dialogue: 0,0:08:49.93,0:08:52.65,Caption,,0,0,0,,А ЗДЕСЬ К ГОРЛУ ПРИСТАВЛЯЮТ НОЖ. ВОТ ТАКАЯ
Dialogue: 0,0:08:52.73,0:08:55.13,Caption,,0,0,0,,ЛЮБОВЬ НА РАССТОЯНИИ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:08:55.29,0:08:57.77,Caption,,0,0,0,,КИРИЛЛ ДМИТРИЕВ ВСТРЕЧАЕТСЯ С ИНОСТРАННЫМ БИЗНЕСОМ,
Dialogue: 0,0:08:57.93,0:09:00.49,Caption,,0,0,0,,ГОВОРИТ О СОТРУДНИЧЕСТВЕ, О ВОЗВРАЩЕНИИ,
Dialogue: 0,0:09:00.73,0:09:03.21,Caption,,0,0,0,,О БУДУЩИХ ВОЗМОЖНОСТЯХ. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:09:03.45,0:09:06.01,Caption,,0,0,0,,КОМПАНИИ СМОТРЯТ НА СОБСТВЕННЫЕ АКТИВЫ И НАЧИНАЮТ
Dialogue: 0,0:09:06.01,0:09:09.05,Caption,,0,0,0,,ПОДОЗРЕВАТЬ, ЧТО ВОЗВРАЩАТЬСЯ СКОРО ПРИДЁТСЯ УЖЕ НЕ В СВОЙ
Dialogue: 0,0:09:09.13,0:09:12.89,Caption,,0,0,0,,ОФИС. ПРИЕХАЛ. ПОЗДОРОВАЛСЯ. ПОКАЗАЛ ПАСПОРТ. А НА
Dialogue: 0,0:09:12.89,0:09:16.01,Caption,,0,0,0,,ПРОХОДНОЙ ГОВОРЯТ ВЫ К КОМУ? В КОМПАНИЮ. А ВЫ КТО?
Dialogue: 0,0:09:16.16,0:09:19.05,Caption,,0,0,0,,ВЛАДЕЛЕЦ. ОЧЕНЬ ПРИЯТНО. ЗАПИШИТЕСЬ НА ПРИЁМ.
Dialogue: 0,0:09:19.61,0:09:21.37,Caption,,0,0,0,,И ВЕДЬ В ЭТОМ ТОЖЕ ЕСТЬ СВОЯ РАСПЛАТА.
Dialogue: 0,0:09:21.77,0:09:24.33,Caption,,0,0,0,,ЗАПАДНЫЕ КОМПАНИИ ГОДАМИ ПЫТАЛИСЬ СОХРАНИТЬ
Dialogue: 0,0:09:24.41,0:09:28.41,Caption,,0,0,0,,РОССИЙСКИЙ БИЗНЕС, НЕСМОТРЯ НА ПОЛИТИЧЕСКИЙ КОНФЛИКТ. КТО ТО УХОДИЛ.
Dialogue: 0,0:09:28.74,0:09:31.53,Caption,,0,0,0,,КТО ТО ОСТАВАЛСЯ. КТО ТО ПРОДАВАЛ. КТО ТО
Dialogue: 0,0:09:31.53,0:09:34.49,Caption,,0,0,0,,ЖДАЛ, ЧТО ВСЁ ЗАКОНЧИТСЯ И МОЖНО БУДЕТ СНОВА СПОКОЙНО
Dialogue: 0,0:09:34.49,0:09:37.21,Caption,,0,0,0,,ЗАРАБАТЫВАТЬ. А ТЕПЕРЬ ПОЛИТИКА ПРИШЛА ПРЯМО В
Dialogue: 0,0:09:37.21,0:09:39.45,Caption,,0,0,0,,БУХГАЛТЕРИЮ. И ТУТ УЖЕ РАЗГОВОР ИДЁТ НЕ ПРО
Dialogue: 0,0:09:39.45,0:09:42.17,Caption,,0,0,0,,ВЫСОКИЕ ЦЕННОСТИ. ТУТ РЕЧЬ ПРО ЗАВОДЫ,
Dialogue: 0,0:09:42.26,0:09:47.21,Caption,,0,0,0,,ДОЛИ, МАГАЗИНЫ, ИМУЩЕСТВО И ДЕНЬГИ. У БОЛЬШОЙ ПОЛИТИКИ ВООБЩЕ ЕСТЬ
Dialogue: 0,0:09:47.29,0:09:52.06,Caption,,0,0,0,,НЕПРИЯТНАЯ ПРИВЫЧКА. ПОКА ПОЛИТИКИ СПОРЯТ,
Dialogue: 0,0:09:52.14,0:09:55.82,Caption,,0,0,0,,БИЗНЕС ДУМАЕТ, ЧТО ГЛАВНОЕ ПЕРЕЖДАТЬ. А ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:09:56.05,0:09:58.30,Caption,,0,0,0,,ЧТО ПЕРЕЖИДАТЬ НАДО БЫЛО ВМЕСТЕ С КЛЮЧАМИ ОТ
Dialogue: 0,0:09:58.30,0:10:01.26,Caption,,0,0,0,,ПРЕДПРИЯТИЯ. ПРИЧЁМ ЯПОНСКАЯ ИСТОРИЯ ОСОБЕННО
Dialogue: 0,0:10:01.26,0:10:04.46,Caption,,0,0,0,,ПОКАЗАТЕЛЬНАЯ. ОТНОШЕНИЯ МОСКВЫ И ТОКИО В ПОСЛЕДНЕЕ
Dialogue: 0,0:10:04.54,0:10:07.42,Caption,,0,0,0,,ВРЕМЯ ТОЖЕ УХУДШАЛИСЬ. ОТДЕЛЬНО СООБЩАЕТСЯ О
Dialogue: 0,0:10:07.42,0:10:10.54,Caption,,0,0,0,,ПЕРЕДАЧЕ ЯПОНИЕЙ БЕСПИЛОТНИКОВ УКРАИНЕ И РОССИЙСКОМ
Dialogue: 0,0:10:10.54,0:10:13.34,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИИ О ЖЁСТКОМ ОТВЕТЕ. И ВСКОРЕ КРУПНАЯ
Dialogue: 0,0:10:13.34,0:10:16.06,Caption,,0,0,0,,ЯПОНСКАЯ КОМПАНИЯ ТЕРЯЕТ КОНТРОЛЬ НАД РОССИЙСКИМИ
Dialogue: 0,0:10:16.06,0:10:19.02,Caption,,0,0,0,,АКТИВАМИ. МОЖНО СКОЛЬКО УГОДНО СПОРИТЬ О ЮРИДИЧЕСКИХ
Dialogue: 0,0:10:19.02,0:10:21.58,Caption,,0,0,0,,ФОРМУЛИРОВКАХ. ДЛЯ БИЗНЕСА ПЕРЕВОД ПРОСТОЙ
Dialogue: 0,0:10:21.58,0:10:24.70,Caption,,0,0,0,,ГЕОПОЛИТИКА НАКОНЕЦ ДОШЛА ДО СОБСТВЕННОСТИ. А ТЕПЕРЬ
Dialogue: 0,0:10:24.78,0:10:27.58,Caption,,0,0,0,,АРМЕНИЯ. ВОТ ГДЕ ВООБЩЕ НАЧИНАЕТСЯ ОТДЕЛЬНЫЙ
Dialogue: 0,0:10:27.58,0:10:30.38,Caption,,0,0,0,,АТТРАКЦИОН. ПАРТНЁРЫ ПО ЕВРАЗИЙСКОМУ ЭКОНОМИЧЕСКОМУ
Dialogue: 0,0:10:30.38,0:10:32.94,Caption,,0,0,0,,СОЮЗУ ПОДГОТОВИЛИ РАСЧЁТЫ ПОСЛЕДСТВИЙ ВЫХОДА
Dialogue: 0,0:10:32.94,0:10:37.42,Caption,,0,0,0,,АРМЕНИИ. ПО ЭТИМ РАСЧЁТАМ, ЦЕНА ГАЗА ДЛЯ СТРАНЫ СПОСОБНА ВЫРАСТИ ПРИМЕРНО НА
Dialogue: 0,0:10:37.42,0:10:40.30,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ДЕВЯТЬ ПРОЦЕНТОВ. А ВВП В ТЯЖЁЛОМ
Dialogue: 0,0:10:40.30,0:10:42.86,Caption,,0,0,0,,СЦЕНАРИИ ТЕРЯЕТ ПЯТНАДЦАТЬ ЦЕЛЫХ ШЕСТЬ ДЕСЯТЫХ
Dialogue: 0,0:10:42.86,0:10:46.46,Caption,,0,0,0,,ПРОЦЕНТА. БОЛЬШЕ ПЯТНАДЦАТИ ПРОЦЕНТОВ ЭКОНОМИКИ. ЭТО
Dialogue: 0,0:10:46.46,0:10:48.78,Caption,,0,0,0,,УЖЕ НЕ РАЗГОВОР ПРО ТАБЛИЧКУ НА ДВЕРИ. ЭТО
Dialogue: 0,0:10:48.86,0:10:51.34,Caption,,0,0,0,,НЕ ПОМЕНЯЛИ ФЛАГ ВОЗЛЕ МИНИСТЕРСТВА И ПОШЛИ ДОМОЙ.
Dialogue: 0,0:10:51.58,0:10:54.54,Caption,,0,0,0,,ЭТО ОГРОМНЫЙ КУСОК СТРАНЫ. ПАШИНЯН С ЭТИМИ РАСЧЁТАМИ
Dialogue: 0,0:10:54.54,0:10:57.90,Caption,,0,0,0,,НЕ СОГЛАСИЛСЯ. ХОРОШО. МОЖНО НЕ СОГЛАШАТЬСЯ. МОЖНО
Dialogue: 0,0:10:57.90,0:11:00.94,Caption,,0,0,0,,СПОРИТЬ С МЕТОДИКОЙ. МОЖНО ПРИНЕСТИ СВОЙ ДОКЛАД.
Dialogue: 0,0:11:03.21,0:11:06.57,Caption,,0,0,0,,МОЖНО СКАЗАТЬ, ЧТО ВСЁ БУДЕТ НАОБОРОТ И ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ
Dialogue: 0,0:11:06.65,0:11:09.37,Caption,,0,0,0,,АРМЯНЕ БУДУТ ЖИТЬ КАК ШВЕЙЦАРЦЫ. НО САМ ВОПРОС
Dialogue: 0,0:11:09.37,0:11:12.25,Caption,,0,0,0,,ОТ ЭТОГО НИКУДА НЕ ИСЧЕЗАЕТ. АРМЕНИЯ СОБИРАЕТСЯ
Dialogue: 0,0:11:12.33,0:11:15.21,Caption,,0,0,0,,ДВИГАТЬСЯ В ЕВРОСОЮЗ. ПАШИНЯН ГОВОРИЛ О ВОЗМОЖНОЙ
Dialogue: 0,0:11:15.29,0:11:17.29,Caption,,0,0,0,,ЗАЯВКЕ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ИЛИ ДВЕ
Dialogue: 0,0:11:17.37,0:11:19.69,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ОДНОВРЕМЕННО ОН
Dialogue: 0,0:11:19.69,0:11:22.89,Caption,,0,0,0,,ПРИЗНАЁТ, ЧТО ЧЛЕНСТВО В ЕС И ЕАЭС ВМЕСТЕ НЕ
Dialogue: 0,0:11:22.89,0:11:26.73,Caption,,0,0,0,,РАБОТАЕТ. ЗНАЧИТ, В КАКОЙ ТО МОМЕНТ ПРИДЁТСЯ ВЫБИРАТЬ. И ВОТ
Dialogue: 0,0:11:26.73,0:11:29.05,Caption,,0,0,0,,ТУТ ХОЧЕТСЯ ВЗЯТЬ НИКОЛ ВОВАЕВИЧА ЗА РУКАВ И
Dialogue: 0,0:11:29.05,0:11:31.29,Caption,,0,0,0,,СПРОСИТЬ. ВЫ ВОКРУГ ВООБЩЕ СМОТРИТЕ?
Dialogue: 0,0:11:31.69,0:11:34.41,Caption,,0,0,0,,ТУРЦИЯ ПОДАЛА ЗАЯВКУ В ЕВРОПЕЙСКОЕ СООБЩЕСТВО ЕЩЁ В
Dialogue: 0,0:11:34.41,0:11:37.21,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ ВОСЕМЬДЕСЯТ СЕДЬМОМ ГОДУ. СТАТУС
Dialogue: 0,0:11:37.29,0:11:39.45,Caption,,0,0,0,,КАНДИДАТА ПОЛУЧИЛА В ТЫСЯЧА ДЕВЯТЬСОТ ДЕВЯНОСТО
Dialogue: 0,0:11:39.45,0:11:41.85,Caption,,0,0,0,,ДЕВЯТОМ. ПЕРЕГОВОРЫ О ВСТУПЛЕНИИ НАЧАЛИСЬ В ДВЕ
Dialogue: 0,0:11:41.85,0:11:44.73,Caption,,0,0,0,,ТЫСЯЧИ ПЯТОМ. НА ДВОРЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОЙ.
Dialogue: 0,0:11:44.92,0:11:48.49,Caption,,0,0,0,,ГДЕ ТУРЦИЯ? ВСЁ ЕЩЁ КАНДИДАТ. ТО ЕСТЬ ЧЕЛОВЕК МОЖЕТ РОДИТЬСЯ
Dialogue: 0,0:11:48.49,0:11:50.97,Caption,,0,0,0,,ПОСЛЕ ПОДАЧИ ТУРЕЦКОЙ ЗАЯВКИ, ВЫРАСТИ,
Dialogue: 0,0:11:51.19,0:11:54.17,Caption,,0,0,0,,ЗАКОНЧИТЬ ШКОЛУ, УНИВЕРСИТЕТ, ЖЕНИТЬСЯ,
Dialogue: 0,0:11:54.33,0:11:56.73,Caption,,0,0,0,,ЗАВЕСТИ ДЕТЕЙ, ОТПРАВИТЬ ИХ В ШКОЛУ,
Dialogue: 0,0:11:56.97,0:11:59.29,Caption,,0,0,0,,А ТУРЦИЯ ВСЁ ЕЩЁ БУДЕТ ИДТИ В ЕВРОСОЮЗ.
Dialogue: 0,0:11:59.45,0:12:02.49,Caption,,0,0,0,,ОТЛИЧНАЯ СКОРОСТЬ. РЯДОМ ГРУЗИЯ. У НЕЁ ТОЖЕ БЫЛ
Dialogue: 0,0:12:02.49,0:12:05.29,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ МАРШРУТ. ПОТОМ ОТНОШЕНИЯ С БРЮССЕЛЕМ
Dialogue: 0,0:12:05.29,0:12:08.25,Caption,,0,0,0,,НАЧАЛИ РЕЗКО ПОРТИТЬСЯ. ДО ВЗАИМНЫХ ОБВИНЕНИЙ И
Dialogue: 0,0:12:08.25,0:12:11.29,Caption,,0,0,0,,ФАКТИЧЕСКИ ОСТАНОВЛЕННОГО ДВИЖЕНИЯ. РЯДОМ УКРАИНА.
Dialogue: 0,0:12:13.56,0:12:18.36,Caption,,0,0,0,,УКРАИНА ПРЕКРАСНО ПОКАЗАЛА, ЧТО САМО СЛОВО "ЕВРОИНТЕГРАЦИЯ" НЕ ВЫДАЁТ ЧЕЛОВЕКУ
Dialogue: 0,0:12:18.36,0:12:20.92,Caption,,0,0,0,,ВОЛШЕБНЫЙ БИЛЕТ В КРАСИВУЮ ЖИЗНЬ НА СЛЕДУЮЩИЙ ДЕНЬ.
Dialogue: 0,0:12:21.43,0:12:23.88,Caption,,0,0,0,,И ВСЁ ЭТО ПАШИНЯН ВИДИТ. НЕ МОЖЕТ НЕ
Dialogue: 0,0:12:23.96,0:12:26.68,Caption,,0,0,0,,ВИДЕТЬ. ОН НЕ ЖИВЁТ НА ОТДЕЛЬНОЙ ПЛАНЕТЕ. ОН
Dialogue: 0,0:12:26.68,0:12:30.84,Caption,,0,0,0,,ПРЕКРАСНО ЗНАЕТ, СКОЛЬКО АРМЕНИЯ ТОРГУЕТ ЧЕРЕЗ ПРОСТРАНСТВО ЕАЭС.
Dialogue: 0,0:12:31.15,0:12:33.96,Caption,,0,0,0,,ЗНАЕТ ИСТОРИЮ С РОССИЙСКИМ ГАЗОМ. ЗНАЕТ,
Dialogue: 0,0:12:34.12,0:12:36.84,Caption,,0,0,0,,ГДЕ НАХОДИТСЯ ЕГО СТРАНА НА КАРТЕ. ЗНАЕТ,
Dialogue: 0,0:12:37.00,0:12:40.36,Caption,,0,0,0,,ЧЕРЕЗ КАКИЕ СОСЕДНИЕ ГОСУДАРСТВА ИДУТ ТОВАРЫ. ЗНАЕТ,
Dialogue: 0,0:12:40.52,0:12:43.64,Caption,,0,0,0,,ЧТО ТУРЦИЯ ДЕСЯТИЛЕТИЯМИ СТОИТ У ЕВРОПЕЙСКОЙ ДВЕРИ.
Dialogue: 0,0:12:43.87,0:12:47.40,Caption,,0,0,0,,И ВСЁ РАВНО ИДЁТ ДАЛЬШЕ. ВОТ ЗДЕСЬ ВОПРОС УЖЕ НЕ В ТОМ,
Dialogue: 0,0:12:47.56,0:12:50.68,Caption,,0,0,0,,ПОНИМАЕТ ЛИ ПАШИНЯН ПОСЛЕДСТВИЯ. ПРЕКРАСНО ПОНИМАЕТ.
Dialogue: 0,0:12:50.92,0:12:55.48,Caption,,0,0,0,,И ВИДИТ ВОКРУГ ПРИМЕРЫ, КОТОРЫЕ НИЧЕГО ХОРОШЕГО АРМЕНИИ НЕ ОБЕЩАЮТ. НО ВСЁ
Dialogue: 0,0:12:55.56,0:12:57.56,Caption,,0,0,0,,РАВНО ПРОДОЛЖАЕТ КУРС. ПОЧЕМУ?
Dialogue: 0,0:12:57.82,0:12:59.88,Caption,,0,0,0,,ЧТО ЗАСТАВЛЯЕТ ЕГО ИДТИ ДАЛЬШЕ,
Dialogue: 0,0:13:00.06,0:13:04.76,Caption,,0,0,0,,КОГДА РИСКИ ТАК ХОРОШО ВИДНЫ? И ГЛАВНЫЙ ВОПРОС ОН САМ ПРИНИМАЕТ ЭТО РЕШЕНИЕ?
Dialogue: 0,0:13:05.16,0:13:07.00,Caption,,0,0,0,,ИЛИ НА ЭТОТ ВЫБОР ВЛИЯЕТ ЧТО ТО ЕЩЁ?
Dialogue: 0,0:13:07.55,0:13:09.96,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ПОЛИТИК ВИДИТ ПЕРЕД СОБОЙ ЧУЖИЕ
Dialogue: 0,0:13:09.96,0:13:12.92,Caption,,0,0,0,,ПРИМЕРЫ, ВИДИТ СОБСТВЕННЫЙ ЭКОНОМИЧЕСКИЙ ЦЕННИК,
Dialogue: 0,0:13:13.24,0:13:16.28,Caption,,0,0,0,,ПОНИМАЕТ ГЕОГРАФИЮ СТРАНЫ И ВСЁ РАВНО ПРОДОЛЖАЕТ ТОТ
Dialogue: 0,0:13:16.36,0:13:20.52,Caption,,0,0,0,,ЖЕ МАРШРУТ, ЗНАЧИТ, ЗА ЭТИМ РЕШЕНИЕМ ДОЛЖНА СТОЯТЬ ОЧЕНЬ СЕРЬЁЗНАЯ
Dialogue: 0,0:13:20.60,0:13:23.64,Caption,,0,0,0,,ПРИЧИНА. ИМЕННО ЕЁ НАДО ИСКАТЬ. НЕ В КРАСИВЫХ
Dialogue: 0,0:13:23.64,0:13:25.24,Caption,,0,0,0,,СЛОВАХ ПРО ЕВРОПЕЙСКОЕ БУДУЩЕЕ.
Dialogue: 0,0:13:27.51,0:13:30.95,Caption,,0,0,0,,А В ТОМ, ЗАЧЕМ ПОЛИТИЧЕСКАЯ ВЛАСТЬ ГОТОВА ЗАПЛАТИТЬ ТАКУЮ
Dialogue: 0,0:13:30.95,0:13:33.51,Caption,,0,0,0,,ЦЕНУ УЖЕ СЕЙЧАС ЗА ОБЕЩАНИЕ РЕЗУЛЬТАТА,
Dialogue: 0,0:13:33.83,0:13:36.63,Caption,,0,0,0,,КОТОРЫЙ НИКТО НЕ ВЫДАЁТ ПО РАСПИСАНИЮ. ВОТ ЭТО,
Dialogue: 0,0:13:36.74,0:13:40.39,Caption,,0,0,0,,КСТАТИ, ОБЪЕДИНЯЕТ ВСЕ СЕГОДНЯШНИЕ ИСТОРИИ ГОРАЗДО СИЛЬНЕЕ,
Dialogue: 0,0:13:40.63,0:13:43.83,Caption,,0,0,0,,ЧЕМ КАЖЕТСЯ. НЕМЕЦКИЙ ПЕНСИОНЕР НИЧЕГО НЕ РЕШАЛ ПРО
Dialogue: 0,0:13:43.91,0:13:45.51,Caption,,0,0,0,,БОЛЬШУЮ ЕВРОПЕЙСКУЮ СТРАТЕГИЮ,
Dialogue: 0,0:13:45.83,0:13:48.63,Caption,,0,0,0,,НО ЕГО ПЕНСИЮ НАЧИНАЮТ СЧИТАТЬ ВНИМАТЕЛЬНЕЕ. МОЛОДОЙ
Dialogue: 0,0:13:48.63,0:13:50.71,Caption,,0,0,0,,НЕМЕЦ НЕ ПРИНИМАЛ РЕШЕНИЯ В БРЮССЕЛЕ,
Dialogue: 0,0:13:51.06,0:13:53.91,Caption,,0,0,0,,НО КВАРТИРУ КУПИТЬ ЕМУ ВСЁ ТЯЖЕЛЕЕ. ЧЕЛОВЕК,
Dialogue: 0,0:13:54.20,0:13:57.99,Caption,,0,0,0,,КОТОРЫЙ МЁРЗНЕТ ДОМА, НЕ РАСПРЕДЕЛЯЛ МЕЖДУНАРОДНЫЕ ПАКЕТЫ ПОМОЩИ,
Dialogue: 0,0:13:58.23,0:14:00.71,Caption,,0,0,0,,НО СЧЁТ ЗА ОТОПЛЕНИЕ ПРИХОДИТ ИМЕННО ЕМУ.
Dialogue: 0,0:14:01.19,0:14:03.59,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ БИЗНЕС МНОГО ЛЕТ УБЕЖДАЛ СЕБЯ,
Dialogue: 0,0:14:03.83,0:14:08.15,Caption,,0,0,0,,ЧТО ПОЛИТИКА ПОЛИТИКОЙ, А СОБСТВЕННОСТЬ СОБСТВЕННОСТЬЮ. ТЕПЕРЬ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:14:08.39,0:14:10.71,Caption,,0,0,0,,ЧТО ОДНО ПРЕКРАСНО УМЕЕТ ПРИХОДИТЬ ЗА ДРУГИМ.
Dialogue: 0,0:14:11.11,0:14:13.91,Caption,,0,0,0,,АРМЯНИНУ ОБЕЩАЮТ БОЛЬШОЕ ЕВРОПЕЙСКОЕ БУДУЩЕЕ,
Dialogue: 0,0:14:14.23,0:14:16.55,Caption,,0,0,0,,А РАСЧЁТЫ ЦЕНЫ ВЫХОДА ИЗ НЫНЕШНЕЙ ЭКОНОМИЧЕСКОЙ
Dialogue: 0,0:14:16.63,0:14:19.67,Caption,,0,0,0,,СИСТЕМЫ ЕМУ ПОКАЗЫВАЮТ УЖЕ СЕЙЧАС. ПРИ ЭТОМ ЛЮДИ,
Dialogue: 0,0:14:19.90,0:14:24.31,Caption,,0,0,0,,КОТОРЫЕ ПРИНИМАЮТ РЕШЕНИЯ, ПРОДОЛЖАЮТ СВОЙ КУРС. ВОТ ЭТО И ЕСТЬ ГЛАВНОЕ.
Dialogue: 0,0:14:24.71,0:14:27.19,Caption,,0,0,0,,РАСПЛАТА НЕ ОБЯЗАТЕЛЬНО ЗАСТАВЛЯЕТ ВЛАСТЬ МЕНЯТЬ
Dialogue: 0,0:14:27.19,0:14:29.99,Caption,,0,0,0,,НАПРАВЛЕНИЕ. ИНОГДА ПРОИСХОДИТ НАОБОРОТ. ЦЕНА
Dialogue: 0,0:14:29.99,0:14:33.27,Caption,,0,0,0,,РАСТЁТ. НЕДОВОЛЬСТВО РАСТЁТ. РЕЙТИНГИ ПАДАЮТ.
Dialogue: 0,0:14:33.43,0:14:36.95,Caption,,0,0,0,,СОЦИАЛЬНЫЕ РАСХОДЫ РЕЖУТ. БИЗНЕС ТЕРЯЕТ АКТИВЫ. НО
Dialogue: 0,0:14:36.95,0:14:38.55,Caption,,0,0,0,,ПОЛИТИК ПРОСТО ГОВОРИТ ЗНАЧИТ,
Dialogue: 0,0:14:38.79,0:14:44.52,Caption,,0,0,0,,НАДО ИДТИ ДАЛЬШЕ. И В КАКОЙ ТО МОМЕНТ ВОЗНИКАЕТ ОЧЕНЬ НЕПРИЯТНАЯ
Dialogue: 0,0:14:44.52,0:14:47.56,Caption,,0,0,0,,РАЗВИЛКА. ЕСЛИ ПОЛИТИЧЕСКИЙ КУРС МЕНЯЕТСЯ ТОЛЬКО
Dialogue: 0,0:14:47.56,0:14:49.96,Caption,,0,0,0,,ТОГДА, КОГДА ЭТОГО ХОЧЕТ САМА ВЛАСТЬ,
Dialogue: 0,0:14:50.36,0:14:53.00,Caption,,0,0,0,,А МАССОВОЕ НЕДОВОЛЬСТВО ОБЩЕСТВА НЕ МЕНЯЕТ НИЧЕГО,
Dialogue: 0,0:14:53.35,0:14:55.48,Caption,,0,0,0,,ЧЕЛОВЕК ПОСТЕПЕННО ПЕРЕСТАЁТ СПРАШИВАТЬ,
Dialogue: 0,0:14:55.56,0:14:58.60,Caption,,0,0,0,,ЗА КОГО ЕМУ ГОЛОСОВАТЬ. ОН ЗАДАЁТ ДРУГОЙ ВОПРОС.
Dialogue: 0,0:14:58.85,0:15:01.00,Caption,,0,0,0,,ЧТО ВООБЩЕ СПОСОБЕН ИЗМЕНИТЬ МОЙ ГОЛОС?
Dialogue: 0,0:15:01.30,0:15:03.64,Caption,,0,0,0,,И ВОТ ЭТОТ ВОПРОС ДЛЯ ЕВРОПЫ СЕЙЧАС НАМНОГО
Dialogue: 0,0:15:03.64,0:15:06.36,Caption,,0,0,0,,ОПАСНЕЕ ЛЮБОГО ПЛОХОГО РЕЙТИНГА ОДНОГО КАНЦЛЕРА.
Dialogue: 0,0:15:06.68,0:15:09.72,Caption,,0,0,0,,ПОТОМУ ЧТО МЕРЦ УЙДЁТ. ПАШИНЯН КОГДА НИБУДЬ УЙДЁТ.
Dialogue: 0,0:15:09.90,0:15:12.52,Caption,,0,0,0,,ФОН ДЕР ЛЯЙЕН КОГДА НИБУДЬ УЙДЁТ. ПРИХОДЯТ И
Dialogue: 0,0:15:12.52,0:15:14.68,Caption,,0,0,0,,УХОДЯТ ПРАВИТЕЛЬСТВА, МИНИСТРЫ,
Dialogue: 0,0:15:14.79,0:15:18.04,Caption,,0,0,0,,ПАРТИИ. А ВОТ ЕСЛИ ЧЕЛОВЕК ОДНАЖДЫ ПЕРЕСТАЁТ ВЕРИТЬ,
