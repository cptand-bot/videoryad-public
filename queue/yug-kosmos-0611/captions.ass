Dialogue: 0,0:00:00.12,0:00:03.32,Caption,,0,0,0,,ЗЕМЛЯ ЛЮДЯМ СТАЛА ТЕСНОВАТА. РЕШИЛИ ПОДНЯТЬСЯ ВЫШЕ.
Dialogue: 0,0:00:03.71,0:00:05.96,Caption,,0,0,0,,КАЗАЛОСЬ БЫ, НАВЕРХУ МЕСТА СТОЛЬКО,
Dialogue: 0,0:00:06.28,0:00:09.16,Caption,,0,0,0,,ЧТО МОЖНО НИКОМУ НЕ МЕШАТЬ ТЫСЯЧЕЛЕТИЯМИ. НО НЕТ.
Dialogue: 0,0:00:09.44,0:00:13.00,Caption,,0,0,0,,ДОБРАЛИСЬ ДО ОРБИТЫ И ПЕРВЫМ ДЕЛОМ НАЧАЛИ ВЫЯСНЯТЬ,
Dialogue: 0,0:00:13.09,0:00:15.56,Caption,,0,0,0,,КТО КОМУ ТАМ МЕШАЕТ. СТАБИЛЬНОСТЬ,
Dialogue: 0,0:00:15.72,0:00:18.28,Caption,,0,0,0,,ОНА ТАКАЯ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ,
Dialogue: 0,0:00:18.51,0:00:21.32,Caption,,0,0,0,,ГДЕ ЗА ОТДЕЛЬНЫМИ НОВОСТЯМИ ИЩУТ ОБЩУЮ ЛОГИКУ,
Dialogue: 0,0:00:21.47,0:00:24.36,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО ЗДЕСЬ ОНА УЖЕ ВЫЛЕЗЛА
Dialogue: 0,0:00:24.36,0:00:27.48,Caption,,0,0,0,,ДАЛЕКО ЗА ПРЕДЕЛЫ ЗЕМЛИ. В СЕНТЯБРЕ МИНИСТР ВОЕННО
Dialogue: 0,0:00:27.48,0:00:30.60,Caption,,0,0,0,,ВОЗДУШНЫХ СИЛ США ТРОЙ МЕЙНК СООБЩИЛ,
Dialogue: 0,0:00:30.84,0:00:33.96,Caption,,0,0,0,,ЧТО У АМЕРИКАНСКИХ КОСМИЧЕСКИХ СИЛ УЖЕ ЕСТЬ НА
Dialogue: 0,0:00:34.04,0:00:37.16,Caption,,0,0,0,,ОРБИТЕ ОРУЖИЕ КОНТРОЛЯ КОСМОСА. ОБРАТИТЕ ВНИМАНИЕ НА
Dialogue: 0,0:00:37.16,0:00:41.08,Caption,,0,0,0,,ФОРМУЛИРОВКУ. НЕ СОБИРАЮТСЯ КОГДА НИБУДЬ СДЕЛАТЬ. НЕ
Dialogue: 0,0:00:41.08,0:00:43.96,Caption,,0,0,0,,ИЗУЧАЮТ ПЕРСПЕКТИВНУЮ КОНЦЕПЦИЮ. НЕ РИСУЮТ
Dialogue: 0,0:00:43.96,0:00:47.88,Caption,,0,0,0,,ПРЕЗЕНТАЦИЮ ДЛЯ КОНГРЕССА. УЖЕ ЕСТЬ. ЧТО ИМЕННО ТАМ
Dialogue: 0,0:00:47.88,0:00:51.08,Caption,,0,0,0,,ЛЕТАЕТ, АМЕРИКАНЦЫ ПОДРОБНО НЕ ОБЪЯСНЯЮТ. И ЭТО,
Dialogue: 0,0:00:51.24,0:00:54.28,Caption,,0,0,0,,В ОБЩЕМ, НЕУДИВИТЕЛЬНО. СТРАННО БЫЛО БЫ СНАЧАЛА СДЕЛАТЬ
Dialogue: 0,0:00:54.36,0:00:57.32,Caption,,0,0,0,,ВОЕННУЮ СИСТЕМУ, А ПОТОМ РАЗДАТЬ ВСЕМ ИНСТРУКЦИЮ,
Dialogue: 0,0:00:57.46,0:01:00.36,Caption,,0,0,0,,КУДА СТУЧАТЬ МОЛОТКОМ. НО САМ ПОДХОД УЖЕ СОВЕРШЕННО
Dialogue: 0,0:01:00.36,0:01:03.48,Caption,,0,0,0,,ПОНЯТЕН. У КОСМИЧЕСКИХ СИЛ США ЕСТЬ НАПРАВЛЕНИЕ
Dialogue: 0,0:01:03.52,0:01:06.92,Caption,,0,0,0,,ORBITAL WARFARE. ОРБИТАЛЬНАЯ ВОЙНА. КОГДА ВОЕННОЕ
Dialogue: 0,0:01:06.92,0:01:09.32,Caption,,0,0,0,,ВЕДОМСТВО СОЗДАЁТ НАПРАВЛЕНИЕ С ТАКИМ НАЗВАНИЕМ,
Dialogue: 0,0:01:09.64,0:01:11.80,Caption,,0,0,0,,РАЗГОВОРЫ О КОСМОСЕ КАК О ТИХОМ МЕСТЕ ДЛЯ
Dialogue: 0,0:01:11.88,0:01:14.04,Caption,,0,0,0,,НАУЧНЫХ СПУТНИКОВ НАЧИНАЮТ СЛЕГКА ОТДАВАТЬ
Dialogue: 0,0:01:14.04,0:01:19.35,Caption,,0,0,0,,НОСТАЛЬГИЕЙ. АМЕРИКАНЦЫ ХОТЯТ ЗАЩИЩАТЬ СВОИ СИСТЕМЫ,
Dialogue: 0,0:01:19.50,0:01:22.15,Caption,,0,0,0,,СОХРАНЯТЬ ПРЕИМУЩЕСТВО И ИМЕТЬ ВОЗМОЖНОСТЬ
Dialogue: 0,0:01:22.15,0:01:25.11,Caption,,0,0,0,,ВОЗДЕЙСТВОВАТЬ НА ЧУЖИЕ. НОРМАЛЬНАЯ ВОЕННАЯ ЛОГИКА.
Dialogue: 0,0:01:25.56,0:01:28.15,Caption,,0,0,0,,ТОЛЬКО ЛОГИКА НИКОГДА НЕ РАБОТАЕТ В ОДНУ СТОРОНУ.
Dialogue: 0,0:01:28.60,0:01:30.63,Caption,,0,0,0,,ЕСЛИ ОДНА СТРАНА ПОЛУЧАЕТ СРЕДСТВО,
Dialogue: 0,0:01:30.79,0:01:33.27,Caption,,0,0,0,,СПОСОБНОЕ СЕРЬЁЗНО МЕШАТЬ ЧУЖИМ КОСМИЧЕСКИМ
Dialogue: 0,0:01:33.27,0:01:37.03,Caption,,0,0,0,,СИСТЕМАМ, ДРУГИЕ НЕ СТАНУТ ПИСАТЬ ЖАЛОБУ В КНИГУ ПРЕДЛОЖЕНИЙ.
Dialogue: 0,0:01:37.42,0:01:40.63,Caption,,0,0,0,,ОНИ НАЧНУТ ДЕЛАТЬ СВОЁ. ТАК УСТРОЕНА ВСЯ ИСТОРИЯ
Dialogue: 0,0:01:40.63,0:01:43.11,Caption,,0,0,0,,ВООРУЖЕНИЙ. НЕ ПОТОМУ ЧТО ПОЛИТИКИ ОСОБЕННО
Dialogue: 0,0:01:43.11,0:01:46.07,Caption,,0,0,0,,КРОВОЖАДНЫЕ. ПОТОМУ ЧТО НИКТО ДОБРОВОЛЬНО НЕ ХОЧЕТ
Dialogue: 0,0:01:46.07,0:01:47.83,Caption,,0,0,0,,ОКАЗАТЬСЯ В ПОЛОЖЕНИИ ЧЕЛОВЕКА,
Dialogue: 0,0:01:48.14,0:01:50.15,Caption,,0,0,0,,У КОТОРОГО ПРОТИВНИК УЖЕ КУПИЛ ЛОМ,
Dialogue: 0,0:01:50.30,0:01:51.99,Caption,,0,0,0,,А У НЕГО ДВЕРЬ ВСЁ ЕЩЁ КАРТОННАЯ.
Dialogue: 0,0:01:52.69,0:01:57.19,Caption,,0,0,0,,ОСОБЕННО ИНТЕРЕСНО ЗДЕСЬ ТО, НАСКОЛЬКО БЫСТРО КОСМОС ПЕРЕСТАЁТ БЫТЬ КАКОЙ ТО
Dialogue: 0,0:01:57.19,0:01:59.43,Caption,,0,0,0,,ОТДЕЛЬНОЙ КРАСИВОЙ ОБЛАСТЬЮ ЧЕЛОВЕЧЕСКОЙ
Dialogue: 0,0:01:59.43,0:02:03.27,Caption,,0,0,0,,ДЕЯТЕЛЬНОСТИ. НА ЗЕМЛЕ АРМИЯ ЗАВИСИТ ОТ СПУТНИКОВ ПОЧТИ ВО
Dialogue: 0,0:02:03.27,0:02:07.59,Caption,,0,0,0,,ВСЁМ. СВЯЗЬ. НАВИГАЦИЯ. РАЗВЕДКА. КОНТРОЛЬ
Dialogue: 0,0:02:07.59,0:02:10.39,Caption,,0,0,0,,ТЕРРИТОРИИ. ПРЕДУПРЕЖДЕНИЕ. ПЕРЕДАЧА ДАННЫХ.
Dialogue: 0,0:02:11.34,0:02:13.51,Caption,,0,0,0,,ЕСЛИ ЭТИ СИСТЕМЫ НАЧИНАЮТ ДАВАТЬ СБОЙ,
Dialogue: 0,0:02:13.72,0:02:16.71,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ПОЯВЛЯЮТСЯ УЖЕ НЕ ГДЕ ТО СРЕДИ ЗВЁЗД.
Dialogue: 0,0:02:16.88,0:02:19.75,Caption,,0,0,0,,ОНИ ПОЯВЛЯЮТСЯ У КОНКРЕТНОГО ПОДРАЗДЕЛЕНИЯ НА ЗЕМЛЕ,
Dialogue: 0,0:02:20.07,0:02:22.47,Caption,,0,0,0,,КОТОРОМУ ВНЕЗАПНО НЕЧЕМ НОРМАЛЬНО СВЯЗАТЬСЯ,
Dialogue: 0,0:02:22.79,0:02:25.67,Caption,,0,0,0,,НЕЧЕГО ПОСМОТРЕТЬ И НЕЧЕМ ПРОВЕРИТЬ КООРДИНАТЫ.
Dialogue: 0,0:02:25.95,0:02:28.71,Caption,,0,0,0,,ПОЭТОМУ РАЗГОВОР О КОНТРОЛЕ ОРБИТЫ ДАВНО НЕ ПРО
Dialogue: 0,0:02:28.71,0:02:32.75,Caption,,0,0,0,,АСТРОНОМИЮ. ЭТО РАЗГОВОР О ТОМ,
Dialogue: 0,0:02:32.84,0:02:37.71,Caption,,0,0,0,,КТО ВНИЗУ БУДЕТ ВИДЕТЬ, СЛЫШАТЬ И ПОПАДАТЬ ТОЧНЕЕ. КИТАЙ ЭТО ПРЕКРАСНО
Dialogue: 0,0:02:37.71,0:02:40.75,Caption,,0,0,0,,ПОНИМАЕТ. ПЕКИН РАЗВИВАЕТ СОБСТВЕННЫЕ МАНЕВРИРУЮЩИЕ
Dialogue: 0,0:02:40.75,0:02:44.67,Caption,,0,0,0,,СПУТНИКИ И ТЕХНОЛОГИИ, КОТОРЫЕ ПОЗВОЛЯЮТ АППАРАТАМ ПОДХОДИТЬ К ДРУГИМ
Dialogue: 0,0:02:44.67,0:02:48.35,Caption,,0,0,0,,ОБЪЕКТАМ, СОПРОВОЖДАТЬ ИХ И РАБОТАТЬ РЯДОМ С НИМИ. КОГДА
Dialogue: 0,0:02:48.35,0:02:50.83,Caption,,0,0,0,,СПУТНИК УМЕЕТ НЕ ПРОСТО ЛЕТАТЬ ПО СВОЕМУ КРУГУ,
Dialogue: 0,0:02:51.14,0:02:53.47,Caption,,0,0,0,,А ЦЕЛЕНАПРАВЛЕННО МЕНЯТЬ ОРБИТУ И СБЛИЖАТЬСЯ С
Dialogue: 0,0:02:53.47,0:02:57.55,Caption,,0,0,0,,ЧУЖИМИ АППАРАТАМИ, ВОЕННЫЕ СРАЗУ НАЧИНАЮТ СМОТРЕТЬ НА НЕГО С БОЛЬШИМ
Dialogue: 0,0:02:57.55,0:03:01.71,Caption,,0,0,0,,ИНТЕРЕСОМ. REUTERS ПОДРОБНО РАЗБИРАЛ КИТАЙСКИЕ РАЗРАБОТКИ И
Dialogue: 0,0:03:01.71,0:03:04.35,Caption,,0,0,0,,САМУ ГОНКУ КОСМИЧЕСКИХ ВОЗМОЖНОСТЕЙ МЕЖДУ КРУПНЫМИ
Dialogue: 0,0:03:04.35,0:03:08.43,Caption,,0,0,0,,ДЕРЖАВАМИ. У АМЕРИКАНЦЕВ СВОЁ. У КИТАЙЦЕВ СВОЁ. У
Dialogue: 0,0:03:08.43,0:03:10.99,Caption,,0,0,0,,РОССИИ ТОЖЕ СВОИ АППАРАТЫ И СВОИ ЗАДАЧИ. В
Dialogue: 0,0:03:10.99,0:03:13.39,Caption,,0,0,0,,ОБЩЕМ, ЧЕЛОВЕЧЕСТВО УВЕРЕННО ДОКАЗАЛО,
Dialogue: 0,0:03:13.57,0:03:16.43,Caption,,0,0,0,,ЧТО ДАЖЕ БЕСКОНЕЧНОЕ ПРОСТРАНСТВО СПОСОБНО ДОВОЛЬНО
Dialogue: 0,0:03:16.43,0:03:20.11,Caption,,0,0,0,,БЫСТРО ПРЕВРАТИТЬ В МЕСТО, ГДЕ ВСЕМ НАДО СЛЕДИТЬ ДРУГ ЗА ДРУГОМ.
Dialogue: 0,0:03:20.83,0:03:22.67,Caption,,0,0,0,,КУРЫ И ПИНГВИНЫ ПОКА В ЭТОЙ ГОНКЕ НЕ
Dialogue: 0,0:03:22.67,0:03:25.87,Caption,,0,0,0,,УЧАСТВУЮТ. ОСТАЛЬНЫЕ УЖЕ ПОДТЯГИВАЮТСЯ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:03:26.05,0:03:28.51,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ СДЕЛАЛИ ЭТОГО. ПОТОМУ ЧТО СЛЕДУЮЩИЙ
Dialogue: 0,0:03:28.51,0:03:32.51,Caption,,0,0,0,,ЭПИЗОД ХОРОШО ПОКАЗЫВАЕТ, КАК ТЕОРИЯ ПРО КОСМИЧЕСКОЕ СОПЕРНИЧЕСТВО
Dialogue: 0,0:03:32.80,0:03:35.79,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ОЧЕНЬ КОНКРЕТНОЕ РАССТОЯНИЕ МЕЖДУ
Dialogue: 0,0:03:35.87,0:03:41.43,Caption,,0,0,0,,ДВУМЯ АППАРАТАМИ. В СЕРЕДИНЕ ОКТЯБРЯ РОССИЙСКИЙ ВОЕННЫЙ СПУТНИК
Dialogue: 0,0:03:41.43,0:03:44.47,Caption,,0,0,0,,"КОСМОС ДВЕ ТЫСЯЧИ ШЕСТЬСОТ ДВЕНАДЦАТЬ" СБЛИЗИЛСЯ СО
Dialogue: 0,0:03:44.47,0:03:48.31,Caption,,0,0,0,,СПУТНИКОМ ИКС ТРИДЦАТЬ ШЕСТЬ ФИНСКОЙ КОМПАНИИ ICEYE.
Dialogue: 0,0:03:48.59,0:03:51.19,Caption,,0,0,0,,И ЗДЕСЬ ВАЖНО, ЧТО ТАКОЕ ICEYE.
Dialogue: 0,0:03:51.92,0:03:55.11,Caption,,0,0,0,,КОМПАНИЯ ДЕЛАЕТ РАДИОЛОКАЦИОННЫЕ СНИМКИ ЗЕМЛИ. ЕЁ
Dialogue: 0,0:03:55.19,0:03:57.59,Caption,,0,0,0,,ДАННЫЕ ПОЛУЧАЮТ ПРАВИТЕЛЬСТВА И ВООРУЖЁННЫЕ СИЛЫ
Dialogue: 0,0:03:57.59,0:04:01.11,Caption,,0,0,0,,ЗАПАДНЫХ СТРАН, В ТОМ ЧИСЛЕ УКРАИНА. ТО ЕСТЬ АППАРАТ ПРИНАДЛЕЖИТ
Dialogue: 0,0:04:01.11,0:04:05.27,Caption,,0,0,0,,КОММЕРЧЕСКОЙ КОМПАНИИ, НО ИНФОРМАЦИЯ С НЕГО ВПОЛНЕ СЕБЕ РАБОТАЕТ В
Dialogue: 0,0:04:05.35,0:04:08.47,Caption,,0,0,0,,ВОЕННОЙ СИСТЕМЕ. И ВОТ ЭТА ГРАНИЦА СЕЙЧАС СТАНОВИТСЯ
Dialogue: 0,0:04:08.47,0:04:11.35,Caption,,0,0,0,,ВСЁ ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО СЛОВО "КОММЕРЧЕСКИЙ"
Dialogue: 0,0:04:11.36,0:04:14.47,Caption,,0,0,0,,ПРЕКРАСНО ЗВУЧИТ В ПРЕСС РЕЛИЗЕ. НО ДРУГОЙ СТОРОНЕ
Dialogue: 0,0:04:14.47,0:04:16.63,Caption,,0,0,0,,КУДА ВАЖНЕЕ НЕ ФОРМА СОБСТВЕННОСТИ,
Dialogue: 0,0:04:16.78,0:04:19.59,Caption,,0,0,0,,А ФУНКЦИЯ. ЕСЛИ СПУТНИК ПОМОГАЕТ НАБЛЮДАТЬ
Dialogue: 0,0:04:19.59,0:04:22.87,Caption,,0,0,0,,ТЕРРИТОРИЮ, ПОЛУЧАТЬ ИЗОБРАЖЕНИЯ И ПЕРЕДАВАТЬ ИНФОРМАЦИЮ
Dialogue: 0,0:04:22.87,0:04:26.23,Caption,,0,0,0,,ВОЕННЫМ, ТО ЧЕЛОВЕК В ШТАБЕ СМОТРИТ НЕ НА РЕГИСТРАЦИОННЫЕ
Dialogue: 0,0:04:26.23,0:04:28.87,Caption,,0,0,0,,ДОКУМЕНТЫ КОМПАНИИ. ОН СМОТРИТ НА ТО,
Dialogue: 0,0:04:28.95,0:04:32.23,Caption,,0,0,0,,ЧТО ЭТОТ АППАРАТ ДАЁТ ПРОТИВНИКУ. РОССИЙСКИЙ "КОСМОС
Dialogue: 0,0:04:32.31,0:04:33.67,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ШЕСТЬСОТ ДВЕНАДЦАТЬ",
Dialogue: 0,0:04:33.90,0:04:37.59,Caption,,0,0,0,,ПО ДАННЫМ REUTERS, ПОДОШЁЛ К ИКС ТРИДЦАТЬ ШЕСТЬ ПРИМЕРНО НА КИЛОМЕТР.
Dialogue: 0,0:04:37.91,0:04:41.19,Caption,,0,0,0,,ДЛЯ ЗЕМЛИ КИЛОМЕТР ЭТО ПРОГУЛЯТЬСЯ ДО МАГАЗИНА. ДЛЯ
Dialogue: 0,0:04:41.19,0:04:43.91,Caption,,0,0,0,,ДВУХ АППАРАТОВ НА НИЗКОЙ ОРБИТЕ ТАКОЕ СОСЕДСТВО УЖЕ
Dialogue: 0,0:04:43.99,0:04:47.27,Caption,,0,0,0,,ВЫГЛЯДИТ КУДА ЛЮБОПЫТНЕЕ. В ГОСДЕПАРТАМЕНТЕ США
Dialogue: 0,0:04:47.27,0:04:53.71,Caption,,0,0,0,,МАНЁВР НАЗВАЛИ НАМЕРЕННЫМ. СПЕЦИАЛИСТ ПО ВОЕННОЙ КОСМОНАВТИКЕ ГРЕГ ГИЛЛИНГЕР
Dialogue: 0,0:04:53.79,0:04:57.95,Caption,,0,0,0,,СКАЗАЛ, ЧТО ПРОИСХОДЯЩЕЕ ВЫГЛЯДЕЛО КАК РЕПЕТИЦИЯ АТАКИ. САМ
Dialogue: 0,0:04:58.03,0:05:01.55,Caption,,0,0,0,,СПУТНИК ICEYE ПРОДОЛЖИЛ РАБОТАТЬ. НО ОДНОВРЕМЕННО
Dialogue: 0,0:05:01.55,0:05:05.79,Caption,,0,0,0,,ПОЯВИЛАСЬ ИНФОРМАЦИЯ, ЧТО ДРУГИЕ РОССИЙСКИЕ АППАРАТЫ НАЧАЛИ МАНЕВРИРОВАТЬ
Dialogue: 0,0:05:05.79,0:05:08.75,Caption,,0,0,0,,РЯДОМ С ЕЩЁ ОДНИМ СПУТНИКОМ ЭТОЙ КОМПАНИИ. ТО
Dialogue: 0,0:05:08.83,0:05:11.47,Caption,,0,0,0,,ЕСТЬ ИКС ТРИДЦАТЬ СЕМЬ ТОЖЕ ОКАЗАЛСЯ В ЦЕНТРЕ
Dialogue: 0,0:05:11.47,0:05:13.63,Caption,,0,0,0,,ВНИМАНИЯ. И ТУТ НАЧИНАЕТСЯ ПРОБЛЕМА,
Dialogue: 0,0:05:13.80,0:05:16.35,Caption,,0,0,0,,КОТОРУЮ ОДНОЙ КРАСИВОЙ ЮРИДИЧЕСКОЙ ФОРМУЛИРОВКОЙ УЖЕ
Dialogue: 0,0:05:16.43,0:05:19.79,Caption,,0,0,0,,НЕ ЗАКРОЕШЬ. ЕСТЬ СПУТНИК ЧАСТНОЙ КОМПАНИИ. ЕСТЬ
Dialogue: 0,0:05:19.79,0:05:23.15,Caption,,0,0,0,,КОММЕРЧЕСКАЯ УСЛУГА. ЕСТЬ ДАННЫЕ. И ЭТИ ДАННЫЕ
Dialogue: 0,0:05:23.15,0:05:26.35,Caption,,0,0,0,,ИСПОЛЬЗУЮТСЯ ВОЕННЫМИ. ГДЕ ИМЕННО ПОСЛЕ ЭТОГО
Dialogue: 0,0:05:26.35,0:05:29.39,Caption,,0,0,0,,ПРОХОДИТ КРАСНАЯ ЛИНИЯ МЕЖДУ ОБЫЧНОЙ КОММЕРЦИЕЙ И
Dialogue: 0,0:05:29.39,0:05:30.99,Caption,,0,0,0,,ЧАСТЬЮ ВОЕННОЙ ИНФРАСТРУКТУРЫ?
Dialogue: 0,0:05:31.23,0:05:33.87,Caption,,0,0,0,,ВОТ ХОРОШИЙ ВОПРОС. ПОТОМУ ЧТО ЕСЛИ КОММЕРЧЕСКИЕ
Dialogue: 0,0:05:33.87,0:05:36.43,Caption,,0,0,0,,ВОЗМОЖНОСТИ ВСЁ ГЛУБЖЕ ВСТРАИВАЮТСЯ В АРМЕЙСКИЕ
Dialogue: 0,0:05:36.51,0:05:39.47,Caption,,0,0,0,,ЗАДАЧИ, ТО И ОТНОШЕНИЕ К НИМ СО СТОРОНЫ ПРОТИВНИКА
Dialogue: 0,0:05:39.47,0:05:42.19,Caption,,0,0,0,,БУДЕТ МЕНЯТЬСЯ. НА ТАБЛИЧКЕ МОЖНО НАПИСАТЬ ЧТО
Dialogue: 0,0:05:42.19,0:05:45.15,Caption,,0,0,0,,УГОДНО. В КОСМОСЕ ТАБЛИЧКИ ВООБЩЕ ПЛОХО ЧИТАЮТСЯ.
Dialogue: 0,0:05:45.53,0:05:48.43,Caption,,0,0,0,,СМОТРЯТ НА ФУНКЦИЮ. ЕСЛИ АППАРАТ ПОМОГАЕТ ОДНОМУ
Dialogue: 0,0:05:48.43,0:05:50.67,Caption,,0,0,0,,УЧАСТНИКУ КОНФЛИКТА ЛУЧШЕ ВИДЕТЬ ДРУГОГО,
Dialogue: 0,0:05:51.07,0:05:53.63,Caption,,0,0,0,,ТОТ ДРУГОЙ РАНО ИЛИ ПОЗДНО НАЧИНАЕТ ИНТЕРЕСОВАТЬСЯ
Dialogue: 0,0:05:53.71,0:05:58.96,Caption,,0,0,0,,САМИМ АППАРАТОМ. УДИВЛЯТЬСЯ ЗДЕСЬ ПРИМЕРНО ТАК ЖЕ ПОЛЕЗНО,
Dialogue: 0,0:05:59.13,0:06:01.84,Caption,,0,0,0,,КАК ПОСТАВИТЬ КАМЕРУ СОСЕДУ ПРЯМО НАПРОТИВ ОКНА,
Dialogue: 0,0:06:02.04,0:06:03.92,Caption,,0,0,0,,ПЕРЕДАВАТЬ КАРТИНКУ ЕГО КОНКУРЕНТУ,
Dialogue: 0,0:06:04.16,0:06:07.20,Caption,,0,0,0,,А ПОТОМ ОБИЖАТЬСЯ, ЧТО СОСЕД ЗАИНТЕРЕСОВАЛСЯ КАМЕРОЙ.
Dialogue: 0,0:06:07.75,0:06:11.76,Caption,,0,0,0,,А ЕВРОПА ТЕМ ВРЕМЕНЕМ РЕШИЛА, ЧТО ПРОСТО НАБЛЮДАТЬ ЗА ЭТОЙ ГОНКОЙ СО СТОРОНЫ
Dialogue: 0,0:06:11.76,0:06:15.84,Caption,,0,0,0,,СКУЧНОВАТО. НЕМЕЦКАЯ КОМПАНИЯ ATMOS SPACE CARGO ЗАНИМАЕТСЯ
Dialogue: 0,0:06:15.92,0:06:18.96,Caption,,0,0,0,,ПРОЕКТОМ PODS. ЗДЕСЬ ИДЕЯ УЖЕ СОВСЕМ БОДРАЯ.
Dialogue: 0,0:06:19.34,0:06:21.92,Caption,,0,0,0,,БОЕПРИПАС ВЫВОДИТСЯ НА ОРБИТУ ВНУТРИ СПЕЦИАЛЬНОЙ
Dialogue: 0,0:06:21.92,0:06:24.08,Caption,,0,0,0,,СПУСКАЕМОЙ СИСТЕМЫ. КОГДА ТРЕБУЕТСЯ,
Dialogue: 0,0:06:24.34,0:06:26.72,Caption,,0,0,0,,АППАРАТ ВХОДИТ ОБРАТНО В АТМОСФЕРУ И ДОСТАВЛЯЕТ
Dialogue: 0,0:06:26.72,0:06:29.52,Caption,,0,0,0,,БОЕПРИПАС К ЦЕЛИ. ТО ЕСТЬ ОБЫЧНЫЙ РАЗГОВОР ПРО
Dialogue: 0,0:06:29.52,0:06:32.48,Caption,,0,0,0,,ДАЛЬНОСТЬ НАЧИНАЕТ ЗВУЧАТЬ ДОВОЛЬНО СТРАННО. СКОЛЬКО
Dialogue: 0,0:06:32.48,0:06:36.40,Caption,,0,0,0,,КИЛОМЕТРОВ? А КАКАЯ РАЗНИЦА, ЕСЛИ ТЫ УЖЕ ЛЕТАЕШЬ ВОКРУГ ПЛАНЕТЫ?
Dialogue: 0,0:06:36.74,0:06:38.88,Caption,,0,0,0,,В ТАКОЙ СХЕМЕ ГЕОГРАФИЯ НАЧИНАЕТ РАБОТАТЬ ПО
Dialogue: 0,0:06:38.88,0:06:44.24,Caption,,0,0,0,,ДРУГОМУ. THE TIMES ПИСАЛ, ЧТО PODS РАССМАТРИВАЕТСЯ КАК ВЫСОКОТОЧНАЯ СИСТЕМА
Dialogue: 0,0:06:44.32,0:06:47.20,Caption,,0,0,0,,ДАЛЬНЕГО УДАРА. КОМПАНИЯ СОБИРАЕТСЯ ИСКАТЬ КРУПНОГО
Dialogue: 0,0:06:47.20,0:06:49.44,Caption,,0,0,0,,ОБОРОННОГО ПАРТНЁРА ВРОДЕ MBDA,
Dialogue: 0,0:06:49.75,0:06:51.92,Caption,,0,0,0,,ПОТОМУ ЧТО ОДНО ДЕЛО ПРИДУМАТЬ ЖЕЛЕЗКУ,
Dialogue: 0,0:06:52.16,0:06:54.80,Caption,,0,0,0,,А ДРУГОЕ ДЕЛО ПОТОМ ПРОЙТИ ВЕСЬ ВЕСЁЛЫЙ АТТРАКЦИОН
Dialogue: 0,0:06:54.88,0:06:59.12,Caption,,0,0,0,,ИЗ ПОЛИТИКИ, ПРАВА, ВОЕННЫХ ТРЕБОВАНИЙ И ГОСУДАРСТВЕННЫХ СОГЛАСОВАНИЙ.
Dialogue: 0,0:06:59.69,0:07:01.68,Caption,,0,0,0,,ПРОЕКТ ВОЗГЛАВЛЯЕТ СЕБАСТЬЯН КЛАУС,
Dialogue: 0,0:07:01.86,0:07:05.04,Caption,,0,0,0,,БЫВШИЙ НЕМЕЦКИЙ СПЕЦНАЗОВЕЦ. ПОСЛЕ НАЧАЛА КОНФЛИКТА
Dialogue: 0,0:07:05.12,0:07:07.60,Caption,,0,0,0,,НА УКРАИНЕ КОМПАНИЯ ПОШЛА В СТОРОНУ ВОЕННЫХ
Dialogue: 0,0:07:07.60,0:07:13.48,Caption,,0,0,0,,РАЗРАБОТОК. И ЭТО ТОЖЕ ХОРОШИЙ ПОКАЗАТЕЛЬ ВРЕМЕНИ. ЕЩЁ НЕДАВНО
Dialogue: 0,0:07:13.48,0:07:16.12,Caption,,0,0,0,,КОММЕРЧЕСКИЙ КОСМОС В ЕВРОПЕ АССОЦИИРОВАЛСЯ ГЛАВНЫМ
Dialogue: 0,0:07:16.12,0:07:20.68,Caption,,0,0,0,,ОБРАЗОМ С ЗАПУСКАМИ, СПУТНИКАМИ И КРАСИВЫМИ РАЗГОВОРАМИ О ТЕХНОЛОГИЯХ
Dialogue: 0,0:07:20.76,0:07:23.96,Caption,,0,0,0,,БУДУЩЕГО. ТЕПЕРЬ БУДУЩЕЕ ПОСТЕПЕННО ПОЛУЧАЕТ БОЕВУЮ
Dialogue: 0,0:07:23.96,0:07:27.96,Caption,,0,0,0,,ЧАСТЬ. ГЕНЕРАЛ НЕМЕЦКИХ ВВС ИНГО ГЕРХАРТЦ ОПИСАЛ
Dialogue: 0,0:07:27.96,0:07:30.76,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ЛОГИКУ ДОВОЛЬНО ОБРАЗНО. РАНЬШЕ
Dialogue: 0,0:07:30.84,0:07:33.48,Caption,,0,0,0,,СТАРАЛИСЬ ПОПАСТЬ В СТРЕЛУ. ТЕПЕРЬ ХОТЯТ ДОБРАТЬСЯ
Dialogue: 0,0:07:33.48,0:07:35.88,Caption,,0,0,0,,ДО ЛУЧНИКА. А ПОТОМ И ДО КУЗНИЦЫ,
Dialogue: 0,0:07:36.10,0:07:39.16,Caption,,0,0,0,,ГДЕ СТРЕЛЫ ДЕЛАЮТ. ВОЕННЫЕ ВООБЩЕ ЛЮБЯТ СЛОЖНЫЕ
Dialogue: 0,0:07:39.16,0:07:43.24,Caption,,0,0,0,,КОНЦЕПЦИИ ОБЪЯСНЯТЬ ТАК, ЧТОБЫ ПОТОМ ВСЁ ПОНЯЛ ДАЖЕ ЧЕЛОВЕК С ШАШЛЫКОМ
Dialogue: 0,0:07:43.32,0:07:46.84,Caption,,0,0,0,,В РУКАХ. СУТЬ ПРОСТАЯ. ЕСЛИ ПОСТОЯННО ЛОВИТЬ ТО,
Dialogue: 0,0:07:46.96,0:07:51.00,Caption,,0,0,0,,ЧТО УЖЕ ЛЕТИТ В ТЕБЯ, МОЖНО ОЧЕНЬ БЫСТРО УСТАТЬ И РАЗОРИТЬСЯ. ПОЭТОМУ
Dialogue: 0,0:07:51.08,0:07:54.44,Caption,,0,0,0,,ХОЧЕТСЯ БИТЬ ГЛУБЖЕ. ПО ПУСКОВОЙ. ПО СКЛАДУ. ПО
Dialogue: 0,0:07:54.44,0:07:57.48,Caption,,0,0,0,,ПРОИЗВОДСТВУ. ПО ИНФРАСТРУКТУРЕ. И ВОТ С ЭТОГО
Dialogue: 0,0:07:57.48,0:08:00.68,Caption,,0,0,0,,МОМЕНТА ДАЛЬНОСТЬ НАЧИНАЕТ РАСТИ ОЧЕНЬ БЫСТРО.
Dialogue: 0,0:08:01.13,0:08:03.72,Caption,,0,0,0,,ОТДЕЛЬНО БРИТАНИЯ И ГЕРМАНИЯ ЗАНИМАЮТСЯ РАКЕТНЫМ
Dialogue: 0,0:08:03.72,0:08:06.52,Caption,,0,0,0,,ПРОЕКТОМ С ДАЛЬНОСТЬЮ БОЛЬШЕ ДВУХ ТЫСЯЧ КИЛОМЕТРОВ.
Dialogue: 0,0:08:06.90,0:08:08.84,Caption,,0,0,0,,ЭТО САМОСТОЯТЕЛЬНЫЙ РАКЕТНЫЙ ПРОЕКТ,
Dialogue: 0,0:08:09.07,0:08:12.28,Caption,,0,0,0,,ОТДЕЛЬНЫЙ ОТ PODS. НО ОБЩИЙ АППЕТИТ ХОРОШО ЗАМЕТЕН.
Dialogue: 0,0:08:12.74,0:08:15.56,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ХОЧЕТСЯ ДОСТАВАТЬ ВСЁ ДАЛЬШЕ. И ЗДЕСЬ
Dialogue: 0,0:08:15.56,0:08:19.08,Caption,,0,0,0,,СНОВА ВКЛЮЧАЕТСЯ ТА САМАЯ НЕПРИЯТНАЯ МЕХАНИКА. ЧЕМ
Dialogue: 0,0:08:19.08,0:08:21.00,Caption,,0,0,0,,ДАЛЬШЕ МОЖЕТ УДАРИТЬ ОДНА СТОРОНА,
Dialogue: 0,0:08:21.22,0:08:23.80,Caption,,0,0,0,,ТЕМ ДАЛЬШЕ ДРУГАЯ НАЧИНАЕТ ОТОДВИГАТЬ СКЛАДЫ.
Dialogue: 0,0:08:24.42,0:08:25.96,Caption,,0,0,0,,РАССРЕДОТОЧИВАТЬ ПРОИЗВОДСТВО.
Dialogue: 0,0:08:28.23,0:08:32.47,Caption,,0,0,0,,УКРЕПЛЯТЬ ОБЪЕКТЫ. СТРОИТЬ ПВО. МЕНЯТЬ ЛОГИСТИКУ. И
Dialogue: 0,0:08:32.47,0:08:36.31,Caption,,0,0,0,,ИСКАТЬ, ЧЕМ ДОСТАТЬ УЖЕ САМОГО СТРЕЛКА. ПОТОМ ВСЕ СМОТРЯТ
Dialogue: 0,0:08:36.39,0:08:39.27,Caption,,0,0,0,,НА ПОЛУЧИВШУЮСЯ КОНСТРУКЦИЮ И УДИВЛЯЮТСЯ ОТКУДА
Dialogue: 0,0:08:39.27,0:08:43.91,Caption,,0,0,0,,ОПЯТЬ ВЗЯЛАСЬ ГОНКА? ДА ВОТ ЖЕ ОНА. СОБСТВЕННЫМИ НОГАМИ ПРИШЛА. А
Dialogue: 0,0:08:43.99,0:08:46.15,Caption,,0,0,0,,НА ЗЕМЛЕ ТЕМ ВРЕМЕНЕМ ИДЁТ СВОЯ АРИФМЕТИКА.
Dialogue: 0,0:08:46.47,0:08:49.03,Caption,,0,0,0,,УКРАИНСКАЯ РАЗВЕДКА ОЦЕНИВАЕТ РОССИЙСКИЙ ЗАПАС
Dialogue: 0,0:08:49.03,0:08:51.91,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИХ РАКЕТ В ОБЪЁМЕ ДО СЕМИСОТ ЕДИНИЦ.
Dialogue: 0,0:08:52.13,0:08:53.99,Caption,,0,0,0,,КРЫЛАТЫХ РАКЕТ, ПО ЭТИМ ДАННЫМ,
Dialogue: 0,0:08:54.13,0:08:57.43,Caption,,0,0,0,,НЕСКОЛЬКО ТЫСЯЧ. НО ЕЩЁ ВАЖНЕЕ НЕ ТОЛЬКО ТО,
Dialogue: 0,0:08:57.59,0:09:02.87,Caption,,0,0,0,,ЧТО ЛЕЖИТ НА СКЛАДАХ. ВАЖНО, С КАКОЙ СКОРОСТЬЮ ЭТИ СКЛАДЫ ПОПОЛНЯЮТСЯ. ПО ОЦЕНКЕ
Dialogue: 0,0:09:02.95,0:09:05.99,Caption,,0,0,0,,ГУР, РОССИЙСКИЕ ПРОИЗВОДСТВЕННЫЕ МОЩНОСТИ ПОЗВОЛЯЮТ
Dialogue: 0,0:09:05.99,0:09:09.19,Caption,,0,0,0,,ВЫПУСКАТЬ БОЛЬШЕ ДВУХСОТ КРЫЛАТЫХ И БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:09:09.19,0:09:12.07,Caption,,0,0,0,,РАКЕТ В МЕСЯЦ. ИЗ НИХ ДО СТА ДЕСЯТИ
Dialogue: 0,0:09:12.07,0:09:14.87,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИХ. ДВЕСТИ РАКЕТ В МЕСЯЦ ЗВУЧИТ КАК
Dialogue: 0,0:09:14.87,0:09:17.99,Caption,,0,0,0,,СТАТИСТИКА. ПЕРЕВЕДЁМ НА ЧЕЛОВЕЧЕСКИЙ. ЭТО БОЛЬШЕ
Dialogue: 0,0:09:17.99,0:09:21.35,Caption,,0,0,0,,ШЕСТИ РАКЕТ В СУТКИ. КАЖДЫЙ ДЕНЬ. НЕ ПРАЗДНИЧНАЯ
Dialogue: 0,0:09:21.35,0:09:23.99,Caption,,0,0,0,,АКЦИЯ. НЕ РАЗОВАЯ ПАРТИЯ. КОНВЕЙЕР.
Dialogue: 0,0:09:24.62,0:09:27.11,Caption,,0,0,0,,И ВОТ ТУТ ДЛЯ УКРАИНЫ ВОПРОС СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:09:27.11,0:09:30.71,Caption,,0,0,0,,ПРАКТИЧЕСКИМ. ПОСЧИТАТЬ ЧУЖОЙ АРСЕНАЛ ПОЛЕЗНО. НО ОТ
Dialogue: 0,0:09:30.71,0:09:33.99,Caption,,0,0,0,,ОДНОЙ ТАБЛИЦЫ РАКЕТА ВНИЗ НЕ УПАДЁТ. НУЖНЫ СИСТЕМЫ
Dialogue: 0,0:09:33.99,0:09:37.43,Caption,,0,0,0,,ОБНАРУЖЕНИЯ. НУЖНЫ КОМПЛЕКСЫ ПВО. НУЖНЫ РАКЕТЫ
Dialogue: 0,0:09:37.43,0:09:40.71,Caption,,0,0,0,,ПЕРЕХВАТЧИКИ. НУЖНЫ ПОДГОТОВЛЕННЫЕ РАСЧЁТЫ. НУЖНЫ
Dialogue: 0,0:09:40.71,0:09:43.91,Caption,,0,0,0,,ЗАПАСНЫЕ ПОЗИЦИИ. И САМОЕ НЕПРИЯТНОЕ ЗДЕСЬ СЛОВО
Dialogue: 0,0:09:43.91,0:09:49.95,Caption,,0,0,0,,"ЗАПАС". ПОТОМУ ЧТО УСТАНОВКА БЕЗ РАКЕТ ЭТО ОЧЕНЬ ДОРОГАЯ
Dialogue: 0,0:09:49.95,0:09:53.23,Caption,,0,0,0,,МЕТАЛЛИЧЕСКАЯ ДОСТОПРИМЕЧАТЕЛЬНОСТЬ. ЗАПАД СПОСОБЕН
Dialogue: 0,0:09:53.31,0:09:56.19,Caption,,0,0,0,,ЗАКАЗАТЬ НОВУЮ ТЕХНИКУ. СПОСОБЕН ВЫДЕЛИТЬ ДЕНЬГИ.
Dialogue: 0,0:09:56.52,0:09:59.55,Caption,,0,0,0,,СПОСОБЕН ПОДПИСАТЬ КОНТРАКТ. НО МЕЖДУ ПОДПИСАННЫМ
Dialogue: 0,0:09:59.55,0:10:02.59,Caption,,0,0,0,,КОНТРАКТОМ И ИЗДЕЛИЕМ НА ПОЗИЦИИ ИНОГДА ЛЕЖАТ ГОДЫ.
Dialogue: 0,0:10:03.03,0:10:06.19,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ПРЕКРАСНАЯ ТОРГОВАЯ СХЕМА. СЕГОДНЯ
Dialogue: 0,0:10:06.27,0:10:09.31,Caption,,0,0,0,,ДОГОВОРИЛИСЬ. СЕГОДНЯ ОБЪЯВИЛИ. СЕГОДНЯ ПОХЛОПАЛИ
Dialogue: 0,0:10:09.31,0:10:11.87,Caption,,0,0,0,,ДРУГ ДРУГА ПО ПЛЕЧУ. А ЖЕЛЕЗО ДОЕДЕТ ПОТОМ.
Dialogue: 0,0:10:12.09,0:10:14.91,Caption,,0,0,0,,ТОЛЬКО РОССИЙСКОЕ ПРОИЗВОДСТВО ИДЁТ НЕ "ПОТОМ". ОНО
Dialogue: 0,0:10:14.99,0:10:17.15,Caption,,0,0,0,,ИДЁТ КАЖДЫЙ МЕСЯЦ. ПОЭТОМУ ВОПРОС НЕ ТОЛЬКО В
Dialogue: 0,0:10:17.23,0:10:19.71,Caption,,0,0,0,,ТОМ, СКОЛЬКО У РОССИИ РАКЕТ. ВОПРОС,
Dialogue: 0,0:10:19.95,0:10:23.07,Caption,,0,0,0,,НАСКОЛЬКО БЫСТРО УКРАИНА СПОСОБНА ПОПОЛНЯТЬ ТО,
Dialogue: 0,0:10:23.31,0:10:26.27,Caption,,0,0,0,,ЧЕМ ЭТИ РАКЕТЫ ПРИХОДИТСЯ ПЕРЕХВАТЫВАТЬ. И ЗДЕСЬ УЖЕ
Dialogue: 0,0:10:26.27,0:10:29.23,Caption,,0,0,0,,НИКАКАЯ ГРОМКАЯ ПРЕСС КОНФЕРЕНЦИЯ СКЛАД НЕ НАПОЛНИТ.
Dialogue: 0,0:10:29.77,0:10:32.51,Caption,,0,0,0,,А ДАЛЬШЕ СОВРЕМЕННЫЙ КОНФЛИКТ ПОКАЗЫВАЕТ ВООБЩЕ
Dialogue: 0,0:10:32.51,0:10:35.23,Caption,,0,0,0,,ИЗДЕВАТЕЛЬСКУЮ ВЕЩЬ. СОВСЕМ НЕ ОБЯЗАТЕЛЬНО ТРАТИТЬ
Dialogue: 0,0:10:35.23,0:10:38.59,Caption,,0,0,0,,МИЛЛИОНЫ, ЧТОБЫ ПРИДУМАТЬ ПРОТИВНИКУ НОВУЮ ГОЛОВНУЮ БОЛЬ.
Dialogue: 0,0:10:39.03,0:10:41.07,Caption,,0,0,0,,ИНОГДА ХВАТАЕТ ДРОНА И КУСКА ПРОВОДА.
Dialogue: 0,0:10:41.62,0:10:44.67,Caption,,0,0,0,,РОССИЙСКИЕ F P V ДРОНЫ ТАК НАЗЫВАЕМОГО ЖДУЩЕГО
Dialogue: 0,0:10:44.75,0:10:47.63,Caption,,0,0,0,,ТИПА НАЧАЛИ ИСПОЛЬЗОВАТЬ ВЫСОКОВОЛЬТНЫЕ ЛИНИИ КАК
Dialogue: 0,0:10:47.63,0:10:51.23,Caption,,0,0,0,,МЕСТО ОЖИДАНИЯ. АППАРАТ ПОДЛЕТАЕТ. ЦЕПЛЯЕТСЯ.
Dialogue: 0,0:10:51.54,0:10:53.63,Caption,,0,0,0,,ОСТАНАВЛИВАЕТ МОТОРЫ. И СИДИТ.
Dialogue: 0,0:10:54.19,0:10:56.99,Caption,,0,0,0,,ОПЕРАТОР НАБЛЮДАЕТ ЧЕРЕЗ КАМЕРУ. ПОЯВИЛАСЬ ЦЕЛЬ.
Dialogue: 0,0:10:57.23,0:11:00.19,Caption,,0,0,0,,ДРОН СНОВА ВКЛЮЧАЕТСЯ И ИДЁТ НА НЕЁ. НИКАКОЙ
Dialogue: 0,0:11:00.19,0:11:02.99,Caption,,0,0,0,,ФАНТАСТИКИ. НИКАКОГО РЕАКТОРА РАЗМЕРОМ С
Dialogue: 0,0:11:02.99,0:11:09.02,Caption,,0,0,0,,ХОЛОДИЛЬНИК. СМЫСЛ В БАТАРЕЕ. ПОКА ОБЫЧНЫЙ FPV ВИСИТ В
Dialogue: 0,0:11:09.02,0:11:13.58,Caption,,0,0,0,,ВОЗДУХЕ И ИЩЕТ ЦЕЛЬ, АККУМУЛЯТОР УХОДИТ. ЧАСЫ НЕ КУПИШЬ. А ЕСЛИ АППАРАТ
Dialogue: 0,0:11:13.66,0:11:16.30,Caption,,0,0,0,,ЗАКРЕПИЛСЯ И ПЕРЕСТАЛ ТРАТИТЬ ЗАРЯД НА УДЕРЖАНИЕ В
Dialogue: 0,0:11:16.38,0:11:19.98,Caption,,0,0,0,,ВОЗДУХЕ, ВРЕМЯ ОЖИДАНИЯ РЕЗКО УВЕЛИЧИВАЕТСЯ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:11:19.98,0:11:25.02,Caption,,0,0,0,,ВОЗДУШНАЯ ЗАСАДА, ТОЛЬКО САМА ЗАСАДА ВИСИТ НА ПРОВОДЕ. ДЁШЕВО. ПРОСТО.
Dialogue: 0,0:11:25.23,0:11:28.22,Caption,,0,0,0,,ПРОТИВНО. УКРАИНСКИЙ СПЕЦИАЛИСТ СЕРГЕЙ БЕСКРЕСТНОВ,
Dialogue: 0,0:11:28.38,0:11:33.18,Caption,,0,0,0,,ИЗВЕСТНЫЙ КАК ФЛЕШ, ПИСАЛ, ЧТО РОССИЙСКИЕ ПОДРАЗДЕЛЕНИЯ ПЕРЕНЯЛИ ЭТУ ТАКТИКУ У
Dialogue: 0,0:11:33.18,0:11:35.74,Caption,,0,0,0,,УКРАИНСКОЙ СТОРОНЫ. И ЭТО, КСТАТИ,
Dialogue: 0,0:11:35.98,0:11:39.02,Caption,,0,0,0,,КУДА ВАЖНЕЕ РАЗГОВОРОВ О ТОМ, КТО ПЕРВЫМ ПРИДУМАЛ.
Dialogue: 0,0:11:39.81,0:11:42.30,Caption,,0,0,0,,В ЗАТЯЖНОМ КОНФЛИКТЕ АВТОРСКОЕ ПРАВО НА ХОРОШУЮ
Dialogue: 0,0:11:42.30,0:11:45.26,Caption,,0,0,0,,ТАКТИКУ ЖИВЁТ ПРИМЕРНО ДО ПЕРВОГО НОРМАЛЬНОГО ВИДЕО.
Dialogue: 0,0:11:45.50,0:11:48.54,Caption,,0,0,0,,ПОКАЗАЛ УДАЧНЫЙ ПРИЁМ. ПРОТИВНИК ПОСМОТРЕЛ. ЧЕРЕЗ
Dialogue: 0,0:11:48.62,0:11:51.34,Caption,,0,0,0,,НЕКОТОРОЕ ВРЕМЯ У НЕГО ПОЯВЛЯЕТСЯ СВОЁ. ПОТОМ ТЫ
Dialogue: 0,0:11:51.34,0:11:54.30,Caption,,0,0,0,,ИЩЕШЬ ЗАЩИТУ УЖЕ ОТ СОБСТВЕННОГО ИЗОБРЕТЕНИЯ. ВОТ
Dialogue: 0,0:11:54.38,0:11:57.34,Caption,,0,0,0,,ТАКАЯ ПРЕКРАСНАЯ ИНДУСТРИЯ ОБМЕНА ОПЫТОМ. БЕЗ
Dialogue: 0,0:11:57.42,0:12:00.30,Caption,,0,0,0,,КОНФЕРЕНЦИЙ И СЕРТИФИКАТОВ. ПОЭТОМУ ТЕХНОЛОГИЧЕСКОЕ
Dialogue: 0,0:12:00.30,0:12:03.02,Caption,,0,0,0,,ПРЕИМУЩЕСТВО СЕГОДНЯ ВСЁ ЧАЩЕ ИЗМЕРЯЕТСЯ НЕ ТОЛЬКО
Dialogue: 0,0:12:03.02,0:12:05.58,Caption,,0,0,0,,ТЕМ, КТО ПЕРВЫМ ПРИДУМАЛ. А ТЕМ,
Dialogue: 0,0:12:05.82,0:12:08.14,Caption,,0,0,0,,КТО БЫСТРЕЕ ЗАМЕТИЛ, СКОПИРОВАЛ,
Dialogue: 0,0:12:08.30,0:12:11.18,Caption,,0,0,0,,ПЕРЕДЕЛАЛ И СНОВА ЗАСТАВИЛ ПРОТИВНИКА ЧЕСАТЬ
Dialogue: 0,0:12:11.18,0:12:16.14,Caption,,0,0,0,,ЗАТЫЛОК. И ПОСЛЕ ОРБИТЫ, ДАЛЬНИХ РАКЕТ И ДРОНОВ ОСОБЕННО ХОРОШО ПОСМОТРЕТЬ НА
Dialogue: 0,0:12:16.14,0:12:21.18,Caption,,0,0,0,,ВЕЩЬ ОЧЕНЬ ЗЕМНУЮ. НА ПОРТ. ТАМ ВООБЩЕ НИКАКИХ ФАНТАСТИЧЕСКИХ ТЕХНОЛОГИЙ НЕ
Dialogue: 0,0:12:21.18,0:12:29.71,Caption,,0,0,0,,ТРЕБУЕТСЯ. ЕСТЬ ПРИЧАЛ. ЕСТЬ РЕЗЕРВУАРЫ. ЕСТЬ ОБОРУДОВАНИЕ. ЕСТЬ СУДА. ЕСТЬ
Dialogue: 0,0:12:29.71,0:12:32.67,Caption,,0,0,0,,ЗЕРНО. ЕСТЬ РАБОТНИКИ. И ЕСТЬ МОМЕНТ,
Dialogue: 0,0:12:32.99,0:12:35.47,Caption,,0,0,0,,КОГДА ВСЁ ЭТО ПЕРЕСТАЁТ НОРМАЛЬНО РАБОТАТЬ.
Dialogue: 0,0:12:36.27,0:12:39.07,Caption,,0,0,0,,ГУБЕРНАТОР РОСТОВСКОЙ ОБЛАСТИ ЮРИЙ СЛЮСАРЬ СООБЩИЛ О
Dialogue: 0,0:12:39.07,0:12:42.35,Caption,,0,0,0,,СЕРЬЁЗНЫХ ПРОБЛЕМАХ ТРЁХ ПОРТОВ РЕГИОНА. РОСТОВ НА
Dialogue: 0,0:12:42.35,0:12:47.79,Caption,,0,0,0,,ДОНУ. АЗОВ. ТАГАНРОГ. ПОСЛЕ АТАК БЕСПИЛОТНИКОВ ПОСТРАДАЛИ ПРИЧАЛЬНЫЕ
Dialogue: 0,0:12:47.79,0:12:51.79,Caption,,0,0,0,,СООРУЖЕНИЯ, РЕЗЕРВУАРЫ И ПЕРЕВАЛОЧНОЕ ОБОРУДОВАНИЕ. РАБОТА
Dialogue: 0,0:12:51.79,0:12:54.67,Caption,,0,0,0,,ФАКТИЧЕСКИ ОСТАНОВИЛАСЬ. А ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:12:54.67,0:12:58.03,Caption,,0,0,0,,ПРОСТОЕ И САМОЕ НЕПРИЯТНОЕ. ЕСЛИ ПРЕДПРИЯТИЕ СТОИТ,
Dialogue: 0,0:12:58.24,0:13:00.91,Caption,,0,0,0,,РАСХОДЫ НИКУДА НЕ УХОДЯТ. ТОЛЬКО ЗА МЕСЯЦ
Dialogue: 0,0:13:00.91,0:13:02.99,Caption,,0,0,0,,СТИВИДОРНЫЕ И СУДОХОДНЫЕ КОМПАНИИ,
Dialogue: 0,0:13:03.15,0:13:07.39,Caption,,0,0,0,,ПО СЛОВАМ ГУБЕРНАТОРА, НЕДОПОЛУЧИЛИ ПЯТЬ ЦЕЛЫХ ТРИ ДЕСЯТЫХ МИЛЛИАРДА
Dialogue: 0,0:13:07.39,0:13:11.23,Caption,,0,0,0,,РУБЛЕЙ. ПЯТЬ ЦЕЛЫХ ТРИ ДЕСЯТЫХ МИЛЛИАРДА ЗА ОДИН
Dialogue: 0,0:13:11.31,0:13:14.27,Caption,,0,0,0,,МЕСЯЦ. В ПОРТАХ И СВЯЗАННЫХ ПРЕДПРИЯТИЯХ РАБОТАЕТ
Dialogue: 0,0:13:14.27,0:13:17.47,Caption,,0,0,0,,БОЛЬШЕ СЕМИ ТЫСЯЧ ЧЕЛОВЕК. ЭТИМ ЛЮДЯМ НУЖНО ПЛАТИТЬ.
Dialogue: 0,0:13:17.71,0:13:19.31,Caption,,0,0,0,,СПЕЦИАЛИСТОВ СТАРАЮТСЯ СОХРАНИТЬ,
Dialogue: 0,0:13:19.71,0:13:22.35,Caption,,0,0,0,,ПОТОМУ ЧТО ВЫГНАТЬ КОЛЛЕКТИВ ЛЕГКО. А КОГДА РАБОТА
Dialogue: 0,0:13:22.35,0:13:26.19,Caption,,0,0,0,,ВОССТАНОВИТСЯ, ПОТОМ ПОПРОБУЙ БЫСТРО НАЙДИ ОБРАТНО НЕСКОЛЬКО ТЫСЯЧ
Dialogue: 0,0:13:26.19,0:13:29.23,Caption,,0,0,0,,ПОДГОТОВЛЕННЫХ ЛЮДЕЙ. ПРИ ЭТОМ БАНК НЕ ПИШЕТ ПИСЬМО
Dialogue: 0,0:13:29.31,0:13:33.95,Caption,,0,0,0,,РЕБЯТА, У ВАС ПРОБЛЕМЫ, КРЕДИТ ПОКА ЗАБУДЕМ. НАЛОГОВАЯ ТОЖЕ САМА ПО СЕБЕ
Dialogue: 0,0:13:34.03,0:13:36.51,Caption,,0,0,0,,НЕ ИСЧЕЗАЕТ. АРЕНДА НИКУДА НЕ ДЕВАЕТСЯ.
Dialogue: 0,0:13:36.67,0:13:40.19,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ОСТАЮТСЯ. ДОХОД ПАДАЕТ. ОЧЕНЬ БОДРЫЙ
Dialogue: 0,0:13:40.27,0:13:42.67,Caption,,0,0,0,,БИЗНЕС ПЛАН. СЛЕДОМ ПРОБЛЕМА ИДЁТ В ЗЕРНО.
Dialogue: 0,0:13:44.96,0:13:46.80,Caption,,0,0,0,,ЕСЛИ ПОРТ НЕ РАБОТАЕТ НОРМАЛЬНО,
Dialogue: 0,0:13:47.01,0:13:49.44,Caption,,0,0,0,,ГРУЗ НЕ УХОДИТ. ЕСЛИ ГРУЗ НЕ УХОДИТ,
Dialogue: 0,0:13:49.68,0:13:52.88,Caption,,0,0,0,,СКЛАДЫ ЗАПОЛНЯЮТСЯ. ЕСЛИ ЗЕРНО СТОИТ НА СКЛАДЕ,
Dialogue: 0,0:13:53.07,0:13:55.52,Caption,,0,0,0,,ПРОИЗВОДИТЕЛЬ НЕ ПОЛУЧАЕТ ДЕНЬГИ ВОВРЕМЯ. А У
Dialogue: 0,0:13:55.52,0:13:58.32,Caption,,0,0,0,,ПРОИЗВОДИТЕЛЯ ВПЕРЕДИ СВОИ РАСХОДЫ. ТОПЛИВО.
Dialogue: 0,0:13:58.54,0:14:01.68,Caption,,0,0,0,,ТЕХНИКА. КРЕДИТЫ. СЛЕДУЮЩИЙ СЕЛЬСКОХОЗЯЙСТВЕННЫЙ
Dialogue: 0,0:14:01.68,0:14:04.24,Caption,,0,0,0,,ЦИКЛ. И ВСЁ ЭТО НАЧИНАЕТ ЦЕПЛЯТЬСЯ ОДНО ЗА
Dialogue: 0,0:14:04.24,0:14:07.36,Caption,,0,0,0,,ДРУГОЕ. ПОЭТОМУ УДАР ПО ПРИЧАЛУ ЭТО НЕ ИСТОРИЯ
Dialogue: 0,0:14:07.44,0:14:10.48,Caption,,0,0,0,,ПРО КУСОК БЕТОНА ВОЗЛЕ ВОДЫ. ОН БЫСТРО ПРЕВРАЩАЕТСЯ
Dialogue: 0,0:14:10.48,0:14:12.64,Caption,,0,0,0,,В ПРОБЛЕМУ ДЛЯ ЦЕЛОЙ ЦЕПОЧКИ ЛЮДЕЙ,
Dialogue: 0,0:14:12.80,0:14:15.76,Caption,,0,0,0,,КОТОРЫЕ САМОГО ПОВРЕЖДЁННОГО ПРИЧАЛА ВООБЩЕ НИКОГДА
Dialogue: 0,0:14:15.84,0:14:18.56,Caption,,0,0,0,,НЕ ВИДЕЛИ. РЕГИОН ПРОСИТ ФЕДЕРАЛЬНЫЙ ЦЕНТР О
Dialogue: 0,0:14:18.56,0:14:22.08,Caption,,0,0,0,,НАЛОГОВЫХ ОТСРОЧКАХ. КРЕДИТНЫХ КАНИКУЛАХ. ЛЬГОТНЫХ
Dialogue: 0,0:14:22.08,0:14:25.28,Caption,,0,0,0,,ЗАЙМАХ. ПОНЯТНО ПОЧЕМУ. КОГДА НЕСКОЛЬКО МИЛЛИАРДОВ
Dialogue: 0,0:14:25.28,0:14:29.84,Caption,,0,0,0,,ДОХОДОВ ИСЧЕЗАЮТ ЗА МЕСЯЦ, ФИЛОСОФСТВОВАТЬ О СВОБОДНОМ РЫНКЕ ОБЫЧНО СТАНОВИТСЯ
Dialogue: 0,0:14:29.92,0:14:34.16,Caption,,0,0,0,,НЕ ДО ТОГО. НО ЗДЕСЬ ЕСТЬ ЕЩЁ ОДИН НЕУДОБНЫЙ МОМЕНТ. ВЛАДЕЛЬЦЫ
Dialogue: 0,0:14:34.16,0:14:36.96,Caption,,0,0,0,,ОБЪЕКТОВ КРИТИЧЕСКОЙ ИНФРАСТРУКТУРЫ ОБЯЗАНЫ САМИ
Dialogue: 0,0:14:36.96,0:14:40.08,Caption,,0,0,0,,ЗАНИМАТЬСЯ ПРОТИВОДРОНОВОЙ ЗАЩИТОЙ. И ТУТ БИЗНЕС
Dialogue: 0,0:14:40.08,0:14:43.44,Caption,,0,0,0,,ПОПАДАЕТ В СТАРУЮ ДОБРУЮ СИТУАЦИЮ. ПОКА ОБЪЕКТ
Dialogue: 0,0:14:43.44,0:14:48.00,Caption,,0,0,0,,РАБОТАЕТ, ОН ЧАСТНЫЙ. ПРИБЫЛЬ ТОЖЕ ОЧЕНЬ ДАЖЕ ЧАСТНАЯ. КОГДА
Dialogue: 0,0:14:48.00,0:14:51.04,Caption,,0,0,0,,ПРИЛЕТЕЛО, РАЗГОВОР БЫСТРО ПЕРЕХОДИТ К ГОСУДАРСТВЕННОЙ
Dialogue: 0,0:14:51.04,0:14:53.84,Caption,,0,0,0,,ПОДДЕРЖКЕ. НИЧЕГО НОВОГО ЧЕЛОВЕЧЕСТВО ТУТ НЕ
Dialogue: 0,0:14:53.92,0:14:58.99,Caption,,0,0,0,,ИЗОБРЕЛО. ГОСУДАРСТВО ВСЁ РАВНО НЕ СМОЖЕТ ПРОСТО ОТВЕРНУТЬСЯ,
Dialogue: 0,0:14:59.21,0:15:01.47,Caption,,0,0,0,,ПОТОМУ ЧТО ЗА ЧАСТНЫМ ПОРТОМ СТОЯТ ЭКСПОРТ,
Dialogue: 0,0:15:01.55,0:15:06.99,Caption,,0,0,0,,ЗЕРНО, РАБОТНИКИ, БАНКИ, НАЛОГИ И ТРАНСПОРТ. НО И ВОПРОС К ВЛАДЕЛЬЦУ
Dialogue: 0,0:15:06.99,0:15:10.11,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗАЕТ. ЧТО ИМЕННО ОН СДЕЛАЛ,
Dialogue: 0,0:15:10.20,0:15:15.31,Caption,,0,0,0,,ЧТОБЫ СВОЙ ОБЪЕКТ ЗАЩИТИТЬ? ПОТОМУ ЧТО КРИТИЧЕСКАЯ ИНФРАСТРУКТУРА ПОЛУЧИЛА СЛОВО
Dialogue: 0,0:15:15.31,0:15:18.35,Caption,,0,0,0,,"КРИТИЧЕСКАЯ" НЕ ЗА КРАСИВУЮ ТАБЛИЧКУ У ВОРОТ. ОНА
Dialogue: 0,0:15:18.35,0:15:22.03,Caption,,0,0,0,,КРИТИЧЕСКАЯ ИМЕННО ПОТОМУ, ЧТО КОГДА ЛОМАЕТСЯ ОДИН ОБЪЕКТ,
Dialogue: 0,0:15:22.27,0:15:25.07,Caption,,0,0,0,,ПРОБЛЕМЫ НАЧИНАЮТ ПОЯВЛЯТЬСЯ ДАЛЕКО ЗА ЕГО ЗАБОРОМ.
Dialogue: 0,0:15:25.53,0:15:28.51,Caption,,0,0,0,,И ВОТ ЗДЕСЬ НОВАЯ ТЕХНИКА СТАЛКИВАЕТСЯ С ОЧЕНЬ
Dialogue: 0,0:15:28.59,0:15:31.71,Caption,,0,0,0,,СТАРОЙ ЧЕЛОВЕЧЕСКОЙ ПРИВЫЧКОЙ. ОРУЖИЕ И СПОСОБЫ ЕГО
Dialogue: 0,0:15:31.71,0:15:34.91,Caption,,0,0,0,,ПРИМЕНЕНИЯ МЕНЯЮТСЯ БЕШЕНО БЫСТРО. ПРАВИЛА,
Dialogue: 0,0:15:35.11,0:15:38.59,Caption,,0,0,0,,ЗАКОНЫ И ПРЕДСТАВЛЕНИЯ О ТОМ, ЧТО СЧИТАТЬ ГРАЖДАНСКИМ,
Dialogue: 0,0:15:38.73,0:15:41.31,Caption,,0,0,0,,ВОЕННЫМ, ДОПУСТИМЫМ И НЕДОПУСТИМЫМ,
Dialogue: 0,0:15:41.57,0:15:44.35,Caption,,0,0,0,,ПОЛЗУТ СЛЕДОМ С ПАПКОЙ ДОКУМЕНТОВ ПОД МЫШКОЙ. ПОКА
Dialogue: 0,0:15:44.35,0:15:46.59,Caption,,0,0,0,,ПОЛИТИКИ ОПРЕДЕЛЯЮТ СТАТУС СПУТНИКА,
Dialogue: 0,0:15:46.74,0:15:51.63,Caption,,0,0,0,,ВОЕННЫЕ УЖЕ СМОТРЯТ, ЧТО ОН УМЕЕТ. ПОКА ЮРИСТЫ ОБСУЖДАЮТ НОВУЮ СИСТЕМУ,
Dialogue: 0,0:15:51.79,0:15:55.15,Caption,,0,0,0,,ИНЖЕНЕРЫ УЖЕ РИСУЮТ СЛЕДУЮЩУЮ. ПОКА ОДНА СТОРОНА
Dialogue: 0,0:15:55.23,0:15:57.31,Caption,,0,0,0,,ИЩЕТ ЗАЩИТУ ОТ ВЧЕРАШНЕГО РЕШЕНИЯ,
Dialogue: 0,0:15:57.52,0:15:59.87,Caption,,0,0,0,,ДРУГАЯ УЖЕ ПРИНЕСЛА ЗАВТРАШНЕЕ. И,
Dialogue: 0,0:16:00.02,0:16:03.95,Caption,,0,0,0,,ПОХОЖЕ, ИМЕННО ЭТО ТЕПЕРЬ СТАНОВИТСЯ ГЛАВНЫМ СОРЕВНОВАНИЕМ.
Dialogue: 0,0:16:04.27,0:16:07.23,Caption,,0,0,0,,НЕ ТОЛЬКО КТО СИЛЬНЕЕ. А КТО БЫСТРЕЕ ЗАСТАВИТ
Dialogue: 0,0:16:07.23,0:16:09.39,Caption,,0,0,0,,ПРОТИВНИКА СНОВА МЕНЯТЬ ПРАВИЛА ИГРЫ.
