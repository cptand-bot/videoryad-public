Dialogue: 0,0:00:00.10,0:00:02.92,Caption,,0,0,0,,ПОМНИТЕ КЛАССИЧЕСКОЕ "А КАК ХОРОШО ВСЁ НАЧИНАЛОСЬ!
Dialogue: 0,0:00:02.92,0:00:07.72,Caption,,0,0,0,,ВЫЗЫВАЕМ ВАС В МОСКВУ!"? ВОТ И СЕЙЧАС ПРИМЕРНО ТАКАЯ ЖЕ ИСТОРИЯ. ПРИГЛАШЕНИЕ
Dialogue: 0,0:00:07.80,0:00:11.16,Caption,,0,0,0,,ВРОДЕ БЫ СЕРЬЁЗНОЕ. ЛЮДИ ТОЖЕ СЕРЬЁЗНЫЕ. РАЗГОВОР
Dialogue: 0,0:00:11.16,0:00:14.36,Caption,,0,0,0,,НАМЕЧАЕТСЯ ТАКОЙ, ЧТО ТУТ УЖ ЯВНО НЕ ДО ХУДОЖЕСТВЕННОЙ
Dialogue: 0,0:00:14.36,0:00:16.68,Caption,,0,0,0,,САМОДЕЯТЕЛЬНОСТИ. НО ЧЕМ ДАЛЬШЕ,
Dialogue: 0,0:00:16.88,0:00:19.32,Caption,,0,0,0,,ТЕМ БОЛЬШЕ ВСЯ ЭТА ИСТОРИЯ НАЧИНАЕТ НАПОМИНАТЬ
Dialogue: 0,0:00:19.32,0:00:22.60,Caption,,0,0,0,,СТАРУЮ СОВЕТСКУЮ КОМЕДИЮ. ПРИЧЁМ САМОЕ ИНТЕРЕСНОЕ
Dialogue: 0,0:00:22.60,0:00:25.40,Caption,,0,0,0,,ДАЖЕ НЕ В ТОМ, КОГО ПРИГЛАСИЛИ. А В ТОМ,
Dialogue: 0,0:00:25.60,0:00:28.04,Caption,,0,0,0,,ПОЧЕМУ ВОКРУГ ЭТОГО ПРИГЛАШЕНИЯ ПОДНЯЛАСЬ ТАКАЯ
Dialogue: 0,0:00:28.04,0:00:33.40,Caption,,0,0,0,,СУЕТА. И ВОТ ЗДЕСЬ, ПОХОЖЕ, НАЧИНАЕТСЯ УЖЕ СОВСЕМ ДРУГОЕ КИНО. ЕСЛИ ВАМ
Dialogue: 0,0:00:33.48,0:00:36.84,Caption,,0,0,0,,ИНТЕРЕСНЫ ТАКИЕ ИСТОРИИ, ПОДПИШИТЕСЬ НА КАНАЛ. ИТАК,
Dialogue: 0,0:00:37.14,0:00:39.80,Caption,,0,0,0,,ВЛАДИМИР ПУТИН ПРИГЛАШАЕТ ПРЕДСТАВИТЕЛЕЙ ЕВРОПЕЙСКИХ
Dialogue: 0,0:00:39.80,0:00:42.52,Caption,,0,0,0,,ГОСУДАРСТВ ПРИЕХАТЬ В МОСКВУ. КАЗАЛОСЬ БЫ,
Dialogue: 0,0:00:42.60,0:00:44.28,Caption,,0,0,0,,ЧЕГО ПРОЩЕ? ХОТЕЛИ РАЗГОВАРИВАТЬ,
Dialogue: 0,0:00:44.44,0:00:47.00,Caption,,0,0,0,,ВОТ ВАМ ПРИГЛАШЕНИЕ. СОБИРАЙТЕ ДЕЛЕГАЦИЮ,
Dialogue: 0,0:00:47.08,0:00:49.96,Caption,,0,0,0,,ПОКУПАЙТЕ БИЛЕТЫ И ПРИЕЗЖАЙТЕ. НО ВЫЯСНИЛАСЬ
Dialogue: 0,0:00:49.96,0:00:52.92,Caption,,0,0,0,,УДИВИТЕЛЬНАЯ ВЕЩЬ. ЕЩЁ НИКТО НИКУДА НЕ УЛЕТЕЛ,
Dialogue: 0,0:00:53.16,0:00:57.48,Caption,,0,0,0,,НИКТО НИЧЕГО НЕ ПОДПИСАЛ, ДАЖЕ ОКОНЧАТЕЛЬНОЙ ДОГОВОРЁННОСТИ О ВСТРЕЧЕ НЕТ,
Dialogue: 0,0:00:57.72,0:01:00.28,Caption,,0,0,0,,А ВЛАДИМИР ЗЕЛЕНСКИЙ УЖЕ ОБЪЯСНЯЕТ ЕВРОПЕЙЦАМ,
Dialogue: 0,0:01:00.36,0:01:02.92,Caption,,0,0,0,,ЧТО ЕХАТЬ НЕЛЬЗЯ. ПРИЧЁМ НЕ В ТОМ СМЫСЛЕ,
Dialogue: 0,0:01:03.16,0:01:05.96,Caption,,0,0,0,,ЧТО ВРЕМЯ НЕУДОБНОЕ ИЛИ СОСТАВ ДЕЛЕГАЦИИ НЕ ТОТ.
Dialogue: 0,0:01:06.28,0:01:08.92,Caption,,0,0,0,,ЕГО ПРЯМО СПРОСИЛИ О ВОЗМОЖНОМ ПРИЕЗДЕ ЕВРОПЕЙСКИХ
Dialogue: 0,0:01:08.92,0:01:11.80,Caption,,0,0,0,,СОВЕТНИКОВ В МОСКВУ. И ОН ОТВЕТИЛ "Я СЧИТАЮ,
Dialogue: 0,0:01:11.88,0:01:14.20,Caption,,0,0,0,,ЧТО ОНИ НЕ МОГУТ ПОЕХАТЬ. ЭТО БЫЛО БЫ
Dialogue: 0,0:01:14.28,0:01:19.59,Caption,,0,0,0,,ОШИБКОЙ". ОБРАТИТЕ ВНИМАНИЕ. НЕ УКРАИНСКУЮ ДЕЛЕГАЦИЮ
Dialogue: 0,0:01:19.59,0:01:22.39,Caption,,0,0,0,,ПРИГЛАШАЮТ. НЕ ЗЕЛЕНСКОМУ ПРЕДЛАГАЮТ ЛЕТЕТЬ В
Dialogue: 0,0:01:22.39,0:01:25.03,Caption,,0,0,0,,МОСКВУ. РЕЧЬ О ПРЕДСТАВИТЕЛЯХ ФРАНЦИИ,
Dialogue: 0,0:01:25.13,0:01:28.39,Caption,,0,0,0,,ГЕРМАНИИ И ВЕЛИКОБРИТАНИИ. ТРЁХ ГОСУДАРСТВ,
Dialogue: 0,0:01:28.63,0:01:31.19,Caption,,0,0,0,,КОТОРЫЕ САМИ ПРИНИМАЮТ РЕШЕНИЯ О СВОИХ ВНЕШНИХ
Dialogue: 0,0:01:31.19,0:01:33.19,Caption,,0,0,0,,СВЯЗЯХ. А ЗЕЛЕНСКИЙ УЖЕ ГОВОРИТ,
Dialogue: 0,0:01:33.43,0:01:36.55,Caption,,0,0,0,,ЧТО ОНИ НЕ МОГУТ ЕХАТЬ. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ ИСТОРИЯ.
Dialogue: 0,0:01:36.77,0:01:38.71,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ДОЛЖНЫ ПОМОГАТЬ КИЕВУ,
Dialogue: 0,0:01:39.02,0:01:41.27,Caption,,0,0,0,,ВЫДЕЛЯТЬ ДЕНЬГИ, ПОСТАВЛЯТЬ ВООРУЖЕНИЯ,
Dialogue: 0,0:01:41.46,0:01:44.23,Caption,,0,0,0,,ПРИНИМАТЬ ПОЛИТИЧЕСКИЕ РЕШЕНИЯ В ПОДДЕРЖКУ УКРАИНЫ.
Dialogue: 0,0:01:44.63,0:01:46.63,Caption,,0,0,0,,НО И С КЕМ ИМ РАЗРЕШАЕТСЯ РАЗГОВАРИВАТЬ,
Dialogue: 0,0:01:46.87,0:01:49.99,Caption,,0,0,0,,УКРАИНСКИЙ ПРЕЗИДЕНТ ТОЖЕ ХОТЕЛ БЫ ОПРЕДЕЛЯТЬ САМ. И
Dialogue: 0,0:01:49.99,0:01:52.23,Caption,,0,0,0,,ЗДЕСЬ ДАЖЕ НЕ ОБЯЗАТЕЛЬНО СПОРИТЬ О ПРАВИЛЬНОСТИ
Dialogue: 0,0:01:52.23,0:01:55.59,Caption,,0,0,0,,САМОГО ВИЗИТА. ВОПРОС ГОРАЗДО ПРОЩЕ. С КАКИХ ПОР
Dialogue: 0,0:01:55.59,0:01:58.15,Caption,,0,0,0,,ПРЕЗИДЕНТ ОДНОЙ СТРАНЫ ПОЛУЧИЛ ПРАВО ЗАПРЕЩАТЬ
Dialogue: 0,0:01:58.15,0:02:00.39,Caption,,0,0,0,,РУКОВОДСТВУ ДРУГИХ ГОСУДАРСТВ РАЗГОВАРИВАТЬ С
Dialogue: 0,0:02:00.47,0:02:03.19,Caption,,0,0,0,,ТРЕТЬЕЙ? НО САМОЕ ИНТЕРЕСНОЕ, ПОЖАЛУЙ,
Dialogue: 0,0:02:03.28,0:02:06.71,Caption,,0,0,0,,ДАЖЕ НЕ ЭТО. ЗЕЛЕНСКИЙ ОБЪЯСНИЛ СВОЁ ВОЗРАЖЕНИЕ ТЕМ,
Dialogue: 0,0:02:06.87,0:02:09.19,Caption,,0,0,0,,ЧТО ПРИГЛАШЕНИЕ СО СТОРОНЫ РОССИИ ЯКОБЫ
Dialogue: 0,0:02:09.19,0:02:12.39,Caption,,0,0,0,,СВИДЕТЕЛЬСТВУЕТ О НЕЖЕЛАНИИ ВЕСТИ ПЕРЕГОВОРЫ. ВОТ
Dialogue: 0,0:02:12.47,0:02:14.87,Caption,,0,0,0,,ЭТО УЖЕ ДЕЙСТВИТЕЛЬНО ЗАМЕЧАТЕЛЬНАЯ ДИПЛОМАТИЧЕСКАЯ
Dialogue: 0,0:02:14.87,0:02:17.43,Caption,,0,0,0,,ЛОГИКА. ЕСЛИ НЕ ПРИГЛАШАЮТ, ЗНАЧИТ,
Dialogue: 0,0:02:17.51,0:02:20.23,Caption,,0,0,0,,РАЗГОВАРИВАТЬ НЕ ХОТЯТ. ЕСЛИ ПРИГЛАШАЮТ,
Dialogue: 0,0:02:20.50,0:02:24.55,Caption,,0,0,0,,ТОЖЕ НЕ ХОТЯТ. ВИДИМО, ПРАВИЛЬНОЕ ПРИГЛАШЕНИЕ ДОЛЖНО ВЫГЛЯДЕТЬ КАК ТО
Dialogue: 0,0:02:24.55,0:02:27.03,Caption,,0,0,0,,СОВЕРШЕННО ИНАЧЕ. А ТЕПЕРЬ ПОСМОТРИМ,
Dialogue: 0,0:02:27.11,0:02:29.67,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ ПО ДРУГУЮ СТОРОНУ ЭТОГО СПОРА.
Dialogue: 0,0:02:31.94,0:02:34.90,Caption,,0,0,0,,ПО ИНФОРМАЦИИ BLOOMBERG, ПРЕДСТАВИТЕЛИ ФРАНЦИИ,
Dialogue: 0,0:02:34.98,0:02:38.18,Caption,,0,0,0,,ГЕРМАНИИ И ВЕЛИКОБРИТАНИИ УЖЕ ОБСУЖДАЛИ ВОЗМОЖНУЮ
Dialogue: 0,0:02:38.26,0:02:40.82,Caption,,0,0,0,,ВСТРЕЧУ С РОССИЙСКОЙ СТОРОНОЙ. БОЛЕЕ ТОГО,
Dialogue: 0,0:02:40.98,0:02:43.30,Caption,,0,0,0,,СОВЕТНИК ПО НАЦИОНАЛЬНОЙ БЕЗОПАСНОСТИ ОДНОЙ ИЗ
Dialogue: 0,0:02:43.38,0:02:46.34,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТРАН СВЯЗЫВАЛСЯ С ЮРИЕМ УШАКОВЫМ,
Dialogue: 0,0:02:46.49,0:02:49.54,Caption,,0,0,0,,ПОМОЩНИКОМ РОССИЙСКОГО ПРЕЗИДЕНТА. ВОТ ВАМ ПЕРВАЯ
Dialogue: 0,0:02:49.62,0:02:52.34,Caption,,0,0,0,,ВАЖНАЯ ДЕТАЛЬ. РАЗГОВОР ПОКА НЕ ОГРАНИЧИВАЕТСЯ
Dialogue: 0,0:02:52.34,0:02:55.14,Caption,,0,0,0,,ПУБЛИЧНЫМИ РЕЧАМИ. ОПИСЫВАЕТСЯ УЖЕ И КОНКРЕТНЫЙ
Dialogue: 0,0:02:55.22,0:02:57.94,Caption,,0,0,0,,КОНТАКТ МЕЖДУ ПРЕДСТАВИТЕЛЯМИ СТОРОН. ЭТО ЕЩЁ НЕ
Dialogue: 0,0:02:57.94,0:03:01.54,Caption,,0,0,0,,ОЗНАЧАЕТ, ЧТО ВИЗИТ СОГЛАСОВАН. НО И НА ПУСТУЮ ГАЗЕТНУЮ
Dialogue: 0,0:03:01.54,0:03:03.38,Caption,,0,0,0,,ФАНТАЗИЮ ИСТОРИЯ УЖЕ НЕ ПОХОЖА.
Dialogue: 0,0:03:03.94,0:03:06.18,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ МИНИСТР ОБОРОНЫ ГЕРМАНИИ БОРИС
Dialogue: 0,0:03:06.18,0:03:09.62,Caption,,0,0,0,,ПИСТОРИУС ЗАЯВИЛ, ЧТО ОТКЛОНИТЬ ПРИГЛАШЕНИЕ В МОСКВУ БЫЛО БЫ
Dialogue: 0,0:03:09.62,0:03:12.50,Caption,,0,0,0,,СОВЕРШЕННО НЕПРАВИЛЬНЫМ СИГНАЛОМ. И ДОБАВИЛ ПРОСТУЮ
Dialogue: 0,0:03:12.50,0:03:15.14,Caption,,0,0,0,,ВЕЩЬ "МЫ ДОЛЖНЫ РАЗГОВАРИВАТЬ. ТОЛЬКО ТОТ,
Dialogue: 0,0:03:15.22,0:03:19.54,Caption,,0,0,0,,КТО РАЗГОВАРИВАЕТ, МОЖЕТ В КОНЕЧНОМ ИТОГЕ ДОСТИЧЬ РЕЗУЛЬТАТОВ". НУ НАДО
Dialogue: 0,0:03:19.54,0:03:22.66,Caption,,0,0,0,,ЖЕ. ОКАЗЫВАЕТСЯ, ЧТОБЫ О ЧЁМ ТО ДОГОВОРИТЬСЯ,
Dialogue: 0,0:03:22.82,0:03:25.46,Caption,,0,0,0,,СНАЧАЛА НУЖНО ХОТЯ БЫ ПОГОВОРИТЬ. ДО ЭТОЙ
Dialogue: 0,0:03:25.46,0:03:27.86,Caption,,0,0,0,,УДИВИТЕЛЬНОЙ МЫСЛИ ЕВРОПЕЙСКАЯ ПОЛИТИКА ДОБИРАЛАСЬ
Dialogue: 0,0:03:27.86,0:03:30.18,Caption,,0,0,0,,ДОВОЛЬНО ДОЛГО. И ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:03:30.31,0:03:33.06,Caption,,0,0,0,,КТО ЭТО ГОВОРИТ. НЕ ДЕПУТАТ ОППОЗИЦИИ,
Dialogue: 0,0:03:33.30,0:03:35.94,Caption,,0,0,0,,НЕ БЫВШИЙ ЧИНОВНИК, КОТОРОМУ УЖЕ НЕЧЕГО ТЕРЯТЬ,
Dialogue: 0,0:03:36.24,0:03:38.74,Caption,,0,0,0,,А ДЕЙСТВУЮЩИЙ МИНИСТР ОБОРОНЫ ГЕРМАНИИ.
Dialogue: 0,0:03:41.01,0:03:43.65,Caption,,0,0,0,,ТО ЕСТЬ ЧЕЛОВЕК, КОТОРЫЙ ПРЕКРАСНО ПОНИМАЕТ,
Dialogue: 0,0:03:43.89,0:03:46.37,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ МЕЖДУ РОССИЕЙ И ЕВРОПЕЙСКИМИ
Dialogue: 0,0:03:46.37,0:03:48.05,Caption,,0,0,0,,ГОСУДАРСТВАМИ В ВОЕННОЙ СФЕРЕ.
Dialogue: 0,0:03:48.61,0:03:50.53,Caption,,0,0,0,,ПРИ ЭТОМ МОСКВА ТОЖЕ НЕ ОБЪЯВЛЯЕТ,
Dialogue: 0,0:03:50.69,0:03:53.81,Caption,,0,0,0,,ЧТО ВСЁ РЕШЕНО. ЗАМЕСТИТЕЛЬ МИНИСТРА ИНОСТРАННЫХ ДЕЛ
Dialogue: 0,0:03:53.89,0:03:56.29,Caption,,0,0,0,,РОССИИ СЕРГЕЙ РЯБКОВ ПОДТВЕРЖДАЕТ ВОЗМОЖНОСТЬ
Dialogue: 0,0:03:56.29,0:03:59.33,Caption,,0,0,0,,ПРИЕЗДА ЕВРОПЕЙСКИХ ПЕРЕГОВОРЩИКОВ ПРОРАБАТЫВАЕТСЯ.
Dialogue: 0,0:03:59.65,0:04:02.05,Caption,,0,0,0,,НО ДОГОВОРЁННОСТЕЙ О НОВОМ РАУНДЕ ПЕРЕГОВОРОВ ПО
Dialogue: 0,0:04:02.05,0:04:05.01,Caption,,0,0,0,,УКРАИНЕ ПОКА НЕТ. И ЗДЕСЬ ВОЗНИКАЕТ ЕЩЁ ОДИН
Dialogue: 0,0:04:05.01,0:04:09.25,Caption,,0,0,0,,ИНТЕРЕСНЫЙ ВОПРОС. ДОПУСТИМ, ПРЕДСТАВИТЕЛИ ЕВРОПЕЙСКОЙ ТРОЙКИ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:09.25,0:04:12.45,Caption,,0,0,0,,ПРИЕЗЖАЮТ. А ЧТО ИМЕННО ОНИ СОБИРАЮТСЯ ОБСУЖДАТЬ?
Dialogue: 0,0:04:12.75,0:04:14.69,Caption,,0,0,0,,ПРОСТО ВЫСЛУШАТЬ РОССИЙСКУЮ ПОЗИЦИЮ?
Dialogue: 0,0:04:14.93,0:04:16.85,Caption,,0,0,0,,ДОГОВОРИТЬСЯ ОБ УСЛОВИЯХ БЕЗОПАСНОСТИ?
Dialogue: 0,0:04:17.13,0:04:19.09,Caption,,0,0,0,,ИЛИ ПОПЫТАТЬСЯ ПОЛУЧИТЬ ОБЕЩАНИЯ,
Dialogue: 0,0:04:19.25,0:04:21.25,Caption,,0,0,0,,КОТОРЫЕ ПОТОМ ЕЩЁ ПРИДЁТСЯ СОГЛАСОВЫВАТЬ С
Dialogue: 0,0:04:21.25,0:04:25.41,Caption,,0,0,0,,ВАШИНГТОНОМ И КИЕВОМ? ВЕДЬ ЭТО СОВЕРШЕННО РАЗНЫЕ ЗАДАЧИ. ОСОБЕННО ЕСЛИ
Dialogue: 0,0:04:25.41,0:04:28.29,Caption,,0,0,0,,ВСПОМНИТЬ СЛОВА ДОНАЛЬДА ТРАМПА. ПРЕЗИДЕНТ ФИНЛЯНДИИ
Dialogue: 0,0:04:28.29,0:04:30.77,Caption,,0,0,0,,АЛЕКСАНДР СТУББ РАССКАЗАЛ О ТЕЛЕФОННОМ РАЗГОВОРЕ
Dialogue: 0,0:04:30.77,0:04:32.85,Caption,,0,0,0,,АМЕРИКАНСКОГО ПРЕЗИДЕНТА С УЧАСТНИКАМИ ТАК
Dialogue: 0,0:04:32.85,0:04:35.09,Caption,,0,0,0,,НАЗЫВАЕМОЙ КОАЛИЦИИ ЖЕЛАЮЩИХ В БЕРЛИНЕ.
Dialogue: 0,0:04:35.65,0:04:38.29,Caption,,0,0,0,,ТРАМП ЗВОНИЛ ПРЯМО С БОРТА СВОЕГО САМОЛЁТА ПОСЛЕ
Dialogue: 0,0:04:38.29,0:04:40.85,Caption,,0,0,0,,ПЕРЕГОВОРОВ С ВЛАДИМИРОМ ПУТИНЫМ И СИ ЦЗИНЬПИНОМ В
Dialogue: 0,0:04:40.85,0:04:43.97,Caption,,0,0,0,,КИТАЕ. АМЕРИКАНСКИЙ ПРЕЗИДЕНТ СООБЩИЛ ЕВРОПЕЙЦАМ О
Dialogue: 0,0:04:43.97,0:04:46.05,Caption,,0,0,0,,РЕЗУЛЬТАТАХ ЭТИХ КОНТАКТОВ И ПЕРЕДАЛ,
Dialogue: 0,0:04:46.24,0:04:52.72,Caption,,0,0,0,,ЧТО ПУТИН ОТКРЫТ К ДИАЛОГУ. А ЗАТЕМ ПОСОВЕТОВАЛ ЕВРОПЕЙСКИМ ЛИДЕРАМ САМИМ
Dialogue: 0,0:04:52.72,0:04:55.52,Caption,,0,0,0,,СВЯЗАТЬСЯ С РОССИЙСКИМ ПРЕЗИДЕНТОМ. НУ ВОТ,
Dialogue: 0,0:04:55.64,0:04:59.84,Caption,,0,0,0,,СОБСТВЕННО, И ВСЯ ИНСТРУКЦИЯ. ТЕЛЕФОН ЗНАЕТЕ. МОСКВА НА МЕСТЕ.
Dialogue: 0,0:04:59.92,0:05:04.00,Caption,,0,0,0,,ХОТИТЕ РАЗГОВАРИВАТЬ, РАЗГОВАРИВАЙТЕ. И ВЕДЬ ПОЛУЧАЕТСЯ ВЕСЬМА ЛЮБОПЫТНОЕ
Dialogue: 0,0:05:04.00,0:05:07.12,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЕ РОЛЕЙ. ТРАМП СОВЕТУЕТ ЕВРОПЕЙЦАМ
Dialogue: 0,0:05:07.12,0:05:09.92,Caption,,0,0,0,,САМОСТОЯТЕЛЬНО СВЯЗАТЬСЯ С ПУТИНЫМ. ПИСТОРИУС
Dialogue: 0,0:05:10.00,0:05:13.04,Caption,,0,0,0,,СЧИТАЕТ ОТКАЗ ОТ ПРИГЛАШЕНИЯ НЕПРАВИЛЬНЫМ. МОСКВА
Dialogue: 0,0:05:13.04,0:05:16.48,Caption,,0,0,0,,СООБЩАЕТ, ЧТО ГОТОВА ЗАНИМАТЬСЯ ОРГАНИЗАЦИЕЙ ВИЗИТА. А
Dialogue: 0,0:05:16.48,0:05:18.24,Caption,,0,0,0,,ЗЕЛЕНСКИЙ УБЕЖДАЕТ ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:05:18.41,0:05:21.36,Caption,,0,0,0,,ЧТО ЕХАТЬ НЕЛЬЗЯ. ПРИЧЁМ НИКТО ПОКА НЕ ПРЕДЛАГАЕТ
Dialogue: 0,0:05:21.36,0:05:24.32,Caption,,0,0,0,,УКРАИНЕ НЕМЕДЛЕННО ПОДПИСЫВАТЬ КАКИЕ ЛИБО ДОКУМЕНТЫ.
Dialogue: 0,0:05:24.64,0:05:27.44,Caption,,0,0,0,,РЕЧЬ ИДЁТ О САМОМ ПРАВЕ НА РАЗГОВОР. И
Dialogue: 0,0:05:27.44,0:05:30.00,Caption,,0,0,0,,ЗДЕСЬ СТОИТ ВСПОМНИТЬ ЕЩЁ ОДНУ ДЕТАЛЬ ИЗ СЛОВ
Dialogue: 0,0:05:30.08,0:05:32.16,Caption,,0,0,0,,СТУББА. ФИНСКИЙ ПРЕЗИДЕНТ СЧИТАЕТ,
Dialogue: 0,0:05:32.34,0:05:35.12,Caption,,0,0,0,,ЧТО БЕЗ ЛИЧНОЙ ВСТРЕЧИ ПУТИНА И ЗЕЛЕНСКОГО ДОБИТЬСЯ
Dialogue: 0,0:05:35.20,0:05:38.16,Caption,,0,0,0,,ОКОНЧАТЕЛЬНОГО УРЕГУЛИРОВАНИЯ НЕ ПОЛУЧИТСЯ. ТО ЕСТЬ
Dialogue: 0,0:05:38.24,0:05:40.56,Caption,,0,0,0,,У ЕВРОПЕЙЦЕВ МОЖЕТ БЫТЬ СОБСТВЕННЫЙ РАЗГОВОР С
Dialogue: 0,0:05:40.56,0:05:43.84,Caption,,0,0,0,,МОСКВОЙ, НО РЕШЕНИЕ УКРАИНСКОГО ВОПРОСА ВСЁ РАВНО,
Dialogue: 0,0:05:43.95,0:05:47.68,Caption,,0,0,0,,ПО ЭТОЙ ЛОГИКЕ, ПОТРЕБУЕТ ОТДЕЛЬНОГО КОНТАКТА ДВУХ ПРЕЗИДЕНТОВ.
Dialogue: 0,0:05:47.94,0:05:51.76,Caption,,0,0,0,,ПОЛУЧАЕТСЯ, ПОЕЗДКА ЕВРОПЕЙСКИХ ПРЕДСТАВИТЕЛЕЙ НЕ ПОДМЕНЯЕТ
Dialogue: 0,0:05:51.76,0:05:54.64,Caption,,0,0,0,,УКРАИНСКИЕ ПЕРЕГОВОРЫ. ОНА НУЖНА ДЛЯ ДРУГОЙ ЧАСТИ
Dialogue: 0,0:05:54.72,0:05:57.76,Caption,,0,0,0,,ОБЩЕЙ ПРОБЛЕМЫ. ТОГДА ПОЧЕМУ САМА ВОЗМОЖНОСТЬ ТАКОЙ
Dialogue: 0,0:05:57.76,0:06:00.32,Caption,,0,0,0,,ВСТРЕЧИ ВЫЗЫВАЕТ У КИЕВА СТОЛЬ РЕЗКУЮ РЕАКЦИЮ?
Dialogue: 0,0:06:00.80,0:06:02.64,Caption,,0,0,0,,ОДНА ИЗ ВЕРСИЙ ЛЕЖИТ НА ПОВЕРХНОСТИ.
Dialogue: 0,0:06:04.92,0:06:07.24,Caption,,0,0,0,,ПОКА ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОБСУЖДАЮТ РОССИЮ
Dialogue: 0,0:06:07.24,0:06:09.40,Caption,,0,0,0,,ПРЕИМУЩЕСТВЕННО МЕЖДУ СОБОЙ И С КИЕВОМ,
Dialogue: 0,0:06:09.65,0:06:12.28,Caption,,0,0,0,,УКРАИНСКОЕ РУКОВОДСТВО УЧАСТВУЕТ В ФОРМИРОВАНИИ ИХ
Dialogue: 0,0:06:12.28,0:06:15.08,Caption,,0,0,0,,ОБЩЕЙ ПОЗИЦИИ. НО СТОИТ ЕВРОПЕЙЦАМ ОТКРЫТЬ
Dialogue: 0,0:06:15.08,0:06:17.00,Caption,,0,0,0,,САМОСТОЯТЕЛЬНЫЙ КАНАЛ С МОСКВОЙ,
Dialogue: 0,0:06:17.31,0:06:19.16,Caption,,0,0,0,,И ТАМ МОГУТ ПРОЗВУЧАТЬ ПРЕДЛОЖЕНИЯ,
Dialogue: 0,0:06:19.43,0:06:22.28,Caption,,0,0,0,,КОТОРЫЕ ЗАРАНЕЕ НИКТО С ЗЕЛЕНСКИМ НЕ СОГЛАСОВЫВАЛ.
Dialogue: 0,0:06:22.52,0:06:26.36,Caption,,0,0,0,,ЭТО ЕЩЁ НЕ ОЗНАЧАЕТ, ЧТО ЕВРОПЕЙЦЫ ДОГОВОРЯТСЯ ЗА ЕГО СПИНОЙ. НО
Dialogue: 0,0:06:26.36,0:06:29.32,Caption,,0,0,0,,ВОЗМОЖНОСТЬ САМОСТОЯТЕЛЬНОГО РАЗГОВОРА УЖЕ МЕНЯЕТ
Dialogue: 0,0:06:29.32,0:06:32.52,Caption,,0,0,0,,ПОЛОЖЕНИЕ КИЕВА. И ИМЕННО ЭТА САМОСТОЯТЕЛЬНОСТЬ,
Dialogue: 0,0:06:32.60,0:06:34.84,Caption,,0,0,0,,СУДЯ ПО ПУБЛИЧНОМУ ВОЗРАЖЕНИЮ ЗЕЛЕНСКОГО,
Dialogue: 0,0:06:35.08,0:06:37.40,Caption,,0,0,0,,ВЫЗЫВАЕТ У НЕГО РАЗДРАЖЕНИЕ. ВПРОЧЕМ,
Dialogue: 0,0:06:37.64,0:06:40.36,Caption,,0,0,0,,САМИМ ЕВРОПЕЙЦАМ ТОЖЕ ПРЕДСТОИТ РЕШИТЬ ЗАНЯТНУЮ
Dialogue: 0,0:06:40.36,0:06:43.64,Caption,,0,0,0,,ЗАДАЧУ. ОСОБЕННО ФРАНЦУЗАМ. ИТАЛЬЯНСКАЯ ГАЗЕТА "ИЛЬ
Dialogue: 0,0:06:43.64,0:06:45.80,Caption,,0,0,0,,СОЛЕ ДВАДЦАТЬ ЧЕТЫРЕ ОРЕ" СООБЩИЛА,
Dialogue: 0,0:06:46.04,0:06:48.20,Caption,,0,0,0,,ЧТО ПАРИЖ ДОПУСКАЕТ ПРИНЯТИЕ РОССИЙСКОГО
Dialogue: 0,0:06:48.20,0:06:51.80,Caption,,0,0,0,,ПРИГЛАШЕНИЯ, ЕСЛИ ЕВРОПЕЙЦАМ ОБЕСПЕЧАТ ПОЛНОЦЕННУЮ РОЛЬ В
Dialogue: 0,0:06:51.80,0:06:54.92,Caption,,0,0,0,,ПЕРЕГОВОРНОМ ПРОЦЕССЕ. ПРИ ЭТОМ И ПРИГЛАШЕНИЕ,
Dialogue: 0,0:06:55.08,0:06:57.40,Caption,,0,0,0,,И ФОРМАТ УЧАСТИЯ ЕЩЁ ТРЕБУЕТСЯ ОФИЦИАЛЬНО
Dialogue: 0,0:06:57.40,0:07:00.44,Caption,,0,0,0,,СОГЛАСОВАТЬ. НОРМАЛЬНОЕ ЖЕЛАНИЕ. ЕСЛИ УЖ ЕХАТЬ,
Dialogue: 0,0:07:00.76,0:07:02.76,Caption,,0,0,0,,ТО НЕ ПРОСТО ПОСИДЕТЬ В КРАСИВОМ КАБИНЕТЕ И
Dialogue: 0,0:07:02.76,0:07:05.64,Caption,,0,0,0,,СФОТОГРАФИРОВАТЬСЯ ВОЗЛЕ КРЕМЛЯ. ХОЧЕТСЯ УЧАСТВОВАТЬ
Dialogue: 0,0:07:05.72,0:07:08.52,Caption,,0,0,0,,В ПРИНЯТИИ РЕШЕНИЙ. НО ТУТ ПОЯВЛЯЕТСЯ МАЛЕНЬКАЯ
Dialogue: 0,0:07:08.60,0:07:12.28,Caption,,0,0,0,,ФРАНЦУЗСКАЯ ПОДРОБНОСТЬ, КОТОРАЯ СПОСОБНА ИСПОРТИТЬ ВСЮ ТОРЖЕСТВЕННОСТЬ
Dialogue: 0,0:07:12.28,0:07:17.11,Caption,,0,0,0,,ПОЕЗДКИ. ПАРИЖ ОДНОВРЕМЕННО ВЫСТУПАЕТ ЗА ГАРАНТИИ
Dialogue: 0,0:07:17.11,0:07:19.75,Caption,,0,0,0,,БЕЗОПАСНОСТИ УКРАИНЕ ПО ОБРАЗЦУ ПЯТОЙ СТАТЬИ
Dialogue: 0,0:07:19.75,0:07:22.55,Caption,,0,0,0,,СЕВЕРОАТЛАНТИЧЕСКОГО АЛЬЯНСА. ПРИЧЁМ СОБЕСЕДНИК
Dialogue: 0,0:07:22.55,0:07:27.27,Caption,,0,0,0,,ИТАЛЬЯНСКОГО ИЗДАНИЯ СЧИТАЕТ, ЧТО ТАКИЕ ГАРАНТИИ ФАКТИЧЕСКИ РАВНОЗНАЧНЫ ВСТУПЛЕНИЮ
Dialogue: 0,0:07:27.35,0:07:30.15,Caption,,0,0,0,,УКРАИНЫ В НАТО. А РЯБКОВ КАК РАЗ ПОДЧЁРКИВАЕТ,
Dialogue: 0,0:07:30.31,0:07:33.03,Caption,,0,0,0,,ЧТО МОСКВА ОТВЕРГАЕТ НЕ ТОЛЬКО ПОЛНОЦЕННОЕ ЧЛЕНСТВО
Dialogue: 0,0:07:33.03,0:07:37.27,Caption,,0,0,0,,УКРАИНЫ В АЛЬЯНСЕ, НО И ЛЮБЫЕ ФОРМЫ КВАЗИЧЛЕНСТВА. НУ ПРЕКРАСНО. ТО
Dialogue: 0,0:07:37.35,0:07:39.03,Caption,,0,0,0,,ЕСТЬ СОБИРАЕМСЯ ДОГОВАРИВАТЬСЯ,
Dialogue: 0,0:07:39.35,0:07:41.59,Caption,,0,0,0,,НО ЗАОДНО СНОВА ДОСТАЁМ СТАРУЮ ПАПКУ,
Dialogue: 0,0:07:41.81,0:07:44.47,Caption,,0,0,0,,КОТОРУЮ УЖЕ СТОЛЬКО РАЗ КЛАЛИ НА СТОЛ. СЕЙЧАС
Dialogue: 0,0:07:44.47,0:07:47.03,Caption,,0,0,0,,ПОЛОЖИМ ЕЩЁ РАЗ, И МОСКВА, КОНЕЧНО,
Dialogue: 0,0:07:47.16,0:07:50.47,Caption,,0,0,0,,СРАЗУ СОГЛАСИТСЯ. ТЫ ЕЙ ГОВОРИШЬ "НЕТ". ОНА СМОТРИТ
Dialogue: 0,0:07:50.47,0:07:52.71,Caption,,0,0,0,,НА ТЕБЯ И СНОВА ПРЕДЛАГАЕТ ТО ЖЕ САМОЕ.
Dialogue: 0,0:07:52.95,0:07:55.59,Caption,,0,0,0,,ЕЩЁ РАЗ ГОВОРИШЬ "НЕТ". ОНА МЕНЯЕТ ОБЛОЖКУ У
Dialogue: 0,0:07:55.59,0:07:58.31,Caption,,0,0,0,,ПАПКИ, ПРИНОСИТ ЕЁ ОБРАТНО И ОБЪЯСНЯЕТ,
Dialogue: 0,0:07:58.55,0:08:01.43,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ВСЁ ДОЛЖНО ПОЛУЧИТЬСЯ. ТАКОЕ ВПЕЧАТЛЕНИЕ,
Dialogue: 0,0:08:01.69,0:08:04.23,Caption,,0,0,0,,ЧТО СЛОВО "НЕТ" ТАМ ПРОСТО НЕ ПОНИМАЮТ. И
Dialogue: 0,0:08:04.23,0:08:08.55,Caption,,0,0,0,,ВЕДЬ РЕЧЬ ЗДЕСЬ НЕ О ТОМ, КАК КРАСИВО НАЗВАТЬ ГАРАНТИИ. ДЛЯ МОСКВЫ ВОПРОС
Dialogue: 0,0:08:08.55,0:08:12.39,Caption,,0,0,0,,СОСТОИТ В ТОМ, КАКИЕ ОБЯЗАТЕЛЬСТВА ВОЗЬМУТ НА СЕБЯ ГОСУДАРСТВА НАТО
Dialogue: 0,0:08:12.39,0:08:15.19,Caption,,0,0,0,,И БУДЕТ ЛИ УКРАИНА ФАКТИЧЕСКИ ВСТРОЕНА В ВОЕННУЮ
Dialogue: 0,0:08:15.19,0:08:17.43,Caption,,0,0,0,,СИСТЕМУ АЛЬЯНСА. А ДЛЯ ПАРИЖА,
Dialogue: 0,0:08:17.51,0:08:20.87,Caption,,0,0,0,,СУДЯ ПО ПРЕДЛОЖЕНИЮ, ВАЖНО ОБЕСПЕЧИТЬ КИЕВУ ГАРАНТИИ,
Dialogue: 0,0:08:21.11,0:08:22.79,Caption,,0,0,0,,БЛИЗКИЕ ПО СМЫСЛУ К НАТОВСКИМ.
Dialogue: 0,0:08:25.07,0:08:27.39,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО МЕНЯТЬ НАЗВАНИЕ ДОКУМЕНТА,
Dialogue: 0,0:08:27.78,0:08:30.67,Caption,,0,0,0,,НО СОДЕРЖАНИЕ ОТ ЭТОГО НИКУДА НЕ ДЕНЕТСЯ. ПРАВДА,
Dialogue: 0,0:08:30.81,0:08:33.23,Caption,,0,0,0,,ПОВТОРЯТЬ ВСЮ ИСТОРИЮ ОТНОШЕНИЙ РОССИИ И НАТО МЫ
Dialogue: 0,0:08:33.31,0:08:36.03,Caption,,0,0,0,,НЕ БУДЕМ. ВЫ ЕЁ ПРЕКРАСНО ЗНАЕТЕ. ЗДЕСЬ ВАЖНА
Dialogue: 0,0:08:36.03,0:08:39.39,Caption,,0,0,0,,ИМЕННО НЫНЕШНЯЯ НЕСОСТЫКОВКА. ЕВРОПЕЙЦЫ ОБСУЖДАЮТ
Dialogue: 0,0:08:39.47,0:08:43.31,Caption,,0,0,0,,ПОЕЗДКУ В МОСКВУ, НО ОДИН ИЗ ПРЕДЛАГАЕМЫХ ИМИ ВАРИАНТОВ БЕЗОПАСНОСТИ
Dialogue: 0,0:08:43.31,0:08:46.43,Caption,,0,0,0,,ЗАРАНЕЕ УПИРАЕТСЯ В РОССИЙСКИЙ ОТКАЗ. КАЗАЛОСЬ БЫ,
Dialogue: 0,0:08:46.59,0:08:48.67,Caption,,0,0,0,,НА ЭТОМ И МОЖНО БЫЛО БЫ ЗАКОНЧИТЬ РАЗГОВОР.
Dialogue: 0,0:08:48.91,0:08:51.55,Caption,,0,0,0,,УСЛОВИЯ НЕСОВМЕСТИМЫ, ЗЕЛЕНСКИЙ ВОЗРАЖАЕТ,
Dialogue: 0,0:08:51.64,0:08:54.03,Caption,,0,0,0,,ПРИГЛАШЕНИЕ ЕЩЁ НЕ ПРИНЯТО. ОЧЕРЕДНОЙ
Dialogue: 0,0:08:54.03,0:08:56.99,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКИЙ ТУПИК. НО ЕСТЬ ОДНА ПОДРОБНОСТЬ,
Dialogue: 0,0:08:57.07,0:08:59.55,Caption,,0,0,0,,КОТОРАЯ ЗАСТАВЛЯЕТ ПОСМОТРЕТЬ НА ВСЮ ЭТУ ПОЕЗДКУ
Dialogue: 0,0:08:59.55,0:09:02.03,Caption,,0,0,0,,СОВСЕМ С ДРУГОЙ СТОРОНЫ. А ЧТО,
Dialogue: 0,0:09:02.11,0:09:04.99,Caption,,0,0,0,,ЕСЛИ ЕВРОПЕЙЦЕВ В МОСКВУ ПОТЯНУЛО ВОВСЕ НЕ ИЗ
Dialogue: 0,0:09:05.07,0:09:07.31,Caption,,0,0,0,,ЗА ВНЕЗАПНОГО ЖЕЛАНИЯ ДОГОВОРИТЬСЯ ПО УКРАИНЕ?
Dialogue: 0,0:09:07.59,0:09:10.43,Caption,,0,0,0,,ЕСТЬ КУДА БОЛЕЕ НЕПРИЯТНАЯ ДЛЯ ЕВРОПЕЙСКИХ СТОЛИЦ
Dialogue: 0,0:09:10.43,0:09:13.07,Caption,,0,0,0,,ВЕРСИЯ. РОССИЙСКИЙ ОТВЕТ НА УКРАИНСКИЕ УДАРЫ,
Dialogue: 0,0:09:13.31,0:09:16.99,Caption,,0,0,0,,СОГЛАСНО ЭТОЙ ВЕРСИИ, УЖЕ ДАВНО ОБСУЖДАЕТСЯ НЕ ТОЛЬКО ПРИМЕНИТЕЛЬНО К
Dialogue: 0,0:09:16.99,0:09:19.79,Caption,,0,0,0,,ОБЪЕКТАМ НА ТЕРРИТОРИИ УКРАИНЫ. РАССМАТРИВАЕТСЯ И
Dialogue: 0,0:09:19.79,0:09:22.35,Caption,,0,0,0,,СОВЕРШЕННО ДРУГОЙ УРОВЕНЬ ОТВЕТА ВОЕННЫЕ
Dialogue: 0,0:09:22.35,0:09:24.99,Caption,,0,0,0,,ПРОИЗВОДСТВЕННЫЕ ПЛОЩАДКИ НЕПОСРЕДСТВЕННО В ЕВРОПЕ.
Dialogue: 0,0:09:25.45,0:09:29.79,Caption,,0,0,0,,ВОТ ЗДЕСЬ, СОГЛАСИТЕСЬ, РАЗГОВОР ПРИОБРЕТАЕТ ИНОЙ ХАРАКТЕР. ОДНО ДЕЛО
Dialogue: 0,0:09:29.79,0:09:32.03,Caption,,0,0,0,,ПРИНИМАТЬ РЕШЕНИЯ О ПОСТАВКАХ ВООРУЖЕНИЙ,
Dialogue: 0,0:09:32.27,0:09:34.75,Caption,,0,0,0,,НАХОДЯСЬ ЗА СОТНИ И ТЫСЯЧИ КИЛОМЕТРОВ ОТ РАЙОНА
Dialogue: 0,0:09:34.75,0:09:39.02,Caption,,0,0,0,,БОЕВЫХ ДЕЙСТВИЙ. ОТПРАВЛЯТЬ ТЕХНИКУ,
Dialogue: 0,0:09:39.18,0:09:43.90,Caption,,0,0,0,,ОБСУЖДАТЬ ФИНАНСИРОВАНИЕ, ОБЕЩАТЬ НОВЫЕ ПАРТИИ БОЕПРИПАСОВ. И СОВСЕМ ДРУГОЕ
Dialogue: 0,0:09:43.90,0:09:46.94,Caption,,0,0,0,,ДЕЛО, ЕСЛИ ОБЪЕКТОМ ВОЗМОЖНОГО РОССИЙСКОГО ОТВЕТА
Dialogue: 0,0:09:46.94,0:09:49.50,Caption,,0,0,0,,СТАНОВИТСЯ ВОЕННОЕ ПРЕДПРИЯТИЕ УЖЕ НА СОБСТВЕННОЙ
Dialogue: 0,0:09:49.50,0:09:52.30,Caption,,0,0,0,,ТЕРРИТОРИИ. ТОГДА ВОПРОС СТОИТ НЕ ТОЛЬКО О ТОМ,
Dialogue: 0,0:09:52.54,0:09:55.50,Caption,,0,0,0,,СКОЛЬКО ВООРУЖЕНИЙ МОЖНО ПЕРЕДАТЬ КИЕВУ. ВОЗНИКАЕТ
Dialogue: 0,0:09:55.58,0:09:57.74,Caption,,0,0,0,,КУДА БОЛЕЕ НЕПРИЯТНАЯ ПРОБЛЕМА ЧТО БУДЕТ,
Dialogue: 0,0:09:58.04,0:10:00.54,Caption,,0,0,0,,ЕСЛИ КОНФЛИКТ ВЫЙДЕТ ЗА УКРАИНСКИЕ ГРАНИЦЫ И
Dialogue: 0,0:10:00.54,0:10:03.82,Caption,,0,0,0,,ЗАТРОНЕТ САМИ СТРАНЫ, УЧАСТВУЮЩИЕ В ЭТИХ ПОСТАВКАХ?
Dialogue: 0,0:10:04.08,0:10:06.54,Caption,,0,0,0,,ПРИЧЁМ ДЛЯ ЕВРОПЕЙСКИХ ПРАВИТЕЛЬСТВ ЭТО УЖЕ НЕ ТА
Dialogue: 0,0:10:06.54,0:10:09.74,Caption,,0,0,0,,ИСТОРИЯ, КОТОРУЮ МОЖНО ПОЛНОСТЬЮ ОСТАВИТЬ НА УСМОТРЕНИЕ
Dialogue: 0,0:10:09.74,0:10:12.38,Caption,,0,0,0,,УКРАИНСКОГО КОМАНДОВАНИЯ. ЛЮБОЙ УДАР ПО ТЕРРИТОРИИ
Dialogue: 0,0:10:12.38,0:10:15.50,Caption,,0,0,0,,ГОСУДАРСТВА НАТО СПОСОБЕН ЗАПУСТИТЬ ПОЛИТИЧЕСКУЮ И
Dialogue: 0,0:10:15.50,0:10:17.82,Caption,,0,0,0,,ВОЕННУЮ ЦЕПНУЮ РЕАКЦИЮ С ПОСЛЕДСТВИЯМИ,
Dialogue: 0,0:10:18.14,0:10:21.26,Caption,,0,0,0,,КОТОРЫЕ НИКТО НЕ СМОЖЕТ ЗАРАНЕЕ ТОЧНО РАСПИСАТЬ. ВОТ
Dialogue: 0,0:10:21.26,0:10:23.74,Caption,,0,0,0,,ПОЧЕМУ К ЭТОЙ ВЕРСИИ СТОИТ ПРИСМОТРЕТЬСЯ ОСОБЕННО
Dialogue: 0,0:10:23.74,0:10:26.22,Caption,,0,0,0,,ВНИМАТЕЛЬНО. НО В НЕЙ ЕСТЬ ЕЩЁ ОДНА ДЕТАЛЬ.
Dialogue: 0,0:10:26.54,0:10:30.38,Caption,,0,0,0,,ДАЖЕ БОЛЕЕ ИНТЕРЕСНАЯ, ЧЕМ ПРЕДПОЛАГАЕМЫЕ ЦЕЛИ РОССИЙСКОГО ОТВЕТА.
Dialogue: 0,0:10:30.76,0:10:34.06,Caption,,0,0,0,,СООБЩАЕТСЯ, ЧТО ПРОТИВ РАСШИРЕНИЯ КОНФЛИКТА НА ЕВРОПЕЙСКУЮ
Dialogue: 0,0:10:34.06,0:10:36.30,Caption,,0,0,0,,ТЕРРИТОРИЮ РЕЗКО ВЫСТУПАЛИ НЕ ТОЛЬКО ТЕ,
Dialogue: 0,0:10:36.49,0:10:38.94,Caption,,0,0,0,,КТО НЕПОСРЕДСТВЕННО РИСКУЕТ ОКАЗАТЬСЯ ПОД УДАРОМ.
Dialogue: 0,0:10:39.27,0:10:41.98,Caption,,0,0,0,,БОЛЬШУЮ РОЛЬ ИГРАЛА ПОЗИЦИЯ СОЕДИНЁННЫХ ШТАТОВ И
Dialogue: 0,0:10:41.98,0:10:44.78,Caption,,0,0,0,,КИТАЯ. ОБРАТИТЕ ВНИМАНИЕ НА ЭТУ КОМБИНАЦИЮ.
Dialogue: 0,0:10:47.04,0:10:49.76,Caption,,0,0,0,,АМЕРИКА ЯВЛЯЕТСЯ ГЛАВНЫМ СОЮЗНИКОМ ЕВРОПЕЙСКИХ
Dialogue: 0,0:10:49.76,0:10:52.64,Caption,,0,0,0,,ГОСУДАРСТВ ПО НАТО. КИТАЙ В ЭТОТ ВОЕННЫЙ СОЮЗ
Dialogue: 0,0:10:52.72,0:10:55.20,Caption,,0,0,0,,НЕ ВХОДИТ И ВЫСТУПАЕТ СОВЕРШЕННО САМОСТОЯТЕЛЬНЫМ
Dialogue: 0,0:10:55.20,0:10:58.48,Caption,,0,0,0,,МИРОВЫМ ИГРОКОМ. У НИХ РАЗНЫЕ ОТНОШЕНИЯ С РОССИЕЙ,
Dialogue: 0,0:10:58.69,0:11:01.44,Caption,,0,0,0,,РАЗНЫЕ ИНТЕРЕСЫ И СОВЕРШЕННО РАЗНОЕ ПОЛОЖЕНИЕ В
Dialogue: 0,0:11:01.44,0:11:04.24,Caption,,0,0,0,,НЫНЕШНЕМ ПРОТИВОСТОЯНИИ. НО В ОДНОМ ВОПРОСЕ,
Dialogue: 0,0:11:04.46,0:11:06.40,Caption,,0,0,0,,СОГЛАСНО ЭТОЙ АНАЛИТИЧЕСКОЙ ВЕРСИИ,
Dialogue: 0,0:11:06.67,0:11:09.60,Caption,,0,0,0,,ИХ ИНТЕРЕСЫ СХОДИЛИСЬ. ОНИ БЫЛИ ПРОТИВ РОССИЙСКОГО
Dialogue: 0,0:11:09.60,0:11:12.64,Caption,,0,0,0,,ОТВЕТА НЕПОСРЕДСТВЕННО ПО ЕВРОПЕЙСКИМ ПЛОЩАДКАМ. И
Dialogue: 0,0:11:12.72,0:11:16.64,Caption,,0,0,0,,ТОГДА ПОЛУЧАЕТСЯ, ЧТО ВОЗМОЖНЫЙ ОТВЕТ МОСКВЫ ОГРАНИЧИВАЕТСЯ НЕ ТОЛЬКО
Dialogue: 0,0:11:16.72,0:11:19.44,Caption,,0,0,0,,ЕЁ СОБСТВЕННЫМИ ВОЕННЫМИ РАСЧЁТАМИ. ПРИХОДИТСЯ
Dialogue: 0,0:11:19.52,0:11:21.68,Caption,,0,0,0,,УЧИТЫВАТЬ, ЧТО СКАЖУТ ДВЕ ДЕРЖАВЫ,
Dialogue: 0,0:11:21.91,0:11:24.32,Caption,,0,0,0,,С КОТОРЫМИ РОССИЯ ВЕДЁТ ОТДЕЛЬНЫЕ ПЕРЕГОВОРЫ.
Dialogue: 0,0:11:24.96,0:11:27.12,Caption,,0,0,0,,А ТЕПЕРЬ ВСПОМНИМ ОДНУ ДЕТАЛЬ ИЗ СОБЫТИЙ ВОКРУГ
Dialogue: 0,0:11:27.12,0:11:31.36,Caption,,0,0,0,,ВСТРЕЧИ ПУТИНА, ТРАМПА И СИ ЦЗИНЬПИНА В ШЭНЬЧЖЭНЕ. НАКАНУНЕ ЭТОЙ
Dialogue: 0,0:11:31.36,0:11:33.68,Caption,,0,0,0,,ВСТРЕЧИ БЫЛ НАНЕСЁН ОЧЕРЕДНОЙ УДАР ПО КРЫМСКОМУ
Dialogue: 0,0:11:33.76,0:11:36.16,Caption,,0,0,0,,МОСТУ. И ЗДЕСЬ ПОЯВЛЯЕТСЯ ВЕСЬМА ИНТЕРЕСНАЯ
Dialogue: 0,0:11:36.16,0:11:38.64,Caption,,0,0,0,,ТРАКТОВКА ЭТОТ УДАР, КАК ПРЕДПОЛАГАЕТСЯ,
Dialogue: 0,0:11:39.04,0:11:41.04,Caption,,0,0,0,,УДАЛОСЬ ПРЕДСТАВИТЬ НЕ ПРОСТО КАК ОЧЕРЕДНУЮ
Dialogue: 0,0:11:41.12,0:11:43.04,Caption,,0,0,0,,УКРАИНСКУЮ АТАКУ НА РОССИЙСКИЙ ОБЪЕКТ,
Dialogue: 0,0:11:43.28,0:11:46.08,Caption,,0,0,0,,А КАК ЛИЧНОЕ ПОЛИТИЧЕСКОЕ ОСКОРБЛЕНИЕ ТРАМПА И СИ
Dialogue: 0,0:11:46.08,0:11:49.12,Caption,,0,0,0,,ЦЗИНЬПИНА. ВОТ ЭТО УЖЕ СОВСЕМ ДРУГОЙ РАСЧЁТ. ЕСЛИ
Dialogue: 0,0:11:49.12,0:11:51.92,Caption,,0,0,0,,ДВЕ ДЕРЖАВЫ ВЫСТУПАЮТ ПРОТИВ РАСШИРЕНИЯ КОНФЛИКТА,
Dialogue: 0,0:11:52.32,0:11:55.20,Caption,,0,0,0,,ОДНО ДЕЛО УБЕЖДАТЬ ИХ ОБЫЧНЫМИ ВОЕННЫМИ АРГУМЕНТАМИ.
Dialogue: 0,0:11:57.47,0:11:59.79,Caption,,0,0,0,,И СОВСЕМ ДРУГОЕ, ЕСЛИ ВОЗНИКАЕТ ВОПРОС,
Dialogue: 0,0:12:00.11,0:12:02.35,Caption,,0,0,0,,НЕ ПЫТАЕТСЯ ЛИ КТО ТО СВОИМИ ДЕЙСТВИЯМИ
Dialogue: 0,0:12:02.35,0:12:05.23,Caption,,0,0,0,,ДЕМОНСТРАТИВНО ПОДРЫВАТЬ ДОГОВОРЁННОСТИ И САМУ
Dialogue: 0,0:12:05.23,0:12:07.95,Caption,,0,0,0,,АТМОСФЕРУ ПЕРЕГОВОРОВ МЕЖДУ КРУПНЕЙШИМИ МИРОВЫМИ
Dialogue: 0,0:12:07.95,0:12:11.23,Caption,,0,0,0,,ЛИДЕРАМИ. ПОСЛЕ УДАРА ПО КРЫМСКОМУ МОСТУ РИСК
Dialogue: 0,0:12:11.23,0:12:13.47,Caption,,0,0,0,,РОССИЙСКОГО ОТВЕТА ПО ВОЕННЫМ ПРОИЗВОДСТВАМ В
Dialogue: 0,0:12:13.47,0:12:18.35,Caption,,0,0,0,,ЕВРОСОЮЗЕ, ПО ЭТОЙ ВЕРСИИ, РЕЗКО ВЫРОС. ВАШИНГТОН И ПЕКИН ПРЕЖДЕ РЕЗКО
Dialogue: 0,0:12:18.35,0:12:21.39,Caption,,0,0,0,,ВОЗРАЖАЛИ ПРОТИВ ТАКОГО РАСШИРЕНИЯ КОНФЛИКТА. НО
Dialogue: 0,0:12:21.39,0:12:23.95,Caption,,0,0,0,,ЕСЛИ АТАКУ ПРЕДСТАВИЛИ ТРАМПУ И СИ КАК ЛИЧНОЕ
Dialogue: 0,0:12:23.95,0:12:27.95,Caption,,0,0,0,,ОСКОРБЛЕНИЕ, ПРЕЖНИЙ ОГРАНИЧИТЕЛЬ МОГ ОСЛАБНУТЬ. ВОТ ПОЧЕМУ
Dialogue: 0,0:12:27.95,0:12:30.43,Caption,,0,0,0,,ЕВРОПЕЙЦАМ МОГ ПОНАДОБИТЬСЯ СОБСТВЕННЫЙ РАЗГОВОР С
Dialogue: 0,0:12:30.43,0:12:33.31,Caption,,0,0,0,,МОСКВОЙ. КОГДА РЕЧЬ ЗАХОДИТ О ВОЗМОЖНОМ УДАРЕ УЖЕ
Dialogue: 0,0:12:33.39,0:12:36.75,Caption,,0,0,0,,ПО ИХ ТЕРРИТОРИИ, ЕВРОПЕЙСКИМ ПРАВИТЕЛЬСТВАМ ПРИХОДИТСЯ ДУМАТЬ НЕ
Dialogue: 0,0:12:36.75,0:12:40.67,Caption,,0,0,0,,ТОЛЬКО ОБ УКРАИНЕ, НО И О БЕЗОПАСНОСТИ СОБСТВЕННЫХ СТРАН. И ВОТ
Dialogue: 0,0:12:40.75,0:12:42.99,Caption,,0,0,0,,ПОСЛЕ ЭТОГО СОВСЕМ ИНАЧЕ ЗВУЧИТ ВОПРОС,
Dialogue: 0,0:12:43.23,0:12:45.95,Caption,,0,0,0,,ПОЧЕМУ ПРЕДСТАВИТЕЛИ КОАЛИЦИИ ЖЕЛАЮЩИХ НАЧАЛИ
Dialogue: 0,0:12:45.95,0:12:49.55,Caption,,0,0,0,,ОБСУЖДАТЬ ПОЕЗДКУ В МОСКВУ. ДО СИХ ПОР НАМ ОБЪЯСНЯЛИ,
Dialogue: 0,0:12:49.71,0:12:52.27,Caption,,0,0,0,,ЧТО ЕВРОПЕЙЦЫ СТРЕМЯТСЯ УЧАСТВОВАТЬ В ПЕРЕГОВОРАХ ПО
Dialogue: 0,0:12:52.27,0:12:55.31,Caption,,0,0,0,,УКРАИНЕ И ХОТЯТ ПОЛУЧИТЬ ПОЛНОЦЕННОЕ МЕСТО В ЭТОМ
Dialogue: 0,0:12:55.31,0:12:58.99,Caption,,0,0,0,,ПРОЦЕССЕ. ХОРОШО. ЭТО ОДНА СТОРОНА ИСТОРИИ. НО ЕСЛИ
Dialogue: 0,0:12:58.99,0:13:01.47,Caption,,0,0,0,,РЯДОМ ПОСТАВИТЬ РАЗГОВОРЫ О ВОЗМОЖНОМ РОССИЙСКОМ
Dialogue: 0,0:13:01.47,0:13:03.79,Caption,,0,0,0,,ОТВЕТЕ ПО ЕВРОПЕЙСКИМ ВОЕННЫМ ПРОИЗВОДСТВАМ,
Dialogue: 0,0:13:04.03,0:13:06.67,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ И ДРУГАЯ ПРИЧИНА ДЛЯ ПРЯМОГО КОНТАКТА.
Dialogue: 0,0:13:08.94,0:13:11.50,Caption,,0,0,0,,В ЭТОМ СЛУЧАЕ МОСКВА НУЖНА ЕВРОПЕЙЦАМ НЕ ТОЛЬКО
Dialogue: 0,0:13:11.50,0:13:15.90,Caption,,0,0,0,,ДЛЯ ОБСУЖДЕНИЯ ТОГО, ЧТО ПРОИЗОЙДЁТ НА УКРАИНЕ. ИМ НЕОБХОДИМО ПОНЯТЬ,
Dialogue: 0,0:13:16.06,0:13:19.10,Caption,,0,0,0,,ГДЕ ПРОХОДЯТ ГРАНИЦЫ ВОЗМОЖНОГО ПРОТИВОСТОЯНИЯ УЖЕ
Dialogue: 0,0:13:19.10,0:13:22.70,Caption,,0,0,0,,МЕЖДУ РОССИЕЙ И САМИМИ ЕВРОПЕЙСКИМИ ГОСУДАРСТВАМИ. И
Dialogue: 0,0:13:22.78,0:13:26.22,Caption,,0,0,0,,ОБРАТИТЕ ВНИМАНИЕ, НАСКОЛЬКО ИНАЧЕ ТОГДА ВОСПРИНИМАЮТСЯ СЛОВА
Dialogue: 0,0:13:26.22,0:13:29.50,Caption,,0,0,0,,ПИСТОРИУСА. ОТКАЗЫВАТЬСЯ ОТ ПРИГЛАШЕНИЯ БЫЛО БЫ
Dialogue: 0,0:13:29.58,0:13:31.74,Caption,,0,0,0,,НЕПРАВИЛЬНЫМ СИГНАЛОМ. ТОЛЬКО ТОТ,
Dialogue: 0,0:13:31.88,0:13:34.54,Caption,,0,0,0,,КТО РАЗГОВАРИВАЕТ, СПОСОБЕН ДОБИТЬСЯ РЕЗУЛЬТАТА.
Dialogue: 0,0:13:35.10,0:13:37.58,Caption,,0,0,0,,В ОБЫЧНОЙ ДИПЛОМАТИЧЕСКОЙ ЗАМЕТКЕ ЭТИ СЛОВА ЗВУЧАТ
Dialogue: 0,0:13:37.58,0:13:40.94,Caption,,0,0,0,,ПОЧТИ СКУЧНО. ОЧЕРЕДНОЙ МИНИСТР ПРИЗЫВАЕТ К ДИАЛОГУ.
Dialogue: 0,0:13:41.10,0:13:44.86,Caption,,0,0,0,,НУ И ЧТО? НО КОГДА РЯДОМ ПОЯВЛЯЕТСЯ РИСК ПРЯМОГО СТОЛКНОВЕНИЯ,
Dialogue: 0,0:13:44.94,0:13:48.14,Caption,,0,0,0,,СМЫСЛ РАЗГОВОРА МЕНЯЕТСЯ. МИНИСТР ОБОРОНЫ ГЕРМАНИИ
Dialogue: 0,0:13:48.14,0:13:50.86,Caption,,0,0,0,,ГОВОРИТ О НЕОБХОДИМОСТИ ПРЯМОГО КОНТАКТА С РОССИЕЙ В
Dialogue: 0,0:13:50.86,0:13:54.06,Caption,,0,0,0,,МОМЕНТ, КОГДА ЕВРОПЕЙСКИЕ СТРАНЫ ПРОДОЛЖАЮТ УЧАСТВОВАТЬ В
Dialogue: 0,0:13:54.06,0:13:57.02,Caption,,0,0,0,,ВОЕННОЙ ПОДДЕРЖКЕ УКРАИНЫ И ОБСУЖДАЮТ СОБСТВЕННЫЕ
Dialogue: 0,0:13:57.02,0:13:59.98,Caption,,0,0,0,,ГАРАНТИИ БЕЗОПАСНОСТИ. ИМЕННО ПОЭТОМУ ЗДЕСЬ ВАЖНО НЕ
Dialogue: 0,0:14:00.06,0:14:03.10,Caption,,0,0,0,,ПУТАТЬ ДВА ВОПРОСА. ПЕРВЫЙ НА КАКИХ УСЛОВИЯХ СТОРОНЫ
Dialogue: 0,0:14:03.18,0:14:04.62,Caption,,0,0,0,,МОГУТ ДОГОВОРИТЬСЯ ОБ УКРАИНЕ?
Dialogue: 0,0:14:04.84,0:14:09.10,Caption,,0,0,0,,ВТОРОЙ КАК НЕ ДОПУСТИТЬ, ЧТОБЫ КОНФЛИКТ РОССИИ С УКРАИНОЙ ПРЕВРАТИЛСЯ В
Dialogue: 0,0:14:09.10,0:14:11.90,Caption,,0,0,0,,ПРЯМОЕ ВОЕННОЕ СТОЛКНОВЕНИЕ РОССИИ С ЕВРОПЕЙСКИМИ
Dialogue: 0,0:14:11.90,0:14:14.78,Caption,,0,0,0,,ГОСУДАРСТВАМИ? НА ПЕРВЫЙ ВОПРОС У ПАРИЖА,
Dialogue: 0,0:14:14.86,0:14:18.06,Caption,,0,0,0,,МОСКВЫ И КИЕВА ПО ПРЕЖНЕМУ ОЧЕНЬ РАЗНЫЕ ОТВЕТЫ.
Dialogue: 0,0:14:18.46,0:14:20.46,Caption,,0,0,0,,ДОСТАТОЧНО ВСПОМНИТЬ ИСТОРИЮ С НАТОВСКИМИ
Dialogue: 0,0:14:20.46,0:14:25.47,Caption,,0,0,0,,ГАРАНТИЯМИ. НО ВТОРОЙ ВОПРОС МОЖЕТ ОКАЗАТЬСЯ НАСТОЛЬКО
Dialogue: 0,0:14:25.47,0:14:29.07,Caption,,0,0,0,,СЕРЬЁЗНЫМ, ЧТО ДАЖЕ ПРИ ПОЛНОМ ОТСУТСТВИИ СОГЛАСИЯ ПО ПЕРВОМУ
Dialogue: 0,0:14:29.15,0:14:31.95,Caption,,0,0,0,,РАЗГОВАРИВАТЬ ВСЁ РАВНО ПРИДЁТСЯ. ПОДПИСЫВАЙТЕСЬ НА
Dialogue: 0,0:14:32.03,0:14:35.63,Caption,,0,0,0,,КАНАЛ, ЕСЛИ ВАМ ИНТЕРЕСНЫ ИМЕННО ТАКИЕ СВЯЗИ. ПОТОМУ ЧТО
Dialogue: 0,0:14:35.63,0:14:38.51,Caption,,0,0,0,,САМЫЕ ВАЖНЫЕ РЕШЕНИЯ ДАЛЕКО НЕ ВСЕГДА НАЧИНАЮТСЯ С
Dialogue: 0,0:14:38.51,0:14:41.39,Caption,,0,0,0,,ГРОМКИХ ЗАЯВЛЕНИЙ. ИНОГДА ВСЁ НАЧИНАЕТСЯ С ТОГО,
Dialogue: 0,0:14:41.55,0:14:44.43,Caption,,0,0,0,,ЧТО ПОЛИТИКИ ВДРУГ ПЕРЕСТАЮТ СПОРИТЬ О САМОМ ПРАВЕ
Dialogue: 0,0:14:44.43,0:14:47.31,Caption,,0,0,0,,ПОГОВОРИТЬ. А ТЕПЕРЬ ВЕРНЁМСЯ К ЗЕЛЕНСКОМУ. ЕСЛИ
Dialogue: 0,0:14:47.31,0:14:49.63,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ПРЕДСТАВИТЕЛИ СОБИРАЮТСЯ В МОСКВУ
Dialogue: 0,0:14:49.63,0:14:51.87,Caption,,0,0,0,,ИСКЛЮЧИТЕЛЬНО РАДИ ОБСУЖДЕНИЯ УКРАИНСКОГО
Dialogue: 0,0:14:51.87,0:14:55.47,Caption,,0,0,0,,УРЕГУЛИРОВАНИЯ, ЕГО ВОЗРАЖЕНИЯ ЕЩЁ МОЖНО ОБЪЯСНЯТЬ ЖЕЛАНИЕМ
Dialogue: 0,0:14:55.47,0:15:00.35,Caption,,0,0,0,,УЧАСТВОВАТЬ ВО ВСЕХ РЕШЕНИЯХ, ЗАТРАГИВАЮЩИХ УКРАИНУ. НО ЕСЛИ ЧАСТЬ ВОПРОСОВ
Dialogue: 0,0:15:00.43,0:15:02.67,Caption,,0,0,0,,КАСАЕТСЯ БЕЗОПАСНОСТИ САМИХ ФРАНЦИИ,
Dialogue: 0,0:15:02.91,0:15:07.87,Caption,,0,0,0,,ГЕРМАНИИ И ВЕЛИКОБРИТАНИИ, ВОЗНИКАЕТ СОВСЕМ ДРУГАЯ СИТУАЦИЯ. РАЗВЕ БЕРЛИН
Dialogue: 0,0:15:07.87,0:15:09.87,Caption,,0,0,0,,ДОЛЖЕН СПРАШИВАТЬ РАЗРЕШЕНИЯ У КИЕВА,
Dialogue: 0,0:15:10.11,0:15:12.59,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ОБСУЖДАТЬ С МОСКВОЙ УГРОЗЫ СОБСТВЕННОЙ
Dialogue: 0,0:15:12.59,0:15:16.35,Caption,,0,0,0,,БЕЗОПАСНОСТИ? РАЗВЕ ПАРИЖУ ТРЕБУЕТСЯ СОГЛАСИЕ ЗЕЛЕНСКОГО,
Dialogue: 0,0:15:16.51,0:15:20.83,Caption,,0,0,0,,ЧТОБЫ ВЫЯСНИТЬ, КАКИЕ ДЕЙСТВИЯ РОССИЯ СОЧТЁТ ПРЯМЫМ УЧАСТИЕМ ФРАНЦИИ
Dialogue: 0,0:15:20.83,0:15:22.99,Caption,,0,0,0,,В КОНФЛИКТЕ? И КТО ВООБЩЕ РЕШИЛ,
Dialogue: 0,0:15:23.15,0:15:25.79,Caption,,0,0,0,,ЧТО УКРАИНСКОЕ РУКОВОДСТВО ВПРАВЕ ЗАПРЕЩАТЬ ДРУГИМ
Dialogue: 0,0:15:25.79,0:15:28.35,Caption,,0,0,0,,ГОСУДАРСТВАМ ВЕСТИ РАЗГОВОР О РИСКАХ ДЛЯ ИХ
Dialogue: 0,0:15:28.35,0:15:32.19,Caption,,0,0,0,,СОБСТВЕННЫХ ТЕРРИТОРИЙ? ВОТ ТУТ И НАЧИНАЕТСЯ НАСТОЯЩАЯ ПОЛИТИЧЕСКАЯ
Dialogue: 0,0:15:32.19,0:15:36.96,Caption,,0,0,0,,НЕПРИЯТНОСТЬ. МОЖНО БЫТЬ СОЮЗНИКОМ УКРАИНЫ,
Dialogue: 0,0:15:37.05,0:15:41.52,Caption,,0,0,0,,ПРЕДОСТАВЛЯТЬ ЕЙ ПОМОЩЬ, ВЫСТУПАТЬ ЗА ЕЁ БЕЗОПАСНОСТЬ. НО ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:15:41.66,0:15:44.00,Caption,,0,0,0,,ЧТО У УКРАИНСКОГО ПРЕЗИДЕНТА ПОЯВЛЯЕТСЯ ПРАВО
Dialogue: 0,0:15:44.00,0:15:46.32,Caption,,0,0,0,,РАСПОРЯЖАТЬСЯ ВНЕШНЕЙ ПОЛИТИКОЙ ЕВРОПЕЙСКИХ
Dialogue: 0,0:15:46.32,0:15:49.04,Caption,,0,0,0,,ГОСУДАРСТВ. А ЕСЛИ ЗЕЛЕНСКИЙ ПЫТАЕТСЯ ЭТОМУ
Dialogue: 0,0:15:49.04,0:15:52.40,Caption,,0,0,0,,ПРЕПЯТСТВОВАТЬ, ЕВРОПЕЙСКИМ ЛИДЕРАМ РАНО ИЛИ ПОЗДНО ПРИДЁТСЯ
Dialogue: 0,0:15:52.40,0:15:55.60,Caption,,0,0,0,,ВЫБИРАТЬ, НАСКОЛЬКО ДАЛЕКО ОНИ ГОТОВЫ ЗАЙТИ В ВОПРОСЕ
Dialogue: 0,0:15:55.60,0:15:58.16,Caption,,0,0,0,,СОБСТВЕННОЙ САМОСТОЯТЕЛЬНОСТИ. ПРИЧЁМ ОБРАТИТЕ
Dialogue: 0,0:15:58.24,0:16:00.96,Caption,,0,0,0,,ВНИМАНИЕ НА ПОСЛЕДОВАТЕЛЬНОСТЬ СОБЫТИЙ. ТРАМП
Dialogue: 0,0:16:00.96,0:16:03.52,Caption,,0,0,0,,РЕКОМЕНДУЕТ СВЯЗАТЬСЯ С ПУТИНЫМ. ЕВРОПЕЙСКИЕ
Dialogue: 0,0:16:03.52,0:16:05.68,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ ОБСУЖДАЮТ ТАКУЮ ВОЗМОЖНОСТЬ.
Dialogue: 0,0:16:05.92,0:16:08.24,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ СООБЩЕНИЕ О КОНТАКТЕ С УШАКОВЫМ.
Dialogue: 0,0:16:08.55,0:16:11.44,Caption,,0,0,0,,ПИСТОРИУС ПУБЛИЧНО ПРИВЕТСТВУЕТ ПЕРЕГОВОРЫ. МОСКВА
Dialogue: 0,0:16:11.52,0:16:14.08,Caption,,0,0,0,,ОБЕЩАЕТ ПОДГОТОВИТЬ ВИЗИТ МАКСИМАЛЬНО БЫСТРО,
Dialogue: 0,0:16:14.32,0:16:17.12,Caption,,0,0,0,,ЕСЛИ ЕВРОПЕЙЦЫ ПРИМУТ ПРИГЛАШЕНИЕ. И ПОСРЕДИ ЭТОЙ
Dialogue: 0,0:16:17.12,0:16:21.76,Caption,,0,0,0,,ИСТОРИИ ЗЕЛЕНСКИЙ СООБЩАЕТ, ЧТО ЕХАТЬ НЕЛЬЗЯ. У НЕГО ЕСТЬ СВОЯ ПОЗИЦИЯ.
Dialogue: 0,0:16:22.08,0:16:24.00,Caption,,0,0,0,,НО САМА ПО СЕБЕ ЭТА ПОЗИЦИЯ ЕЩЁ НЕ
Dialogue: 0,0:16:24.00,0:16:26.64,Caption,,0,0,0,,ЗАКРЫВАЕТ ДИПЛОМАТИЧЕСКИЙ КАНАЛ МЕЖДУ РОССИЕЙ И
Dialogue: 0,0:16:26.64,0:16:29.52,Caption,,0,0,0,,ЕВРОПЕЙСКИМИ ГОСУДАРСТВАМИ. ТЕМ БОЛЕЕ ЧТО ПЕРЕГОВОРЫ
Dialogue: 0,0:16:29.60,0:16:32.00,Caption,,0,0,0,,НЕ ОЗНАЧАЮТ СОГЛАСИЯ. МОЖНО ПРИЕХАТЬ,
Dialogue: 0,0:16:32.24,0:16:34.88,Caption,,0,0,0,,ВЫСЛУШАТЬ ПРОТИВОПОЛОЖНУЮ СТОРОНУ И ОСТАТЬСЯ ПРИ
Dialogue: 0,0:16:34.96,0:16:37.68,Caption,,0,0,0,,СВОИХ ТРЕБОВАНИЯХ. МОЖНО НЕ ДОГОВОРИТЬСЯ ВООБЩЕ НИ О
Dialogue: 0,0:16:37.68,0:16:42.59,Caption,,0,0,0,,ЧЁМ. НО ДЛЯ ЭТОГО КАК МИНИМУМ НЕОБХОДИМО ПОНИМАТЬ,
Dialogue: 0,0:16:42.72,0:16:45.79,Caption,,0,0,0,,ЧТО ИМЕННО ДРУГАЯ СТОРОНА СОБИРАЕТСЯ ДЕЛАТЬ И КАКИЕ
Dialogue: 0,0:16:45.79,0:16:48.83,Caption,,0,0,0,,УСЛОВИЯ СЧИТАЕТ ОБЯЗАТЕЛЬНЫМИ. А ТЕПЕРЬ ПОЛОЖЕНИЕ
Dialogue: 0,0:16:48.83,0:16:51.71,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ПОЛИТИКА ОН ПУБЛИЧНО ОТКАЗЫВАЕТСЯ ДАЖЕ
Dialogue: 0,0:16:51.71,0:16:53.87,Caption,,0,0,0,,ОТ РАЗГОВОРА, А ЗАТЕМ ОБНАРУЖИВАЕТ,
Dialogue: 0,0:16:54.11,0:16:56.83,Caption,,0,0,0,,ЧТО ОБСТАНОВКА СТАНОВИТСЯ ОПАСНЕЕ ИМЕННО ДЛЯ ЕГО
Dialogue: 0,0:16:56.83,0:16:59.55,Caption,,0,0,0,,СОБСТВЕННОЙ СТРАНЫ. И КАК ОН ЭТО БУДЕТ ОБЪЯСНЯТЬ?
Dialogue: 0,0:16:59.79,0:17:01.79,Caption,,0,0,0,,СКАЖЕТ, ЧТО В МОСКВУ НЕ ПОЕХАЛ,
Dialogue: 0,0:17:01.97,0:17:03.39,Caption,,0,0,0,,ПОТОМУ ЧТО ЗЕЛЕНСКИЙ БЫЛ ПРОТИВ?
Dialogue: 0,0:17:03.67,0:17:06.35,Caption,,0,0,0,,ДЛЯ ВНУТРЕННЕЙ ЕВРОПЕЙСКОЙ ПОЛИТИКИ ТАКОЕ ОБЪЯСНЕНИЕ
Dialogue: 0,0:17:06.35,0:17:09.63,Caption,,0,0,0,,ВЫГЛЯДИТ, МЯГКО ГОВОРЯ, ЗАНЯТНО. ЕСТЬ,
Dialogue: 0,0:17:09.78,0:17:13.39,Caption,,0,0,0,,ПРАВДА, И ОБРАТНАЯ СТОРОНА. ЕСЛИ РАЗГОВОР СОСТОИТСЯ,
Dialogue: 0,0:17:13.63,0:17:16.99,Caption,,0,0,0,,ОН ЕЩЁ НЕ ОЗНАЧАЕТ, ЧТО МОСКВА И ЕВРОПА ДОГОВОРИЛИСЬ,
Dialogue: 0,0:17:17.23,0:17:19.15,Caption,,0,0,0,,А ТЕМ БОЛЕЕ ЧТО КТО ТО ПРИНЯЛ РЕШЕНИЕ
Dialogue: 0,0:17:19.23,0:17:21.87,Caption,,0,0,0,,ЗА УКРАИНУ. РЯБКОВ СПЕЦИАЛЬНО ПОДЧЁРКИВАЕТ
Dialogue: 0,0:17:21.87,0:17:24.35,Caption,,0,0,0,,ОТСУТСТВИЕ ОКОНЧАТЕЛЬНЫХ ДОГОВОРЁННОСТЕЙ О НОВОМ
Dialogue: 0,0:17:24.35,0:17:27.31,Caption,,0,0,0,,ПЕРЕГОВОРНОМ РАУНДЕ. ФРАНЦИЯ ВЫДВИГАЕТ УСЛОВИЯ
Dialogue: 0,0:17:27.39,0:17:30.27,Caption,,0,0,0,,СОБСТВЕННОГО УЧАСТИЯ. РОССИЙСКАЯ ПОЗИЦИЯ ПО НАТО
Dialogue: 0,0:17:30.27,0:17:33.23,Caption,,0,0,0,,ОСТАЁТСЯ ПРЕЖНЕЙ. А СТУББ ГОВОРИТ О НЕОБХОДИМОСТИ
Dialogue: 0,0:17:33.31,0:17:35.95,Caption,,0,0,0,,ОТДЕЛЬНОЙ ВСТРЕЧИ ПУТИНА И ЗЕЛЕНСКОГО. ТО ЕСТЬ
Dialogue: 0,0:17:35.95,0:17:38.75,Caption,,0,0,0,,ВПЕРЕДИ ЕЩЁ МАССА ПРЕПЯТСТВИЙ. И НИКТО ПОКА НЕ
Dialogue: 0,0:17:38.75,0:17:41.55,Caption,,0,0,0,,ОТМЕНЯЛ НИ ОДНОГО ИЗ ГЛАВНЫХ ПРОТИВОРЕЧИЙ. НО
Dialogue: 0,0:17:41.55,0:17:44.03,Caption,,0,0,0,,ВОЗМОЖНАЯ ПОЕЗДКА УЖЕ ИНТЕРЕСНА САМА ПО СЕБЕ.
Dialogue: 0,0:17:46.31,0:17:47.99,Caption,,0,0,0,,ПОТОМУ ЧТО ОНА ПОЗВОЛЯЕТ УВИДЕТЬ,
Dialogue: 0,0:17:48.24,0:17:50.87,Caption,,0,0,0,,КАКИЕ ВОПРОСЫ ЕВРОПЕЙСКИЕ ПРАВИТЕЛЬСТВА СЧИТАЮТ
Dialogue: 0,0:17:50.87,0:17:54.79,Caption,,0,0,0,,ДОСТАТОЧНО СЕРЬЁЗНЫМИ, ЧТОБЫ ОБСУЖДАТЬ ИХ НЕПОСРЕДСТВЕННО С РОССИЙСКИМ
Dialogue: 0,0:17:54.79,0:17:58.95,Caption,,0,0,0,,РУКОВОДСТВОМ, ДАЖЕ ПРИ ПРОДОЛЖАЮЩИХСЯ РАЗНОГЛАСИЯХ. И ЕСЛИ СРЕДИ
Dialogue: 0,0:17:59.03,0:18:01.19,Caption,,0,0,0,,ЭТИХ ВОПРОСОВ ДЕЙСТВИТЕЛЬНО ОКАЖЕТСЯ РИСК
Dialogue: 0,0:18:01.27,0:18:03.19,Caption,,0,0,0,,РОССИЙСКОГО ОТВЕТА ПО ЕВРОПЕЙСКОЙ ВОЕННОЙ
Dialogue: 0,0:18:03.19,0:18:06.95,Caption,,0,0,0,,ПРОМЫШЛЕННОСТИ, ЭТО БУДЕТ РАЗГОВОР СОВСЕМ ДРУГОГО УРОВНЯ. ТОГДА
Dialogue: 0,0:18:06.95,0:18:09.91,Caption,,0,0,0,,ВЫЯСНИТСЯ, ЧТО У ЕВРОПЕЙЦЕВ ЗА СТОЛОМ ПЕРЕГОВОРОВ ЕСТЬ НЕ
Dialogue: 0,0:18:09.91,0:18:14.55,Caption,,0,0,0,,ТОЛЬКО ТРЕБОВАНИЯ К МОСКВЕ, НО И СОБСТВЕННЫЕ ОПАСЕНИЯ. А У МОСКВЫ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:18:14.55,0:18:16.87,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ОБСУЖДАТЬ УЖЕ НЕ ТОЛЬКО УКРАИНСКИЕ
Dialogue: 0,0:18:16.87,0:18:20.23,Caption,,0,0,0,,УСЛОВИЯ, НО И ПРЯМЫЕ ПОСЛЕДСТВИЯ ЕВРОПЕЙСКОГО УЧАСТИЯ В
Dialogue: 0,0:18:20.23,0:18:23.67,Caption,,0,0,0,,КОНФЛИКТЕ. ВСЁ ЭТО ЕЩЁ ПРЕДСТОИТ УВИДЕТЬ. ОДНАКО
Dialogue: 0,0:18:23.75,0:18:26.39,Caption,,0,0,0,,ОДИН ВЫВОД НАПРАШИВАЕТСЯ УЖЕ СЕЙЧАС. САМОЕ
Dialogue: 0,0:18:26.39,0:18:29.27,Caption,,0,0,0,,СУЩЕСТВЕННОЕ ИЗМЕНЕНИЕ ПРОИЗОЙДЁТ НЕ В ТОТ МОМЕНТ,
Dialogue: 0,0:18:29.51,0:18:32.63,Caption,,0,0,0,,КОГДА ЕВРОПЕЙСКАЯ ДЕЛЕГАЦИЯ ПРИЗЕМЛИТСЯ В МОСКВЕ. И
Dialogue: 0,0:18:32.63,0:18:36.87,Caption,,0,0,0,,ДАЖЕ НЕ ТОГДА, КОГДА ДИПЛОМАТЫ СЯДУТ ЗА СТОЛ. ОНО ПРОИЗОЙДЁТ,
Dialogue: 0,0:18:37.07,0:18:41.83,Caption,,0,0,0,,ЕСЛИ ФРАНЦИЯ, ГЕРМАНИЯ И ВЕЛИКОБРИТАНИЯ НАЧНУТ ОБСУЖДАТЬ С РОССИЕЙ
Dialogue: 0,0:18:41.83,0:18:44.55,Caption,,0,0,0,,ПРЕДЕЛЫ СОБСТВЕННОЙ БЕЗОПАСНОСТИ ОТДЕЛЬНО ОТ
Dialogue: 0,0:18:44.55,0:18:47.51,Caption,,0,0,0,,УКРАИНСКИХ ТРЕБОВАНИЙ. ПОТОМУ ЧТО ПОСЛЕ ЭТОГО ВОПРОС
Dialogue: 0,0:18:47.51,0:18:51.51,Caption,,0,0,0,,БУДЕТ УЖЕ НЕ В ТОМ, РАЗРЕШИЛ ЛИ ЗЕЛЕНСКИЙ ЕВРОПЕЙЦАМ ПРИЕХАТЬ К ПУТИНУ.
Dialogue: 0,0:18:51.81,0:18:57.94,Caption,,0,0,0,,ВОПРОС БУДЕТ В ДРУГОМ. КОГДА РЕЧЬ ЗАХОДИТ О БЕЗОПАСНОСТИ САМОЙ ЕВРОПЫ,
Dialogue: 0,0:18:58.26,0:19:00.82,Caption,,0,0,0,,КТО В КОНЕЧНОМ СЧЁТЕ ПРИНИМАЕТ ЗА НЕЁ РЕШЕНИЯ?
