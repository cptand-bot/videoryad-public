Dialogue: 0,0:00:00.12,0:00:05.08,Caption,,0,0,0,,ФРИДРИХ МЕРЦ ОПЯТЬ РЕШИЛ, ЧТО РОССИЯ ПОНИМАЕТ ТОЛЬКО ЯЗЫК СИЛЫ. ФРИДРИХ,
Dialogue: 0,0:00:05.44,0:00:07.40,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ПЕРЕХОДИТЬ НА ЭТОТ ЯЗЫК,
Dialogue: 0,0:00:07.72,0:00:10.44,Caption,,0,0,0,,НЕПЛОХО БЫЛО БЫ ЗАГЛЯНУТЬ В СЕМЕЙНЫЙ АРХИВ. ТАМ
Dialogue: 0,0:00:10.44,0:00:13.32,Caption,,0,0,0,,НАВЕРНЯКА НАЙДЁТСЯ ЧЕЛОВЕК, СПОСОБНЫЙ ОБЪЯСНИТЬ,
Dialogue: 0,0:00:13.48,0:00:16.20,Caption,,0,0,0,,ЧЕМ ДЛЯ ГЕРМАНИИ ОБЫЧНО ЗАКАНЧИВАЕТСЯ ПОПЫТКА
Dialogue: 0,0:00:16.20,0:00:18.36,Caption,,0,0,0,,РАЗГОВАРИВАТЬ С РОССИЕЙ ПРИКАЗНЫМ ТОНОМ.
Dialogue: 0,0:00:18.92,0:00:21.96,Caption,,0,0,0,,НО МЕРЦ УРОК ИСТОРИИ ПРОПУСТИЛ И ТЕПЕРЬ ТРЕНИРУЕТСЯ
Dialogue: 0,0:00:21.96,0:00:23.96,Caption,,0,0,0,,НА СОЮЗНИКАХ. ПОКА БЕЗ ТАНКОВ,
Dialogue: 0,0:00:24.28,0:00:26.28,Caption,,0,0,0,,ЗАТО С ЕВРОПЕЙСКИМ БЮДЖЕТОМ В РУКАХ.
Dialogue: 0,0:00:28.49,0:00:32.97,Caption,,0,0,0,,ГЕРМАНИЯ ТРЕБУЕТ, ЧТОБЫ ВСЕ СТРАНЫ ЕВРОСОЮЗА УЧАСТВОВАЛИ В ДАЛЬНЕЙШЕМ
Dialogue: 0,0:00:32.97,0:00:35.37,Caption,,0,0,0,,ФИНАНСИРОВАНИИ УКРАИНЫ. НЕ НРАВИТСЯ,
Dialogue: 0,0:00:35.52,0:00:37.69,Caption,,0,0,0,,ДОРОГО, ХОЧЕТСЯ ВЫЙТИ ИЗ ИГРЫ,
Dialogue: 0,0:00:37.92,0:00:41.13,Caption,,0,0,0,,ЭТО УЖЕ ВАШИ ЛИЧНЫЕ ПЕРЕЖИВАНИЯ. БЕРЛИН ПРЕДЛАГАЕТ
Dialogue: 0,0:00:41.21,0:00:43.61,Caption,,0,0,0,,ПЛАТИТЬ СООБЩА, А ТЕМ, КТО ОТКАЖЕТСЯ,
Dialogue: 0,0:00:43.88,0:00:46.33,Caption,,0,0,0,,МЕРЦ ГРОЗИТ ЗАБЛОКИРОВАТЬ СЕМИЛЕТНИЙ БЮДЖЕТ
Dialogue: 0,0:00:46.33,0:00:49.37,Caption,,0,0,0,,ЕВРОСОЮЗА С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ
Dialogue: 0,0:00:49.37,0:00:50.97,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ ГОД.
Dialogue: 0,0:00:53.17,0:00:56.06,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ЗА СЛОВОМ "ЕДИНСТВО" ДАВНО
Dialogue: 0,0:00:56.06,0:00:58.14,Caption,,0,0,0,,СКРЫВАЕТСЯ ДРАКА ЗА ОБЩИЙ КОШЕЛЁК,
Dialogue: 0,0:00:58.37,0:01:00.22,Caption,,0,0,0,,И СЕЙЧАС ИЗ НЕГО УЖЕ ЛЕТЯТ НЕ ТОЛЬКО
Dialogue: 0,0:01:00.22,0:01:06.10,Caption,,0,0,0,,МОНЕТЫ, НО И ЗУБЫ. УГРОЗА МЕРЦА ЗВУЧИТ ПРИМЕРНО ТАК ЛИБО ВЫ
Dialogue: 0,0:01:06.10,0:01:10.66,Caption,,0,0,0,,СОГЛАШАЕТЕСЬ С ГЕРМАНИЕЙ, ЛИБО НОРМАЛЬНОГО БЮДЖЕТА НЕ ПОЛУЧИТ НИКТО. ОЧЕНЬ
Dialogue: 0,0:01:10.66,0:01:13.62,Caption,,0,0,0,,ТЁПЛАЯ СЕМЕЙНАЯ АТМОСФЕРА. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:01:13.94,0:01:16.18,Caption,,0,0,0,,И НА ЗАСЕДАНИЯ ЕВРОСОЮЗА НАЧНУТ ПРИГЛАШАТЬ
Dialogue: 0,0:01:16.18,0:01:18.02,Caption,,0,0,0,,СПЕЦИАЛИСТА ПО РАЗДЕЛУ ИМУЩЕСТВА.
Dialogue: 0,0:01:20.29,0:01:23.09,Caption,,0,0,0,,ВЕНГРИЯ И СЛОВАКИЯ НЕ ХОТЯТ ПОДПИСЫВАТЬСЯ ПОД НОВЫМИ
Dialogue: 0,0:01:23.09,0:01:25.97,Caption,,0,0,0,,РАСХОДАМИ НА КИЕВ. НЕДОВОЛЬНЫ И ДРУГИЕ СТРАНЫ,
Dialogue: 0,0:01:26.20,0:01:28.61,Caption,,0,0,0,,КОТОРЫМ ВСЁ ТРУДНЕЕ ОБЪЯСНЯТЬ СВОИМ ГРАЖДАНАМ,
Dialogue: 0,0:01:28.77,0:01:31.49,Caption,,0,0,0,,ПОЧЕМУ ЭТОТ СЧЁТ НЕ ИМЕЕТ НИ ИТОГОВОЙ СУММЫ,
Dialogue: 0,0:01:31.73,0:01:34.93,Caption,,0,0,0,,НИ ДАТЫ ЗАКРЫТИЯ. БЕРЛИН ЖЕ ТРЕБУЕТ МНОГОЛЕТНИХ
Dialogue: 0,0:01:34.93,0:01:38.45,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ, БУДТО РЕЧЬ ИДЁТ НЕ О ПРОДОЛЖАЮЩЕМСЯ КОНФЛИКТЕ,
Dialogue: 0,0:01:38.69,0:01:41.97,Caption,,0,0,0,,А ОБ АБОНЕМЕНТЕ, КОТОРЫЙ НЕЛЬЗЯ ОТМЕНИТЬ РАНЬШЕ СРОКА.
Dialogue: 0,0:01:44.24,0:01:47.44,Caption,,0,0,0,,МЕРЦ ПОНИМАЕТ, ЧТО ЕДИНОГЛАСИЕ МЕШАЕТ ЕГО ПЛАНУ,
Dialogue: 0,0:01:47.68,0:01:49.68,Caption,,0,0,0,,ПОЭТОМУ ГЕРМАНИЯ ДОБИВАЕТСЯ ПЕРЕХОДА К
Dialogue: 0,0:01:49.68,0:01:52.48,Caption,,0,0,0,,КВАЛИФИЦИРОВАННОМУ БОЛЬШИНСТВУ. ТОГДА НЕСКОЛЬКО
Dialogue: 0,0:01:52.48,0:01:55.04,Caption,,0,0,0,,НЕСОГЛАСНЫХ ГОСУДАРСТВ МОЖНО БУДЕТ ПРОСТО ОСТАВИТЬ
Dialogue: 0,0:01:55.12,0:01:57.76,Caption,,0,0,0,,ЗА ДВЕРЬЮ. НА ВЫВЕСКЕ СОХРАНИТСЯ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:01:57.76,0:02:01.92,Caption,,0,0,0,,СОГЛАСИЕ, А ВНУТРИ ОСТАНЕТСЯ ПРАВИЛО ВАШЕ МНЕНИЕ ОЧЕНЬ ЦЕННО,
Dialogue: 0,0:02:02.08,0:02:09.23,Caption,,0,0,0,,ПОКА ОНО СОВПАДАЕТ С НАШИМ. ЭТО НЕ ПРОЯВЛЕНИЕ СИЛЫ СОЮЗА. СИЛЬНОМУ ОБЪЕДИНЕНИЮ
Dialogue: 0,0:02:09.23,0:02:11.55,Caption,,0,0,0,,НЕ ПРИХОДИТСЯ УГРОЖАТЬ СОБСТВЕННЫМ УЧАСТНИКАМ
Dialogue: 0,0:02:11.55,0:02:14.91,Caption,,0,0,0,,ФИНАНСОВОЙ ДУБИНКОЙ. ЕСЛИ ПАРТНЁРОВ УДЕРЖИВАЮТ ВОЗЛЕ
Dialogue: 0,0:02:14.99,0:02:17.23,Caption,,0,0,0,,КАССЫ УГРОЗОЙ ЗАБЛОКИРОВАТЬ ВЕСЬ БЮДЖЕТ,
Dialogue: 0,0:02:17.55,0:02:20.35,Caption,,0,0,0,,ПЕРЕД НАМИ УЖЕ НЕ ОБЩИЙ КУРС. ЭТО КОМПАНИЯ,
Dialogue: 0,0:02:20.59,0:02:23.15,Caption,,0,0,0,,В КОТОРОЙ ОДИН СОВЛАДЕЛЕЦ ЗАПЕР ВЫХОД И ОБЪЯВИЛ
Dialogue: 0,0:02:23.15,0:02:29.84,Caption,,0,0,0,,СОБРАНИЕ ДОБРОВОЛЬНЫМ. ГЕРМАНИЯ МОЖЕТ ПОЗВОЛИТЬ СЕБЕ ПОДОБНЫЙ ТОН. ЕЁ
Dialogue: 0,0:02:29.84,0:02:32.56,Caption,,0,0,0,,ЭКОНОМИКА ОСТАЁТСЯ ОДНОЙ ИЗ ОПОР ЕВРОСОЮЗА,
Dialogue: 0,0:02:32.88,0:02:36.00,Caption,,0,0,0,,А БЕЗ НЕМЕЦКИХ ДЕНЕГ И СОГЛАСИЯ МНОГИЕ БРЮССЕЛЬСКИЕ
Dialogue: 0,0:02:36.00,0:02:38.48,Caption,,0,0,0,,КОНСТРУКЦИИ НАЧИНАЮТ ПОДОЗРИТЕЛЬНО ПОСКРИПЫВАТЬ.
Dialogue: 0,0:02:38.75,0:02:41.84,Caption,,0,0,0,,ПОЭТОМУ МЕРЦ НЕ ПРОСТО ПОВЫШАЕТ ГОЛОС. ОН ПЫТАЕТСЯ
Dialogue: 0,0:02:41.84,0:02:44.80,Caption,,0,0,0,,ПРЕВРАТИТЬ ВЕС ГЕРМАНИИ В ОБЯЗАННОСТЬ ОСТАЛЬНЫХ ИДТИ
Dialogue: 0,0:02:44.80,0:02:47.04,Caption,,0,0,0,,ТУДА, КУДА БЕРЛИН УЖЕ ПОВЕРНУЛ.
Dialogue: 0,0:02:49.31,0:02:52.04,Caption,,0,0,0,,ПРИЧИНА ТАКОЙ СПЕШКИ ВИДНА В КАЛЕНДАРЕ. СОВЕТ
Dialogue: 0,0:02:52.04,0:02:55.00,Caption,,0,0,0,,ЕВРОСОЮЗА ПРОДЛИЛ МИССИЮ ПО ПОДГОТОВКЕ УКРАИНСКИХ
Dialogue: 0,0:02:55.00,0:02:57.32,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ ДО НОЯБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:02:57.32,0:03:00.68,Caption,,0,0,0,,ВОСЬМОГО ГОДА. ПОЧТИ ТРИСТА МИЛЛИОНОВ ЕВРО ПОЙДУТ НА
Dialogue: 0,0:03:00.68,0:03:03.16,Caption,,0,0,0,,ОБУЧЕНИЕ, ИЗУЧЕНИЕ БОЕВОГО ОПЫТА,
Dialogue: 0,0:03:03.40,0:03:06.84,Caption,,0,0,0,,ОБНОВЛЕНИЕ ПРОГРАММ И КООРДИНАЦИЮ С ВЕЛИКОБРИТАНИЕЙ,
Dialogue: 0,0:03:06.92,0:03:11.00,Caption,,0,0,0,,КАНАДОЙ, НОРВЕГИЕЙ, СОЕДИНЁННЫМИ ШТАТАМИ И СТРУКТУРАМИ НАТО.
Dialogue: 0,0:03:13.27,0:03:15.75,Caption,,0,0,0,,ПЕРЕД НАМИ НЕ ЗАПАСНОЙ ПЛАН НА СЛУЧАЙ ПРОДОЛЖЕНИЯ
Dialogue: 0,0:03:15.75,0:03:19.19,Caption,,0,0,0,,КОНФЛИКТА. ЭТО УЖЕ ДЕЙСТВУЮЩАЯ ПРОГРАММА С ДЕНЬГАМИ,
Dialogue: 0,0:03:19.27,0:03:22.71,Caption,,0,0,0,,СРОКАМИ И УЧАСТНИКАМИ. ПЕРЕГОВОРЩИКИ МОГУТ ОБСУЖДАТЬ
Dialogue: 0,0:03:22.71,0:03:25.99,Caption,,0,0,0,,МИР, ТЕРРИТОРИАЛЬНЫЕ ВОПРОСЫ И ГАРАНТИИ БЕЗОПАСНОСТИ,
Dialogue: 0,0:03:26.31,0:03:29.19,Caption,,0,0,0,,НО ВОЕННАЯ СИСТЕМА ТЕМ ВРЕМЕНЕМ СПОКОЙНО БРОНИРУЕТ
Dialogue: 0,0:03:29.27,0:03:31.83,Caption,,0,0,0,,СЕБЕ РАБОТУ ЕЩЁ НА ДВА ГОДА. У НЕЁ,
Dialogue: 0,0:03:31.97,0:03:35.11,Caption,,0,0,0,,КАК У ХОРОШЕГО САНАТОРИЯ, МЕСТА РАСПИСАНЫ ЗАРАНЕЕ.
Dialogue: 0,0:03:37.38,0:03:40.50,Caption,,0,0,0,,ТА ЖЕ КАРТИНА С ПРОТИВОВОЗДУШНОЙ ОБОРОНОЙ. ПО ДАННЫМ
Dialogue: 0,0:03:40.58,0:03:44.10,Caption,,0,0,0,,BLOOMBERG, РОССИЯ ВЫПУСКАЕТ БАЛЛИСТИЧЕСКИЕ РАКЕТЫ БЫСТРЕЕ,
Dialogue: 0,0:03:44.26,0:03:46.74,Caption,,0,0,0,,ЧЕМ ВСЕ МИРОВЫЕ ПРОИЗВОДИТЕЛИ ПЕРЕХВАТЧИКОВ ДЛЯ
Dialogue: 0,0:03:46.74,0:03:50.18,Caption,,0,0,0,,PATRIOT ВМЕСТЕ УСПЕВАЮТ ДЕЛАТЬ ПРОТИВОРАКЕТЫ. ТУТ НЕ
Dialogue: 0,0:03:50.18,0:03:55.38,Caption,,0,0,0,,ПОМОГУТ НИ ГРОЗНЫЕ ЗАЯВЛЕНИЯ, НИ ОСОБЕННО СУРОВОЕ ВЫРАЖЕНИЕ ЛИЦА У МИКРОФОНА. ЕСЛИ
Dialogue: 0,0:03:55.38,0:03:57.46,Caption,,0,0,0,,РАСХОД РАСТЁТ БЫСТРЕЕ ПОПОЛНЕНИЯ,
Dialogue: 0,0:03:57.54,0:04:00.18,Caption,,0,0,0,,СКЛАД ПУСТЕЕТ НЕЗАВИСИМО ОТ КАЧЕСТВА РЕЧЕЙ.
Dialogue: 0,0:04:02.46,0:04:05.26,Caption,,0,0,0,,УКРАИНЕ ОБЕЩАНЫ ШЕСТЬСОТ РАКЕТ ПАК ДВА НЕМЕЦКОГО
Dialogue: 0,0:04:05.26,0:04:07.98,Caption,,0,0,0,,ПРОИЗВОДСТВА. ПОСТАВКИ ОЖИДАЮТСЯ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:04:07.98,0:04:10.22,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОМ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ
Dialogue: 0,0:04:10.22,0:04:12.70,Caption,,0,0,0,,ГОДАХ. ОДНОВРЕМЕННО В ПОЛЬШЕ СОБИРАЮТСЯ
Dialogue: 0,0:04:12.70,0:04:15.42,Caption,,0,0,0,,РАЗВОРАЧИВАТЬ ПРОИЗВОДСТВО ПАК ТРИ. НА БУМАГЕ
Dialogue: 0,0:04:15.42,0:04:17.34,Caption,,0,0,0,,ВЫГЛЯДИТ ВНУШИТЕЛЬНО ШЕСТЬСОТ РАКЕТ,
Dialogue: 0,0:04:17.50,0:04:21.42,Caption,,0,0,0,,НОВЫЙ ПРОЕКТ, ЕВРОПЕЙСКАЯ КООПЕРАЦИЯ. БУМАГА ВООБЩЕ ОТЛИЧНО
Dialogue: 0,0:04:21.42,0:04:24.06,Caption,,0,0,0,,ПЕРЕНОСИТ ЗИМУ. ЕЙ ОТОПЛЕНИЕ НЕ ТРЕБУЕТСЯ.
Dialogue: 0,0:04:26.33,0:04:28.25,Caption,,0,0,0,,ДО ЭТИХ ПОСТАВОК ЕЩЁ НУЖНО ДОЖИТЬ,
Dialogue: 0,0:04:28.41,0:04:31.45,Caption,,0,0,0,,ПРИЧЁМ В БУКВАЛЬНОМ СМЫСЛЕ. ЗАВОД НЕЛЬЗЯ ПОСТРОИТЬ
Dialogue: 0,0:04:31.45,0:04:34.89,Caption,,0,0,0,,АПЛОДИСМЕНТАМИ, ПРОИЗВОДСТВЕННУЮ ЛИНИЮ НЕ УСКОРИШЬ ИТОГОВЫМ
Dialogue: 0,0:04:34.89,0:04:38.33,Caption,,0,0,0,,КОММЮНИКЕ, А ГОТОВЫЙ ПЕРЕХВАТЧИК НЕ ПОЯВЛЯЕТСЯ ПОСЛЕ ФРАЗЫ
Dialogue: 0,0:04:38.41,0:04:41.37,Caption,,0,0,0,,"ПОДДЕРЖКА БУДЕТ ПРОДОЛЖАТЬСЯ". У ПРОМЫШЛЕННОСТИ
Dialogue: 0,0:04:41.45,0:04:44.81,Caption,,0,0,0,,СВОЙ ТЕМП, И ОН СОВЕРШЕННО НЕ ОБЯЗАН СОВПАДАТЬ С ТЕМПОМ
Dialogue: 0,0:04:44.81,0:04:49.97,Caption,,0,0,0,,ВОЙНЫ. ИМЕННО ПОЭТОМУ МЕРЦ ТАК СТАРАЕТСЯ ПРИБИТЬ
Dialogue: 0,0:04:49.97,0:04:52.93,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ОБЯЗАТЕЛЬСТВА К БУДУЩИМ БЮДЖЕТАМ. ОН
Dialogue: 0,0:04:52.93,0:04:54.77,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТ ТУ ЧАСТЬ СОЮЗНИКОВ,
Dialogue: 0,0:04:55.01,0:04:57.73,Caption,,0,0,0,,КОТОРАЯ НЕ СОБИРАЕТСЯ ОТСТУПАТЬ ОТ ПРЕЖНЕГО КУРСА,
Dialogue: 0,0:04:57.97,0:05:01.01,Caption,,0,0,0,,ДАЖЕ ЕСЛИ ДРУГИЕ УЖЕ ИЩУТ ВЫХОД. БОЛЕЕ ТОГО,
Dialogue: 0,0:05:01.25,0:05:03.81,Caption,,0,0,0,,БЕРЛИН ХОЧЕТ ЛИШИТЬ СОМНЕВАЮЩИХСЯ ВОЗМОЖНОСТИ
Dialogue: 0,0:05:03.81,0:05:06.69,Caption,,0,0,0,,ОСТАНОВИТЬСЯ САМОСТОЯТЕЛЬНО. ЕСЛИ ВАГОН НАЧАЛ
Dialogue: 0,0:05:06.69,0:05:10.77,Caption,,0,0,0,,ТОРМОЗИТЬ, МЕРЦ ПРЕДЛАГАЕТ СНЯТЬ С НЕГО ТОРМОЗА. ДЛЯ НАДЁЖНОСТИ
Dialogue: 0,0:05:10.77,0:05:16.80,Caption,,0,0,0,,И ОБЩЕГО СПОКОЙСТВИЯ. ТЕМ ВРЕМЕНЕМ ПЕРЕГОВОРНЫЙ ПРОЦЕСС ДАЁТ СОВСЕМ ИНОЙ
Dialogue: 0,0:05:16.80,0:05:19.04,Caption,,0,0,0,,СИГНАЛ. ПО СВЕДЕНИЯМ THE TELEGRAPH,
Dialogue: 0,0:05:19.36,0:05:21.84,Caption,,0,0,0,,КИЕВ ГОТОВ ОБСУЖДАТЬ ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ.
Dialogue: 0,0:05:22.18,0:05:24.96,Caption,,0,0,0,,АМЕРИКАНСКИЕ ИСТОЧНИКИ ГОВОРЯТ О ГИБКОСТИ МОСКВЫ И
Dialogue: 0,0:05:24.96,0:05:28.24,Caption,,0,0,0,,КИЕВА, А ТЕРРИТОРИАЛЬНУЮ ТЕМУ ПРЕДПОЛАГАЕТСЯ ОТЛОЖИТЬ ДО
Dialogue: 0,0:05:28.24,0:05:30.16,Caption,,0,0,0,,ОБСУЖДЕНИЯ ГАРАНТИЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:05:32.45,0:05:36.77,Caption,,0,0,0,,ЭТО НЕ ОЗНАЧАЕТ, ЧТО СТОРОНЫ УЖЕ ОБО ВСЁМ ДОГОВОРИЛИСЬ. ВАЖНО ДРУГОЕ
Dialogue: 0,0:05:36.77,0:05:38.85,Caption,,0,0,0,,ПОИСК ВАРИАНТОВ ИДЁТ ИМЕННО ПОТОМУ,
Dialogue: 0,0:05:39.08,0:05:41.97,Caption,,0,0,0,,ЧТО ПРЕЖНИЙ РАСЧЁТ НЕ ПРИНЁС ОБЕЩАННОГО РЕЗУЛЬТАТА.
Dialogue: 0,0:05:42.29,0:05:44.85,Caption,,0,0,0,,ЧАСТЬ УЧАСТНИКОВ УЖЕ СМОТРИТ В СТОРОНУ ВЫХОДА,
Dialogue: 0,0:05:45.06,0:05:47.89,Caption,,0,0,0,,ПОКА ДРУГАЯ ЧАСТЬ ЗАКУПАЕТ БИЛЕТЫ НА ПРОДОЛЖЕНИЕ ДО
Dialogue: 0,0:05:47.89,0:05:50.69,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА. МЕРЦ В ЭТОЙ
Dialogue: 0,0:05:50.69,0:05:53.41,Caption,,0,0,0,,КОМПАНИИ РАБОТАЕТ КОНТРОЛЁРОМ И ПРОВЕРЯЕТ,
Dialogue: 0,0:05:53.57,0:05:55.65,Caption,,0,0,0,,ЧТОБЫ НИКТО НЕ СОШЁЛ РАНЬШЕ ГЕРМАНИИ.
Dialogue: 0,0:05:57.92,0:06:00.72,Caption,,0,0,0,,ОСОБОЕ ИЗЯЩЕСТВО ПРОИСХОДЯЩЕМУ ДОБАВИЛ ПОСТПРЕД
Dialogue: 0,0:06:00.72,0:06:03.76,Caption,,0,0,0,,УКРАИНЫ ПРИ ООН АНДРЕЙ МЕЛЬНИК. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:06:03.93,0:06:06.72,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ГОТОВ ВСТРЕТИТЬСЯ С ПУТИНЫМ ГДЕ УГОДНО,
Dialogue: 0,0:06:06.88,0:06:10.40,Caption,,0,0,0,,ДАЖЕ В АНТАРКТИДЕ, НО ТОЛЬКО НЕ В МОСКВЕ. ТУРЦИЯ,
Dialogue: 0,0:06:10.48,0:06:12.96,Caption,,0,0,0,,АБУ ДАБИ И ДРУГИЕ ПЛОЩАДКИ, ВИДИМО,
Dialogue: 0,0:06:13.06,0:06:16.00,Caption,,0,0,0,,ПОКАЗАЛИСЬ НЕДОСТАТОЧНО СВЕЖИМИ. ТЕПЕРЬ ДИПЛОМАТАМ
Dialogue: 0,0:06:16.00,0:06:20.32,Caption,,0,0,0,,ПРЕДЛАГАЮТ ЛЁД, ПИНГВИНОВ И ПОЛНОЕ ОТСУТСТВИЕ СЛУЧАЙНЫХ ПРОХОЖИХ.
Dialogue: 0,0:06:22.60,0:06:25.72,Caption,,0,0,0,,ДЕВЯНОСТО ПЯТЫЙ КВАРТАЛ ВЕРЕН СЕБЕ. КОГДА СОДЕРЖАНИЕ
Dialogue: 0,0:06:25.72,0:06:27.72,Caption,,0,0,0,,РАЗГОВОРА СТАНОВИТСЯ СЛИШКОМ ТЯЖЁЛЫМ,
Dialogue: 0,0:06:28.00,0:06:31.08,Caption,,0,0,0,,МОЖНО ЗАНЯТЬСЯ ДЕКОРАЦИЯМИ. ВСТРЕЧА СРЕДИ ПИНГВИНОВ
Dialogue: 0,0:06:31.08,0:06:33.40,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ЗАПОМНИТСЯ. ПРАВДА,
Dialogue: 0,0:06:33.49,0:06:37.72,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ ВОПРОСЫ, ГАРАНТИИ БЕЗОПАСНОСТИ И УСЛОВИЯ ПРЕКРАЩЕНИЯ
Dialogue: 0,0:06:37.72,0:06:40.36,Caption,,0,0,0,,КОНФЛИКТА ОТ ПОЛЯРНОГО ПЕЙЗАЖА ПРОЩЕ НЕ СТАНУТ.
Dialogue: 0,0:06:40.77,0:06:43.56,Caption,,0,0,0,,ПИНГВИНЫ ТОЖЕ ВРЯД ЛИ ПОДСКАЖУТ КОМПРОМИСС. У НИХ
Dialogue: 0,0:06:43.64,0:06:45.48,Caption,,0,0,0,,СВОИХ ГРАНИЦ НА ЛЬДИНЕ ХВАТАЕТ.
Dialogue: 0,0:06:47.68,0:06:50.16,Caption,,0,0,0,,ВЫ БЫ СОГЛАСИЛИСЬ ОПЛАЧИВАТЬ МНОГОЛЕТНИЙ ПЛАН,
Dialogue: 0,0:06:50.32,0:06:52.96,Caption,,0,0,0,,ЕСЛИ ЕГО УЧАСТНИКИ ОДНОВРЕМЕННО ОБСУЖДАЮТ ВЫХОД ИЗ
Dialogue: 0,0:06:52.96,0:06:56.64,Caption,,0,0,0,,КОНФЛИКТА? НАПИШИТЕ В КОММЕНТАРИЯХ. ЗДЕСЬ КАК РАЗ НАЧИНАЕТСЯ
Dialogue: 0,0:06:56.64,0:06:59.44,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ ЕВРОПЕЙСКИЕ ПРАВИТЕЛЬСТВА СПОРЯТ О
Dialogue: 0,0:06:59.44,0:07:02.88,Caption,,0,0,0,,ГОДАХ, А УКРАИНСКИЕ ГОРОДА ЖИВУТ СОВСЕМ В ДРУГОМ МАСШТАБЕ
Dialogue: 0,0:07:02.88,0:07:08.51,Caption,,0,0,0,,ВРЕМЕНИ. ДЕПУТАТ ВЕРХОВНОЙ РАДЫ СЕРГЕЙ НАГОРНЯК ПРЕДУПРЕДИЛ,
Dialogue: 0,0:07:08.75,0:07:13.79,Caption,,0,0,0,,ЧТО ОТСУТСТВИЕ ТЕПЛА, ВОДЫ И ЭЛЕКТРИЧЕСТВА В КИЕВЕ МОЖЕТ ЗАКОНЧИТЬСЯ ТЕМ,
Dialogue: 0,0:07:14.03,0:07:16.43,Caption,,0,0,0,,ЧТО ЛЮДИ СМЕТУТ ВЛАСТЬ. ПОД РАЗДАЧУ,
Dialogue: 0,0:07:16.51,0:07:18.99,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ПОПАДУТ ЦЕНТРАЛЬНЫЕ ОРГАНЫ,
Dialogue: 0,0:07:19.08,0:07:22.75,Caption,,0,0,0,,ПАРЛАМЕНТ, ИСПОЛНИТЕЛЬНЫЕ СТРУКТУРЫ И МЕСТНЫЕ ЧИНОВНИКИ.
Dialogue: 0,0:07:22.99,0:07:25.31,Caption,,0,0,0,,РАЗБИРАТЬСЯ ПО КАБИНЕТАМ НИКТО НЕ СТАНЕТ.
Dialogue: 0,0:07:27.60,0:07:29.84,Caption,,0,0,0,,ЭТО ПРЕДУПРЕЖДЕНИЕ ЗВУЧИТ КУДА СЕРЬЁЗНЕЕ
Dialogue: 0,0:07:29.84,0:07:32.64,Caption,,0,0,0,,АНТАРКТИЧЕСКОГО ГАСТРОЛИРОВАНИЯ. КОГДА ПОДОБНОЕ
Dialogue: 0,0:07:32.64,0:07:34.64,Caption,,0,0,0,,ПРОИЗНОСИТ ДЕПУТАТ ВЕРХОВНОЙ РАДЫ,
Dialogue: 0,0:07:34.91,0:07:37.28,Caption,,0,0,0,,РЕЧЬ УЖЕ НЕ О РАЗДРАЖЕНИИ В СОЦИАЛЬНЫХ СЕТЯХ.
Dialogue: 0,0:07:37.68,0:07:40.96,Caption,,0,0,0,,ВЛАСТЬ ПОНИМАЕТ, ЧТО ТЕРПЕНИЕ ЖИТЕЛЕЙ ИМЕЕТ ПРЕДЕЛ,
Dialogue: 0,0:07:41.16,0:07:43.60,Caption,,0,0,0,,ПРИЧЁМ ИЗМЕРЯЕТСЯ ОН НЕ БЮДЖЕТНЫМИ ЦИКЛАМИ,
Dialogue: 0,0:07:43.76,0:07:50.12,Caption,,0,0,0,,А ТЕМПЕРАТУРОЙ В КВАРТИРЕ. ЭКСПЕРТ АНДРИАН ПРОКИП ГОВОРИТ ОБ ОПАСНОСТИ ДЛЯ
Dialogue: 0,0:07:50.12,0:07:54.12,Caption,,0,0,0,,КИЕВА, ОДЕССЫ И ДНЕПРА. ЕСЛИ БУДУТ ПОВРЕЖДЕНЫ КЛЮЧЕВЫЕ
Dialogue: 0,0:07:54.12,0:07:56.52,Caption,,0,0,0,,СОЕДИНЕНИЯ С ОБЪЕДИНЁННОЙ ЭНЕРГОСИСТЕМОЙ,
Dialogue: 0,0:07:56.81,0:07:59.40,Caption,,0,0,0,,КРУПНЫЕ ГОРОДА МОГУТ ОСТАТЬСЯ БЕЗ ЭЛЕКТРИЧЕСТВА НА
Dialogue: 0,0:07:59.40,0:08:02.12,Caption,,0,0,0,,СРОК ОТ ТРЁХ ДО ПЯТИ ДНЕЙ. ПРИ ТЯЖЁЛОМ
Dialogue: 0,0:08:02.12,0:08:05.00,Caption,,0,0,0,,РАЗВИТИИ СОБЫТИЙ ОТКЛЮЧЕНИЕ СПОСОБНО РАСТЯНУТЬСЯ ОТ
Dialogue: 0,0:08:05.08,0:08:11.12,Caption,,0,0,0,,ОДНОЙ ДО ДВУХ НЕДЕЛЬ. ДВЕ НЕДЕЛИ БЕЗ УСТОЙЧИВОГО ЭЛЕКТРОСНАБЖЕНИЯ ДЛЯ
Dialogue: 0,0:08:11.12,0:08:13.76,Caption,,0,0,0,,МНОГОМИЛЛИОННОГО ГОРОДА НЕЛЬЗЯ НАЗВАТЬ НЕУДОБСТВОМ.
Dialogue: 0,0:08:14.23,0:08:16.32,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО ТЯНЕТ ЗА СОБОЙ ВОДУ,
Dialogue: 0,0:08:16.40,0:08:19.44,Caption,,0,0,0,,ОТОПЛЕНИЕ, СВЯЗЬ, ГОРОДСКОЙ ТРАНСПОРТ,
Dialogue: 0,0:08:19.65,0:08:22.48,Caption,,0,0,0,,РАБОТУ МАГАЗИНОВ И НАСОСНЫХ СТАНЦИЙ. ОДНА
Dialogue: 0,0:08:22.56,0:08:25.28,Caption,,0,0,0,,ПОВРЕЖДЁННАЯ СИСТЕМА НАЧИНАЕТ ВЫКЛЮЧАТЬ ОСТАЛЬНЫЕ,
Dialogue: 0,0:08:25.52,0:08:28.32,Caption,,0,0,0,,И ГОРОД ПОСТЕПЕННО ПРЕВРАЩАЕТСЯ В ОГРОМНЫЙ ДОМ,
Dialogue: 0,0:08:28.48,0:08:31.68,Caption,,0,0,0,,ГДЕ ВЫБИЛО ПРОБКИ, ТОЛЬКО ЭЛЕКТРИКА ВЫЗВАТЬ НЕОТКУДА.
Dialogue: 0,0:08:33.95,0:08:37.47,Caption,,0,0,0,,КИЕВ, ОДЕССА ИЛИ ДНЕПР МОГУТ ОКАЗАТЬСЯ ЭНЕРГЕТИЧЕСКИМИ
Dialogue: 0,0:08:37.47,0:08:39.63,Caption,,0,0,0,,ОСТРОВАМИ. КРАСИВОЕ ВЫРАЖЕНИЕ,
Dialogue: 0,0:08:39.78,0:08:42.67,Caption,,0,0,0,,ПОКА НЕ ПОНИМАЕШЬ ЕГО СМЫСЛ. НА ТАКОМ ОСТРОВЕ
Dialogue: 0,0:08:42.67,0:08:46.03,Caption,,0,0,0,,НЕТ ПАЛЬМ И КОКТЕЙЛЕЙ. ТАМ ЕСТЬ НЕРАБОТАЮЩИЕ НАСОСЫ,
Dialogue: 0,0:08:46.27,0:08:51.15,Caption,,0,0,0,,ОСТЫВАЮЩИЕ БАТАРЕИ И ТЕЛЕФОН, ЗАРЯД КОТОРОГО ВНЕЗАПНО СТАНОВИТСЯ СЕМЕЙНЫМ
Dialogue: 0,0:08:51.15,0:08:57.19,Caption,,0,0,0,,СТРАТЕГИЧЕСКИМ РЕЗЕРВОМ. В БРЮССЕЛЕ В ЭТО ВРЕМЯ ОБСУЖДАЮТ РАСХОДЫ ДО
Dialogue: 0,0:08:57.27,0:08:59.91,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТОГО ГОДА. ВОЕННЫЕ
Dialogue: 0,0:08:59.99,0:09:02.55,Caption,,0,0,0,,ПРОГРАММЫ РАССЧИТАНЫ ДО НОЯБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:09:02.63,0:09:05.43,Caption,,0,0,0,,ВОСЬМОГО. РАКЕТЫ ОБЕЩАЮТ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:09:05.43,0:09:08.15,Caption,,0,0,0,,СЕДЬМОМ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДАХ. А
Dialogue: 0,0:09:08.15,0:09:10.15,Caption,,0,0,0,,ЖИТЕЛЮ ХОЛОДНОЙ КВАРТИРЫ НУЖНО ЗНАТЬ,
Dialogue: 0,0:09:10.38,0:09:13.03,Caption,,0,0,0,,БУДЕТ ЛИ ВОДА ВЕЧЕРОМ. ВОТ И ВСЯ РАЗНИЦА
Dialogue: 0,0:09:13.03,0:09:15.91,Caption,,0,0,0,,МЕЖДУ ВЕРХНИМ ЭТАЖОМ УПРАВЛЕНИЯ И ПЕРВЫМ ЭТАЖОМ
Dialogue: 0,0:09:15.91,0:09:21.86,Caption,,0,0,0,,РЕАЛЬНОСТИ. ЧИНОВНИК МОЖЕТ ОТКРЫТЬ ПРЕЗЕНТАЦИЮ И ПОКАЗАТЬ ГРАФИК
Dialogue: 0,0:09:21.86,0:09:25.38,Caption,,0,0,0,,БУДУЩИХ ПОСТАВОК. ЧЕЛОВЕК БЕЗ СВЕТА ОТКРОЕТ КРАН И
Dialogue: 0,0:09:25.38,0:09:29.38,Caption,,0,0,0,,УВИДИТ, ЧТО ТАМ НИЧЕГО НЕТ. ПОСЛЕ ТАКОГО НАГЛЯДНОГО ПОСОБИЯ
Dialogue: 0,0:09:29.38,0:09:31.78,Caption,,0,0,0,,ДОВЕРИЕ К ПРЕЗЕНТАЦИИ ОБЫЧНО НЕ ВОЗРАСТАЕТ.
Dialogue: 0,0:09:33.98,0:09:36.54,Caption,,0,0,0,,НЕСКОЛЬКО ЧАСОВ ОТКЛЮЧЕНИЯ ЕЩЁ МОЖНО СПИСАТЬ НА
Dialogue: 0,0:09:36.54,0:09:39.50,Caption,,0,0,0,,АВАРИЮ. ЧЕРЕЗ НЕСКОЛЬКО ДНЕЙ ВОПРОСЫ ПЕРЕХОДЯТ ОТ
Dialogue: 0,0:09:39.50,0:09:42.22,Caption,,0,0,0,,ЭНЕРГЕТИКОВ К ГОРОДСКОМУ РУКОВОДСТВУ. ЕСЛИ
Dialogue: 0,0:09:42.22,0:09:45.18,Caption,,0,0,0,,ОДНОВРЕМЕННО ИСЧЕЗАЮТ СВЕТ, ВОДА И ТЕПЛО,
Dialogue: 0,0:09:45.41,0:09:47.98,Caption,,0,0,0,,ГРАЖДАН УЖЕ МАЛО ИНТЕРЕСУЕТ СХЕМА РАСПРЕДЕЛЕНИЯ
Dialogue: 0,0:09:47.98,0:09:50.38,Caption,,0,0,0,,ПОЛНОМОЧИЙ. ОНИ НЕ СТАНУТ ВЫЯСНЯТЬ,
Dialogue: 0,0:09:50.54,0:09:53.10,Caption,,0,0,0,,ЧЬЯ ПОДПИСЬ СТОЯЛА НА НЕПРАВИЛЬНОМ РЕШЕНИИ.
Dialogue: 0,0:09:53.42,0:09:56.46,Caption,,0,0,0,,ОТВЕТСТВЕННЫМ НАЗНАЧАТ ВСЕХ, КОГО УВИДЯТ В КАБИНЕТАХ.
Dialogue: 0,0:09:58.74,0:10:01.54,Caption,,0,0,0,,ИМЕННО ОБ ЭТОМ ГОВОРИТ НАГОРНЯК. ГНЕВ НЕ БУДЕТ
Dialogue: 0,0:10:01.54,0:10:04.26,Caption,,0,0,0,,ХОДИТЬ ПО ИНСТАНЦИЯМ С ТАЛОНЧИКОМ. ВСПОМНЯТ И
Dialogue: 0,0:10:04.26,0:10:06.34,Caption,,0,0,0,,ЦЕНТРАЛЬНУЮ ВЛАСТЬ, И ПАРЛАМЕНТ,
Dialogue: 0,0:10:06.44,0:10:09.22,Caption,,0,0,0,,И МЕСТНЫХ ЧИНОВНИКОВ. ПУШКИНСКОЕ ПРЕДУПРЕЖДЕНИЕ О
Dialogue: 0,0:10:09.22,0:10:11.46,Caption,,0,0,0,,РУССКОМ БУНТЕ ЗДЕСЬ ЗВУЧИТ НЕ ЛИТЕРАТУРНЫМ
Dialogue: 0,0:10:11.46,0:10:15.30,Caption,,0,0,0,,УКРАШЕНИЕМ, А ВПОЛНЕ ПРАКТИЧЕСКИМ ПРОГНОЗОМ. БУНТ НЕ ЧИТАЕТ
Dialogue: 0,0:10:15.30,0:10:18.10,Caption,,0,0,0,,ДОЛЖНОСТНЫЕ ИНСТРУКЦИИ И НЕ ЖДЁТ КВАЛИФИЦИРОВАННОГО
Dialogue: 0,0:10:18.10,0:10:21.82,Caption,,0,0,0,,БОЛЬШИНСТВА. ПОДПИШИТЕСЬ,
Dialogue: 0,0:10:21.91,0:10:24.78,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ДАЛЬШЕ ЕВРОПЕЙСКИЙ ПЛАН
Dialogue: 0,0:10:24.78,0:10:28.70,Caption,,0,0,0,,СТАЛКИВАЕТСЯ С ТОЙ СИЛОЙ, КОТОРУЮ НЕВОЗМОЖНО ВНЕСТИ ОТДЕЛЬНОЙ СТРОКОЙ В
Dialogue: 0,0:10:28.70,0:10:34.83,Caption,,0,0,0,,БЮДЖЕТ. МЕРЦ СПОСОБЕН ПРОДАВИТЬ ВЕНГРИЮ И СЛОВАКИЮ. ГЕРМАНИЯ
Dialogue: 0,0:10:34.83,0:10:36.75,Caption,,0,0,0,,МОЖЕТ УГРОЖАТЬ БЛОКИРОВКОЙ БЮДЖЕТА,
Dialogue: 0,0:10:36.99,0:10:39.79,Caption,,0,0,0,,СОБИРАТЬ БОЛЬШИНСТВО И УБЕЖДАТЬ ОСТАЛЬНЫЕ СТОЛИЦЫ,
Dialogue: 0,0:10:39.95,0:10:42.91,Caption,,0,0,0,,ЧТО ПЛАТИТЬ ПРИДЁТСЯ ВСЕМ. НО ДАЖЕ НЕМЕЦКИЙ
Dialogue: 0,0:10:42.91,0:10:45.87,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЙ ВЕС НЕ ЗАСТАВИТ ЖИТЕЛЕЙ КИЕВА СПОКОЙНО
Dialogue: 0,0:10:45.87,0:10:49.87,Caption,,0,0,0,,ПРОЖИТЬ ДВЕ НЕДЕЛИ БЕЗ СВЕТА, ВОДЫ И ОТОПЛЕНИЯ РАДИ ПОСТАВОК,
Dialogue: 0,0:10:50.03,0:10:56.63,Caption,,0,0,0,,НАМЕЧЕННЫХ НА СЛЕДУЮЩИЙ ГОД. ЕВРОПЕЙСКИЕ РУКОВОДИТЕЛИ ВСЁ ЕЩЁ ИСХОДЯТ ИЗ ТОГО,
Dialogue: 0,0:10:56.87,0:10:59.11,Caption,,0,0,0,,ЧТО ДОСТАТОЧНО СОХРАНИТЬ ФИНАНСИРОВАНИЕ,
Dialogue: 0,0:10:59.19,0:11:04.31,Caption,,0,0,0,,ОБУЧЕНИЕ И ПРОИЗВОДСТВО, А ОБЩЕСТВО ВЫДЕРЖИТ ПОСЛЕДСТВИЯ. ТОЛЬКО ОБЩЕСТВО НЕ
Dialogue: 0,0:11:04.31,0:11:06.71,Caption,,0,0,0,,ПОДПИСЫВАЛО ОБЯЗАТЕЛЬСТВО ТЕРПЕТЬ ДО ДВЕ ТЫСЯЧИ
Dialogue: 0,0:11:06.71,0:11:09.91,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОГО ГОДА. И ПЕЧАТИ ЕВРОСОЮЗА ПОД ТАКИМ
Dialogue: 0,0:11:09.91,0:11:16.28,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВОМ ТОЖЕ НЕТ. ЕСЛИ КРУПНЫЕ ГОРОДА НАДОЛГО ПОГРУЗЯТСЯ ВО ТЬМУ И
Dialogue: 0,0:11:16.28,0:11:19.80,Caption,,0,0,0,,ХОЛОД, ЛЮДИ МОГУТ ПОТРЕБОВАТЬ НЕ ОЧЕРЕДНОГО ПАКЕТА ПОМОЩИ,
Dialogue: 0,0:11:19.96,0:11:22.28,Caption,,0,0,0,,А ОКОНЧАНИЯ КОНФЛИКТА. НЕ ПОТОМУ,
Dialogue: 0,0:11:22.44,0:11:25.32,Caption,,0,0,0,,ЧТО ОНИ ИЗУЧИЛИ ВСЕ ВАРИАНТЫ ГАРАНТИЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:11:25.63,0:11:28.60,Caption,,0,0,0,,ПРОСТО НОРМАЛЬНАЯ ЖИЗНЬ ИЗ ВЫСОКОЙ ЦЕЛИ ВНЕЗАПНО
Dialogue: 0,0:11:28.60,0:11:31.56,Caption,,0,0,0,,ПРЕВРАТИТСЯ В СРОЧНУЮ НЕОБХОДИМОСТЬ. ЧЕЛОВЕКУ БЕЗ
Dialogue: 0,0:11:31.56,0:11:33.32,Caption,,0,0,0,,ВОДЫ ТРУДНО ПРОДАТЬ СТРАТЕГИЮ,
Dialogue: 0,0:11:33.55,0:11:35.48,Caption,,0,0,0,,РАССЧИТАННУЮ ДО СЛЕДУЮЩЕЙ СЕМИЛЕТКИ.
Dialogue: 0,0:11:37.75,0:11:40.95,Caption,,0,0,0,,ОТСЮДА И ГЛАВНЫЙ РАЗЛОМ СРЕДИ СОЮЗНИКОВ. ОДНИ ВИДЯТ,
Dialogue: 0,0:11:41.10,0:11:43.67,Caption,,0,0,0,,ЧТО ПРЕЖНИЙ ПУТЬ НЕ ПРИВЁЛ К ЗАЯВЛЕННОЙ ТОЧКЕ,
Dialogue: 0,0:11:43.98,0:11:47.19,Caption,,0,0,0,,ПОЭТОМУ ДОПУСКАЮТ УСТУПКИ И ИЩУТ УСЛОВИЯ СОГЛАШЕНИЯ.
Dialogue: 0,0:11:47.59,0:11:50.31,Caption,,0,0,0,,ДРУГИЕ НАМЕРЕНЫ ПРОДОЛЖАТЬ ДВИЖЕНИЕ И ЗАРАНЕЕ
Dialogue: 0,0:11:50.31,0:11:53.67,Caption,,0,0,0,,ОПЛАЧИВАЮТ СЛЕДУЮЩИЕ ГОДЫ. МЕРЦ ИДЁТ ЕЩЁ ДАЛЬШЕ ОН
Dialogue: 0,0:11:53.67,0:11:56.71,Caption,,0,0,0,,ТРЕБУЕТ, ЧТОБЫ СОМНЕВАЮЩИЕСЯ ТОЖЕ КУПИЛИ БИЛЕТ,
Dialogue: 0,0:11:56.95,0:11:59.59,Caption,,0,0,0,,А ПРАВО ВЫЙТИ ИЗ ВАГОНА ОТМЕНИЛИ ГОЛОСОВАНИЕМ.
Dialogue: 0,0:12:01.86,0:12:04.50,Caption,,0,0,0,,ТАКОЕ УПОРСТВО ЛЕГКО ВЫДАВАТЬ ЗА ПРИНЦИПИАЛЬНОСТЬ,
Dialogue: 0,0:12:04.74,0:12:07.94,Caption,,0,0,0,,ПОКА СЧЁТ ОПЛАЧИВАЕТ КТО ТО ДРУГОЙ. НО ЕВРОПЕЙСКИЕ
Dialogue: 0,0:12:07.94,0:12:11.14,Caption,,0,0,0,,ДЕНЬГИ БЕРУТСЯ ИЗ НАЛОГОВ, РАКЕТЫ ТРЕБУЮТ ЗАВОДОВ,
Dialogue: 0,0:12:11.37,0:12:13.70,Caption,,0,0,0,,А УКРАИНСКОЕ ТЕРПЕНИЕ ЗАВИСИТ ОТ ТОГО,
Dialogue: 0,0:12:13.86,0:12:16.90,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ В ДОМАХ. У КАЖДОГО РЕСУРСА ЕСТЬ
Dialogue: 0,0:12:16.90,0:12:21.78,Caption,,0,0,0,,ПРЕДЕЛ. ДАЖЕ У КРАСИВЫХ СЛОВ, ХОТЯ ИХ В БРЮССЕЛЕ НАУЧИЛИСЬ ПРОИЗВОДИТЬ ПОЧТИ БЕЗ
Dialogue: 0,0:12:21.78,0:12:27.32,Caption,,0,0,0,,ОГРАНИЧЕНИЙ. ИСТОРИЯ С АНТАРКТИДОЙ НА ЭТОМ ФОНЕ ВЫГЛЯДИТ НЕ
Dialogue: 0,0:12:27.32,0:12:29.40,Caption,,0,0,0,,ПРОСТО ШУТКОЙ. ОНА ПОКАЗЫВАЕТ,
Dialogue: 0,0:12:29.64,0:12:32.28,Caption,,0,0,0,,НАСКОЛЬКО ПУБЛИЧНАЯ СЦЕНА ОТОРВАЛАСЬ ОТ БЫТОВОЙ
Dialogue: 0,0:12:32.28,0:12:35.16,Caption,,0,0,0,,РЕАЛЬНОСТИ. НАВЕРХУ ВЫБИРАЮТ МЕСТО ВСТРЕЧИ,
Dialogue: 0,0:12:35.32,0:12:37.88,Caption,,0,0,0,,СПОРЯТ О ПРОЦЕДУРЕ ГОЛОСОВАНИЯ И СОСТАВЛЯЮТ
Dialogue: 0,0:12:37.88,0:12:40.36,Caption,,0,0,0,,ПРОГРАММЫ НА ГОДЫ. ВНИЗУ ВЫЯСНЯЮТ,
Dialogue: 0,0:12:40.53,0:12:43.48,Caption,,0,0,0,,СКОЛЬКО ЧАСОВ ПРОДЕРЖИТСЯ ОТОПЛЕНИЕ ПОСЛЕ ОТКЛЮЧЕНИЯ
Dialogue: 0,0:12:43.48,0:12:49.51,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА. ПИНГВИНЫ ВСТРЕЧУ ПЕРЕЖИВУТ. У НИХ С ХОЛОДОМ ДАВНИЕ
Dialogue: 0,0:12:49.59,0:12:52.63,Caption,,0,0,0,,РАБОЧИЕ ОТНОШЕНИЯ. А ВОТ ЖИТЕЛЯМ УКРАИНСКИХ ГОРОДОВ
Dialogue: 0,0:12:52.64,0:12:55.35,Caption,,0,0,0,,ОБЕЩАНИЕ РАКЕТ ЧЕРЕЗ ДВА ГОДА ВМЕСТО ТЕПЛА ЭТОЙ
Dialogue: 0,0:12:55.35,0:12:58.23,Caption,,0,0,0,,ЗИМОЙ МОЖЕТ ПОКАЗАТЬСЯ НЕУДАЧНЫМ ОБМЕНОМ.
Dialogue: 0,0:13:00.50,0:13:03.22,Caption,,0,0,0,,МЕРЦ ХОЧЕТ ЗАКРЕПИТЬ ПРОДОЛЖЕНИЕ НЫНЕШНЕГО КУРСА
Dialogue: 0,0:13:03.30,0:13:07.38,Caption,,0,0,0,,ДЕНЬГАМИ, ПРАВИЛАМИ ГОЛОСОВАНИЯ И НЕМЕЦКИМ ВЛИЯНИЕМ. ОДНАКО
Dialogue: 0,0:13:07.38,0:13:10.50,Caption,,0,0,0,,БЮДЖЕТНАЯ БЛОКИРОВКА НЕ УСТРАНЯЕТ РАСКОЛ. ОНА ЛИШЬ
Dialogue: 0,0:13:10.50,0:13:14.02,Caption,,0,0,0,,ДОКАЗЫВАЕТ, ЧТО ДОБРОВОЛЬНО СЛЕДОВАТЬ ЗА БЕРЛИНОМ ГОТОВЫ УЖЕ НЕ
Dialogue: 0,0:13:14.02,0:13:17.38,Caption,,0,0,0,,ВСЕ. КОГДА ЕДИНСТВО ПРИХОДИТСЯ ОБЕСПЕЧИВАТЬ УГРОЗОЙ,
Dialogue: 0,0:13:17.60,0:13:20.02,Caption,,0,0,0,,ОНО ПРЕВРАЩАЕТСЯ В ДИСЦИПЛИНУ ПОД НАДЗОРОМ.
Dialogue: 0,0:13:22.29,0:13:27.09,Caption,,0,0,0,,ИРОНИЯ В ТОМ, ЧТО ЧЕЛОВЕК, ПРЕДЛАГАЮЩИЙ РАЗГОВАРИВАТЬ С РОССИЕЙ С ПОЗИЦИИ СИЛЫ,
Dialogue: 0,0:13:27.49,0:13:29.81,Caption,,0,0,0,,ПЕРВЫМ ДЕЛОМ ПРИМЕНИЛ СИЛУ ПРОТИВ СОБСТВЕННЫХ
Dialogue: 0,0:13:29.81,0:13:32.37,Caption,,0,0,0,,ПАРТНЁРОВ. ПОКА ЭТО ФИНАНСОВОЕ ДАВЛЕНИЕ,
Dialogue: 0,0:13:32.61,0:13:35.73,Caption,,0,0,0,,НО СМЫСЛ ПРЕДЕЛЬНО ЯСЕН НЕСОГЛАСНЫМ ПРЕДЛАГАЮТ ЛИБО
Dialogue: 0,0:13:35.73,0:13:39.81,Caption,,0,0,0,,ПОДЧИНИТЬСЯ, ЛИБО ОСТАТЬСЯ БЕЗ ОБЩЕГО БЮДЖЕТА. ЕВРОПА ЕЩЁ НЕ
Dialogue: 0,0:13:39.81,0:13:42.77,Caption,,0,0,0,,ПОБЕДИЛА ВНЕШНЕГО ПРОТИВНИКА, ЗАТО УЖЕ НАШЛА,
Dialogue: 0,0:13:42.85,0:13:49.30,Caption,,0,0,0,,КОМУ ВЫКРУЧИВАТЬ РУКИ ВНУТРИ. ГЛАВНАЯ ОПАСНОСТЬ ДЛЯ ЭТОГО ПЛАНА НАХОДИТСЯ НЕ ЗА
Dialogue: 0,0:13:49.30,0:13:52.50,Caption,,0,0,0,,СТОЛОМ ПЕРЕГОВОРОВ И НЕ СРЕДИ ВЕНГЕРСКИХ ВОЗРАЖЕНИЙ.
Dialogue: 0,0:13:52.98,0:13:54.98,Caption,,0,0,0,,ОНА СИДИТ В ТЁМНОЙ КВАРТИРЕ И СМОТРИТ НА
Dialogue: 0,0:13:54.98,0:13:58.10,Caption,,0,0,0,,ОСТЫВАЮЩУЮ БАТАРЕЮ. У НЕЁ НЕТ ПРАВА ВЕТО,
Dialogue: 0,0:13:58.18,0:14:01.14,Caption,,0,0,0,,МЕСТА В ЕВРОПЕЙСКОМ СОВЕТЕ И МИКРОФОНА В ПАРЛАМЕНТЕ.
Dialogue: 0,0:14:01.38,0:14:03.86,Caption,,0,0,0,,ЗАТО ТАКИХ КВАРТИР МОГУТ БЫТЬ СОТНИ ТЫСЯЧ.
Dialogue: 0,0:14:06.15,0:14:10.63,Caption,,0,0,0,,ЕСЛИ СВЕТ ВЕРНЁТСЯ БЫСТРО, ДЛИННЫЕ ПРОГРАММЫ ПРОДОЛЖАТ ОБСУЖДАТЬ ПРИВЫЧНЫМ
Dialogue: 0,0:14:10.71,0:14:13.67,Caption,,0,0,0,,ТОНОМ. ЕСЛИ ОТКЛЮЧЕНИЯ РАСТЯНУТСЯ НА НЕДЕЛИ,
Dialogue: 0,0:14:13.91,0:14:16.79,Caption,,0,0,0,,КАЛЕНДАРЬ МЕРЦА НИКОГО НЕ СПАСЁТ. ТОГДА РЕШЕНИЯ
Dialogue: 0,0:14:16.79,0:14:20.47,Caption,,0,0,0,,БУДУТ ПРИНИМАТЬ НЕ ТЕ, КТО ЗАПЛАНИРОВАЛ ШЕСТЬСОТ РАКЕТ НА ДВЕ ТЫСЯЧИ
Dialogue: 0,0:14:20.47,0:14:24.71,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОЙ ГОД, А ТЕ, КОМУ СЕГОДНЯ НЕЧЕМ СОГРЕТЬ РЕБЁНКА.
Dialogue: 0,0:14:26.92,0:14:28.68,Caption,,0,0,0,,ЕВРОПА МОЖЕТ УТВЕРДИТЬ БЮДЖЕТ,
Dialogue: 0,0:14:28.84,0:14:31.64,Caption,,0,0,0,,ПРОДЛИТЬ ВОЕННУЮ МИССИЮ И ОТКРЫТЬ ПРОИЗВОДСТВО В
Dialogue: 0,0:14:31.64,0:14:34.92,Caption,,0,0,0,,ПОЛЬШЕ. НЕЛЬЗЯ УТВЕРДИТЬ ПОСТАНОВЛЕНИЕМ ЧЕЛОВЕЧЕСКОЕ
Dialogue: 0,0:14:34.92,0:14:37.96,Caption,,0,0,0,,ТЕРПЕНИЕ. ОНО ЗАКАНЧИВАЕТСЯ БЕЗ ГОЛОСОВАНИЯ,
Dialogue: 0,0:14:38.20,0:14:41.32,Caption,,0,0,0,,БЕЗ ПОВЕСТКИ ЗАСЕДАНИЯ И БЕЗ УВАЖИТЕЛЬНОЙ ПРИЧИНЫ.
Dialogue: 0,0:14:43.58,0:14:46.30,Caption,,0,0,0,,ВОТ ПОЧЕМУ НАСТОЯЩАЯ РАЗВИЛКА ПРОХОДИТ НЕ МЕЖДУ
Dialogue: 0,0:14:46.30,0:14:49.58,Caption,,0,0,0,,МОСКВОЙ И АНТАРКТИДОЙ. ОНА ПРОХОДИТ МЕЖДУ ПЛАНОМ НА
Dialogue: 0,0:14:49.58,0:14:53.02,Caption,,0,0,0,,ГОДЫ И ЖИЗНЬЮ ДО ВЕЧЕРА. МЕРЦ ПЫТАЕТСЯ ЗАСТАВИТЬ
Dialogue: 0,0:14:53.10,0:14:55.82,Caption,,0,0,0,,ВСЕХ ОПЛАТИТЬ ПЕРВЫЙ ВАРИАНТ. НО ЕСЛИ ВТОРОЙ
Dialogue: 0,0:14:55.82,0:14:58.94,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО РАЗВАЛИТСЯ, СЧЁТ ЕМУ ПРЕДЪЯВЯТ ЛЮДИ,
Dialogue: 0,0:14:59.18,0:15:02.14,Caption,,0,0,0,,КОТОРЫХ НИКТО НЕ ПРИГЛАСИЛ ЗА СТОЛ. И РАЗГОВАРИВАТЬ
Dialogue: 0,0:15:02.22,0:15:04.30,Caption,,0,0,0,,ОНИ БУДУТ НА ТОМ САМОМ ЯЗЫКЕ СИЛЫ,
Dialogue: 0,0:15:04.46,0:15:07.02,Caption,,0,0,0,,КОТОРЫЙ ФРИДРИХ ТАК ЛЮБИТ РЕКОМЕНДОВАТЬ ДРУГИМ.
