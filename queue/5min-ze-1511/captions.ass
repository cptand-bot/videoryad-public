Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,НУ ЧТО, ДОИГРАЛИСЬ? В МОСКВЕ, ПОХОЖЕ,
Dialogue: 0,0:00:03.24,0:00:06.04,Caption,,0,0,0,,РЕШИЛИ ПЕРЕСМОТРЕТЬ ОДНО СТАРОЕ ПРАВИЛО. ПРИЧЁМ
Dialogue: 0,0:00:06.04,0:00:08.68,Caption,,0,0,0,,ТАКОЕ, О КОТОРОМ РАНЬШЕ ПРЕДПОЧИТАЛИ ВООБЩЕ НЕ
Dialogue: 0,0:00:08.68,0:00:11.32,Caption,,0,0,0,,РАЗГОВАРИВАТЬ. И ВОТ ТУТ У НЕКОТОРЫХ ТОВАРИЩЕЙ В
Dialogue: 0,0:00:11.40,0:00:14.36,Caption,,0,0,0,,КИЕВЕ НАСТРОЕНИЕ ДОЛЖНО ЗАМЕТНО ИСПОРТИТЬСЯ. ПОТОМУ
Dialogue: 0,0:00:14.44,0:00:18.44,Caption,,0,0,0,,ЧТО ОДНО ДЕЛО, КОГДА ТЕБЕ ГОДАМИ РАССКАЗЫВАЮТ О КРАСНЫХ ЛИНИЯХ. И
Dialogue: 0,0:00:18.44,0:00:21.56,Caption,,0,0,0,,СОВСЕМ ДРУГОЕ, КОГДА НАЧИНАЮТ ПОЯВЛЯТЬСЯ СООБЩЕНИЯ,
Dialogue: 0,0:00:21.78,0:00:24.36,Caption,,0,0,0,,ЧТО ЭТИ ЛИНИИ БОЛЬШЕ НЕ ДЕЙСТВУЮТ. ПРАВДА,
Dialogue: 0,0:00:24.51,0:00:27.32,Caption,,0,0,0,,ПОКА ЭТО ТОЛЬКО ИНСАЙДЫ. НО ОТКУДА ОНИ ВЗЯЛИСЬ
Dialogue: 0,0:00:27.32,0:00:29.72,Caption,,0,0,0,,ИМЕННО СЕЙЧАС И ПОЧЕМУ ЗАГОВОРИЛИ О ТОМ,
Dialogue: 0,0:00:29.88,0:00:34.44,Caption,,0,0,0,,О ЧЁМ РАНЬШЕ МОЛЧАЛИ? ДАВАЙТЕ РАЗБИРАТЬСЯ. ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ОТДЕЛЬНЫЕ
Dialogue: 0,0:00:34.44,0:00:39.00,Caption,,0,0,0,,ЗАГОЛОВКИ, А ТО, КАК ЭТИ СОБЫТИЯ НАЧИНАЮТ ЦЕПЛЯТЬСЯ ОДНО ЗА ДРУГОЕ,
Dialogue: 0,0:00:39.12,0:00:42.28,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ПОТОМУ ЧТО СЕГОДНЯ ИСТОРИЯ ИМЕННО
Dialogue: 0,0:00:42.28,0:00:45.48,Caption,,0,0,0,,ТАКАЯ. В СЕТИ ПОЯВИЛИСЬ НЕПОДТВЕРЖДЁННЫЕ СООБЩЕНИЯ О
Dialogue: 0,0:00:45.48,0:00:48.84,Caption,,0,0,0,,ТОМ, ЧТО В КРЕМЛЕ НА ЗАКРЫТОМ УРОВНЕ ЯКОБЫ ОБСУЖДАЛИ
Dialogue: 0,0:00:48.84,0:00:51.80,Caption,,0,0,0,,ОТМЕНУ ПРЕЖНЕГО НЕГЛАСНОГО ОГРАНИЧЕНИЯ НА ДЕЙСТВИЯ
Dialogue: 0,0:00:51.80,0:00:54.28,Caption,,0,0,0,,ПРОТИВ ВЫСШЕГО ВОЕННО ПОЛИТИЧЕСКОГО РУКОВОДСТВА
Dialogue: 0,0:00:54.28,0:00:57.16,Caption,,0,0,0,,УКРАИНЫ. РЕЧЬ УЖЕ НЕ ПРО ЭЛЕКТРОСТАНЦИИ,
Dialogue: 0,0:00:57.24,0:01:01.32,Caption,,0,0,0,,СКЛАДЫ, АЭРОДРОМЫ ИЛИ ЗАВОДЫ. РЕЧЬ ПРО КОНКРЕТНЫХ ЛЮДЕЙ.
Dialogue: 0,0:01:01.64,0:01:03.72,Caption,,0,0,0,,ЗЕЛЕНСКОГО, ВЫСШИХ ЧИНОВНИКОВ,
Dialogue: 0,0:01:03.96,0:01:05.64,Caption,,0,0,0,,ЛЮДЕЙ ИЗ ВОЕННОГО РУКОВОДСТВА,
Dialogue: 0,0:01:05.72,0:01:08.60,Caption,,0,0,0,,ГЕНЕРАЛОВ ГЕНШТАБА. ОФИЦИАЛЬНОГО ПОДТВЕРЖДЕНИЯ НЕТ.
Dialogue: 0,0:01:08.76,0:01:11.72,Caption,,0,0,0,,РЕЧЬ ИМЕННО О НЕПОДТВЕРЖДЁННЫХ СВЕДЕНИЯХ. НО САМ
Dialogue: 0,0:01:11.72,0:01:13.88,Caption,,0,0,0,,МОМЕНТ ПОЯВЛЕНИЯ ЭТОЙ ИСТОРИИ ЗАНЯТНЫЙ.
Dialogue: 0,0:01:16.16,0:01:18.96,Caption,,0,0,0,,ПОТОМУ ЧТО РАНЬШЕ ЛОГИКА МОСКВЫ ЗВУЧАЛА СОВСЕМ ИНАЧЕ
Dialogue: 0,0:01:19.04,0:01:22.00,Caption,,0,0,0,,РУКОВОДСТВО УКРАИНЫ, КАКИМ БЫ К НЕМУ НИ БЫЛО ОТНОШЕНИЕ,
Dialogue: 0,0:01:22.24,0:01:24.64,Caption,,0,0,0,,ВСЁ РАВНО НУЖНО ДЛЯ ПЕРЕГОВОРОВ. С КЕМ ТО
Dialogue: 0,0:01:24.64,0:01:26.24,Caption,,0,0,0,,ЖЕ ПОТОМ ПРИДЁТСЯ РАЗГОВАРИВАТЬ,
Dialogue: 0,0:01:26.48,0:01:29.28,Caption,,0,0,0,,КОМУ ТО ПРИДЁТСЯ ЧТО ТО ПОДПИСЫВАТЬ. А ТЕПЕРЬ
Dialogue: 0,0:01:29.36,0:01:32.24,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ СОВСЕМ ДРУГАЯ РИТОРИКА. И ПОЯВИЛАСЬ ОНА
Dialogue: 0,0:01:32.32,0:01:34.64,Caption,,0,0,0,,НЕ В ПУСТОМ МЕСТЕ. ЗА ПОСЛЕДНИЕ ГОДЫ МЫ
Dialogue: 0,0:01:34.72,0:01:36.40,Caption,,0,0,0,,УЖЕ ВИДЕЛИ ВЗРЫВЫ АВТОМОБИЛЕЙ,
Dialogue: 0,0:01:36.57,0:01:39.52,Caption,,0,0,0,,УБИЙСТВА РОССИЙСКИХ ВОЕННЫХ, АТАКИ НА ЛЮДЕЙ,
Dialogue: 0,0:01:39.68,0:01:42.72,Caption,,0,0,0,,СВЯЗАННЫХ С АРМИЕЙ И ГОСУДАРСТВЕННЫМИ СТРУКТУРАМИ. И
Dialogue: 0,0:01:42.72,0:01:45.68,Caption,,0,0,0,,ВОТ ЗДЕСЬ ВОЗНИКАЕТ СОВЕРШЕННО ПРОСТОЙ ВОПРОС. ЕСЛИ
Dialogue: 0,0:01:45.76,0:01:49.92,Caption,,0,0,0,,ОДНА СТОРОНА СЧИТАЕТ, ЧТО МОЖЕТ ПЕРЕНОСИТЬ ПОДОБНЫЕ МЕТОДЫ ВСЁ ДАЛЬШЕ И
Dialogue: 0,0:01:50.00,0:01:54.88,Caption,,0,0,0,,ДАЛЬШЕ, ПОЧЕМУ ОНА УВЕРЕНА, ЧТО ВТОРАЯ СТОРОНА БУДЕТ ВЕЧНО СОБЛЮДАТЬ СТАРЫЕ
Dialogue: 0,0:01:54.88,0:01:58.64,Caption,,0,0,0,,ОГРАНИЧЕНИЯ? ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ ПОЛУЧАЕТСЯ. ЗДЕСЬ МОЖНО
Dialogue: 0,0:01:58.72,0:02:01.92,Caption,,0,0,0,,ПОВЫШАТЬ СТАВКИ, ТАМ МОЖНО УСТРАИВАТЬ НОВЫЕ ОПЕРАЦИИ,
Dialogue: 0,0:02:02.08,0:02:04.64,Caption,,0,0,0,,ПОТОМ ЕЩЁ НЕМНОЖКО ПОДВИНУТЬ ГРАНИЦУ ДОЗВОЛЕННОГО,
Dialogue: 0,0:02:04.88,0:02:09.44,Caption,,0,0,0,,А МОСКВА, БУДЬТЕ ДОБРЫ, ПРОДОЛЖАЙТЕ ИГРАТЬ ПО ПРЕЖНИМ ПРАВИЛАМ. ЁЛЫ ПАЛЫ,
Dialogue: 0,0:02:09.60,0:02:13.28,Caption,,0,0,0,,А ПОЧЕМУ? И ЗДЕСЬ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ВЕРСИЯ ЗЕЛЕНСКИЙ И
Dialogue: 0,0:02:13.28,0:02:16.08,Caption,,0,0,0,,ЕГО СОЮЗНИКИ САМИ ВСЁ СИЛЬНЕЕ ТОЛКАЮТ КРЕМЛЬ К
Dialogue: 0,0:02:16.08,0:02:18.64,Caption,,0,0,0,,ЖЁСТКОЙ ОТВЕТНОЙ РЕАКЦИИ. НЕ ПОТОМУ,
Dialogue: 0,0:02:18.87,0:02:21.84,Caption,,0,0,0,,ЧТО ИМ ОБЯЗАТЕЛЬНО НУЖЕН КОНКРЕТНЫЙ УДАР. ИМ НУЖНА
Dialogue: 0,0:02:21.84,0:02:24.08,Caption,,0,0,0,,САМА НОВАЯ СТУПЕНЬ КОНФРОНТАЦИИ.
Dialogue: 0,0:02:26.35,0:02:30.19,Caption,,0,0,0,,ЧЕМ ЖЁСТЧЕ ОТВЕЧАЕТ РОССИЯ, ТЕМ ЛЕГЧЕ ПОТОМ ОБЪЯСНЯТЬ ЕВРОПЕ,
Dialogue: 0,0:02:30.45,0:02:32.83,Caption,,0,0,0,,ЗАЧЕМ СНОВА НУЖНЫ ДЕНЬГИ, ОРУЖИЕ,
Dialogue: 0,0:02:32.92,0:02:38.67,Caption,,0,0,0,,КРЕДИТЫ, НОВЫЕ ОГРАНИЧЕНИЯ, НОВЫЕ БЮДЖЕТЫ И НОВЫЕ ГОДЫ ПРОТИВОСТОЯНИЯ. СХЕМА
Dialogue: 0,0:02:38.67,0:02:41.79,Caption,,0,0,0,,УДОБНАЯ. СНАЧАЛА ПОДНЯТЬ СТАВКУ. ПОТОМ ПОЛУЧИТЬ
Dialogue: 0,0:02:41.79,0:02:44.83,Caption,,0,0,0,,ОТВЕТ. ПОТОМ ПОКАЗАТЬ ЭТОТ ОТВЕТ ПАРТНЁРАМ И СКАЗАТЬ
Dialogue: 0,0:02:44.84,0:02:48.91,Caption,,0,0,0,,НУ ВОТ, СМОТРИТЕ, МЫ ЖЕ ПРЕДУПРЕЖДАЛИ. ТОЛЬКО ТУТ ЕСТЬ ОДНА МАЛЕНЬКАЯ
Dialogue: 0,0:02:48.91,0:02:51.39,Caption,,0,0,0,,ПРОБЛЕМА. КОГДА ДОЛГО ИГРАЕШЬ В ТАКУЮ ИГРУ,
Dialogue: 0,0:02:51.67,0:02:53.63,Caption,,0,0,0,,ОДНАЖДЫ ОТВЕТ ПРИЛЕТАЕТ УЖЕ НЕ ТУДА,
Dialogue: 0,0:02:53.78,0:02:56.11,Caption,,0,0,0,,КУДА ТЫ ПРИВЫК. И НА ЭТОМ ФОНЕ ОСОБЕННО
Dialogue: 0,0:02:56.11,0:02:58.51,Caption,,0,0,0,,ИНТЕРЕСНО ЗВУЧИТ СОВСЕМ ДРУГАЯ НОВОСТЬ ИЗ САМОЙ
Dialogue: 0,0:02:58.59,0:03:01.39,Caption,,0,0,0,,УКРАИНЫ. ДЕПУТАТ ВЕРХОВНОЙ РАДЫ ГЕОРГИЙ МАЗУРАШУ
Dialogue: 0,0:03:01.39,0:03:03.79,Caption,,0,0,0,,ГОВОРИТ УКРАИНА МОГЛА БЫ СОГЛАСИТЬСЯ НА ИЗМЕНЕНИЕ
Dialogue: 0,0:03:03.79,0:03:06.11,Caption,,0,0,0,,ГРАНИЦ ДОНЕЦКОЙ И ЛУГАНСКОЙ ОБЛАСТЕЙ ПО ЛИНИИ
Dialogue: 0,0:03:06.11,0:03:09.87,Caption,,0,0,0,,ФРОНТА, ЕСЛИ ЭТО ДАСТ РЕАЛЬНЫЕ ГАРАНТИИ МИРА. ПРИЧЁМ ОН
Dialogue: 0,0:03:09.87,0:03:13.15,Caption,,0,0,0,,ОТДЕЛЬНО ОБЪЯСНЯЕТ ЮРИДИЧЕСКУЮ СТОРОНУ. КОНСТИТУЦИЮ
Dialogue: 0,0:03:13.23,0:03:15.31,Caption,,0,0,0,,ВО ВРЕМЯ ВОЕННОГО ПОЛОЖЕНИЯ МЕНЯТЬ НЕЛЬЗЯ,
Dialogue: 0,0:03:15.71,0:03:18.11,Caption,,0,0,0,,НО КОНКРЕТНЫЕ ГРАНИЦЫ НАСЕЛЁННЫХ ПУНКТОВ ТАМ И НЕ
Dialogue: 0,0:03:18.11,0:03:21.39,Caption,,0,0,0,,ПРОПИСАНЫ. ВОТ ЭТО УЖЕ ИНТЕРЕСНЫЙ ПОВОРОТ. ЕЩЁ
Dialogue: 0,0:03:21.47,0:03:23.79,Caption,,0,0,0,,НЕДАВНО САМА ПОСТАНОВКА ВОПРОСА О ТЕРРИТОРИАЛЬНЫХ
Dialogue: 0,0:03:23.79,0:03:25.79,Caption,,0,0,0,,УСТУПКАХ СЧИТАЛАСЬ ЧУТЬ ЛИ НЕ ПОЛИТИЧЕСКИМ
Dialogue: 0,0:03:25.79,0:03:28.91,Caption,,0,0,0,,САМОУБИЙСТВОМ. А ТЕПЕРЬ ДЕПУТАТ РАДЫ УЖЕ РАССУЖДАЕТ,
Dialogue: 0,0:03:29.12,0:03:32.11,Caption,,0,0,0,,КАК ЭТО ТЕХНИЧЕСКИ МОЖНО ОФОРМИТЬ. И ЗДЕСЬ НАДО
Dialogue: 0,0:03:32.11,0:03:35.23,Caption,,0,0,0,,ВНИМАТЕЛЬНО СЛУШАТЬ СЛОВА. ОБСУЖДАТЬ ТЕРРИТОРИИ НЕ
Dialogue: 0,0:03:35.31,0:03:41.90,Caption,,0,0,0,,ЗНАЧИТ ВОЗВРАЩАТЬ ТЕРРИТОРИИ. ЭТО ВООБЩЕ ДВЕ СОВЕРШЕННО РАЗНЫЕ КОНСТРУКЦИИ. МОЖНО
Dialogue: 0,0:03:41.90,0:03:43.58,Caption,,0,0,0,,ПРИЙТИ ЗА СТОЛ И СКАЗАТЬ ХОРОШО,
Dialogue: 0,0:03:43.83,0:03:46.30,Caption,,0,0,0,,ДАВАЙТЕ ОБСУЖДАТЬ, ГДЕ ПРОХОДИТ ЛИНИЯ,
Dialogue: 0,0:03:46.46,0:03:49.02,Caption,,0,0,0,,НА КОТОРОЙ ВСЁ ЭТО ОСТАНОВИТСЯ. А МОЖНО ПРИЙТИ
Dialogue: 0,0:03:49.10,0:03:52.86,Caption,,0,0,0,,И СКАЗАТЬ СЕЙЧАС ОБСУДИМ, ЧТО МЫ ВАМ ВЕРНЁМ. ЧУВСТВУЕТЕ РАЗНИЦУ?
Dialogue: 0,0:03:53.18,0:03:55.58,Caption,,0,0,0,,ВОТ ПОЭТОМУ ДИПЛОМАТИЧЕСКИЙ ЯЗЫК ИНОГДА ПРЕКРАСЕН.
Dialogue: 0,0:03:55.99,0:03:58.54,Caption,,0,0,0,,ВСЕ УСЛЫШАЛИ СЛОВО "ТЕРРИТОРИИ" И УЖЕ МЫСЛЕННО
Dialogue: 0,0:03:58.54,0:04:01.66,Caption,,0,0,0,,НАЧАЛИ РИСОВАТЬ ГОЛУБЕЙ МИРА. А ТАМ ВОПРОС СОВСЕМ
Dialogue: 0,0:04:01.66,0:04:04.38,Caption,,0,0,0,,ДРУГОЙ МЫ ОБСУЖДАЕМ, ЧТО КОМУ ВОЗВРАЩАТЬ,
Dialogue: 0,0:04:04.62,0:04:06.70,Caption,,0,0,0,,ИЛИ ГДЕ ТЕПЕРЬ ПРОХОДИТ НОВАЯ ЛИНИЯ,
Dialogue: 0,0:04:07.02,0:04:11.42,Caption,,0,0,0,,ДАЛЬШЕ КОТОРОЙ НИКТО НЕ ИДЁТ? И ТУТ ПОЯВЛЯЕТСЯ ТАРАС ЧМУТ. ВОТ УЖ ОТ
Dialogue: 0,0:04:11.50,0:04:14.62,Caption,,0,0,0,,КОГО ТАКОГО ПОВОРОТА МНОГИЕ ТОЧНО НЕ ЖДАЛИ. ЧЕЛОВЕК,
Dialogue: 0,0:04:14.76,0:04:17.10,Caption,,0,0,0,,КОТОРЫЙ МНОГО ЛЕТ СВЯЗАН С ПОДДЕРЖКОЙ УКРАИНСКОЙ
Dialogue: 0,0:04:17.10,0:04:20.38,Caption,,0,0,0,,АРМИИ, В ИНТЕРВЬЮ САМ ЗАДАЁТ ПРОВОКАЦИОННЫЙ ВОПРОС ЕСЛИ
Dialogue: 0,0:04:20.38,0:04:22.70,Caption,,0,0,0,,ЗАПАД ЗАСТАВИТ УКРАИНУ ОТДАТЬ ТЕРРИТОРИИ,
Dialogue: 0,0:04:23.02,0:04:25.50,Caption,,0,0,0,,ПОЧЕМУ ТОГДА УКРАИНЕ НЕ ПЕРЕСМОТРЕТЬ ВООБЩЕ ВСЮ
Dialogue: 0,0:04:25.58,0:04:28.46,Caption,,0,0,0,,СИСТЕМУ СОЮЗОВ? ПОЧЕМУ НЕ ИСКАТЬ НОВЫХ ПАРТНЁРОВ?
Dialogue: 0,0:04:28.54,0:04:30.22,Caption,,0,0,0,,ПОЧЕМУ НЕ КИТАЙ? ПОЧЕМУ НЕ ИРАН?
Dialogue: 0,0:04:30.23,0:04:34.46,Caption,,0,0,0,,ПОЧЕМУ НЕ СЕВЕРНАЯ КОРЕЯ? И НАКОНЕЦ СОВСЕМ ВЕСЁЛОЕ ПОЧЕМУ БЫ УКРАИНЕ В
Dialogue: 0,0:04:34.46,0:04:36.94,Caption,,0,0,0,,ТАКОМ СЛУЧАЕ НЕ СТАТЬ СОЮЗНИКОМ РОССИИ ПРОТИВ
Dialogue: 0,0:04:37.02,0:04:40.70,Caption,,0,0,0,,ЕВРОПЫ? НЕТ, ЧМУТ НЕ ОБЪЯВЛЯЕТ ПЛАН СОВМЕСТНОГО ПОХОДА НА
Dialogue: 0,0:04:40.70,0:04:42.54,Caption,,0,0,0,,БРЮССЕЛЬ. ОН СПЕЦИАЛЬНО ГОВОРИТ,
Dialogue: 0,0:04:42.74,0:04:45.58,Caption,,0,0,0,,ЧТО ПРИВОДИТ ЭТОТ СЦЕНАРИЙ КАК ИЛЛЮСТРАЦИЮ ТОГО,
Dialogue: 0,0:04:45.83,0:04:48.06,Caption,,0,0,0,,ДО КАКОГО АБСУРДА МОЖЕТ ДОЙТИ СИСТЕМА,
Dialogue: 0,0:04:48.38,0:04:50.06,Caption,,0,0,0,,ГДЕ ДЕЙСТВУЕТ ТОЛЬКО ПРАВО СИЛЬНОГО.
Dialogue: 0,0:04:52.35,0:04:54.59,Caption,,0,0,0,,НО СЛОВА УЖЕ ПРОИЗНЕСЕНЫ. И ВОТ ИХ Я
Dialogue: 0,0:04:54.59,0:04:57.71,Caption,,0,0,0,,БЫ ТОЧНО НЕ ВЫБРАСЫВАЛ КАК ПУСТУЮ РИТОРИКУ. ПОТОМУ
Dialogue: 0,0:04:57.79,0:05:00.27,Caption,,0,0,0,,ЧТО У ТАКОГО СЦЕНАРИЯ ЕСТЬ ИСТОРИЧЕСКАЯ ПОЧВА.
Dialogue: 0,0:05:00.83,0:05:03.71,Caption,,0,0,0,,РУССКИЕ И УКРАИНЦЫ ВЕКАМИ ЖИЛИ В ОДНИХ ГОСУДАРСТВАХ,
Dialogue: 0,0:05:03.95,0:05:07.07,Caption,,0,0,0,,СЛУЖИЛИ В ОДНОЙ АРМИИ, ВОЕВАЛИ ПЛЕЧОМ К ПЛЕЧУ,
Dialogue: 0,0:05:07.23,0:05:09.07,Caption,,0,0,0,,СОЗДАВАЛИ ОБЩУЮ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:05:09.31,0:05:14.03,Caption,,0,0,0,,ОБЩУЮ ИНФРАСТРУКТУРУ, ИМЕЛИ МИЛЛИОНЫ СЕМЕЙНЫХ СВЯЗЕЙ. ЭТО НЕ ДВЕ СТРАНЫ,
Dialogue: 0,0:05:14.27,0:05:16.91,Caption,,0,0,0,,КОТОРЫЕ ВПЕРВЫЕ УВИДЕЛИ ДРУГ ДРУГА НА КАРТЕ ДВАДЦАТЬ
Dialogue: 0,0:05:16.99,0:05:21.63,Caption,,0,0,0,,ЛЕТ НАЗАД. ДА, СЕЙЧАС МЕЖДУ НИМИ ИДЁТ ТЯЖЕЛЕЙШИЙ КОНФЛИКТ. ДА,
Dialogue: 0,0:05:21.71,0:05:23.71,Caption,,0,0,0,,НАКОПЛЕНА ОГРОМНАЯ МАССА КРОВИ,
Dialogue: 0,0:05:23.88,0:05:27.07,Caption,,0,0,0,,НЕНАВИСТИ И ВЗАИМНЫХ ПРЕТЕНЗИЙ. ВСЁ ЭТО НИКУДА
Dialogue: 0,0:05:27.15,0:05:30.03,Caption,,0,0,0,,ЗАВТРА УТРОМ НЕ ИСЧЕЗНЕТ. НО ИСТОРИЯ ВООБЩЕ ПЛОХО
Dialogue: 0,0:05:30.11,0:05:33.07,Caption,,0,0,0,,ПОДЧИНЯЕТСЯ СЕГОДНЯШНИМ ЭМОЦИЯМ. СЕГОДНЯШНИЙ ВРАГ
Dialogue: 0,0:05:33.15,0:05:35.63,Caption,,0,0,0,,ЧЕРЕЗ ПОКОЛЕНИЕ НЕРЕДКО СТАНОВИТСЯ ПАРТНЁРОМ.
Dialogue: 0,0:05:35.92,0:05:38.67,Caption,,0,0,0,,СЕГОДНЯШНИЙ СОЮЗНИК ИНОГДА ПРЕВРАЩАЕТСЯ В ЧЕЛОВЕКА,
Dialogue: 0,0:05:38.98,0:05:42.19,Caption,,0,0,0,,КОТОРОМУ ПОТОМ ПЕРВЫМ ПРЕДЪЯВЛЯЮТ СЧЁТ. И ВОТ ИМЕННО
Dialogue: 0,0:05:42.19,0:05:44.59,Caption,,0,0,0,,ЭТО ЧМУТ, САМ ТОГО ЖЕЛАЯ ИЛИ НЕТ,
Dialogue: 0,0:05:44.75,0:05:47.79,Caption,,0,0,0,,И ВЫТАЩИЛ НАРУЖУ. ПОТОМУ ЧТО СБЛИЖЕНИЕ РОССИИ И
Dialogue: 0,0:05:47.79,0:05:50.83,Caption,,0,0,0,,УКРАИНЫ, ЭТО НЕ КАКАЯ ТО ФАНТАСТИКА ИЗ ПОЛИТИЧЕСКОГО
Dialogue: 0,0:05:50.83,0:05:53.55,Caption,,0,0,0,,АНЕКДОТА. ЭТО ОДИН ИЗ ОСНОВНЫХ СЦЕНАРИЕВ,
Dialogue: 0,0:05:53.71,0:05:56.43,Caption,,0,0,0,,КОТОРЫЙ ВПОЛНЕ СПОСОБЕН ПОЯВИТЬСЯ В БУДУЩЕМ. И
Dialogue: 0,0:05:56.43,0:05:59.63,Caption,,0,0,0,,ИСТОРИЧЕСКИЕ ПРЕДПОСЫЛКИ У НЕГО ОГРОМНЫЕ. ЭТИ НАРОДЫ
Dialogue: 0,0:05:59.63,0:06:02.43,Caption,,0,0,0,,ВЕКАМИ ЖИЛИ ВМЕСТЕ, СЛУЖИЛИ В ОДНИХ АРМИЯХ,
Dialogue: 0,0:06:02.65,0:06:04.43,Caption,,0,0,0,,ВОЕВАЛИ ПРОТИВ ОБЩИХ ПРОТИВНИКОВ,
Dialogue: 0,0:06:04.59,0:06:06.19,Caption,,0,0,0,,В ТОМ ЧИСЛЕ ЕВРОПЕЙСКИХ ДЕРЖАВ.
Dialogue: 0,0:06:08.47,0:06:10.71,Caption,,0,0,0,,А ЕСЛИ ДВЕ СТРАНЫ С ОГРОМНОЙ ТЕРРИТОРИЕЙ,
Dialogue: 0,0:06:10.87,0:06:16.23,Caption,,0,0,0,,РЕСУРСАМИ, ПРОМЫШЛЕННОСТЬЮ, СЕЛЬСКИМ ХОЗЯЙСТВОМ И ВОЕННЫМ ОПЫТОМ СНОВА ОКАЖУТСЯ
Dialogue: 0,0:06:16.23,0:06:18.95,Caption,,0,0,0,,СОЮЗНИКАМИ? ДЛЯ ЕВРОПЫ ТАКОЙ РАЗВОРОТ,
Dialogue: 0,0:06:19.09,0:06:23.03,Caption,,0,0,0,,НАСТОЯЩИЙ СТРАШНЫЙ СОН. СОВСЕМ ДРУГОЙ БАЛАНС СИЛ. И
Dialogue: 0,0:06:23.03,0:06:25.51,Caption,,0,0,0,,СОВСЕМ ДРУГИЕ ОТНОШЕНИЯ С ВОСТОЧНЫМИ СОСЕДЯМИ.
Dialogue: 0,0:06:25.90,0:06:28.15,Caption,,0,0,0,,ПОЭТОМУ СЛОВА ЧМУТА НЕ СТОИТ ВОСПРИНИМАТЬ КАК
Dialogue: 0,0:06:28.15,0:06:31.43,Caption,,0,0,0,,СЛУЧАЙНУЮ ШУТКУ. У ТАКОГО СЦЕНАРИЯ ЕСТЬ ГЛУБОКАЯ
Dialogue: 0,0:06:31.43,0:06:34.23,Caption,,0,0,0,,ИСТОРИЧЕСКАЯ ПОЧВА. И ОСОБЕННО ИНТЕРЕСНО,
Dialogue: 0,0:06:34.44,0:06:36.23,Caption,,0,0,0,,ЧТО ЧМУТ ТУТ ЖЕ ГОВОРИТ ЕЩЁ ОБ ОДНОЙ
Dialogue: 0,0:06:36.23,0:06:40.55,Caption,,0,0,0,,ВЕЩИ НИКТО НЕ ЗНАЕТ, КАКАЯ ВЛАСТЬ ПРИДЁТ ПОСЛЕ ЗЕЛЕНСКОГО. ОНА СОВСЕМ НЕ
Dialogue: 0,0:06:40.55,0:06:43.59,Caption,,0,0,0,,ОБЯЗАНА БЫТЬ ТАКОЙ ЖЕ ПРОЕВРОПЕЙСКОЙ. НОВЫЕ ПОЛИТИКИ
Dialogue: 0,0:06:43.59,0:06:45.59,Caption,,0,0,0,,ЛЕГКО МОГУТ СПРОСИТЬ А ЧТО НАМ ВООБЩЕ ДАЛА
Dialogue: 0,0:06:45.59,0:06:47.83,Caption,,0,0,0,,ЭТА ОРИЕНТАЦИЯ? ГДЕ ОБЕЩАННЫЙ РЕЗУЛЬТАТ?
Dialogue: 0,0:06:47.91,0:06:49.67,Caption,,0,0,0,,КТО ЗАСТАВЛЯЛ НАС ИДТИ НА УСТУПКИ?
Dialogue: 0,0:06:49.99,0:06:51.67,Caption,,0,0,0,,КТО СПОРИЛ С НАМИ ИЗ ЗА ЗЕРНА?
Dialogue: 0,0:06:51.85,0:06:54.87,Caption,,0,0,0,,КТО ГОДАМИ ДЕРЖАЛ ДВЕРЬ В ЕВРОСОЮЗ ПРИОТКРЫТОЙ РОВНО
Dialogue: 0,0:06:54.87,0:06:57.67,Caption,,0,0,0,,НАСТОЛЬКО, ЧТОБЫ МЫ ПРОДОЛЖАЛИ СТОЯТЬ В КОРИДОРЕ?
Dialogue: 0,0:06:58.10,0:07:00.87,Caption,,0,0,0,,И КАК ПО ЗАКАЗУ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА НЕПРИЯТНАЯ
Dialogue: 0,0:07:00.87,0:07:03.83,Caption,,0,0,0,,ДЛЯ КИЕВА ПЕРСПЕКТИВА. УКРАИНА ВРЯД ЛИ ВСТУПИТ В
Dialogue: 0,0:07:03.91,0:07:07.35,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ СОЮЗ ДАЖЕ В БЛИЖАЙШИЕ ДЕСЯТЬ ЛЕТ. ДЕСЯТЬ
Dialogue: 0,0:07:07.35,0:07:10.95,Caption,,0,0,0,,ЛЕТ. НЕ ДЕСЯТЬ МЕСЯЦЕВ. НЕ "ПОСЛЕ ОКОНЧАНИЯ ВОЙНЫ".
Dialogue: 0,0:07:11.23,0:07:13.27,Caption,,0,0,0,,НЕ "ВОТ СЕЙЧАС ПРОВЕДИТЕ ЕЩЁ ДВЕ РЕФОРМЫ И
Dialogue: 0,0:07:13.35,0:07:17.03,Caption,,0,0,0,,ЗАХОДИТЕ". ДЕСЯТЬ ЛЕТ, И ДАЖЕ ТАМ НИКАКОЙ ГАРАНТИИ.
Dialogue: 0,0:07:19.32,0:07:21.96,Caption,,0,0,0,,ПОТОМУ ЧТО ВСТУПЛЕНИЕ ТРЕБУЕТ ДОЛГИХ ПЕРЕГОВОРОВ,
Dialogue: 0,0:07:22.08,0:07:26.12,Caption,,0,0,0,,ПРАВОВЫХ РЕФОРМ, СООТВЕТСТВИЯ ПОЛИТИЧЕСКИМ И ЭКОНОМИЧЕСКИМ КРИТЕРИЯМ.
Dialogue: 0,0:07:26.49,0:07:29.40,Caption,,0,0,0,,А У УКРАИНЫ СВЕРХУ ЕЩЁ ВОЙНА, КОРРУПЦИЯ,
Dialogue: 0,0:07:29.56,0:07:32.36,Caption,,0,0,0,,ОГРОМНЫЙ РАЗМЕР СТРАНЫ И ЦЕЛАЯ ГОРА ПРОБЛЕМ,
Dialogue: 0,0:07:32.60,0:07:35.00,Caption,,0,0,0,,КОТОРЫЕ ЕВРОПЕЙСКОЙ БЮРОКРАТИИ ПРИДЁТСЯ КАКИМ ТО
Dialogue: 0,0:07:35.00,0:07:38.60,Caption,,0,0,0,,ОБРАЗОМ ПЕРЕВАРИВАТЬ. И ВОТ ЗДЕСЬ УЖЕ ХОЧЕТСЯ СПРОСИТЬ РЕБЯТА,
Dialogue: 0,0:07:38.92,0:07:41.40,Caption,,0,0,0,,А СКОЛЬКО ЛЕТ УКРАИНУ ЭТОЙ МОРКОВКОЙ ПЕРЕД НОСОМ
Dialogue: 0,0:07:41.48,0:07:45.48,Caption,,0,0,0,,ВОДИЛИ? ЕВРОПЕЙСКОЕ БУДУЩЕЕ. ЕВРОПЕЙСКАЯ СЕМЬЯ. ЕВРОПЕЙСКИЙ
Dialogue: 0,0:07:45.56,0:07:49.08,Caption,,0,0,0,,ПУТЬ. ЕЩЁ НЕМНОГО. ЕЩЁ ОДИН ШАГ. ЕЩЁ ОДНА
Dialogue: 0,0:07:49.16,0:07:52.12,Caption,,0,0,0,,РЕФОРМА. ЕЩЁ ОДИН ПАКЕТ. ЕЩЁ ПОТЕРПИТЕ.
Dialogue: 0,0:07:52.67,0:07:56.04,Caption,,0,0,0,,А ТЕПЕРЬ ВЫЯСНЯЕТСЯ, ЧТО ЧЕРЕЗ ДЕСЯТЬ ЛЕТ ДВЕРЬ ТОЖЕ СОВСЕМ НЕ
Dialogue: 0,0:07:56.04,0:07:58.68,Caption,,0,0,0,,ОБЯЗАНА ОТКРЫТЬСЯ. ПРИЧЁМ В ЕВРОПЕ ПОНИМАЮТ,
Dialogue: 0,0:07:58.92,0:08:01.56,Caption,,0,0,0,,НАСКОЛЬКО ЭТО НЕПРИЯТНЫЙ РАЗГОВОР. ЕСЛИ КИЕВУ
Dialogue: 0,0:08:01.56,0:08:05.08,Caption,,0,0,0,,ОТКРЫТО СКАЗАТЬ, ЧТО С ЧЛЕНСТВОМ НИКТО ОСОБЕННО НЕ ТОРОПИТСЯ,
Dialogue: 0,0:08:05.32,0:08:07.96,Caption,,0,0,0,,ЭТО СТАНЕТ ДЕМОРАЛИЗУЮЩИМ СИГНАЛОМ. НУ КОНЕЧНО.
Dialogue: 0,0:08:08.18,0:08:09.96,Caption,,0,0,0,,ЧЕЛОВЕК ДЕСЯТЬ ЛЕТ ИДЁТ К ДВЕРИ,
Dialogue: 0,0:08:10.28,0:08:12.44,Caption,,0,0,0,,А ПОТОМ ЕМУ ГОВОРЯТ ГЛАВНОЕ НЕ РАССТРАИВАЙСЯ,
Dialogue: 0,0:08:12.67,0:08:15.32,Caption,,0,0,0,,ПРОСТО ДВЕРЬ ПОКА ЗАКРЫТА. НО ТЫ ПРОДОЛЖАЙ ИДТИ.
Dialogue: 0,0:08:15.67,0:08:18.92,Caption,,0,0,0,,И ТУТ ВЕНГРИЯ ДОБАВЛЯЕТ ЕЩЁ КРАСОТЫ. БУДАПЕШТ СНОВА
Dialogue: 0,0:08:18.92,0:08:22.20,Caption,,0,0,0,,БЛОКИРУЕТ УКРАИНСКИЙ ПУТЬ В ЕС. ПРИЧИНА СТАРАЯ И
Dialogue: 0,0:08:22.20,0:08:25.48,Caption,,0,0,0,,ОЧЕНЬ КОНКРЕТНАЯ ПРАВА ВЕНГРОВ ЗАКАРПАТЬЯ. КИЕВ,
Dialogue: 0,0:08:25.63,0:08:29.72,Caption,,0,0,0,,ПО ВЕНГЕРСКОЙ ВЕРСИИ, ОБЕЩАНИЯ НЕ ВЫПОЛНИЛ. ПРИЧЁМ ТЕПЕРЬ ЭТО ГОВОРИТ УЖЕ
Dialogue: 0,0:08:29.72,0:08:32.20,Caption,,0,0,0,,ПЕТЕР МАДЬЯР. УКРАИНА, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:08:32.39,0:08:37.37,Caption,,0,0,0,,ЯВНО НЕ ГОТОВА К ЧЛЕНСТВУ. ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:08:37.45,0:08:40.49,Caption,,0,0,0,,КАКАЯ ЗАНЯТНАЯ ВЕЩЬ. МОЖНО СКОЛЬКО УГОДНО ОБЪЯСНЯТЬ
Dialogue: 0,0:08:40.57,0:08:43.21,Caption,,0,0,0,,ВСЕ ПРОБЛЕМЫ УКРАИНЫ В ОТНОШЕНИЯХ С ВЕНГРИЕЙ ОДНИМ
Dialogue: 0,0:08:43.21,0:08:46.49,Caption,,0,0,0,,ОРБАНОМ. ВОТ УЙДЁТ ОРБАН, ПРИДУТ ДРУГИЕ,
Dialogue: 0,0:08:46.73,0:08:49.21,Caption,,0,0,0,,И ВСЁ СРАЗУ НАЛАДИТСЯ. НУ ВОТ ПРИШЛИ ДРУГИЕ.
Dialogue: 0,0:08:49.44,0:08:51.29,Caption,,0,0,0,,И ЧТО? ПРОБЛЕМА КУДА ТО ИСЧЕЗЛА?
Dialogue: 0,0:08:51.50,0:08:54.41,Caption,,0,0,0,,НЕТ. ПОТОМУ ЧТО НАЦИОНАЛЬНЫЕ ИНТЕРЕСЫ СТРАНЫ НЕ
Dialogue: 0,0:08:54.41,0:08:56.57,Caption,,0,0,0,,ВСЕГДА МЕНЯЮТСЯ ВМЕСТЕ С ТАБЛИЧКОЙ НА ДВЕРИ
Dialogue: 0,0:08:56.57,0:08:59.77,Caption,,0,0,0,,ПРЕМЬЕРСКОГО КАБИНЕТА. ЗАКАРПАТСКИЕ ВЕНГРЫ НИКУДА НЕ
Dialogue: 0,0:08:59.77,0:09:03.13,Caption,,0,0,0,,ДЕЛИСЬ. СПОР О ЯЗЫКЕ НИКУДА НЕ ДЕЛСЯ. ВЕНГЕРСКАЯ
Dialogue: 0,0:09:03.13,0:09:05.45,Caption,,0,0,0,,ПОЛИТИКА В ОТНОШЕНИИ СВОИХ СООТЕЧЕСТВЕННИКОВ ЗА
Dialogue: 0,0:09:05.45,0:09:08.25,Caption,,0,0,0,,ГРАНИЦЕЙ ТОЖЕ НИКУДА НЕ ДЕЛАСЬ. И ТЕПЕРЬ СЛОВА
Dialogue: 0,0:09:08.25,0:09:11.61,Caption,,0,0,0,,ЧМУТА НАЧИНАЮТ ЗВУЧАТЬ ЕЩЁ ИНТЕРЕСНЕЕ. ОН ВЕДЬ ПРЯМО
Dialogue: 0,0:09:11.61,0:09:14.73,Caption,,0,0,0,,ПЕРЕЧИСЛЯЕТ БУДУЩИЕ ПРЕТЕНЗИИ К ЕВРОПЕ. ПОЛЬСКОЕ
Dialogue: 0,0:09:14.73,0:09:18.65,Caption,,0,0,0,,ЗЕРНО. ВЕНГРИЯ. ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ. ВОЗМОЖНОЕ
Dialogue: 0,0:09:18.65,0:09:21.05,Caption,,0,0,0,,ОЩУЩЕНИЕ, ЧТО УКРАИНУ ИСПОЛЬЗОВАЛИ,
Dialogue: 0,0:09:21.37,0:09:24.17,Caption,,0,0,0,,А ПОТОМ ОСТАВИЛИ РАЗБИРАТЬСЯ С ПОСЛЕДСТВИЯМИ. ВОТ
Dialogue: 0,0:09:24.25,0:09:26.81,Caption,,0,0,0,,ВАМ И ПОЧВА ДЛЯ БУДУЩЕЙ ПОЛИТИКИ. НЕ СЕГОДНЯ.
Dialogue: 0,0:09:27.04,0:09:29.61,Caption,,0,0,0,,НЕ ЗАВТРА УТРОМ. НО ЕСЛИ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ
Dialogue: 0,0:09:29.61,0:09:32.01,Caption,,0,0,0,,УКРАИНСКИЙ ИЗБИРАТЕЛЬ ПОСМОТРИТ ВОКРУГ И СПРОСИТ
Dialogue: 0,0:09:32.01,0:09:34.65,Caption,,0,0,0,,ТАК, СЕКУНДОЧКУ, ГДЕ ЕВРОСОЮЗ,
Dialogue: 0,0:09:34.89,0:09:37.85,Caption,,0,0,0,,ГДЕ ОБЕЩАННОЕ ПРОЦВЕТАНИЕ, ГДЕ ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:09:38.08,0:09:41.61,Caption,,0,0,0,,ГДЕ ДЕНЬГИ, ГДЕ БЕЗОПАСНОСТЬ И ПОЧЕМУ МЫ ОПЯТЬ КОМУ ТО
Dialogue: 0,0:09:41.61,0:09:45.53,Caption,,0,0,0,,ЧТО ТО ДОЛЖНЫ, НА ЭТОМ МЕСТЕ ПОЯВИТСЯ СОВСЕМ ДРУГОЙ ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:09:45.61,0:09:50.78,Caption,,0,0,0,,СПРОС. И ТОГДА НЫНЕШНЯЯ ФРАЗА ПРО РОССИЮ ПРОТИВ ЕВРОПЫ
Dialogue: 0,0:09:50.86,0:09:53.02,Caption,,0,0,0,,УЖЕ НЕ БУДЕТ ВЫГЛЯДЕТЬ КАКИМ ТО АНЕКДОТОМ ИЗ
Dialogue: 0,0:09:53.02,0:09:55.10,Caption,,0,0,0,,ИНТЕРВЬЮ. ПОДПИСЫВАЙТЕСЬ, КСТАТИ,
Dialogue: 0,0:09:55.34,0:09:57.74,Caption,,0,0,0,,ПОТОМУ ЧТО ИМЕННО ТАКИЕ ФРАЗЫ СЕГОДНЯ ЛЕГКО
Dialogue: 0,0:09:57.74,0:10:01.66,Caption,,0,0,0,,ПРОСКОЧИТЬ ГЛАЗАМИ, А ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ВСЕ ВДРУГ НАЧИНАЮТ УДИВЛЯТЬСЯ
Dialogue: 0,0:10:01.74,0:10:04.54,Caption,,0,0,0,,НАДО ЖЕ, А ВЕДЬ НАМ ОБ ЭТОМ ГОВОРИЛИ. НУ А
Dialogue: 0,0:10:04.54,0:10:07.34,Caption,,0,0,0,,ТЕПЕРЬ ВЕРНЁМСЯ С БОЛЬШОЙ ГЕОПОЛИТИКИ ДОМОЙ. ПОТОМУ
Dialogue: 0,0:10:07.42,0:10:09.90,Caption,,0,0,0,,ЧТО МОЖНО СКОЛЬКО УГОДНО ОБСУЖДАТЬ ЕВРОСОЮЗ ЧЕРЕЗ
Dialogue: 0,0:10:09.90,0:10:12.86,Caption,,0,0,0,,ДЕСЯТЬ ЛЕТ, НОВЫЕ СОЮЗЫ, ГРАНИЦЫ,
Dialogue: 0,0:10:13.02,0:10:16.06,Caption,,0,0,0,,БУДУЩИЕ ПРАВИТЕЛЬСТВА И ИСТОРИЧЕСКИЕ РАЗВОРОТЫ. НО
Dialogue: 0,0:10:16.06,0:10:18.86,Caption,,0,0,0,,ЕСТЬ ВОПРОС ГОРАЗДО ПРОЩЕ. А СВЕТ СЕГОДНЯ ЕСТЬ?
Dialogue: 0,0:10:19.24,0:10:21.98,Caption,,0,0,0,,ПО СОВМЕСТНОМУ ДОКЛАДУ АМЕРИКАНСКИХ ВЕДОМСТВ УКРАИНА
Dialogue: 0,0:10:22.06,0:10:24.54,Caption,,0,0,0,,ПОТЕРЯЛА БОЛЬШЕ ПОЛОВИНЫ ДОВОЕННЫХ МОЩНОСТЕЙ
Dialogue: 0,0:10:24.54,0:10:27.66,Caption,,0,0,0,,ЭЛЕКТРОГЕНЕРАЦИИ. БОЛЬШЕ ПОЛОВИНЫ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:10:27.74,0:10:31.50,Caption,,0,0,0,,ЦИФРА, КОТОРУЮ НЕ НАДО УКРАШАТЬ. УДАРЫ ПО ЭЛЕКТРОСТАНЦИЯМ,
Dialogue: 0,0:10:31.57,0:10:35.10,Caption,,0,0,0,,СЕТЯМ, ОБЪЕКТАМ ЦЕНТРАЛИЗОВАННОГО ОТОПЛЕНИЯ ПЛЮС ПОТЕРЯ
Dialogue: 0,0:10:35.18,0:10:37.58,Caption,,0,0,0,,КОНТРОЛЯ НАД ЗАПОРОЖСКОЙ АЭС ПРИВЕЛИ К ТОМУ,
Dialogue: 0,0:10:37.79,0:10:40.62,Caption,,0,0,0,,ЧТО ПРЕЖНЕЙ СИСТЕМЫ ФАКТИЧЕСКИ БОЛЬШЕ НЕТ В ПРЕЖНЕМ
Dialogue: 0,0:10:40.70,0:10:43.58,Caption,,0,0,0,,ВИДЕ. ОТСЮДА ПЛАНОВЫЕ ОТКЛЮЧЕНИЯ. А ДАЛЬШЕ
Dialogue: 0,0:10:43.66,0:10:47.74,Caption,,0,0,0,,НАЧИНАЕТСЯ ТА ЧАСТЬ, КОТОРУЮ ОЧЕНЬ ЛЮБЯТ ТЕРЯТЬ ЗА КРАСИВЫМИ СЛОВАМИ ПРО
Dialogue: 0,0:10:47.74,0:10:52.46,Caption,,0,0,0,,МЕГАВАТТЫ. А ГДЕ ЗДЕСЬ ЛЮДИ? БОЛЬШИНСТВО ГОРОДСКИХ КВАРТИР НЕ ИМЕЮТ СОБСТВЕННОГО
Dialogue: 0,0:10:52.46,0:10:55.90,Caption,,0,0,0,,КОТЛА, СОБСТВЕННОЙ ЭЛЕКТРОСТАНЦИИ И МАЛЕНЬКОЙ ТУРБИНЫ НА
Dialogue: 0,0:10:55.90,0:10:58.70,Caption,,0,0,0,,БАЛКОНЕ. ОНИ ЗАВЯЗАНЫ НА ОБЩУЮ СИСТЕМУ.
Dialogue: 0,0:11:00.97,0:11:05.05,Caption,,0,0,0,,НЕТ ЭЛЕКТРИЧЕСТВА, НАЧИНАЮТСЯ ПРОБЛЕМЫ С НАСОСАМИ. НЕТ НОРМАЛЬНОГО
Dialogue: 0,0:11:05.05,0:11:08.97,Caption,,0,0,0,,ТЕПЛОСНАБЖЕНИЯ, ВСТАЁТ ВОПРОС ОТОПЛЕНИЯ И ГОРЯЧЕЙ ВОДЫ. И
Dialogue: 0,0:11:08.97,0:11:11.53,Caption,,0,0,0,,АМЕРИКАНСКИЙ ДОКЛАД ГОВОРИТ ЕЩЁ ЖЁСТЧЕ ПОЛНОЕ
Dialogue: 0,0:11:11.53,0:11:14.49,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ МОЖЕТ ЗАНЯТЬ ДО ПЯТИ ЛЕТ. ДАЖЕ ПРИ
Dialogue: 0,0:11:14.49,0:11:17.29,Caption,,0,0,0,,БЛАГОПРИЯТНОМ ХОДЕ РАБОТ К СЛЕДУЮЩЕЙ ЗИМЕ УДАСТСЯ
Dialogue: 0,0:11:17.29,0:11:20.09,Caption,,0,0,0,,ВЕРНУТЬ ТОЛЬКО ЧАСТЬ УТРАЧЕННЫХ МОЩНОСТЕЙ. ТО ЕСТЬ
Dialogue: 0,0:11:20.17,0:11:23.05,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ПРОИСХОДЯТ ДВЕ УКРАИНЫ. ОДНА РАССУЖДАЕТ
Dialogue: 0,0:11:23.05,0:11:25.45,Caption,,0,0,0,,О НОВОМ МИРОВОМ ПОРЯДКЕ, О ЕВРОПЕ,
Dialogue: 0,0:11:25.53,0:11:28.09,Caption,,0,0,0,,О СОЮЗАХ, О ГЕОПОЛИТИЧЕСКОМ ВЫБОРЕ,
Dialogue: 0,0:11:28.33,0:11:30.97,Caption,,0,0,0,,О БУДУЩЕМ ЧЛЕНСТВЕ В ЕС. А ВТОРАЯ СМОТРИТ
Dialogue: 0,0:11:30.97,0:11:32.89,Caption,,0,0,0,,НА ГРАФИК ОТКЛЮЧЕНИЙ И ДУМАЕТ,
Dialogue: 0,0:11:33.15,0:11:36.17,Caption,,0,0,0,,КОГДА ВКЛЮЧАТ ЧАЙНИК. И ВОТ ЗДЕСЬ ВСЯ СЕГОДНЯШНЯЯ
Dialogue: 0,0:11:36.25,0:11:39.05,Caption,,0,0,0,,ПОДБОРКА НАЧИНАЕТ СМОТРЕТЬСЯ СОВСЕМ ПО ДРУГОМУ. В
Dialogue: 0,0:11:39.05,0:11:41.29,Caption,,0,0,0,,МОСКВЕ ОБСУЖДАЮТ, СУДЯ ПО ИНСАЙДАМ,
Dialogue: 0,0:11:41.53,0:11:44.49,Caption,,0,0,0,,ОТМЕНУ СТАРЫХ ОГРАНИЧЕНИЙ. В КИЕВЕ ПОЯВЛЯЮТСЯ
Dialogue: 0,0:11:44.49,0:11:47.61,Caption,,0,0,0,,ГОЛОСА, ГОТОВЫЕ ОБСУЖДАТЬ ТЕРРИТОРИАЛЬНЫЙ КОМПРОМИСС.
Dialogue: 0,0:11:47.77,0:11:50.49,Caption,,0,0,0,,ЧЕЛОВЕК ИЗ САМОГО УКРАИНСКОГО ВОЕННО ВОЛОНТЁРСКОГО
Dialogue: 0,0:11:50.49,0:11:52.57,Caption,,0,0,0,,ЯДРА УЖЕ ВСЛУХ РАССУЖДАЕТ О ТОМ,
Dialogue: 0,0:11:52.81,0:11:55.13,Caption,,0,0,0,,ЧТО СТРАНА ПОСЛЕ ЗЕЛЕНСКОГО СПОСОБНА ВООБЩЕ
Dialogue: 0,0:11:55.13,0:11:58.33,Caption,,0,0,0,,ПЕРЕСМОТРЕТЬ СВОИ СОЮЗЫ. ПЕРСПЕКТИВА ЕЩЁ ДЕСЯТЬ ЛЕТ
Dialogue: 0,0:11:58.41,0:12:01.13,Caption,,0,0,0,,ПРОСТОЯТЬ ПЕРЕД ДВЕРЯМИ ЕВРОСОЮЗА ОХЛАЖДАЕТ
Dialogue: 0,0:12:01.13,0:12:04.33,Caption,,0,0,0,,РАЗГОВОРЫ О БЫСТРОМ ВСТУПЛЕНИИ. ВЕНГРИЯ НАПОМИНАЕТ,
Dialogue: 0,0:12:04.59,0:12:07.13,Caption,,0,0,0,,ЧТО ДАЖЕ ВНУТРИ ЕС НИКТО НЕ ОБЯЗАН ОТКРЫВАТЬ
Dialogue: 0,0:12:07.21,0:12:11.21,Caption,,0,0,0,,ДВЕРЬ ТОЛЬКО ПОТОМУ, ЧТО КИЕВ ОЧЕНЬ ДОЛГО ВОЗЛЕ НЕЁ СТОИТ. А
Dialogue: 0,0:12:11.21,0:12:14.09,Caption,,0,0,0,,ЭНЕРГЕТИКА ТЕМ ВРЕМЕНЕМ ПРОСТО СЧИТАЕТ ОСТАВШИЕСЯ
Dialogue: 0,0:12:14.17,0:12:18.45,Caption,,0,0,0,,МОЩНОСТИ. И ВОТ ТУТ ГЛАВНЫЙ ВОПРОС УЖЕ НЕ В
Dialogue: 0,0:12:18.53,0:12:22.13,Caption,,0,0,0,,ТОМ, КТО СЕГОДНЯ ПРОИЗНЁС САМУЮ ГРОМКУЮ ФРАЗУ. ГЛАВНЫЙ
Dialogue: 0,0:12:22.13,0:12:25.25,Caption,,0,0,0,,ВОПРОС В ДРУГОМ. ЕСЛИ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ УКРАИНА
Dialogue: 0,0:12:25.25,0:12:27.41,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ОКАЖЕТСЯ ДРУГОЙ СТРАНОЙ,
Dialogue: 0,0:12:27.70,0:12:30.29,Caption,,0,0,0,,С ДРУГИМИ ГРАНИЦАМИ, ДРУГОЙ ЭНЕРГЕТИКОЙ,
Dialogue: 0,0:12:30.45,0:12:33.41,Caption,,0,0,0,,ДРУГИМИ ОТНОШЕНИЯМИ С ЕВРОПОЙ И ДРУГИМ РУКОВОДСТВОМ,
Dialogue: 0,0:12:33.74,0:12:35.97,Caption,,0,0,0,,КТО ТОГДА БУДЕТ ЕЁ ГЛАВНЫМ СОЮЗНИКОМ?
Dialogue: 0,0:12:36.27,0:12:38.69,Caption,,0,0,0,,ПОТОМУ ЧТО ИСТОРИЯ, ЗАРАЗА ТАКАЯ,
Dialogue: 0,0:12:38.85,0:12:43.41,Caption,,0,0,0,,ВООБЩЕ НЕ ОБЯЗАНА ИДТИ ТУДА, КУДА ЕЁ СЕГОДНЯ ПЫТАЮТСЯ ТОЛКАТЬ. ИНОГДА ОНА
Dialogue: 0,0:12:43.41,0:12:46.69,Caption,,0,0,0,,РАЗВОРАЧИВАЕТСЯ. И ТОГДА ВЧЕРАШНИЕ НЕМЫСЛИМЫЕ СЛОВА
Dialogue: 0,0:12:46.69,0:12:48.69,Caption,,0,0,0,,ВНЕЗАПНО СТАНОВЯТСЯ ОБЫЧНОЙ ПОЛИТИКОЙ.
