Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,ЕВРОПА ГОТОВИТСЯ К МИРУ ОЧЕНЬ СВОЕОБРАЗНО. ВОЕННЫХ
Dialogue: 0,0:00:03.00,0:00:05.40,Caption,,0,0,0,,ПЕРЕБРАСЫВАЮТ, УЧЕНИЯ ПРОВОДЯТ,
Dialogue: 0,0:00:05.64,0:00:09.24,Caption,,0,0,0,,НАСЕЛЕНИЮ ОБЪЯСНЯЮТ, ЧТО ДЕРЖАТЬ ДОМА НА СЛУЧАЙ БОЛЬШОЙ БЕДЫ,
Dialogue: 0,0:00:09.64,0:00:12.12,Caption,,0,0,0,,А ВОЗЛЕ РОССИЙСКОЙ ГРАНИЦЫ УЖЕ ВЫСМАТРИВАЮТ КАКИХ ТО
Dialogue: 0,0:00:12.12,0:00:14.60,Caption,,0,0,0,,ПОДОЗРИТЕЛЬНЫХ ЛЮДЕЙ С ФОНАРИКАМИ. ХОРОШИЕ,
Dialogue: 0,0:00:14.68,0:00:18.68,Caption,,0,0,0,,КСТАТИ, ДИВЕРСАНТЫ. САМИ СЕБЕ ПОДСВЕТКУ ВКЛЮЧИЛИ. И ВОТ ЧЕМ
Dialogue: 0,0:00:18.68,0:00:20.68,Caption,,0,0,0,,ДАЛЬШЕ СМОТРИШЬ НА ВСЮ ЭТУ ПОДГОТОВКУ,
Dialogue: 0,0:00:20.92,0:00:23.32,Caption,,0,0,0,,ТЕМ СИЛЬНЕЕ ХОЧЕТСЯ СПРОСИТЬ А К МИРУ ОНИ
Dialogue: 0,0:00:23.32,0:00:27.72,Caption,,0,0,0,,ТОЧНО ГОТОВЯТСЯ? НАЧНЁМ КАК РАЗ С ФОНАРИКОВ. ПОЛЬСКИЙ ПРЕМЬЕР ДОНАЛЬД
Dialogue: 0,0:00:27.72,0:00:31.64,Caption,,0,0,0,,ТУСК СООБЩИЛ, ЧТО НОЧЬЮ ВОЗЛЕ ГРАНИЦЫ С КАЛИНИНГРАДСКОЙ ОБЛАСТЬЮ
Dialogue: 0,0:00:31.64,0:00:34.52,Caption,,0,0,0,,ЗАМЕТИЛИ ПОДОЗРИТЕЛЬНОЕ ДВИЖЕНИЕ. КОНКРЕТНО,
Dialogue: 0,0:00:34.62,0:00:37.80,Caption,,0,0,0,,ЛЮДЕЙ С ФОНАРИКАМИ. ПОСЛЕ ЭТОГО К ГРАНИЦЕ БЫСТРО
Dialogue: 0,0:00:37.88,0:00:40.60,Caption,,0,0,0,,ПОДТЯНУЛИ ДОПОЛНИТЕЛЬНЫЕ СИЛЫ. ПОЛИЦИЮ,
Dialogue: 0,0:00:40.68,0:00:45.80,Caption,,0,0,0,,ПОГРАНИЧНИКОВ, ВОЕННЫХ, КОНТРТЕРРОРИСТИЧЕСКИЕ ПОДРАЗДЕЛЕНИЯ. ТУСК ЗАЯВИЛ,
Dialogue: 0,0:00:46.09,0:00:48.60,Caption,,0,0,0,,ЧТО ПОЛЬСКИЕ И СОЮЗНЫЕ СПЕЦСЛУЖБЫ ЗАРАНЕЕ
Dialogue: 0,0:00:48.60,0:00:53.48,Caption,,0,0,0,,ПРЕДУПРЕЖДАЛИ О ДИВЕРСИЯХ, САБОТАЖЕ И ДАЖЕ ВОЗМОЖНОМ ПРОНИКНОВЕНИИ ВООРУЖЁННЫХ
Dialogue: 0,0:00:53.56,0:00:56.20,Caption,,0,0,0,,ЛЮДЕЙ В ПЕРВОЙ ПОЛОВИНЕ НОЯБРЯ. А ТУТ НОЧЬЮ
Dialogue: 0,0:00:56.28,0:01:00.36,Caption,,0,0,0,,ФОНАРИКИ. НУ ВСЁ, КАРТИНА МАСЛОМ. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ ИСТОРИИ НЕ
Dialogue: 0,0:01:00.36,0:01:04.36,Caption,,0,0,0,,ПО ОТДЕЛЬНОСТИ, А В СВЯЗКЕ, ПОДПИСЫВАЙТЕСЬ. СЕЙЧАС РАЗБЕРЁМ,
Dialogue: 0,0:01:04.44,0:01:07.32,Caption,,0,0,0,,ПОЧЕМУ ОДИН НОЧНОЙ ЭПИЗОД СВЯЗАН С БОЛЬШОЙ ВОЕННОЙ
Dialogue: 0,0:01:07.32,0:01:09.64,Caption,,0,0,0,,ПОДГОТОВКОЙ. НО ТУТ У МЕНЯ ВОЗНИКАЕТ ОЧЕНЬ ПРОСТОЙ
Dialogue: 0,0:01:09.64,0:01:12.12,Caption,,0,0,0,,ВОПРОС. А ПОЧЕМУ ЭТО ИМЕННО ДИВЕРСАНТЫ?
Dialogue: 0,0:01:14.39,0:01:16.79,Caption,,0,0,0,,ХОРОШИЙ ДИВЕРСАНТ ВООБЩЕ ТО ОБЫЧНО СТАРАЕТСЯ,
Dialogue: 0,0:01:17.03,0:01:19.27,Caption,,0,0,0,,ЧТОБЫ ЕГО НИКТО НЕ ВИДЕЛ. ДЛЯ ЭТОГО ОН
Dialogue: 0,0:01:19.27,0:01:21.83,Caption,,0,0,0,,НОЧЬЮ НЕ СВЕТИТ СЕБЕ ПОД НОГИ ФОНАРИКОМ РАЗМЕРОМ
Dialogue: 0,0:01:21.91,0:01:24.47,Caption,,0,0,0,,С АВТОМОБИЛЬНУЮ ФАРУ И НЕ ХОДИТ ВДОЛЬ ГРАНИЦЫ
Dialogue: 0,0:01:24.55,0:01:29.11,Caption,,0,0,0,,С ВЫРАЖЕНИЕМ ЗДРАВСТВУЙТЕ, Я ЗДЕСЬ ТАЙНО ПРОНИКНУТЬ СОБИРАЮСЬ. ДИВЕРСАНТ
Dialogue: 0,0:01:29.11,0:01:32.87,Caption,,0,0,0,,ПРЯЧЕТСЯ. МАСКИРУЕТСЯ. ИСПОЛЬЗУЕТ ТЕМНОТУ. А ТУТ
Dialogue: 0,0:01:32.95,0:01:36.71,Caption,,0,0,0,,ЛЮДИ С ФОНАРИКАМИ. МОЖЕТ, ГРИБНИКИ ЗАБЛУДИЛИСЬ. МОЖЕТ,
Dialogue: 0,0:01:36.93,0:01:40.71,Caption,,0,0,0,,КЛЮЧИ ПОТЕРЯЛИ. КОЗЛЁНОК УБЕЖАЛ. СВИНКА ПРОПАЛА. Я
Dialogue: 0,0:01:40.71,0:01:43.59,Caption,,0,0,0,,ПОНЯТИЯ НЕ ИМЕЮ, КТО ЭТО БЫЛ. И ВОТ В ЭТОМ КАК
Dialogue: 0,0:01:43.59,0:01:46.07,Caption,,0,0,0,,РАЗ ВЕСЬ ВОПРОС. САМ ТУСК ПРИЗНАЛ,
Dialogue: 0,0:01:46.22,0:01:48.71,Caption,,0,0,0,,ЧТО ОКОНЧАТЕЛЬНО УСТАНОВИТЬ НАМЕРЕНИЕ ЭТИХ ЛЮДЕЙ НЕ
Dialogue: 0,0:01:48.71,0:01:51.75,Caption,,0,0,0,,ПОЛУЧИЛОСЬ. ПРИ ЭТОМ СИЛЫ ТУДА ОТПРАВИЛИ СЕРЬЁЗНЫЕ.
Dialogue: 0,0:01:52.07,0:01:55.67,Caption,,0,0,0,,ЗНАЧИТ, У ПОЛЬСКИХ СЛУЖБ БЫЛИ ОСНОВАНИЯ НЕРВНИЧАТЬ НЕ ТОЛЬКО
Dialogue: 0,0:01:55.75,0:01:57.99,Caption,,0,0,0,,ИЗ ЗА ФОНАРИКА. И ВОТ ЭТИ ОСНОВАНИЯ КУДА
Dialogue: 0,0:01:57.99,0:02:00.87,Caption,,0,0,0,,ИНТЕРЕСНЕЕ САМИХ ФОНАРИКОВ. ПОТОМУ ЧТО НАКАНУНЕ
Dialogue: 0,0:02:00.87,0:02:03.27,Caption,,0,0,0,,ПОЛЬСКИЕ ВЛАСТИ УЖЕ ПОЛУЧИЛИ ПРЕДУПРЕЖДЕНИЯ О
Dialogue: 0,0:02:03.27,0:02:06.31,Caption,,0,0,0,,ВЕРОЯТНЫХ ПРОВОКАЦИЯХ И ДИВЕРСИОННЫХ ДЕЙСТВИЯХ. ТО
Dialogue: 0,0:02:06.31,0:02:08.87,Caption,,0,0,0,,ЕСТЬ ЛЮДЕЙ С ФОНАРЯМИ УВИДЕЛИ НЕ ПОСРЕДИ ОБЫЧНОЙ
Dialogue: 0,0:02:08.87,0:02:10.95,Caption,,0,0,0,,СПОКОЙНОЙ НЕДЕЛИ, А В ТОТ МОМЕНТ,
Dialogue: 0,0:02:11.19,0:02:13.75,Caption,,0,0,0,,КОГДА ГОСУДАРСТВЕННЫЙ АППАРАТ УЖЕ СИДЕЛ НА ВЗВОДЕ И
Dialogue: 0,0:02:13.83,0:02:16.87,Caption,,0,0,0,,ЖДАЛ КАКОГО НИБУДЬ СЮРПРИЗА. И ЭТО ВАЖНО. РЕЧЬ
Dialogue: 0,0:02:16.87,0:02:20.07,Caption,,0,0,0,,НЕ О ТОМ, ЧТО ПОЛЬСКИЕ ВЛАСТИ УВИДЕЛИ ТРИ ФОНАРЯ И СОШЛИ
Dialogue: 0,0:02:20.15,0:02:24.07,Caption,,0,0,0,,С УМА. РЕЧЬ О ТОМ, ЧТО ВСЯ СИСТЕМА УЖЕ ПРИВЕДЕНА В СОСТОЯНИЕ
Dialogue: 0,0:02:24.07,0:02:30.02,Caption,,0,0,0,,ГОТОВНОСТИ. ОНА ЖДЁТ СОБЫТИЯ. И КОГДА СИСТЕМА ЧЕГО ТО ЖДЁТ,
Dialogue: 0,0:02:30.22,0:02:33.54,Caption,,0,0,0,,КАЖДАЯ СТРАННАЯ МАШИНА, КАЖДЫЙ НЕЗНАКОМЫЙ ЧЕЛОВЕК,
Dialogue: 0,0:02:33.86,0:02:36.42,Caption,,0,0,0,,КАЖДЫЙ ОГОНЁК В КУСТАХ СРАЗУ СТАНОВИТСЯ ЧАСТЬЮ
Dialogue: 0,0:02:36.42,0:02:40.02,Caption,,0,0,0,,БОЛЬШОЙ КАРТИНЫ. ИНОГДА СПРАВЕДЛИВО. ИНОГДА НЕТ. НО
Dialogue: 0,0:02:40.02,0:02:43.22,Caption,,0,0,0,,НЕРВЫ УЖЕ НАТЯНУТЫ. ПОЛЬША СЕЙЧАС ВООБЩЕ ИНТЕРЕСНА
Dialogue: 0,0:02:43.30,0:02:46.58,Caption,,0,0,0,,ТЕМ, ЧТО РАБОТАЕТ СРАЗУ НА ДВУХ НАПРАВЛЕНИЯХ. ПРИЧЁМ ЭТО
Dialogue: 0,0:02:46.66,0:02:48.74,Caption,,0,0,0,,НЕ ДВЕ РАЗНЫЕ ПОЛЬШИ И НЕ ДВЕ РАЗНЫЕ
Dialogue: 0,0:02:48.74,0:02:52.58,Caption,,0,0,0,,АРМИИ. ГОСУДАРСТВО ОДНО. СИЛОВАЯ СИСТЕМА ОДНА. НА
Dialogue: 0,0:02:52.66,0:02:54.98,Caption,,0,0,0,,СЕВЕРЕ УСИЛИВАЕТСЯ ГРАНИЦА С КАЛИНИНГРАДСКОЙ
Dialogue: 0,0:02:54.98,0:02:58.58,Caption,,0,0,0,,ОБЛАСТЬЮ. НА ВОСТОКЕ И ЮГО ВОСТОКЕ ПОЛЬША ГОТОВИТСЯ
Dialogue: 0,0:02:58.58,0:03:01.06,Caption,,0,0,0,,ИГРАТЬ КЛЮЧЕВУЮ РОЛЬ В РАЗМЕЩЕНИИ И СНАБЖЕНИИ
Dialogue: 0,0:03:01.06,0:03:05.30,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СИЛ, ЕСЛИ ПОСЛЕ ПРЕКРАЩЕНИЯ БОЕВЫХ ДЕЙСТВИЙ ИНОСТРАННЫЙ
Dialogue: 0,0:03:05.30,0:03:08.58,Caption,,0,0,0,,КОНТИНГЕНТ ВОЙДЁТ НА ТЕРРИТОРИЮ УКРАИНЫ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:03:08.58,0:03:11.22,Caption,,0,0,0,,НАЧИНАЕТСЯ УЖЕ НЕ РАЗГОВОР О СТРАШНЫХ ДИВЕРСАНТАХ С
Dialogue: 0,0:03:11.22,0:03:15.30,Caption,,0,0,0,,ФОНАРИКАМИ, А ВПОЛНЕ НОРМАЛЬНАЯ ВОЕННАЯ РАБОТА. С ДЕВЯТОГО ПО
Dialogue: 0,0:03:15.30,0:03:17.62,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОЕ НОЯБРЯ В ПОЛЬШЕ ЗАПЛАНИРОВАНЫ
Dialogue: 0,0:03:17.62,0:03:20.98,Caption,,0,0,0,,КРУПНЫЕ УЧЕНИЯ KOALICJA. ОКОЛО ДВУХ ТЫСЯЧ ВОСЬМИСОТ
Dialogue: 0,0:03:20.98,0:03:23.86,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. ФРАНЦУЗЫ, БРИТАНЦЫ,
Dialogue: 0,0:03:23.95,0:03:28.42,Caption,,0,0,0,,ПОЛЯКИ, НЕМЦЫ И ДРУГИЕ ЕВРОПЕЙСКИЕ СТРАНЫ. ОТРАБАТЫВАЕТСЯ
Dialogue: 0,0:03:28.42,0:03:31.38,Caption,,0,0,0,,КОМАНДОВАНИЕ, СВЯЗЬ, ПЕРЕБРОСКА ВОЙСК,
Dialogue: 0,0:03:31.46,0:03:37.06,Caption,,0,0,0,,СНАБЖЕНИЕ, ДОСТАВКА ТЕХНИКИ, БОРЬБА С БЕСПИЛОТНИКАМИ. ТО ЕСТЬ НЕ СИДЯТ ГЕНЕРАЛЫ
Dialogue: 0,0:03:37.06,0:03:38.98,Caption,,0,0,0,,ВОКРУГ КРУГЛОГО СТОЛА И РАССУЖДАЮТ,
Dialogue: 0,0:03:39.22,0:03:41.54,Caption,,0,0,0,,КАК КОГДА НИБУДЬ ХОРОШО БЫЛО БЫ ЧТО НИБУДЬ
Dialogue: 0,0:03:41.54,0:03:45.42,Caption,,0,0,0,,ОРГАНИЗОВАТЬ. ОНИ ПРОВЕРЯЮТ,
Dialogue: 0,0:03:45.58,0:03:48.14,Caption,,0,0,0,,КАК ЭТО БУДЕТ РАБОТАТЬ РУКАМИ И НОГАМИ. И
Dialogue: 0,0:03:48.14,0:03:51.26,Caption,,0,0,0,,ОСОБЕННО ИНТЕРЕСНАЯ ДЕТАЛЬ. ВСЯ ЭТА СИСТЕМА СТРОИТСЯ
Dialogue: 0,0:03:51.34,0:03:53.82,Caption,,0,0,0,,С РАСЧЁТОМ НА РАБОТУ БЕЗ ПРИВЫЧНОЙ АМЕРИКАНСКОЙ
Dialogue: 0,0:03:53.82,0:03:57.90,Caption,,0,0,0,,ОПОРЫ. БЕЗ ТОГО, ЧТОБЫ США ОБЯЗАТЕЛЬНО ДАЛИ СВОИ ВОЙСКА,
Dialogue: 0,0:03:58.14,0:04:00.06,Caption,,0,0,0,,СВОИ СИСТЕМЫ И СКАЗАЛИ РЕБЯТА,
Dialogue: 0,0:04:00.22,0:04:04.78,Caption,,0,0,0,,НЕ ПЕРЕЖИВАЙТЕ, ПАПА ПРИЕХАЛ. ЕВРОПЕЙЦЫ ТРЕНИРУЮТСЯ САМИ. ФРАНЦИЯ И
Dialogue: 0,0:04:04.86,0:04:09.26,Caption,,0,0,0,,БРИТАНИЯ ВЕДУТ ЭТУ ИСТОРИЮ, ОСТАЛЬНЫЕ ПОДКЛЮЧАЮТСЯ. НАТО В КУРСЕ,
Dialogue: 0,0:04:09.50,0:04:12.54,Caption,,0,0,0,,НО САМА ОПЕРАЦИЯ ОФОРМЛЯЕТСЯ ОТДЕЛЬНО. ПОДПИШИТЕСЬ,
Dialogue: 0,0:04:12.86,0:04:15.50,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ДАЛЬШЕ РАЗБИРАТЬ НЕ КРАСИВЫЕ НАЗВАНИЯ
Dialogue: 0,0:04:15.50,0:04:19.42,Caption,,0,0,0,,ОПЕРАЦИЙ, А ТО, ЧТО ЗА НИМИ РЕАЛЬНО СТОИТ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:04:19.50,0:04:22.22,Caption,,0,0,0,,ВАЖНОЕ ИЗМЕНЕНИЕ. ПОТОМУ ЧТО КОГДА НЕСКОЛЬКО ЛЕТ
Dialogue: 0,0:04:22.22,0:04:23.98,Caption,,0,0,0,,ПОЛИТИКИ РАССКАЗЫВАЮТ О ЕВРОПЕЙСКОЙ
Dialogue: 0,0:04:23.98,0:04:28.06,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТИ, ЭТО ОДНО. ПОЛИТИК ВООБЩЕ МОЖЕТ РАССКАЗАТЬ ВСЁ ЧТО
Dialogue: 0,0:04:28.14,0:04:31.10,Caption,,0,0,0,,УГОДНО. У НЕГО РАБОТА ТАКАЯ. НО КОГДА ВОЕННЫЕ
Dialogue: 0,0:04:31.18,0:04:34.38,Caption,,0,0,0,,НАЧИНАЮТ ПРОВЕРЯТЬ, ПРОХОДЯТ ЛИ КОЛОННЫ ЧЕРЕЗ ГРАНИЦЫ,
Dialogue: 0,0:04:34.62,0:04:36.94,Caption,,0,0,0,,РАБОТАЕТ ЛИ СВЯЗЬ МЕЖДУ ПОДРАЗДЕЛЕНИЯМИ,
Dialogue: 0,0:04:37.28,0:04:41.02,Caption,,0,0,0,,КТО КОГО СНАБЖАЕТ, КТО КОМУ ОТДАЁТ КОМАНДУ И ЧТО ДЕЛАТЬ,
Dialogue: 0,0:04:41.26,0:04:43.10,Caption,,0,0,0,,ЕСЛИ АМЕРИКАНСКОЙ СИСТЕМЫ РЯДОМ НЕТ,
Dialogue: 0,0:04:43.50,0:04:46.62,Caption,,0,0,0,,ЭТО УЖЕ ДРУГАЯ СТАДИЯ. И ЕЩЁ ВЕСЕЛЕЕ СТАНОВИТСЯ,
Dialogue: 0,0:04:46.98,0:04:51.26,Caption,,0,0,0,,КОГДА ЧИТАЕШЬ, ЗАЧЕМ ЭТОТ КОНТИНГЕНТ ВООБЩЕ ГОТОВЯТ. БРИТАНСКИЕ И
Dialogue: 0,0:04:51.26,0:04:54.14,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ВОЕННЫЕ ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ ДОЛЖНЫ
Dialogue: 0,0:04:54.22,0:04:57.02,Caption,,0,0,0,,БУДУТ ОБЕСПЕЧИВАТЬ БЕЗОПАСНОСТЬ УКРАИНЫ. СЛОВО
Dialogue: 0,0:04:57.02,0:05:00.38,Caption,,0,0,0,,КРАСИВОЕ. БЕЗОПАСНОСТЬ. ОЧЕНЬ МИРНОЕ СЛОВО.
Dialogue: 0,0:05:02.64,0:05:05.44,Caption,,0,0,0,,ТОЛЬКО ТЕПЕРЬ ЗАПАДНЫЕ ЧИНОВНИКИ ПРЯМО ГОВОРЯТ ЕСЛИ
Dialogue: 0,0:05:05.44,0:05:07.84,Caption,,0,0,0,,РОССИЙСКИЕ СИЛЫ НАПАДУТ НА ЭТОТ КОНТИНГЕНТ,
Dialogue: 0,0:05:08.16,0:05:10.96,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ВОЕННОСЛУЖАЩИЕ СМОГУТ ОТКРЫТЬ ОТВЕТНЫЙ
Dialogue: 0,0:05:11.04,0:05:13.44,Caption,,0,0,0,,ОГОНЬ. ВОТ МЫ И ПРИЕХАЛИ. ТО ЕСТЬ ПОСЛЕ
Dialogue: 0,0:05:13.52,0:05:15.60,Caption,,0,0,0,,ПЕРЕМИРИЯ НА ТЕРРИТОРИИ УКРАИНЫ ПОЯВЛЯЮТСЯ
Dialogue: 0,0:05:15.60,0:05:20.80,Caption,,0,0,0,,ВООРУЖЁННЫЕ БРИТАНЦЫ, ФРАНЦУЗЫ И ДРУГИЕ ЕВРОПЕЙЦЫ. РОССИЯ ЗАРАНЕЕ ГОВОРИТ,
Dialogue: 0,0:05:21.03,0:05:24.00,Caption,,0,0,0,,ЧТО ТАКОЕ ПРИСУТСТВИЕ ДЛЯ НЕЁ НЕПРИЕМЛЕМО. ЕВРОПЕЙЦЫ
Dialogue: 0,0:05:24.00,0:05:26.96,Caption,,0,0,0,,ЗАРАНЕЕ ОБСУЖДАЮТ ПРАВИЛА, ПО КОТОРЫМ БУДУТ СТРЕЛЯТЬ,
Dialogue: 0,0:05:27.13,0:05:30.08,Caption,,0,0,0,,ЕСЛИ ИХ АТАКУЮТ. И ВСЯ ЭТА КОНСТРУКЦИЯ НАЗЫВАЕТСЯ
Dialogue: 0,0:05:30.08,0:05:33.68,Caption,,0,0,0,,ОБЕСПЕЧЕНИЕМ МИРА. Я ДАЖЕ СПОРИТЬ НЕ БУДУ. НАВЕРНОЕ,
Dialogue: 0,0:05:33.89,0:05:36.40,Caption,,0,0,0,,В ВОЕННЫХ ШТАБАХ СЛОВО МИР ИМЕЕТ КАКОЙ ТО
Dialogue: 0,0:05:36.48,0:05:39.52,Caption,,0,0,0,,СВОЙ СПЕЦИАЛЬНЫЙ СМЫСЛ. КАК В МАГАЗИНЕ СЛОВО СКИДКА.
Dialogue: 0,0:05:39.76,0:05:41.92,Caption,,0,0,0,,СНАЧАЛА ЦЕНУ ПОДНЯЛИ НА СОРОК ПРОЦЕНТОВ,
Dialogue: 0,0:05:42.22,0:05:43.76,Caption,,0,0,0,,ПОТОМ СДЕЛАЛИ СКИДКУ ДВАДЦАТЬ,
Dialogue: 0,0:05:43.98,0:05:46.24,Caption,,0,0,0,,И ПОКУПАТЕЛЬ СЧАСТЛИВ. ЗДЕСЬ ПРИМЕРНО ТАК ЖЕ.
Dialogue: 0,0:05:46.47,0:05:49.12,Caption,,0,0,0,,СНАЧАЛА ВВОДИМ ВООРУЖЁННЫЙ КОНТИНГЕНТ В СТРАНУ,
Dialogue: 0,0:05:49.44,0:05:52.16,Caption,,0,0,0,,ГДЕ ТОЛЬКО ЧТО ЗАКОНЧИЛИСЬ БОЕВЫЕ ДЕЙСТВИЯ. ПОТОМ
Dialogue: 0,0:05:52.16,0:05:56.32,Caption,,0,0,0,,ЗАРАНЕЕ ОПРЕДЕЛЯЕМ, ПРИ КАКИХ УСЛОВИЯХ ОН НАЧНЁТ СТРЕЛЯТЬ. А СВЕРХУ
Dialogue: 0,0:05:56.40,0:05:59.28,Caption,,0,0,0,,АККУРАТНО ПРИКЛЕИВАЕМ ЭТИКЕТКУ БЕЗОПАСНОСТЬ. ПРИ
Dialogue: 0,0:05:59.36,0:06:01.52,Caption,,0,0,0,,ЭТОМ САМИ ЗАПАДНЫЕ ВОЕННЫЕ ПОДЧЁРКИВАЮТ,
Dialogue: 0,0:06:01.69,0:06:04.40,Caption,,0,0,0,,ЧТО ЗАДАЧИ БУДУТ ОБОРОНИТЕЛЬНЫМИ. КОНТИНГЕНТ НЕ
Dialogue: 0,0:06:04.40,0:06:06.88,Caption,,0,0,0,,СОБИРАЮТСЯ СТАВИТЬ ПРЯМО НА ЛИНИЮ СОПРИКОСНОВЕНИЯ.
Dialogue: 0,0:06:09.15,0:06:10.99,Caption,,0,0,0,,ЕГО ЗАДАЧА ДОЛЖНА СОСТОЯТЬ В ТОМ,
Dialogue: 0,0:06:11.15,0:06:15.55,Caption,,0,0,0,,ЧТОБЫ ПОДДЕРЖИВАТЬ УКРАИНУ, ПОМОГАТЬ ВОССТАНАВЛИВАТЬ ЕЁ АРМИЮ И СВОИМ
Dialogue: 0,0:06:15.55,0:06:18.03,Caption,,0,0,0,,ПРИСУТСТВИЕМ НЕ ДОПУСТИТЬ НОВОГО НАПАДЕНИЯ.
Dialogue: 0,0:06:18.59,0:06:21.31,Caption,,0,0,0,,ТОЛЬКО ПРОБЛЕМА ТУТ ОЧЕНЬ ПРОСТАЯ. КАК ТОЛЬКО ОДИН
Dialogue: 0,0:06:21.31,0:06:24.11,Caption,,0,0,0,,РОССИЙСКИЙ И ОДИН БРИТАНСКИЙ ВОЕННОСЛУЖАЩИЙ НАЧИНАЮТ
Dialogue: 0,0:06:24.11,0:06:28.27,Caption,,0,0,0,,СТРЕЛЯТЬ ДРУГ В ДРУГА, СЛОВО ОБОРОНИТЕЛЬНЫЙ СТАНОВИТСЯ УТЕШЕНИЕМ ДЛЯ ПРЕСС
Dialogue: 0,0:06:28.27,0:06:31.23,Caption,,0,0,0,,СЕКРЕТАРЯ. ДЛЯ СОЛДАТА ПУЛЯ ОТ ЭТОГО МЯГЧЕ НЕ
Dialogue: 0,0:06:31.23,0:06:33.15,Caption,,0,0,0,,СТАНОВИТСЯ. А ТЕПЕРЬ ПОСМОТРИМ,
Dialogue: 0,0:06:33.31,0:06:35.23,Caption,,0,0,0,,КАК ЭТА ЖЕ ЛОГИКА РАБОТАЕТ НА МОРЕ.
Dialogue: 0,0:06:35.92,0:06:38.99,Caption,,0,0,0,,НЕМЕЦКАЯ КОМПАНИЯ STARK DEFENCE ПРЕДСТАВИЛА НОВЫЙ
Dialogue: 0,0:06:38.99,0:06:41.87,Caption,,0,0,0,,АВТОНОМНЫЙ КАТЕР VANTA ДВАДЦАТЬ ЧЕТЫРЕ. МАШИНА
Dialogue: 0,0:06:41.87,0:06:44.99,Caption,,0,0,0,,НЕМАЛЕНЬКАЯ. ОКОЛО ДВАДЦАТИ ЧЕТЫРЁХ МЕТРОВ. БЕЗ
Dialogue: 0,0:06:44.99,0:06:48.19,Caption,,0,0,0,,ЭКИПАЖА. ПРЕДНАЗНАЧЕНА ДЛЯ БАЛТИЙСКОГО МОРЯ И ДРУГИХ
Dialogue: 0,0:06:48.19,0:06:51.31,Caption,,0,0,0,,СЕВЕРНЫХ ВОД. СРЕДИ ЗАЯВЛЕННЫХ ЗАДАЧ ЕСТЬ ОХРАНА
Dialogue: 0,0:06:51.39,0:06:54.99,Caption,,0,0,0,,ПОДВОДНЫХ КАБЕЛЕЙ, СОПРОВОЖДЕНИЕ ВОЕННЫХ КОРАБЛЕЙ И НАБЛЮДЕНИЕ ЗА
Dialogue: 0,0:06:54.99,0:06:57.71,Caption,,0,0,0,,СУДАМИ ТАК НАЗЫВАЕМОГО РОССИЙСКОГО ТЕНЕВОГО ФЛОТА.
Dialogue: 0,0:06:58.19,0:07:02.75,Caption,,0,0,0,,НАБЛЮДЕНИЕ, КОНЕЧНО, ЗВУЧИТ МИРНО. ПРОСТО ПЛАВАЕТ РОБОТ И СМОТРИТ.
Dialogue: 0,0:07:03.07,0:07:05.87,Caption,,0,0,0,,ПРАВДА, РОБОТ ЭТОТ ИЗНАЧАЛЬНО ПРОЕКТИРУЮТ ТАК,
Dialogue: 0,0:07:06.11,0:07:07.63,Caption,,0,0,0,,ЧТОБЫ НА НЕГО МОЖНО БЫЛО ПОСТАВИТЬ
Dialogue: 0,0:07:07.63,0:07:11.87,Caption,,0,0,0,,ПРОТИВОКОРАБЕЛЬНЫЕ РАКЕТЫ, ТРИДЦАТИМИЛЛИМЕТРОВУЮ ПУШКУ И ДРУГОЕ ВОЕННОЕ
Dialogue: 0,0:07:11.95,0:07:14.91,Caption,,0,0,0,,ОБОРУДОВАНИЕ. ПОЛЕЗНАЯ НАГРУЗКА ДО ПЯТИДЕСЯТИ ТОНН.
Dialogue: 0,0:07:15.23,0:07:17.87,Caption,,0,0,0,,СКОРОСТЬ БОЛЬШЕ ШЕСТИДЕСЯТИ КИЛОМЕТРОВ В ЧАС. ТО
Dialogue: 0,0:07:17.87,0:07:20.19,Caption,,0,0,0,,ЕСТЬ ПЕРЕД НАМИ ТАКОЙ ОЧЕНЬ МИРОЛЮБИВЫЙ МОРСКОЙ
Dialogue: 0,0:07:20.19,0:07:26.80,Caption,,0,0,0,,НАБЛЮДАТЕЛЬ. С ПУШКОЙ. И РАКЕТАМИ. НА ВСЯКИЙ СЛУЧАЙ. КОМПАНИЯ ПРЯМО
Dialogue: 0,0:07:26.80,0:07:30.24,Caption,,0,0,0,,ОБЪЯСНЯЕТ ЛОГИКУ. ОБЫЧНЫЙ ФРЕГАТ ДОРОГОЙ. СТРОИТСЯ
Dialogue: 0,0:07:30.24,0:07:32.96,Caption,,0,0,0,,ДОЛГО. ЭКИПАЖ НАДО ОБУЧАТЬ, КОРМИТЬ,
Dialogue: 0,0:07:33.11,0:07:35.92,Caption,,0,0,0,,РАЗМЕЩАТЬ. А БЕСПИЛОТНЫХ КАТЕРОВ МОЖНО СДЕЛАТЬ
Dialogue: 0,0:07:36.00,0:07:38.88,Caption,,0,0,0,,БОЛЬШЕ И БЫСТРЕЕ. ОДИН ОПЕРАТОР СПОСОБЕН УПРАВЛЯТЬ
Dialogue: 0,0:07:38.96,0:07:41.68,Caption,,0,0,0,,СРАЗУ НЕСКОЛЬКИМИ СИСТЕМАМИ. ПОЛУЧАЕТСЯ ВПОЛНЕ
Dialogue: 0,0:07:41.76,0:07:44.80,Caption,,0,0,0,,ПОНЯТНАЯ ВОЕННАЯ МАТЕМАТИКА. ВМЕСТО ОДНОГО ДОРОГОГО
Dialogue: 0,0:07:44.80,0:07:48.00,Caption,,0,0,0,,КОРАБЛЯ ВЫСТАВИТЬ ЦЕЛУЮ СТАЮ ДЕШЁВЫХ РОБОТОВ. И ВОТ
Dialogue: 0,0:07:48.00,0:07:50.24,Caption,,0,0,0,,ЗДЕСЬ ЕВРОПЕЙСКАЯ ПОДГОТОВКА СТАНОВИТСЯ УЖЕ
Dialogue: 0,0:07:50.24,0:07:53.68,Caption,,0,0,0,,ОБЪЁМНОЙ. НА СУШЕ ГОТОВЯТ КОНТИНГЕНТ. В ПОЛЬШЕ
Dialogue: 0,0:07:53.68,0:07:56.80,Caption,,0,0,0,,ПРОВЕРЯЮТ ЛОГИСТИКУ. НА РОССИЙСКОЙ ГРАНИЦЕ УСИЛИВАЮТ
Dialogue: 0,0:07:56.80,0:07:59.76,Caption,,0,0,0,,СИЛЫ БЕЗОПАСНОСТИ. НА МОРЕ СОЗДАЮТ БЕСПИЛОТНЫЕ
Dialogue: 0,0:07:59.76,0:08:02.72,Caption,,0,0,0,,ПЛАТФОРМЫ, КОТОРЫЕ СМОГУТ СЛЕДИТЬ ЗА ТАНКЕРАМИ И ПРИ
Dialogue: 0,0:08:02.72,0:08:05.52,Caption,,0,0,0,,НЕОБХОДИМОСТИ НЕ ТОЛЬКО СЛЕДИТЬ. И ПАРАЛЛЕЛЬНО
Dialogue: 0,0:08:05.52,0:08:07.68,Caption,,0,0,0,,БРЮССЕЛЬ НАЧИНАЕТ ОБЪЯСНЯТЬ НАСЕЛЕНИЮ,
Dialogue: 0,0:08:07.84,0:08:11.76,Caption,,0,0,0,,ЧТО ДЕЛАТЬ, ЕСЛИ ВСЯ ЭТА ПРЕКРАСНАЯ КОНСТРУКЦИЯ ОДНАЖДЫ НАЧНЁТ
Dialogue: 0,0:08:11.76,0:08:16.08,Caption,,0,0,0,,РАБОТАТЬ НЕ ПО ПЛАНУ. ЕВРОКОМИССИЯ ПРЕДСТАВИЛА НОВЫЕ РЕКОМЕНДАЦИИ ПО
Dialogue: 0,0:08:16.16,0:08:18.48,Caption,,0,0,0,,ПОДГОТОВКЕ ЖИТЕЛЕЙ СТРАН ЕС К ЧРЕЗВЫЧАЙНЫМ
Dialogue: 0,0:08:18.48,0:08:22.00,Caption,,0,0,0,,СИТУАЦИЯМ. ГЛАВНАЯ ЦИФРА ОЧЕНЬ ПРОСТАЯ. СЕМЬДЕСЯТ
Dialogue: 0,0:08:22.08,0:08:25.12,Caption,,0,0,0,,ДВА ЧАСА. ПЕРВЫЕ ТРОЕ СУТОК ЧЕЛОВЕК ДОЛЖЕН УМЕТЬ
Dialogue: 0,0:08:25.20,0:08:28.64,Caption,,0,0,0,,ПРОЖИТЬ САМ, ПОКА ГОСУДАРСТВЕННАЯ ПОМОЩЬ ТОЛЬКО РАЗВОРАЧИВАЕТСЯ.
Dialogue: 0,0:08:28.79,0:08:34.40,Caption,,0,0,0,,ВОДА. ЕДА, КОТОРАЯ ДОЛГО ХРАНИТСЯ. АПТЕЧКА. НАЛИЧНЫЕ. РАДИО НА
Dialogue: 0,0:08:34.40,0:08:37.60,Caption,,0,0,0,,БАТАРЕЙКАХ. ЗАРЯЖЕННЫЕ АККУМУЛЯТОРЫ. ДОКУМЕНТЫ И
Dialogue: 0,0:08:37.60,0:08:44.19,Caption,,0,0,0,,ВЕЩИ ДЛЯ БЫСТРОЙ ЭВАКУАЦИИ. САМ НАБОР СОВЕРШЕННО НОРМАЛЬНЫЙ. БОЛЕЕ ТОГО,
Dialogue: 0,0:08:44.28,0:08:47.63,Caption,,0,0,0,,ПОЛЕЗНЫЙ. ПОЖАР, НАВОДНЕНИЕ, БЛЭКАУТ,
Dialogue: 0,0:08:47.72,0:08:51.39,Caption,,0,0,0,,ЗЕМЛЕТРЯСЕНИЕ. В ЖИЗНИ ЧЕГО ТОЛЬКО НЕ БЫВАЕТ. ТОЛЬКО
Dialogue: 0,0:08:51.47,0:08:54.51,Caption,,0,0,0,,ИНТЕРЕСНО ДРУГОЕ. ПОЧЕМУ ИМЕННО СЕЙЧАС ВСЯ ЭТА ТЕМА
Dialogue: 0,0:08:54.51,0:08:57.07,Caption,,0,0,0,,СТАНОВИТСЯ ЧАСТЬЮ БОЛЬШОЙ ЕВРОПЕЙСКОЙ ПОЛИТИКИ
Dialogue: 0,0:08:57.07,0:09:01.39,Caption,,0,0,0,,БЕЗОПАСНОСТИ? КОМИССАР ЕС ХАДЖА ЛАБИБ ГОВОРИТ О РАСТУЩИХ РИСКАХ
Dialogue: 0,0:09:01.47,0:09:04.03,Caption,,0,0,0,,И НЕОБХОДИМОСТИ ГОТОВИТЬ ЛЮДЕЙ К СЕРЬЁЗНЫМ КРИЗИСАМ.
Dialogue: 0,0:09:04.19,0:09:06.91,Caption,,0,0,0,,ОТДЕЛЬНО ПРЕДЛАГАЕТСЯ УЧИТЬ ОСНОВАМ ТАКОЙ ГОТОВНОСТИ
Dialogue: 0,0:09:06.91,0:09:09.55,Caption,,0,0,0,,УЖЕ ДЕТЕЙ И ПЕДАГОГОВ. ПРОВОДИТЬ СПЕЦИАЛЬНЫЙ
Dialogue: 0,0:09:09.55,0:09:12.03,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ДЕНЬ ГОТОВНОСТИ. ПРОВЕРЯТЬ,
Dialogue: 0,0:09:12.19,0:09:14.75,Caption,,0,0,0,,СМОГУТ ЛИ ГОСУДАРСТВЕННЫЕ СЛУЖБЫ РАБОТАТЬ ВО ВРЕМЯ
Dialogue: 0,0:09:14.75,0:09:17.47,Caption,,0,0,0,,МАСШТАБНОГО СБОЯ. ТО ЕСТЬ РАНЬШЕ У ЕВРОПЕЙЦА БЫЛ
Dialogue: 0,0:09:17.47,0:09:20.51,Caption,,0,0,0,,СПИСОК ДЕЛ НА ВЫХОДНЫЕ. КУПИТЬ ХЛЕБ. ЗАПРАВИТЬ
Dialogue: 0,0:09:20.51,0:09:23.55,Caption,,0,0,0,,МАШИНУ. ЗАБРАТЬ РЕБЁНКА С ФУТБОЛА. ТЕПЕРЬ ТУДА
Dialogue: 0,0:09:23.63,0:09:25.95,Caption,,0,0,0,,АККУРАТНО ДОБАВЛЯЕТСЯ НОВЫЙ ПУНКТ. ПРОВЕРИТЬ
Dialogue: 0,0:09:25.95,0:09:28.19,Caption,,0,0,0,,ТРЕВОЖНЫЙ ЧЕМОДАНЧИК. ТРИ ДНЯ,
Dialogue: 0,0:09:28.35,0:09:32.27,Caption,,0,0,0,,КСТАТИ, ПРЕКРАСНЫЙ СРОК. ПЕРВЫЕ ТРОЕ СУТОК ДЕРЖИСЬ САМ. А
Dialogue: 0,0:09:32.35,0:09:34.59,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ НА ЧЕТВЁРТЫЕ, ВИДИМО,
Dialogue: 0,0:09:34.76,0:09:36.99,Caption,,0,0,0,,ГОСУДАРСТВО УЖЕ ДОЛЖНО ПОДЪЕХАТЬ И ТОРЖЕСТВЕННО
Dialogue: 0,0:09:36.99,0:09:39.95,Caption,,0,0,0,,СООБЩИТЬ, ЧТО ВСЁ ПОД КОНТРОЛЕМ. И ОПЯТЬ ЖЕ,
Dialogue: 0,0:09:40.27,0:09:42.59,Caption,,0,0,0,,САМ ПО СЕБЕ ЗАПАС ВОДЫ ВОЙНУ НЕ ОЗНАЧАЕТ.
Dialogue: 0,0:09:42.91,0:09:44.91,Caption,,0,0,0,,НО МЫ СМОТРИМ НЕ НА ОДНУ БУТЫЛКУ ВОДЫ.
Dialogue: 0,0:09:45.13,0:09:47.39,Caption,,0,0,0,,ВОТ В ЧЁМ ПРОБЛЕМА. МЫ СМОТРИМ НА ВСЮ
Dialogue: 0,0:09:47.39,0:09:50.27,Caption,,0,0,0,,КАРТИНУ ЦЕЛИКОМ. В ПОЛЬШЕ ВОЕННЫЕ ГОТОВЯТСЯ
Dialogue: 0,0:09:50.35,0:09:52.83,Caption,,0,0,0,,ОТРАБАТЫВАТЬ ПЕРЕБРОСКУ КОНТИНГЕНТА НА УКРАИНУ.
Dialogue: 0,0:09:55.11,0:09:58.07,Caption,,0,0,0,,НЕМЕЦКАЯ КОМПАНИЯ ГОТОВИТ БЕСПИЛОТНЫЕ БОЕВЫЕ КАТЕРА
Dialogue: 0,0:09:58.07,0:10:00.95,Caption,,0,0,0,,ДЛЯ БАЛТИКИ. ПОЛЬША УСИЛИВАЕТ ГРАНИЦУ И ЖДЁТ
Dialogue: 0,0:10:00.95,0:10:03.75,Caption,,0,0,0,,ДИВЕРСИОННЫЕ ГРУППЫ. ЕВРОПЕЙЦАМ ОБЪЯСНЯЮТ,
Dialogue: 0,0:10:04.06,0:10:06.47,Caption,,0,0,0,,КАК ЖИТЬ ТРОЕ СУТОК БЕЗ НОРМАЛЬНОЙ ГОСУДАРСТВЕННОЙ
Dialogue: 0,0:10:06.47,0:10:09.59,Caption,,0,0,0,,ПОМОЩИ. А РЯДОМ МОЛДОВА ОБСУЖДАЕТ УЖЕ СЛЕДУЮЩУЮ
Dialogue: 0,0:10:09.67,0:10:12.39,Caption,,0,0,0,,СТУПЕНЬ. МИНИСТЕРСТВО ОБОРОНЫ МОЛДОВЫ ПОДГОТОВИЛО
Dialogue: 0,0:10:12.39,0:10:14.55,Caption,,0,0,0,,ПРОЕКТ, ПО КОТОРОМУ ГРАЖДАНЕ СТРАНЫ,
Dialogue: 0,0:10:14.79,0:10:17.03,Caption,,0,0,0,,ЖИВУЩИЕ ЗА ГРАНИЦЕЙ И ПОДПАДАЮЩИЕ ПОД
Dialogue: 0,0:10:17.03,0:10:21.59,Caption,,0,0,0,,МОБИЛИЗАЦИОННЫЕ ОБЯЗАННОСТИ, ПОСЛЕ ПОЛУЧЕНИЯ СООТВЕТСТВУЮЩЕГО РАСПОРЯЖЕНИЯ ДОЛЖНЫ
Dialogue: 0,0:10:21.67,0:10:24.55,Caption,,0,0,0,,БУДУТ ВЕРНУТЬСЯ ДОМОЙ. ВОТ ТУТ ДИАСПОРА,
Dialogue: 0,0:10:24.64,0:10:28.63,Caption,,0,0,0,,НАВЕРНОЕ, ОСОБЕННО ОБРАДУЕТСЯ. ЧЕЛОВЕК ДВАДЦАТЬ ЛЕТ ЖИВЁТ ГДЕ
Dialogue: 0,0:10:28.71,0:10:32.55,Caption,,0,0,0,,НИБУДЬ В ИТАЛИИ. РАБОТА. ДОМ. ДЕТИ. ПО ВЫХОДНЫМ
Dialogue: 0,0:10:32.63,0:10:35.59,Caption,,0,0,0,,КОФЕ НА ПЛОЩАДИ. А ПОТОМ ПРИХОДИТ БУМАГА ДОРОГОЙ
Dialogue: 0,0:10:35.59,0:10:38.95,Caption,,0,0,0,,ГРАЖДАНИН, РОДИНА ВСПОМНИЛА, ЧТО ВЫ У НЕЁ ЕСТЬ.
Dialogue: 0,0:10:39.51,0:10:41.83,Caption,,0,0,0,,ДЛЯ РЕЗЕРВИСТОВ ВНУТРИ САМОЙ МОЛДОВЫ ПРОЕКТ
Dialogue: 0,0:10:41.83,0:10:45.03,Caption,,0,0,0,,ПРЕДУСМАТРИВАЕТ ЕЩЁ БОЛЕЕ ЖЁСТКУЮ ДИСЦИПЛИНУ. ПОСЛЕ
Dialogue: 0,0:10:45.03,0:10:47.83,Caption,,0,0,0,,МОБИЛИЗАЦИИ ПОКИДАТЬ МЕСТО ПРОЖИВАНИЯ БОЛЬШЕ ЧЕМ НА
Dialogue: 0,0:10:47.91,0:10:50.15,Caption,,0,0,0,,ДВЕНАДЦАТЬ ЧАСОВ МОЖНО БУДЕТ ТОЛЬКО С ПИСЬМЕННОГО
Dialogue: 0,0:10:50.15,0:10:53.19,Caption,,0,0,0,,РАЗРЕШЕНИЯ. ПРИЧЁМ ЭТО ПОКА ИМЕННО ПРОЕКТ. ОН
Dialogue: 0,0:10:53.27,0:10:56.15,Caption,,0,0,0,,ПРОХОДИТ ОБСУЖДЕНИЕ. ВСТУПИТЬ В СИЛУ НОВЫЕ ПРАВИЛА
Dialogue: 0,0:10:56.23,0:10:58.55,Caption,,0,0,0,,ДОЛЖНЫ ТОЛЬКО ПОСЛЕ ПРОХОЖДЕНИЯ ВСЕЙ ПРОЦЕДУРЫ
Dialogue: 0,0:10:58.55,0:11:01.67,Caption,,0,0,0,,ПРИНЯТИЯ. НО САМ ФАКТ ПОЯВЛЕНИЯ ТАКОГО ДОКУМЕНТА
Dialogue: 0,0:11:01.67,0:11:06.23,Caption,,0,0,0,,ПРЕКРАСНО ПОКАЗЫВАЕТ, КАКИЕ СЦЕНАРИИ ТЕПЕРЬ ЛЕЖАТ НА СТОЛЕ У ЕВРОПЕЙСКИХ
Dialogue: 0,0:11:06.23,0:11:12.43,Caption,,0,0,0,,ПРАВИТЕЛЬСТВ И ИХ СОСЕДЕЙ. И ВОТ ТЕПЕРЬ МОЖНО ВЕРНУТЬСЯ К ГЛАВНОМУ. ПО
Dialogue: 0,0:11:12.43,0:11:14.75,Caption,,0,0,0,,ОТДЕЛЬНОСТИ КАЖДУЮ ТАКУЮ НОВОСТЬ ОЧЕНЬ ЛЕГКО
Dialogue: 0,0:11:14.83,0:11:18.99,Caption,,0,0,0,,ОБЪЯСНИТЬ. УЧЕНИЯ? АРМИЯ ВСЕГДА ПРОВОДИТ УЧЕНИЯ. ПОГРАНИЧНИКИ?
Dialogue: 0,0:11:19.39,0:11:22.19,Caption,,0,0,0,,ОНИ ДОЛЖНЫ ОХРАНЯТЬ ГРАНИЦУ. ЛЮДИ С ФОНАРИКАМИ?
Dialogue: 0,0:11:22.36,0:11:25.15,Caption,,0,0,0,,ПОДОЗРИТЕЛЬНАЯ АКТИВНОСТЬ. БЕСПИЛОТНЫЕ КАТЕРА?
Dialogue: 0,0:11:25.23,0:11:28.11,Caption,,0,0,0,,СОВРЕМЕННАЯ ТЕХНИКА. ЗАПАСЫ НА ТРОЕ СУТОК?
Dialogue: 0,0:11:28.19,0:11:31.15,Caption,,0,0,0,,НОРМАЛЬНАЯ ГРАЖДАНСКАЯ ОБОРОНА. МОБИЛИЗАЦИОННЫЕ
Dialogue: 0,0:11:31.23,0:11:34.51,Caption,,0,0,0,,ПРАВИЛА? ГОСУДАРСТВО ОБЯЗАНО ИМЕТЬ ЗАКОНЫ НА СЛУЧАЙ ВОЙНЫ.
Dialogue: 0,0:11:34.72,0:11:37.23,Caption,,0,0,0,,КАЖДЫЙ ОТДЕЛЬНЫЙ КИРПИЧ МОЖНО НАЗВАТЬ СОВЕРШЕННО
Dialogue: 0,0:11:37.23,0:11:39.63,Caption,,0,0,0,,ОБЫЧНЫМ. ТОЛЬКО КОГДА КИРПИЧЕЙ СТАНОВИТСЯ
Dialogue: 0,0:11:39.63,0:11:43.31,Caption,,0,0,0,,ДОСТАТОЧНО, ПОЧЕМУ ТО НАЧИНАЕТ ПОЛУЧАТЬСЯ СТЕНА. И ВОТ ЭТУ
Dialogue: 0,0:11:43.31,0:11:45.87,Caption,,0,0,0,,СТЕНУ СЕГОДНЯ СТРОЯТ СРАЗУ НА НЕСКОЛЬКИХ УРОВНЯХ.
Dialogue: 0,0:11:46.19,0:11:48.83,Caption,,0,0,0,,ПЕРВЫЙ УРОВЕНЬ ВОЕННЫЙ. ЕВРОПА УЖЕ ГОТОВИТ
Dialogue: 0,0:11:48.91,0:11:51.71,Caption,,0,0,0,,КОНКРЕТНЫЙ МЕХАНИЗМ РАЗМЕЩЕНИЯ СВОИХ СИЛ НА УКРАИНЕ.
Dialogue: 0,0:11:51.95,0:11:55.39,Caption,,0,0,0,,НЕ ЛОЗУНГ. НЕ ПОЛИТИЧЕСКУЮ ДЕКЛАРАЦИЮ. КОМАНДОВАНИЕ,
Dialogue: 0,0:11:55.47,0:11:59.63,Caption,,0,0,0,,СВЯЗЬ, ЛОГИСТИКА, СНАБЖЕНИЕ, ПРАВИЛА ПРИМЕНЕНИЯ ОРУЖИЯ.
Dialogue: 0,0:12:00.19,0:12:03.15,Caption,,0,0,0,,ВТОРОЙ УРОВЕНЬ ПОГРАНИЧНЫЙ. ПОЛЬША СТЯГИВАЕТ СИЛЫ К
Dialogue: 0,0:12:03.15,0:12:05.71,Caption,,0,0,0,,РОССИЙСКОЙ ГРАНИЦЕ И ЗАРАНЕЕ РАБОТАЕТ ПО СЦЕНАРИЮ
Dialogue: 0,0:12:05.71,0:12:08.83,Caption,,0,0,0,,ДИВЕРСИЙ И ВООРУЖЁННЫХ ПРОНИКНОВЕНИЙ. ТРЕТИЙ УРОВЕНЬ
Dialogue: 0,0:12:08.83,0:12:12.03,Caption,,0,0,0,,МОРСКОЙ. БАЛТИЙСКОЕ МОРЕ ВСЁ БЫСТРЕЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:12:12.03,0:12:14.11,Caption,,0,0,0,,ПРОСТРАНСТВО ПОСТОЯННОГО НАБЛЮДЕНИЯ,
Dialogue: 0,0:12:14.35,0:12:16.83,Caption,,0,0,0,,БЕСПИЛОТНЫХ СИСТЕМ И ЗАЩИТЫ КРИТИЧЕСКОЙ
Dialogue: 0,0:12:16.83,0:12:19.63,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. ЧЕТВЁРТЫЙ УРОВЕНЬ ГРАЖДАНСКИЙ.
Dialogue: 0,0:12:21.92,0:12:26.24,Caption,,0,0,0,,НАСЕЛЕНИЕ ПРИУЧАЮТ К МЫСЛИ, ЧТО СЕРЬЁЗНЫЙ КРИЗИС СПОСОБЕН ОСТАВИТЬ ОБЫЧНОГО
Dialogue: 0,0:12:26.32,0:12:29.04,Caption,,0,0,0,,ЧЕЛОВЕКА НА НЕСКОЛЬКО СУТОК ПРАКТИЧЕСКИ ОДИН НА ОДИН
Dialogue: 0,0:12:29.12,0:12:34.16,Caption,,0,0,0,,С СОБСТВЕННЫМИ ЗАПАСАМИ. ПЯТЫЙ УРОВЕНЬ МОБИЛИЗАЦИОННЫЙ. ГОСУДАРСТВА ЗАРАНЕЕ
Dialogue: 0,0:12:34.16,0:12:36.40,Caption,,0,0,0,,ОПРЕДЕЛЯЮТ, КОГО И КАК ВОЗВРАЩАТЬ,
Dialogue: 0,0:12:36.64,0:12:39.44,Caption,,0,0,0,,ОГРАНИЧИВАТЬ В ПЕРЕДВИЖЕНИИ И СТАВИТЬ ПОД ВОИНСКУЮ
Dialogue: 0,0:12:39.44,0:12:41.76,Caption,,0,0,0,,ОБЯЗАННОСТЬ. ЭТО УЖЕ НЕ РАЗГОВОРЫ О ТОМ,
Dialogue: 0,0:12:41.92,0:12:44.48,Caption,,0,0,0,,ЧТО ЕВРОПЕ КОГДА НИБУДЬ НАДО БУДЕТ ПРИГОТОВИТЬСЯ.
Dialogue: 0,0:12:44.77,0:12:48.16,Caption,,0,0,0,,ОНА ГОТОВИТСЯ СЕЙЧАС. ИМЕННО ЭТО МЕНЯЕТ ВСЮ КАРТИНУ.
Dialogue: 0,0:12:48.63,0:12:51.04,Caption,,0,0,0,,КОГДА ОДИН ПОЛИТИК ГОВОРИТ О РОССИЙСКОЙ УГРОЗЕ,
Dialogue: 0,0:12:51.35,0:12:54.32,Caption,,0,0,0,,ЭТО ПОЛИТИЧЕСКОЕ ЗАЯВЛЕНИЕ. КОГДА ДЕСЯТЬ ПОЛИТИКОВ
Dialogue: 0,0:12:54.32,0:12:58.48,Caption,,0,0,0,,ГОВОРЯТ ТО ЖЕ САМОЕ, ЭТО УЖЕ ИНФОРМАЦИОННАЯ ЛИНИЯ. А КОГДА ПОСЛЕ ЭТИХ
Dialogue: 0,0:12:58.48,0:13:00.72,Caption,,0,0,0,,СЛОВ НАЧИНАЮТ ДВИГАТЬСЯ ПОДРАЗДЕЛЕНИЯ,
Dialogue: 0,0:13:01.04,0:13:04.96,Caption,,0,0,0,,МЕНЯТЬСЯ ИНСТРУКЦИИ, ПОЯВЛЯТЬСЯ НОВЫЕ БЕСПИЛОТНЫЕ ПЛАТФОРМЫ,
Dialogue: 0,0:13:05.19,0:13:08.00,Caption,,0,0,0,,УСИЛИВАТЬСЯ ГРАНИЦЫ И ПЕРЕПИСЫВАТЬСЯ МОБИЛИЗАЦИОННЫЕ
Dialogue: 0,0:13:08.00,0:13:10.24,Caption,,0,0,0,,ПРАВИЛА, ЭТО УЖЕ ИНФРАСТРУКТУРА.
Dialogue: 0,0:13:10.80,0:13:12.88,Caption,,0,0,0,,А ИНФРАСТРУКТУРА СОЗДАЁТСЯ НЕ ДЛЯ КРАСИВОЙ
Dialogue: 0,0:13:12.88,0:13:16.56,Caption,,0,0,0,,ФОТОГРАФИИ. САМАЯ ОПАСНАЯ ЧАСТЬ ВСЕЙ ЭТОЙ ИСТОРИИ ДАЖЕ НЕ
Dialogue: 0,0:13:16.56,0:13:20.16,Caption,,0,0,0,,В ТОМ, ЧТО ЕВРОПА ХОЧЕТ ВОЙНЫ. ХОТЕТЬ ВОЙНУ ВООБЩЕ МАЛО
Dialogue: 0,0:13:20.24,0:13:25.12,Caption,,0,0,0,,КТО ХОЧЕТ. ОНА ДОРОГАЯ, ГРЯЗНАЯ И БЫСТРО ПОРТИТ ПОЛИТИЧЕСКИЕ РЕЙТИНГИ.
Dialogue: 0,0:13:25.51,0:13:31.24,Caption,,0,0,0,,ОПАСНЕЕ ДРУГОЕ. КОГДА ДВЕ СТОРОНЫ ГОДАМИ ГОТОВЯТСЯ К ХУДШЕМУ
Dialogue: 0,0:13:31.24,0:13:33.96,Caption,,0,0,0,,СЦЕНАРИЮ, ОНИ ПОСТЕПЕННО СОЗДАЮТ УСЛОВИЯ,
Dialogue: 0,0:13:34.04,0:13:36.12,Caption,,0,0,0,,В КОТОРЫХ ДАЖЕ НЕБОЛЬШОЙ ЭПИЗОД НАЧИНАЕТ
Dialogue: 0,0:13:36.12,0:13:38.60,Caption,,0,0,0,,ВОСПРИНИМАТЬСЯ КАК НАЧАЛО ЭТОГО СЦЕНАРИЯ.
Dialogue: 0,0:13:39.32,0:13:42.20,Caption,,0,0,0,,ВОТ ОПЯТЬ ТЕ ЖЕ ФОНАРИКИ. В СПОКОЙНОЙ ОБСТАНОВКЕ
Dialogue: 0,0:13:42.20,0:13:45.24,Caption,,0,0,0,,УВИДЕЛИ НОЧЬЮ ЛЮДЕЙ ВОЗЛЕ ГРАНИЦЫ. ПОГРАНИЧНИКИ
Dialogue: 0,0:13:45.32,0:13:48.52,Caption,,0,0,0,,ПОЕХАЛИ ПРОВЕРИТЬ. РАЗОБРАЛИСЬ. РАЗОШЛИСЬ. В
Dialogue: 0,0:13:48.52,0:13:51.16,Caption,,0,0,0,,НЫНЕШНЕЙ ОБСТАНОВКЕ ТЕ ЖЕ САМЫЕ ФОНАРИКИ СРАЗУ
Dialogue: 0,0:13:51.24,0:13:54.12,Caption,,0,0,0,,ПОПАДАЮТ В СИСТЕМУ КООРДИНАТ РАЗВЕДКА ПРЕДУПРЕЖДАЛА
Dialogue: 0,0:13:54.20,0:13:58.36,Caption,,0,0,0,,О ДИВЕРСИИ, ВОЙСКА УСИЛЕНЫ, ПОЛИТИКИ ГОВОРЯТ О РОССИЙСКОЙ УГРОЗЕ,
Dialogue: 0,0:13:58.60,0:14:01.72,Caption,,0,0,0,,РЯДОМ ИДУТ КРУПНЫЕ ВОЕННЫЕ ПРИГОТОВЛЕНИЯ. И ОБЫЧНЫЙ
Dialogue: 0,0:14:01.72,0:14:04.76,Caption,,0,0,0,,ОГОНЁК В ТЕМНОТЕ УЖЕ ВЫГЛЯДИТ СОВСЕМ ИНАЧЕ. ТЕПЕРЬ
Dialogue: 0,0:14:04.84,0:14:07.88,Caption,,0,0,0,,ДОБАВИМ ИНОСТРАННЫЙ КОНТИНГЕНТ НА УКРАИНЕ. ДОПУСТИМ,
Dialogue: 0,0:14:07.98,0:14:11.00,Caption,,0,0,0,,ПЕРЕМИРИЕ ПОДПИСАНО. ЕВРОПЕЙСКИЕ ВОЕННЫЕ ЗАШЛИ.
Dialogue: 0,0:14:11.33,0:14:14.12,Caption,,0,0,0,,РОССИЙСКИЕ ПОДРАЗДЕЛЕНИЯ СТОЯТ С ДРУГОЙ СТОРОНЫ. У
Dialogue: 0,0:14:14.20,0:14:17.16,Caption,,0,0,0,,ОБОИХ ЕСТЬ ОРУЖИЕ. У ОБОИХ ЕСТЬ СВОИ ИНСТРУКЦИИ.
Dialogue: 0,0:14:17.40,0:14:20.28,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ЗАРАНЕЕ РАЗРЕШЕНО ЗАЩИЩАТЬ СЕБЯ ОГНЁМ.
Dialogue: 0,0:14:20.52,0:14:23.40,Caption,,0,0,0,,РОССИЯ СЧИТАЕТ ИХ ПРИСУТСТВИЕ УГРОЗОЙ. И ВОТ ГДЕ
Dialogue: 0,0:14:23.48,0:14:26.44,Caption,,0,0,0,,НИБУДЬ ПРОИСХОДИТ ОДИН НЕПОНЯТНЫЙ ЭПИЗОД. КТО ТО НЕ
Dialogue: 0,0:14:26.52,0:14:29.00,Caption,,0,0,0,,ТУДА ЗАЕХАЛ. КТО ТО НЕ ТАК ПОНЯЛ СИГНАЛ.
Dialogue: 0,0:14:29.18,0:14:31.80,Caption,,0,0,0,,ГДЕ ТО ПОЯВИЛСЯ БЕСПИЛОТНИК. ГДЕ ТО ПРОЗВУЧАЛ
Dialogue: 0,0:14:31.88,0:14:34.76,Caption,,0,0,0,,ВЫСТРЕЛ. У КАЖДОГО УЖЕ ЕСТЬ ГОТОВОЕ ОБЪЯСНЕНИЕ,
Dialogue: 0,0:14:34.93,0:14:37.32,Caption,,0,0,0,,КТО ВИНОВАТ. И ВОТ ТОГДА СТАНОВИТСЯ НЕ ТАК
Dialogue: 0,0:14:37.40,0:14:39.40,Caption,,0,0,0,,ВАЖНО, КТО ПЕРВЫМ ХОТЕЛ ВОЙНЫ.
Dialogue: 0,0:14:41.67,0:14:44.55,Caption,,0,0,0,,СИСТЕМА САМА НАЧИНАЕТ ТАЩИТЬ УЧАСТНИКОВ ВВЕРХ ПО
Dialogue: 0,0:14:44.55,0:14:47.83,Caption,,0,0,0,,ЛЕСТНИЦЕ ЭСКАЛАЦИИ. ПОЭТОМУ МЕНЯ И ВЕСЕЛЯТ РАЗГОВОРЫ
Dialogue: 0,0:14:47.91,0:14:51.75,Caption,,0,0,0,,О ТОМ, ЧТО ВСЁ ЭТО ДЕЛАЕТСЯ ИСКЛЮЧИТЕЛЬНО РАДИ МИРА. РАДИ
Dialogue: 0,0:14:51.75,0:14:55.03,Caption,,0,0,0,,МИРА ГОТОВЯТ УЧЕНИЯ ПО ПЕРЕБРОСКЕ ВОЙСК. РАДИ МИРА
Dialogue: 0,0:14:55.03,0:14:57.27,Caption,,0,0,0,,ИНОСТРАННЫМ СОЛДАТАМ ЗАРАНЕЕ ОБЪЯСНЯЮТ,
Dialogue: 0,0:14:57.51,0:15:00.39,Caption,,0,0,0,,КОГДА ОНИ СМОГУТ СТРЕЛЯТЬ. РАДИ МИРА СТРОЯТ
Dialogue: 0,0:15:00.39,0:15:03.91,Caption,,0,0,0,,ВООРУЖЁННЫЕ БЕСПИЛОТНЫЕ КАТЕРА. РАДИ МИРА УКРЕПЛЯЮТ
Dialogue: 0,0:15:03.91,0:15:06.95,Caption,,0,0,0,,ГРАНИЦЫ. РАДИ МИРА НАСЕЛЕНИЮ СОВЕТУЮТ ЗАПАСАТЬСЯ
Dialogue: 0,0:15:07.03,0:15:11.19,Caption,,0,0,0,,ВОДОЙ, ЕДОЙ И БАТАРЕЙКАМИ. РАДИ МИРА ПЕРЕПИСЫВАЮТ ПРАВИЛА
Dialogue: 0,0:15:11.19,0:15:14.87,Caption,,0,0,0,,МОБИЛИЗАЦИИ. ОЧЕНЬ ДЕЯТЕЛЬНЫЙ МИР ПОЛУЧАЕТСЯ. МИР,
Dialogue: 0,0:15:15.11,0:15:17.19,Caption,,0,0,0,,КОТОРЫЙ ПОЧЕМУ ТО ВСЁ ВРЕМЯ ХОДИТ В КАСКЕ.
Dialogue: 0,0:15:17.60,0:15:20.07,Caption,,0,0,0,,И ВОТ ТУТ У ЕВРОПЫ ПОЯВЛЯЕТСЯ ОДИН СЕРЬЁЗНЫЙ
Dialogue: 0,0:15:20.07,0:15:23.19,Caption,,0,0,0,,ВЫБОР. ЕСЛИ ВСЯ ЭТА ОГРОМНАЯ СИСТЕМА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:15:23.19,0:15:25.19,Caption,,0,0,0,,НУЖНА ДЛЯ СДЕРЖИВАНИЯ БОЛЬШОЙ ВОЙНЫ,
Dialogue: 0,0:15:25.59,0:15:28.23,Caption,,0,0,0,,ТОГДА ГЛАВНОЕ ЕЁ ПРЕДНАЗНАЧЕНИЕ ДОЛЖНО СОСТОЯТЬ В
Dialogue: 0,0:15:28.31,0:15:31.11,Caption,,0,0,0,,ТОМ, ЧТОБЫ НИ ОДИН ФОНАРИК, ДРОН,
Dialogue: 0,0:15:31.19,0:15:34.39,Caption,,0,0,0,,СЛУЧАЙНЫЙ ВЫСТРЕЛ ИЛИ НЕРВНЫЙ ПОГРАНИЧНИК НЕ СМОГ
Dialogue: 0,0:15:34.47,0:15:38.55,Caption,,0,0,0,,ЗАПУСТИТЬ ЦЕПОЧКУ, КОТОРУЮ ПОТОМ УЖЕ НИКТО НЕ ОСТАНОВИТ. ПОТОМУ ЧТО
Dialogue: 0,0:15:38.55,0:15:42.07,Caption,,0,0,0,,ПОДГОТОВИТЬ АРМИЮ СЛОЖНО. СОЗДАТЬ БЕСПИЛОТНЫЙ ФЛОТ
Dialogue: 0,0:15:42.23,0:15:45.11,Caption,,0,0,0,,СЛОЖНО. ОРГАНИЗОВАТЬ ПЕРЕБРОСКУ НЕСКОЛЬКИХ ТЫСЯЧ
Dialogue: 0,0:15:45.11,0:15:48.15,Caption,,0,0,0,,ВОЕННЫХ ЧЕРЕЗ ПОЛОВИНУ ЕВРОПЫ ТОЖЕ НЕПРОСТО. НО
Dialogue: 0,0:15:48.23,0:15:51.11,Caption,,0,0,0,,САМОЕ ТРУДНОЕ НАЧИНАЕТСЯ ПОТОМ. КОГДА ВСЁ ЭТО УЖЕ
Dialogue: 0,0:15:51.11,0:15:53.99,Caption,,0,0,0,,СТОИТ НА МЕСТЕ, ВООРУЖЕНО, ОБУЧЕНО,
Dialogue: 0,0:15:54.23,0:15:56.47,Caption,,0,0,0,,ПОЛУЧИЛО ИНСТРУКЦИИ И ЖДЁТ СИГНАЛА.
Dialogue: 0,0:15:58.76,0:16:00.52,Caption,,0,0,0,,И ТОГДА ОСТАЁТСЯ ТОЛЬКО НАДЕЯТЬСЯ,
Dialogue: 0,0:16:00.78,0:16:03.08,Caption,,0,0,0,,ЧТО СЛЕДУЮЩИЙ ЧЕЛОВЕК С ФОНАРИКОМ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:16:03.16,0:16:05.96,Caption,,0,0,0,,ОКАЖЕТСЯ ГРИБНИКОМ. ПОТОМУ ЧТО ЕСЛИ ЕВРОПА БУДЕТ
Dialogue: 0,0:16:06.04,0:16:08.52,Caption,,0,0,0,,ВИДЕТЬ ДИВЕРСАНТА В КАЖДОМ ОГОНЬКЕ У ГРАНИЦЫ,
Dialogue: 0,0:16:08.84,0:16:11.48,Caption,,0,0,0,,А РОССИЯ БУДЕТ ВИДЕТЬ ПОДГОТОВКУ НАПАДЕНИЯ В КАЖДОМ
Dialogue: 0,0:16:11.48,0:16:16.36,Caption,,0,0,0,,ЕВРОПЕЙСКОМ УЧЕНИИ, ОДНАЖДЫ КОМУ НИБУДЬ ХВАТИТ СОВСЕМ МАЛЕНЬКОЙ ИСКРЫ. А
Dialogue: 0,0:16:16.44,0:16:18.36,Caption,,0,0,0,,БЕНЗИНА ВОКРУГ УЖЕ НАЛИЛИ ДОСТАТОЧНО.
