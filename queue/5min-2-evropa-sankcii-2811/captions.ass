Dialogue: 0,0:00:00.12,0:00:02.13,Caption,,0,0,0,,ПЯТЫЙ ГОД ЕВРОПА ПЫТАЕТСЯ СВАЛИТЬ
Dialogue: 0,0:00:02.13,0:00:05.27,Caption,,0,0,0,,РУССКОГО МЕДВЕДЯ. ДОБРАЛИСЬ УЖЕ ДО ДВАДЦАТЬ ВТОРОГО
Dialogue: 0,0:00:05.27,0:00:07.96,Caption,,0,0,0,,ПАКЕТА САНКЦИЙ. А ЧТО МЕШАЛО ВСЁ ЭТО СДЕЛАТЬ СРАЗУ?
Dialogue: 0,0:00:08.31,0:00:10.13,Caption,,0,0,0,,ИЛИ МЕДВЕДЮ СПЕЦИАЛЬНО ДАВАЛИ ВРЕМЯ
Dialogue: 0,0:00:10.13,0:00:12.20,Caption,,0,0,0,,ПРИВЫКНУТЬ К КАЖДОМУ СЛЕДУЮЩЕМУ ПАКЕТУ?
Dialogue: 0,0:00:12.68,0:00:14.42,Caption,,0,0,0,,И ВЕДЬ ТЕПЕРЬ ЕВРОПЕЙЦАМ ПРИХОДИТСЯ
Dialogue: 0,0:00:14.42,0:00:17.23,Caption,,0,0,0,,БЕСПОКОИТЬСЯ НЕ ТОЛЬКО О МЕДВЕДЕ. ЧЕШСКИЙ ПРЕМЬЕР
Dialogue: 0,0:00:17.23,0:00:20.92,Caption,,0,0,0,,АНДРЕЙ БАБИШ ЗАДАЛ ВОПРОС, КОТОРЫЙ ЗВУЧИТ НАСТОЛЬКО ПРОСТО,
Dialogue: 0,0:00:21.01,0:00:23.12,Caption,,0,0,0,,ЧТО ДАЖЕ КАК ТО НЕУДОБНО. УКРАИНА С
Dialogue: 0,0:00:23.12,0:00:25.38,Caption,,0,0,0,,НАЧАЛА КОНФЛИКТА ПОЛУЧИЛА ПЯТЬСОТ ДВАДЦАТЬ
Dialogue: 0,0:00:25.38,0:00:28.07,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ПРЯМОЙ И КОСВЕННОЙ ПОМОЩИ. ЕЩЁ
Dialogue: 0,0:00:28.07,0:00:30.94,Caption,,0,0,0,,ДЕВЯНОСТО МИЛЛИАРДОВ ПРЕДУСМОТРЕЛИ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:00:30.94,0:00:33.48,Caption,,0,0,0,,ШЕСТОЙ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОДЫ. ТЕПЕРЬ
Dialogue: 0,0:00:33.48,0:00:36.01,Caption,,0,0,0,,ТРЕБУЕТСЯ ЕЩЁ СЕМЬДЕСЯТ МИЛЛИАРДОВ. И БАБИШ
Dialogue: 0,0:00:36.01,0:00:37.88,Caption,,0,0,0,,СПРАШИВАЕТ А КОНЕЧНАЯ ЦЕЛЬ ГДЕ?
Dialogue: 0,0:00:38.08,0:00:40.30,Caption,,0,0,0,,ПРИЧЁМ БАБИШ ОТДЕЛЬНО ВЫСТУПИЛ ПРОТИВ
Dialogue: 0,0:00:40.30,0:00:43.36,Caption,,0,0,0,,ВЫДЕЛЕНИЯ ЕЩЁ СТА МИЛЛИАРДОВ ЕВРО УКРАИНЕ ИЗ ОБЩЕГО
Dialogue: 0,0:00:43.36,0:00:46.45,Caption,,0,0,0,,СЕМИЛЕТНЕГО БЮДЖЕТА ЕВРОСОЮЗА. ЕГО ВОЗРАЖЕНИЕ
Dialogue: 0,0:00:46.45,0:00:49.18,Caption,,0,0,0,,ПРОСТОЕ ЧЕХИЯ ДОЛЖНА ВСЁ БОЛЬШЕ ПЛАТИТЬ В ОБЩИЙ
Dialogue: 0,0:00:49.18,0:00:52.06,Caption,,0,0,0,,БЮДЖЕТ, А ОБРАТНО ПОЛУЧАЕТ ВСЁ МЕНЬШЕ. ПОЭТОМУ
Dialogue: 0,0:00:52.06,0:00:54.28,Caption,,0,0,0,,ФИНАНСИРОВАТЬ УКРАИНУ, СЧИТАЕТ БАБИШ,
Dialogue: 0,0:00:54.44,0:00:56.99,Caption,,0,0,0,,НУЖНО ВНЕ ЭТОГО БЮДЖЕТА. ВОТ ЕЩЁ ОДИН
Dialogue: 0,0:00:56.99,0:00:59.72,Caption,,0,0,0,,ВОПРОС К ЕВРОПЕЙСКОЙ АРИФМЕТИКЕ. СТО ТРИДЦАТЬ
Dialogue: 0,0:00:59.72,0:01:02.18,Caption,,0,0,0,,ПЯТЬ МИЛЛИАРДОВ ЕВРО КАЖДЫЙ ГОД. ДЕСЯТЬ
Dialogue: 0,0:01:02.18,0:01:05.16,Caption,,0,0,0,,ЛЕТ? ДВАДЦАТЬ? ТРИДЦАТЬ? ВОТ ЧТО ЭТО ЗА СТРАТЕГИЯ?
Dialogue: 0,0:01:05.56,0:01:09.48,Caption,,0,0,0,,ВОПРОС, МЕЖДУ ПРОЧИМ, НЕ РОССИЙСКИЙ. НЕ КРЕМЛЁВСКИЙ. НЕ ЧЕЙ
Dialogue: 0,0:01:09.48,0:01:15.54,Caption,,0,0,0,,ТО ТАМ ХИТРЫЙ ВБРОС. ЕГО ЗАДАЁТ ПРЕМЬЕР СТРАНЫ ЕВРОСОЮЗА.
Dialogue: 0,0:01:15.54,0:01:18.23,Caption,,0,0,0,,ПРИЧЁМ СТРАНЫ, КОТОРАЯ ПРЕКРАСНО ЗНАЕТ,
Dialogue: 0,0:01:18.39,0:01:20.67,Caption,,0,0,0,,ЧТО ТАКОЕ ПОМОЩЬ УКРАИНЕ И СКОЛЬКО ЭТА
Dialogue: 0,0:01:20.67,0:01:23.89,Caption,,0,0,0,,ПОМОЩЬ СТОИТ. ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ ТОЛЬКО САМИ
Dialogue: 0,0:01:23.89,0:01:27.13,Caption,,0,0,0,,НОВОСТИ, А ТО, КАКИЕ НЕУДОБНЫЕ ВОПРОСЫ НАЧИНАЮТ ИЗ
Dialogue: 0,0:01:27.13,0:01:30.03,Caption,,0,0,0,,НИХ ТОРЧАТЬ, ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО С
Dialogue: 0,0:01:30.03,0:01:33.17,Caption,,0,0,0,,ДЕНЬГАМИ ЗДЕСЬ ТОЛЬКО НАЧИНАЕТСЯ. В ГЕРМАНИИ ФРИДРИХ
Dialogue: 0,0:01:33.17,0:01:35.91,Caption,,0,0,0,,МЕРЦ ТОЖЕ ПРИШЁЛ В ПАРЛАМЕНТ С ДЕНЬГАМИ. ТОЧНЕЕ,
Dialogue: 0,0:01:35.99,0:01:39.61,Caption,,0,0,0,,С ОБЪЯСНЕНИЕМ, ПОЧЕМУ ДЕНЕГ ТЕПЕРЬ НА ВСЁ НЕ ХВАТИТ.
Dialogue: 0,0:01:39.61,0:01:41.78,Caption,,0,0,0,,ОН ПРЯМО ГОВОРИТ ГЕРМАНИЯ ПЕРЕЖИВАЕТ
Dialogue: 0,0:01:41.78,0:01:45.35,Caption,,0,0,0,,ГЛУБОКИЙ КРИЗИС АДАПТАЦИИ. ПРОБЛЕМЫ ГЕОПОЛИТИЧЕСКИЕ,
Dialogue: 0,0:01:45.43,0:01:48.61,Caption,,0,0,0,,ТЕХНОЛОГИЧЕСКИЕ, ДЕМОГРАФИЧЕСКИЕ. И БЮДЖЕТ НА ДВЕ
Dialogue: 0,0:01:48.61,0:01:51.37,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД ВСЁ ЭТО ПРЕКРАСНО
Dialogue: 0,0:01:51.37,0:01:54.23,Caption,,0,0,0,,ПОКАЗЫВАЕТ. ДАЛЬШЕ ЕЩЁ ИНТЕРЕСНЕЕ. НЕМЦАМ,
Dialogue: 0,0:01:54.23,0:01:57.27,Caption,,0,0,0,,ПО СЛОВАМ КАНЦЛЕРА, ПРИДЁТСЯ ОТКАЗАТЬСЯ ОТ НЕКОТОРЫХ
Dialogue: 0,0:01:57.27,0:01:59.81,Caption,,0,0,0,,ПРИВЫЧНЫХ ПРЕДСТАВЛЕНИЙ. ГОСУДАРСТВО БОЛЬШЕ НЕ
Dialogue: 0,0:01:59.81,0:02:01.83,Caption,,0,0,0,,СМОЖЕТ ФИНАНСИРОВАТЬ ИЗ НАЛОГОВ ВСЁ,
Dialogue: 0,0:02:01.99,0:02:03.99,Caption,,0,0,0,,К ЧЕМУ ЛЮДИ ПРИВЫКЛИ ЗА ДОЛГИЕ ГОДЫ.
Dialogue: 0,0:02:04.56,0:02:06.52,Caption,,0,0,0,,ИЗ ЗАЛА ЕМУ ТУТ ЖЕ ПРИЛЕТАЕТ РЕПЛИКА
Dialogue: 0,0:02:06.52,0:02:09.17,Caption,,0,0,0,,ОТ ДЕПУТАТА АДГ МАРКУСА ФРОНМАЙЕРА ДЕНЬГИ
Dialogue: 0,0:02:09.17,0:02:11.71,Caption,,0,0,0,,ЕСТЬ, ИХ ОТПРАВИЛИ НА УКРАИНУ. КРАСИВО
Dialogue: 0,0:02:11.71,0:02:14.71,Caption,,0,0,0,,ВСТРЕТИЛИСЬ ДВЕ ЭКОНОМИКИ В ОДНОМ ПОМЕЩЕНИИ. МЕРЦ
Dialogue: 0,0:02:14.71,0:02:17.53,Caption,,0,0,0,,ОТВЕЧАЕТ СВОЕЙ ЛОГИКОЙ. ГЕРМАНИЯ СЛИШКОМ ДОЛГО
Dialogue: 0,0:02:17.53,0:02:21.24,Caption,,0,0,0,,ЭКОНОМИЛА НА ВНЕШНЕЙ БЕЗОПАСНОСТИ. ТЕПЕРЬ ЭТО ИСПРАВЛЯЮТ.
Dialogue: 0,0:02:21.24,0:02:23.75,Caption,,0,0,0,,БОЛЕЕ ТОГО, ГЕРМАНИЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:02:23.91,0:02:26.73,Caption,,0,0,0,,СТАЛА СИЛЬНЕЕ, ЧЕМ КОГДА ЛИБО ЗА ПОСЛЕДНИЕ
Dialogue: 0,0:02:26.73,0:02:31.91,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯ. ЕСТЬ ТОЛЬКО МАЛЕНЬКАЯ ПОДРОБНОСТЬ. ЭТА
Dialogue: 0,0:02:31.91,0:02:34.87,Caption,,0,0,0,,НОВАЯ СИЛА СТАЛА ВОЗМОЖНА БЛАГОДАРЯ НОВЫМ ДОЛГАМ.
Dialogue: 0,0:02:34.87,0:02:38.18,Caption,,0,0,0,,ТО ЕСТЬ СИЛА ЕСТЬ. ДЕНЬГИ ТОЖЕ ЕСТЬ. ПРАВДА,
Dialogue: 0,0:02:38.29,0:02:40.67,Caption,,0,0,0,,ДЕНЬГИ ЗАЁМНЫЕ. НО ЗАТО ЗВУЧИТ
Dialogue: 0,0:02:40.67,0:02:44.08,Caption,,0,0,0,,СОЛИДНО. МЕРЦ ОТДЕЛЬНО ЗАЩИЩАЕТ РАСХОДЫ НА УКРАИНУ.
Dialogue: 0,0:02:44.08,0:02:46.50,Caption,,0,0,0,,ПО ЕГО ВЕРСИИ, РОССИЯ ПРЕКРАСНО ЗНАЕТ,
Dialogue: 0,0:02:46.56,0:02:49.70,Caption,,0,0,0,,ЧЕГО ХОЧЕТ, ЕЁ ЦЕЛИ НЕ ЗАКАНЧИВАЮТСЯ УКРАИНОЙ,
Dialogue: 0,0:02:49.86,0:02:51.69,Caption,,0,0,0,,НАПРЯЖЕНИЕ ИДЁТ И В БАЛТИЙСКОМ
Dialogue: 0,0:02:51.69,0:02:54.34,Caption,,0,0,0,,РЕГИОНЕ, И В ПОЛЬШЕ, И В ЧЁРНОМ МОРЕ,
Dialogue: 0,0:02:54.50,0:02:56.87,Caption,,0,0,0,,И ДАЖЕ В КОСМОСЕ. ПОЭТОМУ ПОМОЩЬ КИЕВУ
Dialogue: 0,0:02:56.87,0:02:59.73,Caption,,0,0,0,,ДЛЯ ГЕРМАНИИ ЯВЛЯЕТСЯ ЕЩЁ И ЗАЩИТОЙ САМОЙ
Dialogue: 0,0:02:59.73,0:03:02.55,Caption,,0,0,0,,ГЕРМАНИИ. ЕСТЬ И ПРАКТИЧЕСКИЙ АРГУМЕНТ. НЕМЦЫ
Dialogue: 0,0:03:02.55,0:03:05.35,Caption,,0,0,0,,ПОЛУЧАЮТ УКРАИНСКИЙ ОПЫТ В ГРАЖДАНСКИХ И ОБОРОННЫХ
Dialogue: 0,0:03:05.35,0:03:08.42,Caption,,0,0,0,,ТЕХНОЛОГИЯХ, РАЗВИВАЮТ ЭКОНОМИЧЕСКИЕ ОТНОШЕНИЯ,
Dialogue: 0,0:03:08.50,0:03:11.03,Caption,,0,0,0,,УЧАТСЯ. И ВСЁ ЭТО ЗАКАНЧИВАЕТСЯ ФРАЗОЙ
Dialogue: 0,0:03:11.03,0:03:15.09,Caption,,0,0,0,,СРЕДСТВ НА ВСЁ БОЛЬШЕ НЕТ. ВОТ ТУТ БАБИШ СО СВОИМ ВОПРОСОМ
Dialogue: 0,0:03:15.09,0:03:18.32,Caption,,0,0,0,,СТАНОВИТСЯ ОСОБЕННО НЕУДОБНЫМ. ЕСЛИ ДЕНЕГ НА ВСЁ БОЛЬШЕ
Dialogue: 0,0:03:18.32,0:03:20.34,Caption,,0,0,0,,НЕТ, ТО ХОТЕЛОСЬ БЫ ВСЁ ТАКИ ПОНЯТЬ,
Dialogue: 0,0:03:20.42,0:03:22.26,Caption,,0,0,0,,СКОЛЬКО ЛЕТ БУДЕТ РАБОТАТЬ СХЕМА,
Dialogue: 0,0:03:22.51,0:03:24.42,Caption,,0,0,0,,ПРИ КОТОРОЙ НОВЫЕ ДЕСЯТКИ МИЛЛИАРДОВ
Dialogue: 0,0:03:24.42,0:03:27.86,Caption,,0,0,0,,НАХОДЯТСЯ РЕГУЛЯРНО, А ОТВЕТ НА ВОПРОС О КОНЕЧНОЙ ТОЧКЕ ВСЁ
Dialogue: 0,0:03:27.86,0:03:29.62,Caption,,0,0,0,,ВРЕМЯ ОТПРАВЛЯЕТСЯ КУДА ТО ПОТОМ.
Dialogue: 0,0:03:30.24,0:03:32.46,Caption,,0,0,0,,И НА ЭТОМ ФОНЕ ЕВРОПА ГОТОВИТ ДВАДЦАТЬ
Dialogue: 0,0:03:32.46,0:03:35.47,Caption,,0,0,0,,ВТОРОЙ ПАКЕТ САНКЦИЙ ПРОТИВ РОССИИ. ДВАДЦАТЬ
Dialogue: 0,0:03:35.47,0:03:38.21,Caption,,0,0,0,,ВТОРОЙ. ВОТ ЗДЕСЬ ДЕЙСТВИТЕЛЬНО ХОЧЕТСЯ СПРОСИТЬ А
Dialogue: 0,0:03:38.21,0:03:40.23,Caption,,0,0,0,,ЧТО, НЕЛЬЗЯ БЫЛО ВСЁ ЭТО СДЕЛАТЬ В ПЕРВЫЙ
Dialogue: 0,0:03:40.23,0:03:42.12,Caption,,0,0,0,,ГОД? ЧЕГО УДОВОЛЬСТВИЕ НА ПЯТЬ ЛЕТ
Dialogue: 0,0:03:42.12,0:03:47.01,Caption,,0,0,0,,РАСТЯНУЛИ? ЕСЛИ ЗАДАЧА БЫЛА СВАЛИТЬ МЕДВЕДЯ,
Dialogue: 0,0:03:47.09,0:03:49.21,Caption,,0,0,0,,ЛОГИКА ВРОДЕ ПРОСТАЯ. НАВАЛИВАТЬСЯ
Dialogue: 0,0:03:49.21,0:03:51.81,Caption,,0,0,0,,НАДО СРАЗУ ВСЕМ, ЧЕМ МОЖЕШЬ. БАНКАМИ,
Dialogue: 0,0:03:51.90,0:03:55.17,Caption,,0,0,0,,ТОРГОВЛЕЙ, ЭНЕРГЕТИКОЙ, МОРСКИМИ ПЕРЕВОЗКАМИ,
Dialogue: 0,0:03:55.25,0:03:58.95,Caption,,0,0,0,,ТЕХНОЛОГИЯМИ, ДЕНЬГАМИ. НЕТ. РЕШИЛИ ВЫДАВАТЬ
Dialogue: 0,0:03:58.95,0:04:03.23,Caption,,0,0,0,,ПОРЦИЯМИ. ПЕРВЫЙ ПАКЕТ. ВТОРОЙ. ПЯТЫЙ. ДЕСЯТЫЙ.
Dialogue: 0,0:04:03.23,0:04:07.13,Caption,,0,0,0,,ДВАДЦАТЫЙ. ТЕПЕРЬ ДВАДЦАТЬ ВТОРОЙ. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ
Dialogue: 0,0:04:07.13,0:04:10.69,Caption,,0,0,0,,КОНСТРУКЦИЯ. РОССИЯ ПОЛУЧАЕТ ОЧЕРЕДНОЕ ОГРАНИЧЕНИЕ,
Dialogue: 0,0:04:10.77,0:04:14.94,Caption,,0,0,0,,ЖИВЁТ С НИМ, ИЩЕТ ОБХОД, ПЕРЕСТРАИВАЕТСЯ. ПОТОМ ПОЛУЧАЕТ
Dialogue: 0,0:04:14.94,0:04:18.06,Caption,,0,0,0,,СЛЕДУЮЩЕЕ. ОПЯТЬ ПЕРЕСТРАИВАЕТСЯ. ТАК В ЧЁМ ЛОГИКА
Dialogue: 0,0:04:18.06,0:04:21.41,Caption,,0,0,0,,ДВАДЦАТИ ДВУХ ПАКЕТОВ? ДАТЬ РОССИИ ВРЕМЯ ПРИВЫКНУТЬ ИЛИ ЧТО?
Dialogue: 0,0:04:21.89,0:04:24.11,Caption,,0,0,0,,А ПАКЕТ ПРИ ЭТОМ СОВСЕМ НЕ МАЛЕНЬКИЙ.
Dialogue: 0,0:04:24.11,0:04:26.06,Caption,,0,0,0,,ЕЩЁ ШЕСТЬДЕСЯТ РОССИЙСКИХ БАНКОВ ХОТЯТ
Dialogue: 0,0:04:26.06,0:04:28.64,Caption,,0,0,0,,ОТКЛЮЧИТЬ ОТ СВИФТ. ОГРАНИЧЕНИЯ РАСШИРЯЮТ НА
Dialogue: 0,0:04:28.64,0:04:31.84,Caption,,0,0,0,,КРИПТОВАЛЮТНЫЕ И ПЛАТЁЖНЫЕ СЕТИ. ПРИЧЁМ ДОБИРАЮТСЯ УЖЕ
Dialogue: 0,0:04:31.84,0:04:33.57,Caption,,0,0,0,,И ДО КОМПАНИЙ В ТРЕТЬИХ СТРАНАХ,
Dialogue: 0,0:04:33.81,0:04:35.93,Caption,,0,0,0,,КОТОРЫЕ ПОМОГАЮТ ОБХОДИТЬ САНКЦИИ.
Dialogue: 0,0:04:35.93,0:04:38.61,Caption,,0,0,0,,ЕВРОПЕЙСКИМ КОМПАНИЯМ ХОТЯТ ЗАПРЕТИТЬ ПОМОГАТЬ
Dialogue: 0,0:04:38.61,0:04:41.16,Caption,,0,0,0,,РОССИИ СТРОИТЬ, ОБСЛУЖИВАТЬ И РЕМОНТИРОВАТЬ
Dialogue: 0,0:04:41.16,0:04:45.08,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИЕ ОБЪЕКТЫ. НЕФТЕПЕРЕРАБАТЫВАЮЩИЕ ЗАВОДЫ СЮДА
Dialogue: 0,0:04:45.08,0:04:47.89,Caption,,0,0,0,,ВХОДЯТ. ВПЕРВЫЕ ОГРАНИЧЕНИЯ СОБИРАЮТСЯ РАСПРОСТРАНИТЬ
Dialogue: 0,0:04:47.89,0:04:50.52,Caption,,0,0,0,,И НА УСЛУГИ В ЭЛЕКТРОЭНЕРГЕТИКЕ. В СПИСОК ТАК
Dialogue: 0,0:04:50.52,0:04:53.72,Caption,,0,0,0,,НАЗЫВАЕМОГО ТЕНЕВОГО ФЛОТА ХОТЯТ ДОБАВИТЬ ЕЩЁ БОЛЬШЕ
Dialogue: 0,0:04:53.72,0:04:56.77,Caption,,0,0,0,,СЕМИДЕСЯТИ СУДОВ. ТАНКЕРНЫМ ПЕРЕВОЗКАМ ПОД РОССИЙСКОЙ
Dialogue: 0,0:04:56.77,0:04:59.17,Caption,,0,0,0,,СТРАХОВКОЙ ТОЖЕ СОБИРАЮТСЯ ПЕРЕКРЫВАТЬ ДОРОГУ.
Dialogue: 0,0:05:01.44,0:05:03.46,Caption,,0,0,0,,ГРАЖДАНАМ ЕВРОСОЮЗА ХОТЯТ ЗАПРЕТИТЬ
Dialogue: 0,0:05:03.46,0:05:06.06,Caption,,0,0,0,,ЗАНИМАТЬ РУКОВОДЯЩИЕ ДОЛЖНОСТИ В РОССИЙСКИХ
Dialogue: 0,0:05:06.06,0:05:09.36,Caption,,0,0,0,,КОМПАНИЯХ. БЫВШИМ РОССИЙСКИМ ВОЕННЫМ ХОТЯТ ЗАКРЫТЬ ВЪЕЗД
Dialogue: 0,0:05:09.36,0:05:12.29,Caption,,0,0,0,,В ЕВРОСОЮЗ. РОССИЙСКИМ КОМАНДАМ И СПОРТСМЕНАМ ПОД
Dialogue: 0,0:05:12.29,0:05:14.49,Caption,,0,0,0,,РОССИЙСКИМ ФЛАГОМ ХОТЯТ ЗАПРЕТИТЬ УЧАСТИЕ В
Dialogue: 0,0:05:14.49,0:05:17.61,Caption,,0,0,0,,СОРЕВНОВАНИЯХ В СТРАНАХ ЕС. ОФИЦИАЛЬНУЮ РОССИЙСКУЮ
Dialogue: 0,0:05:17.61,0:05:20.27,Caption,,0,0,0,,СИМВОЛИКУ ТОЖЕ ХОТЯТ ОГРАНИЧИТЬ. ПЕРЕВОДЫ ОТ
Dialogue: 0,0:05:20.27,0:05:23.41,Caption,,0,0,0,,РОССИЙСКИХ СПОНСОРОВ ЕВРОПЕЙСКИМ СПОРТИВНЫМ И КУЛЬТУРНЫМ
Dialogue: 0,0:05:23.41,0:05:26.24,Caption,,0,0,0,,ОРГАНИЗАЦИЯМ ПЕРЕКРЫТЬ. РОССИЯН НЕ ДОПУСКАТЬ К
Dialogue: 0,0:05:26.24,0:05:29.28,Caption,,0,0,0,,РУКОВОДСТВУ ЕВРОПЕЙСКИМИ СПОРТИВНЫМИ ФЕДЕРАЦИЯМИ.
Dialogue: 0,0:05:29.28,0:05:32.53,Caption,,0,0,0,,УРСУЛА ФОН ДЕР ЛЯЙЕН ОБЪЯСНЯЕТ ЭТО ПРОСТО. СПОРТИВНЫЕ
Dialogue: 0,0:05:32.53,0:05:35.40,Caption,,0,0,0,,СОРЕВНОВАНИЯ НЕ ДОЛЖНЫ СТАНОВИТЬСЯ ПЛОЩАДКОЙ ДЛЯ
Dialogue: 0,0:05:35.40,0:05:37.52,Caption,,0,0,0,,ПРОПАГАНДЫ. ТО ЕСТЬ НАЧИНАЛИ С БАНКОВ,
Dialogue: 0,0:05:37.60,0:05:40.88,Caption,,0,0,0,,НЕФТИ И ТЕХНОЛОГИЙ. ДОШЛИ ДО СПОРТИВНЫХ ФЕДЕРАЦИЙ.
Dialogue: 0,0:05:41.16,0:05:44.65,Caption,,0,0,0,,МЕДВЕДЬ, ВИДИМО, ОСОБЕННО УЯЗВИМ ПЕРЕД ЗАПРЕТОМ НА
Dialogue: 0,0:05:44.65,0:05:47.60,Caption,,0,0,0,,СОРЕВНОВАНИЯ. И ВСЁ ЭТО, ПО СЛОВАМ ФОН ДЕР ЛЯЙЕН,
Dialogue: 0,0:05:47.87,0:05:49.60,Caption,,0,0,0,,БУДЕТ ПРОДОЛЖАТЬСЯ ДО ТЕХ ПОР,
Dialogue: 0,0:05:49.77,0:05:51.76,Caption,,0,0,0,,ПОКА РОССИЯ НЕ ПОКАЖЕТ ИСКРЕННЕГО
Dialogue: 0,0:05:51.76,0:05:54.22,Caption,,0,0,0,,СТРЕМЛЕНИЯ К ПРОЧНОМУ МИРУ. НАПИШИТЕ В
Dialogue: 0,0:05:54.22,0:05:57.18,Caption,,0,0,0,,КОММЕНТАРИЯХ, В ЧЁМ ВЫ ВИДИТЕ ЛОГИКУ ДВАДЦАТИ ДВУХ
Dialogue: 0,0:05:57.18,0:06:00.94,Caption,,0,0,0,,ПАКЕТОВ. И ПОДПИСЫВАЙТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО
Dialogue: 0,0:06:00.94,0:06:03.54,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ ВЕСЁЛОЕ. САНКЦИИ
Dialogue: 0,0:06:03.54,0:06:07.72,Caption,,0,0,0,,НАЧИНАЮТ СЧИТАТЬ УЖЕ ТЕ, КТО СОБИРАЕТСЯ К НИМ ПРИСОЕДИНЯТЬСЯ.
Dialogue: 0,0:06:07.72,0:06:09.99,Caption,,0,0,0,,МОЛДАВИЯ НАЧАЛА ГОТОВИТЬ СОБСТВЕННЫЙ ПЛАН
Dialogue: 0,0:06:09.99,0:06:13.36,Caption,,0,0,0,,ПРИСОЕДИНЕНИЯ К САНКЦИЯМ ЕВРОСОЮЗА ПРОТИВ РОССИИ И БЕЛОРУССИИ.
Dialogue: 0,0:06:15.63,0:06:17.50,Caption,,0,0,0,,ДО КОНЦА ЯНВАРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:06:17.50,0:06:19.55,Caption,,0,0,0,,СЕДЬМОГО ГОДА ВЛАСТИ ДОЛЖНЫ ОПРЕДЕЛИТЬ,
Dialogue: 0,0:06:19.69,0:06:22.28,Caption,,0,0,0,,КАКИЕ ОГРАНИЧЕНИЯ ВВОДИТЬ. НО СНАЧАЛА
Dialogue: 0,0:06:22.28,0:06:24.84,Caption,,0,0,0,,ОНИ ХОТЯТ ОЦЕНИТЬ ПОСЛЕДСТВИЯ ДЛЯ ЭКОНОМИКИ
Dialogue: 0,0:06:24.84,0:06:28.23,Caption,,0,0,0,,САМОЙ МОЛДАВИИ. ВОТ ЭТО ПРАВИЛЬНЫЙ ПОРЯДОК. СНАЧАЛА
Dialogue: 0,0:06:28.23,0:06:30.83,Caption,,0,0,0,,РЕШИЛИ ПРИСОЕДИНИТЬСЯ. ПОТОМ ПОСЧИТАЕМ,
Dialogue: 0,0:06:30.91,0:06:32.83,Caption,,0,0,0,,СКОЛЬКО ЭТО БУДЕТ СТОИТЬ. ПО КРАЙНЕЙ
Dialogue: 0,0:06:32.83,0:06:35.79,Caption,,0,0,0,,МЕРЕ СЧИТАТЬ СОБИРАЮТСЯ. А СЧИТАТЬ В ЕВРОПЕ СЕЙЧАС
Dialogue: 0,0:06:35.79,0:06:38.45,Caption,,0,0,0,,ЕСТЬ ЧТО. ГЛАВА ИТАЛЬЯНСКОЙ ЭНЕРГЕТИЧЕСКОЙ
Dialogue: 0,0:06:38.45,0:06:41.07,Caption,,0,0,0,,КОМПАНИИ ЭНИ КЛАУДИО ДЕСКАЛЬЦИ ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:06:41.33,0:06:43.35,Caption,,0,0,0,,ЧТО ПОСЛЕ ЗАПРЕТА ИМПОРТА РОССИЙСКОГО
Dialogue: 0,0:06:43.35,0:06:46.63,Caption,,0,0,0,,ГАЗА С ПЕРВОГО ЯНВАРЯ ЕВРОПА ПОТЕРЯЕТ ОКОЛО ДВАДЦАТИ
Dialogue: 0,0:06:46.63,0:06:49.95,Caption,,0,0,0,,МИЛЛИАРДОВ КУБОМЕТРОВ ГАЗА В ГОД. И ЭТО НЕ ОБЪЁМ,
Dialogue: 0,0:06:50.11,0:06:52.33,Caption,,0,0,0,,КОТОРЫЙ МОЖНО СПОКОЙНО ЗАМЕНИТЬ ДРУГОЙ
Dialogue: 0,0:06:52.33,0:06:56.57,Caption,,0,0,0,,ТРУБОЙ. ПО СЛОВАМ ДЕСКАЛЬЦИ, ДАЖЕ ПОЛНОЕ ВОЗОБНОВЛЕНИЕ ПОСТАВОК ИЗ
Dialogue: 0,0:06:56.57,0:06:59.70,Caption,,0,0,0,,КАТАРА НЕ ЗАКРОЕТ ЭТУ ДЫРУ. ЕСЛИ ЗИМА ОКАЖЕТСЯ
Dialogue: 0,0:06:59.70,0:07:02.51,Caption,,0,0,0,,СУРОВОЙ, А ЕВРОПЕЙСКИЕ ЗАПАСЫ БУДУТ НИЗКИМИ,
Dialogue: 0,0:07:02.75,0:07:06.28,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ СОКРАТИТСЯ, ЦЕНЫ ВЫРАСТУТ. ТО ЕСТЬ ДВАДЦАТЬ
Dialogue: 0,0:07:06.28,0:07:08.75,Caption,,0,0,0,,МИЛЛИАРДОВ КУБОМЕТРОВ ИСЧЕЗАЮТ ЕЖЕГОДНО,
Dialogue: 0,0:07:08.95,0:07:11.41,Caption,,0,0,0,,А ПОЛНОЙ ЗАМЕНЫ ИМ ПОКА НЕТ. ДЕСКАЛЬЦИ
Dialogue: 0,0:07:11.41,0:07:14.33,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОВОРИТ И О ПРОДЛЕНИИ ПОТОЛКА ЦЕН НА
Dialogue: 0,0:07:14.33,0:07:16.83,Caption,,0,0,0,,ТОПЛИВО ДО КОНЦА ГОДА. ОЧЕНЬ ЕВРОПЕЙСКАЯ
Dialogue: 0,0:07:16.83,0:07:20.06,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКАЯ КОНСТРУКЦИЯ ПОЛУЧАЕТСЯ. СНАЧАЛА СВОИМИ
Dialogue: 0,0:07:20.06,0:07:22.99,Caption,,0,0,0,,РУКАМИ СОКРАЩАЕМ ПРЕДЛОЖЕНИЕ. ПОТОМ ДУМАЕМ,
Dialogue: 0,0:07:23.14,0:07:25.57,Caption,,0,0,0,,ЧТО ДЕЛАТЬ С ЦЕНОЙ. ЛИТВА ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:07:25.57,0:07:31.64,Caption,,0,0,0,,РЕШИЛА ВСПОМНИТЬ ПРО АТОМ. ИГНАЛИНСКУЮ АЭС ЗАКРЫЛИ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:31.64,0:07:34.63,Caption,,0,0,0,,ДЕВЯТОМ ГОДУ. ПРОШЛО ПОЧТИ ДВА ДЕСЯТИЛЕТИЯ,
Dialogue: 0,0:07:34.87,0:07:36.73,Caption,,0,0,0,,И ТЕПЕРЬ МИНИСТР ЭНЕРГЕТИКИ ЛУКАС
Dialogue: 0,0:07:36.73,0:07:39.36,Caption,,0,0,0,,САВИЦКАС ГОВОРИТ О ВОЗВРАЩЕНИИ СТРАНЫ К АТОМНОЙ
Dialogue: 0,0:07:39.36,0:07:42.25,Caption,,0,0,0,,ЭНЕРГЕТИКЕ. РАССМАТРИВАЮТ СОВРЕМЕННЫЕ МАЛЫЕ
Dialogue: 0,0:07:42.25,0:07:45.07,Caption,,0,0,0,,МОДУЛЬНЫЕ РЕАКТОРЫ. НУЖНА БАЗОВАЯ ВЫРАБОТКА
Dialogue: 0,0:07:45.07,0:07:48.49,Caption,,0,0,0,,ЭЛЕКТРОЭНЕРГИИ. ПРЕДЛОЖЕНИЕ ХОТЯТ ВНЕСТИ В ПАРЛАМЕНТ В ПЕРВОЙ
Dialogue: 0,0:07:48.49,0:07:50.91,Caption,,0,0,0,,ПОЛОВИНЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА.
Dialogue: 0,0:07:50.91,0:07:54.18,Caption,,0,0,0,,ПЛОЩАДКА УЖЕ ЕСТЬ. ГЕОЛОГИЧЕСКИЕ ИССЛЕДОВАНИЯ ЕСТЬ.
Dialogue: 0,0:07:54.18,0:07:57.90,Caption,,0,0,0,,СПЕЦИАЛИСТЫ ЕСТЬ. ЗАКОНЫ ЕСТЬ. ПОДДЕРЖКА ЖИТЕЛЕЙ ТОЖЕ
Dialogue: 0,0:07:57.90,0:08:01.24,Caption,,0,0,0,,ЕСТЬ. ОСТАЁТСЯ ОДНА ПИКАНТНАЯ МЕЛОЧЬ. КОММЕРЧЕСКИЕ
Dialogue: 0,0:08:01.24,0:08:04.34,Caption,,0,0,0,,МАЛЫЕ МОДУЛЬНЫЕ РЕАКТОРЫ СЕЙЧАС РАБОТАЮТ В РОССИИ И
Dialogue: 0,0:08:04.34,0:08:06.76,Caption,,0,0,0,,КИТАЕ. ВОТ ТАКАЯ ЭНЕРГЕТИЧЕСКАЯ НЕЗАВИСИМОСТЬ
Dialogue: 0,0:08:06.76,0:08:09.51,Caption,,0,0,0,,ПОЛУЧАЕТСЯ. ЗАКРЫВАЛИ ОДНУ АТОМНУЮ ИСТОРИЮ,
Dialogue: 0,0:08:09.75,0:08:11.78,Caption,,0,0,0,,ЧТОБЫ ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ ИСКАТЬ НОВУЮ
Dialogue: 0,0:08:11.78,0:08:14.44,Caption,,0,0,0,,ТЕХНОЛОГИЮ, КОММЕРЧЕСКИЙ ОПЫТ КОТОРОЙ ЕСТЬ В ТОМ
Dialogue: 0,0:08:14.44,0:08:17.38,Caption,,0,0,0,,ЧИСЛЕ У ТЕХ, ОТ КОГО ТАК ДОЛГО УЧИЛИСЬ СТАНОВИТЬСЯ
Dialogue: 0,0:08:17.38,0:08:20.58,Caption,,0,0,0,,НЕЗАВИСИМЫМИ. НО ЭКОНОМИЧЕСКОЕ ДАВЛЕНИЕ ВООБЩЕ ШТУКА
Dialogue: 0,0:08:20.58,0:08:22.95,Caption,,0,0,0,,ИНТЕРЕСНАЯ. ОСОБЕННО КОГДА ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:08:23.19,0:08:25.20,Caption,,0,0,0,,ЧТО УЩЕРБ ДЕНЬГАМ НЕ ВСЕГДА ЯВЛЯЕТСЯ
Dialogue: 0,0:08:25.20,0:08:28.39,Caption,,0,0,0,,ГЛАВНОЙ ЦЕЛЬЮ. МИНИСТР ЭКОНОМИКИ УКРАИНЫ АЛЕКСАНДР
Dialogue: 0,0:08:28.39,0:08:30.63,Caption,,0,0,0,,КРАВЧЕНКО В РАЗГОВОРЕ С ВОВАНОМ И ЛЕКСУСОМ
Dialogue: 0,0:08:30.63,0:08:33.81,Caption,,0,0,0,,РАССКАЗАЛ О ЛЕТНИХ УДАРАХ ПО СКЛАДАМ WILDBERRIES. ПО ЕГО
Dialogue: 0,0:08:33.81,0:08:36.60,Caption,,0,0,0,,СЛОВАМ, СЕРЬЁЗНОГО УЩЕРБА РОССИЙСКОЙ ЭКОНОМИКЕ
Dialogue: 0,0:08:36.60,0:08:38.79,Caption,,0,0,0,,ОНИ НЕ НАНЕСЛИ. РАСЧЁТ БЫЛ В ДРУГОМ.
Dialogue: 0,0:08:41.05,0:08:43.15,Caption,,0,0,0,,СБОИ В РАБОТЕ МАРКЕТПЛЕЙСА ДОЛЖНЫ БЫЛИ
Dialogue: 0,0:08:43.15,0:08:45.85,Caption,,0,0,0,,ВЫЗВАТЬ НЕДОВОЛЬСТВО У ОБЫЧНЫХ ЛЮДЕЙ. ПЛЮС В
Dialogue: 0,0:08:45.85,0:08:49.18,Caption,,0,0,0,,КИЕВЕ РАССЧИТЫВАЛИ, ЧТО ПРОБЛЕМЫ WILDBERRIES БОЛЬНО УДАРЯТ
Dialogue: 0,0:08:49.18,0:08:51.51,Caption,,0,0,0,,ПО БАНКОВСКОМУ СЕКТОРУ. НО ЭТОТ РАСЧЁТ
Dialogue: 0,0:08:51.51,0:08:54.83,Caption,,0,0,0,,САМ КРАВЧЕНКО НАЗВАЛ ЯВНЫМ ПРЕУВЕЛИЧЕНИЕМ. ЗАТЕЯ
Dialogue: 0,0:08:54.83,0:08:57.62,Caption,,0,0,0,,ПРОВАЛИЛАСЬ. И ВОТ ЭТО ГОРАЗДО ИНТЕРЕСНЕЕ САМОЙ
Dialogue: 0,0:08:57.62,0:09:00.32,Caption,,0,0,0,,ИСТОРИИ СО СКЛАДАМИ. ЦЕЛЬЮ ОКАЗЫВАЕТСЯ НЕ
Dialogue: 0,0:09:00.32,0:09:04.18,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО ЗАВОД, МОСТ ИЛИ ЭЛЕКТРОСТАНЦИЯ. ДОСТАТОЧНО
Dialogue: 0,0:09:04.18,0:09:07.01,Caption,,0,0,0,,ПОПЫТАТЬСЯ ЗАЛЕЗТЬ ЧЕЛОВЕКУ В ПРИВЫЧНУЮ ЖИЗНЬ. НЕ
Dialogue: 0,0:09:07.01,0:09:10.09,Caption,,0,0,0,,ПРИЕХАЛА ПОСЫЛКА. НЕ РАБОТАЕТ ПРИВЫЧНЫЙ СЕРВИС.
Dialogue: 0,0:09:10.09,0:09:12.57,Caption,,0,0,0,,ЧЕЛОВЕК ЗЛИТСЯ. А ДАЛЬШЕ РАССЧИТЫВАЮТ,
Dialogue: 0,0:09:12.73,0:09:16.79,Caption,,0,0,0,,ЧТО ЗЛОСТЬ ПОЙДЁТ ТУДА, КУДА НУЖНО. НЕ ПОШЛА. НО САМА ЛОГИКА
Dialogue: 0,0:09:16.79,0:09:19.54,Caption,,0,0,0,,НИКУДА НЕ ДЕЛАСЬ. НО НА МОРЕ ВОЗНИКАЕТ ДРУГАЯ
Dialogue: 0,0:09:19.54,0:09:22.68,Caption,,0,0,0,,ПРОБЛЕМА. СОЕДИНЁННЫЕ ШТАТЫ ПОДОЗРЕВАЮТ РОССИЮ И
Dialogue: 0,0:09:22.68,0:09:24.89,Caption,,0,0,0,,ИРАН В ПРИЧАСТНОСТИ К СЕРИИ КИБЕРАТАК НА
Dialogue: 0,0:09:24.89,0:09:28.01,Caption,,0,0,0,,ТАНКЕРЫ ПО ВСЕМУ МИРУ. ПО ДАННЫМ УОЛЛ СТРИТ ДЖОРНАЛ,
Dialogue: 0,0:09:28.18,0:09:30.13,Caption,,0,0,0,,ПОД УГРОЗОЙ ОКАЗАЛИСЬ ДО ПЯТИДЕСЯТИ
Dialogue: 0,0:09:30.13,0:09:33.64,Caption,,0,0,0,,СУДОВ С НЕФТЬЮ, ГАЗОМ И ХИМИЧЕСКОЙ ПРОДУКЦИЕЙ. ЭКИПАЖИ
Dialogue: 0,0:09:33.64,0:09:37.54,Caption,,0,0,0,,ПОЛУЧАЛИ УГРОЗЫ ВЗРЫВОВ, ТРЕБОВАНИЯ ВЫКУПА И ПРЕДУПРЕЖДЕНИЯ С
Dialogue: 0,0:09:37.54,0:09:40.97,Caption,,0,0,0,,ТРЕБОВАНИЕМ НЕ ПЕРЕВОЗИТЬ АМЕРИКАНСКИЕ ЭНЕРГОРЕСУРСЫ.
Dialogue: 0,0:09:40.97,0:09:44.68,Caption,,0,0,0,,УГРОЗЫ ПОЛУЧИЛИ ДВА ТАНКЕРА, НАПРАВЛЯВШИЕСЯ В ТЕХАС. В ТОЙ ЖЕ
Dialogue: 0,0:09:44.68,0:09:47.21,Caption,,0,0,0,,ИСТОРИИ ФИГУРИРУЕТ ГАЗОВОЗ VIVIT AFRICA,
Dialogue: 0,0:09:47.45,0:09:49.56,Caption,,0,0,0,,КОТОРЫЙ ШЁЛ ИЗ США В ИТАЛИЮ. ПОСЛЕ
Dialogue: 0,0:09:49.56,0:09:52.30,Caption,,0,0,0,,ПРЕДПОЛАГАЕМОГО ВЗЛОМА СУДНО НАЧАЛО ДВИГАТЬСЯ ПО
Dialogue: 0,0:09:52.30,0:09:57.82,Caption,,0,0,0,,НЕОБЫЧНОЙ ТРАЕКТОРИИ. ДА В ЭТУ ИГРУ НЕ ПРОСТО МОЖНО ИГРАТЬ
Dialogue: 0,0:09:57.82,0:10:00.35,Caption,,0,0,0,,ВДВОЁМ. В НЕЁ ЛЕГКО ИГРАТЬ ВДВОЁМ.
Dialogue: 0,0:10:00.35,0:10:03.08,Caption,,0,0,0,,ЕСЛИ АТАКИ НА ТАНКЕРЫ ТАК НАЗЫВАЕМОГО ТЕНЕВОГО
Dialogue: 0,0:10:03.08,0:10:05.58,Caption,,0,0,0,,ФЛОТА СЧИТАТЬ ДОПУСТИМЫМ СПОСОБОМ ДАВЛЕНИЯ НА
Dialogue: 0,0:10:05.58,0:10:09.20,Caption,,0,0,0,,РОССИЮ, ПОЧЕМУ КТО ТО УВЕРЕН, ЧТО ТАКУЮ ЖЕ ЛОГИКУ НЕ ПРИМЕНЯТ С
Dialogue: 0,0:10:09.20,0:10:12.50,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ? ОЧЕНЬ БЫСТРО ВОЗНИКАЕТ ГЛАВНЫЙ ВОПРОС
Dialogue: 0,0:10:12.50,0:10:14.48,Caption,,0,0,0,,А ГДЕ ЗАКАНЧИВАЕТСЯ ГРАЖДАНСКИЙ ГРУЗ И
Dialogue: 0,0:10:14.48,0:10:17.18,Caption,,0,0,0,,НАЧИНАЕТСЯ ВОЕННЫЙ? ЭЛЕКТРОДВИГАТЕЛЬ ГРАЖДАНСКИЙ?
Dialogue: 0,0:10:17.24,0:10:19.34,Caption,,0,0,0,,КОНЕЧНО. А ЕСЛИ ТАКОЙ ДВИГАТЕЛЬ СТАВЯТ
Dialogue: 0,0:10:19.34,0:10:22.06,Caption,,0,0,0,,НА ВОЕННУЮ ТЕХНИКУ? ЭЛЕКТРОНИКА ГРАЖДАНСКАЯ?
Dialogue: 0,0:10:22.19,0:10:24.18,Caption,,0,0,0,,КОНЕЧНО. А ЕСЛИ ЕЁ ИСПОЛЬЗУЮТ В
Dialogue: 0,0:10:24.18,0:10:26.46,Caption,,0,0,0,,БЕСПИЛОТНИКЕ? ПРОДОВОЛЬСТВИЕ ГРАЖДАНСКОЕ?
Dialogue: 0,0:10:26.58,0:10:28.70,Caption,,0,0,0,,КОНЕЧНО. А ЕСЛИ ИМ КОРМЯТ АРМИЮ?
Dialogue: 0,0:10:29.15,0:10:31.82,Caption,,0,0,0,,ПО ТАКОЙ ЛОГИКЕ ГРАНИЦУ МОЖНО РАСТЯНУТЬ КУДА УГОДНО.
Dialogue: 0,0:10:32.06,0:10:33.98,Caption,,0,0,0,,СУДНО МОЖЕТ ИДТИ ПОД ЛЮБЫМ ФЛАГОМ,
Dialogue: 0,0:10:34.14,0:10:36.37,Caption,,0,0,0,,А ЕГО ГРУЗ ОБЪЯВЯТ ВОЕННЫМ. И ПОКА
Dialogue: 0,0:10:36.37,0:10:39.21,Caption,,0,0,0,,БУДУТ ВЫЯСНЯТЬ, ДЕЙСТВИТЕЛЬНО ЛИ ОБЫЧНЫЕ МОТОРЫ
Dialogue: 0,0:10:39.21,0:10:41.18,Caption,,0,0,0,,ПРЕДНАЗНАЧАЛИСЬ ДЛЯ ВОЕННОЙ ТЕХНИКИ,
Dialogue: 0,0:10:41.50,0:10:43.93,Caption,,0,0,0,,ПОД УГРОЗОЙ ОКАЖУТСЯ ДРУГИЕ СУДА. ДАЖЕ
Dialogue: 0,0:10:43.93,0:10:46.10,Caption,,0,0,0,,ОБЫЧНЫЙ СКОТОВОЗ ПРИ БОЛЬШОМ ЖЕЛАНИИ КТО
Dialogue: 0,0:10:46.10,0:10:49.09,Caption,,0,0,0,,НИБУДЬ ОБЪЯВИТ ЧАСТЬЮ ВОЕННОГО СНАБЖЕНИЯ. И ПОПРОБУЙ
Dialogue: 0,0:10:49.09,0:10:52.23,Caption,,0,0,0,,ПОТОМ ДОКАЖИ ОБРАТНОЕ. И ВОТ ЭТО УЖЕ ОПАСНЕЙШАЯ
Dialogue: 0,0:10:52.23,0:10:55.58,Caption,,0,0,0,,ИГРА. ПОКА ПОЛИТИКИ СПОРЯТ, КОМУ ПРИНАДЛЕЖИТ СУДНО,
Dialogue: 0,0:10:55.68,0:10:59.39,Caption,,0,0,0,,ПОД КАКИМ ОНО ФЛАГОМ, КТО ВЛАДЕЕТ ГРУЗОМ И КУДА ГРУЗ ДОЛЖЕН
Dialogue: 0,0:10:59.39,0:11:02.45,Caption,,0,0,0,,БЫЛ ПОПАСТЬ, МОРСКАЯ ТОРГОВЛЯ НАЧИНАЕТ ЖИТЬ СОВСЕМ
Dialogue: 0,0:11:02.45,0:11:07.55,Caption,,0,0,0,,ПО ДРУГИМ ПРАВИЛАМ. А ЕВРОПА ПРИ ЭТОМ САМА ВСЁ СИЛЬНЕЕ
Dialogue: 0,0:11:07.55,0:11:10.18,Caption,,0,0,0,,ЗАВИСИТ ОТ МОРСКИХ ПОСТАВОК ЭНЕРГОРЕСУРСОВ.
Dialogue: 0,0:11:10.18,0:11:13.15,Caption,,0,0,0,,РОССИЙСКОГО ГАЗА СТАНОВИТСЯ МЕНЬШЕ. КАТАР ДОЛЖЕН
Dialogue: 0,0:11:13.15,0:11:15.89,Caption,,0,0,0,,ЗАКРЫВАТЬ ЧАСТЬ НЕХВАТКИ. ТАНКЕРНЫЕ ПЕРЕВОЗКИ
Dialogue: 0,0:11:15.89,0:11:18.53,Caption,,0,0,0,,ПРИОБРЕТАЮТ ВСЁ БОЛЬШЕЕ ЗНАЧЕНИЕ. ТО ЕСТЬ ВЫ
Dialogue: 0,0:11:18.53,0:11:21.40,Caption,,0,0,0,,ОДНОВРЕМЕННО ХОТИТЕ ИСПОЛЬЗОВАТЬ МОРСКИЕ ПЕРЕВОЗКИ КАК
Dialogue: 0,0:11:21.40,0:11:24.09,Caption,,0,0,0,,ТОЧКУ ДАВЛЕНИЯ НА ПРОТИВНИКА И РАССЧИТЫВАЕТЕ,
Dialogue: 0,0:11:24.25,0:11:26.32,Caption,,0,0,0,,ЧТО ВАШИ СОБСТВЕННЫЕ МОРСКИЕ ПЕРЕВОЗКИ
Dialogue: 0,0:11:26.32,0:11:29.01,Caption,,0,0,0,,ОСТАНУТСЯ НЕПРИКОСНОВЕННЫМИ. ХОРОШИЙ ПЛАН. ДО
Dialogue: 0,0:11:29.01,0:11:32.40,Caption,,0,0,0,,ПЕРВОГО ЧЕЛОВЕКА, КОТОРЫЙ РЕШИТ ЧИТАТЬ ПРАВИЛА ТОЧНО ТАК
Dialogue: 0,0:11:32.40,0:11:34.86,Caption,,0,0,0,,ЖЕ, ТОЛЬКО С ДРУГОЙ СТОРОНЫ СТОЛА. ПРИЧЁМ
Dialogue: 0,0:11:34.86,0:11:37.26,Caption,,0,0,0,,НЕПРИЯТНОСТИ ЕВРОПЕ СПОСОБНА УСТРОИТЬ НЕ ТОЛЬКО
Dialogue: 0,0:11:37.26,0:11:40.07,Caption,,0,0,0,,РОССИЯ. БРИТАНСКИЕ ВЛАСТИ УЖЕ ОПАСАЮТСЯ НОВЫХ
Dialogue: 0,0:11:40.07,0:11:42.68,Caption,,0,0,0,,МАСШТАБНЫХ УДАРОВ ТРАМПА ПО ИРАНУ. БЛУМБЕРГ
Dialogue: 0,0:11:42.68,0:11:44.67,Caption,,0,0,0,,ПИШЕТ, ЧТО ТАКИЕ ДЕЙСТВИЯ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:11:44.67,0:11:47.35,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОМ ГОДУ СПОСОБНЫ УДАРИТЬ ПО ЭКОНОМИКЕ И
Dialogue: 0,0:11:47.35,0:11:50.26,Caption,,0,0,0,,БЕЗОПАСНОСТИ САМОЙ БРИТАНИИ. ВОТ И ПРИЕХАЛИ.
Dialogue: 0,0:11:50.26,0:11:52.33,Caption,,0,0,0,,СТОЛЬКО ЛЕТ ЕВРОПЕЙЦАМ ОБЪЯСНЯЛИ,
Dialogue: 0,0:11:52.57,0:11:54.58,Caption,,0,0,0,,ОТКУДА ИСХОДИТ ГЛАВНАЯ УГРОЗА. А
Dialogue: 0,0:11:54.58,0:11:56.83,Caption,,0,0,0,,ТЕПЕРЬ ЛОНДОНУ ПРИХОДИТСЯ СМОТРЕТЬ ЕЩЁ И НА
Dialogue: 0,0:11:56.83,0:11:58.89,Caption,,0,0,0,,СОБСТВЕННОГО ГЛАВНОГО СОЮЗНИКА И ДУМАТЬ,
Dialogue: 0,0:11:59.14,0:12:01.11,Caption,,0,0,0,,ЧТО ТОТ УСТРОИТ СЛЕДУЮЩИМ ХОДОМ.
Dialogue: 0,0:12:01.11,0:12:04.24,Caption,,0,0,0,,ПОТОМУ ЧТО НОВЫЙ КОНФЛИКТ ВОКРУГ ИРАНА ОЗНАЧАЕТ РИСКИ
Dialogue: 0,0:12:04.24,0:12:07.32,Caption,,0,0,0,,ДЛЯ ЭНЕРГЕТИКИ, ТОРГОВЛИ И БЕЗОПАСНОСТИ. И ЕСЛИ
Dialogue: 0,0:12:07.32,0:12:09.13,Caption,,0,0,0,,ВАШИНГТОН РЕШИТ ИГРАТЬ ЖЁСТКО,
Dialogue: 0,0:12:09.37,0:12:11.46,Caption,,0,0,0,,СЧЁТ ПРИДЁТ НЕ ТОЛЬКО В ВАШИНГТОН.
Dialogue: 0,0:12:11.46,0:12:13.80,Caption,,0,0,0,,ЕВРОПЕ ВООБЩЕ ПРИХОДИТСЯ ВСЁ ЧАЩЕ СМОТРЕТЬ ПО
Dialogue: 0,0:12:13.80,0:12:18.80,Caption,,0,0,0,,СТОРОНАМ. И ТУТ ЕВРОПЕЙСКИЕ НАПЁРСТКИ ДЕМОКРАТИИ
Dialogue: 0,0:12:18.80,0:12:21.80,Caption,,0,0,0,,ПРОДОЛЖАЮТСЯ. В РУМЫНИИ ХОТЯТ ПОСАДИТЬ ВТОРОГО
Dialogue: 0,0:12:21.80,0:12:25.34,Caption,,0,0,0,,ЛИДЕРА ОППОЗИЦИИ ДЖОРДЖА СИМИОНА. ДРУГОЙ ОППОЗИЦИОНЕР,
Dialogue: 0,0:12:25.42,0:12:28.23,Caption,,0,0,0,,КЭЛИН ДЖОРДЖЕСКУ, КОТОРЫЙ ПОБЕДИЛ НА ПРЕЗИДЕНТСКИХ
Dialogue: 0,0:12:28.23,0:12:30.81,Caption,,0,0,0,,ВЫБОРАХ, ВЫШЕЛ ИЗ ПОД СТРАЖИ ПОД ДОМАШНИЙ
Dialogue: 0,0:12:30.81,0:12:33.76,Caption,,0,0,0,,АРЕСТ. СНАЧАЛА ЕГО ОБВИНЯЛИ В ПОЛУЧЕНИИ РОССИЙСКИХ
Dialogue: 0,0:12:33.76,0:12:36.78,Caption,,0,0,0,,ДЕНЕГ. ЗАТЕМ, КОГДА ДОКАЗАТЕЛЬСТВ ЭТОГО ОБВИНЕНИЯ НЕ
Dialogue: 0,0:12:36.78,0:12:39.05,Caption,,0,0,0,,НАШЛИ, ПОЯВИЛИСЬ ДРУГИЕ ПРЕТЕНЗИИ.
Dialogue: 0,0:12:39.05,0:12:41.95,Caption,,0,0,0,,МОШЕННИЧЕСТВО ДЕСЯТИЛЕТНЕЙ ДАВНОСТИ И ПЛОХИЕ СОВЕТЫ
Dialogue: 0,0:12:41.95,0:12:44.68,Caption,,0,0,0,,БИЗНЕСМЕНАМ. НОРМАЛЬНО. ВЫБОРЫ ВЫИГРАЛ ОДИН
Dialogue: 0,0:12:44.68,0:12:48.22,Caption,,0,0,0,,ЧЕЛОВЕК. ПОТОМ У НЕГО НАЧИНАЮТСЯ ПРОБЛЕМЫ С ЗАКОНОМ. ВТОРОГО
Dialogue: 0,0:12:48.22,0:12:50.45,Caption,,0,0,0,,КРУПНОГО ОППОЗИЦИОННОГО ПОЛИТИКА ТОЖЕ ХОТЯТ
Dialogue: 0,0:12:50.45,0:12:53.12,Caption,,0,0,0,,ОТПРАВИТЬ В ТЮРЬМУ. А ТЕПЕРЬ РЯДОМ ПОСТАВИМ ЕЩЁ
Dialogue: 0,0:12:53.12,0:12:55.66,Caption,,0,0,0,,ОДНУ ИСТОРИЮ. ФАЙНЭНШЛ ТАЙМС ПИШЕТ,
Dialogue: 0,0:12:55.82,0:12:57.64,Caption,,0,0,0,,ЧТО СЛЕДУЮЩИМ ПРЕЗИДЕНТОМ ЕВРОПЕЙСКОГО
Dialogue: 0,0:12:57.64,0:13:00.73,Caption,,0,0,0,,ЦЕНТРАЛЬНОГО БАНКА ДОЛЖЕН СТАТЬ ПАБЛО ЭРНАНДЕС ДЕ
Dialogue: 0,0:13:00.73,0:13:03.71,Caption,,0,0,0,,КОС. ПРИЧЁМ НАЗНАЧИТЬ ЕГО ХОТЯТ РАНЬШЕ СРОКА. И
Dialogue: 0,0:13:03.71,0:13:05.82,Caption,,0,0,0,,ПРИЧИНА, КОТОРУЮ НАЗЫВАЕТ ИЗДАНИЕ,
Dialogue: 0,0:13:06.06,0:13:08.42,Caption,,0,0,0,,ПРЕКРАСНА СВОЕЙ ДЕМОКРАТИЧНОСТЬЮ. В
Dialogue: 0,0:13:08.42,0:13:11.46,Caption,,0,0,0,,ЕВРОПЕ ОПАСАЮТСЯ БУДУЩИХ ПОБЕД ПРАВЫХ ПАРТИЙ ВО
Dialogue: 0,0:13:11.46,0:13:14.47,Caption,,0,0,0,,ФРАНЦИИ, ГЕРМАНИИ И ДРУГИХ СТРАНАХ И ХОТЯТ
Dialogue: 0,0:13:14.47,0:13:17.81,Caption,,0,0,0,,ЗАРАНЕЕ ОГРАНИЧИТЬ ИХ ВЛИЯНИЕ НА ЕВРОПЕЙСКИЙ ЦЕНТРАЛЬНЫЙ
Dialogue: 0,0:13:17.81,0:13:21.01,Caption,,0,0,0,,БАНК. ТО ЕСТЬ ВЫБОРОВ ЕЩЁ НЕТ. ИЗБИРАТЕЛЬ ЕЩЁ НИКУДА
Dialogue: 0,0:13:21.01,0:13:23.99,Caption,,0,0,0,,НЕ ПРИШЁЛ. БЮЛЛЕТЕНЬ ЕЩЁ НИКУДА НЕ ПОЛОЖИЛ. А
Dialogue: 0,0:13:23.99,0:13:26.54,Caption,,0,0,0,,ПРАВИЛЬНУЮ ДВЕРЬ УЖЕ ХОТЯТ ЗАРАНЕЕ ПРИКРЫТЬ.
Dialogue: 0,0:13:28.82,0:13:31.06,Caption,,0,0,0,,ЧТОБЫ ПОТОМ ДЕМОКРАТИЯ, НЕ ДАЙ БОГ,
Dialogue: 0,0:13:31.14,0:13:35.27,Caption,,0,0,0,,НЕ ВЫБРАЛА ЧТО НИБУДЬ НЕ ТО. ВОТ И ПОЛУЧАЕТСЯ ЕВРОПЕЙСКАЯ ПОЛИТИКА
Dialogue: 0,0:13:35.27,0:13:38.04,Caption,,0,0,0,,ПОСЛЕДНЕГО ВРЕМЕНИ В ОДНОМ КАДРЕ. ДВАДЦАТЬ ВТОРОЙ
Dialogue: 0,0:13:38.04,0:13:40.75,Caption,,0,0,0,,ПАКЕТ САНКЦИЙ ПРОТИВ РОССИИ ГОТОВЯТ ЗАРАНЕЕ.
Dialogue: 0,0:13:40.75,0:13:43.27,Caption,,0,0,0,,ПОСЛЕДСТВИЯ СОБСТВЕННОЙ ЭНЕРГЕТИЧЕСКОЙ ПОЛИТИКИ
Dialogue: 0,0:13:43.27,0:13:46.22,Caption,,0,0,0,,НАЧИНАЮТ СЧИТАТЬ УЖЕ ПОСЛЕ РЕШЕНИЙ. ДЕНЬГИ УКРАИНЕ
Dialogue: 0,0:13:46.22,0:13:48.18,Caption,,0,0,0,,ГОТОВЫ ВЫДЕЛЯТЬ НА ГОДЫ ВПЕРЁД,
Dialogue: 0,0:13:48.42,0:13:50.26,Caption,,0,0,0,,ХОТЯ БАБИШ ВСЁ ГРОМЧЕ СПРАШИВАЕТ,
Dialogue: 0,0:13:50.35,0:13:52.96,Caption,,0,0,0,,ГДЕ КОНЕЧНАЯ ТОЧКА. А ВЛИЯНИЕ БУДУЩЕГО
Dialogue: 0,0:13:52.96,0:13:56.00,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ИЗБИРАТЕЛЯ ПРЕДЛАГАЮТ ОГРАНИЧИТЬ ЕЩЁ
Dialogue: 0,0:13:56.00,0:13:58.81,Caption,,0,0,0,,ДО ТОГО, КАК ЭТОТ ИЗБИРАТЕЛЬ ПРОГОЛОСОВАЛ.
Dialogue: 0,0:13:58.81,0:14:01.94,Caption,,0,0,0,,МЕДВЕДЬ ЗА ПЯТЬ ЛЕТ КО МНОГОМУ ПРИВЫК. А ВОТ ЕВРОПА,
Dialogue: 0,0:14:02.03,0:14:04.53,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, ТОЛЬКО НАЧИНАЕТ ПРИВЫКАТЬ К
Dialogue: 0,0:14:04.53,0:14:06.26,Caption,,0,0,0,,ПОСЛЕДСТВИЯМ СОБСТВЕННЫХ РЕШЕНИЙ.
