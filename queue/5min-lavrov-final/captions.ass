Dialogue: 0,0:00:00.12,0:00:02.68,Caption,,0,0,0,,ВОТ ОБЪЯСНИТЕ МНЕ ОДНУ ПРОСТУЮ ВЕЩЬ. ЕСЛИ ВАМ
Dialogue: 0,0:00:02.68,0:00:06.68,Caption,,0,0,0,,ПРЕДЛАГАЮТ ОСТАНОВИТЬСЯ, ПОЧЕМУ ВЫ ОБЯЗАТЕЛЬНО ДОЛЖНЫ ОСТАНАВЛИВАТЬСЯ?
Dialogue: 0,0:00:06.99,0:00:08.76,Caption,,0,0,0,,ПОТОМУ ЧТО КОМУ ТО ТАК УДОБНЕЕ?
Dialogue: 0,0:00:08.88,0:00:12.12,Caption,,0,0,0,,ПОТОМУ ЧТО КТО ТО УСТАЛ? ИЛИ ПОТОМУ ЧТО КТО ТО РЕШИЛ,
Dialogue: 0,0:00:12.28,0:00:14.12,Caption,,0,0,0,,ЧТО САМОЕ ВРЕМЯ НЕМНОГО ОТДОХНУТЬ?
Dialogue: 0,0:00:14.26,0:00:17.64,Caption,,0,0,0,,СОГЛАСИТЕСЬ, ПРИЧИНЫ ЗАМЕЧАТЕЛЬНЫЕ. ОСОБЕННО ДЛЯ ТОГО,
Dialogue: 0,0:00:17.76,0:00:20.44,Caption,,0,0,0,,КТО ПРОСИТ СДЕЛАТЬ ПАУЗУ. НО У ВТОРОЙ СТОРОНЫ
Dialogue: 0,0:00:20.52,0:00:22.60,Caption,,0,0,0,,ВЕДЬ ТОЖЕ ЕСТЬ СВОИ ВОПРОСЫ. И СУДЯ ПО
Dialogue: 0,0:00:22.60,0:00:26.68,Caption,,0,0,0,,ПОСЛЕДНИМ ЗАЯВЛЕНИЯМ, ВОПРОСЫ ТАМ СОВСЕМ НЕ МАЛЕНЬКИЕ. ПОДПИСЫВАЙТЕСЬ НА
Dialogue: 0,0:00:26.76,0:00:29.24,Caption,,0,0,0,,КАНАЛ. ПОТОМУ ЧТО СЕГОДНЯ ИСТОРИЯ КАК РАЗ О
Dialogue: 0,0:00:29.24,0:00:31.88,Caption,,0,0,0,,ТОМ СЛУЧАЕ, КОГДА ВСЕ ГОВОРЯТ ОБ УКРАИНЕ,
Dialogue: 0,0:00:32.12,0:00:34.20,Caption,,0,0,0,,А РАЗГОВОР НА САМОМ ДЕЛЕ ДАВНО УЖЕ ГОРАЗДО
Dialogue: 0,0:00:34.20,0:00:37.72,Caption,,0,0,0,,ШИРЕ УКРАИНЫ. ЛАВРОВ ОПЯТЬ ЗАГОВОРИЛ О НОВОЙ СИСТЕМЕ
Dialogue: 0,0:00:37.72,0:00:40.12,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТОЛЬКО ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:00:40.43,0:00:42.20,Caption,,0,0,0,,ОН ГОВОРИТ УЖЕ НЕ О КАКОМ ТО ОТДЕЛЬНОМ
Dialogue: 0,0:00:42.20,0:00:45.08,Caption,,0,0,0,,СОГЛАШЕНИИ МЕЖДУ МОСКВОЙ И КИЕВОМ. ОН ГОВОРИТ ОБ
Dialogue: 0,0:00:45.08,0:00:47.96,Caption,,0,0,0,,АРХИТЕКТУРЕ БЕЗОПАСНОСТИ ЕВРАЗИИ. ВОТ ЗДЕСЬ И
Dialogue: 0,0:00:47.96,0:00:51.40,Caption,,0,0,0,,НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ. ЕВРАЗИИ. ОГРОМНОГО
Dialogue: 0,0:00:51.40,0:00:54.04,Caption,,0,0,0,,КОНТИНЕНТА. РОССИЯ, ЕВРОПА,
Dialogue: 0,0:00:54.12,0:00:57.00,Caption,,0,0,0,,КИТАЙ, ИНДИЯ, ДЕСЯТКИ ГОСУДАРСТВ,
Dialogue: 0,0:00:57.08,0:00:59.72,Caption,,0,0,0,,ВОЕННЫЕ СОЮЗЫ, РАКЕТЫ, БАЗЫ,
Dialogue: 0,0:00:59.81,0:01:03.48,Caption,,0,0,0,,ФЛОТЫ, ЯДЕРНЫЕ ДЕРЖАВЫ. И НА ЭТОМ ФОНЕ НАМ ПРОДОЛЖАЮТ
Dialogue: 0,0:01:03.48,0:01:06.60,Caption,,0,0,0,,РАССКАЗЫВАТЬ, ЧТО ГЛАВНОЕ СЕЙЧАС ПРОСТО ОСТАНОВИТЬ СТРЕЛЬБУ НА
Dialogue: 0,0:01:06.60,0:01:09.56,Caption,,0,0,0,,УКРАИНЕ. ХОРОШО. ОСТАНОВИЛИ. А ДАЛЬШЕ ЧТО?
Dialogue: 0,0:01:11.82,0:01:14.55,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ПОСЛЕ ЭТОГО НАТО ОСТАЁТСЯ ТАМ,
Dialogue: 0,0:01:14.63,0:01:17.99,Caption,,0,0,0,,ГДЕ ОНО ЕСТЬ, ВОЕННАЯ ИНФРАСТРУКТУРА ОСТАЁТСЯ ТАМ,
Dialogue: 0,0:01:18.06,0:01:21.99,Caption,,0,0,0,,ГДЕ ОНА ЕСТЬ, ВОПРОС ДАЛЬНЕЙШЕГО РАСШИРЕНИЯ НИКУДА НЕ ДЕВАЕТСЯ,
Dialogue: 0,0:01:22.24,0:01:24.63,Caption,,0,0,0,,ВЗАИМНЫЕ ПРЕТЕНЗИИ РОССИИ И ЗАПАДА НИКУДА НЕ
Dialogue: 0,0:01:24.63,0:01:27.27,Caption,,0,0,0,,ДЕВАЮТСЯ, РАКЕТЫ НИКУДА НЕ ДЕВАЮТСЯ,
Dialogue: 0,0:01:27.51,0:01:30.63,Caption,,0,0,0,,БАЗЫ НИКУДА НЕ ДЕВАЮТСЯ, ТО ЧТО ИМЕННО МЫ РЕШИЛИ?
Dialogue: 0,0:01:30.90,0:01:33.91,Caption,,0,0,0,,НИЧЕГО. ПРОСТО ПОСТАВИЛИ ПРОИСХОДЯЩЕЕ НА ПАУЗУ.
Dialogue: 0,0:01:34.07,0:01:36.39,Caption,,0,0,0,,УКРАИНА ЗДЕСЬ ОГРОМНАЯ, ТРАГИЧЕСКАЯ,
Dialogue: 0,0:01:36.48,0:01:39.75,Caption,,0,0,0,,КРОВАВАЯ ЧАСТЬ ИСТОРИИ. НО ВСЁ ЖЕ ЧАСТЬ. САМ
Dialogue: 0,0:01:39.75,0:01:42.79,Caption,,0,0,0,,КОНФЛИКТ ГОРАЗДО ШИРЕ. ПО БОЛЬШОМУ СЧЁТУ РЕЧЬ ДАВНО
Dialogue: 0,0:01:42.87,0:01:47.51,Caption,,0,0,0,,ИДЁТ О РОССИИ И НАТО. О ТОМ, ГДЕ ПРОХОДЯТ ГРАНИЦЫ ДОПУСТИМОГО ВОЕННОГО
Dialogue: 0,0:01:47.51,0:01:51.03,Caption,,0,0,0,,ПРИСУТСТВИЯ. ГДЕ МОЖНО СТАВИТЬ РАКЕТЫ. ГДЕ НЕЛЬЗЯ.
Dialogue: 0,0:01:51.35,0:01:53.75,Caption,,0,0,0,,КТО И НАСКОЛЬКО БЛИЗКО МОЖЕТ ПОДХОДИТЬ К ЧУЖИМ
Dialogue: 0,0:01:53.83,0:01:57.43,Caption,,0,0,0,,ГРАНИЦАМ. КАКИЕ СОЮЗЫ РАСШИРЯЮТСЯ. КАКИЕ СИЛЫ ТАМ
Dialogue: 0,0:01:57.43,0:01:59.75,Caption,,0,0,0,,РАЗМЕЩАЮТСЯ. А УКРАИНА УЖЕ ТУТ,
Dialogue: 0,0:01:59.83,0:02:03.83,Caption,,0,0,0,,КАК ГОВОРИТСЯ, ПО ДОРОГЕ ПРИШЛАСЬ. И ЕСЛИ СМОТРЕТЬ НА ПРОИСХОДЯЩЕЕ
Dialogue: 0,0:02:03.91,0:02:06.39,Caption,,0,0,0,,ИМЕННО ТАК, СРАЗУ СТАНОВИТСЯ ПОНЯТНЕЕ,
Dialogue: 0,0:02:06.50,0:02:09.11,Caption,,0,0,0,,ПОЧЕМУ МОСКВА НЕ БРОСАЕТСЯ ПОДПИСЫВАТЬ ПЕРВОЕ
Dialogue: 0,0:02:09.11,0:02:12.31,Caption,,0,0,0,,ПОПАВШЕЕСЯ ПРЕДЛОЖЕНИЕ О ПЕРЕМИРИИ. ЛАВРОВ ПРЯМО
Dialogue: 0,0:02:12.31,0:02:15.51,Caption,,0,0,0,,ОТВЕРГ ЕВРОПЕЙСКУЮ ИДЕЮ НЕМЕДЛЕННО ПРЕКРАТИТЬ ОГОНЬ.
Dialogue: 0,0:02:15.91,0:02:19.03,Caption,,0,0,0,,ОБЪЯСНЕНИЕ У МОСКВЫ ПРОСТОЕ. ПАУЗА ДАСТ УКРАИНЕ
Dialogue: 0,0:02:19.11,0:02:21.75,Caption,,0,0,0,,ВРЕМЯ ВОССТАНОВИТЬСЯ. И ВЕДЬ ЧЕГО ЗДЕСЬ НЕПОНЯТНОГО?
Dialogue: 0,0:02:21.92,0:02:24.07,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ С АРМИЕЙ ВО ВРЕМЯ ПЕРЕДЫШКИ?
Dialogue: 0,0:02:24.15,0:02:27.83,Caption,,0,0,0,,ОНА ОТДЫХАЕТ? НУ КОНЕЧНО. ТОЛЬКО ОТДЫХАЕТ ОНА ОБЫЧНО ОЧЕНЬ
Dialogue: 0,0:02:27.83,0:02:33.78,Caption,,0,0,0,,СВОЕОБРАЗНО. РЕМОНТИРУЕТСЯ ТЕХНИКА. ВОССТАНАВЛИВАЮТСЯ ЧАСТИ.
Dialogue: 0,0:02:33.93,0:02:36.66,Caption,,0,0,0,,ПОДВОЗЯТСЯ БОЕПРИПАСЫ. СТРОЯТСЯ УКРЕПЛЕНИЯ.
Dialogue: 0,0:02:36.90,0:02:39.46,Caption,,0,0,0,,ГОТОВЯТСЯ РЕЗЕРВЫ. ПРИЕЗЖАЕТ НОВОЕ ОРУЖИЕ.
Dialogue: 0,0:02:39.73,0:02:42.42,Caption,,0,0,0,,ПЕРЕСТРАИВАЕТСЯ ЛОГИСТИКА. ЗАЛИЗЫВАЮТСЯ РАНЫ.
Dialogue: 0,0:02:42.73,0:02:45.94,Caption,,0,0,0,,ПЕРЕЗАРЯЖАЮТСЯ МАГАЗИНЫ. А ПОТОМ МОЖНО ПРОДОЛЖАТЬ. И
Dialogue: 0,0:02:46.02,0:02:48.58,Caption,,0,0,0,,ВОТ РОССИЯ ДОЛЖНА НА ЭТО СОГЛАСИТЬСЯ ПРОСТО ПОТОМУ,
Dialogue: 0,0:02:48.82,0:02:51.54,Caption,,0,0,0,,ЧТО КОМУ ТО ОЧЕНЬ ПОНРАВИЛОСЬ СЛОВО "ПЕРЕМИРИЕ"?
Dialogue: 0,0:02:51.70,0:02:55.46,Caption,,0,0,0,,С ЧЕГО ВДРУГ? МОСКВА ПРЕСЛЕДУЕТ ДРУГИЕ ЦЕЛИ. МОЖНО СОГЛАШАТЬСЯ С
Dialogue: 0,0:02:55.54,0:03:00.42,Caption,,0,0,0,,НИМИ, МОЖНО НЕ СОГЛАШАТЬСЯ, МОЖНО ВОЗМУЩАТЬСЯ СКОЛЬКО УГОДНО. НО СДЕЛАТЬ ВИД,
Dialogue: 0,0:03:00.58,0:03:04.82,Caption,,0,0,0,,ЧТО ЭТИХ ЦЕЛЕЙ НЕТ, НЕ ПОЛУЧИТСЯ. ЕСЛИ РОССИЙСКОЕ РУКОВОДСТВО СЧИТАЕТ
Dialogue: 0,0:03:04.90,0:03:07.38,Caption,,0,0,0,,ПРИЧИНОЙ НЫНЕШНЕГО КОНФЛИКТА НЕ ТОЛЬКО УКРАИНУ,
Dialogue: 0,0:03:07.70,0:03:10.50,Caption,,0,0,0,,А ВСЮ СЛОЖИВШУЮСЯ СИСТЕМУ ОТНОШЕНИЙ РОССИИ С НАТО,
Dialogue: 0,0:03:10.75,0:03:13.46,Caption,,0,0,0,,ЗНАЧИТ ОБЫЧНАЯ ОСТАНОВКА ОГНЯ ПРОБЛЕМУ ДЛЯ МОСКВЫ НЕ
Dialogue: 0,0:03:13.46,0:03:16.66,Caption,,0,0,0,,РЕШАЕТ. ПОЛУЧАЕТСЯ ПРЕКРАСНАЯ СХЕМА. ПЯТЫЙ ГОД
Dialogue: 0,0:03:16.66,0:03:19.06,Caption,,0,0,0,,ВОЮЕМ. ПОТОМ ГОВОРИМ ВСЁ, РЕБЯТА,
Dialogue: 0,0:03:19.22,0:03:21.62,Caption,,0,0,0,,ДАВАЙТЕ ПЕРЕДОХНЁМ. КИЕВ ВОССТАНОВИТСЯ,
Dialogue: 0,0:03:21.79,0:03:26.10,Caption,,0,0,0,,ЕВРОПА ДОВЕЗЁТ НЕОБХОДИМОЕ, АРМИЯ ПЕРЕГРУППИРУЕТСЯ. А ВОПРОСЫ,
Dialogue: 0,0:03:26.18,0:03:30.74,Caption,,0,0,0,,ИЗ ЗА КОТОРЫХ ВСЁ НАЧИНАЛОСЬ, МЫ ПОКА ТРОГАТЬ НЕ БУДЕМ. ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:03:31.14,0:03:33.38,Caption,,0,0,0,,ТОЛЬКО УДОБНАЯ ОНА ДАЛЕКО НЕ ДЛЯ ВСЕХ. И
Dialogue: 0,0:03:33.38,0:03:36.10,Caption,,0,0,0,,ТУТ ПОЯВЛЯЕТСЯ ДЕПУТАТ ВЕРХОВНОЙ РАДЫ ЕГОР ЧЕРНЕВ.
Dialogue: 0,0:03:36.16,0:03:40.18,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, УКРАИНА ПРЕДЛАГАЛА РАЗНЫЕ ВАРИАНТЫ. ЭНЕРГЕТИЧЕСКОЕ
Dialogue: 0,0:03:40.18,0:03:43.14,Caption,,0,0,0,,ПЕРЕМИРИЕ. ЧЕРНОМОРСКОЕ ПЕРЕМИРИЕ. ПОЛНОЕ
Dialogue: 0,0:03:43.14,0:03:47.19,Caption,,0,0,0,,ПРЕКРАЩЕНИЕ ОГНЯ. И МОСКВА,
Dialogue: 0,0:03:47.35,0:03:51.19,Caption,,0,0,0,,ОПЯТЬ ЖЕ ПО СЛОВАМ ЧЕРНЕВА, НЕ ОТВЕЧАЕТ НА ЭТИ ПРЕДЛОЖЕНИЯ ТАК,
Dialogue: 0,0:03:51.27,0:03:54.47,Caption,,0,0,0,,КАК ХОТЕЛОСЬ БЫ КИЕВУ. ВМЕСТО ЭТОГО РОССИЯ СНОВА
Dialogue: 0,0:03:54.55,0:03:57.27,Caption,,0,0,0,,ТАЩИТ НА СТОЛ НАТО И ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ. НУ
Dialogue: 0,0:03:57.35,0:03:59.83,Caption,,0,0,0,,ТАК ПОТОМУ И ТАЩИТ. КИЕВ ГОВОРИТ ДАВАЙТЕ ЗДЕСЬ
Dialogue: 0,0:03:59.91,0:04:02.47,Caption,,0,0,0,,ПЕРЕСТАНЕМ СТРЕЛЯТЬ. МОСКВА ОТВЕЧАЕТ А ЧТО ПОСЛЕ
Dialogue: 0,0:04:02.55,0:04:06.23,Caption,,0,0,0,,ЭТОГО ИЗМЕНИТСЯ? КИЕВ ГОВОРИТ ДАВАЙТЕ НЕ БИТЬ ПО ЭНЕРГЕТИКЕ. МОСКВА
Dialogue: 0,0:04:06.31,0:04:09.03,Caption,,0,0,0,,СПРАШИВАЕТ ХОРОШО, А ПОСТАВКИ ОРУЖИЯ БУДУТ ИДТИ?
Dialogue: 0,0:04:09.25,0:04:11.59,Caption,,0,0,0,,КИЕВ ГОВОРИТ ДАВАЙТЕ ДОГОВОРИМСЯ ПО ЧЁРНОМУ МОРЮ.
Dialogue: 0,0:04:11.83,0:04:14.07,Caption,,0,0,0,,МОСКВА ОПЯТЬ ВОЗВРАЩАЕТСЯ К ТОМУ ЖЕ ВОПРОСУ А
Dialogue: 0,0:04:14.07,0:04:16.15,Caption,,0,0,0,,ВЕСЬ ОСТАЛЬНОЙ ВОЕННЫЙ МЕХАНИЗМ КУДА ДЕЛСЯ?
Dialogue: 0,0:04:16.15,0:04:19.43,Caption,,0,0,0,,НИКУДА. ВОТ ПОЭТОМУ УКРАИНСКОЕ ПЕРЕМИРИЕ И
Dialogue: 0,0:04:19.43,0:04:21.91,Caption,,0,0,0,,РОССИЙСКОЕ ПОНИМАНИЕ БУДУЩЕГО СОГЛАШЕНИЯ СЕЙЧАС
Dialogue: 0,0:04:21.91,0:04:24.63,Caption,,0,0,0,,НАХОДЯТСЯ ПРОСТО НА РАЗНЫХ ЭТАЖАХ ОДНОГО ЗДАНИЯ.
Dialogue: 0,0:04:25.03,0:04:28.63,Caption,,0,0,0,,ОДНИ ОБСУЖДАЮТ, КАКУЮ ДВЕРЬ ЗАКРЫТЬ. ДРУГИЕ ОБСУЖДАЮТ,
Dialogue: 0,0:04:28.82,0:04:31.51,Caption,,0,0,0,,КОМУ ВООБЩЕ ПРИНАДЛЕЖИТ ДОМ И КТО ИМЕЕТ ПРАВО
Dialogue: 0,0:04:31.51,0:04:34.63,Caption,,0,0,0,,СТАВИТЬ ВОЗЛЕ НЕГО ВООРУЖЁННУЮ ОХРАНУ. И ВДРУГ НА
Dialogue: 0,0:04:34.71,0:04:37.75,Caption,,0,0,0,,ЭТОМ ФОНЕ FINANCIAL TIMES СООБЩАЕТ ОЧЕНЬ ИНТЕРЕСНУЮ
Dialogue: 0,0:04:37.83,0:04:40.55,Caption,,0,0,0,,ВЕЩЬ. ЕВРОПЕЙСКИЕ СТРАНЫ НАЧИНАЮТ ОБСУЖДАТЬ
Dialogue: 0,0:04:40.55,0:04:43.67,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ К СТАРЫМ МЕХАНИЗМАМ БЕЗОПАСНОСТИ ВРЕМЁН
Dialogue: 0,0:04:43.67,0:04:46.39,Caption,,0,0,0,,ХОЛОДНОЙ ВОЙНЫ. КОНТРОЛЬ НАД ВООРУЖЕНИЯМИ.
Dialogue: 0,0:04:46.71,0:04:49.99,Caption,,0,0,0,,ПРЕДОТВРАЩЕНИЕ ВОЕННЫХ ИНЦИДЕНТОВ. ЭЛЕМЕНТЫ ДОГОВОРА
Dialogue: 0,0:04:49.99,0:04:53.03,Caption,,0,0,0,,"ОТКРЫТОЕ НЕБО". ОГРАНИЧЕНИЯ, ПРАВИЛА,
Dialogue: 0,0:04:53.11,0:04:57.03,Caption,,0,0,0,,НАБЛЮДЕНИЕ, ВЗАИМНАЯ ПРЕДСКАЗУЕМОСТЬ. ЗДРАВСТВУЙТЕ. А ЭТО МЫ
Dialogue: 0,0:04:57.11,0:05:01.87,Caption,,0,0,0,,КУДА ПРИЕХАЛИ? МЫ ВЕДЬ ВСЁ ЭТО УЖЕ ГДЕ ТО СЛЫШАЛИ.
Dialogue: 0,0:05:02.02,0:05:04.75,Caption,,0,0,0,,ПРИЧЁМ НЕ СТО ЛЕТ НАЗАД. В ДЕКАБРЕ ДВАДЦАТЬ
Dialogue: 0,0:05:04.75,0:05:07.47,Caption,,0,0,0,,ПЕРВОГО ГОДА РОССИЯ ОФИЦИАЛЬНО ПЕРЕДАЛА СОЕДИНЁННЫМ
Dialogue: 0,0:05:07.55,0:05:10.35,Caption,,0,0,0,,ШТАТАМ ПРОЕКТЫ СОГЛАШЕНИЙ ПО ГАРАНТИЯМ БЕЗОПАСНОСТИ.
Dialogue: 0,0:05:10.75,0:05:13.55,Caption,,0,0,0,,ПОТОМ ДОКУМЕНТЫ ОПУБЛИКОВАЛИ. ТАМ ВСЁ ЛЕЖАЛО
Dialogue: 0,0:05:13.55,0:05:16.67,Caption,,0,0,0,,ОТКРЫТЫМ ТЕКСТОМ. НИКАКИХ ТАЙНЫХ ПАПОК. НИКАКОГО
Dialogue: 0,0:05:16.67,0:05:19.47,Caption,,0,0,0,,ГАДАНИЯ НА КОФЕЙНОЙ ГУЩЕ. РОССИЯ ПРЕДЛАГАЛА
Dialogue: 0,0:05:19.47,0:05:22.75,Caption,,0,0,0,,ОБСУЖДАТЬ НЕРАСШИРЕНИЕ НАТО, ВОЕННУЮ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:05:22.97,0:05:27.55,Caption,,0,0,0,,РАЗМЕЩЕНИЕ ВООРУЖЕНИЙ, ВОЕННУЮ АКТИВНОСТЬ И ЦЕЛЫЙ КОМПЛЕКС ОГРАНИЧЕНИЙ,
Dialogue: 0,0:05:27.63,0:05:30.19,Caption,,0,0,0,,СВЯЗАННЫХ С БЕЗОПАСНОСТЬЮ РОССИИ И СТРАН НАТО.
Dialogue: 0,0:05:30.82,0:05:33.95,Caption,,0,0,0,,ЗАПАД КЛЮЧЕВЫЕ ТРЕБОВАНИЯ НЕ ПРИНЯЛ. ВОТ ЭТО ФАКТ.
Dialogue: 0,0:05:34.27,0:05:37.31,Caption,,0,0,0,,ДОКУМЕНТЫ СУЩЕСТВОВАЛИ. ПРЕДЛОЖЕНИЯ БЫЛИ СДЕЛАНЫ.
Dialogue: 0,0:05:37.55,0:05:41.15,Caption,,0,0,0,,ОТВЕТ ТОЖЕ БЫЛ. И ТЕПЕРЬ, СПУСТЯ ПОЧТИ ПЯТЬ ЛЕТ,
Dialogue: 0,0:05:41.37,0:05:43.23,Caption,,0,0,0,,ЕВРОПА НАЧИНАЕТ ОБСУЖДАТЬ ЧТО?
Dialogue: 0,0:05:43.49,0:05:46.59,Caption,,0,0,0,,КОНТРОЛЬ НАД ВООРУЖЕНИЯМИ. ПРЕДОТВРАЩЕНИЕ ВОЕННЫХ
Dialogue: 0,0:05:46.59,0:05:50.11,Caption,,0,0,0,,ИНЦИДЕНТОВ. СТАРЫЕ МЕХАНИЗМЫ ДОВЕРИЯ. ВОЗВРАЩЕНИЕ К
Dialogue: 0,0:05:50.11,0:05:53.15,Caption,,0,0,0,,ДОГОВОРАМ. ПРЕКРАСНО. ТО ЕСТЬ УЧЕБНИК ВСЁ ЭТО ВРЕМЯ
Dialogue: 0,0:05:53.23,0:05:55.95,Caption,,0,0,0,,ЛЕЖАЛ НА СТОЛЕ. ЕГО ПРОСТО РЕШИЛИ ОТКРЫТЬ ПОСЛЕ
Dialogue: 0,0:05:55.95,0:05:58.19,Caption,,0,0,0,,ТОГО, КАК СДАЛИ ЭКЗАМЕН НА ДВОЙКУ,
Dialogue: 0,0:05:58.35,0:06:00.91,Caption,,0,0,0,,ПОССОРИЛИСЬ С ПРЕПОДАВАТЕЛЕМ И СОЖГЛИ ПОЛОВИНУ
Dialogue: 0,0:06:00.99,0:06:03.95,Caption,,0,0,0,,АУДИТОРИИ. СЕЙЧАС, КОНЕЧНО, МОЖНО СКАЗАТЬ,
Dialogue: 0,0:06:04.35,0:06:06.75,Caption,,0,0,0,,ЧТО ЕВРОПЕЙЦЫ ВОВСЕ НЕ СОГЛАСИЛИСЬ С РОССИЙСКИМИ
Dialogue: 0,0:06:06.75,0:06:09.39,Caption,,0,0,0,,ТРЕБОВАНИЯМИ ДВАДЦАТЬ ПЕРВОГО ГОДА. И ЭТО ПРАВДА.
Dialogue: 0,0:06:11.66,0:06:15.66,Caption,,0,0,0,,НИКТО НЕ ОБЪЯВИЛ, ЧТО НАТО ЗАВТРА ПАКУЕТ ЧЕМОДАНЫ И УЕЗЖАЕТ КУДА
Dialogue: 0,0:06:15.74,0:06:18.22,Caption,,0,0,0,,ТО ЗА ГРАНИЦЫ ДЕВЯНОСТО СЕДЬМОГО ГОДА. НИКТО НЕ
Dialogue: 0,0:06:18.22,0:06:22.06,Caption,,0,0,0,,СКАЗАЛ, ЧТО ВСЕ ТРЕБОВАНИЯ МОСКВЫ ПРИНЯТЫ. НО ВАЖНО ДРУГОЕ.
Dialogue: 0,0:06:22.38,0:06:24.86,Caption,,0,0,0,,САМ ПРЕДМЕТ РАЗГОВОРА ВЕРНУЛСЯ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:06:24.86,0:06:27.90,Caption,,0,0,0,,СЕРЬЁЗНО. ПОТОМУ ЧТО ЕСЛИ ЕВРОПА НАЧИНАЕТ ОБСУЖДАТЬ
Dialogue: 0,0:06:27.90,0:06:32.70,Caption,,0,0,0,,ОГРАНИЧЕНИЯ НА ВООРУЖЕНИЯ, ПРЕДОТВРАЩЕНИЕ ИНЦИДЕНТОВ И НОВЫЕ ПРАВИЛА ВОЕННОГО
Dialogue: 0,0:06:32.70,0:06:36.38,Caption,,0,0,0,,ПОВЕДЕНИЯ, ЗНАЧИТ РАЗГОВОР ПОСТЕПЕННО УХОДИТ ОТ ПРИМИТИВНОГО
Dialogue: 0,0:06:36.46,0:06:38.62,Caption,,0,0,0,,"ОСТАНОВИТЕ СТРЕЛЬБУ" К ВОПРОСУ О ТОМ,
Dialogue: 0,0:06:38.98,0:06:41.18,Caption,,0,0,0,,КАК ВООБЩЕ БУДУТ ЖИТЬ РЯДОМ РОССИЯ И НАТО
Dialogue: 0,0:06:41.18,0:06:44.14,Caption,,0,0,0,,ПОСЛЕ ОКОНЧАНИЯ КОНФЛИКТА. А ЭТО ИМЕННО ТО,
Dialogue: 0,0:06:44.38,0:06:46.86,Caption,,0,0,0,,О ЧЁМ МОСКВА ГОВОРИЛА ДО ФЕВРАЛЯ ДВАДЦАТЬ ВТОРОГО
Dialogue: 0,0:06:46.94,0:06:50.62,Caption,,0,0,0,,ГОДА. КСТАТИ, ДОГОВОР "ОТКРЫТОЕ НЕБО" ВЕДЬ ПРИДУМАЛИ НЕ ОТ ХОРОШЕЙ
Dialogue: 0,0:06:50.62,0:06:53.82,Caption,,0,0,0,,ЖИЗНИ. ЕГО СМЫСЛ БЫЛ ЭЛЕМЕНТАРНЫЙ. ЧТОБЫ СТОРОНЫ
Dialogue: 0,0:06:53.90,0:06:56.14,Caption,,0,0,0,,МОГЛИ СМОТРЕТЬ ДРУГ НА ДРУГА И МЕНЬШЕ ГАДАТЬ,
Dialogue: 0,0:06:56.37,0:06:59.02,Caption,,0,0,0,,ЧТО ТАМ СОСЕД ТИХОНЬКО ВЫКАТЫВАЕТ ИЗ АНГАРА.
Dialogue: 0,0:06:59.36,0:07:03.26,Caption,,0,0,0,,ПРОВЕРЯЕШЬ. НАБЛЮДАЕШЬ. ПОЛУЧАЕШЬ ИНФОРМАЦИЮ. МЕНЬШЕ
Dialogue: 0,0:07:03.26,0:07:07.74,Caption,,0,0,0,,НЕИЗВЕСТНОСТИ. МЕНЬШЕ ШАНСОВ, ЧТО КТО ТО УВИДЕЛ ДВИЖЕНИЕ ТЕХНИКИ,
Dialogue: 0,0:07:08.06,0:07:10.78,Caption,,0,0,0,,ДОДУМАЛ ОСТАЛЬНОЕ САМ И ПОБЕЖАЛ НАЖИМАТЬ БОЛЬШУЮ
Dialogue: 0,0:07:10.86,0:07:13.66,Caption,,0,0,0,,КРАСНУЮ КНОПКУ. СОЕДИНЁННЫЕ ШТАТЫ ПОТОМ ИЗ ЭТОГО
Dialogue: 0,0:07:13.74,0:07:16.62,Caption,,0,0,0,,ДОГОВОРА ВЫШЛИ. РОССИЯ ТОЖЕ. А ТЕПЕРЬ ОПЯТЬ
Dialogue: 0,0:07:16.62,0:07:19.82,Caption,,0,0,0,,ОБСУЖДАЮТ ЭЛЕМЕНТЫ СТАРОЙ КОНСТРУКЦИИ. НУ КОНЕЧНО.
Dialogue: 0,0:07:20.06,0:07:22.86,Caption,,0,0,0,,СТАРОЕ ИНОГДА УДИВИТЕЛЬНО БЫСТРО СТАНОВИТСЯ НОВЫМ,
Dialogue: 0,0:07:23.10,0:07:24.94,Caption,,0,0,0,,КОГДА НОВОЕ ПОЧЕМУ ТО НЕ РАБОТАЕТ.
Dialogue: 0,0:07:27.20,0:07:29.93,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ПОЯВЛЯЕТСЯ КУШНЕР. КУШНЕР ГОВОРИТ,
Dialogue: 0,0:07:30.20,0:07:32.89,Caption,,0,0,0,,ЧТО ПОСЛЕ КОНТАКТОВ С ПУТИНЫМ АМЕРИКАНСКАЯ СТОРОНА
Dialogue: 0,0:07:32.89,0:07:35.69,Caption,,0,0,0,,СЧИТАЕТ РОССИЮ ГОТОВОЙ К МИРНОМУ СОГЛАШЕНИЮ ПРИ
Dialogue: 0,0:07:35.69,0:07:38.57,Caption,,0,0,0,,СОБЛЮДЕНИИ ОПРЕДЕЛЁННЫХ УСЛОВИЙ. КОНЕЧНО РОССИЯ
Dialogue: 0,0:07:38.57,0:07:40.49,Caption,,0,0,0,,ГОТОВА. ЧЕГО Ж ЕЙ НЕ БЫТЬ ГОТОВОЙ?
Dialogue: 0,0:07:40.57,0:07:42.25,Caption,,0,0,0,,ОНА В ДВАДЦАТЬ ПЕРВОМ ГОДУ УЖЕ ПРИШЛА СО
Dialogue: 0,0:07:42.25,0:07:45.69,Caption,,0,0,0,,СВОИМИ УСЛОВИЯМИ. ВОТ ДОКУМЕНТЫ. ВОТ ПРЕДЛОЖЕНИЯ.
Dialogue: 0,0:07:45.93,0:07:48.81,Caption,,0,0,0,,ДАВАЙТЕ ОБСУЖДАТЬ. ТОГДА ВЫ ОТКАЗАЛИСЬ. ТЕПЕРЬ
Dialogue: 0,0:07:48.81,0:07:51.53,Caption,,0,0,0,,КУШНЕР ПРИЕЗЖАЕТ И ГОВОРИТ МЫ ПОГОВОРИЛИ С ПУТИНЫМ,
Dialogue: 0,0:07:51.77,0:07:54.41,Caption,,0,0,0,,РОССИЯ ГОТОВА К СОГЛАШЕНИЮ ПРИ ПРАВИЛЬНЫХ УСЛОВИЯХ.
Dialogue: 0,0:07:54.64,0:07:57.77,Caption,,0,0,0,,СПАСИБО, ДЖАРЕД. ТАК ОНА И ТОГДА БЫЛА ГОТОВА. ВОПРОС
Dialogue: 0,0:07:57.77,0:07:59.61,Caption,,0,0,0,,ВООБЩЕ НЕ В ЭТОМ. ВОПРОС В ТОМ,
Dialogue: 0,0:07:59.73,0:08:02.73,Caption,,0,0,0,,КТО ТЕПЕРЬ ГОТОВ ОБСУЖДАТЬ ЕЁ УСЛОВИЯ. ВОТ ЧТО
Dialogue: 0,0:08:02.73,0:08:05.37,Caption,,0,0,0,,ИЗМЕНИЛОСЬ. ПОТОМУ ЧТО ЕСЛИ РОССИЙСКАЯ ПОЗИЦИЯ ПО
Dialogue: 0,0:08:05.37,0:08:08.01,Caption,,0,0,0,,ФУНДАМЕНТАЛЬНЫМ ВОПРОСАМ БЕЗОПАСНОСТИ ОСТАЛАСЬ ТОЙ
Dialogue: 0,0:08:08.09,0:08:10.65,Caption,,0,0,0,,ЖЕ, А АМЕРИКАНСКИЕ ПЕРЕГОВОРЩИКИ ТЕПЕРЬ СЧИТАЮТ
Dialogue: 0,0:08:10.65,0:08:12.89,Caption,,0,0,0,,ВОЗМОЖНЫМ СТРОИТЬ ВОКРУГ НЕЁ СОГЛАШЕНИЕ,
Dialogue: 0,0:08:13.28,0:08:15.37,Caption,,0,0,0,,ТОГДА ИНТЕРЕСНЕЕ СМОТРЕТЬ УЖЕ НЕ НА МОСКВУ.
Dialogue: 0,0:08:15.75,0:08:18.49,Caption,,0,0,0,,ИНТЕРЕСНЕЕ СМОТРЕТЬ НА ВАШИНГТОН. ЧТО ТАМ ГОТОВЫ
Dialogue: 0,0:08:18.57,0:08:22.57,Caption,,0,0,0,,ОБСУЖДАТЬ СЕГОДНЯ ИЗ ТОГО, ЧТО В ДВАДЦАТЬ ПЕРВОМ ГОДУ ОБСУЖДАТЬ ОТКАЗАЛИСЬ?
Dialogue: 0,0:08:22.72,0:08:25.45,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО? ВОЕННУЮ ИНФРАСТРУКТУРУ?
Dialogue: 0,0:08:25.69,0:08:28.17,Caption,,0,0,0,,РАКЕТНЫЕ СИСТЕМЫ? МЕХАНИЗМЫ КОНТРОЛЯ?
Dialogue: 0,0:08:28.49,0:08:30.41,Caption,,0,0,0,,НОВЫЕ ПРАВИЛА ВОЕННОЙ АКТИВНОСТИ?
Dialogue: 0,0:08:30.62,0:08:33.21,Caption,,0,0,0,,ВОТ ГДЕ МЯСО. А НЕ В ОЧЕРЕДНОМ ТОРЖЕСТВЕННОМ
Dialogue: 0,0:08:33.21,0:08:35.77,Caption,,0,0,0,,СООБЩЕНИИ, ЧТО ПУТИН, ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:08:35.86,0:08:42.37,Caption,,0,0,0,,ГОТОВ РАЗГОВАРИВАТЬ. ОН РАЗГОВАРИВАЛ И ТОГДА. НЕ ДОГОВОРИЛИСЬ. И ЦЕНА
Dialogue: 0,0:08:42.45,0:08:44.69,Caption,,0,0,0,,ЭТОГО НЕДОГОВОРИЛИСЬ СЕГОДНЯ УЖЕ ИЗВЕСТНА ВСЕМ.
Dialogue: 0,0:08:44.91,0:08:47.09,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ДАЛЬШЕ
Dialogue: 0,0:08:47.09,0:08:50.77,Caption,,0,0,0,,ПОСМОТРИМ, ПОЧЕМУ ДАЖЕ ХОРОШИЕ ГАРАНТИИ БЕЗОПАСНОСТИ МОГУТ
Dialogue: 0,0:08:50.77,0:08:55.17,Caption,,0,0,0,,ОКАЗАТЬСЯ БЕСПОЛЕЗНЫМИ, ЕСЛИ ОДНУ ИЗ СТОРОН ОНИ НЕ УСТРАИВАЮТ. ТЕПЕРЬ
Dialogue: 0,0:08:55.17,0:08:57.41,Caption,,0,0,0,,СЛЕДУЮЩИЙ НОМЕР ПРОГРАММЫ. США,
Dialogue: 0,0:08:57.49,0:09:01.01,Caption,,0,0,0,,ЕВРОСОЮЗ И УКРАИНА ПУБЛИКУЮТ СОВМЕСТНОЕ ЗАЯВЛЕНИЕ.
Dialogue: 0,0:09:01.09,0:09:04.05,Caption,,0,0,0,,СУВЕРЕНИТЕТ УКРАИНЫ. ТЕРРИТОРИАЛЬНАЯ ЦЕЛОСТНОСТЬ.
Dialogue: 0,0:09:04.28,0:09:07.33,Caption,,0,0,0,,НЕЗАВИСИМОСТЬ ПРИНЯТИЯ РЕШЕНИЙ. НАДЁЖНЫЕ ГАРАНТИИ
Dialogue: 0,0:09:07.33,0:09:10.53,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ПРАКТИЧЕСКИЙ МЕХАНИЗМ ЗАЩИТЫ ПОСЛЕ
Dialogue: 0,0:09:10.53,0:09:13.57,Caption,,0,0,0,,ОКОНЧАНИЯ БОЕВЫХ ДЕЙСТВИЙ. УИТКОФФ СООБЩАЕТ,
Dialogue: 0,0:09:13.81,0:09:17.65,Caption,,0,0,0,,ЧТО ОБСУЖДАЛОСЬ, КАК ИСПОЛЬЗОВАТЬ СУЩЕСТВУЮЩИЕ ЕВРОПЕЙСКИЕ ИНСТИТУТЫ
Dialogue: 0,0:09:17.73,0:09:20.37,Caption,,0,0,0,,И ДОГОВОРЁННОСТИ ДЛЯ БУДУЩЕЙ СИСТЕМЫ БЕЗОПАСНОСТИ.
Dialogue: 0,0:09:20.57,0:09:23.73,Caption,,0,0,0,,ПРЕКРАСНО. ГАРАНТИИ ВЕЛИКОЛЕПНЫ. СОВЕЩАЙТЕСЬ.
Dialogue: 0,0:09:23.89,0:09:27.25,Caption,,0,0,0,,ПИШИТЕ. ДОГОВАРИВАЙТЕСЬ. УКРАИНЕ ГАРАНТИИ НУЖНЫ.
Dialogue: 0,0:09:27.61,0:09:29.97,Caption,,0,0,0,,ПОСЛЕ ВСЕГО ПРОИЗОШЕДШЕГО ЭТО ВООБЩЕ НЕ ВОПРОС.
Dialogue: 0,0:09:30.25,0:09:33.01,Caption,,0,0,0,,ТОЛЬКО ЕСТЬ ОДНА МАЛЕНЬКАЯ ДЕТАЛЬ. ЭТИ ГАРАНТИИ
Dialogue: 0,0:09:33.09,0:09:35.33,Caption,,0,0,0,,ДОЛЖНЫ УСТРАИВАТЬ РОССИЮ. И ЭТО УЖЕ НЕ Я
Dialogue: 0,0:09:35.33,0:09:38.69,Caption,,0,0,0,,ПРИДУМАЛ. ЭТО МАРКО РУБИО ГОВОРИТ. РУБИО ПРЯМО
Dialogue: 0,0:09:38.69,0:09:41.89,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО УКРАИНА ДОЛЖНА ЧУВСТВОВАТЬ СЕБЯ В БЕЗОПАСНОСТИ
Dialogue: 0,0:09:41.97,0:09:45.33,Caption,,0,0,0,,ПОСЛЕ ОКОНЧАНИЯ КОНФЛИКТА, НО МЕХАНИЗМ ДОЛЖЕН БЫТЬ ТАКИМ,
Dialogue: 0,0:09:45.49,0:09:48.21,Caption,,0,0,0,,С КОТОРЫМ СОГЛАСИТСЯ И РОССИЯ. ИНАЧЕ ОН ПРОСТО
Dialogue: 0,0:09:48.29,0:09:50.13,Caption,,0,0,0,,НЕ БУДЕТ РАБОТАТЬ. БОЛЕЕ ТОГО,
Dialogue: 0,0:09:50.39,0:09:52.61,Caption,,0,0,0,,ОКОНЧАТЕЛЬНОГО ПЛАНА ГАРАНТИЙ ПОКА НЕТ.
Dialogue: 0,0:09:54.90,0:09:57.70,Caption,,0,0,0,,ОБСУЖДАЮТСЯ РАЗНЫЕ ВАРИАНТЫ. ВОТ И ВСЁ. ОЧЕНЬ
Dialogue: 0,0:09:57.78,0:10:00.50,Caption,,0,0,0,,ПРОСТАЯ МЫСЛЬ. НЕ НАДО ДАЖЕ ЗАКАНЧИВАТЬ ГАРВАРД.
Dialogue: 0,0:10:00.98,0:10:03.22,Caption,,0,0,0,,ЕСЛИ ВЫ ЗАКЛЮЧАЕТЕ СОГЛАШЕНИЕ С РОССИЕЙ,
Dialogue: 0,0:10:03.46,0:10:06.42,Caption,,0,0,0,,НЕЛЬЗЯ СОБРАТЬ США, ЕВРОПУ И УКРАИНУ,
Dialogue: 0,0:10:06.66,0:10:09.22,Caption,,0,0,0,,ПРИДУМАТЬ МЕЖДУ СОБОЙ ЗАМЕЧАТЕЛЬНЫЙ НАБОР ПРАВИЛ,
Dialogue: 0,0:10:09.46,0:10:11.70,Caption,,0,0,0,,А ПОТОМ ПРИЙТИ К МОСКВЕ СО СЛОВАМИ МЫ
Dialogue: 0,0:10:11.78,0:10:14.66,Caption,,0,0,0,,ТУТ ВСЁ РЕШИЛИ, ДЕРЖИ, ПОДПИСЫВАЙ. НУ,
Dialogue: 0,0:10:14.76,0:10:17.54,Caption,,0,0,0,,ТАКОЕ СЕБЕ. ЭТО НЕ ДОГОВОР. ЭТО МЕНЮ В
Dialogue: 0,0:10:17.54,0:10:20.18,Caption,,0,0,0,,РЕСТОРАНЕ, КОТОРОЕ ВАМ ПРИНЕСЛИ ПОСЛЕ ТОГО,
Dialogue: 0,0:10:20.26,0:10:22.50,Caption,,0,0,0,,КАК ЗА ВАС УЖЕ ЗАКАЗАЛИ УЖИН. А ПОТОМ
Dialogue: 0,0:10:22.58,0:10:25.14,Caption,,0,0,0,,ОФИЦИАНТ ЕЩЁ УДИВЛЯЕТСЯ, ПОЧЕМУ ВЫ НЕ ЕДИТЕ.
Dialogue: 0,0:10:25.77,0:10:28.82,Caption,,0,0,0,,ГАРАНТИИ УКРАИНЫ ДОЛЖНЫ УЧИТЫВАТЬ ИНТЕРЕСЫ УКРАИНЫ.
Dialogue: 0,0:10:28.96,0:10:32.10,Caption,,0,0,0,,БЕЗУСЛОВНО. НО ЕСЛИ ВЕСЬ СМЫСЛ СОГЛАШЕНИЯ СОСТОИТ В
Dialogue: 0,0:10:32.18,0:10:35.22,Caption,,0,0,0,,ТОМ, ЧТОБЫ РОССИЯ СОГЛАСИЛАСЬ ПРЕКРАТИТЬ КОНФЛИКТ И
Dialogue: 0,0:10:35.22,0:10:37.38,Caption,,0,0,0,,ПРИЗНАЛА НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ,
Dialogue: 0,0:10:37.78,0:10:40.02,Caption,,0,0,0,,ТУДА НЕИЗБЕЖНО ПРИДЁТСЯ ЗАКЛАДЫВАТЬ И ИНТЕРЕСЫ
Dialogue: 0,0:10:40.02,0:10:44.82,Caption,,0,0,0,,РОССИИ. ИНАЧЕ КАКОЙ СМЫСЛ? ЕСЛИ МОСКВА СЧИТАЕТ ОПРЕДЕЛЁННОЕ РАЗМЕЩЕНИЕ ВОЙСК
Dialogue: 0,0:10:44.82,0:10:48.10,Caption,,0,0,0,,УГРОЗОЙ, А ВЫ ЭТО РАЗМЕЩЕНИЕ ПРЯМО ВПИСЫВАЕТЕ В ГАРАНТИИ
Dialogue: 0,0:10:48.10,0:10:51.94,Caption,,0,0,0,,УКРАИНЕ, МОСКВА ТАКОЙ ДОКУМЕНТ НЕ ПРИМЕТ. ЕСЛИ МОСКВА ТРЕБУЕТ
Dialogue: 0,0:10:51.94,0:10:53.94,Caption,,0,0,0,,ОГРАНИЧЕНИЙ ПО ИНФРАСТРУКТУРЕ НАТО,
Dialogue: 0,0:10:54.10,0:10:56.98,Caption,,0,0,0,,А НАТО ОТВЕЧАЕТ, ЧТО НИКАКИХ ОГРАНИЧЕНИЙ НЕ БУДЕТ,
Dialogue: 0,0:10:57.12,0:11:00.34,Caption,,0,0,0,,СПОР НЕ ИСЧЕЗАЕТ. ЕСЛИ КИЕВ ТРЕБУЕТ ГАРАНТИЙ,
Dialogue: 0,0:11:00.50,0:11:02.66,Caption,,0,0,0,,КОТОРЫЕ РОССИЯ СЧИТАЕТ ВОЕННОЙ УГРОЗОЙ,
Dialogue: 0,0:11:02.93,0:11:04.58,Caption,,0,0,0,,ВЫ ОПЯТЬ ПРИХОДИТЕ В ТУ ЖЕ ТОЧКУ.
Dialogue: 0,0:11:06.87,0:11:08.95,Caption,,0,0,0,,И СНОВА ЧЕРЕЗ КАКОЕ ТО ВРЕМЯ КТО НИБУДЬ
Dialogue: 0,0:11:08.95,0:11:11.99,Caption,,0,0,0,,СКАЖЕТ СЛУШАЙТЕ, А ДАВАЙТЕ ДЛЯ НАЧАЛА ПРОСТО ПРЕКРАТИМ ОГОНЬ.
Dialogue: 0,0:11:12.28,0:11:17.19,Caption,,0,0,0,,ПРОХОДИЛИ. И ЗДЕСЬ, КСТАТИ, ВОЗНИКАЕТ САМАЯ НЕПРИЯТНАЯ ЧАСТЬ ПЕРЕГОВОРОВ.
Dialogue: 0,0:11:17.43,0:11:20.07,Caption,,0,0,0,,БЕЗОПАСНОСТЬ НЕВОЗМОЖНО ГАРАНТИРОВАТЬ ТОЛЬКО ОДНОМУ
Dialogue: 0,0:11:20.07,0:11:23.11,Caption,,0,0,0,,УЧАСТНИКУ СИСТЕМЫ. ВОТ УКРАИНА ПОЛУЧИЛА ГАРАНТИИ.
Dialogue: 0,0:11:23.27,0:11:25.99,Caption,,0,0,0,,ХОРОШО. РОССИЯ СЧИТАЕТ СЕБЯ ПОСЛЕ ЭТОГО МЕНЕЕ
Dialogue: 0,0:11:25.99,0:11:31.27,Caption,,0,0,0,,ЗАЩИЩЁННОЙ. ЧТО ОНА ДЕЛАЕТ? НАЧИНАЕТ УСИЛИВАТЬСЯ. РОССИЯ УСИЛИВАЕТСЯ. ЧТО ДЕЛАЕТ
Dialogue: 0,0:11:31.35,0:11:35.27,Caption,,0,0,0,,НАТО? ТОЖЕ УСИЛИВАЕТСЯ. НАТО УСИЛИВАЕТСЯ. МОСКВА ОТВЕЧАЕТ
Dialogue: 0,0:11:35.35,0:11:38.31,Caption,,0,0,0,,ЕЩЁ ОДНИМ УСИЛЕНИЕМ. ПОЗДРАВЛЯЮ. МЫ ТОЛЬКО ЧТО
Dialogue: 0,0:11:38.39,0:11:41.19,Caption,,0,0,0,,ПОСТРОИЛИ ПРЕКРАСНУЮ НОВУЮ СИСТЕМУ БЕЗОПАСНОСТИ,
Dialogue: 0,0:11:41.51,0:11:44.63,Caption,,0,0,0,,В КОТОРОЙ КАЖДЫЙ ЧУВСТВУЕТ СЕБЯ ЕЩЁ МЕНЕЕ БЕЗОПАСНО,
Dialogue: 0,0:11:44.79,0:11:47.75,Caption,,0,0,0,,ЧЕМ РАНЬШЕ. БЕЗОПАСНОСТЬ СОСЕДА НЕЛЬЗЯ ВЫСТРАИВАТЬ
Dialogue: 0,0:11:47.83,0:11:51.27,Caption,,0,0,0,,ТАК, БУДТО ЗА ЗАБОРОМ НИКОГО НЕТ. ВСЕ СОСЕДИ ДОЛЖНЫ
Dialogue: 0,0:11:51.27,0:11:54.55,Caption,,0,0,0,,ПОНИМАТЬ ПРАВИЛА. ЧТО МОЖНО. ЧТО НЕЛЬЗЯ. ГДЕ
Dialogue: 0,0:11:54.55,0:11:58.07,Caption,,0,0,0,,НАХОДЯТСЯ ВООРУЖЕНИЯ. КАКИЕ СИСТЕМЫ ЗАПРЕЩЕНЫ. КАК
Dialogue: 0,0:11:58.15,0:12:00.95,Caption,,0,0,0,,ПРОВЕРЯЕТСЯ ВЫПОЛНЕНИЕ ДОГОВОРА. ЧТО ПРОИСХОДИТ,
Dialogue: 0,0:12:01.10,0:12:04.07,Caption,,0,0,0,,ЕСЛИ КТО ТО ЕГО НАРУШАЕТ. КАК ПРЕДОТВРАЩАЮТСЯ
Dialogue: 0,0:12:04.07,0:12:06.55,Caption,,0,0,0,,СЛУЧАЙНЫЕ СТОЛКНОВЕНИЯ. КУДА ЗВОНЯТ,
Dialogue: 0,0:12:06.63,0:12:09.35,Caption,,0,0,0,,КОГДА САМОЛЁТ ПОЛЕТЕЛ НЕ ТУДА. ЧТО ДЕЛАЮТ,
Dialogue: 0,0:12:09.51,0:12:12.07,Caption,,0,0,0,,ЕСЛИ РАЗВЕДКА УВИДЕЛА ПЕРЕДВИЖЕНИЕ ТЕХНИКИ И НЕ
Dialogue: 0,0:12:12.15,0:12:16.07,Caption,,0,0,0,,ПОНИМАЕТ, УЧЕНИЯ ЭТО ИЛИ ПОДГОТОВКА К УДАРУ. ВОТ ЭТО
Dialogue: 0,0:12:16.07,0:12:19.03,Caption,,0,0,0,,АРХИТЕКТУРА БЕЗОПАСНОСТИ. А НЕ ФОТОГРАФИЯ ДЕСЯТИ
Dialogue: 0,0:12:19.11,0:12:21.27,Caption,,0,0,0,,ДОВОЛЬНЫХ ПОЛИТИКОВ ВОЗЛЕ ДОКУМЕНТА НА ДВЕСТИ
Dialogue: 0,0:12:21.27,0:12:27.31,Caption,,0,0,0,,СТРАНИЦ. И ПОЭТОМУ ЛАВРОВ СЕЙЧАС ГОВОРИТ О ЕВРАЗИИ. КУШНЕР
Dialogue: 0,0:12:27.39,0:12:29.63,Caption,,0,0,0,,ГОВОРИТ ОБ УСЛОВИЯХ. РУБИО ГОВОРИТ,
Dialogue: 0,0:12:29.79,0:12:32.83,Caption,,0,0,0,,ЧТО ГАРАНТИИ ДОЛЖНЫ УСТРАИВАТЬ РОССИЮ. ЕВРОПЕЙЦЫ
Dialogue: 0,0:12:32.83,0:12:35.71,Caption,,0,0,0,,ДОСТАЮТ СТАРЫЕ ДОГОВОРЫ. И ВДРУГ ВСЕ ЭТИ НОВОСТИ
Dialogue: 0,0:12:35.71,0:12:37.87,Caption,,0,0,0,,НАЧИНАЮТ СКЛАДЫВАТЬСЯ СОВСЕМ НЕ В УКРАИНСКУЮ
Dialogue: 0,0:12:37.87,0:12:41.23,Caption,,0,0,0,,КАРТИНКУ. ОНИ СКЛАДЫВАЮТСЯ В РАЗГОВОР РОССИИ С НАТО
Dialogue: 0,0:12:41.31,0:12:44.59,Caption,,0,0,0,,О ТОМ, КАК ВООБЩЕ БУДЕТ ВЫГЛЯДЕТЬ ПРОСТРАНСТВО БЕЗОПАСНОСТИ
Dialogue: 0,0:12:44.59,0:12:47.71,Caption,,0,0,0,,ПОСЛЕ ОКОНЧАНИЯ НЫНЕШНЕГО КОНФЛИКТА. УКРАИНА В
Dialogue: 0,0:12:47.79,0:12:50.43,Caption,,0,0,0,,ЦЕНТРЕ СОБЫТИЙ. НО СТОЛ, ПОХОЖЕ,
Dialogue: 0,0:12:50.54,0:12:53.71,Caption,,0,0,0,,УЖЕ СТАНОВИТСЯ ГОРАЗДО БОЛЬШЕ САМОЙ УКРАИНЫ. И ТУТ
Dialogue: 0,0:12:53.71,0:12:56.11,Caption,,0,0,0,,АМЕРИКАНЦАМ ПРИДЁТСЯ РЕШАТЬ ЕЩЁ ОДНУ ПРОБЛЕМУ.
Dialogue: 0,0:12:56.28,0:12:59.55,Caption,,0,0,0,,ЕВРОПА. ПОТОМУ ЧТО ВАШИНГТОН СЕГОДНЯ ЯВНО ПЫТАЕТСЯ
Dialogue: 0,0:12:59.55,0:13:03.71,Caption,,0,0,0,,НАЙТИ КОНСТРУКЦИЮ, НА КОТОРУЮ СОГЛАСИТСЯ МОСКВА. А ЧАСТЬ ЕВРОПЕЙСКИХ
Dialogue: 0,0:13:03.79,0:13:06.11,Caption,,0,0,0,,ГОСУДАРСТВ ПРОДОЛЖАЕТ ИСХОДИТЬ ИЗ СОВСЕМ ДРУГОЙ
Dialogue: 0,0:13:06.11,0:13:08.91,Caption,,0,0,0,,ЛОГИКИ. ДЛЯ НИХ ГЛАВНЫЙ ВОПРОС ЗАКЛЮЧАЕТСЯ ПРЕЖДЕ
Dialogue: 0,0:13:08.99,0:13:12.67,Caption,,0,0,0,,ВСЕГО В ТОМ, КАК ОБЕСПЕЧИТЬ УКРАИНУ И НЕ ДАТЬ РОССИИ ПОЛУЧИТЬ
Dialogue: 0,0:13:12.67,0:13:16.75,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ РЕЗУЛЬТАТ, КОТОРЫЙ В ЕВРОПЕ ВОСПРИМУТ КАК НАГРАДУ ЗА ПРИМЕНЕНИЕ
Dialogue: 0,0:13:16.75,0:13:20.51,Caption,,0,0,0,,СИЛЫ. У МОСКВЫ ЛОГИКА ДРУГАЯ. МОСКВА ГОВОРИТ ВЕРНИТЕСЬ К
Dialogue: 0,0:13:20.51,0:13:23.23,Caption,,0,0,0,,ПРИЧИНАМ КОНФЛИКТА. И СОЕДИНЁННЫЕ ШТАТЫ СЕЙЧАС
Dialogue: 0,0:13:23.23,0:13:25.95,Caption,,0,0,0,,ОКАЗАЛИСЬ МЕЖДУ ЭТИМИ ДВУМЯ ПОДХОДАМИ. С ОДНОЙ
Dialogue: 0,0:13:25.95,0:13:28.43,Caption,,0,0,0,,СТОРОНЫ, СОЮЗНИКИ. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:13:28.54,0:13:31.23,Caption,,0,0,0,,ПЕРЕГОВОРЫ, КОТОРЫЕ БЕССМЫСЛЕННО ВЕСТИ,
Dialogue: 0,0:13:31.47,0:13:34.27,Caption,,0,0,0,,ЕСЛИ ЗАРАНЕЕ ОБЪЯВИТЬ НЕПРИЕМЛЕМЫМИ ВСЕ ТРЕБОВАНИЯ
Dialogue: 0,0:13:34.27,0:13:38.24,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ. А РОССИЯ ЗДЕСЬ,
Dialogue: 0,0:13:38.33,0:13:41.92,Caption,,0,0,0,,КАК И РАНЬШЕ, СТОИТ НА СВОЁМ. И В ЭТОМ СМЫСЛЕ РОССИЙСКАЯ
Dialogue: 0,0:13:41.92,0:13:44.96,Caption,,0,0,0,,ПОЗИЦИЯ ДЕЙСТВИТЕЛЬНО НАПОМИНАЕТ СКАЛУ. МОЖНО ВОКРУГ
Dialogue: 0,0:13:44.96,0:13:48.40,Caption,,0,0,0,,НЕЁ БЕГАТЬ. МОЖНО СОЗДАВАТЬ КОАЛИЦИИ. МОЖНО ПИСАТЬ
Dialogue: 0,0:13:48.40,0:13:51.84,Caption,,0,0,0,,ЗАЯВЛЕНИЯ. МОЖНО ОБСУЖДАТЬ НОВЫЕ ПАКЕТЫ. МОЖНО
Dialogue: 0,0:13:51.84,0:13:54.80,Caption,,0,0,0,,ОБЪЯВЛЯТЬ НОВЫЕ ГАРАНТИИ. НО ЕСЛИ ФУНДАМЕНТАЛЬНЫЕ
Dialogue: 0,0:13:54.80,0:13:56.88,Caption,,0,0,0,,РОССИЙСКИЕ ТРЕБОВАНИЯ ОСТАЮТСЯ НА СТОЛЕ,
Dialogue: 0,0:13:57.25,0:13:59.68,Caption,,0,0,0,,БУДУЩУЮ СИСТЕМУ ВСЁ РАВНО ПРИДЁТСЯ СТРОИТЬ С ИХ
Dialogue: 0,0:13:59.68,0:14:02.80,Caption,,0,0,0,,УЧЁТОМ. НЕ ОБЯЗАТЕЛЬНО ПРИНИМАТЬ ВСЁ. ПЕРЕГОВОРЫ ДЛЯ
Dialogue: 0,0:14:02.80,0:14:06.00,Caption,,0,0,0,,ТОГО И НУЖНЫ, ЧТОБЫ ТОРГОВАТЬСЯ. НО НЕЛЬЗЯ СДЕЛАТЬ ВИД,
Dialogue: 0,0:14:06.16,0:14:08.40,Caption,,0,0,0,,ЧТО ЭТИХ ТРЕБОВАНИЙ НЕТ. И ВОТ ТУТ МЫ
Dialogue: 0,0:14:08.40,0:14:11.36,Caption,,0,0,0,,ПРИХОДИМ К ГЛАВНОМУ. СЕГОДНЯ ВСЕ ОЧЕНЬ ЛЮБЯТ СЛОВО
Dialogue: 0,0:14:11.36,0:14:14.56,Caption,,0,0,0,,"МИР". ОНО ПРЕКРАСНОЕ. ТОЛЬКО МИР ЭТО НЕ МОМЕНТ,
Dialogue: 0,0:14:14.73,0:14:17.04,Caption,,0,0,0,,КОГДА ПЕРЕСТАЛИ СТРЕЛЯТЬ. ЭТО МОМЕНТ,
Dialogue: 0,0:14:17.27,0:14:20.08,Caption,,0,0,0,,КОГДА У СТОРОН ИСЧЕЗЛА НЕОБХОДИМОСТЬ СНОВА НАЧИНАТЬ.
Dialogue: 0,0:14:20.32,0:14:22.96,Caption,,0,0,0,,А ВОТ ЭТОГО ДОБИТЬСЯ ГОРАЗДО СЛОЖНЕЕ. ДЛЯ ЭТОГО
Dialogue: 0,0:14:23.04,0:14:26.00,Caption,,0,0,0,,МАЛО СКАЗАТЬ КИЕВУ ВЫ В БЕЗОПАСНОСТИ. НАДО,
Dialogue: 0,0:14:26.10,0:14:28.56,Caption,,0,0,0,,ЧТОБЫ МОСКВА ТОЖЕ СЧИТАЛА НОВУЮ КОНСТРУКЦИЮ
Dialogue: 0,0:14:28.56,0:14:32.08,Caption,,0,0,0,,БЕЗОПАСНОЙ ДЛЯ СЕБЯ. НАДО, ЧТОБЫ ЕВРОПА ПОНИМАЛА,
Dialogue: 0,0:14:32.24,0:14:34.72,Caption,,0,0,0,,КАКИЕ ОБЯЗАТЕЛЬСТВА ОНА БЕРЁТ. НАДО,
Dialogue: 0,0:14:34.91,0:14:39.04,Caption,,0,0,0,,ЧТОБЫ США ПОНИМАЛИ, КАКИЕ ГАРАНТИИ ОНИ ДЕЙСТВИТЕЛЬНО ГОТОВЫ ВЫПОЛНЯТЬ
Dialogue: 0,0:14:39.04,0:14:42.80,Caption,,0,0,0,,ЧЕРЕЗ ПЯТЬ, ДЕСЯТЬ, ПЯТНАДЦАТЬ ЛЕТ. НАДО ОПРЕДЕЛИТЬ,
Dialogue: 0,0:14:42.88,0:14:46.32,Caption,,0,0,0,,ГДЕ СТОЯТ РАКЕТЫ. ГДЕ НАХОДЯТСЯ ВОЙСКА. КАКИЕ
Dialogue: 0,0:14:46.32,0:14:50.00,Caption,,0,0,0,,ВОЕННЫЕ ДЕЙСТВИЯ ДОПУСТИМЫ. КАКИЕ ЗАПРЕЩЕНЫ. КАК ВСЁ
Dialogue: 0,0:14:50.00,0:14:52.40,Caption,,0,0,0,,ЭТО ПРОВЕРЯТЬ. И ЧТО ДЕЛАТЬ С НАРУШИТЕЛЕМ.
Dialogue: 0,0:14:54.68,0:14:57.48,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ОБЫЧНОЕ ПЕРЕМИРИЕ РОССИЮ СЕЙЧАС НЕ
Dialogue: 0,0:14:57.56,0:15:02.04,Caption,,0,0,0,,УСТРАИВАЕТ. НЕ ПОТОМУ, ЧТО СЛОВО ПЛОХОЕ. А ПОТОМУ ЧТО ПАУЗА БЕЗ
Dialogue: 0,0:15:02.04,0:15:04.52,Caption,,0,0,0,,РЕШЕНИЯ ЭТИХ ВОПРОСОВ ОСТАВЛЯЕТ ВЕСЬ КОНФЛИКТ НА
Dialogue: 0,0:15:04.52,0:15:08.12,Caption,,0,0,0,,МЕСТЕ. МОЖНО ЗАШИТЬ РАНУ СВЕРХУ. НО ЕСЛИ ВНУТРИ
Dialogue: 0,0:15:08.12,0:15:11.40,Caption,,0,0,0,,ВСЁ ОСТАЛОСЬ КАК БЫЛО, ПОТОМ ПРИДЁТСЯ РЕЗАТЬ ЕЩЁ РАЗ.
Dialogue: 0,0:15:11.96,0:15:13.96,Caption,,0,0,0,,И САМОЕ ИРОНИЧНОЕ ЗДЕСЬ ДАЖЕ НЕ ТО,
Dialogue: 0,0:15:14.12,0:15:16.84,Caption,,0,0,0,,ЧТО СПУСТЯ ПОЧТИ ПЯТЬ ЛЕТ ВСЕ СНОВА ЗАГОВОРИЛИ
Dialogue: 0,0:15:16.92,0:15:19.24,Caption,,0,0,0,,О ГАРАНТИЯХ БЕЗОПАСНОСТИ. А ТО,
Dialogue: 0,0:15:19.56,0:15:22.28,Caption,,0,0,0,,ЧТО КРУГ ПОСТЕПЕННО ЗАМЫКАЕТСЯ ВОКРУГ ВОПРОСОВ,
Dialogue: 0,0:15:22.52,0:15:24.84,Caption,,0,0,0,,КОТОРЫЕ УЖЕ ЛЕЖАЛИ НА СТОЛЕ В ДЕКАБРЕ ДВАДЦАТЬ
