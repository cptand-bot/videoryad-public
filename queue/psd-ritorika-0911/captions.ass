Dialogue: 0,0:00:00.12,0:00:03.80,Caption,,0,0,0,,В ВАШИНГТОНЕ РЕШИЛИ, ЧТО ЕВРОПЕЙСКИЙ ПОЖАР ПОРА НЕ ТОЛЬКО ЗАЛИВАТЬ
Dialogue: 0,0:00:03.80,0:00:06.04,Caption,,0,0,0,,ДЕНЬГАМИ, НО И ОБСУЖДАТЬ С ТЕМИ,
Dialogue: 0,0:00:06.25,0:00:09.24,Caption,,0,0,0,,КТО СТОИТ ПО ДРУГУЮ СТОРОНУ ОГНЯ. ТРАМП ПРЕДЛАГАЕТ
Dialogue: 0,0:00:09.32,0:00:11.48,Caption,,0,0,0,,БОЛЬШОЙ РАЗГОВОР. СТОЛ УЖЕ ИЩУТ,
Dialogue: 0,0:00:11.71,0:00:15.64,Caption,,0,0,0,,ПОВЕСТКУ СОСТАВЛЯЮТ, ТЕЛЕФОНЫ ПРОВЕРЯЮТ. А ЧАСТЬ ЕВРОПЕЙСКИХ
Dialogue: 0,0:00:15.64,0:00:18.52,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ ТЕМ ВРЕМЕНЕМ РЕПЕТИРУЕТ РЕЧЬ О ТОМ,
Dialogue: 0,0:00:18.70,0:00:21.96,Caption,,0,0,0,,ПОЧЕМУ РАЗГОВОР НАЧИНАТЬ НЕЛЬЗЯ. ПРЕКРАСНО. А ДАЛЬШЕ
Dialogue: 0,0:00:22.04,0:00:28.07,Caption,,0,0,0,,ТО ЧТО У ВАС ПО ПЛАНУ? ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ БЕЗ ДИПЛОМАТИЧЕСКОГО
Dialogue: 0,0:00:28.07,0:00:35.64,Caption,,0,0,0,,СНОТВОРНОГО, ПОДПИШИТЕСЬ. ОСОБЕННО ГРОМКО СЕЙЧАС ЗВУЧАТ СТРАНЫ БАЛТИИ. ЭСТОНИЯ
Dialogue: 0,0:00:35.72,0:00:38.68,Caption,,0,0,0,,ТРЕБУЕТ ПРОДОЛЖАТЬ ДАВЛЕНИЕ. ЛИТВА ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:00:38.92,0:00:42.20,Caption,,0,0,0,,ЧТО РОССИИ НЕЛЬЗЯ ДОВЕРЯТЬ. ПРЕЗИДЕНТ ЛИТВЫ ГИТАНАС
Dialogue: 0,0:00:42.28,0:00:45.56,Caption,,0,0,0,,НАУСЕДА ГОВОРИТ О ПРОВОКАЦИЯХ ПРОТИВ СТРАН НАТО И
Dialogue: 0,0:00:45.64,0:00:47.48,Caption,,0,0,0,,ПРОВЕРКЕ КРАСНЫХ ЛИНИЙ АЛЬЯНСА.
Dialogue: 0,0:00:49.75,0:00:52.31,Caption,,0,0,0,,СЛУШАЕШЬ ЭТУ РЕШИТЕЛЬНОСТЬ И НЕВОЛЬНО ВСПОМИНАЕШЬ
Dialogue: 0,0:00:52.39,0:00:55.75,Caption,,0,0,0,,СТАРЫЙ ВОПРОС, КОТОРЫЙ ПРИПИСЫВАЮТ СТАЛИНУ "А СКОЛЬКО У НИХ
Dialogue: 0,0:00:55.75,0:00:59.30,Caption,,0,0,0,,ДИВИЗИЙ?" ДЕЙСТВИТЕЛЬНО,
Dialogue: 0,0:00:59.41,0:01:03.81,Caption,,0,0,0,,СКОЛЬКО? ПО ИНТОНАЦИИ МОЖНО ПОДУМАТЬ,
Dialogue: 0,0:01:04.05,0:01:06.69,Caption,,0,0,0,,ЧТО ЭСТОНИЯ ДЕРЖИТ В РЕЗЕРВЕ НЕСКОЛЬКО АРМИЙ,
Dialogue: 0,0:01:06.93,0:01:08.85,Caption,,0,0,0,,ЛИТВА ПРИКРЫВАЕТ ВТОРОЙ ЭШЕЛОН,
Dialogue: 0,0:01:09.09,0:01:11.65,Caption,,0,0,0,,А КАЯ КАЛЛАС УЖЕ ВЫБИРАЕТ ПЛОЩАДЬ ДЛЯ ПОБЕДНОГО
Dialogue: 0,0:01:11.65,0:01:15.09,Caption,,0,0,0,,ПАРАДА. НО БЕЗОПАСНОСТЬ ЭТИХ СТРАН ОБЕСПЕЧИВАЕТСЯ НЕ
Dialogue: 0,0:01:15.09,0:01:18.05,Caption,,0,0,0,,ГРОМКОСТЬЮ ЗАЯВЛЕНИЙ. ОНА ДЕРЖИТСЯ НА НАТО,
Dialogue: 0,0:01:18.15,0:01:22.93,Caption,,0,0,0,,АМЕРИКАНСКИХ ГАРАНТИЯХ, СОЮЗНЫХ ВОЙСКАХ И ОБЩЕЙ ВОЕННОЙ ИНФРАСТРУКТУРЕ.
Dialogue: 0,0:01:25.20,0:01:28.16,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАНЯТНАЯ КОНСТРУКЦИЯ. САМЫЕ НЕБОЛЬШИЕ
Dialogue: 0,0:01:28.16,0:01:32.16,Caption,,0,0,0,,УЧАСТНИКИ ГОВОРЯТ ТАК, БУДТО ИМЕННО ОНИ ВЫДАЮТ ОСТАЛЬНЫМ ГАРАНТИИ
Dialogue: 0,0:01:32.16,0:01:35.04,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ХОТЯ ГЛАВНЫЙ ВОПРОС КАК РАЗ В ТОМ,
Dialogue: 0,0:01:35.27,0:01:37.60,Caption,,0,0,0,,СОХРАНИТСЯ ЛИ ПРЕЖНЯЯ АМЕРИКАНСКАЯ РОЛЬ.
Dialogue: 0,0:01:39.88,0:01:45.77,Caption,,0,0,0,,ВОТ ОТКУДА ТАКАЯ НЕРВОЗНОСТЬ. ТРАМП ЗАГОВОРИЛ О ДОГОВОРЁННОСТИ,
Dialogue: 0,0:01:46.00,0:01:48.41,Caption,,0,0,0,,КОТОРАЯ ДОЛЖНА ОХВАТЫВАТЬ НЕ ОДНУ УКРАИНУ,
Dialogue: 0,0:01:48.65,0:01:52.09,Caption,,0,0,0,,А БЕЗОПАСНОСТЬ ВСЕЙ ЕВРОПЫ. СРЕДИ ОБСУЖДАЕМЫХ ВЕЩЕЙ
Dialogue: 0,0:01:52.17,0:01:54.33,Caption,,0,0,0,,НАЗЫВАЮТСЯ ПОСТОЯННЫЕ КОНСУЛЬТАЦИИ,
Dialogue: 0,0:01:54.59,0:01:56.41,Caption,,0,0,0,,ПРЯМАЯ СВЯЗЬ ВО ВРЕМЯ КРИЗИСОВ,
Dialogue: 0,0:01:56.74,0:01:59.93,Caption,,0,0,0,,ПРОЗРАЧНОСТЬ ВОЕННОЙ ДЕЯТЕЛЬНОСТИ И ВЗАИМНЫЕ МЕРЫ
Dialogue: 0,0:02:00.01,0:02:07.25,Caption,,0,0,0,,ПРОТИВ СЛУЧАЙНОЙ ЭСКАЛАЦИИ. ВРОДЕ БЫ НЕ КАПИТУЛЯЦИЯ. НЕ ПОДАРОК МОСКВЕ. ДАЖЕ
Dialogue: 0,0:02:07.33,0:02:10.29,Caption,,0,0,0,,НЕ ДРУЖЕСКИЙ УЖИН ПРИ СВЕЧАХ. ПОПЫТКА УСТАНОВИТЬ
Dialogue: 0,0:02:10.29,0:02:13.49,Caption,,0,0,0,,ПРАВИЛА МЕЖДУ СТОРОНАМИ, КОТОРЫЕ ДРУГ ДРУГУ НЕ ДОВЕРЯЮТ.
Dialogue: 0,0:02:15.77,0:02:17.69,Caption,,0,0,0,,НО ЕВРОПЕЙСКИЕ СОЮЗНИКИ ПО НАТО,
Dialogue: 0,0:02:17.85,0:02:21.53,Caption,,0,0,0,,КАК ВЫЯСНИЛОСЬ, ЗАРАНЕЕ ПОЧТИ НИЧЕГО НЕ ЗНАЛИ ОБ АМЕРИКАНСКИХ
Dialogue: 0,0:02:21.53,0:02:24.09,Caption,,0,0,0,,ПЛАНАХ. ВОТ ЭТО УЖЕ ХОРОШИЙ СЕМЕЙНЫЙ РАЗГОВОР.
Dialogue: 0,0:02:26.38,0:02:28.86,Caption,,0,0,0,,АМЕРИКА СОБРАЛАСЬ ДОГОВАРИВАТЬСЯ О БЕЗОПАСНОСТИ
Dialogue: 0,0:02:28.94,0:02:32.06,Caption,,0,0,0,,ЕВРОПЫ. ЕВРОПА УЗНАЛА ОБ ЭТОМ ПОЧТИ ОДНОВРЕМЕННО С
Dialogue: 0,0:02:32.06,0:02:34.94,Caption,,0,0,0,,ПУБЛИКОЙ. ТЕПЕРЬ ЕВРОПЕЙСКИЕ СТОЛИЦЫ ТРЕБУЮТ,
Dialogue: 0,0:02:35.18,0:02:37.02,Caption,,0,0,0,,ЧТОБЫ БЕЗ НИХ ИХ СУДЬБУ НЕ РЕШАЛИ.
Dialogue: 0,0:02:39.31,0:02:41.95,Caption,,0,0,0,,ТРЕБОВАНИЕ СПРАВЕДЛИВОЕ. ТОЛЬКО ОДНОГО СТУЛА ЗА
Dialogue: 0,0:02:42.03,0:02:44.43,Caption,,0,0,0,,СТОЛОМ МАЛО. К СТУЛУ ЖЕЛАТЕЛЬНО ПРИНЕСТИ
Dialogue: 0,0:02:44.43,0:02:47.47,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ, А НЕ ПАПКУ С ВОЗМУЩЕНИЕМ ТОЛЩИНОЙ В ТРИ
Dialogue: 0,0:02:47.47,0:02:51.35,Caption,,0,0,0,,ТОМА. КАЯ КАЛЛАС СЧИТАЕТ,
Dialogue: 0,0:02:51.57,0:02:54.55,Caption,,0,0,0,,ЧТО НОВАЯ СИСТЕМА ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ НЕ НУЖНА.
Dialogue: 0,0:02:54.88,0:02:57.11,Caption,,0,0,0,,УЖЕ СУЩЕСТВУЮТ НАТО И ЕВРОСОЮЗ,
Dialogue: 0,0:02:57.38,0:02:59.59,Caption,,0,0,0,,А РОССИЯ НЕ ДОЛЖНА ПОЛУЧАТЬ ПРАВО ВЕТО НА
Dialogue: 0,0:02:59.67,0:03:05.30,Caption,,0,0,0,,РЕШЕНИЯ ЕВРОПЫ. ДОПУСТИМ. ТОГДА ЗАЧЕМ ВООБЩЕ ПОНАДОБИЛАСЬ
Dialogue: 0,0:03:05.38,0:03:12.05,Caption,,0,0,0,,АМЕРИКАНСКАЯ ИНИЦИАТИВА? ПЯТЫЙ ГОД ПРОДОЛЖАЕТСЯ ТЯЖЕЛЕЙШИЙ КОНФЛИКТ. ДО ЕГО
Dialogue: 0,0:03:12.13,0:03:15.01,Caption,,0,0,0,,НАЧАЛА МОСКВА ПОДНИМАЛА ВОПРОСЫ РАСШИРЕНИЯ НАТО,
Dialogue: 0,0:03:15.17,0:03:18.05,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЫ И РАЗМЕЩЕНИЯ ВООРУЖЕНИЙ.
Dialogue: 0,0:03:18.49,0:03:21.81,Caption,,0,0,0,,ЗАПАД РОССИЙСКИЕ ТРЕБОВАНИЯ ОТВЕРГ. У УКРАИНЫ ЕСТЬ
Dialogue: 0,0:03:21.89,0:03:24.93,Caption,,0,0,0,,СОБСТВЕННЫЕ УСЛОВИЯ. У ЕВРОПЫ СВОИ. ТЕПЕРЬ
Dialogue: 0,0:03:25.01,0:03:27.57,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ПРЕДЛАГАЮТ ВЫНЕСТИ ПРОБЛЕМУ НА
Dialogue: 0,0:03:27.65,0:03:33.78,Caption,,0,0,0,,БОЛЕЕ ШИРОКИЙ УРОВЕНЬ. А ИМ ОТВЕЧАЮТ ОБСУЖДАТЬ УСТРОЙСТВО БЕЗОПАСНОСТИ
Dialogue: 0,0:03:33.78,0:03:37.06,Caption,,0,0,0,,НЕЗАЧЕМ, ПОТОМУ ЧТО ОНО УЖЕ УСТРОЕНО. ШИКАРНО.
Dialogue: 0,0:03:39.26,0:03:42.78,Caption,,0,0,0,,ЭТО КАК ВЫЗВАТЬ ПОЖАРНЫХ, ВСТРЕТИТЬ ИХ У ПОДЪЕЗДА И СООБЩИТЬ,
Dialogue: 0,0:03:43.00,0:03:46.22,Caption,,0,0,0,,ЧТО ДОМ ПОСТРОЕН ПО УТВЕРЖДЁННОМУ ПРОЕКТУ. ПРОЕКТ
Dialogue: 0,0:03:46.22,0:03:49.42,Caption,,0,0,0,,ХОРОШИЙ, ПЕЧАТЬ СТОИТ, А ДЫМ, ВИДИМО,
Dialogue: 0,0:03:49.52,0:03:51.34,Caption,,0,0,0,,НАРУШАЕТ РЕГЛАМЕНТ САМОВОЛЬНО.
Dialogue: 0,0:03:53.63,0:03:56.27,Caption,,0,0,0,,КАЛЛАС В ЭТОЙ ИСТОРИИ ПОКАЗАТЕЛЬНА ЕЩЁ И ПОТОМУ,
Dialogue: 0,0:03:56.43,0:03:58.91,Caption,,0,0,0,,ЧТО ПРЕЖДЕ ВОЗГЛАВЛЯЛА ПРАВИТЕЛЬСТВО ЭСТОНИИ,
Dialogue: 0,0:03:59.20,0:04:01.63,Caption,,0,0,0,,А ТЕПЕРЬ ГОВОРИТ ОТ ИМЕНИ ЕВРОСОЮЗА ВО ВНЕШНИХ
Dialogue: 0,0:04:01.63,0:04:04.75,Caption,,0,0,0,,ДЕЛАХ. НЫНЕШНИЙ ЭСТОНСКИЙ ПРЕМЬЕР КРИСТЕН МИХАЛ
Dialogue: 0,0:04:04.75,0:04:07.39,Caption,,0,0,0,,ВЫРАЖАЕТСЯ НЕ МЕНЕЕ ЖЁСТКО. ЕВРОПА,
Dialogue: 0,0:04:07.47,0:04:11.55,Caption,,0,0,0,,ПО ЕГО МНЕНИЮ, НЕ ДОЛЖНА БЫТЬ ПОСРЕДНИКОМ МЕЖДУ РОССИЕЙ И УКРАИНОЙ,
Dialogue: 0,0:04:11.71,0:04:14.43,Caption,,0,0,0,,ИСКАТЬ ОТДЕЛЬНЫЙ КАНАЛ С МОСКВОЙ ИЛИ ПЫТАТЬСЯ
Dialogue: 0,0:04:14.51,0:04:16.75,Caption,,0,0,0,,УГОДИТЬ ПУТИНУ. НУЖНЫ САНКЦИИ,
Dialogue: 0,0:04:16.91,0:04:19.87,Caption,,0,0,0,,ВИЗОВЫЕ ОГРАНИЧЕНИЯ И ДАЛЬНЕЙШЕЕ ДАВЛЕНИЕ.
Dialogue: 0,0:04:22.15,0:04:25.03,Caption,,0,0,0,,ПОСРЕДНИЧЕСТВО УБРАЛИ. ПРЯМОЙ КАНАЛ ЗАКРЫЛИ.
Dialogue: 0,0:04:25.19,0:04:30.84,Caption,,0,0,0,,ДАВЛЕНИЕ ОСТАВИЛИ. КАКОГО РЕЗУЛЬТАТА ВЫ ХОТИТЕ ДОБИТЬСЯ?
Dialogue: 0,0:04:33.13,0:04:35.53,Caption,,0,0,0,,РОССИЯ ДОЛЖНА ОТКАЗАТЬСЯ ОТ СВОИХ ТРЕБОВАНИЙ?
Dialogue: 0,0:04:35.74,0:04:38.01,Caption,,0,0,0,,КАПИТУЛИРОВАТЬ? СМЕНИТЬ РУКОВОДСТВО?
Dialogue: 0,0:04:38.24,0:04:40.57,Caption,,0,0,0,,ПРИНЯТЬ ЕВРОПЕЙСКИЕ УСЛОВИЯ И ПОБЛАГОДАРИТЬ ЗА
Dialogue: 0,0:04:40.57,0:04:43.37,Caption,,0,0,0,,НАСТОЙЧИВОСТЬ? НАЗОВИТЕ КОНЕЧНУЮ ТОЧКУ,
Dialogue: 0,0:04:43.61,0:04:45.93,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ИНСТРУМЕНТ МОЖНО БУДЕТ ПОЛОЖИТЬ НА
Dialogue: 0,0:04:45.93,0:04:51.41,Caption,,0,0,0,,ПОЛКУ. ПОКА ВМЕСТО НЕЁ ПОЯВЛЯЕТСЯ ПОСТОЯННЫЙ ОФИС
Dialogue: 0,0:04:51.41,0:04:54.61,Caption,,0,0,0,,ЕВРОКОМИССИИ ПО САНКЦИЯМ. ОН ДОЛЖЕН РАЗРАБАТЫВАТЬ
Dialogue: 0,0:04:54.61,0:04:58.61,Caption,,0,0,0,,ОГРАНИЧЕНИЯ, СЛЕДИТЬ ЗА ИХ ИСПОЛНЕНИЕМ И БОРОТЬСЯ С ОБХОДОМ.
Dialogue: 0,0:05:00.89,0:05:02.97,Caption,,0,0,0,,САНКЦИИ СПОСОБНЫ ПРИЧИНЯТЬ УЩЕРБ,
Dialogue: 0,0:05:03.13,0:05:06.25,Caption,,0,0,0,,ОГРАНИЧИВАТЬ ТОРГОВЛЮ И ПОВЫШАТЬ ЦЕНУ РЕШЕНИЙ. НО
Dialogue: 0,0:05:06.25,0:05:08.41,Caption,,0,0,0,,САМИ ПО СЕБЕ ОНИ НЕ ОТВЕЧАЮТ НА ВОПРОС,
Dialogue: 0,0:05:08.65,0:05:11.77,Caption,,0,0,0,,ЧЕМ ДОЛЖНА ЗАКОНЧИТЬСЯ ВЫБРАННАЯ ЛИНИЯ. МОЛОТОК
Dialogue: 0,0:05:11.85,0:05:14.49,Caption,,0,0,0,,МОЖЕТ БЫТЬ ПРЕКРАСНЫМ. ОДНАКО ЕСЛИ ПЯТЬ ЛЕТ
Dialogue: 0,0:05:14.57,0:05:17.93,Caption,,0,0,0,,РАЗМАХИВАТЬ ИМ БЕЗ ЧЕРТЕЖА, ДОМ ОТ ЭТОГО НЕ ПОЯВЛЯЕТСЯ.
Dialogue: 0,0:05:20.22,0:05:23.10,Caption,,0,0,0,,У НАС ТУТ БИЗНЕС. ТРАМП РОССИЮ НЕ ПОЛЮБИЛ.
Dialogue: 0,0:05:23.42,0:05:25.50,Caption,,0,0,0,,У СОЕДИНЁННЫХ ШТАТОВ ОСТАЮТСЯ ДЕНЬГИ,
Dialogue: 0,0:05:25.58,0:05:31.18,Caption,,0,0,0,,РЕСУРСЫ, КИТАЙ, ВЛИЯНИЕ, ВОЕННЫЕ РАСХОДЫ И СДЕЛКИ. ОН ПРОСТО СЧИТАЕТ,
Dialogue: 0,0:05:31.34,0:05:33.58,Caption,,0,0,0,,ЧТО ДОГОВОРЁННОСТЬ ВЫГОДНЕЕ ПРОЦЕССА,
Dialogue: 0,0:05:33.74,0:05:36.14,Caption,,0,0,0,,КОТОРОМУ НИКТО НЕ НАЗНАЧИЛ ДАТУ ОКОНЧАНИЯ.
Dialogue: 0,0:05:38.43,0:05:40.43,Caption,,0,0,0,,А У ЧАСТИ ЕВРОПЕЙСКОГО РУКОВОДСТВА,
Dialogue: 0,0:05:40.51,0:05:44.75,Caption,,0,0,0,,ПОХОЖЕ, СОХРАНИЛСЯ ПРЕЖНИЙ ПЛАН В ОТНОШЕНИИ РОССИИ. ВОЕННОЕ
Dialogue: 0,0:05:44.75,0:05:48.75,Caption,,0,0,0,,ПОРАЖЕНИЕ, ОСЛАБЛЕНИЕ И В ИТОГЕ ДОСТУП К РОССИЙСКИМ РЕСУРСАМ
Dialogue: 0,0:05:48.83,0:05:51.95,Caption,,0,0,0,,НА ВЫГОДНЫХ ЗАПАДУ УСЛОВИЯХ. РАНЬШЕ ГЛАВНЫМ СИЛОВЫМ
Dialogue: 0,0:05:52.03,0:05:54.59,Caption,,0,0,0,,КОМПОНЕНТОМ ЭТОГО ПЛАНА БЫЛИ СОЕДИНЁННЫЕ ШТАТЫ.
Dialogue: 0,0:05:56.86,0:05:59.75,Caption,,0,0,0,,ПРИ ТРАМПЕ ОСНОВНОЙ КОМПОНЕНТ НАЧИНАЕТ ВЫПАДАТЬ.
Dialogue: 0,0:06:01.94,0:06:04.74,Caption,,0,0,0,,АМЕРИКАНСКАЯ ПОЗИЦИЯ ЧИТАЕТСЯ ПРИМЕРНО ТАК ХОТИТЕ
Dialogue: 0,0:06:04.74,0:06:07.14,Caption,,0,0,0,,ПРОДОЛЖАТЬ ПРЕЖНЮЮ ЛИНИЮ, ПРОДОЛЖАЙТЕ,
Dialogue: 0,0:06:07.26,0:06:09.70,Caption,,0,0,0,,ТОЛЬКО БЕЗ ПРИВЫЧКИ АВТОМАТИЧЕСКИ ВЫСТАВЛЯТЬ СЧЁТ
Dialogue: 0,0:06:09.70,0:06:12.90,Caption,,0,0,0,,ВАШИНГТОНУ. И ТУТ ЕВРОПЕЙСКАЯ УВЕРЕННОСТЬ ЗАМЕТНО
Dialogue: 0,0:06:12.90,0:06:16.42,Caption,,0,0,0,,МЕНЯЕТСЯ В ЛИЦЕ. ОДНО ДЕЛО ИЗОБРАЖАТЬ ЖЕЛЕЗНУЮ ВОЛЮ,
Dialogue: 0,0:06:16.59,0:06:19.46,Caption,,0,0,0,,КОГДА ЗА СПИНОЙ СТОИТ АМЕРИКАНСКАЯ АРМИЯ. ДРУГОЕ
Dialogue: 0,0:06:19.54,0:06:23.14,Caption,,0,0,0,,ДЕЛО УСЛЫШАТЬ, ЧТО ЖЕЛЕЗО ТЕПЕРЬ ПРИДЁТСЯ ПОКУПАТЬ САМОСТОЯТЕЛЬНО.
Dialogue: 0,0:06:25.43,0:06:28.31,Caption,,0,0,0,,ОТСЮДА ПОПЫТКИ ОДНОВРЕМЕННО УДЕРЖАТЬ США ВНУТРИ
Dialogue: 0,0:06:28.39,0:06:32.15,Caption,,0,0,0,,СТАРОЙ СХЕМЫ И НЕ ДОПУСТИТЬ, ЧТОБЫ ТРАМП ДОГОВОРИЛСЯ О НОВОЙ.
Dialogue: 0,0:06:34.41,0:06:36.89,Caption,,0,0,0,,ПОЛЬСКИЙ МИНИСТР РАДОСЛАВ СИКОРСКИЙ ПРИЗЫВАЕТ
Dialogue: 0,0:06:36.89,0:06:39.61,Caption,,0,0,0,,ПРЕЗИДЕНТА КАРОЛЯ НАВРОЦКОГО ИСПОЛЬЗОВАТЬ ОТНОШЕНИЯ
Dialogue: 0,0:06:39.69,0:06:42.41,Caption,,0,0,0,,С ТРАМПОМ И ВЛИЯТЬ НА АМЕРИКАНСКУЮ ПОЗИЦИЮ В
Dialogue: 0,0:06:42.49,0:06:46.41,Caption,,0,0,0,,ПОЛЬЗУ УКРАИНЫ. ПРАВИТЕЛЬСТВО ДОНАЛЬДА ТУСКА НЕ СОБИРАЕТСЯ ПРОСТО
Dialogue: 0,0:06:46.41,0:06:49.45,Caption,,0,0,0,,ПОВОРАЧИВАТЬ ВСЛЕД ЗА ВАШИНГТОНОМ. ВАРШАВА ХОЧЕТ
Dialogue: 0,0:06:49.45,0:06:52.25,Caption,,0,0,0,,ПОДТОЛКНУТЬ ВАШИНГТОН ОБРАТНО К ЕВРОПЕЙСКОЙ ЛИНИИ.
Dialogue: 0,0:06:54.53,0:06:58.77,Caption,,0,0,0,,СИКОРСКИЙ ДОБАВЛЯЕТ, ЧТО ВОПРОСЫ БЕЗОПАСНОСТИ ЕВРОПЫ НЕЛЬЗЯ ОБСУЖДАТЬ БЕЗ
Dialogue: 0,0:06:58.77,0:07:01.97,Caption,,0,0,0,,ВОСТОЧНОЙ ЕВРОПЫ. И ЗДЕСЬ ОН ПРАВ. ПОЛЬША И
Dialogue: 0,0:07:01.97,0:07:04.13,Caption,,0,0,0,,СТРАНЫ БАЛТИИ НАХОДЯТСЯ ИМЕННО ТАМ,
Dialogue: 0,0:07:04.45,0:07:07.17,Caption,,0,0,0,,ГДЕ ЛЮБЫЕ НОВЫЕ ВОЕННЫЕ ПРАВИЛА БУДУТ ОЩУЩАТЬСЯ
Dialogue: 0,0:07:07.17,0:07:13.45,Caption,,0,0,0,,ОСОБЕННО БЫСТРО. ПЕРЕГОВОРЫ НАЧИНАЮТСЯ НЕ С ОБЩЕГО ФОТОГРАФИРОВАНИЯ И
Dialogue: 0,0:07:13.53,0:07:16.73,Caption,,0,0,0,,НЕ С КОНКУРСА КРАСНЫХ ЛИНИЙ. НУЖЕН ПРЕДМЕТ СДЕЛКИ.
Dialogue: 0,0:07:19.00,0:07:22.52,Caption,,0,0,0,,КАКАЯ ВОЕННАЯ ИНФРАСТРУКТУРА ДОПУСТИМА. ГДЕ И КАКИЕ
Dialogue: 0,0:07:22.52,0:07:25.48,Caption,,0,0,0,,ВООРУЖЕНИЯ МОЖНО РАЗМЕЩАТЬ. КТО КОНТРОЛИРУЕТ
Dialogue: 0,0:07:25.56,0:07:28.76,Caption,,0,0,0,,ВЫПОЛНЕНИЕ УСЛОВИЙ. КАКИЕ ГАРАНТИИ ПОЛУЧАЕТ КАЖДАЯ
Dialogue: 0,0:07:28.76,0:07:32.60,Caption,,0,0,0,,СТОРОНА. ЧТО СЧИТАЕТСЯ НАРУШЕНИЕМ. КТО СВЯЗЫВАЕТСЯ С
Dialogue: 0,0:07:32.60,0:07:35.80,Caption,,0,0,0,,КЕМ ВО ВРЕМЯ КРИЗИСА. КАКИЕ ПОСЛЕДСТВИЯ НАСТУПАЮТ,
Dialogue: 0,0:07:35.96,0:07:42.57,Caption,,0,0,0,,ЕСЛИ ДОГОВОРЁННОСТЬ СОРВАНА. УКРАИНСКИЙ ВОПРОС ВНУТРИ ТАКОЙ КОНСТРУКЦИИ ОСТАЁТСЯ
Dialogue: 0,0:07:42.65,0:07:46.57,Caption,,0,0,0,,ЦЕНТРАЛЬНЫМ, НО НЕ ЕДИНСТВЕННЫМ. ДАЖЕ ЕСЛИ СТРЕЛЬБА ПРЕКРАТИТСЯ,
Dialogue: 0,0:07:46.82,0:07:51.05,Caption,,0,0,0,,РОССИЯ ОСТАНЕТСЯ В ЕВРОПЕ. НАТО ОСТАНЕТСЯ. УКРАИНА,
Dialogue: 0,0:07:51.18,0:07:54.65,Caption,,0,0,0,,ПОЛЬША, ЭСТОНИЯ И ЛИТВА ТОЖЕ НИКУДА НЕ ПЕРЕЕДУТ.
Dialogue: 0,0:07:56.86,0:07:59.90,Caption,,0,0,0,,ЗНАЧИТ, СОСЕДЯМ ПРИДЁТСЯ ЛИБО УСТАНОВИТЬ ПРАВИЛА,
Dialogue: 0,0:08:00.21,0:08:02.94,Caption,,0,0,0,,ЛИБО БЕСКОНЕЧНО ВООРУЖАТЬСЯ ПРОТИВ ВООРУЖЕНИЯ ДРУГ
Dialogue: 0,0:08:02.94,0:08:05.82,Caption,,0,0,0,,ДРУГА. ОДНА СТОРОНА УСИЛИВАЕТ ГРУППИРОВКУ,
Dialogue: 0,0:08:06.06,0:08:09.10,Caption,,0,0,0,,ПОТОМУ ЧТО БОИТСЯ ВТОРОЙ. ВТОРАЯ ВИДИТ УСИЛЕНИЕ И
Dialogue: 0,0:08:09.10,0:08:12.62,Caption,,0,0,0,,ОТВЕЧАЕТ СВОИМ. ПЕРВАЯ СМОТРИТ НА ОТВЕТ И ОБЪЯВЛЯЕТ,
Dialogue: 0,0:08:12.86,0:08:14.70,Caption,,0,0,0,,ЧТО ЕЁ ОПАСЕНИЯ ПОДТВЕРДИЛИСЬ.
Dialogue: 0,0:08:16.97,0:08:20.01,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ЕВРОПЕЙЦАМ СОВЕТУЮТ ДЕРЖАТЬ ДОМА ЗАПАС
Dialogue: 0,0:08:20.01,0:08:22.81,Caption,,0,0,0,,ВОДЫ, ЕДЫ, ЛЕКАРСТВ, НАЛИЧНЫХ,
Dialogue: 0,0:08:23.05,0:08:25.21,Caption,,0,0,0,,ФОНАРИ И РАДИО ХОТЯ БЫ НА ТРОЕ СУТОК.
Dialogue: 0,0:08:25.53,0:08:29.37,Caption,,0,0,0,,ДЛЯ АВАРИЙ, ОТКЛЮЧЕНИЙ И КИБЕРАТАК ТАКАЯ ПОДГОТОВКА РАЗУМНА.
Dialogue: 0,0:08:31.65,0:08:33.33,Caption,,0,0,0,,ТО ЕСТЬ РУКОВОДИТЕЛИ ПОКА НЕ ЗНАЮТ,
Dialogue: 0,0:08:33.49,0:08:37.09,Caption,,0,0,0,,КАК ЗАВЕРШИТЬ ПРОТИВОСТОЯНИЕ, ЗАТО ГРАЖДАНАМ УЖЕ РАССКАЗАЛИ,
Dialogue: 0,0:08:37.17,0:08:41.20,Caption,,0,0,0,,ГДЕ ЛЕЖАТ БАТАРЕЙКИ. МУЖИКИ,
Dialogue: 0,0:08:41.34,0:08:46.45,Caption,,0,0,0,,А КУДА ЕДЕМ ТО? ЕСЛИ ХОТИТЕ БОЛЬШЕ ТАКИХ РАЗБОРОВ,
Dialogue: 0,0:08:46.58,0:08:48.85,Caption,,0,0,0,,ПОДПИШИТЕСЬ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:08:49.08,0:08:51.89,Caption,,0,0,0,,КАКОЙ РЕЗУЛЬТАТ НЫНЕШНЕЙ ЕВРОПЕЙСКОЙ ЛИНИИ ВИДИТЕ
Dialogue: 0,0:08:51.97,0:08:57.28,Caption,,0,0,0,,ВЫ. ФИНЛЯНДИЯ ТЕМ ВРЕМЕНЕМ ГОТОВИТ НОВЫЕ ОГРАНИЧЕНИЯ НА
Dialogue: 0,0:08:57.28,0:09:00.00,Caption,,0,0,0,,ВЪЕЗД ГРАЖДАН РОССИИ. ПОД НИХ МОГУТ ПОПАСТЬ
Dialogue: 0,0:09:00.00,0:09:04.29,Caption,,0,0,0,,ПРОФЕССИОНАЛЬНЫЕ СПОРТСМЕНЫ. ХОРОШО,
Dialogue: 0,0:09:04.37,0:09:07.17,Caption,,0,0,0,,СПОРТСМЕНА НЕ ПУСТИЛИ. ЧТО ИЗМЕНИЛОСЬ В ВОЕННОМ
Dialogue: 0,0:09:07.17,0:09:09.57,Caption,,0,0,0,,БАЛАНСЕ? КАК ЭТО ПРИБЛИЗИЛО СОГЛАШЕНИЕ?
Dialogue: 0,0:09:09.66,0:09:13.78,Caption,,0,0,0,,КАКОЙ РИСК ИСЧЕЗ? ОТВЕТА НЕТ,
Dialogue: 0,0:09:14.01,0:09:16.42,Caption,,0,0,0,,ЗАТО МЕРА ВЫГЛЯДИТ РЕШИТЕЛЬНОЙ. А КОГДА НЕ
Dialogue: 0,0:09:16.42,0:09:18.58,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ПОКАЗАТЬ КОНЕЧНЫЙ РЕЗУЛЬТАТ,
Dialogue: 0,0:09:18.88,0:09:21.78,Caption,,0,0,0,,ВСЕГДА МОЖНО ПОКАЗАТЬ ЕЩЁ ОДИН ЗАКРЫТЫЙ ШЛАГБАУМ.
Dialogue: 0,0:09:24.05,0:09:26.53,Caption,,0,0,0,,ИМЕННО ЦЕЛЬ СЕЙЧАС ПРЯЧЕТСЯ ЛУЧШЕ ВСЕГО.
Dialogue: 0,0:09:28.81,0:09:32.09,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ЖЁСТКОСТЬ ИМЕЕТ ПОНЯТНЫЕ ПРИЧИНЫ. СТРАНЫ
Dialogue: 0,0:09:32.17,0:09:35.53,Caption,,0,0,0,,БАЛТИИ СЧИТАЮТ РОССИЮ УГРОЗОЙ. ПОЛЬША СМОТРИТ НА НЕЁ
Dialogue: 0,0:09:35.61,0:09:38.41,Caption,,0,0,0,,ЧЕРЕЗ СОБСТВЕННУЮ ИСТОРИЮ. УКРАИНА НАХОДИТСЯ В
Dialogue: 0,0:09:38.49,0:09:41.61,Caption,,0,0,0,,КОНФЛИКТЕ И БОИТСЯ СДЕЛКИ, ЗАКЛЮЧЁННОЙ ЗА ЕЁ СПИНОЙ.
Dialogue: 0,0:09:43.88,0:09:46.20,Caption,,0,0,0,,НО ЭТИ ПРИЧИНЫ КАК РАЗ И ДЕЛАЮТ ПЕРЕГОВОРЫ
Dialogue: 0,0:09:46.20,0:09:50.88,Caption,,0,0,0,,НЕОБХОДИМЫМИ. ЗА СТОЛ САДЯТСЯ НЕ ПОТОМУ,
Dialogue: 0,0:09:51.08,0:09:53.76,Caption,,0,0,0,,ЧТО ВСЕМ ПРИЯТНО ДРУГ ДРУГА ВИДЕТЬ. ДЛЯ ПРИЯТНЫХ
Dialogue: 0,0:09:53.76,0:09:56.96,Caption,,0,0,0,,ВСТРЕЧ СУЩЕСТВУЮТ ДНИ РОЖДЕНИЯ. ПЕРЕГОВОРНЫЙ СТОЛ
Dialogue: 0,0:09:57.04,0:09:59.36,Caption,,0,0,0,,НУЖЕН ТЕМ, КТО НЕ ДОВЕРЯЕТ СОСЕДУ,
Dialogue: 0,0:09:59.53,0:10:02.72,Caption,,0,0,0,,ОПАСАЕТСЯ ЕГО АРМИИ И ХОЧЕТ ЗАКРЕПИТЬ ОГРАНИЧЕНИЯ,
Dialogue: 0,0:10:02.96,0:10:08.77,Caption,,0,0,0,,КОТОРЫЕ МОЖНО ПРОВЕРИТЬ. ЕВРОПА НЕ ОБЯЗАНА ПРИНИМАТЬ АМЕРИКАНСКОЕ
Dialogue: 0,0:10:08.77,0:10:12.13,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ. ОНА МОЖЕТ ВЫДВИНУТЬ СОБСТВЕННОЕ. ТОЛЬКО
Dialogue: 0,0:10:12.21,0:10:14.69,Caption,,0,0,0,,В НЁМ ДОЛЖНЫ БЫТЬ УСЛОВИЯ, ГАРАНТИИ,
Dialogue: 0,0:10:14.78,0:10:18.29,Caption,,0,0,0,,КОНТРОЛЬ И МОМЕНТ, КОГДА ДАВЛЕНИЕ ПРЕКРАЩАЕТСЯ.
Dialogue: 0,0:10:20.55,0:10:23.83,Caption,,0,0,0,,ФРАЗА "ДАВИТЬ ЕЩЁ СИЛЬНЕЕ" ПЛАНОМ НЕ ЯВЛЯЕТСЯ. ЭТО
Dialogue: 0,0:10:23.91,0:10:26.79,Caption,,0,0,0,,ПОЛОЖЕНИЕ РЕГУЛЯТОРА ГРОМКОСТИ. КРУТИТЬ ЕГО МОЖНО
Dialogue: 0,0:10:26.79,0:10:29.19,Caption,,0,0,0,,ДОЛГО, ПОКА РУЧКА НЕ ОСТАНЕТСЯ В РУКАХ.
Dialogue: 0,0:10:31.47,0:10:34.35,Caption,,0,0,0,,РОССИЯ НЕ ИСЧЕЗЛА ПОСЛЕ ПРЕЖНИХ ПАКЕТОВ САНКЦИЙ.
Dialogue: 0,0:10:34.59,0:10:37.71,Caption,,0,0,0,,КОНФЛИКТ НЕ ЗАВЕРШИЛСЯ. АМЕРИКАНСКАЯ АДМИНИСТРАЦИЯ
Dialogue: 0,0:10:37.79,0:10:40.27,Caption,,0,0,0,,ТЕПЕРЬ ОЦЕНИВАЕТ ПРОДОЛЖЕНИЕ ЭТОЙ ЛИНИИ ИНАЧЕ.
Dialogue: 0,0:10:40.56,0:10:44.19,Caption,,0,0,0,,СЛЕДОВАТЕЛЬНО, ЕВРОПЕЙСКИМ СТОРОННИКАМ ПРЕЖНЕГО КУРСА ПРИДЁТСЯ
Dialogue: 0,0:10:44.19,0:10:48.11,Caption,,0,0,0,,ОБЪЯСНИТЬ, КАКИМИ СИЛАМИ ОНИ СОБИРАЮТСЯ ЕГО ПОДДЕРЖИВАТЬ И РАДИ
Dialogue: 0,0:10:48.19,0:10:54.63,Caption,,0,0,0,,КАКОГО ИТОГА. СНОВА ВОЗНИКАЕТ ВОПРОС ПРО ДИВИЗИИ. НЕ ДЛЯ НАСМЕШКИ
Dialogue: 0,0:10:54.71,0:10:59.51,Caption,,0,0,0,,НАД МАЛЕНЬКИМИ ГОСУДАРСТВАМИ, А ДЛЯ ПРОВЕРКИ РЕАЛЬНОСТИ. ЛЮБАЯ ЖЁСТКАЯ ЛИНИЯ
Dialogue: 0,0:10:59.51,0:11:01.75,Caption,,0,0,0,,ОПИРАЕТСЯ НА АРМИЮ, ЭКОНОМИКУ,
Dialogue: 0,0:11:01.83,0:11:05.75,Caption,,0,0,0,,РЕСУРСЫ И ГОТОВНОСТЬ ОБЩЕСТВА ПЛАТИТЬ. ЕСЛИ КЛЮЧЕВАЯ
Dialogue: 0,0:11:05.75,0:11:07.91,Caption,,0,0,0,,АМЕРИКАНСКАЯ ОПОРА ОТХОДИТ В СТОРОНУ,
Dialogue: 0,0:11:08.15,0:11:10.95,Caption,,0,0,0,,ГРОМКОСТЬ ЭСТОНСКОГО ЗАЯВЛЕНИЯ НЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:11:10.95,0:11:14.67,Caption,,0,0,0,,АВИАНОСЕЦ. КТО ПЛАТИТ?
Dialogue: 0,0:11:14.89,0:11:17.55,Caption,,0,0,0,,КТО ВОЮЕТ? СКОЛЬКО ЛЕТ ПРОДОЛЖАЕТСЯ КУРС?
Dialogue: 0,0:11:17.78,0:11:21.55,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ, ЕСЛИ РОССИЯ НЕ ПРИНИМАЕТ НАВЯЗАННЫЕ УСЛОВИЯ?
Dialogue: 0,0:11:21.83,0:11:28.47,Caption,,0,0,0,,ГДЕ ГРАНИЦА ПОВЫШЕНИЯ СТАВОК? БЕЗ ЭТИХ ОТВЕТОВ ПОЛУЧАЕТСЯ НЕ СТРАТЕГИЯ,
Dialogue: 0,0:11:28.63,0:11:35.40,Caption,,0,0,0,,А ПОДПИСКА БЕЗ КНОПКИ ОТМЕНЫ. ТРАМП ПРЕДЛАГАЕТ ПЕРЕЙТИ ОТ БЕСКОНЕЧНОГО ПРОДЛЕНИЯ
Dialogue: 0,0:11:35.40,0:11:38.52,Caption,,0,0,0,,ПОДПИСКИ К ТОРГУ О ПРАВИЛАХ. ЕГО УСЛОВИЯ ЕВРОПЕ
Dialogue: 0,0:11:38.60,0:11:41.56,Caption,,0,0,0,,МОГУТ НЕ ПОНРАВИТЬСЯ. УКРАИНА УВИДИТ В НИХ УГРОЗУ
Dialogue: 0,0:11:41.64,0:11:44.44,Caption,,0,0,0,,ДЛЯ СЕБЯ. ПОЛЬША И СТРАНЫ БАЛТИИ ПОТРЕБУЮТ
Dialogue: 0,0:11:44.44,0:11:46.92,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫХ ГАРАНТИЙ. ДЛЯ ЭТОГО И НУЖНЫ
Dialogue: 0,0:11:46.92,0:11:50.44,Caption,,0,0,0,,ПЕРЕГОВОРЫ, ГДЕ КАЖДОЕ ВОЗРАЖЕНИЕ ПРЕВРАЩАЕТСЯ В УСЛОВИЕ,
Dialogue: 0,0:11:50.60,0:11:57.03,Caption,,0,0,0,,А НЕ В ОЧЕРЕДНОЕ ИНТЕРВЬЮ. ПОКА ЖЕ ЕВРОПЕЙСКАЯ ДИСКУССИЯ ВСЁ ЧАЩЕ СВОДИТСЯ К
Dialogue: 0,0:11:57.03,0:12:00.31,Caption,,0,0,0,,ЗАЩИТЕ САМОЙ ВОЗМОЖНОСТИ ПРОДОЛЖАТЬ ДАВЛЕНИЕ. БУДТО
Dialogue: 0,0:12:00.31,0:12:02.87,Caption,,0,0,0,,ПРИЗНАТЬ НЕОБХОДИМОСТЬ ИНОЙ СИСТЕМЫ ОЗНАЧАЕТ
Dialogue: 0,0:12:02.95,0:12:09.38,Caption,,0,0,0,,ПРИЗНАТЬ ЧЬЮ ТО ПОБЕДУ. НА САМОМ ДЕЛЕ ПРИЗНАТЬ ПРИХОДИТСЯ ДРУГОЕ. СТАРАЯ
Dialogue: 0,0:12:09.38,0:12:12.42,Caption,,0,0,0,,СИСТЕМА НЕ ПРЕДОТВРАТИЛА НЫНЕШНИЙ КОНФЛИКТ. ЭТО УЖЕ
Dialogue: 0,0:12:12.50,0:12:14.82,Caption,,0,0,0,,ПРОИЗОШЛО. ТАБЛИЧКА НАТО НА ДВЕРИ,
Dialogue: 0,0:12:15.14,0:12:17.54,Caption,,0,0,0,,ДОЛЖНОСТЬ КАЛЛАС И НОВЫЙ КАБИНЕТ САНКЦИОННОГО
Dialogue: 0,0:12:17.54,0:12:19.78,Caption,,0,0,0,,ЧИНОВНИКА НЕ МОГУТ ОТМЕНИТЬ ЭТОТ ФАКТ.
Dialogue: 0,0:12:22.08,0:12:25.04,Caption,,0,0,0,,РАЗГОВОР О ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ НЕ ДАР МОСКВЕ.
Dialogue: 0,0:12:25.36,0:12:30.16,Caption,,0,0,0,,ЭТО ПОПЫТКА УБРАТЬ СИТУАЦИЮ, В КОТОРОЙ БЕЗОПАСНОСТЬ КАЖДОЙ СТОРОНЫ ДОКАЗЫВАЕТСЯ
Dialogue: 0,0:12:30.24,0:12:34.84,Caption,,0,0,0,,КОЛИЧЕСТВОМ УГРОЗ ДЛЯ ДРУГОЙ. АМЕРИКА,
Dialogue: 0,0:12:34.95,0:12:38.52,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, БОЛЬШЕ НЕ ХОЧЕТ БЫТЬ ГЛАВНЫМ ДВИГАТЕЛЕМ СТАРОГО
Dialogue: 0,0:12:38.60,0:12:40.60,Caption,,0,0,0,,ПЛАНА И ОДНОВРЕМЕННО ЕГО КАССОЙ,
Dialogue: 0,0:12:40.76,0:12:44.44,Caption,,0,0,0,,СКЛАДОМ И СЛУЖБОЙ ДОСТАВКИ. ЕВРОПЕ ПРЕДЛАГАЮТ ВЫБОР.
Dialogue: 0,0:12:44.76,0:12:47.16,Caption,,0,0,0,,ЛИБО УЧАСТВОВАТЬ В ВЫРАБОТКЕ НОВЫХ ПРАВИЛ,
Dialogue: 0,0:12:47.40,0:12:49.96,Caption,,0,0,0,,ЛИБО ПРОДОЛЖАТЬ ПРЕЖНЮЮ ЛИНИЮ СВОИМИ СИЛАМИ.
Dialogue: 0,0:12:52.25,0:12:54.81,Caption,,0,0,0,,ВОТ ЗДЕСЬ ЗАКАНЧИВАЕТСЯ УДОБНАЯ РИТОРИКА И
Dialogue: 0,0:12:54.81,0:13:01.64,Caption,,0,0,0,,НАЧИНАЕТСЯ БУХГАЛТЕРИЯ. СТОЛ МОЖНО ОТВЕРГНУТЬ. СТУЛЬЯ МОЖНО ДЕМОНСТРАТИВНО
Dialogue: 0,0:13:01.64,0:13:05.24,Caption,,0,0,0,,ОТОДВИНУТЬ. ПОСРЕДНИКА МОЖНО НАЗВАТЬ НЕНУЖНЫМ. ЕЩЁ
Dialogue: 0,0:13:05.24,0:13:07.48,Caption,,0,0,0,,ОДИН ПАКЕТ ОГРАНИЧЕНИЙ ТОЖЕ НАЙДЁТСЯ,
Dialogue: 0,0:13:07.63,0:13:13.50,Caption,,0,0,0,,ОФИС ТЕПЕРЬ ПОСТОЯННЫЙ. НО ПОСЛЕ ВСЕХ РЕЧЕЙ ОСТАЁТСЯ ВОПРОС,
Dialogue: 0,0:13:13.74,0:13:15.74,Caption,,0,0,0,,ОТ КОТОРОГО НЕ СПРЯТАТЬСЯ НИ ЗА КАЛЛАС,
Dialogue: 0,0:13:15.98,0:13:18.70,Caption,,0,0,0,,НИ ЗА СИКОРСКОГО, НИ ЗА ХОККЕИСТА НА ГРАНИЦЕ.
Dialogue: 0,0:13:20.96,0:13:23.06,Caption,,0,0,0,,КАКОГО РЕЗУЛЬТАТА ВЫ ХОТИТЕ ДОБИТЬСЯ?
Dialogue: 0,0:13:25.34,0:13:29.90,Caption,,0,0,0,,ЕСЛИ ОТВЕТА НЕТ, ЕВРОПА ЗАЩИЩАЕТ УЖЕ НЕ ПЛАН ПОБЕДЫ. ОНА ЗАЩИЩАЕТ
Dialogue: 0,0:13:29.90,0:13:33.82,Caption,,0,0,0,,ПРАВО НЕ ПРИЗНАВАТЬ, ЧТО ПРЕЖНИЙ ПЛАН ОСТАЛСЯ БЕЗ СВОЕГО ГЛАВНОГО
Dialogue: 0,0:13:33.82,0:13:34.46,Caption,,0,0,0,,УЧАСТНИКА.
