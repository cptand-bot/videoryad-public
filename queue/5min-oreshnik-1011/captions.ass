Dialogue: 0,0:00:00.12,0:00:05.00,Caption,,0,0,0,,ТРИ ИСПЫТАНИЯ, КОСМОС, ПЕРЕХВАТ "ОРЕШНИКА". ЗВУЧИТ СОЛИДНО. ПРЯМО
Dialogue: 0,0:00:05.00,0:00:08.36,Caption,,0,0,0,,ЧУВСТВУЕТСЯ, ЧТО СТУДИЯ ПЯТЫЙ КВАРТАЛ ПРОДОЛЖАЕТ РАБОТУ,
Dialogue: 0,0:00:08.60,0:00:11.24,Caption,,0,0,0,,ТОЛЬКО БЮДЖЕТЫ У НОВОГО СЕЗОНА УЖЕ СОВСЕМ ДРУГИЕ.
Dialogue: 0,0:00:11.64,0:00:15.24,Caption,,0,0,0,,И ЕСЛИ ВЫ ДУМАЕТЕ, ЧТО НА ЭТОМ ТВОРЧЕСКИЙ ПОТЕНЦИАЛ КОМЕДИЙНОЙ СТУДИИ
Dialogue: 0,0:00:15.24,0:00:18.76,Caption,,0,0,0,,ЗАКОНЧИЛСЯ, ТО ЗРЯ. ТАМ ДАЛЬШЕ ТАКИЕ РЕШЕНИЯ ПОШЛИ,
Dialogue: 0,0:00:18.93,0:00:21.48,Caption,,0,0,0,,ЧТО "ОРЕШНИК" ЕЩЁ ПОКАЖЕТСЯ САМОЙ ПРИЗЕМЛЁННОЙ
Dialogue: 0,0:00:21.48,0:00:24.04,Caption,,0,0,0,,ЧАСТЬЮ ПРОГРАММЫ. ПРИЧЁМ ВСЁ ЭТО УЖЕ НЕ ГДЕ
Dialogue: 0,0:00:24.12,0:00:28.04,Caption,,0,0,0,,ТО В ДАЛЁКОМ КОСМОСЕ, А БУКВАЛЬНО ПОД НАШИМИ НОГАМИ. ВОТ ДАВАЙТЕ
Dialogue: 0,0:00:28.04,0:00:31.08,Caption,,0,0,0,,ПОСМОТРИМ, ЧЕМ ЕЩЁ НАС РЕШИЛИ УДИВИТЬ. КСТАТИ,
Dialogue: 0,0:00:31.24,0:00:34.04,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ЕСЛИ ТАКИМИ ТЕМПАМИ ПОЙДЁТ
Dialogue: 0,0:00:34.04,0:00:37.48,Caption,,0,0,0,,ДАЛЬШЕ, СКОРО БЕЗ ПОДПИСКИ ВООБЩЕ НЕВОЗМОЖНО БУДЕТ УСЛЕДИТЬ,
Dialogue: 0,0:00:37.64,0:00:39.48,Caption,,0,0,0,,КОГО МЫ УЖЕ СБИВАЕМ В КОСМОСЕ,
Dialogue: 0,0:00:39.64,0:00:41.96,Caption,,0,0,0,,А КОГО ПОКА ТОЛЬКО СОБИРАЕМСЯ. ИТАК,
Dialogue: 0,0:00:42.12,0:00:44.68,Caption,,0,0,0,,УКРАИНА ЗАЯВЛЯЕТ, ЧТО ИСПЫТЫВАЕТ СИСТЕМУ,
Dialogue: 0,0:00:44.92,0:00:47.56,Caption,,0,0,0,,КОТОРАЯ ДОЛЖНА ПЕРЕХВАТЫВАТЬ РОССИЙСКИЙ "ОРЕШНИК" ЗА
Dialogue: 0,0:00:47.56,0:00:50.28,Caption,,0,0,0,,ПРЕДЕЛАМИ АТМОСФЕРЫ. СООБЩАЕТСЯ УЖЕ О ТРЁХ
Dialogue: 0,0:00:50.28,0:00:53.40,Caption,,0,0,0,,ИСПЫТАНИЯХ. ГЛАВНАЯ ЦЕЛЬ ПОНЯТНА. РАКЕТА УХОДИТ
Dialogue: 0,0:00:53.40,0:00:57.08,Caption,,0,0,0,,ВЫСОКО, ТАМ ЕЁ И ХОТЯТ ЛОВИТЬ. КРАСИВО. ДО ЭТОГО
Dialogue: 0,0:00:57.16,0:00:59.24,Caption,,0,0,0,,МЫ КАК ТО ВСЁ ПО СТАРИНКЕ ЖИЛИ. РАКЕТА
Dialogue: 0,0:00:59.24,0:01:01.72,Caption,,0,0,0,,ЛЕТИТ, ПРОТИВОРАКЕТА ЛЕТИТ ЕЙ НАВСТРЕЧУ,
Dialogue: 0,0:01:01.96,0:01:06.20,Caption,,0,0,0,,РАДАРЫ ЧТО ТО ИЩУТ, ГЕНЕРАЛЫ СМОТРЯТ НА ЭКРАНЫ. А ТЕПЕРЬ МАСШТАБ УЖЕ
Dialogue: 0,0:01:06.20,0:01:09.40,Caption,,0,0,0,,ДРУГОЙ. КОСМОС. ЧУТЬ ЛИ НЕ МЕЖПЛАНЕТНЫЙ УРОВЕНЬ.
Dialogue: 0,0:01:11.58,0:01:14.23,Caption,,0,0,0,,ЕЩЁ НЕМНОГО, И МОЖНО БУДЕТ СПОКОЙНО ОБЪЯВЛЯТЬ,
Dialogue: 0,0:01:14.48,0:01:16.87,Caption,,0,0,0,,ЧТО СЛЕДУЮЩАЯ ЗАДАЧА УКРАИНСКОГО ВПК,
Dialogue: 0,0:01:17.11,0:01:20.15,Caption,,0,0,0,,ЭТО ПЕРЕХВАТ ЗВЕЗДЫ СМЕРТИ. НУ А ЧТО. ЕСЛИ
Dialogue: 0,0:01:20.23,0:01:24.23,Caption,,0,0,0,,УЖ ПОШЛИ ВВЕРХ, ЗАЧЕМ МЕЛОЧИТЬСЯ. ТОЛЬКО У ЭТОЙ КРАСИВОЙ КОСМИЧЕСКОЙ
Dialogue: 0,0:01:24.31,0:01:27.27,Caption,,0,0,0,,ИСТОРИИ ЕСТЬ ОДНА ЗЕМНАЯ ОСОБЕННОСТЬ. ВСЁ ЭТО НАДО
Dialogue: 0,0:01:27.27,0:01:30.15,Caption,,0,0,0,,ЧЕМ ТО ЗАПУСКАТЬ. ЧЕМ ТО НАВОДИТЬ. ЧЕМ ТО
Dialogue: 0,0:01:30.15,0:01:33.51,Caption,,0,0,0,,ОБНАРУЖИВАТЬ. ГДЕ ТО ПРОИЗВОДИТЬ. ГДЕ ТО ИСПЫТЫВАТЬ.
Dialogue: 0,0:01:33.73,0:01:36.55,Caption,,0,0,0,,НУЖНЫ ЛЮДИ, ЗАВОДЫ, ЭЛЕКТРОНИКА,
Dialogue: 0,0:01:36.63,0:01:40.07,Caption,,0,0,0,,ДЕНЬГИ, ЕЩЁ ДЕНЬГИ, ПОТОМ ЕЩЁ НЕМНОГО ДЕНЕГ,
Dialogue: 0,0:01:40.31,0:01:42.07,Caption,,0,0,0,,А ПОСЛЕ ЭТОГО ОБЫЧНО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:01:42.31,0:01:44.71,Caption,,0,0,0,,ЧТО ДЕНЬГИ ОПЯТЬ НУЖНЫ. И ВОТ ЗДЕСЬ ПРОЕКТ
Dialogue: 0,0:01:44.79,0:01:47.35,Caption,,0,0,0,,СТАНОВИТСЯ ПРОСТО СКАЗОЧНО УДОБНЫМ. ПОТОМУ ЧТО
Dialogue: 0,0:01:47.43,0:01:50.47,Caption,,0,0,0,,РЕЗУЛЬТАТ МОЖНО ОБЕЩАТЬ ДАЛЕКО ВПЕРЕДИ. СЕГОДНЯ ВЫ
Dialogue: 0,0:01:50.47,0:01:53.35,Caption,,0,0,0,,ВЫДЕЛЯЕТЕ ДЕНЬГИ. ЗАВТРА ЕЩЁ ДЕНЬГИ. ПОТОМ
Dialogue: 0,0:01:53.35,0:01:56.87,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО НУЖЕН НОВЫЙ ЭТАП ИСПЫТАНИЙ. ПОТОМ НОВЫЙ
Dialogue: 0,0:01:56.87,0:02:00.47,Caption,,0,0,0,,ДВИГАТЕЛЬ. ПОТОМ НОВАЯ СИСТЕМА НАВЕДЕНИЯ. ПОТОМ ЕЩЁ
Dialogue: 0,0:02:00.47,0:02:03.83,Caption,,0,0,0,,ОДИН НАУЧНЫЙ ЦЕНТР. ПОТОМ МЕЖДУНАРОДНАЯ КООПЕРАЦИЯ.
Dialogue: 0,0:02:04.07,0:02:06.31,Caption,,0,0,0,,ПОТОМ СРОЧНО ТРЕБУЕТСЯ ДОПОЛНИТЕЛЬНОЕ
Dialogue: 0,0:02:06.31,0:02:08.87,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ. А ЕСЛИ КТО ТО СПРАШИВАЕТ,
Dialogue: 0,0:02:08.95,0:02:14.07,Caption,,0,0,0,,ГДЕ ГОТОВАЯ СИСТЕМА, ОТВЕТ ПРЕКРАСНЫЙ. РАБОТА ИДЁТ. ЗАДАЧА УНИКАЛЬНАЯ.
Dialogue: 0,0:02:14.31,0:02:16.39,Caption,,0,0,0,,ТЕХНОЛОГИЯ СЛОЖНЕЙШАЯ. КОСМОС,
Dialogue: 0,0:02:16.54,0:02:19.43,Caption,,0,0,0,,ПОНИМАЕТЕ ЛИ. НА ОБЫЧНОМ АВТОБУСЕ ДАЛЕКО НЕ УЕДЕШЬ.
Dialogue: 0,0:02:19.65,0:02:22.71,Caption,,0,0,0,,А ТУТ КОСМОС. ИМЕННО ПОЭТОМУ ВСЯ ЭТА ИСТОРИЯ
Dialogue: 0,0:02:22.79,0:02:25.35,Caption,,0,0,0,,ВЫГЛЯДИТ КАК МЕЧТА ЛЮБОГО БОЛЬШОГО БЮДЖЕТНОГО
Dialogue: 0,0:02:25.35,0:02:29.22,Caption,,0,0,0,,ПРОЕКТА. ЧЕМ СЛОЖНЕЕ ВЕЩЬ,
Dialogue: 0,0:02:29.38,0:02:32.18,Caption,,0,0,0,,ЧЕМ ДАЛЬШЕ РЕЗУЛЬТАТ И ЧЕМ МЕНЬШЕ ОБЫЧНЫЙ ЧЕЛОВЕК
Dialogue: 0,0:02:32.18,0:02:34.42,Caption,,0,0,0,,ПОНИМАЕТ, КАК ЭТО ВООБЩЕ ДОЛЖНО РАБОТАТЬ,
Dialogue: 0,0:02:34.75,0:02:39.46,Caption,,0,0,0,,ТЕМ ЛЕГЧЕ ОБЪЯСНЯТЬ, ПОЧЕМУ НУЖНО ЕЩЁ НЕМНОГО ДЕНЕГ. ДЛЯ БУДУЩЕГО РАСПИЛА
Dialogue: 0,0:02:39.46,0:02:42.50,Caption,,0,0,0,,БЮДЖЕТА СХЕМА ПОЧТИ ИДЕАЛЬНАЯ. ДЕНЬГИ ВЫДЕЛЯЮТ
Dialogue: 0,0:02:42.50,0:02:46.58,Caption,,0,0,0,,СЕГОДНЯ, А ГОТОВУЮ СИСТЕМУ МОЖНО ОБЕЩАТЬ ГОДАМИ. ПРИЧЁМ ШУМ
Dialogue: 0,0:02:46.58,0:02:49.78,Caption,,0,0,0,,УЖЕ ЕСТЬ. ЗАГОЛОВОК ПРЕКРАСНЫЙ. "ОРЕШНИК" БУДУТ
Dialogue: 0,0:02:49.78,0:02:52.90,Caption,,0,0,0,,СБИВАТЬ В КОСМОСЕ. ВСЁ. ПОЛОВИНА РАБОТЫ СДЕЛАНА.
Dialogue: 0,0:02:53.13,0:02:56.50,Caption,,0,0,0,,ПРОЕКТ УЖЕ ЗВУЧИТ ТАК, БУДТО ЗАВТРА ГДЕ ТО ОТКРОЕТСЯ ЛЮК,
Dialogue: 0,0:02:56.80,0:02:59.54,Caption,,0,0,0,,ОТТУДА ВЫЙДЕТ УКРАИНСКИЙ ЛЮК СКАЙУОКЕР И СПРОСИТ,
Dialogue: 0,0:02:59.70,0:03:02.90,Caption,,0,0,0,,КУДА ТУТ СТРЕЛЯТЬ. А ДАЛЬШЕ РАЗБЕРЁМСЯ. НО КОСМОС
Dialogue: 0,0:03:02.90,0:03:06.50,Caption,,0,0,0,,КОСМОСОМ, А НА ЗЕМЛЕ ТОЖЕ РЕШИЛИ НЕ СКУЧАТЬ. УКРАИНСКИМ
Dialogue: 0,0:03:06.58,0:03:09.30,Caption,,0,0,0,,ЧАСТНЫМ КОМПАНИЯМ РАСШИРИЛИ ВОЗМОЖНОСТИ СОБСТВЕННОЙ
Dialogue: 0,0:03:09.30,0:03:12.34,Caption,,0,0,0,,ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ. ТЕПЕРЬ ТАКИЕ ГРУППЫ СМОГУТ
Dialogue: 0,0:03:12.42,0:03:14.34,Caption,,0,0,0,,ЗАЩИЩАТЬ НЕ ТОЛЬКО СВОЁ ПРЕДПРИЯТИЕ,
Dialogue: 0,0:03:14.58,0:03:17.38,Caption,,0,0,0,,НО И ЧУЖИЕ ОБЪЕКТЫ ПО ДОГОВОРУ. РАЗРЕШАЕТСЯ
Dialogue: 0,0:03:17.38,0:03:20.02,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ ПИЛОТИРУЕМЫЕ САМОЛЁТЫ. ВОЗРАСТ
Dialogue: 0,0:03:20.02,0:03:22.98,Caption,,0,0,0,,УЧАСТНИКОВ СНИЗИЛИ ДО ВОСЕМНАДЦАТИ ЛЕТ. К ПРОЕКТУ
Dialogue: 0,0:03:22.98,0:03:26.02,Caption,,0,0,0,,УЖЕ ПРИСОЕДИНИЛОСЬ ОКОЛО СТА ПРЕДПРИЯТИЙ. ВОТ ЗДЕСЬ
Dialogue: 0,0:03:26.02,0:03:29.38,Caption,,0,0,0,,НАЧИНАЕТСЯ НАСТОЯЩЕЕ ВЕСЕЛЬЕ. САМА ИДЕЯ ПОНЯТНА.
Dialogue: 0,0:03:29.69,0:03:32.50,Caption,,0,0,0,,АРМИЯ ФИЗИЧЕСКИ НЕ МОЖЕТ ПОСТАВИТЬ ПОЛНОЦЕННУЮ ПВО
Dialogue: 0,0:03:32.50,0:03:35.22,Caption,,0,0,0,,ВОЗЛЕ КАЖДОГО ЗАВОДА, КАЖДОГО СКЛАДА,
Dialogue: 0,0:03:35.44,0:03:37.62,Caption,,0,0,0,,КАЖДОЙ ЭЛЕКТРОСТАНЦИИ И КАЖДОГО БОЛЬШОГО
Dialogue: 0,0:03:37.62,0:03:42.26,Caption,,0,0,0,,ПРЕДПРИЯТИЯ. ЗНАЧИТ, ЧАСТЬ НАГРУЗКИ ПЫТАЮТСЯ ПЕРЕЛОЖИТЬ НА САМ БИЗНЕС.
Dialogue: 0,0:03:44.46,0:03:48.30,Caption,,0,0,0,,В РОССИИ, КСТАТИ, ПОХОЖАЯ ЛОГИКА ТОЖЕ РАЗВИВАЕТСЯ. ПРЕДПРИЯТИЯ
Dialogue: 0,0:03:48.30,0:03:50.30,Caption,,0,0,0,,ПОДКЛЮЧАЮТ К ЗАЩИТЕ СВОИХ ОБЪЕКТОВ,
Dialogue: 0,0:03:50.62,0:03:55.74,Caption,,0,0,0,,ЗАКУПАЮТ ОБОРУДОВАНИЕ, ФОРМИРУЮТ МОБИЛЬНЫЕ ГРУППЫ. ХОРОШО. ДОПУСТИМ. НО
Dialogue: 0,0:03:55.74,0:03:58.54,Caption,,0,0,0,,ЕСТЬ МАЛЕНЬКАЯ БЫТОВАЯ ПРОБЛЕМА. А СТРЕЛЯТЬ КТО
Dialogue: 0,0:03:58.54,0:04:02.38,Caption,,0,0,0,,БУДЕТ? НЕ КНОПКУ НА КОФЕВАРКЕ НАЖАТЬ. НЕ ШЛАГБАУМ ПОДНЯТЬ.
Dialogue: 0,0:04:02.70,0:04:04.30,Caption,,0,0,0,,НЕ СТОРОЖУ СКАЗАТЬ ИВАН ИВАНЫЧ,
Dialogue: 0,0:04:04.47,0:04:06.30,Caption,,0,0,0,,СЕГОДНЯ ТЫ ДО ШЕСТИ НА ПРОХОДНОЙ,
Dialogue: 0,0:04:06.54,0:04:09.18,Caption,,0,0,0,,А ПОТОМ ПЕРЕСЯДЕШЬ ЗА ЗЕНИТКУ. ПОТОМУ ЧТО НАЖАТЬ
Dialogue: 0,0:04:09.26,0:04:11.74,Caption,,0,0,0,,НА СПУСК ДЕЙСТВИТЕЛЬНО БОЛЬШОГО УМА НЕ НАДО. А
Dialogue: 0,0:04:11.74,0:04:15.10,Caption,,0,0,0,,ВОТ ПОНЯТЬ, ЧТО ИМЕННО ЛЕТИТ, КУДА ОНО ЛЕТИТ,
Dialogue: 0,0:04:15.34,0:04:18.70,Caption,,0,0,0,,МОЖНО ЛИ ОТКРЫВАТЬ ОГОНЬ, ГДЕ НАХОДЯТСЯ СОСЕДНИЕ ДОМА,
Dialogue: 0,0:04:18.94,0:04:21.58,Caption,,0,0,0,,КУДА ПОЛЕТЯТ ОСКОЛКИ, КУДА УПАДЁТ ТО,
Dialogue: 0,0:04:21.72,0:04:23.74,Caption,,0,0,0,,ЧТО ВЫ СОБЬЁТЕ, И ЧТО ПРОИЗОЙДЁТ,
Dialogue: 0,0:04:23.89,0:04:27.90,Caption,,0,0,0,,ЕСЛИ ВЫ ПРОМАХНЁТЕСЬ, ЭТО УЖЕ НЕМНОГО ДРУГАЯ ПРОФЕССИЯ. И ТУТ
Dialogue: 0,0:04:27.90,0:04:30.54,Caption,,0,0,0,,ВЫРИСОВЫВАЕТСЯ ПРЕКРАСНАЯ КАРТИНА. ОБЫЧНОЕ
Dialogue: 0,0:04:30.54,0:04:34.38,Caption,,0,0,0,,ПРЕДПРИЯТИЕ. ПРОХОДНАЯ. ШЛАГБАУМ. БУДКА ОХРАНЫ.
Dialogue: 0,0:04:34.69,0:04:36.94,Caption,,0,0,0,,ВЧЕРА ЧЕЛОВЕК ПРОВЕРЯЛ ПРОПУСКА И РУГАЛСЯ С
Dialogue: 0,0:04:36.94,0:04:39.42,Caption,,0,0,0,,ВОДИТЕЛЕМ ЗА НЕПРАВИЛЬНО ОФОРМЛЕННУЮ НАКЛАДНУЮ.
Dialogue: 0,0:04:39.74,0:04:44.62,Caption,,0,0,0,,СЕГОДНЯ ЕМУ ГОВОРЯТ ПЕТРОВИЧ, ПОВЫШЕНИЕ. ТЕПЕРЬ ТЫ ПВО. ПЕТРОВИЧ СМОТРИТ НА
Dialogue: 0,0:04:44.62,0:04:47.66,Caption,,0,0,0,,ЗЕНИТКУ. ЗЕНИТКА СМОТРИТ НА ПЕТРОВИЧА. ВОРОБЬИ
Dialogue: 0,0:04:47.66,0:04:50.30,Caption,,0,0,0,,НАЧИНАЮТ НЕРВНИЧАТЬ. А ЕСЛИ СЕРЬЁЗНЕЕ,
Dialogue: 0,0:04:50.46,0:04:55.10,Caption,,0,0,0,,ТО ГДЕ БРАТЬ СПЕЦИАЛИСТОВ? НОРМАЛЬНЫЕ СПЕЦИАЛИСТЫ ПВО НУЖНЫ АРМИИ. ПРИЧЁМ НУЖНЫ
Dialogue: 0,0:04:55.10,0:04:57.42,Caption,,0,0,0,,НЕ КОГДА НИБУДЬ ПОТОМ, А ПРЯМО СЕЙЧАС.
Dialogue: 0,0:04:59.69,0:05:02.81,Caption,,0,0,0,,ЛЮДИ, КОТОРЫЕ УМЕЮТ РАБОТАТЬ С СИСТЕМАМИ ОБНАРУЖЕНИЯ,
Dialogue: 0,0:05:03.13,0:05:05.05,Caption,,0,0,0,,ЗНАЮТ ПОРЯДОК ПРИМЕНЕНИЯ ОРУЖИЯ,
Dialogue: 0,0:05:05.28,0:05:07.61,Caption,,0,0,0,,УМЕЮТ ОТЛИЧАТЬ ЦЕЛЬ ОТ ВСЕГО ОСТАЛЬНОГО,
Dialogue: 0,0:05:07.78,0:05:11.05,Caption,,0,0,0,,УЖЕ ЯВЛЯЮТСЯ ОЧЕНЬ ЦЕННЫМ РЕСУРСОМ. И ВДРУГ МЫ
Dialogue: 0,0:05:11.05,0:05:13.53,Caption,,0,0,0,,СОЗДАЁМ ЕЩЁ ОДИН ОГРОМНЫЙ СПРОС НА ТАКИХ ЖЕ
Dialogue: 0,0:05:13.53,0:05:17.13,Caption,,0,0,0,,ЛЮДЕЙ. ПОЧТИ СТО ПРЕДПРИЯТИЙ УЖЕ УЧАСТВУЮТ. А ЕСЛИ
Dialogue: 0,0:05:17.13,0:05:19.77,Caption,,0,0,0,,ЗАВТРА БУДЕТ ДВЕСТИ? ТРИСТА? ПЯТЬСОТ?
Dialogue: 0,0:05:20.09,0:05:23.13,Caption,,0,0,0,,ОТКУДА ПОЯВЯТСЯ РАСЧЁТЫ? С ЛУНЫ ПОДКРЕПЛЕНИЕ ПРИШЛЮТ?
Dialogue: 0,0:05:23.35,0:05:26.01,Caption,,0,0,0,,И ЗДЕСЬ ПОЯВЛЯЕТСЯ ЕЩЁ ОДИН ПРЕКРАСНЫЙ УКРАИНСКИЙ
Dialogue: 0,0:05:26.01,0:05:29.53,Caption,,0,0,0,,ПАРАДОКС. МУЖЧИН НА ФРОНТЕ НЕ ХВАТАЕТ. МОБИЛИЗАЦИЯ
Dialogue: 0,0:05:29.53,0:05:32.81,Caption,,0,0,0,,ПРОДОЛЖАЕТСЯ. ТЦК РАБОТАЕТ. И ТЕПЕРЬ МУЖЧИНЕ
Dialogue: 0,0:05:32.81,0:05:35.45,Caption,,0,0,0,,ПРЕДЛАГАЮТ ДОБРОВОЛЬНО ПРИЙТИ В ВООРУЖЁННУЮ ГРУППУ
Dialogue: 0,0:05:35.45,0:05:37.77,Caption,,0,0,0,,ПРЕДПРИЯТИЯ, ОФИЦИАЛЬНО ЗАСВЕТИТЬСЯ,
Dialogue: 0,0:05:38.01,0:05:40.01,Caption,,0,0,0,,ПОКАЗАТЬ, ЧТО ОН ЗДОРОВ, ГОДЕН,
Dialogue: 0,0:05:40.25,0:05:42.81,Caption,,0,0,0,,УМЕЕТ ОБРАЩАТЬСЯ С ТЕХНИКОЙ И ВООБЩЕ ПРЕКРАСНЫЙ
Dialogue: 0,0:05:42.81,0:05:47.61,Caption,,0,0,0,,КАНДИДАТ. ОЧЕРЕДЬ, ДУМАЮ, БУДЕТ ОТ КИЕВА ДО ЛЬВОВА. ОСОБЕННО ИЗ ТЕХ,
Dialogue: 0,0:05:47.93,0:05:50.25,Caption,,0,0,0,,КТО ПОСЛЕДНИЕ МЕСЯЦЫ СТАРАТЕЛЬНО ОБЪЯСНЯЛ ВСЕМ
Dialogue: 0,0:05:50.25,0:05:53.77,Caption,,0,0,0,,ЗНАКОМЫМ, ЧТО НА УЛИЦУ ОН ВЫХОДИТ ИСКЛЮЧИТЕЛЬНО НОЧЬЮ,
Dialogue: 0,0:05:53.93,0:05:56.89,Caption,,0,0,0,,В МУСОРНОМ ПАКЕТЕ И ЖЕЛАТЕЛЬНО ЧЕРЕЗ ЧЁРНЫЙ ХОД.
Dialogue: 0,0:05:57.11,0:05:58.81,Caption,,0,0,0,,И КОГО ТОГДА НАБИРАТЬ? ЖЕНЩИН?
Dialogue: 0,0:05:58.95,0:06:02.25,Caption,,0,0,0,,ПОЧЕМУ НЕТ. ЖЕНЩИНЫ В АРМИИ СЛУЖАТ. ЕСТЬ ЖЕНЩИНЫ,
Dialogue: 0,0:06:02.48,0:06:04.41,Caption,,0,0,0,,КОТОРЫЕ УМЕЮТ ОБРАЩАТЬСЯ С ОРУЖИЕМ,
Dialogue: 0,0:06:04.57,0:06:07.61,Caption,,0,0,0,,ЕСТЬ ОТЛИЧНЫЕ СПЕЦИАЛИСТЫ. ТОЛЬКО ТАКИХ СПЕЦИАЛИСТОВ
Dialogue: 0,0:06:07.69,0:06:09.77,Caption,,0,0,0,,ОТ ЭТОГО ВНЕЗАПНО НЕ СТАНОВИТСЯ БЕСКОНЕЧНОЕ
Dialogue: 0,0:06:09.77,0:06:15.24,Caption,,0,0,0,,КОЛИЧЕСТВО. ЕСЛИ ДЛЯ СОТЕН НОВЫХ РАСЧЁТОВ НУЖНЫ ТЫСЯЧИ
Dialogue: 0,0:06:15.24,0:06:19.08,Caption,,0,0,0,,ПОДГОТОВЛЕННЫХ ЛЮДЕЙ, ОНИ НЕ ПОЯВЛЯЮТСЯ ПО ПОСТАНОВЛЕНИЮ ПРАВИТЕЛЬСТВА.
Dialogue: 0,0:06:19.48,0:06:21.16,Caption,,0,0,0,,НЕЛЬЗЯ УТРОМ ПРИНЯТЬ ДОКУМЕНТ,
Dialogue: 0,0:06:21.40,0:06:23.48,Caption,,0,0,0,,А ПОСЛЕ ОБЕДА ОТКРЫТЬ ОКНО И УВИДЕТЬ,
Dialogue: 0,0:06:23.80,0:06:26.36,Caption,,0,0,0,,КАК ПО УЛИЦЕ УЖЕ ИДУТ ГОТОВЫЕ РАСЧЁТЫ ПВО,
Dialogue: 0,0:06:26.60,0:06:29.48,Caption,,0,0,0,,ВСЕ С ОПЫТОМ, ВСЕ ОБУЧЕННЫЕ, ВСЕ ЗНАЮТ,
Dialogue: 0,0:06:29.50,0:06:31.96,Caption,,0,0,0,,КУДА СТРЕЛЯТЬ. ТАК ЭТО НЕ РАБОТАЕТ. А
Dialogue: 0,0:06:31.96,0:06:34.28,Caption,,0,0,0,,НЕПОДГОТОВЛЕННЫЙ ЧЕЛОВЕК С СЕРЬЁЗНЫМ ОРУЖИЕМ,
Dialogue: 0,0:06:34.60,0:06:37.56,Caption,,0,0,0,,ЭТО ВООБЩЕ ОТДЕЛЬНЫЙ ЖАНР. ОСОБЕННО ЕСЛИ ПРЕДПРИЯТИЕ
Dialogue: 0,0:06:37.56,0:06:43.16,Caption,,0,0,0,,НАХОДИТСЯ НЕ ПОСРЕДИ ПУСТЫНИ, А В ГОРОДЕ. РЯДОМ ЖИЛЫЕ ДОМА. ДОРОГИ. МАШИНЫ.
Dialogue: 0,0:06:43.32,0:06:45.96,Caption,,0,0,0,,ЛЮДИ. МАГАЗИНЫ. ЧТО ПРОИЗОЙДЁТ,
Dialogue: 0,0:06:46.20,0:06:48.36,Caption,,0,0,0,,ЕСЛИ ТАКОЙ РАСЧЁТ НАЧИНАЕТ ПАЛИТЬ ВОКРУГ?
Dialogue: 0,0:06:48.65,0:06:51.16,Caption,,0,0,0,,НУ ТОГДА ВОРОБЬЯМ ТОЧНО ХАНА. А ВМЕСТЕ С
Dialogue: 0,0:06:51.24,0:06:53.88,Caption,,0,0,0,,ВОРОБЬЯМИ ОЧЕНЬ БЫСТРО МОГУТ ВОЗНИКНУТЬ ВОПРОСЫ И У
Dialogue: 0,0:06:53.96,0:06:56.68,Caption,,0,0,0,,ЖИТЕЛЕЙ БЛИЖАЙШЕГО ДОМА. ПОТОМУ ЧТО СБИТЬ ДРОН,
Dialogue: 0,0:06:56.77,0:06:59.16,Caption,,0,0,0,,ЭТО ЕЩЁ ПОЛОВИНА ЗАДАЧИ. ПОТОМ ВСЁ,
Dialogue: 0,0:06:59.24,0:07:03.72,Caption,,0,0,0,,ЧТО ЛЕТЕЛО, КУДА ТО ПАДАЕТ. ОСКОЛКИ КУДА ТО ЛЕТЯТ. БОЕПРИПАСЫ
Dialogue: 0,0:07:03.72,0:07:05.96,Caption,,0,0,0,,ТОЖЕ НЕ РАСТВОРЯЮТСЯ В ВОЗДУХЕ ПОСЛЕ ТОГО,
Dialogue: 0,0:07:06.26,0:07:09.08,Caption,,0,0,0,,КАК ВЫ НАЖАЛИ КНОПКУ. КТО ОТВЕЧАЕТ ЗА ОШИБКУ?
Dialogue: 0,0:07:09.32,0:07:11.40,Caption,,0,0,0,,КТО РЕШАЕТ, КОГДА ОТКРЫВАТЬ ОГОНЬ?
Dialogue: 0,0:07:11.72,0:07:14.44,Caption,,0,0,0,,КТО КОНТРОЛИРУЕТ ПОДГОТОВКУ? КТО ПРОВЕРЯЕТ,
Dialogue: 0,0:07:14.60,0:07:16.84,Caption,,0,0,0,,ЧТО ЧЕЛОВЕК ЗА УСТАНОВКОЙ ВООБЩЕ ПОНИМАЕТ,
Dialogue: 0,0:07:16.97,0:07:19.72,Caption,,0,0,0,,ЧТО ДЕЛАЕТ? ЕСЛИ ДОВЕСТИ ЭТУ ЛОГИКУ ДО КОНЦА,
Dialogue: 0,0:07:20.04,0:07:22.44,Caption,,0,0,0,,ТО МОЖНО УЖЕ СРАЗУ ВЫДАТЬ КАЖДОМУ ПРЕДПРИЯТИЮ ПО
Dialogue: 0,0:07:22.44,0:07:25.40,Caption,,0,0,0,,АТОМНОЙ БОМБЕ. ЧТОБЫ ДВА РАЗА БУМАГИ НЕ ОФОРМЛЯТЬ.
Dialogue: 0,0:07:25.61,0:07:28.28,Caption,,0,0,0,,ПОДПИШИТЕСЬ, КСТАТИ, ЕСЛИ ЕЩЁ НЕ СДЕЛАЛИ ЭТОГО.
Dialogue: 0,0:07:30.55,0:07:32.87,Caption,,0,0,0,,ПОТОМУ ЧТО МЫ ПОКА ТОЛЬКО СПУСТИЛИСЬ ИЗ КОСМОСА
Dialogue: 0,0:07:32.95,0:07:36.63,Caption,,0,0,0,,НА КРЫШУ ЗАВОДА, А ВПЕРЕДИ У НАС ЕЩЁ ГОРОДСКОЙ ТРАНСПОРТ. И
Dialogue: 0,0:07:36.63,0:07:39.19,Caption,,0,0,0,,ВОТ ТЕПЕРЬ ПЕРЕХОДИМ ОКОНЧАТЕЛЬНО К ДЕЛАМ ЗЕМНЫМ.
Dialogue: 0,0:07:39.74,0:07:42.55,Caption,,0,0,0,,В КИЕВЕ ПРОБЛЕМЫ СО СВЕТОМ. ПРОБЛЕМЫ С ВОДОЙ.
Dialogue: 0,0:07:42.82,0:07:45.67,Caption,,0,0,0,,ПРОБЛЕМЫ С ОТОПЛЕНИЕМ. ПОСЛЕ УДАРОВ ПРИХОДИТСЯ
Dialogue: 0,0:07:45.67,0:07:48.63,Caption,,0,0,0,,ПЕРЕСТРАИВАТЬ ТРАНСПОРТНЫЕ МАРШРУТЫ. ЛЮДИ СИДЯТ БЕЗ
Dialogue: 0,0:07:48.63,0:07:51.35,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА ПО НЕСКОЛЬКО СУТОК. НА ЛЕВОМ БЕРЕГУ
Dialogue: 0,0:07:51.35,0:07:53.83,Caption,,0,0,0,,ЖИТЕЛИ ЖИЛОГО КОМПЛЕКСА "НОВЫЙ АВТОГРАФ" ВЫШЛИ И
Dialogue: 0,0:07:53.83,0:07:56.63,Caption,,0,0,0,,ПЕРЕКРЫЛИ ДОРОГУ ПОСЛЕ ТРЁХ СУТОК БЕЗ СВЕТА. И
Dialogue: 0,0:07:56.63,0:08:00.23,Caption,,0,0,0,,ТУТ ПОЯВЛЯЕТСЯ РЕШЕНИЕ. БЕСПЛАТНЫЙ ПРОЕЗД. ПРЕЗИДЕНТ
Dialogue: 0,0:08:00.31,0:08:02.15,Caption,,0,0,0,,ПОРУЧИЛ ПРАВИТЕЛЬСТВУ ПОДГОТОВИТЬ ПРОГРАММУ
Dialogue: 0,0:08:02.15,0:08:04.39,Caption,,0,0,0,,БЕСПЛАТНОГО ПРОЕЗДА В НАЗЕМНОМ ОБЩЕСТВЕННОМ
Dialogue: 0,0:08:04.39,0:08:07.51,Caption,,0,0,0,,ТРАНСПОРТЕ КИЕВА И ОБЕСПЕЧИТЬ РЕЗЕРВ АВТОБУСОВ. НУ
Dialogue: 0,0:08:07.59,0:08:10.55,Caption,,0,0,0,,КРАСОТА ЖЕ. СВЕТА НЕТ. ВОДЫ МЕСТАМИ НЕТ. С
Dialogue: 0,0:08:10.63,0:08:13.03,Caption,,0,0,0,,ОТОПЛЕНИЕМ ВОПРОСЫ. МЕТРО МОЖЕТ РАБОТАТЬ С
Dialogue: 0,0:08:13.03,0:08:16.55,Caption,,0,0,0,,ПЕРЕБОЯМИ. МОСТЫ ТРЕБУЮТ ОТДЕЛЬНОГО ВНИМАНИЯ. ЗАТО
Dialogue: 0,0:08:16.55,0:08:21.11,Caption,,0,0,0,,ЕХАТЬ БЕСПЛАТНО. КУДА ЕХАТЬ, ЭТО УЖЕ ВТОРОЙ ВОПРОС. А ТЕПЕРЬ ПОСМОТРИМ НА
Dialogue: 0,0:08:21.11,0:08:23.91,Caption,,0,0,0,,ПРАКТИЧЕСКУЮ СТОРОНУ. КТО БЕСПЛАТНО ПОВЕЗЁТ?
Dialogue: 0,0:08:24.07,0:08:28.07,Caption,,0,0,0,,ТАКСИСТЫ? ДА ФИГУШКИ ОНИ БЕСПЛАТНО ПОВЕЗУТ. ТАКСИСТ БЕСПЛАТНО
Dialogue: 0,0:08:28.07,0:08:30.39,Caption,,0,0,0,,ПОВЕЗЁТ ТОЛЬКО В ОДНОМ СЛУЧАЕ. ЕСЛИ ВЫ ЕГО
Dialogue: 0,0:08:30.39,0:08:32.63,Caption,,0,0,0,,МАШИНУ ТОЛКАЕТЕ СЗАДИ. АВТОБУСЫ?
Dialogue: 0,0:08:32.79,0:08:38.15,Caption,,0,0,0,,ХОРОШО. ЗНАЧИТ, НУЖНЫ АВТОБУСЫ. НУЖНЫ ВОДИТЕЛИ. НУЖНО ТОПЛИВО. НУЖНО
Dialogue: 0,0:08:38.15,0:08:41.03,Caption,,0,0,0,,ОБСЛУЖИВАНИЕ. НУЖНО РЕМОНТИРОВАТЬ ЭТИ АВТОБУСЫ.
Dialogue: 0,0:08:41.27,0:08:45.38,Caption,,0,0,0,,НУЖНЫ ЗАПЧАСТИ. НУЖНЫ ЛЮДИ,
Dialogue: 0,0:08:45.62,0:08:48.02,Caption,,0,0,0,,КОТОРЫЕ ВСЁ ЭТО БУДУТ ДЕЛАТЬ. И ТУТ ОПЯТЬ
Dialogue: 0,0:08:48.02,0:08:50.34,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЗНАКОМЫЙ ВОПРОС. А ЛЮДИ ГДЕ?
Dialogue: 0,0:08:50.74,0:08:53.30,Caption,,0,0,0,,МЫ ТОЛЬКО ЧТО ИСКАЛИ СПЕЦИАЛИСТОВ ДЛЯ ЧАСТНОЙ ПВО.
Dialogue: 0,0:08:53.62,0:08:56.10,Caption,,0,0,0,,ДО ЭТОГО ИСКАЛИ ЛЮДЕЙ ДЛЯ ФРОНТА. ТЕПЕРЬ НАМ
Dialogue: 0,0:08:56.18,0:08:58.82,Caption,,0,0,0,,НУЖНЫ ВОДИТЕЛИ, МЕХАНИКИ, ЭЛЕКТРИКИ,
Dialogue: 0,0:08:58.90,0:09:01.22,Caption,,0,0,0,,САНТЕХНИКИ, АВАРИЙНЫЕ БРИГАДЫ,
Dialogue: 0,0:09:01.35,0:09:06.58,Caption,,0,0,0,,ЭНЕРГЕТИКИ. ТАКОЕ ЧУВСТВО, ЧТО ГДЕ ТО СУЩЕСТВУЕТ СЕКРЕТНЫЙ СКЛАД УКРАИНЦЕВ.
Dialogue: 0,0:09:06.73,0:09:10.66,Caption,,0,0,0,,ОТКРЫВАЕТСЯ ОГРОМНАЯ ДВЕРЬ, А ТАМ СТОЯТ РЯДЫ СВОБОДНЫХ ЭЛЕКТРИКОВ,
Dialogue: 0,0:09:10.81,0:09:13.54,Caption,,0,0,0,,СВОБОДНЫХ ИНЖЕНЕРОВ, СВОБОДНЫХ ВОДИТЕЛЕЙ,
Dialogue: 0,0:09:13.70,0:09:16.82,Caption,,0,0,0,,СПЕЦИАЛИСТОВ ПВО И САНТЕХНИКОВ. БЕРИТЕ СКОЛЬКО
Dialogue: 0,0:09:16.82,0:09:19.78,Caption,,0,0,0,,ХОТИТЕ. ТОЛЬКО В РЕАЛЬНОЙ ЖИЗНИ ТАКОГО СКЛАДА НЕТ.
Dialogue: 0,0:09:20.10,0:09:22.42,Caption,,0,0,0,,И ЭТО УЖЕ ВИДНО ПО КОММУНАЛЬНЫМ СЛУЖБАМ. КОГДА
Dialogue: 0,0:09:22.50,0:09:24.82,Caption,,0,0,0,,ЛЮДИ НЕСКОЛЬКО СУТОК СИДЯТ БЕЗ ЭЛЕКТРИЧЕСТВА И
Dialogue: 0,0:09:24.82,0:09:27.54,Caption,,0,0,0,,ВЫХОДЯТ ПЕРЕКРЫВАТЬ ДОРОГИ, ЭТО НЕ ПОТОМУ,
Dialogue: 0,0:09:27.62,0:09:30.34,Caption,,0,0,0,,ЧТО ИМ ВНЕЗАПНО ЗАХОТЕЛОСЬ ПОДЫШАТЬ СВЕЖИМ ВОЗДУХОМ
Dialogue: 0,0:09:30.42,0:09:32.82,Caption,,0,0,0,,ПОСРЕДИ ПРОЕЗЖЕЙ ЧАСТИ. ОНИ ХОТЯТ,
Dialogue: 0,0:09:33.05,0:09:35.94,Caption,,0,0,0,,ЧТОБЫ ПРОБЛЕМУ РЕШИЛИ. А КТО ЕЁ ДОЛЖЕН РЕШАТЬ?
Dialogue: 0,0:09:36.17,0:09:39.62,Caption,,0,0,0,,РЕМОНТНИКИ. ЭЛЕКТРИКИ. ЭНЕРГЕТИКИ. ЛЮДИ,
Dialogue: 0,0:09:39.78,0:09:41.70,Caption,,0,0,0,,КОТОРЫЕ ЗНАЮТ КОНКРЕТНЫЕ СЕТИ,
Dialogue: 0,0:09:41.82,0:09:46.58,Caption,,0,0,0,,КОНКРЕТНЫЕ ПОДСТАНЦИИ, КОНКРЕТНЫЕ СИСТЕМЫ ВОДОСНАБЖЕНИЯ. И ВОТ ЭТИХ ЛЮДЕЙ
Dialogue: 0,0:09:46.66,0:09:49.06,Caption,,0,0,0,,ТОЖЕ МОЖНО МОБИЛИЗОВАТЬ. ТО ЕСТЬ ПОЛУЧАЕТСЯ
Dialogue: 0,0:09:49.06,0:09:51.54,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ СИСТЕМА. СНАЧАЛА ГОВОРИМ,
Dialogue: 0,0:09:51.70,0:09:54.42,Caption,,0,0,0,,ЧТО ЛЮДЕЙ НЕ ХВАТАЕТ НА ФРОНТЕ. ПОТОМ ЗАБИРАЕМ
Dialogue: 0,0:09:54.42,0:09:57.94,Caption,,0,0,0,,ТУДА ТЕХ, КТО НУЖЕН В ТЫЛУ. ПОТОМ В ТЫЛУ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:09:58.02,0:10:03.35,Caption,,0,0,0,,ЧТО НЕКОМУ ЧИНИТЬ. ПОТОМ ЖИТЕЛИ ПЕРЕКРЫВАЮТ ДОРОГИ,
Dialogue: 0,0:10:03.43,0:10:06.31,Caption,,0,0,0,,ПОТОМУ ЧТО НИКТО НЕ ПОЧИНИЛ. ПОТОМ СОЗДАЁМ НОВУЮ
Dialogue: 0,0:10:06.31,0:10:09.35,Caption,,0,0,0,,ПРОГРАММУ, ЧТОБЫ ЛЮДИ БЕСПЛАТНО ЕЗДИЛИ ПО ГОРОДУ,
Dialogue: 0,0:10:09.43,0:10:11.91,Caption,,0,0,0,,ГДЕ ВСЁ ЭТО ПРОИСХОДИТ. А ПОТОМ ДЛЯ ЗАЩИТЫ
Dialogue: 0,0:10:11.91,0:10:14.07,Caption,,0,0,0,,ПРЕДПРИЯТИЙ СОЗДАЁМ ЧАСТНУЮ ПВО,
Dialogue: 0,0:10:14.23,0:10:16.47,Caption,,0,0,0,,КОТОРОЙ ОПЯТЬ НУЖНЫ ЛЮДИ. С ЛУНЫ,
Dialogue: 0,0:10:16.55,0:10:19.43,Caption,,0,0,0,,РЕБЯТА. ТОЛЬКО С ЛУНЫ. И ЖЕЛАТЕЛЬНО СРАЗУ
Dialogue: 0,0:10:19.43,0:10:22.63,Caption,,0,0,0,,АВТОБУСАМИ. ПРИЧЁМ БЕСПЛАТНО. НА ЭТОМ ФОНЕ УЖЕ ПОШЛИ
Dialogue: 0,0:10:22.71,0:10:26.07,Caption,,0,0,0,,РАЗГОВОРЫ, ЧТО ИСТОРИЯ С БЕСПЛАТНЫМ ТРАНСПОРТОМ ИМЕЕТ ЕЩЁ И
Dialogue: 0,0:10:26.07,0:10:30.71,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ СЛОЙ. МОЛ, ЗЕЛЕНСКИЙ ТАКИМ ОБРАЗОМ ЗАХОДИТ НА ТЕРРИТОРИЮ КЛИЧКО
Dialogue: 0,0:10:30.79,0:10:33.51,Caption,,0,0,0,,И ПЫТАЕТСЯ ПЕРЕХВАТИТЬ У МЭРИИ КРАСИВУЮ СОЦИАЛЬНУЮ
Dialogue: 0,0:10:33.51,0:10:36.71,Caption,,0,0,0,,ТЕМУ. ПУСКАЙ РАЗБИРАЮТСЯ. КТО ТАМ КОГО ПОЛИТИЧЕСКИ
Dialogue: 0,0:10:36.71,0:10:40.39,Caption,,0,0,0,,ПЕРЕИГРЫВАЕТ, ЭТО СЕЙЧАС ДАЛЕКО НЕ САМОЕ ИНТЕРЕСНОЕ. ПОТОМУ ЧТО
Dialogue: 0,0:10:40.39,0:10:43.19,Caption,,0,0,0,,ОБЫЧНОМУ КИЕВЛЯНИНУ ГОРАЗДО ВАЖНЕЕ ДРУГОЙ ВОПРОС.
Dialogue: 0,0:10:43.34,0:10:46.31,Caption,,0,0,0,,КОГДА ОН НАЖМЁТ ВЫКЛЮЧАТЕЛЬ, ЗАГОРИТСЯ СВЕТ ИЛИ НЕТ?
Dialogue: 0,0:10:46.63,0:10:49.03,Caption,,0,0,0,,КОГДА ОТКРОЕТ КРАН, БУДЕТ ВОДА ИЛИ НЕТ?
Dialogue: 0,0:10:49.35,0:10:53.19,Caption,,0,0,0,,КОГДА ВЫЙДЕТ НА ОСТАНОВКУ, ПРИЕДЕТ АВТОБУС ИЛИ ЕМУ ДЕЙСТВИТЕЛЬНО ПОРА ИСКАТЬ
Dialogue: 0,0:10:53.19,0:10:57.27,Caption,,0,0,0,,ЛОШАДЬ? ВОТ ЭТО УЖЕ ОЧЕНЬ ПРИЗЕМЛЁННЫЕ ВОПРОСЫ. И ЗДЕСЬ
Dialogue: 0,0:10:57.35,0:10:59.99,Caption,,0,0,0,,ВСЯ СЕГОДНЯШНЯЯ КАРТИНА ВДРУГ СТАНОВИТСЯ УДИВИТЕЛЬНО
Dialogue: 0,0:10:59.99,0:11:03.11,Caption,,0,0,0,,ЦЕЛЬНОЙ. СВЕРХУ У НАС КОСМОС. ТАМ СОБИРАЮТСЯ
Dialogue: 0,0:11:03.11,0:11:06.79,Caption,,0,0,0,,ПЕРЕХВАТЫВАТЬ "ОРЕШНИК". ЧУТЬ НИЖЕ ЧАСТНАЯ ПВО. ТАМ
Dialogue: 0,0:11:06.79,0:11:11.03,Caption,,0,0,0,,ИЩУТ ЛЮДЕЙ, КОТОРЫЕ БУДУТ ЗАЩИЩАТЬ ПРЕДПРИЯТИЯ. ЕЩЁ НИЖЕ КИЕВ.
Dialogue: 0,0:11:11.27,0:11:14.39,Caption,,0,0,0,,ТАМ ИЩУТ АВТОБУСЫ, ВОДИТЕЛЕЙ, ЭЛЕКТРИКОВ,
Dialogue: 0,0:11:14.48,0:11:19.78,Caption,,0,0,0,,РЕМОНТНИКОВ И ДЕНЬГИ. И НА КАЖДОМ ЭТАЖЕ ОДНА И ТА ЖЕ
Dialogue: 0,0:11:19.78,0:11:22.58,Caption,,0,0,0,,ПРОБЛЕМА. ОБЪЯВИТЬ РЕШЕНИЕ ЗНАЧИТЕЛЬНО ЛЕГЧЕ,
Dialogue: 0,0:11:22.82,0:11:25.22,Caption,,0,0,0,,ЧЕМ НАЙТИ ЛЮДЕЙ, ТЕХНИКУ И РЕСУРСЫ,
Dialogue: 0,0:11:25.46,0:11:28.58,Caption,,0,0,0,,КОТОРЫЕ ЗАСТАВЯТ ЭТО РЕШЕНИЕ РАБОТАТЬ. МОЖНО СКОЛЬКО
Dialogue: 0,0:11:28.58,0:11:33.22,Caption,,0,0,0,,УГОДНО НАПИСАТЬ НА БУМАГЕ, ЧТО ПРЕДПРИЯТИЕ ТЕПЕРЬ ЗАЩИЩАЕТ СЕБЯ САМО. ОТ ЭТОГО
Dialogue: 0,0:11:33.22,0:11:36.02,Caption,,0,0,0,,СПЕЦИАЛИСТ ПВО ВОЗЛЕ ПРОХОДНОЙ НЕ МАТЕРИАЛИЗУЕТСЯ.
Dialogue: 0,0:11:36.34,0:11:38.82,Caption,,0,0,0,,МОЖНО ОБЪЯВИТЬ БЕСПЛАТНЫЙ ТРАНСПОРТ. ОТ ЭТОГО
Dialogue: 0,0:11:38.82,0:11:41.22,Caption,,0,0,0,,АВТОБУС НЕ ЗАПРАВИТСЯ САМ. МОЖНО ОБЪЯВИТЬ
Dialogue: 0,0:11:41.22,0:11:43.86,Caption,,0,0,0,,КОСМИЧЕСКИЙ ПЕРЕХВАТ. ОТ ЭТОГО ПРОТИВОРАКЕТА НЕ
Dialogue: 0,0:11:43.86,0:11:46.66,Caption,,0,0,0,,ВЫРАСТЕТ НА ДЕРЕВЕ. ВОТ ПОЭТОМУ ВСЯ ЭТА ИСТОРИЯ
Dialogue: 0,0:11:46.74,0:11:49.22,Caption,,0,0,0,,И ВЫГЛЯДИТ ОДНОВРЕМЕННО СМЕШНО И ДОВОЛЬНО ГРУСТНО.
Dialogue: 0,0:11:49.54,0:11:51.78,Caption,,0,0,0,,ПОТОМУ ЧТО ЮМОР ЗДЕСЬ УЖЕ НЕ НАДО ПРИДУМЫВАТЬ.
Dialogue: 0,0:11:51.96,0:11:53.70,Caption,,0,0,0,,ОН САМ ПОЯВЛЯЕТСЯ В ТОТ МОМЕНТ,
Dialogue: 0,0:11:53.94,0:11:56.18,Caption,,0,0,0,,КОГДА РЯДОМ СТАВИШЬ ОБЕЩАНИЕ И РЕАЛЬНОСТЬ.
Dialogue: 0,0:11:56.42,0:11:58.82,Caption,,0,0,0,,КОСМИЧЕСКИЙ ПЕРЕХВАТ НА ФОНЕ НЕХВАТКИ ОБЫЧНЫХ
Dialogue: 0,0:11:58.82,0:12:01.46,Caption,,0,0,0,,РЕСУРСОВ. ЧАСТНАЯ ПВО НА ФОНЕ НЕХВАТКИ
Dialogue: 0,0:12:01.46,0:12:04.58,Caption,,0,0,0,,ПОДГОТОВЛЕННЫХ ЛЮДЕЙ. БЕСПЛАТНЫЙ ТРАНСПОРТ В ГОРОДЕ,
Dialogue: 0,0:12:04.66,0:12:06.98,Caption,,0,0,0,,ГДЕ ЖИТЕЛИ ПЕРЕКРЫВАЮТ ДОРОГИ ИЗ ЗА ОТСУТСТВИЯ
Dialogue: 0,0:12:07.06,0:12:10.18,Caption,,0,0,0,,СВЕТА. ЭТО УЖЕ НЕ ОТДЕЛЬНЫЕ АНЕКДОТЫ. ЭТО СПОСОБ
Dialogue: 0,0:12:10.18,0:12:13.06,Caption,,0,0,0,,УПРАВЛЕНИЯ ПРОБЛЕМАМИ ЧЕРЕЗ ВСЁ НОВЫЕ ОБЪЯВЛЕНИЯ О
Dialogue: 0,0:12:13.14,0:12:17.06,Caption,,0,0,0,,ТОМ, КАК ИМЕННО ПРОБЛЕМА БУДЕТ РЕШЕНА. СЕГОДНЯ КОСМОС.
Dialogue: 0,0:12:17.30,0:12:20.26,Caption,,0,0,0,,ЗАВТРА ЗЕНИТКА НА ЗАВОДЕ. ПОСЛЕЗАВТРА БЕСПЛАТНЫЙ
Dialogue: 0,0:12:20.26,0:12:22.98,Caption,,0,0,0,,АВТОБУС. А ПОТОМ КТО НИБУДЬ ОБЯЗАТЕЛЬНО ПРЕДЛОЖИТ
Dialogue: 0,0:12:22.98,0:12:25.70,Caption,,0,0,0,,ЕЩЁ ОДИН БОЛЬШОЙ ПРОЕКТ. И ВОТ ТОГДА САМОЕ
Dialogue: 0,0:12:25.78,0:12:29.06,Caption,,0,0,0,,ГЛАВНОЕ БУДЕТ ДАЖЕ НЕ ТО, НАСКОЛЬКО КРАСИВО ОН ЗВУЧИТ.
Dialogue: 0,0:12:31.35,0:12:35.03,Caption,,0,0,0,,ГЛАВНОЕ, ЧТОБЫ К ТОМУ МОМЕНТУ ГДЕ НИБУДЬ ОСТАЛСЯ ЧЕЛОВЕК,
Dialogue: 0,0:12:35.11,0:12:36.47,Caption,,0,0,0,,КОТОРЫЙ УМЕЕТ ЕГО ДЕЛАТЬ.
