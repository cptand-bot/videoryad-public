Dialogue: 0,0:00:00.12,0:00:03.80,Caption,,0,0,0,,ЗНАЕТЕ, БЫВАЕТ ТАКАЯ СЕМЕЙНАЯ ИСТОРИЯ. МУЖ ПРИХОДИТ ДОМОЙ И
Dialogue: 0,0:00:03.80,0:00:07.16,Caption,,0,0,0,,ГОВОРИТ, ЧТО ДЕЛА ИДУТ ВЕЛИКОЛЕПНО. ВСЁ ПОД КОНТРОЛЕМ,
Dialogue: 0,0:00:07.32,0:00:11.72,Caption,,0,0,0,,ПЕРСПЕКТИВЫ БЛЕСТЯЩИЕ, ЗАВТРА ЗАЖИВЁМ ЕЩЁ ЛУЧШЕ. А ЖЕНА СМОТРИТ НА
Dialogue: 0,0:00:11.72,0:00:15.96,Caption,,0,0,0,,ПРОИСХОДЯЩЕЕ И ПОНИМАЕТ, ЧТО ОБЪЯСНИТЬ ЕЙ ПРИДЁТСЯ КОЕ ЧТО СОВСЕМ ДРУГОЕ.
Dialogue: 0,0:00:16.44,0:00:19.08,Caption,,0,0,0,,ВОТ ПРИМЕРНО ТАКАЯ АРИФМЕТИКА СЕЙЧАС ОБНАРУЖИЛАСЬ В
Dialogue: 0,0:00:19.08,0:00:21.88,Caption,,0,0,0,,БОЛЬШОЙ ПОЛИТИКЕ. ПРИЧЁМ В НЕЙ УЧАСТВУЕТ СРАЗУ
Dialogue: 0,0:00:21.96,0:00:23.64,Caption,,0,0,0,,НЕСКОЛЬКО ВЕСЬМА СЕРЬЁЗНЫХ ЛЮДЕЙ,
Dialogue: 0,0:00:23.96,0:00:26.60,Caption,,0,0,0,,И КАЖДЫЙ ПОЧЕМУ ТО РАССКАЗЫВАЕТ СВОЮ ЧАСТЬ ИСТОРИИ.
Dialogue: 0,0:00:27.00,0:00:28.84,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:28.92,0:00:31.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:31.44,0:00:33.96,Caption,,0,0,0,,КОГДА НЕСКОЛЬКО ОТДЕЛЬНЫХ НОВОСТЕЙ ВМЕСТЕ ДАЮТ
Dialogue: 0,0:00:33.96,0:00:36.44,Caption,,0,0,0,,КАРТИНУ ГОРАЗДО ИНТЕРЕСНЕЕ КАЖДОЙ ИЗ НИХ ПО
Dialogue: 0,0:00:36.44,0:00:40.04,Caption,,0,0,0,,ОТДЕЛЬНОСТИ. НАЧНЁМ С ДЕНЕГ. ЕВРОКОМИССИЯ ПРЕДЛАГАЕТ
Dialogue: 0,0:00:40.04,0:00:42.92,Caption,,0,0,0,,УКРАИНЕ ЕЩЁ СОРОК ПЯТЬ МИЛЛИАРДОВ ЕВРО НА ДВЕ
Dialogue: 0,0:00:42.92,0:00:45.64,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД. ДЕНЬГИ НУЖНЫ И НА
Dialogue: 0,0:00:45.72,0:00:49.24,Caption,,0,0,0,,БЮДЖЕТ, И НА ВОЕННЫЕ РАСХОДЫ. ФОРМАЛЬНО СХЕМА КРАСИВАЯ.
Dialogue: 0,0:00:49.48,0:00:51.64,Caption,,0,0,0,,ЕВРОСОЮЗ ЗАНИМАЕТ СРЕДСТВА НА РЫНКАХ,
Dialogue: 0,0:00:51.88,0:00:55.64,Caption,,0,0,0,,ДАЁТ ИХ КИЕВУ, А УКРАИНА ДОЛЖНА ВОЗВРАЩАТЬ ОСНОВНОЙ ДОЛГ ПОСЛЕ
Dialogue: 0,0:00:55.64,0:00:59.00,Caption,,0,0,0,,ТОГО, КАК РОССИЯ ВЫПЛАТИТ РЕПАРАЦИИ. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:00:59.00,0:01:01.64,Caption,,0,0,0,,КОНСТРУКЦИЯ. ОСОБЕННО ЕСЛИ НЕ ЗАДАВАТЬ ВОПРОС,
Dialogue: 0,0:01:01.80,0:01:04.92,Caption,,0,0,0,,ЧТО БУДЕТ, ЕСЛИ ЭТИХ САМЫХ РЕПАРАЦИЙ В НУЖНЫЙ МОМЕНТ НЕ
Dialogue: 0,0:01:04.92,0:01:07.88,Caption,,0,0,0,,ОКАЖЕТСЯ. И ВОТ ЗДЕСЬ СЛОВА РОБЕРТА ФИЦО ЗВУЧАТ
Dialogue: 0,0:01:07.88,0:01:09.96,Caption,,0,0,0,,ОСОБЕННО НЕПРИЯТНО ДЛЯ ВСЕЙ ЭТОЙ КРАСИВОЙ
Dialogue: 0,0:01:09.96,0:01:15.99,Caption,,0,0,0,,БУХГАЛТЕРИИ. ОН НАЗЫВАЕТ ТАКИЕ КРЕДИТЫ ПОДАРКАМИ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:01:16.23,0:01:18.95,Caption,,0,0,0,,УКРАИНА НЕ ВЕРНЁТ НИ ПРЕЖНИЕ ДЕВЯНОСТО МИЛЛИАРДОВ,
Dialogue: 0,0:01:19.10,0:01:21.99,Caption,,0,0,0,,НИ НОВЫЕ ДЕНЬГИ. СЛОВАКИЯ ПОЭТОМУ УЧАСТВОВАТЬ В
Dialogue: 0,0:01:21.99,0:01:24.23,Caption,,0,0,0,,СЛЕДУЮЩЕМ РАУНДЕ ФИНАНСОВЫХ ОБЯЗАТЕЛЬСТВ НЕ
Dialogue: 0,0:01:24.23,0:01:26.55,Caption,,0,0,0,,СОБИРАЕТСЯ. ТУТ УЖЕ НЕ СПОР О ТОМ,
Dialogue: 0,0:01:26.63,0:01:29.75,Caption,,0,0,0,,ПОМОГАТЬ УКРАИНЕ ИЛИ НЕТ. ТУТ ВОПРОС ПРОЩЕ. ЭТО
Dialogue: 0,0:01:29.75,0:01:32.23,Caption,,0,0,0,,КРЕДИТ, КОТОРЫЙ РАССЧИТЫВАЮТ ПОЛУЧИТЬ ОБРАТНО,
Dialogue: 0,0:01:32.55,0:01:35.43,Caption,,0,0,0,,ИЛИ ПОЛИТИЧЕСКИ КРАСИВО ОФОРМЛЕННАЯ БЕЗВОЗВРАТНАЯ
Dialogue: 0,0:01:35.43,0:01:38.79,Caption,,0,0,0,,ПОМОЩЬ? ПОТОМУ ЧТО САМА УКРАИНА ТЕМ ВРЕМЕНЕМ ПОДНИМАЕТ
Dialogue: 0,0:01:38.87,0:01:41.99,Caption,,0,0,0,,СТАВКИ. ДВАДЦАТЬ ДЕВЯТОГО СЕНТЯБРЯ УКРАИНСКИЙ МИНФИН
Dialogue: 0,0:01:41.99,0:01:44.79,Caption,,0,0,0,,ГОВОРИЛ, ЧТО В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ СТРАНЕ
Dialogue: 0,0:01:44.79,0:01:47.59,Caption,,0,0,0,,ПОНАДОБИТСЯ ПЯТЬДЕСЯТ ДВА ЦЕЛЫХ ШЕСТЬ ДЕСЯТЫХ
Dialogue: 0,0:01:47.59,0:01:50.47,Caption,,0,0,0,,МИЛЛИАРДА ДОЛЛАРОВ ИНОСТРАННОЙ ПОМОЩИ. ПРОХОДИТ
Dialogue: 0,0:01:50.47,0:01:54.55,Caption,,0,0,0,,СОВСЕМ НЕМНОГО ВРЕМЕНИ, И ЗЕЛЕНСКИЙ УЖЕ НАЗЫВАЕТ СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ
Dialogue: 0,0:01:54.55,0:01:56.95,Caption,,0,0,0,,ЕВРО. НЕ ПРОСТО БОЛЬШЕ. В ДВА С ЛИШНИМ
Dialogue: 0,0:01:56.95,0:02:00.95,Caption,,0,0,0,,РАЗА БОЛЬШЕ, ПРИЧЁМ ЕЩЁ И В ДРУГОЙ ВАЛЮТЕ. КАТЕГОРИИ РАСХОДОВ
Dialogue: 0,0:02:00.95,0:02:04.15,Caption,,0,0,0,,ЗДЕСЬ РАЗЛИЧАЮТСЯ, ТАК ЧТО ЭТО НЕ БУХГАЛТЕРСКОЕ СРАВНЕНИЕ ОДИН К
Dialogue: 0,0:02:04.15,0:02:07.35,Caption,,0,0,0,,ОДНОМУ. НО НАПРАВЛЕНИЕ ВИДНО ПРЕКРАСНО. АППЕТИТ
Dialogue: 0,0:02:07.35,0:02:09.83,Caption,,0,0,0,,ПРИХОДИТ ВО ВРЕМЯ ЕДЫ. И ВОТ ТУТ ХОЧЕТСЯ
Dialogue: 0,0:02:09.83,0:02:13.03,Caption,,0,0,0,,ВСПОМНИТЬ ОДНУ СТАРУЮ ИСТОРИЮ. ВО ВРЕМЕНА ЯНУКОВИЧА
Dialogue: 0,0:02:13.03,0:02:15.19,Caption,,0,0,0,,НА ПЕРЕОРИЕНТАЦИЮ УКРАИНСКОЙ ЭКОНОМИКИ ПОД
Dialogue: 0,0:02:15.19,0:02:17.91,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ИНТЕГРАЦИЮ НАЗЫВАЛИ СТО ВОСЕМЬДЕСЯТ
Dialogue: 0,0:02:17.91,0:02:21.11,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ТОГДА ДЕНЕГ НЕ ДАЛИ. А ПОТОМ
Dialogue: 0,0:02:21.11,0:02:23.91,Caption,,0,0,0,,НАЧАЛАСЬ СОВСЕМ ДРУГАЯ ЭПОХА. НАШЛИСЬ КРЕДИТЫ.
Dialogue: 0,0:02:26.20,0:02:29.40,Caption,,0,0,0,,НАШЛИСЬ ВОЕННЫЕ ПРОГРАММЫ. НАШЛИСЬ НОВЫЕ ПАКЕТЫ.
Dialogue: 0,0:02:29.72,0:02:32.44,Caption,,0,0,0,,НАШЛИСЬ ДЕСЯТКИ И СОТНИ МИЛЛИАРДОВ НА ПОДДЕРЖКУ
Dialogue: 0,0:02:32.44,0:02:37.32,Caption,,0,0,0,,УКРАИНЫ В УСЛОВИЯХ ВОЙНЫ. И ВОТ ЗДЕСЬ МОЯ ВЕРСИЯ ПРОСТАЯ. УКРАИНА ЗАПАДУ
Dialogue: 0,0:02:37.40,0:02:39.80,Caption,,0,0,0,,НУЖНА БЫЛА НЕ КАК ПРОЦВЕТАЮЩАЯ САМОСТОЯТЕЛЬНАЯ
Dialogue: 0,0:02:39.80,0:02:43.48,Caption,,0,0,0,,СТРАНА. УКРАИНА НУЖНА КАК ТАРАН НА РОССИЮ. ПОЭТОМУ
Dialogue: 0,0:02:43.56,0:02:46.04,Caption,,0,0,0,,НА МИРНУЮ ПЕРЕСТРОЙКУ ЭКОНОМИКИ ОГРОМНАЯ СУММА
Dialogue: 0,0:02:46.04,0:02:50.12,Caption,,0,0,0,,ОКАЗАЛАСЬ НЕПОДЪЁМНОЙ, А НА ВОЙНУ СУММЫ СОВЕРШЕННО ДРУГОГО ПОРЯДКА СТАЛИ
Dialogue: 0,0:02:50.12,0:02:55.16,Caption,,0,0,0,,НОРМОЙ. МОЖЕТЕ СОГЛАШАТЬСЯ, МОЖЕТЕ СПОРИТЬ. НО ТОГДА ОБЪЯСНИТЕ ЭТУ АРИФМЕТИКУ
Dialogue: 0,0:02:55.16,0:02:57.88,Caption,,0,0,0,,ИНАЧЕ. ТЕМ БОЛЕЕ ЧТО ВНУТРИ САМОЙ УКРАИНЫ ДЕНЬГИ
Dialogue: 0,0:02:57.88,0:03:00.92,Caption,,0,0,0,,ТОЖЕ ЖИВУТ ОЧЕНЬ ИНТЕРЕСНОЙ ЖИЗНЬЮ. НАРДЕП СЕРГЕЙ
Dialogue: 0,0:03:00.92,0:03:03.96,Caption,,0,0,0,,НАГОРНЯК ЗАЯВИЛ, ЧТО ИЗ ВОСЬМИСОТ МИЛЛИОНОВ ГРИВЕН,
Dialogue: 0,0:03:04.20,0:03:06.52,Caption,,0,0,0,,ВЫДЕЛЕННЫХ НА ЗАЩИТУ ЭНЕРГЕТИЧЕСКИХ ОБЪЕКТОВ
Dialogue: 0,0:03:06.52,0:03:10.76,Caption,,0,0,0,,КИЕВСКОЙ ОБЛАСТИ, СЕМЬСОТ МИЛЛИОНОВ БЫЛИ УКРАДЕНЫ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:03:10.96,0:03:14.76,Caption,,0,0,0,,АВАНСЫ УХОДИЛИ НА ФИРМЫ, КОТОРЫЕ ИСПОЛЬЗОВАЛИСЬ ДЛЯ ОБНАЛИЧИВАНИЯ,
Dialogue: 0,0:03:15.00,0:03:17.32,Caption,,0,0,0,,А ДАЛЬШЕ ДЕНЬГИ ПЕРЕДАВАЛИСЬ БЕНЕФИЦИАРАМ,
Dialogue: 0,0:03:17.48,0:03:19.40,Caption,,0,0,0,,СВЯЗАННЫМ С ЗАКЛЮЧЕНИЕМ КОНТРАКТОВ.
Dialogue: 0,0:03:19.95,0:03:22.44,Caption,,0,0,0,,И ВСЁ ЭТО ЗВУЧИТ НА ФОНЕ ПОСТОЯННЫХ РАЗГОВОРОВ
Dialogue: 0,0:03:22.52,0:03:25.80,Caption,,0,0,0,,О ТОМ, ЧТО СВЕТА НЕТ ИЗ ЗА ОГРОМНОГО КОЛИЧЕСТВА УДАРОВ
Dialogue: 0,0:03:25.88,0:03:29.64,Caption,,0,0,0,,ПО ЭНЕРГЕТИКЕ. УДАРЫ ЕСТЬ. РАЗРУШЕНИЯ ЕСТЬ. А
Dialogue: 0,0:03:29.64,0:03:31.88,Caption,,0,0,0,,НАГОРНЯК ПАРАЛЛЕЛЬНО ОПИСЫВАЕТ СХЕМУ,
Dialogue: 0,0:03:32.04,0:03:35.72,Caption,,0,0,0,,В КОТОРОЙ СОТНИ МИЛЛИОНОВ, ПРЕДНАЗНАЧЕННЫХ ДЛЯ ЗАЩИТЫ ЭНЕРГЕТИКИ,
Dialogue: 0,0:03:35.96,0:03:38.68,Caption,,0,0,0,,УХОДЯТ СОВСЕМ НЕ ТУДА. ПОЛУЧАЕТСЯ ВЕЛИКОЛЕПНАЯ
Dialogue: 0,0:03:38.68,0:03:43.83,Caption,,0,0,0,,КОНСТРУКЦИЯ. СНАРУЖИ ТРЕБУЮТ ВСЁ БОЛЬШЕ ДЕНЕГ НА СПАСЕНИЕ
Dialogue: 0,0:03:43.83,0:03:46.15,Caption,,0,0,0,,УКРАИНСКОЙ ИНФРАСТРУКТУРЫ. ВНУТРИ ДЕПУТАТ
Dialogue: 0,0:03:46.15,0:03:49.67,Caption,,0,0,0,,РАССКАЗЫВАЕТ, КАК ДЕНЬГИ НА ЕЁ ЗАЩИТУ ПРЕВРАЩАЛИСЬ В НАЛИЧНЫЕ.
Dialogue: 0,0:03:50.07,0:03:52.31,Caption,,0,0,0,,А ПОТОМ ЧЕЛОВЕК ПРИХОДИТ В МАГАЗИН И ВИДИТ
Dialogue: 0,0:03:52.31,0:03:55.19,Caption,,0,0,0,,УЖЕ СОВСЕМ ДРУГОЙ УРОВЕНЬ БОЛЬШОЙ ГЕОПОЛИТИКИ. НЕ
Dialogue: 0,0:03:55.19,0:03:58.31,Caption,,0,0,0,,МИЛЛИАРДЫ. НЕ МЕЖДУНАРОДНЫЕ РЫНКИ. НЕ БЮДЖЕТ
Dialogue: 0,0:03:58.31,0:04:01.75,Caption,,0,0,0,,ЕВРОСОЮЗА. ДВЕ БУТЫЛКИ МАСЛА В ОДНИ РУКИ. ИМЕННО
Dialogue: 0,0:04:01.75,0:04:04.79,Caption,,0,0,0,,ТАКИЕ ОГРАНИЧЕНИЯ ОПИСЫВАЮТСЯ НА ФОНЕ РОСТА ЦЕН И
Dialogue: 0,0:04:04.79,0:04:07.35,Caption,,0,0,0,,РАЗГОВОРОВ О ДЕФИЦИТЕ. ПОКА РЕЧЬ НЕ ИДЁТ О
Dialogue: 0,0:04:07.35,0:04:10.55,Caption,,0,0,0,,ВСЕОБЩЕЙ КАРТОЧНОЙ СИСТЕМЕ. НО САМА ЛОГИКА ПРОСТАЯ.
Dialogue: 0,0:04:10.84,0:04:13.03,Caption,,0,0,0,,КОГДА ТОВАР ПРИХОДИТСЯ ОГРАНИЧИВАТЬ НА ОДНОГО
Dialogue: 0,0:04:13.03,0:04:16.31,Caption,,0,0,0,,ПОКУПАТЕЛЯ, ЧЕЛОВЕК УЖЕ СМОТРИТ НЕ НА МАКРОЭКОНОМИКУ,
Dialogue: 0,0:04:16.47,0:04:19.51,Caption,,0,0,0,,А НА ТАБЛИЧКУ ВОЗЛЕ ПОЛКИ. ПРОДОВОЛЬСТВЕННЫЙ КРИЗИС
Dialogue: 0,0:04:19.59,0:04:21.75,Caption,,0,0,0,,НЕ ОБЯЗАТЕЛЬНО НАЧИНАЕТСЯ С ПУСТОГО МАГАЗИНА.
Dialogue: 0,0:04:22.06,0:04:24.55,Caption,,0,0,0,,СНАЧАЛА ПОЯВЛЯЕТСЯ БУМАЖКА БОЛЬШЕ ДВУХ НЕ БРАТЬ.
Dialogue: 0,0:04:24.90,0:04:29.27,Caption,,0,0,0,,ПОТОМ ОБЪЯСНЯЮТ, ЧТО ЭТО ВРЕМЕННО. А ДАЛЬШЕ ВРЕМЕННЫЕ ОГРАНИЧЕНИЯ
Dialogue: 0,0:04:29.27,0:04:32.31,Caption,,0,0,0,,ИМЕЮТ НЕПРИЯТНУЮ ПРИВЫЧКУ ЗАДЕРЖИВАТЬСЯ. НА ЭТОМ
Dialogue: 0,0:04:32.31,0:04:35.03,Caption,,0,0,0,,ФОНЕ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ПРЕКРАСНАЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:04:35.31,0:04:38.15,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ОПЛАЧИВАЮТ РАКЕТЫ PATRIOT ДЛЯ УКРАИНЫ.
Dialogue: 0,0:04:38.35,0:04:41.75,Caption,,0,0,0,,ДЕНЬГИ ЕСТЬ. РАКЕТЫ ОПЛАЧЕНЫ. НО ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:04:41.98,0:04:44.79,Caption,,0,0,0,,ЧТО СОЕДИНЁННЫЕ ШТАТЫ ВСЁ РАВНО ДОЛЖНЫ РАЗРЕШИТЬ ИХ
Dialogue: 0,0:04:44.79,0:04:47.03,Caption,,0,0,0,,ПЕРЕДАЧУ. ТО ЕСТЬ ЕВРОПА ПЛАТИТ,
Dialogue: 0,0:04:47.23,0:04:50.95,Caption,,0,0,0,,КИЕВ ЖДЁТ, А ПОСЛЕДНЕЕ СЛОВО ВСЁ РАВНО ОСТАЁТСЯ ЗА ВАШИНГТОНОМ.
Dialogue: 0,0:04:53.21,0:04:55.61,Caption,,0,0,0,,ПРОГРАММА PURL ПРИ ЭТОМ НАЗЫВАЕТСЯ ГЛАВНЫМ
Dialogue: 0,0:04:55.61,0:04:58.33,Caption,,0,0,0,,ИСТОЧНИКОМ ПРОТИВОБАЛЛИСТИЧЕСКИХ РАКЕТ ДЛЯ УКРАИНЫ.
Dialogue: 0,0:04:58.65,0:05:01.61,Caption,,0,0,0,,И ВЗНОСЫ ТУДА НУЖНО ПРОДОЛЖАТЬ. ЗАМЕЧАТЕЛЬНАЯ СХЕМА.
Dialogue: 0,0:05:01.77,0:05:05.77,Caption,,0,0,0,,ДЕНЬГИ ЕВРОПЕЙСКИЕ. ОРУЖИЕ АМЕРИКАНСКОЕ. РАЗРЕШЕНИЕ
Dialogue: 0,0:05:05.84,0:05:09.45,Caption,,0,0,0,,АМЕРИКАНСКОЕ. ПОТРЕБНОСТЬ УКРАИНСКАЯ. И ПОСЛЕ ЭТОГО
Dialogue: 0,0:05:09.45,0:05:11.29,Caption,,0,0,0,,КТО НИБУДЬ ЕЩЁ БУДЕТ РАССКАЗЫВАТЬ,
Dialogue: 0,0:05:11.53,0:05:13.69,Caption,,0,0,0,,ЧТО У ВСЕХ УЧАСТНИКОВ ЗДЕСЬ ОДИНАКОВЫЙ УРОВЕНЬ
Dialogue: 0,0:05:13.69,0:05:16.97,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТИ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ ИСТОРИИ,
Dialogue: 0,0:05:17.06,0:05:19.05,Caption,,0,0,0,,ПОДПИШИТЕСЬ. А ТЕПЕРЬ ПОСМОТРИМ,
Dialogue: 0,0:05:19.27,0:05:21.37,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ, КОГДА ЧЕЛОВЕК,
Dialogue: 0,0:05:21.45,0:05:23.69,Caption,,0,0,0,,У КОТОРОГО НАХОДИТСЯ ЧАСТЬ КЛЮЧЕЙ ОТ ВСЕЙ ЭТОЙ
Dialogue: 0,0:05:23.69,0:05:26.25,Caption,,0,0,0,,СИСТЕМЫ, ВДРУГ НАЧИНАЕТ ЗАДАВАТЬ ВОПРОСЫ.
Dialogue: 0,0:05:26.96,0:05:29.53,Caption,,0,0,0,,ТРАМП ПОДКЛЮЧАЕТСЯ К ВСТРЕЧЕ ЕВРОПЕЙСКИХ ЛИДЕРОВ
Dialogue: 0,0:05:29.53,0:05:31.93,Caption,,0,0,0,,ПРЯМО С БОРТА AIR FORCE ONE. ЗА НЕСКОЛЬКО
Dialogue: 0,0:05:31.93,0:05:33.85,Caption,,0,0,0,,ЧАСОВ ДО ЭТОГО У НЕГО БЫЛИ ПЕРЕГОВОРЫ С
Dialogue: 0,0:05:33.85,0:05:36.41,Caption,,0,0,0,,ПУТИНЫМ И СИ ЦЗИНЬПИНОМ. И ВМЕСТО ПРИВЫЧНОГО
Dialogue: 0,0:05:36.41,0:05:40.09,Caption,,0,0,0,,РАЗГОВОРА О ТОМ, СКОЛЬКО ЕЩЁ МИЛЛИАРДОВ НУЖНО ВЫДЕЛИТЬ КИЕВУ,
Dialogue: 0,0:05:40.31,0:05:42.97,Caption,,0,0,0,,ОН НАЧИНАЕТ СОМНЕВАТЬСЯ В ЦЕЛЕСООБРАЗНОСТИ НОВЫХ
Dialogue: 0,0:05:42.97,0:05:45.05,Caption,,0,0,0,,РАСХОДОВ И ГОВОРИТ ЕВРОПЕЙЦАМ,
Dialogue: 0,0:05:45.28,0:05:48.33,Caption,,0,0,0,,ЧТО НУЖНО СОСРЕДОТОЧИТЬСЯ НА МИРНЫХ ПЕРЕГОВОРАХ. ТО
Dialogue: 0,0:05:48.41,0:05:51.69,Caption,,0,0,0,,ЕСТЬ ПОЛУЧАЕТСЯ ПРЕКРАСНАЯ СЦЕНА. ЕВРОПА ОБСУЖДАЕТ,
Dialogue: 0,0:05:51.77,0:05:54.65,Caption,,0,0,0,,ГДЕ ВЗЯТЬ ЕЩЁ ДЕНЕГ. УКРАИНА ОБЪЯСНЯЕТ,
Dialogue: 0,0:05:54.77,0:05:57.61,Caption,,0,0,0,,ПОЧЕМУ ДЕНЕГ НУЖНО ЕЩЁ БОЛЬШЕ. А ПРЕЗИДЕНТ
Dialogue: 0,0:05:57.61,0:06:00.01,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ ВЛЕЗАЕТ В РАЗГОВОР И СПРАШИВАЕТ
Dialogue: 0,0:06:00.01,0:06:02.33,Caption,,0,0,0,,МЫ ВООБЩЕ ТОЧНО ХОТИМ ПРОДОЛЖАТЬ ОПЛАЧИВАТЬ ЭТУ
Dialogue: 0,0:06:02.41,0:06:08.53,Caption,,0,0,0,,ИСТОРИЮ В ТАКОМ ВИДЕ? ПОСЛЕ ЭТОГО СПОР О СОРОКА ПЯТИ МИЛЛИАРДАХ ПЕРЕСТАЁТ
Dialogue: 0,0:06:08.61,0:06:11.33,Caption,,0,0,0,,БЫТЬ ПРОСТО БУХГАЛТЕРИЕЙ. ЭТО УЖЕ ВОПРОС О ТОМ,
Dialogue: 0,0:06:11.49,0:06:14.37,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ СОЮЗНИКИ ГОТОВЫ ПЛАТИТЬ ЗА ПРОДОЛЖЕНИЕ
Dialogue: 0,0:06:14.37,0:06:17.49,Caption,,0,0,0,,НЫНЕШНЕГО КУРСА. И ТУТ ЖЕ РЯДОМ ПОЯВЛЯЕТСЯ ИСТОРИЯ
Dialogue: 0,0:06:17.49,0:06:19.97,Caption,,0,0,0,,ДАВИДА АРАХАМИИ. ЕГО СТАРШИЙ СЫН,
Dialogue: 0,0:06:20.10,0:06:24.29,Caption,,0,0,0,,ПО ДАННЫМ СООБЩЕНИЯ, НАХОДИТСЯ В ЧЕХИИ И ПРЕДПОЛОЖИТЕЛЬНО ЖИВЁТ В БРНО.
Dialogue: 0,0:06:24.77,0:06:27.33,Caption,,0,0,0,,САМ ФАКТ ПРОЖИВАНИЯ СЫНА ПОЛИТИКА ЗА ГРАНИЦЕЙ
Dialogue: 0,0:06:27.33,0:06:29.97,Caption,,0,0,0,,НАРУШЕНИЯ НЕ ПОДТВЕРЖДАЕТ. НО ЭКИПАЖ,
Dialogue: 0,0:06:30.12,0:06:33.97,Caption,,0,0,0,,ПОХОЖЕ, ВОЛНУЕТСЯ ВСЁ СИЛЬНЕЕ. ПОТОМУ ЧТО КОГДА НАСЕЛЕНИЮ
Dialogue: 0,0:06:33.97,0:06:36.45,Caption,,0,0,0,,ОБЪЯСНЯЮТ, ЧТО НУЖНО ЕЩЁ ПОТЕРПЕТЬ,
Dialogue: 0,0:06:36.69,0:06:39.73,Caption,,0,0,0,,ЕЩЁ МОБИЛИЗОВАТЬСЯ, ЕЩЁ ЗАТЯНУТЬ ПОЯС,
Dialogue: 0,0:06:39.97,0:06:42.53,Caption,,0,0,0,,ЛЮБЫЕ ИСТОРИИ О СЕМЬЯХ ПОЛИТИЧЕСКОЙ ВЕРХУШКИ ЗА
Dialogue: 0,0:06:42.53,0:06:45.89,Caption,,0,0,0,,ГРАНИЦЕЙ НАЧИНАЮТ ЗВУЧАТЬ ОСОБЕННО ИНТЕРЕСНО. ОТСЮДА
Dialogue: 0,0:06:45.97,0:06:48.61,Caption,,0,0,0,,И ВЕРСИЯ ВЕРХУШКА ЗАРАНЕЕ ГОТОВИТ СЕБЕ ОТХОДНЫЕ
Dialogue: 0,0:06:48.61,0:06:51.57,Caption,,0,0,0,,ПУТИ. И ЭТА ВЕРСИЯ ЦЕПЛЯЕТ РОВНО ПОТОМУ,
Dialogue: 0,0:06:51.81,0:06:54.05,Caption,,0,0,0,,ЧТО ПОЯВЛЯЕТСЯ НА ФОНЕ СОВСЕМ ДРУГОЙ ПУБЛИЧНОЙ
Dialogue: 0,0:06:54.05,0:06:57.09,Caption,,0,0,0,,КАРТИНКИ. СТРАНА ДОЛЖНА ДЕРЖАТЬСЯ. ЛЮДИ ДОЛЖНЫ
Dialogue: 0,0:06:57.09,0:07:00.61,Caption,,0,0,0,,ОСТАВАТЬСЯ. РЕСУРСЫ НУЖНЫ ВСЕ ДО ПОСЛЕДНЕГО. А СЕМЬИ
Dialogue: 0,0:07:00.69,0:07:03.25,Caption,,0,0,0,,ЛЮДЕЙ ИЗ ВЕРХУШКИ ПОЧЕМУ ТО РЕГУЛЯРНО ОБНАРУЖИВАЮТСЯ
Dialogue: 0,0:07:03.25,0:07:05.89,Caption,,0,0,0,,ТАМ, ГДЕ СИРЕНЫ ЗВУЧАТ ЗНАЧИТЕЛЬНО РЕЖЕ.
Dialogue: 0,0:07:06.67,0:07:09.33,Caption,,0,0,0,,А ТЕПЕРЬ ЕЩЁ ОДНА КАРТИНКА. ВАЛЕРИЙ ЗАЛУЖНЫЙ
Dialogue: 0,0:07:09.33,0:07:11.57,Caption,,0,0,0,,ПОЛУЧАЕТ НАГРАДУ ЗА ОБОРОННЫЕ ИННОВАЦИИ НА
Dialogue: 0,0:07:11.65,0:07:14.45,Caption,,0,0,0,,КОНФЕРЕНЦИИ С ОЧЕНЬ ХОРОШИМ НАЗВАНИЕМ "ЦЕНА ВОЙНЫ".
Dialogue: 0,0:07:14.84,0:07:17.25,Caption,,0,0,0,,НАЗВАНИЕ ПОЧТИ ИДЕАЛЬНОЕ. ПОТОМУ ЧТО ЦЕНА
Dialogue: 0,0:07:17.25,0:07:23.36,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО У ВСЕХ РАЗНАЯ. ДЛЯ ОДНОЙ СТРАНЫ ЭТО РАЗРУШЕННАЯ ЭНЕРГЕТИКА,
Dialogue: 0,0:07:23.44,0:07:26.16,Caption,,0,0,0,,МОБИЛИЗАЦИЯ, ПОГИБШИЕ, РАНЕНЫЕ,
Dialogue: 0,0:07:26.40,0:07:29.44,Caption,,0,0,0,,ДОЛГИ И МИЛЛИОНЫ ЛЮДЕЙ ЗА ГРАНИЦЕЙ. ДЛЯ ДРУГОЙ
Dialogue: 0,0:07:29.52,0:07:33.20,Caption,,0,0,0,,ЭТО КОНФЕРЕНЦИЯ, СТАТУЭТКА, РЕЧЬ И СЛОВА О БОЛЬШОЙ ЧЕСТИ.
Dialogue: 0,0:07:33.86,0:07:36.56,Caption,,0,0,0,,И ТУТ НАПРАШИВАЕТСЯ ЖЁСТКОЕ СРАВНЕНИЕ "ИНДЕЕЦ",
Dialogue: 0,0:07:36.80,0:07:41.04,Caption,,0,0,0,,КОТОРОМУ ВЫДАЛИ БУСЫ ЗА ТО, ЧТО ОН ХОРОШО ВОЕВАЛ НА СТОРОНЕ БЕЛЫХ ЛЮДЕЙ.
Dialogue: 0,0:07:41.35,0:07:44.80,Caption,,0,0,0,,ЖЁСТКО. НО ИМЕННО ПОЭТОМУ СРАВНЕНИЕ И ЦЕПЛЯЕТ. КТО
Dialogue: 0,0:07:44.88,0:07:47.68,Caption,,0,0,0,,ПЛАТИТ НАСТОЯЩУЮ ЦЕНУ, А КТО ВРУЧАЕТ НАГРАДЫ?
Dialogue: 0,0:07:47.91,0:07:50.16,Caption,,0,0,0,,И ВОТ ПОСЛЕ ВСЕГО ЭТОГО ВОЗВРАЩАЕМСЯ К САМОМУ
Dialogue: 0,0:07:50.16,0:07:52.80,Caption,,0,0,0,,ИНТЕРЕСНОМУ. ЗЕЛЕНСКИЙ БУКВАЛЬНО ЗАЯВИЛ,
Dialogue: 0,0:07:53.04,0:07:55.44,Caption,,0,0,0,,ЧТО РОССИЯ ПРОИГРАЛА УКРАИНЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:07:55.44,0:07:58.72,Caption,,0,0,0,,ШЕСТОЙ ГОД НА ПОЛЕ БОЯ. ХОРОШО. ПРОТИВНИК
Dialogue: 0,0:07:58.72,0:08:01.60,Caption,,0,0,0,,ПРОИГРЫВАЕТ. ЕГО ОПЕРАЦИИ ПРОВАЛЕНЫ. УКРАИНА
Dialogue: 0,0:08:01.60,0:08:04.96,Caption,,0,0,0,,ДЕРЖИТСЯ. ЕВРОПА ЕДИНА. ТОГДА ОБЪЯСНИТЕ ПРОСТУЮ
Dialogue: 0,0:08:05.04,0:08:08.00,Caption,,0,0,0,,ВЕЩЬ. ЗАЧЕМ ПЯТНАДЦАТИЛЕТНИХ ШКОЛЬНИЦ УЖЕ НАЧИНАЮТ
Dialogue: 0,0:08:08.08,0:08:09.52,Caption,,0,0,0,,ЗНАКОМИТЬ С ВОЕННОЙ ПОДГОТОВКОЙ?
Dialogue: 0,0:08:09.88,0:08:11.92,Caption,,0,0,0,,ЕСЛИ ВАШ ВРАГ ДЕЙСТВИТЕЛЬНО НА КОЛЕНЯХ,
Dialogue: 0,0:08:12.30,0:08:14.64,Caption,,0,0,0,,ЕСЛИ ОН ПРОИГРЫВАЕТ И ПЕРСПЕКТИВ У НЕГО НЕТ,
Dialogue: 0,0:08:14.88,0:08:16.56,Caption,,0,0,0,,ЗАЧЕМ ЗАГЛЯДЫВАТЬ УЖЕ В ШКОЛЫ?
Dialogue: 0,0:08:16.88,0:08:18.96,Caption,,0,0,0,,ЗАЧЕМ ОДНОВРЕМЕННО ОБСУЖДАТЬ СНИЖЕНИЕ
Dialogue: 0,0:08:18.96,0:08:22.96,Caption,,0,0,0,,МОБИЛИЗАЦИОННОГО ВОЗРАСТА, ПЕРЕСМАТРИВАТЬ БРОНИРОВАНИЕ И ОТСРОЧКИ,
Dialogue: 0,0:08:23.20,0:08:25.76,Caption,,0,0,0,,ВСЁ ГРОМЧЕ ГОВОРИТЬ О СЛУЖБЕ ЖЕНЩИН И ПАРАЛЛЕЛЬНО
Dialogue: 0,0:08:25.76,0:08:29.44,Caption,,0,0,0,,ПРИУЧАТЬ ДЕВОЧЕК К МЫСЛИ, ЧТО ВОЙНА СТАНЕТ ЧАСТЬЮ ИХ БУДУЩЕГО?
Dialogue: 0,0:08:29.76,0:08:32.32,Caption,,0,0,0,,ЧТО ТО НЕ ПЛЯШЕТ. И ДАЛЬШЕ ЕЩЁ ИНТЕРЕСНЕЕ.
Dialogue: 0,0:08:34.60,0:08:37.40,Caption,,0,0,0,,ПОСТЕПЕННО СТИРАЕТСЯ ГРАНИЦА МЕЖДУ ОБЫЧНЫМ ШКОЛЬНЫМ
Dialogue: 0,0:08:37.40,0:08:40.36,Caption,,0,0,0,,ОБРАЗОВАНИЕМ И ПОДГОТОВКОЙ БУДУЩЕГО МОБИЛИЗАЦИОННОГО
Dialogue: 0,0:08:40.44,0:08:43.88,Caption,,0,0,0,,РЕЗЕРВА. СЕГОДНЯ НАВЫКИ. ЗАВТРА ДРУГОЙ ВОЗРАСТ.
Dialogue: 0,0:08:44.07,0:08:49.24,Caption,,0,0,0,,ПОТОМ ЕЩЁ ОДНО ОБЪЯСНЕНИЕ, ПОЧЕМУ ЭТО НЕОБХОДИМО. В ТОМ ЖЕ СООБЩЕНИИ ПРИВОДИТСЯ
Dialogue: 0,0:08:49.32,0:08:51.64,Caption,,0,0,0,,ОЦЕНКА ПРИМЕРНО В ТРИДЦАТЬ ПЯТЬ ТЫСЯЧ ПОТЕРЬ В
Dialogue: 0,0:08:51.64,0:08:56.28,Caption,,0,0,0,,МЕСЯЦ И УТВЕРЖДАЕТСЯ, ЧТО ЭТОТ УРОВЕНЬ УЖЕ ПРЕВЫШАЕТ ТЕМПЫ ПРИНУДИТЕЛЬНОГО
Dialogue: 0,0:08:56.28,0:08:59.24,Caption,,0,0,0,,ПОПОЛНЕНИЯ АРМИИ. ЭТО НЕПОДТВЕРЖДЁННАЯ ОЦЕНКА,
Dialogue: 0,0:08:59.48,0:09:02.28,Caption,,0,0,0,,А НЕ ОФИЦИАЛЬНАЯ СТАТИСТИКА. НО ГЛАВНЫЙ ВОПРОС ОТ
Dialogue: 0,0:09:02.28,0:09:04.92,Caption,,0,0,0,,ЭТОГО НИКУДА НЕ ИСЧЕЗАЕТ. ЕСЛИ ВСЁ НАСТОЛЬКО
Dialogue: 0,0:09:04.92,0:09:08.44,Caption,,0,0,0,,УСПЕШНО, ЗАЧЕМ ВСЁ ГЛУБЖЕ ЗАЛЕЗАТЬ В БУДУЩИЕ ПОКОЛЕНИЯ?
Dialogue: 0,0:09:08.84,0:09:11.16,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ПОСТАВЬТЕ РЯДОМ ВСЕ ЭТИ ВЕЩИ.
Dialogue: 0,0:09:11.38,0:09:14.20,Caption,,0,0,0,,НЕ ОДНУ НОВОСТЬ. НЕ ОДНУ ЦИФРУ. НЕ ОДНУ
Dialogue: 0,0:09:14.20,0:09:18.12,Caption,,0,0,0,,ЦИТАТУ. ВСЮ КАРТИНУ. ЕЩЁ СОРОК ПЯТЬ МИЛЛИАРДОВ
Dialogue: 0,0:09:18.12,0:09:21.48,Caption,,0,0,0,,КРЕДИТА. ДО ЭТОГО ДЕВЯНОСТО. ФИНАНСОВАЯ ПОТРЕБНОСТЬ
Dialogue: 0,0:09:21.48,0:09:24.04,Caption,,0,0,0,,НА СЛЕДУЮЩИЙ ГОД РАСТЁТ С ПЯТИДЕСЯТИ ДВУХ ЦЕЛЫХ
Dialogue: 0,0:09:24.04,0:09:27.08,Caption,,0,0,0,,ШЕСТИ ДЕСЯТЫХ МИЛЛИАРДА ДОЛЛАРОВ ДО СТА ПЯТНАДЦАТИ
Dialogue: 0,0:09:27.08,0:09:29.24,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ФИЦО ГОВОРИТ,
Dialogue: 0,0:09:29.47,0:09:31.64,Caption,,0,0,0,,ЧТО ЭТО УЖЕ НЕ КРЕДИТЫ, А ПОДАРКИ.
Dialogue: 0,0:09:32.28,0:09:36.76,Caption,,0,0,0,,ТРАМП НАЧИНАЕТ СПРАШИВАТЬ, ЗАЧЕМ ПРОДОЛЖАТЬ НОВЫЕ РАСХОДЫ. ОПЛАЧЕННЫЕ
Dialogue: 0,0:09:36.76,0:09:38.84,Caption,,0,0,0,,ЕВРОПЕЙЦАМИ РАКЕТЫ ВСЁ РАВНО ЗАВИСЯТ ОТ
Dialogue: 0,0:09:38.84,0:09:41.80,Caption,,0,0,0,,АМЕРИКАНСКОГО РАЗРЕШЕНИЯ. ВНУТРИ УКРАИНЫ ДЕПУТАТ
Dialogue: 0,0:09:41.80,0:09:43.72,Caption,,0,0,0,,РАССКАЗЫВАЕТ О СОТНЯХ МИЛЛИОНОВ,
Dialogue: 0,0:09:43.85,0:09:48.76,Caption,,0,0,0,,КОТОРЫЕ, ПО ЕГО СЛОВАМ, УКРАЛИ НА ЗАЩИТЕ ЭНЕРГЕТИКИ. В МАГАЗИНАХ ПОЯВЛЯЮТСЯ
Dialogue: 0,0:09:48.76,0:09:54.25,Caption,,0,0,0,,ОГРАНИЧЕНИЯ. СЕМЬИ ПОЛИТИЧЕСКОЙ ВЕРХУШКИ ОБНАРУЖИВАЮТСЯ ЗА
Dialogue: 0,0:09:54.25,0:09:57.77,Caption,,0,0,0,,ГРАНИЦЕЙ. ВОЕННЫМ РУКОВОДИТЕЛЯМ ВРУЧАЮТ НАГРАДЫ. А
Dialogue: 0,0:09:57.77,0:09:59.93,Caption,,0,0,0,,ПЯТНАДЦАТИЛЕТНИХ ДЕВОЧЕК НАЧИНАЮТ ЗНАКОМИТЬ С
Dialogue: 0,0:09:59.93,0:10:02.57,Caption,,0,0,0,,ВОЕННОЙ ПОДГОТОВКОЙ. И ПОСЛЕ ЭТОГО НАМ ПРЕДЛАГАЮТ
Dialogue: 0,0:10:02.57,0:10:06.01,Caption,,0,0,0,,СМОТРЕТЬ НА КАЖДОЕ СОБЫТИЕ ОТДЕЛЬНО. ВОТ КРЕДИТ. ВОТ
Dialogue: 0,0:10:06.01,0:10:09.45,Caption,,0,0,0,,ПОМОЩЬ. ВОТ ЭНЕРГЕТИКА. ВОТ МОБИЛИЗАЦИЯ. ВОТ
Dialogue: 0,0:10:09.45,0:10:12.57,Caption,,0,0,0,,ОЧЕРЕДНАЯ КОНФЕРЕНЦИЯ. ОЧЕНЬ УДОБНО. ПОТОМУ ЧТО
Dialogue: 0,0:10:12.57,0:10:17.37,Caption,,0,0,0,,КОГДА СКЛАДЫВАЕШЬ ВСЁ ВМЕСТЕ, ВОЗНИКАЕТ УЖЕ СОВСЕМ ДРУГОЙ ВОПРОС. ЧТО ИМЕННО
Dialogue: 0,0:10:17.37,0:10:20.41,Caption,,0,0,0,,СТРОИЛИ ВСЕ ЭТИ ГОДЫ? ПРОЦВЕТАЮЩУЮ УКРАИНУ,
Dialogue: 0,0:10:20.49,0:10:22.57,Caption,,0,0,0,,КОТОРАЯ ПОСЛЕ ВОЙНЫ СТАНЕТ СИЛЬНЕЕ,
Dialogue: 0,0:10:22.65,0:10:27.37,Caption,,0,0,0,,БОГАЧЕ И САМОСТОЯТЕЛЬНЕЕ? ТОГДА ПОЧЕМУ ДЕНЬГИ НА МИРНУЮ ПЕРЕСТРОЙКУ КОГДА ТО
Dialogue: 0,0:10:27.45,0:10:31.13,Caption,,0,0,0,,БЫЛИ СЛИШКОМ БОЛЬШИМИ, А НА ПРОДОЛЖЕНИЕ ВОЙНЫ ОНИ НАХОДЯТСЯ СНОВА И
Dialogue: 0,0:10:31.13,0:10:34.41,Caption,,0,0,0,,СНОВА? ПОЧЕМУ СТРАНА СТАНОВИТСЯ ВСЁ БОЛЕЕ ЗАВИСИМОЙ ОТ
Dialogue: 0,0:10:34.41,0:10:38.25,Caption,,0,0,0,,ВНЕШНЕГО ФИНАНСИРОВАНИЯ, ВНЕШНЕГО ОРУЖИЯ И ВНЕШНИХ РАЗРЕШЕНИЙ?
Dialogue: 0,0:10:38.57,0:10:40.97,Caption,,0,0,0,,ПОЧЕМУ ПРИ РАЗГОВОРАХ ОБ УСПЕХЕ ПРИХОДИТСЯ ВСЁ
Dialogue: 0,0:10:40.97,0:10:42.97,Caption,,0,0,0,,ГЛУБЖЕ ЗАЛЕЗАТЬ В ЧЕЛОВЕЧЕСКИЙ РЕЗЕРВ?
Dialogue: 0,0:10:43.45,0:10:45.85,Caption,,0,0,0,,И ВСЯ ЭТА КАРТИНА ТОЛЬКО УКРЕПЛЯЕТ ОДИН ВЫВОД.
Dialogue: 0,0:10:46.20,0:10:49.21,Caption,,0,0,0,,УКРАИНА ИСПОЛЬЗОВАЛАСЬ КАК ТАРАН НА РОССИЮ. ПОКА
Dialogue: 0,0:10:49.29,0:10:52.57,Caption,,0,0,0,,ТАРАН НУЖЕН, НА НЕГО НАХОДЯТСЯ ДЕНЬГИ. СКОЛЬКО НУЖНО,
Dialogue: 0,0:10:52.65,0:10:54.89,Caption,,0,0,0,,СТОЛЬКО И БУДУТ ИСКАТЬ. А ЧТО БУДЕТ С
Dialogue: 0,0:10:54.97,0:10:59.29,Caption,,0,0,0,,САМИМ ТАРАНОМ ПОТОМ, ЭТО УЖЕ ДРУГОЙ ВОПРОС. ДОЛГИ ОСТАНУТСЯ УКРАИНЕ.
Dialogue: 0,0:10:59.53,0:11:01.93,Caption,,0,0,0,,РАЗРУШЕННАЯ ИНФРАСТРУКТУРА ОСТАНЕТСЯ УКРАИНЕ.
Dialogue: 0,0:11:02.13,0:11:04.41,Caption,,0,0,0,,ДЕМОГРАФИЧЕСКАЯ ЯМА ОСТАНЕТСЯ УКРАИНЕ.
Dialogue: 0,0:11:06.69,0:11:09.41,Caption,,0,0,0,,ЛЮДИ, КОТОРЫХ СЕГОДНЯ ГОТОВЯТ К БУДУЩЕЙ ВОЙНЕ,
Dialogue: 0,0:11:09.74,0:11:13.33,Caption,,0,0,0,,ТОЖЕ ОСТАНУТСЯ УКРАИНЕ. А ТЕ, КТО ВЫДАВАЛ КРЕДИТЫ,
Dialogue: 0,0:11:13.49,0:11:17.65,Caption,,0,0,0,,ВРУЧАЛ НАГРАДЫ, СОГЛАСОВЫВАЛ РАКЕТЫ И РАССКАЗЫВАЛ О ПРАВИЛЬНЫХ
Dialogue: 0,0:11:17.65,0:11:19.89,Caption,,0,0,0,,ЦЕЛЯХ, В ЛЮБОЙ МОМЕНТ СМОГУТ СКАЗАТЬ,
Dialogue: 0,0:11:19.97,0:11:22.93,Caption,,0,0,0,,ЧТО ОНИ ВСЕГО ЛИШЬ ПОМОГАЛИ. ВОТ ТОЛЬКО ПОМОЩЬ
Dialogue: 0,0:11:23.01,0:11:26.13,Caption,,0,0,0,,ОБЫЧНО ДОЛЖНА ДЕЛАТЬ ЧЕЛОВЕКА СИЛЬНЕЕ. А ЗДЕСЬ ЧЕМ
Dialogue: 0,0:11:26.13,0:11:28.61,Caption,,0,0,0,,БОЛЬШЕ ПОМОГАЮТ, ТЕМ БОЛЬШЕ ОН ДОЛЖЕН,
Dialogue: 0,0:11:28.69,0:11:31.57,Caption,,0,0,0,,ТЕМ БОЛЬШЕ ПРОСИТ И ТЕМ МОЛОЖЕ СТАНОВЯТСЯ ТЕ,
Dialogue: 0,0:11:31.76,0:11:33.89,Caption,,0,0,0,,КОГО НАЧИНАЮТ ГОТОВИТЬ К СЛЕДУЮЩЕМУ РАУНДУ.
