Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,У ВЛАДИМИРА ЗЕЛЕНСКОГО РЕЗКО ПРИБАВИЛОСЬ ПРИЧИН
Dialogue: 0,0:00:02.60,0:00:05.08,Caption,,0,0,0,,ОГЛЯДЫВАТЬСЯ ЧЕРЕЗ ПЛЕЧО. В МОСКВЕ,
Dialogue: 0,0:00:05.16,0:00:09.56,Caption,,0,0,0,,ПО ПОЯВИВШИМСЯ СООБЩЕНИЯМ, БОЛЬШЕ НЕ ДЕЙСТВУЕТ НЕГЛАСНОЕ ОГРАНИЧЕНИЕ НА ЕГО
Dialogue: 0,0:00:09.56,0:00:12.44,Caption,,0,0,0,,ФИЗИЧЕСКОЕ УСТРАНЕНИЕ. ПРИЧЁМ РЕЧЬ МОЖЕТ ИДТИ НЕ
Dialogue: 0,0:00:12.44,0:00:15.80,Caption,,0,0,0,,ТОЛЬКО О НЁМ, НО И О НЕСКОЛЬКИХ ЛЮДЯХ ИЗ ВЕРХУШКИ УКРАИНСКОЙ
Dialogue: 0,0:00:15.80,0:00:19.00,Caption,,0,0,0,,ВЛАСТИ. ПЯТЫЙ ГОД ЗЕЛЕНСКИЙ ВЫСТАВЛЯЕТ УСЛОВИЯ,
Dialogue: 0,0:00:19.15,0:00:21.88,Caption,,0,0,0,,ТРЕБУЕТ ГАРАНТИЙ И ОБЪЯСНЯЕТ СОЮЗНИКАМ,
Dialogue: 0,0:00:22.10,0:00:25.40,Caption,,0,0,0,,КАК ИМЕННО ОНИ ДОЛЖНЫ ЕГО СПАСАТЬ. ТЕПЕРЬ УСЛОВИЯ,
Dialogue: 0,0:00:25.62,0:00:28.92,Caption,,0,0,0,,ПОХОЖЕ, НАЧАЛИ ВЫСТАВЛЯТЬ УЖЕ ЕМУ. И ПОЧТИ В ТОТ
Dialogue: 0,0:00:29.00,0:00:30.92,Caption,,0,0,0,,ЖЕ МОМЕНТ ГЕНЕРАЛ СБУ ОБЪЯВИЛ,
Dialogue: 0,0:00:31.16,0:00:33.96,Caption,,0,0,0,,ЧТО ПРОТИВ РУКОВОДСТВА УКРАИНЫ РАЗВЁРНУТА ОПЕРАЦИЯ,
Dialogue: 0,0:00:34.17,0:00:37.40,Caption,,0,0,0,,В КОТОРОЙ УЧАСТВУЮТ НАБУ И САП. ПОЛУЧАЕТСЯ ДВОЙНАЯ
Dialogue: 0,0:00:37.48,0:00:40.20,Caption,,0,0,0,,ЛИКВИДАЦИЯ. СНАРУЖИ ОБСУЖДАЮТ ФИЗИЧЕСКУЮ,
Dialogue: 0,0:00:40.42,0:00:43.32,Caption,,0,0,0,,ИЗНУТРИ ЗАПУСКАЮТ АППАРАТНУЮ. ОСТАЁТСЯ ПОНЯТЬ,
Dialogue: 0,0:00:43.48,0:00:46.20,Caption,,0,0,0,,ЗЕЛЕНСКОГО ДЕЙСТВИТЕЛЬНО ГОТОВЯТСЯ УБРАТЬ ИЛИ ЕГО
Dialogue: 0,0:00:46.28,0:00:48.60,Caption,,0,0,0,,ЗАСТАВЛЯЮТ ПРИНИМАТЬ РЕШЕНИЯ С ОЩУЩЕНИЕМ,
Dialogue: 0,0:00:48.76,0:00:51.00,Caption,,0,0,0,,ЧТО СТУЛ ПОД НИМ УЖЕ ШАТАЕТСЯ.
Dialogue: 0,0:00:53.28,0:00:55.04,Caption,,0,0,0,,ЕСЛИ ВАМ НРАВЯТСЯ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:55.19,0:01:00.67,Caption,,0,0,0,,ПОДПИШИТЕСЬ. СЛУХ О НОВОМ РЕШЕНИИ МОСКВЫ ПОЯВИЛСЯ ПОСЛЕ
Dialogue: 0,0:01:00.67,0:01:03.15,Caption,,0,0,0,,ОБСУЖДЕНИЯ СИТУАЦИИ С УЧАСТИЕМ ПРЕДСТАВИТЕЛЕЙ
Dialogue: 0,0:01:03.15,0:01:05.95,Caption,,0,0,0,,РОССИЙСКОГО СИЛОВОГО БЛОКА. ИМЕННО ОНИ,
Dialogue: 0,0:01:06.03,0:01:09.87,Caption,,0,0,0,,СОГЛАСНО ЭТОЙ ВЕРСИИ, ДОБИВАЛИСЬ ОТМЕНЫ ПРЕЖНЕГО ОГРАНИЧЕНИЯ.
Dialogue: 0,0:01:12.14,0:01:14.62,Caption,,0,0,0,,ОДНОЙ ИЗ ПРИЧИН НАЗЫВАЮТ УКРАИНСКИЕ АТАКИ НА
Dialogue: 0,0:01:14.62,0:01:18.70,Caption,,0,0,0,,РОССИЙСКУЮ ТЕРРИТОРИЮ, ВКЛЮЧАЯ ЛЕНИНГРАДСКУЮ ОБЛАСТЬ. ЛОГИКА ЗДЕСЬ
Dialogue: 0,0:01:18.70,0:01:21.98,Caption,,0,0,0,,ПРЕДЕЛЬНО ЖЁСТКАЯ. ЕСЛИ КИЕВ СЧИТАЕТ ДОПУСТИМЫМ
Dialogue: 0,0:01:21.98,0:01:26.06,Caption,,0,0,0,,РАСШИРЯТЬ ПЕРЕЧЕНЬ ЦЕЛЕЙ, МОСКВА МОЖЕТ ПЕРЕСМОТРЕТЬ ПЕРЕЧЕНЬ ТЕХ,
Dialogue: 0,0:01:26.22,0:01:28.06,Caption,,0,0,0,,КОГО ДО СИХ ПОР НЕ ТРОГАЛИ ЛИЧНО.
Dialogue: 0,0:01:30.35,0:01:32.43,Caption,,0,0,0,,ДЛЯ ДАВЛЕНИЯ ДАЖЕ НЕ ТРЕБУЕТСЯ ПРЕДЪЯВЛЯТЬ
Dialogue: 0,0:01:32.43,0:01:35.23,Caption,,0,0,0,,ЗЕЛЕНСКОМУ ПРИКАЗ С ПОДПИСЬЮ И ПЕЧАТЬЮ. САМО
Dialogue: 0,0:01:35.31,0:01:38.27,Caption,,0,0,0,,СООБЩЕНИЕ УЖЕ МЕНЯЕТ ЕГО РАСЧЁТЫ. МОЖНО СКОЛЬКО
Dialogue: 0,0:01:38.27,0:01:40.67,Caption,,0,0,0,,УГОДНО ИЗОБРАЖАТЬ СПОКОЙСТВИЕ ПЕРЕД КАМЕРАМИ,
Dialogue: 0,0:01:40.91,0:01:43.55,Caption,,0,0,0,,НО ОХРАНА ПОСЛЕ ТАКИХ СЛУХОВ НАЧИНАЕТ СМОТРЕТЬ НА
Dialogue: 0,0:01:43.63,0:01:49.75,Caption,,0,0,0,,КРЫШИ ЗАМЕТНО ВНИМАТЕЛЬНЕЕ. ДО ЭТОГО УКРАИНСКИЙ ПРЕЗИДЕНТ МОГ ПОЛАГАТЬ,
Dialogue: 0,0:01:49.91,0:01:53.27,Caption,,0,0,0,,ЧТО ВОКРУГ НЕГО СУЩЕСТВУЕТ НЕВИДИМАЯ ГРАНИЦА. БОЕВЫЕ
Dialogue: 0,0:01:53.27,0:01:55.83,Caption,,0,0,0,,ДЕЙСТВИЯ ИДУТ, ОБЪЕКТЫ ПОРАЖАЮТСЯ,
Dialogue: 0,0:01:55.99,0:01:58.23,Caption,,0,0,0,,ТЕРРИТОРИЯ УКРАИНЫ НАХОДИТСЯ ПОД УДАРАМИ,
Dialogue: 0,0:01:58.47,0:02:01.51,Caption,,0,0,0,,ОДНАКО ПЕРВОЕ ЛИЦО ГОСУДАРСТВА ОСТАЁТСЯ ЗА СКОБКАМИ.
Dialogue: 0,0:02:03.78,0:02:05.46,Caption,,0,0,0,,ТЕПЕРЬ ЕМУ ПРЕДЛАГАЮТ ПРОВЕРИТЬ,
Dialogue: 0,0:02:05.70,0:02:07.94,Caption,,0,0,0,,НЕ СТЁРЛИ ЛИ ЭТИ СКОБКИ ВМЕСТЕ С ПРЕЖНИМИ
Dialogue: 0,0:02:07.94,0:02:13.74,Caption,,0,0,0,,ПРАВИЛАМИ. СЕЙЧАС ЭТОТ ВОПРОС ДЕМОНСТРАТИВНО ПОЛОЖИЛИ НА СТОЛ.
Dialogue: 0,0:02:16.01,0:02:19.45,Caption,,0,0,0,,МОМЕНТ ВЫБРАН ОСОБЕННО НЕПРИЯТНЫЙ ДЛЯ КИЕВА. СТОРОНЫ
Dialogue: 0,0:02:19.45,0:02:22.09,Caption,,0,0,0,,ОБСУЖДАЮТ ПАРАМЕТРЫ ДАЛЬНЕЙШЕГО УРЕГУЛИРОВАНИЯ,
Dialogue: 0,0:02:22.33,0:02:24.81,Caption,,0,0,0,,СРАВНИВАЮТ ТРЕБОВАНИЯ И ПЫТАЮТСЯ ОПРЕДЕЛИТЬ,
Dialogue: 0,0:02:24.97,0:02:28.33,Caption,,0,0,0,,ЧТО ЕЩЁ МОЖНО ВЫТОРГОВАТЬ. И ИМЕННО ТОГДА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:02:28.33,0:02:32.17,Caption,,0,0,0,,ИНФОРМАЦИЯ, ЧТО ПРЕЖНИЕ ОГРАНИЧЕНИЯ В ОТНОШЕНИИ ЗЕЛЕНСКОГО МОГЛИ
Dialogue: 0,0:02:32.17,0:02:37.64,Caption,,0,0,0,,ИСЧЕЗНУТЬ. НА ПЕРЕГОВОРАХ ЗНАЧЕНИЕ ИМЕЕТ НЕ ТОЛЬКО СОДЕРЖАНИЕ
Dialogue: 0,0:02:37.64,0:02:41.00,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯ. ИНОГДА ДОСТАТОЧНО ПОКАЗАТЬ СОБЕСЕДНИКУ,
Dialogue: 0,0:02:41.30,0:02:43.32,Caption,,0,0,0,,ЧТО ВРЕМЯ ДЛЯ ДОЛГИХ РАЗДУМИЙ БОЛЬШЕ НЕ
Dialogue: 0,0:02:43.32,0:02:46.36,Caption,,0,0,0,,ПРЕДОСТАВЛЯЕТСЯ. РАНЬШЕ ЗЕЛЕНСКИЙ МОГ ОТВЕЧАТЬ
Dialogue: 0,0:02:46.36,0:02:49.32,Caption,,0,0,0,,ОЧЕРЕДНЫМ ПЕРЕЧНЕМ УСЛОВИЙ. ТЕПЕРЬ РЯДОМ С ЭТИМ
Dialogue: 0,0:02:49.32,0:02:51.32,Caption,,0,0,0,,ПЕРЕЧНЕМ СЛОВНО ПОСТАВИЛИ ЧАСЫ,
Dialogue: 0,0:02:51.61,0:02:54.20,Caption,,0,0,0,,ТОЛЬКО БЕЗ ЦИФЕРБЛАТА И БЕЗ ПОНЯТНОГО СРОКА.
Dialogue: 0,0:02:56.47,0:02:58.47,Caption,,0,0,0,,ЕСЛИ РЕШЕНИЕ ДЕЙСТВИТЕЛЬНО ПРИНЯТО,
Dialogue: 0,0:02:58.71,0:03:01.59,Caption,,0,0,0,,ДЛЯ УКРАИНСКОГО РУКОВОДСТВА ЭТО НОВЫЙ УРОВЕНЬ РИСКА.
Dialogue: 0,0:03:01.99,0:03:03.83,Caption,,0,0,0,,ЕСЛИ ЖЕ ПРИКАЗА НЕ СУЩЕСТВУЕТ,
Dialogue: 0,0:03:03.99,0:03:06.79,Caption,,0,0,0,,НО СЛУХ СПЕЦИАЛЬНО ЗАПУЩЕН РАДИ НУЖНОЙ РЕАКЦИИ,
Dialogue: 0,0:03:07.04,0:03:09.59,Caption,,0,0,0,,РЕЗУЛЬТАТ ВСЁ РАВНО МОЖЕТ ОКАЗАТЬСЯ БОЛЕЗНЕННЫМ.
Dialogue: 0,0:03:11.86,0:03:15.30,Caption,,0,0,0,,НАСТОЯЩАЯ УГРОЗА ПРОВЕРЯЕТ ОХРАНУ. РАССКАЗ ОБ УГРОЗЕ
Dialogue: 0,0:03:15.30,0:03:19.54,Caption,,0,0,0,,ПРОВЕРЯЕТ НЕРВЫ, ДОВЕРИЕ И СПОСОБНОСТЬ ПРИНИМАТЬ РЕШЕНИЯ БЕЗ ПАНИКИ.
Dialogue: 0,0:03:21.81,0:03:23.57,Caption,,0,0,0,,ПОЭТОМУ ВАЖЕН НЕ ТОЛЬКО ВОПРОС,
Dialogue: 0,0:03:23.73,0:03:26.77,Caption,,0,0,0,,СУЩЕСТВУЕТ ЛИ СООТВЕТСТВУЮЩИЙ ПРИКАЗ. ГОРАЗДО
Dialogue: 0,0:03:26.77,0:03:30.61,Caption,,0,0,0,,ИНТЕРЕСНЕЕ, КТО ДОЛЖЕН УСЛЫШАТЬ ЭТУ ИСТОРИЮ И СДЕЛАТЬ ИЗ
Dialogue: 0,0:03:30.61,0:03:36.82,Caption,,0,0,0,,НЕЁ ВЫВОДЫ. САМ ЗЕЛЕНСКИЙ УСЛЫШИТ ОДНО. ЕГО ОХРАНА УСЛЫШИТ
Dialogue: 0,0:03:36.90,0:03:39.78,Caption,,0,0,0,,ДРУГОЕ. КОМАНДОВАНИЕ ВООРУЖЁННЫХ СИЛ ПОДУМАЕТ О
Dialogue: 0,0:03:39.86,0:03:42.82,Caption,,0,0,0,,ТРЕТЬЕМ. А ЛЮДИ ИЗ БЛИЖАЙШЕГО ОКРУЖЕНИЯ НАВЕРНЯКА
Dialogue: 0,0:03:42.82,0:03:46.98,Caption,,0,0,0,,НАЧНУТ ПРИКИДЫВАТЬ, НАСКОЛЬКО ИХ СОБСТВЕННОЕ БУДУЩЕЕ ОБЯЗАНО СЛЕДОВАТЬ
Dialogue: 0,0:03:47.06,0:03:52.87,Caption,,0,0,0,,ЗА СУДЬБОЙ ПРЕЗИДЕНТА. ВОЗЛЕ ГЛАВЫ ГОСУДАРСТВА НЕТ КРУЖКА ЛЮДЕЙ,
Dialogue: 0,0:03:53.11,0:03:56.23,Caption,,0,0,0,,ПОКЛЯВШИХСЯ НАВЕЧНО ДЕЛИТЬ С НИМ ЛЮБОЙ ИСХОД. ТАМ
Dialogue: 0,0:03:56.23,0:04:01.43,Caption,,0,0,0,,ЧИНОВНИКИ, СИЛОВИКИ, СОВЕТНИКИ И РУКОВОДИТЕЛИ ВЕДОМСТВ. У КАЖДОГО ИМЕЮТСЯ
Dialogue: 0,0:04:01.43,0:04:05.03,Caption,,0,0,0,,СВЯЗИ, ДОЛЖНОСТЬ, ИМУЩЕСТВО И ЗАПАСНОЙ ВАРИАНТ,
Dialogue: 0,0:04:05.27,0:04:07.67,Caption,,0,0,0,,О КОТОРОМ ОБЫЧНО НЕ РАССКАЗЫВАЮТ НА СОВЕЩАНИИ.
Dialogue: 0,0:04:09.96,0:04:12.12,Caption,,0,0,0,,ПОКА РУКОВОДИТЕЛЬ ВЫГЛЯДИТ НЕУЯЗВИМЫМ,
Dialogue: 0,0:04:12.36,0:04:15.72,Caption,,0,0,0,,ЛИЧНЫЕ ИНТЕРЕСЫ УДОБНО ВЫДАВАТЬ ЗА ОБЩЕЕ ДЕЛО. КОГДА
Dialogue: 0,0:04:15.72,0:04:17.56,Caption,,0,0,0,,НЕУЯЗВИМОСТЬ СТАВЯТ ПОД ВОПРОС,
Dialogue: 0,0:04:17.79,0:04:20.76,Caption,,0,0,0,,САМЫЕ ГРОМКИЕ КЛЯТВЫ ВНЕЗАПНО СТАНОВЯТСЯ ТИШЕ,
Dialogue: 0,0:04:21.00,0:04:23.64,Caption,,0,0,0,,А ЗАПАСНЫЕ ВЫХОДЫ ПОЧЕМУ ТО ПРИВЛЕКАЮТ БОЛЬШЕ
Dialogue: 0,0:04:23.71,0:04:29.10,Caption,,0,0,0,,ВНИМАНИЯ. ДЛЯ ЭТОГО НЕ НУЖЕН ГОТОВЫЙ ЗАГОВОР. ДОСТАТОЧНО
Dialogue: 0,0:04:29.10,0:04:32.30,Caption,,0,0,0,,РИСКА, КОТОРЫЙ СОВСЕМ НЕДАВНО СЧИТАЛСЯ НЕВОЗМОЖНЫМ.
Dialogue: 0,0:04:34.59,0:04:37.07,Caption,,0,0,0,,ЕСТЬ И ЕЩЁ ОДИН АДРЕСАТ ТАКОГО СИГНАЛА.
Dialogue: 0,0:04:39.34,0:04:42.14,Caption,,0,0,0,,ВАШИНГТОН И МОСКВА ПРОДОЛЖАЮТ ОБСУЖДАТЬ ВОЗМОЖНОЕ
Dialogue: 0,0:04:42.14,0:04:45.18,Caption,,0,0,0,,УРЕГУЛИРОВАНИЕ. ПОЭТОМУ ИНФОРМАЦИЯ О ПЕРЕСМОТРЕ
Dialogue: 0,0:04:45.18,0:04:48.30,Caption,,0,0,0,,ОТНОШЕНИЯ К ЗЕЛЕНСКОМУ МОЖЕТ СОЗДАТЬ ВПЕЧАТЛЕНИЕ,
Dialogue: 0,0:04:48.46,0:04:50.70,Caption,,0,0,0,,БУДТО РОССИЙСКОЕ ДАВЛЕНИЕ УКЛАДЫВАЕТСЯ В
Dialogue: 0,0:04:50.70,0:04:56.82,Caption,,0,0,0,,АМЕРИКАНСКУЮ ЛИНИЮ. ИМЕННО ВПЕЧАТЛЕНИЕ ЗДЕСЬ ВАЖНЕЕ ФОРМАЛЬНОГО
Dialogue: 0,0:04:56.82,0:05:02.14,Caption,,0,0,0,,СОГЛАСОВАНИЯ. АМЕРИКАНСКАЯ СТОРОНА МОГЛА НЕ УЧАСТВОВАТЬ В
Dialogue: 0,0:05:02.14,0:05:04.86,Caption,,0,0,0,,ПОЯВЛЕНИИ ЭТИХ СООБЩЕНИЙ. НО В КИЕВЕ СПОСОБНЫ
Dialogue: 0,0:05:04.94,0:05:07.58,Caption,,0,0,0,,УВИДЕТЬ ОДНУ ПОСЛЕДОВАТЕЛЬНОСТЬ ВАШИНГТОН ТРЕБУЕТ
Dialogue: 0,0:05:07.58,0:05:10.22,Caption,,0,0,0,,УСТУПОК, МОСКВА ПОВЫШАЕТ ЦЕНУ ОТКАЗА,
Dialogue: 0,0:05:10.44,0:05:12.14,Caption,,0,0,0,,А ЗЕЛЕНСКОМУ ПРЕДЛАГАЮТ РЕШИТЬ,
Dialogue: 0,0:05:12.29,0:05:15.66,Caption,,0,0,0,,НАСКОЛЬКО КРЕПКИ ОБЕЩАНИЯ, НА КОТОРЫЕ ОН ПРИВЫК ОПИРАТЬСЯ.
Dialogue: 0,0:05:17.93,0:05:20.81,Caption,,0,0,0,,ДЛЯ УКРАИНСКОЙ ВЛАСТИ ЭТО КРАЙНЕ НЕУДОБНАЯ КАРТИНА.
Dialogue: 0,0:05:21.12,0:05:25.29,Caption,,0,0,0,,ГАРАНТИИ ХОРОШИ ДО ТЕХ ПОР, ПОКА ГАРАНТ НЕ НАЧИНАЕТ ЗАДАВАТЬ ВОПРОСЫ,
Dialogue: 0,0:05:25.45,0:05:28.49,Caption,,0,0,0,,КОТОРЫЕ ВАМ НЕ НРАВЯТСЯ, А ПРОТИВНИК НЕ СООБЩАЕТ,
Dialogue: 0,0:05:28.60,0:05:30.73,Caption,,0,0,0,,ЧТО ПРЕЖНЯЯ ОСТОРОЖНОСТЬ ЗАКОНЧИЛАСЬ.
Dialogue: 0,0:05:33.00,0:05:35.40,Caption,,0,0,0,,НО ВНЕШНЕЙ УГРОЗОЙ ДЕЛО НЕ ИСЧЕРПЫВАЕТСЯ.
Dialogue: 0,0:05:37.59,0:05:40.80,Caption,,0,0,0,,ПОЧТИ ОДНОВРЕМЕННО ГЕНЕРАЛ МАЙОР СБУ СЕРГЕЙ ДУКА
Dialogue: 0,0:05:40.87,0:05:43.36,Caption,,0,0,0,,ЗАГОВОРИЛ О СПЕЦИАЛЬНОЙ ОПЕРАЦИИ ПРОТИВ ВЫСШЕГО
Dialogue: 0,0:05:43.44,0:05:46.16,Caption,,0,0,0,,РУКОВОДСТВА УКРАИНЫ. ТОЛЬКО ИСПОЛНИТЕЛЕЙ ОН
Dialogue: 0,0:05:46.16,0:05:48.72,Caption,,0,0,0,,ОБНАРУЖИЛ НЕ В РОССИЙСКОЙ АРМИИ И НЕ СРЕДИ
Dialogue: 0,0:05:48.72,0:05:55.15,Caption,,0,0,0,,ТАИНСТВЕННЫХ ДИВЕРСАНТОВ. В ЕГО ВЕРСИИ В ЭТОЙ РАБОТЕ УЧАСТВУЮТ УКРАИНСКИЕ
Dialogue: 0,0:05:55.15,0:05:58.03,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ СТРУКТУРЫ, НАБУ И САП.
Dialogue: 0,0:06:00.32,0:06:04.80,Caption,,0,0,0,,ДАЛЬШЕ ГЕНЕРАЛ СДЕЛАЛ ШАГ, ПОСЛЕ КОТОРОГО ОБЫЧНАЯ МЕЖВЕДОМСТВЕННАЯ ССОРА
Dialogue: 0,0:06:05.00,0:06:07.76,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В БОРЬБУ ЗА ПРАВО ОПРЕДЕЛЯТЬ ВРАГА.
Dialogue: 0,0:06:10.04,0:06:14.44,Caption,,0,0,0,,ОН ДОПУСТИЛ, ЧТО СОТРУДНИКИ НАБУ И САП ЛИБО СОЗНАТЕЛЬНО ПОМОГАЮТ
Dialogue: 0,0:06:14.44,0:06:17.80,Caption,,0,0,0,,РОССИИ, ЛИБО НАСТОЛЬКО ПЛОХО ВЫПОЛНЯЮТ СВОЮ РАБОТУ,
Dialogue: 0,0:06:17.96,0:06:24.57,Caption,,0,0,0,,ЧТО ИТОГ ПОЛУЧАЕТСЯ ТЕМ ЖЕ. КАРТИНА ДЛЯ УКРАИНСКОЙ СИСТЕМЫ ПОЧТИ ОБРАЗЦОВАЯ.
Dialogue: 0,0:06:24.73,0:06:27.37,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫЕ СЛЕДОВАТЕЛИ ИЗУЧАЮТ ВОЗМОЖНЫЕ
Dialogue: 0,0:06:27.37,0:06:30.09,Caption,,0,0,0,,ПРЕСТУПЛЕНИЯ СИЛОВИКОВ. ПРЕДСТАВИТЕЛЬ СИЛОВОГО
Dialogue: 0,0:06:30.09,0:06:34.73,Caption,,0,0,0,,ВЕДОМСТВА ОТВЕЧАЕТ, ЧТО САМИ СЛЕДОВАТЕЛИ ДЕЙСТВУЮТ В ПОЛЬЗУ МОСКВЫ. ЕЩЁ
Dialogue: 0,0:06:34.73,0:06:38.09,Caption,,0,0,0,,НЕМНОГО, И ДЛЯ ПРОВЕРКИ ПРОВЕРЯЮЩИХ ПОНАДОБИТСЯ ОТДЕЛЬНОЕ
Dialogue: 0,0:06:38.09,0:06:40.97,Caption,,0,0,0,,ВЕДОМСТВО, КОТОРОЕ ЗАТЕМ ТОЖЕ ПРИДЁТСЯ ПРОВЕРИТЬ.
Dialogue: 0,0:06:43.24,0:06:45.16,Caption,,0,0,0,,В МИРНОЕ ВРЕМЯ ЭТО МОЖНО БЫЛО БЫ НАЗВАТЬ
Dialogue: 0,0:06:45.16,0:06:49.56,Caption,,0,0,0,,ДРАКОЙ ЗА ПОЛНОМОЧИЯ, КАБИНЕТЫ И ДОСТУП К НУЖНЫМ ПАПКАМ. ВО ВРЕМЯ
Dialogue: 0,0:06:49.56,0:06:52.52,Caption,,0,0,0,,ВОЙНЫ ОБВИНЕНИЕ ЗВУЧИТ ИНАЧЕ. РЕЧЬ ИДЁТ УЖЕ НЕ
Dialogue: 0,0:06:52.52,0:06:55.08,Caption,,0,0,0,,О ТОМ, КТО НАРУШИЛ ЗАКОН, А О ТОМ,
Dialogue: 0,0:06:55.31,0:07:01.37,Caption,,0,0,0,,КТО ОБСЛУЖИВАЕТ ПРОТИВНИКА. ДУКА ПОТРЕБОВАЛ РЕАКЦИИ ОТ ПРЕЗИДЕНТА,
Dialogue: 0,0:07:01.52,0:07:04.89,Caption,,0,0,0,,ВЕРХОВНОЙ РАДЫ И РУКОВОДСТВА СБУ. ОН ПРЕДЛОЖИЛ
Dialogue: 0,0:07:04.89,0:07:07.37,Caption,,0,0,0,,СОЗДАТЬ ПАРЛАМЕНТСКУЮ СЛЕДСТВЕННУЮ КОМИССИЮ,
Dialogue: 0,0:07:07.60,0:07:10.17,Caption,,0,0,0,,КОТОРАЯ ЗАЙМЁТСЯ ДЕЯТЕЛЬНОСТЬЮ НАБУ И САП,
Dialogue: 0,0:07:10.40,0:07:13.13,Caption,,0,0,0,,И ВЫРАЗИЛ ГОТОВНОСТЬ ПУБЛИЧНО ДАВАТЬ ПОКАЗАНИЯ.
Dialogue: 0,0:07:15.40,0:07:17.56,Caption,,0,0,0,,ТО ЕСТЬ ГЕНЕРАЛ ХОЧЕТ НЕ ПРОСТО ОТБИТЬСЯ ОТ
Dialogue: 0,0:07:17.56,0:07:20.44,Caption,,0,0,0,,ОБВИНЕНИЙ И ГРОМКО ВОЗМУТИТЬСЯ. ОН ПРЕДЛАГАЕТ
Dialogue: 0,0:07:20.52,0:07:23.00,Caption,,0,0,0,,РАЗВЕРНУТЬ ОТДЕЛЬНОЕ РАССЛЕДОВАНИЕ ПРОТИВ ТЕХ,
Dialogue: 0,0:07:23.24,0:07:25.16,Caption,,0,0,0,,КТО ВЕДЁТ АНТИКОРРУПЦИОННЫЕ ДЕЛА.
Dialogue: 0,0:07:27.44,0:07:31.76,Caption,,0,0,0,,И ТУТ ПОЯВЛЯЕТСЯ ПОДРОБНОСТЬ, БЕЗ КОТОРОЙ УКРАИНСКАЯ ДЕЙСТВИТЕЛЬНОСТЬ ВЫГЛЯДЕЛА БЫ
Dialogue: 0,0:07:31.76,0:07:38.36,Caption,,0,0,0,,НЕДОСТАТОЧНО ВЫРАЗИТЕЛЬНО. САМ СЕРГЕЙ ДУКА ПРОХОДИЛ ПО ДЕЛУ О ПРЕДПОЛАГАЕМОМ
Dialogue: 0,0:07:38.36,0:07:41.24,Caption,,0,0,0,,ПОКРОВИТЕЛЬСТВЕ МОШЕННИЧЕСКИМ КОЛЛ ЦЕНТРАМ. ЕГО
Dialogue: 0,0:07:41.24,0:07:43.88,Caption,,0,0,0,,ЗАДЕРЖИВАЛИ, ПОСЛЕ ЧЕГО ОН ВЫШЕЛ ПОД ЗАЛОГ.
Dialogue: 0,0:07:46.17,0:07:48.81,Caption,,0,0,0,,ТЕПЕРЬ ФИГУРАНТ УГОЛОВНОГО ПРОИЗВОДСТВА ПРЕДЛАГАЕТ
Dialogue: 0,0:07:48.81,0:07:51.77,Caption,,0,0,0,,ВЫЯСНИТЬ, НЕ СЛУЖАТ ЛИ ИНТЕРЕСАМ РОССИИ ЛЮДИ,
Dialogue: 0,0:07:51.93,0:07:54.73,Caption,,0,0,0,,КОТОРЫЕ РАССЛЕДУЮТ ПОДОБНЫЕ ИСТОРИИ. ХОД,
Dialogue: 0,0:07:54.75,0:07:58.89,Caption,,0,0,0,,КОНЕЧНО, СМЕЛЫЙ. ЕСЛИ СЛЕДОВАТЕЛЬ ЗАДАЁТ НЕУДОБНЫЕ ВОПРОСЫ,
Dialogue: 0,0:07:59.13,0:08:01.37,Caption,,0,0,0,,МОЖНО НЕ ОТВЕЧАТЬ, А ПОИНТЕРЕСОВАТЬСЯ,
Dialogue: 0,0:08:01.61,0:08:06.70,Caption,,0,0,0,,ДОСТАТОЧНО ЛИ ОН ПАТРИОТИЧЕН. ЭТО НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:08:06.87,0:08:09.50,Caption,,0,0,0,,ЧТО ЛЮБОЕ ЗАЯВЛЕНИЕ ДУКИ АВТОМАТИЧЕСКИ ЛОЖНО.
Dialogue: 0,0:08:09.83,0:08:12.86,Caption,,0,0,0,,НАЛИЧИЕ ДЕЛА НЕ ЛИШАЕТ ЧЕЛОВЕКА ВОЗМОЖНОСТИ СООБЩИТЬ
Dialogue: 0,0:08:12.86,0:08:15.74,Caption,,0,0,0,,ВАЖНЫЕ СВЕДЕНИЯ. НО И СЛОВА О ГОСУДАРСТВЕННОЙ
Dialogue: 0,0:08:15.74,0:08:18.54,Caption,,0,0,0,,БЕЗОПАСНОСТИ НЕ ПРЕВРАЩАЮТ ОБВИНЕНИЕ В ГОТОВОЕ
Dialogue: 0,0:08:18.54,0:08:24.42,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВО. ЗАТО ПОСЛЕДСТВИЯ ТАКОГО ВЫСТУПЛЕНИЯ СОВЕРШЕННО
Dialogue: 0,0:08:24.42,0:08:29.98,Caption,,0,0,0,,ПОНЯТНЫ. ПОД УДАРОМ ОКАЗЫВАЕТСЯ НЕ ОДИН СОТРУДНИК И НЕ
Dialogue: 0,0:08:29.98,0:08:33.18,Caption,,0,0,0,,ОДИН ЭПИЗОД. СОМНЕНИЮ ПОДВЕРГАЮТ РАБОТУ ЦЕЛЫХ
Dialogue: 0,0:08:33.18,0:08:35.98,Caption,,0,0,0,,ОРГАНОВ, СОЗДАННЫХ ДЛЯ РАССЛЕДОВАНИЯ КОРРУПЦИИ.
Dialogue: 0,0:08:38.26,0:08:40.74,Caption,,0,0,0,,ЕСЛИ ВЫ ЕЩЁ НЕ ПОДПИСАЛИСЬ, ПОДПИШИТЕСЬ,
Dialogue: 0,0:08:40.86,0:08:42.74,Caption,,0,0,0,,СЕЙЧАС САМОЕ ВРЕМЯ ЭТО СДЕЛАТЬ.
Dialogue: 0,0:08:45.02,0:08:47.82,Caption,,0,0,0,,ПОЧЕМУ ЭТА СХВАТКА ОСОБЕННО ОПАСНА ДЛЯ ЗЕЛЕНСКОГО?
Dialogue: 0,0:08:49.93,0:08:52.25,Caption,,0,0,0,,В МАТЕРИАЛАХ ПОЯВЛЯЕТСЯ ЧЕЛОВЕК ПО ПРОЗВИЩУ
Dialogue: 0,0:08:52.25,0:08:55.77,Caption,,0,0,0,,МЕКСИКАНЕЦ, КОТОРОГО СВЯЗЫВАЮТ С НАРКОСИНДИКАТОМ "ХИМПРОМ".
Dialogue: 0,0:08:56.17,0:08:58.25,Caption,,0,0,0,,СОГЛАСНО РАСПРОСТРАНЁННОЙ ИНФОРМАЦИИ,
Dialogue: 0,0:08:58.55,0:09:01.77,Caption,,0,0,0,,ОН ПОДТВЕРДИЛ ПОДЛИННОСТЬ ОПЕРАТИВНЫХ ЗАПИСЕЙ НАБУ И
Dialogue: 0,0:09:01.77,0:09:04.33,Caption,,0,0,0,,РАССКАЗАЛ О МИЛЛИОННЫХ ЕЖЕМЕСЯЧНЫХ ВЫПЛАТАХ
Dialogue: 0,0:09:04.33,0:09:08.41,Caption,,0,0,0,,СОТРУДНИКАМ СБУ, ПОЛИЦИИ И ПРОКУРАТУРЫ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:09:08.57,0:09:10.81,Caption,,0,0,0,,ПОТОК ДЕНЕГ ПОДНИМАЛСЯ ДО САМОГО ВЕРХА.
Dialogue: 0,0:09:13.08,0:09:16.28,Caption,,0,0,0,,ЕСЛИ ТАКИЕ ВЫПЛАТЫ ШЛИ РЕГУЛЯРНО И ОХВАТЫВАЛИ СРАЗУ
Dialogue: 0,0:09:16.28,0:09:19.08,Caption,,0,0,0,,НЕСКОЛЬКО ВЕДОМСТВ, РЕЧЬ УЖЕ НЕ О СОТРУДНИКЕ,
Dialogue: 0,0:09:19.16,0:09:22.36,Caption,,0,0,0,,КОТОРЫЙ ОДНАЖДЫ ВЗЯЛ КОНВЕРТ. ТАКАЯ СИСТЕМА ТРЕБУЕТ
Dialogue: 0,0:09:22.36,0:09:24.68,Caption,,0,0,0,,ЗАЩИТЫ, ПРЕДУПРЕЖДЕНИЙ О ПРОВЕРКАХ,
Dialogue: 0,0:09:24.99,0:09:29.40,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЯ ДЕНЕГ И ЛЮДЕЙ, СПОСОБНЫХ ЗАКРЫВАТЬ ГЛАЗА В НУЖНЫЙ МОМЕНТ.
Dialogue: 0,0:09:31.68,0:09:34.72,Caption,,0,0,0,,ИМЕННО ЭТО ДЕЛАЕТ ВЫПАД ДУКИ ОСОБЕННО УДОБНЫМ И
Dialogue: 0,0:09:34.72,0:09:37.68,Caption,,0,0,0,,ОДНОВРЕМЕННО ОСОБЕННО ПОДОЗРИТЕЛЬНЫМ. НАБУ И САП
Dialogue: 0,0:09:37.68,0:09:40.48,Caption,,0,0,0,,ИЗУЧАЮТ ВОЗМОЖНЫЕ СВЯЗИ ВНУТРИ СИЛОВЫХ ВЕДОМСТВ,
Dialogue: 0,0:09:40.72,0:09:43.12,Caption,,0,0,0,,А ГЕНЕРАЛ СБУ ПРЕДЛАГАЕТ ЗАНЯТЬСЯ САМИМИ
Dialogue: 0,0:09:43.12,0:09:47.60,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫМИ ОРГАНАМИ, ПОТОМУ ЧТО ИХ ДЕЯТЕЛЬНОСТЬ ЯКОБЫ ПОМОГАЕТ РОССИИ.
Dialogue: 0,0:09:49.89,0:09:54.13,Caption,,0,0,0,,ОДНИ ИЩУТ ТЕХ, КТО МОГ ПОЛУЧАТЬ ДЕНЬГИ ОТ ПРЕСТУПНОЙ СЕТИ. ДРУГИЕ
Dialogue: 0,0:09:54.13,0:09:57.25,Caption,,0,0,0,,ИЩУТ МОСКВУ В ДЕЙСТВИЯХ ПЕРВЫХ. ПОКА ЭТА КОМПАНИЯ
Dialogue: 0,0:09:57.33,0:10:00.69,Caption,,0,0,0,,ХОДИТ ПО КРУГУ, ЗЕЛЕНСКОМУ ОСТАЁТСЯ ИЗОБРАЖАТЬ ЧЕЛОВЕКА,
Dialogue: 0,0:10:00.92,0:10:04.05,Caption,,0,0,0,,КОТОРЫЙ ПОЛНОСТЬЮ КОНТРОЛИРУЕТ ПРОИСХОДЯЩЕЕ. ЗАДАЧА
Dialogue: 0,0:10:04.05,0:10:07.49,Caption,,0,0,0,,НЕПРОСТАЯ, ОСОБЕННО КОГДА КОНТРОЛЁРЫ УЖЕ ПОДОЗРЕВАЮТ ДРУГ
Dialogue: 0,0:10:07.57,0:10:12.72,Caption,,0,0,0,,ДРУГА. К ЭТОЙ ИСТОРИИ ДОБАВИЛИСЬ СВЕДЕНИЯ ИЗ ЭСТОНИИ.
Dialogue: 0,0:10:14.99,0:10:17.71,Caption,,0,0,0,,РУКОВОДИТЕЛЬ МЕСТНОГО ЦЕНТРА БОРЬБЫ С МОШЕННИЧЕСТВОМ
Dialogue: 0,0:10:17.71,0:10:22.99,Caption,,0,0,0,,ЯАГУП ТООМПУУ СООБЩИЛ, ЧТО ЭСТОНСКАЯ ПОЛИЦИЯ НЕ РАЗ ПЕРЕДАВАЛА УКРАИНСКИМ
Dialogue: 0,0:10:23.07,0:10:25.71,Caption,,0,0,0,,КОЛЛЕГАМ АДРЕСА ПРЕДПОЛАГАЕМЫХ МОШЕННИЧЕСКИХ КОЛЛ
Dialogue: 0,0:10:25.71,0:10:28.43,Caption,,0,0,0,,ЦЕНТРОВ. КОГДА СОТРУДНИКИ ПРИЕЗЖАЛИ ТУДА С
Dialogue: 0,0:10:28.43,0:10:32.35,Caption,,0,0,0,,ПРОВЕРКОЙ, КОМНАТЫ ВСТРЕЧАЛИ ИХ ОБРАЗЦОВЫМ ПОРЯДКОМ И ПОЛНЫМ
Dialogue: 0,0:10:32.35,0:10:39.03,Caption,,0,0,0,,ОТСУТСТВИЕМ ПОДОЗРЕВАЕМЫХ. ПРИ ЭТОМ ТООМПУУ УПОМИНАЛ И УДАЧНЫЕ СОВМЕСТНЫЕ
Dialogue: 0,0:10:39.03,0:10:42.31,Caption,,0,0,0,,ОПЕРАЦИИ. НО ПОВТОРЯЮЩИЕСЯ ИСЧЕЗНОВЕНИЯ ЛЮДЕЙ ПО
Dialogue: 0,0:10:42.31,0:10:45.35,Caption,,0,0,0,,ИЗВЕСТНЫМ АДРЕСАМ ОСТАВЛЯЮТ ОЧЕВИДНЫЙ ВОПРОС. КТО
Dialogue: 0,0:10:45.35,0:10:47.19,Caption,,0,0,0,,УСПЕВАЛ ПРЕДУПРЕДИТЬ ИХ РАНЬШЕ,
Dialogue: 0,0:10:47.35,0:10:49.19,Caption,,0,0,0,,ЧЕМ ПОЛИЦИЯ ДОБИРАЛАСЬ ДО ДВЕРИ?
Dialogue: 0,0:10:51.46,0:10:54.18,Caption,,0,0,0,,ПОХОЖИЕ ЗАТРУДНЕНИЯ ВОЗНИКАЛИ И ВОКРУГ СВЕДЕНИЙ
Dialogue: 0,0:10:54.18,0:10:56.42,Caption,,0,0,0,,АВСТРИЙСКОЙ ПОЛИЦИИ ПО ДЕЛУ "КАРФАГЕН".
Dialogue: 0,0:10:58.69,0:11:03.01,Caption,,0,0,0,,РАЗМЕР УЩЕРБА ПОКАЗЫВАЕТ, ЧТО РЕЧЬ ШЛА НЕ О НЕСКОЛЬКИХ ТЕЛЕФОННЫХ ЛОВКАЧАХ.
Dialogue: 0,0:11:03.31,0:11:05.57,Caption,,0,0,0,,ЗА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТЫЙ ГОД ПОТЕРИ
Dialogue: 0,0:11:05.57,0:11:08.77,Caption,,0,0,0,,СОСТАВИЛИ ПЯТНАДЦАТЬ МИЛЛИОНОВ ЕВРО. ЗА ДВЕ ТЫСЯЧИ
Dialogue: 0,0:11:08.77,0:11:11.97,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТЫЙ ГОД СУММА ВЫРОСЛА ДО ТРИДЦАТИ ЧЕТЫРЁХ
Dialogue: 0,0:11:11.97,0:11:17.45,Caption,,0,0,0,,МИЛЛИОНОВ. ПОЧТИ ПЯТЬДЕСЯТ МИЛЛИОНОВ ЕВРО ЗА ДВА ГОДА ДЛЯ
Dialogue: 0,0:11:17.45,0:11:20.73,Caption,,0,0,0,,ЭСТОНИИ, ГДЕ ЖИВЁТ ПРИМЕРНО ОДИН МИЛЛИОН ТРИСТА ТЫСЯЧ
Dialogue: 0,0:11:20.73,0:11:23.69,Caption,,0,0,0,,ЧЕЛОВЕК. МОШЕННИКИ, СУДЯ ПО ОБОРОТУ,
Dialogue: 0,0:11:23.91,0:11:27.37,Caption,,0,0,0,,РАБОТАЛИ ТАК, БУДТО СОБИРАЛИСЬ ВКЛЮЧИТЬ ТЕЛЕФОННЫЕ ЗВОНКИ В
Dialogue: 0,0:11:27.37,0:11:33.41,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ БЮДЖЕТ. ПОСЛЕ КРУПНЫХ РАССЛЕДОВАНИЙ ИХ АКТИВНОСТЬ ПОЧТИ
Dialogue: 0,0:11:33.41,0:11:36.29,Caption,,0,0,0,,ИСЧЕЗЛА ПРИМЕРНО НА ШЕСТЬ НЕДЕЛЬ. ЗАТЕМ ЗВОНКИ
Dialogue: 0,0:11:36.29,0:11:39.17,Caption,,0,0,0,,ВЕРНУЛИСЬ. К КОНЦУ ОКТЯБРЯ ЭСТОНСКАЯ ПОЛИЦИЯ
Dialogue: 0,0:11:39.17,0:11:41.41,Caption,,0,0,0,,ОЦЕНИВАЛА МАСШТАБЫ РАБОТЫ КАК ПРЕЖНИЕ.
Dialogue: 0,0:11:43.68,0:11:46.00,Caption,,0,0,0,,МОЖНО ЗАКРЫТЬ НЕСКОЛЬКО ПОМЕЩЕНИЙ И ВЫВЕЗТИ
Dialogue: 0,0:11:46.00,0:11:49.12,Caption,,0,0,0,,АППАРАТУРУ. НО ЕСЛИ КТО ТО ВНУТРИ СИСТЕМЫ ЗАРАНЕЕ
Dialogue: 0,0:11:49.12,0:11:53.76,Caption,,0,0,0,,СООБЩАЕТ О ПРОВЕРКЕ, СЕТЬ СПОКОЙНО ПЕРЕЖИДАЕТ ШУМ И СНОВА ВЫХОДИТ НА
Dialogue: 0,0:11:53.76,0:11:58.74,Caption,,0,0,0,,СВЯЗЬ. ДЛЯ ЗЕЛЕНСКОГО ВСЁ ЭТО СКЛАДЫВАЕТСЯ В КРАЙНЕ
Dialogue: 0,0:11:58.74,0:12:02.58,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВНУТРЕННИЙ ОТЧЁТ. СБУ ОБВИНЯЕТ НАБУ И САП
Dialogue: 0,0:12:02.58,0:12:05.70,Caption,,0,0,0,,В СОДЕЙСТВИИ РОССИИ. ЕВРОПЕЙСКИЕ ПРАВООХРАНИТЕЛИ
Dialogue: 0,0:12:05.70,0:12:08.90,Caption,,0,0,0,,ИНТЕРЕСУЮТСЯ УТЕЧКАМИ. АНТИКОРРУПЦИОННЫЕ МАТЕРИАЛЫ
Dialogue: 0,0:12:08.98,0:12:11.70,Caption,,0,0,0,,ЗАТРАГИВАЮТ ПРЕДСТАВИТЕЛЕЙ СИЛОВЫХ ВЕДОМСТВ. А
Dialogue: 0,0:12:11.70,0:12:13.38,Caption,,0,0,0,,ПРЕЗИДЕНТУ ПРИХОДИТСЯ ВЫБИРАТЬ,
Dialogue: 0,0:12:13.50,0:12:16.34,Caption,,0,0,0,,КОМУ ДОВЕРЯТЬ, КОГДА КАЖДАЯ СТОРОНА УВЕРЯЕТ,
Dialogue: 0,0:12:16.58,0:12:19.06,Caption,,0,0,0,,ЧТО ИМЕННО ОНА ЗАЩИЩАЕТ ГОСУДАРСТВО.
Dialogue: 0,0:12:21.34,0:12:23.74,Caption,,0,0,0,,В ЭТОТ ЖЕ ПЕРИОД ВОЗНИК ЕЩЁ ОДИН ЭПИЗОД
Dialogue: 0,0:12:23.74,0:12:28.03,Caption,,0,0,0,,НА ПЕРЕГОВОРАХ. ЗЕЛЕНСКИЙ РАССКАЗАЛ,
Dialogue: 0,0:12:28.22,0:12:30.91,Caption,,0,0,0,,ЧТО ПРЕДСТАВИТЕЛИ США СПРАШИВАЛИ О ГОТОВНОСТИ
Dialogue: 0,0:12:30.91,0:12:33.55,Caption,,0,0,0,,УКРАИНЫ ВЫВЕСТИ ВОЙСКА ИЗ ДОНБАССА В ОБМЕН НА
Dialogue: 0,0:12:33.55,0:12:35.31,Caption,,0,0,0,,ПЕРСПЕКТИВУ ВСТУПЛЕНИЯ В НАТО.
Dialogue: 0,0:12:37.59,0:12:42.23,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ВЫГЛЯДИТ СТРАННО, ПОСКОЛЬКУ ПОЗИЦИЯ МОСКВЫ ПО ЭТОМУ ВОПРОСУ ИЗВЕСТНА
Dialogue: 0,0:12:42.23,0:12:45.51,Caption,,0,0,0,,ДАВНО. РОССИЯ ВЫСТУПАЕТ ПРОТИВ ЧЛЕНСТВА УКРАИНЫ В
Dialogue: 0,0:12:45.51,0:12:48.31,Caption,,0,0,0,,АЛЬЯНСЕ И СЧИТАЕТ РАЗМЕЩЕНИЕ ЕГО ВОЕННОЙ
Dialogue: 0,0:12:48.31,0:12:50.31,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ ПРИНЦИПИАЛЬНОЙ УГРОЗОЙ.
Dialogue: 0,0:12:52.59,0:12:55.23,Caption,,0,0,0,,ЗАЧЕМ ТОГДА АМЕРИКАНЦАМ ПРЕДЛАГАТЬ СОЧЕТАНИЕ,
Dialogue: 0,0:12:55.40,0:12:57.95,Caption,,0,0,0,,КОТОРОЕ ПОЧТИ НАВЕРНЯКА НЕ УСТРОИТ РОССИЙСКУЮ
Dialogue: 0,0:12:57.95,0:13:01.43,Caption,,0,0,0,,СТОРОНУ? ВОЗМОЖНО,
Dialogue: 0,0:13:01.62,0:13:04.47,Caption,,0,0,0,,ИМ ТРЕБОВАЛОСЬ НЕ СОГЛАСИЕ ЗЕЛЕНСКОГО. ИМ МОГ
Dialogue: 0,0:13:04.47,0:13:09.86,Caption,,0,0,0,,ПОНАДОБИТЬСЯ ЕГО ОТКАЗ. ТАКОЙ ВОПРОС ПОЗВОЛЯЕТ ПРОВЕРИТЬ,
Dialogue: 0,0:13:10.10,0:13:12.26,Caption,,0,0,0,,ГОТОВ ЛИ УКРАИНСКИЙ ПРЕЗИДЕНТ ОБСУЖДАТЬ
Dialogue: 0,0:13:12.26,0:13:14.50,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЙ КОМПРОМИСС ДАЖЕ ПРИ ОБЕЩАНИИ
Dialogue: 0,0:13:14.50,0:13:17.78,Caption,,0,0,0,,ЧЛЕНСТВА В НАТО. ВМЕСТО ОБЩИХ ЗАЯВЛЕНИЙ ВАШИНГТОН
Dialogue: 0,0:13:17.78,0:13:21.94,Caption,,0,0,0,,ПОЛУЧАЕТ ТОЧНУЮ ГРАНИЦУ, ЗА КОТОРУЮ ЗЕЛЕНСКИЙ НЕ НАМЕРЕН ОТСТУПАТЬ.
Dialogue: 0,0:13:24.22,0:13:28.30,Caption,,0,0,0,,ПОСЛЕ ЭТОГО НЕ НУЖНО ГАДАТЬ, НАСКОЛЬКО ОН УСТУПЧИВ. ОТВЕТ УЖЕ ДАН,
Dialogue: 0,0:13:28.46,0:13:32.62,Caption,,0,0,0,,УСЛОВИЯ ПЕРЕЧИСЛЕНЫ, ПРОСТРАНСТВО ДЛЯ ДАЛЬНЕЙШЕГО ДАВЛЕНИЯ ИЗМЕРЕНО.
Dialogue: 0,0:13:34.90,0:13:37.62,Caption,,0,0,0,,ПО ОПУБЛИКОВАННОМУ ИЗЛОЖЕНИЮ ПОЗИЦИИ ЗЕЛЕНСКОГО,
Dialogue: 0,0:13:37.94,0:13:40.10,Caption,,0,0,0,,ПОДОБНОЕ РЕШЕНИЕ ПОТРЕБОВАЛО БЫ ГАРАНТИЙ
Dialogue: 0,0:13:40.10,0:13:43.06,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ДЕНЕГ НА СОДЕРЖАНИЕ АРМИИ,
Dialogue: 0,0:13:43.22,0:13:46.26,Caption,,0,0,0,,ПОСТАВОК ВООРУЖЕНИЙ И ФИНАНСИРОВАНИЯ ВОССТАНОВЛЕНИЯ
Dialogue: 0,0:13:46.26,0:13:49.94,Caption,,0,0,0,,УКРАИНЫ. НЕЙТРАЛЬНЫЙ СТАТУС ОН ОТВЕРГАЕТ. ПРИЗНАВАТЬ
Dialogue: 0,0:13:50.02,0:13:52.18,Caption,,0,0,0,,УТРАЧЕННЫЕ ТЕРРИТОРИИ РОССИЙСКИМИ ТОЖЕ НЕ
Dialogue: 0,0:13:52.18,0:13:56.14,Caption,,0,0,0,,СОБИРАЕТСЯ. ИНЫМИ СЛОВАМИ,
Dialogue: 0,0:13:56.31,0:13:58.78,Caption,,0,0,0,,ПЕРЕД АМЕРИКАНЦАМИ ОКАЗАЛСЯ НЕ КОРОТКИЙ ОТВЕТ,
Dialogue: 0,0:13:58.96,0:14:01.90,Caption,,0,0,0,,А СЧЁТ С НЕСКОЛЬКИМИ СТРОКАМИ. ТЕРРИТОРИИ МОЖНО
Dialogue: 0,0:14:01.90,0:14:04.30,Caption,,0,0,0,,ОБСУЖДАТЬ ТОЛЬКО ВМЕСТЕ С ЧЛЕНСТВОМ В НАТО,
Dialogue: 0,0:14:04.46,0:14:08.46,Caption,,0,0,0,,ОРУЖИЕМ, ФИНАНСИРОВАНИЕМ И ВОССТАНОВЛЕНИЕМ. ДАЖЕ РЕСТОРАН
Dialogue: 0,0:14:08.46,0:14:10.22,Caption,,0,0,0,,ОБЫЧНО СНАЧАЛА ПРИНОСИТ БЛЮДО,
Dialogue: 0,0:14:10.38,0:14:16.81,Caption,,0,0,0,,А УЖЕ ПОТОМ ТАКУЮ БУМАГУ. ДЛЯ ВАШИНГТОНА ВАЖЕН САМ РЕЗУЛЬТАТ ПРОВЕРКИ.
Dialogue: 0,0:14:17.12,0:14:20.97,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПОКАЗАЛ, ЧТО ЕГО ОТКАЗ НЕ СВОДИТСЯ К ОДНОМУ ПУНКТУ.
Dialogue: 0,0:14:21.22,0:14:23.53,Caption,,0,0,0,,ОН ПРИВЯЗАН К ЦЕЛОМУ НАБОРУ ТРЕБОВАНИЙ,
Dialogue: 0,0:14:23.78,0:14:26.33,Caption,,0,0,0,,БЕЗ ВЫПОЛНЕНИЯ КОТОРЫХ ДВИЖЕНИЕ ДАЛЬШЕ ДЛЯ НЕГО
Dialogue: 0,0:14:26.33,0:14:31.96,Caption,,0,0,0,,НЕПРИЕМЛЕМО. НО ПЕРЕГОВОРЫ ВЕДУТ НЕ ДВОЕ В ПУСТОЙ КОМНАТЕ.
Dialogue: 0,0:14:32.14,0:14:35.24,Caption,,0,0,0,,РОССИЯ НАСТАИВАЕТ НА СВОИХ УСЛОВИЯХ. СОЕДИНЁННЫЕ
Dialogue: 0,0:14:35.24,0:14:38.12,Caption,,0,0,0,,ШТАТЫ ИЩУТ ПРИЕМЛЕМУЮ КОНСТРУКЦИЮ СОГЛАШЕНИЯ.
Dialogue: 0,0:14:38.36,0:14:41.32,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ ЗАЩИЩАЮТ СОБСТВЕННЫЕ ИНТЕРЕСЫ.
Dialogue: 0,0:14:41.65,0:14:44.52,Caption,,0,0,0,,КИЕВ СТАРАЕТСЯ СОХРАНИТЬ МАКСИМАЛЬНОЕ ЧИСЛО ПРЕЖНИХ
Dialogue: 0,0:14:44.52,0:14:49.61,Caption,,0,0,0,,ТРЕБОВАНИЙ. ТЕПЕРЬ К ЭТОМУ ДОБАВИЛИСЬ СЛУХ О ВОЗМОЖНОМ
Dialogue: 0,0:14:49.61,0:14:52.57,Caption,,0,0,0,,УСТРАНЕНИИ ЗЕЛЕНСКОГО И ОТКРЫТЫЙ КОНФЛИКТ МЕЖДУ
Dialogue: 0,0:14:52.57,0:14:54.97,Caption,,0,0,0,,УКРАИНСКИМИ СИЛОВЫМИ И АНТИКОРРУПЦИОННЫМИ
Dialogue: 0,0:14:54.97,0:15:00.38,Caption,,0,0,0,,СТРУКТУРАМИ. ТАК И ВЫГЛЯДИТ ДАВЛЕНИЕ СРАЗУ С ДВУХ СТОРОН.
Dialogue: 0,0:15:02.65,0:15:05.61,Caption,,0,0,0,,ОДНАКО РЕШАЮЩАЯ ФИГУРА ЗДЕСЬ МОЖЕТ НАХОДИТЬСЯ НЕ В
Dialogue: 0,0:15:05.61,0:15:11.10,Caption,,0,0,0,,ПРЕЗИДЕНТСКОМ КАБИНЕТЕ. ГОРАЗДО ВАЖНЕЕ РЕАКЦИЯ ЛЮДЕЙ,
Dialogue: 0,0:15:11.22,0:15:13.98,Caption,,0,0,0,,КОТОРЫЕ ОКРУЖАЮТ ЗЕЛЕНСКОГО И ДОЛЖНЫ ВЫПОЛНЯТЬ ЕГО
Dialogue: 0,0:15:13.98,0:15:18.33,Caption,,0,0,0,,РЕШЕНИЯ. ПРЕЗИДЕНТ МОЖЕТ ВЫСТУПАТЬ,
Dialogue: 0,0:15:18.49,0:15:23.13,Caption,,0,0,0,,ОТВЕРГАТЬ ПРЕДЛОЖЕНИЯ, ТРЕБОВАТЬ ОРУЖИЕ И НАСТАИВАТЬ НА ГАРАНТИЯХ. НО
Dialogue: 0,0:15:23.13,0:15:26.41,Caption,,0,0,0,,ГОСУДАРСТВЕННАЯ МАШИНА РАБОТАЕТ РУКАМИ СИЛОВИКОВ,
Dialogue: 0,0:15:26.57,0:15:29.53,Caption,,0,0,0,,ЧИНОВНИКОВ, РУКОВОДИТЕЛЕЙ ВЕДОМСТВ И ЛЮДЕЙ,
Dialogue: 0,0:15:29.61,0:15:33.85,Caption,,0,0,0,,ОТВЕЧАЮЩИХ ЗА ДЕНЬГИ, БЕЗОПАСНОСТЬ И СВЯЗЬ МЕЖДУ УЧРЕЖДЕНИЯМИ.
Dialogue: 0,0:15:36.14,0:15:38.54,Caption,,0,0,0,,КАЖДЫЙ ИЗ НИХ ОЦЕНИВАЕТ НЕ ТОЛЬКО ОФИЦИАЛЬНУЮ
Dialogue: 0,0:15:38.54,0:15:41.66,Caption,,0,0,0,,ПОЗИЦИЮ КИЕВА. ОНИ ОЦЕНИВАЮТ ВЕРОЯТНОСТЬ ТОГО,
Dialogue: 0,0:15:41.82,0:15:43.90,Caption,,0,0,0,,ЧТО НЫНЕШНЯЯ СИСТЕМА СОХРАНИТСЯ,
Dialogue: 0,0:15:44.14,0:15:46.30,Caption,,0,0,0,,А ВМЕСТЕ С НЕЙ СОХРАНЯТСЯ ИХ ДОЛЖНОСТИ И
Dialogue: 0,0:15:46.30,0:15:50.99,Caption,,0,0,0,,ЗАЩИТА. ПОКА КУРС КАЖЕТСЯ УСТОЙЧИВЫМ,
Dialogue: 0,0:15:51.22,0:15:54.19,Caption,,0,0,0,,ВСЕ ЛЕГКО ДЕМОНСТРИРУЮТ ЕДИНСТВО. КОГДА СНАРУЖИ
Dialogue: 0,0:15:54.19,0:15:56.11,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ УГРОЗА РУКОВОДИТЕЛЮ,
Dialogue: 0,0:15:56.35,0:15:58.35,Caption,,0,0,0,,ВНУТРИ ИДУТ УГОЛОВНЫЕ РАССЛЕДОВАНИЯ,
Dialogue: 0,0:15:58.59,0:16:01.47,Caption,,0,0,0,,А ВЕДОМСТВА ОБВИНЯЮТ ДРУГ ДРУГА В ПОМОЩИ ПРОТИВНИКУ,
Dialogue: 0,0:16:01.70,0:16:03.95,Caption,,0,0,0,,СТРОЕВОЕ РАВНЕНИЕ НАЧИНАЕТ ВЫГЛЯДЕТЬ СЛЕГКА
Dialogue: 0,0:16:03.95,0:16:09.02,Caption,,0,0,0,,ТЕАТРАЛЬНО. ИМЕННО ЗДЕСЬ СОЕДИНЯЮТСЯ ОБЕ ЛИНИИ.
Dialogue: 0,0:16:11.30,0:16:15.46,Caption,,0,0,0,,ПЕРВАЯ СВЯЗАНА СО СЛУХОМ, ЧТО МОСКВА СНЯЛА ОГРАНИЧЕНИЕ НА ФИЗИЧЕСКОЕ
Dialogue: 0,0:16:15.46,0:16:18.10,Caption,,0,0,0,,УСТРАНЕНИЕ ЗЕЛЕНСКОГО И НЕКОТОРЫХ ПРЕДСТАВИТЕЛЕЙ
Dialogue: 0,0:16:18.10,0:16:24.69,Caption,,0,0,0,,УКРАИНСКОЙ ВЕРХУШКИ. ВТОРАЯ РАЗВИВАЕТСЯ ВНУТРИ УКРАИНЫ. ГЕНЕРАЛ СБУ
Dialogue: 0,0:16:24.69,0:16:27.73,Caption,,0,0,0,,ЗАЯВЛЯЕТ ОБ ОПЕРАЦИИ ПРОТИВ РУКОВОДСТВА СТРАНЫ И
Dialogue: 0,0:16:27.73,0:16:30.05,Caption,,0,0,0,,ПЕРЕНОСИТ ПОДОЗРЕНИЕ НА НАБУ И САП,
Dialogue: 0,0:16:30.37,0:16:32.85,Caption,,0,0,0,,КОТОРЫЕ РАССЛЕДУЮТ ВОЗМОЖНУЮ КОРРУПЦИЮ В СИЛОВОЙ
Dialogue: 0,0:16:32.85,0:16:38.26,Caption,,0,0,0,,СИСТЕМЕ. ЭТО И ЕСТЬ ЛИКВИДАЦИЯ С ДВУХ СТОРОН. ОДНА
Dialogue: 0,0:16:38.26,0:16:41.38,Caption,,0,0,0,,УГРОЖАЕТ САМОМУ ЧЕЛОВЕКУ. ДРУГАЯ РАЗЪЕДАЕТ ЕГО
Dialogue: 0,0:16:41.38,0:16:43.14,Caption,,0,0,0,,СПОСОБНОСТЬ УПРАВЛЯТЬ АППАРАТОМ,
Dialogue: 0,0:16:43.29,0:16:50.05,Caption,,0,0,0,,КОТОРОМУ ОН ДОЛЖЕН ДОВЕРЯТЬ. ВАШИНГТОН В ЭТО ВРЕМЯ ВЫЯСНЯЕТ ПРЕДЕЛЫ ЕГО УСТУПОК.
Dialogue: 0,0:16:50.41,0:16:52.53,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ПОЛИЦИЯ ПЫТАЕТСЯ ПОНЯТЬ,
Dialogue: 0,0:16:52.77,0:16:55.49,Caption,,0,0,0,,ПОЧЕМУ ПОДОЗРЕВАЕМЫЕ ИСЧЕЗАЮТ ПЕРЕД ПРОВЕРКАМИ.
Dialogue: 0,0:16:55.86,0:16:59.41,Caption,,0,0,0,,УКРАИНСКИЕ ВЕДОМСТВА СПОРЯТ, КТО ИЗ НИХ ЛОВИТ ПРЕСТУПНИКОВ,
Dialogue: 0,0:16:59.57,0:17:05.28,Caption,,0,0,0,,А КТО ПОМОГАЕТ РОССИИ. ПОПРОБУЙТЕ РУКОВОДИТЬ ТАКОЙ СИСТЕМОЙ,
Dialogue: 0,0:17:05.59,0:17:08.32,Caption,,0,0,0,,ЕСЛИ ЛЮБОЙ ДОКЛАД ПРИХОДИТСЯ СНАЧАЛА ПРОВЕРЯТЬ НА
Dialogue: 0,0:17:08.40,0:17:11.52,Caption,,0,0,0,,ТО, НЕ НАПИСАН ЛИ ОН УЧАСТНИКОМ СОСЕДНЕЙ ВНУТРЕННЕЙ
Dialogue: 0,0:17:11.60,0:17:17.40,Caption,,0,0,0,,ВОЙНЫ. ВНЕШНЕГО ПРОТИВНИКА ХОТЯ БЫ ВИДНО. НАМНОГО ХУЖЕ,
Dialogue: 0,0:17:17.64,0:17:20.84,Caption,,0,0,0,,КОГДА ПРЕЗИДЕНТ НЕ УВЕРЕН, КТО ОХРАНЯЕТ ЕГО ВЛАСТЬ,
Dialogue: 0,0:17:21.08,0:17:23.16,Caption,,0,0,0,,КТО РАССЛЕДУЕТ ЕЁ ЗЛОУПОТРЕБЛЕНИЯ,
Dialogue: 0,0:17:23.32,0:17:25.64,Caption,,0,0,0,,А КТО УЖЕ ГОТОВИТСЯ ПЕРЕЖИТЬ ЕЁ БЕЗ НЕГО.
Dialogue: 0,0:17:27.92,0:17:30.48,Caption,,0,0,0,,СИЛЬНОЕ ДАВЛЕНИЕ ИЗВНЕ ГОСУДАРСТВО СПОСОБНО
Dialogue: 0,0:17:30.48,0:17:34.80,Caption,,0,0,0,,ВЫДЕРЖИВАТЬ ДОЛГО, ПОКА ЕГО КЛЮЧЕВЫЕ ЛЮДИ ДОВЕРЯЮТ ДРУГ ДРУГУ. НО
Dialogue: 0,0:17:34.80,0:17:37.84,Caption,,0,0,0,,КОГДА СИЛОВЫЕ И АНТИКОРРУПЦИОННЫЕ ОРГАНЫ ПЕРЕХОДЯТ К
Dialogue: 0,0:17:37.84,0:17:41.36,Caption,,0,0,0,,ВЗАИМНЫМ ОБВИНЕНИЯМ, КАЖДЫЙ СЛУХ СТАНОВИТСЯ ТЯЖЕЛЕЕ,
Dialogue: 0,0:17:41.60,0:17:44.48,Caption,,0,0,0,,А КАЖДОЕ ТРЕБОВАНИЕ ИЗ ВАШИНГТОНА ИЛИ МОСКВЫ ЗВУЧИТ
Dialogue: 0,0:17:44.48,0:17:49.81,Caption,,0,0,0,,ГРОМЧЕ. В ИТОГЕ ДАЛЬНЕЙШИЕ РЕШЕНИЯ ЗАВИСЯТ НЕ ТОЛЬКО ОТ
Dialogue: 0,0:17:49.81,0:17:53.09,Caption,,0,0,0,,УСЛОВИЙ ЗА ПЕРЕГОВОРНЫМ СТОЛОМ. ОНИ ЗАВИСЯТ ОТ ТОГО,
Dialogue: 0,0:17:53.25,0:17:56.21,Caption,,0,0,0,,СПОСОБЕН ЛИ ЗЕЛЕНСКИЙ ПО ПРЕЖНЕМУ УПРАВЛЯТЬ ЛЮДЬМИ,
Dialogue: 0,0:17:56.44,0:17:59.57,Caption,,0,0,0,,КОТОРЫМ ПОРУЧЕНО ВОПЛОЩАТЬ ЭТИ РЕШЕНИЯ. И ЕСЛИ ВЫ
Dialogue: 0,0:17:59.57,0:18:03.25,Caption,,0,0,0,,СЧИТАЕТЕ, ЧТО ПЕРЕД НАМИ РЕАЛЬНАЯ ПОДГОТОВКА К ЕГО УСТРАНЕНИЮ
Dialogue: 0,0:18:03.41,0:18:05.25,Caption,,0,0,0,,ИЛИ БОЛЬШАЯ ОПЕРАЦИЯ ДАВЛЕНИЯ,
Dialogue: 0,0:18:05.48,0:18:07.33,Caption,,0,0,0,,НАПИШИТЕ СВОЁ МНЕНИЕ В КОММЕНТАРИЯХ.
