Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,ЕВРОПА СНОВА ОБЪЯВЛЯЕТ ПРЕЖНИЙ КУРС ЕДИНСТВЕННО
Dialogue: 0,0:00:02.76,0:00:06.52,Caption,,0,0,0,,ВОЗМОЖНЫМ, ОТКАЗЫВАЕТСЯ ОТ РАЗГОВОРА С РОССИЕЙ И ОБЕЩАЕТ
Dialogue: 0,0:00:06.52,0:00:09.64,Caption,,0,0,0,,УКРАИНЕ БОЛЬШЕ ДЕНЕГ И БОЛЬШЕ ОРУЖИЯ. НА ВОПРОС
Dialogue: 0,0:00:09.64,0:00:14.20,Caption,,0,0,0,,О СРОКЕ ЗВУЧИТ "СТОЛЬКО, СКОЛЬКО ПОТРЕБУЕТСЯ". НОВЫЙ ЗАЁМ СВЫШЕ СОРОКА
Dialogue: 0,0:00:14.20,0:00:17.00,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ПОДНИМЕТ ОБЩИЕ ОБЯЗАТЕЛЬСТВА ВЫШЕ
Dialogue: 0,0:00:17.00,0:00:19.64,Caption,,0,0,0,,ДВУХСОТ МИЛЛИАРДОВ. ДЕНЬГИ ПОКА ЧУЖИЕ,
Dialogue: 0,0:00:19.88,0:00:22.20,Caption,,0,0,0,,ЗАТО ВОЗВРАЩАТЬ ИХ ПРИДЁТСЯ ВПОЛНЕ СВОИМ.
Dialogue: 0,0:00:24.47,0:00:27.27,Caption,,0,0,0,,НО ГДЕ ПОБЕДА И КАК ВЫГЛЯДИТ КОНЕЧНЫЙ РЕЗУЛЬТАТ?
Dialogue: 0,0:00:27.56,0:00:29.35,Caption,,0,0,0,,РОССИЯ ДОЛЖНА СОГЛАСИТЬСЯ НА ЧТО,
Dialogue: 0,0:00:29.56,0:00:31.59,Caption,,0,0,0,,А ВОЙСКА УЙТИ КУДА? ДО МОСКВЫ?
Dialogue: 0,0:00:31.67,0:00:35.91,Caption,,0,0,0,,ДО УРАЛА? ГДЕ ТА ТОЧКА, ПОСЛЕ КОТОРОЙ ЕВРОПА СМОЖЕТ СКАЗАТЬ,
Dialogue: 0,0:00:36.07,0:00:39.91,Caption,,0,0,0,,ЧТО ЗАДАЧА ВЫПОЛНЕНА, А НЕ ПРОСТО ПОПРОСИТЬ ЕЩЁ БОЛЬШЕ И ПРОДОЛЖАТЬ
Dialogue: 0,0:00:39.99,0:00:45.95,Caption,,0,0,0,,ПРЕЖНИЙ КУРС? НЕМЕЦКАЯ HANDELSBLATT УЖЕ ВЫСКАЗАЛАСЬ БЕЗ ПРИВЫЧНОЙ
Dialogue: 0,0:00:45.95,0:00:49.07,Caption,,0,0,0,,УПАКОВКИ. ЗАПАДНАЯ ПОМОЩЬ НЕ СПАСЁТ УКРАИНУ ОТ
Dialogue: 0,0:00:49.07,0:00:51.87,Caption,,0,0,0,,ПОРАЖЕНИЯ. ГЕРМАНИЯ МОЖЕТ ОТПРАВЛЯТЬ ДЕНЬГИ И
Dialogue: 0,0:00:51.87,0:00:55.63,Caption,,0,0,0,,ВООРУЖЕНИЕ, НО ГЛАВНЫЕ РЕШЕНИЯ ПРИНИМАЮТСЯ В РАЗГОВОРЕ МОСКВЫ И
Dialogue: 0,0:00:55.63,0:00:58.35,Caption,,0,0,0,,ВАШИНГТОНА. БЕРЛИН УЧАСТВУЕТ В РАСХОДАХ,
Dialogue: 0,0:00:58.52,0:01:01.47,Caption,,0,0,0,,А НЕ В ВЫБОРЕ ФИНАЛА. ОЧЕНЬ ПОЧЁТНАЯ ДОЛЖНОСТЬ
Dialogue: 0,0:01:01.47,0:01:03.63,Caption,,0,0,0,,ГЛАВНЫЙ СПОНСОР ЧУЖОГО СОВЕЩАНИЯ.
Dialogue: 0,0:01:05.89,0:01:08.78,Caption,,0,0,0,,ПОРАЖЕНИЕ УКРАИНЫ НЕИЗБЕЖНО. ОДНАКО НЫНЕШНИЙ
Dialogue: 0,0:01:08.78,0:01:11.18,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ЦЕНТР ДЕРЖИТСЯ ПРЕЖНЕЙ ЛИНИИ,
Dialogue: 0,0:01:11.26,0:01:14.14,Caption,,0,0,0,,СЛОВНО ПОВТОРЕНИЕ ОДНОГО ДЕЙСТВИЯ ОДНАЖДЫ ОБЯЗАНО
Dialogue: 0,0:01:14.14,0:01:15.66,Caption,,0,0,0,,ДАТЬ ПРОТИВОПОЛОЖНЫЙ РЕЗУЛЬТАТ.
Dialogue: 0,0:01:16.22,0:01:18.38,Caption,,0,0,0,,НЕ ПОЛУЧИЛОСЬ С ПРЕЖНИМ ОБЪЁМОМ ПОМОЩИ,
Dialogue: 0,0:01:18.54,0:01:21.66,Caption,,0,0,0,,НУЖЕН БОЛЬШИЙ. НЕ СРАБОТАЛИ ПРЕЖНИЕ САНКЦИИ,
Dialogue: 0,0:01:21.82,0:01:25.02,Caption,,0,0,0,,ПОТРЕБУЕТСЯ СЛЕДУЮЩИЙ ПАКЕТ. ЦЕЛЬ НЕ ПРИБЛИЖАЕТСЯ,
Dialogue: 0,0:01:25.26,0:01:27.74,Caption,,0,0,0,,ЗАТО ПАПКА С РЕШЕНИЯМИ СТАНОВИТСЯ ТОЛЩЕ.
Dialogue: 0,0:01:30.01,0:01:32.57,Caption,,0,0,0,,ГЛУБИННЫЙ РАСЧЁТ ЭТОГО КУРСА ВСЁ ЕЩЁ СВЯЗАН С
Dialogue: 0,0:01:32.57,0:01:35.85,Caption,,0,0,0,,НАДЕЖДОЙ НА ИЗМЕНЕНИЯ ВНУТРИ РОССИИ. СЧИТАЕТСЯ,
Dialogue: 0,0:01:36.01,0:01:38.73,Caption,,0,0,0,,ЧТО УЙДЁТ ПУТИН, ИЗМЕНИТСЯ РУКОВОДСТВО,
Dialogue: 0,0:01:38.89,0:01:42.09,Caption,,0,0,0,,А ЗАТЕМ МОСКВА ПЕРЕСМОТРИТ ПРЕЖНИЕ РЕШЕНИЯ. ОЧЕНЬ
Dialogue: 0,0:01:42.09,0:01:45.29,Caption,,0,0,0,,АККУРАТНАЯ КОНСТРУКЦИЯ, КОТОРАЯ ДЕРЖИТСЯ НА СОБЫТИИ,
Dialogue: 0,0:01:45.45,0:01:51.40,Caption,,0,0,0,,НЕ ПОДВЛАСТНОМ ЕВРОПЕ. ЗА ЧЕТВЕРТЬ ВЕКА В РОССИИ СЛОЖИЛАСЬ СИСТЕМА ИЗ
Dialogue: 0,0:01:51.40,0:01:54.04,Caption,,0,0,0,,СИЛОВЫХ ВЕДОМСТВ, АРМИИ, СПЕЦСЛУЖБ,
Dialogue: 0,0:01:54.20,0:01:57.40,Caption,,0,0,0,,БЮРОКРАТИИ, ГОСУДАРСТВЕННЫХ КОРПОРАЦИЙ И ГРУПП,
Dialogue: 0,0:01:57.64,0:02:01.16,Caption,,0,0,0,,ЧЬЁ ПОЛОЖЕНИЕ ЗАВИСИТ ОТ СУЩЕСТВУЮЩЕГО ПОРЯДКА. УХОД
Dialogue: 0,0:02:01.16,0:02:04.36,Caption,,0,0,0,,ОДНОГО ЧЕЛОВЕКА НЕ ВЫКЛЮЧИТ ЭТОТ МЕХАНИЗМ. НА МЕСТЕ
Dialogue: 0,0:02:04.36,0:02:06.44,Caption,,0,0,0,,ПУТИНА МОЖЕТ ПОЯВИТЬСЯ ПУТИН ДВА НОЛЬ,
Dialogue: 0,0:02:06.68,0:02:09.56,Caption,,0,0,0,,А ЗАТЕМ ПУТИН ТРИ НОЛЬ. ФАМИЛИЯ БУДЕТ ДРУГОЙ,
Dialogue: 0,0:02:09.80,0:02:11.96,Caption,,0,0,0,,ПРОИСХОЖДЕНИЕ РЕШЕНИЙ ОСТАНЕТСЯ ТЕМ ЖЕ.
Dialogue: 0,0:02:14.23,0:02:17.11,Caption,,0,0,0,,ВЫХОДЦЫ ИЗ КГБ И ДРУГИХ СИЛОВЫХ СТРУКТУР ПОЛУЧИЛИ
Dialogue: 0,0:02:17.19,0:02:19.83,Caption,,0,0,0,,ВЛАСТЬ НЕ ЗАТЕМ, ЧТОБЫ ПЕРЕДАТЬ ЕЁ ЛЮДЯМ,
Dialogue: 0,0:02:19.99,0:02:22.07,Caption,,0,0,0,,КОТОРЫЕ НАЧНУТ ОТМЕНЯТЬ ИХ РЕШЕНИЯ,
Dialogue: 0,0:02:22.15,0:02:24.47,Caption,,0,0,0,,ПРОВЕРЯТЬ СОБСТВЕННОСТЬ И МЕНЯТЬ УСТРОЙСТВО
Dialogue: 0,0:02:24.47,0:02:27.51,Caption,,0,0,0,,ГОСУДАРСТВА. ВЛАСТЬ РЕДКО ГОТОВИТ ПРЕЕМНИКА С
Dialogue: 0,0:02:27.51,0:02:30.15,Caption,,0,0,0,,ПРОГРАММОЙ СОБСТВЕННОГО ДЕМОНТАЖА. ЗДЕСЬ ОНА
Dialogue: 0,0:02:30.23,0:02:31.99,Caption,,0,0,0,,ПРОЯВЛЯЕТ ЗАВИДНУЮ СТАБИЛЬНОСТЬ,
Dialogue: 0,0:02:32.15,0:02:34.31,Caption,,0,0,0,,НЕЗАВИСИМО ОТ СТРАНЫ И ЦВЕТА ГАЛСТУКА.
Dialogue: 0,0:02:36.59,0:02:38.75,Caption,,0,0,0,,РАСПАД СОВЕТСКОГО СОЮЗА РОССИЙСКАЯ ЭЛИТА
Dialogue: 0,0:02:38.75,0:02:40.91,Caption,,0,0,0,,ВОСПРИНИМАЕТ НЕ КАК СТАРУЮ ФОТОГРАФИЮ,
Dialogue: 0,0:02:41.07,0:02:44.19,Caption,,0,0,0,,А КАК ПРЕДУПРЕЖДЕНИЕ. ВЫВОД ПРОСТ СИСТЕМА ДОЛЖНА
Dialogue: 0,0:02:44.27,0:02:46.75,Caption,,0,0,0,,ПЕРЕЖИВАТЬ РУКОВОДИТЕЛЕЙ И НЕ ДОПУСКАТЬ НОВОГО
Dialogue: 0,0:02:46.75,0:02:49.55,Caption,,0,0,0,,РАСПАДА ГОСУДАРСТВА. ПОЭТОМУ ОЖИДАНИЕ НОВОГО
Dialogue: 0,0:02:49.55,0:02:53.39,Caption,,0,0,0,,ЕЛЬЦИНА, КОТОРЫЙ ВЕРНЁТ ОТНОШЕНИЯ НА УДОБНЫЕ ЗАПАДУ УСЛОВИЯ,
Dialogue: 0,0:02:53.55,0:02:56.83,Caption,,0,0,0,,НЕ СТРАТЕГИЯ. ЭТО ЗАЯВКА НА ЧУДО С НЕОПРЕДЕЛЁННОЙ
Dialogue: 0,0:02:56.83,0:03:03.52,Caption,,0,0,0,,ДАТОЙ ДОСТАВКИ. САНКЦИОННЫЙ РАСЧЁТ СТРОИЛСЯ ПОХОЖЕ. ДАВЛЕНИЕ ДОЛЖНО
Dialogue: 0,0:03:03.52,0:03:08.32,Caption,,0,0,0,,БЫЛО ОСЛАБИТЬ ЭКОНОМИКУ, ОБОСТРИТЬ ВНУТРЕННИЕ ПРОТИВОРЕЧИЯ И ЗАСТАВИТЬ КРЕМЛЬ
Dialogue: 0,0:03:08.32,0:03:11.92,Caption,,0,0,0,,ОТСТУПИТЬ. ПРОШЛО ПОЧТИ ПЯТЬ ЛЕТ ВОЙНЫ. РОССИЙСКАЯ
Dialogue: 0,0:03:11.92,0:03:15.68,Caption,,0,0,0,,СИСТЕМА СОХРАНИЛАСЬ, РУКОВОДСТВО НЕ ПРИНЯЛО ТРЕБУЕМЫХ УСЛОВИЙ,
Dialogue: 0,0:03:15.84,0:03:17.84,Caption,,0,0,0,,ОБЕЩАННЫЙ ПЕРЕЛОМ НЕ СОСТОЯЛСЯ.
Dialogue: 0,0:03:20.11,0:03:22.59,Caption,,0,0,0,,ОФИЦИАЛЬНЫЙ ОТВЕТ САНКЦИЯМ НЕОБХОДИМО БОЛЬШЕ
Dialogue: 0,0:03:22.59,0:03:25.15,Caption,,0,0,0,,ВРЕМЕНИ. ПЕРЕВОД ЛЕКАРСТВО НЕ ПОМОГЛО,
Dialogue: 0,0:03:25.34,0:03:29.79,Caption,,0,0,0,,ПОЭТОМУ ДОЗУ УВЕЛИЧАТ, А ПАЦИЕНТА ПОПРОСЯТ НЕ ОТВЛЕКАТЬ ВРАЧА ВОПРОСАМИ.
Dialogue: 0,0:03:32.08,0:03:35.28,Caption,,0,0,0,,НО СКОЛЬКО ИМЕННО ВРЕМЕНИ? ЕСЛИ РЕЗУЛЬТАТ НЕ ДОСТИГНУТ,
Dialogue: 0,0:03:35.53,0:03:38.64,Caption,,0,0,0,,НУЖЕН НОВЫЙ МЕХАНИЗМ ИЛИ ЧЕСТНОЕ ПРИЗНАНИЕ ОШИБКИ.
Dialogue: 0,0:03:38.96,0:03:41.92,Caption,,0,0,0,,ПРОДЛЕВАТЬ ОЖИДАНИЕ ЛЕГЧЕ, ЧЕМ МЕНЯТЬ РЕШЕНИЕ,
Dialogue: 0,0:03:42.15,0:03:44.32,Caption,,0,0,0,,ОСОБЕННО КОГДА ЦЕНУ ОПЛАЧИВАЕТ НЕ ТОТ,
Dialogue: 0,0:03:44.48,0:03:50.60,Caption,,0,0,0,,КТО ВЫСТУПАЕТ У МИКРОФОНА. ЕВРОПЕЙЦАМ УЖЕ ПРЕДЛАГАЛИ НЕСКОЛЬКО ВАРИАНТОВ
Dialogue: 0,0:03:50.60,0:03:53.88,Caption,,0,0,0,,ПОБЕДЫ. СНАЧАЛА САНКЦИИ ДОЛЖНЫ БЫЛИ ИЗМЕНИТЬ РАСЧЁТЫ
Dialogue: 0,0:03:53.88,0:03:57.24,Caption,,0,0,0,,МОСКВЫ. ЗАТЕМ ПОСТАВКИ ОРУЖИЯ ДОЛЖНЫ БЫЛИ ПЕРЕЛОМИТЬ
Dialogue: 0,0:03:57.24,0:04:00.20,Caption,,0,0,0,,ХОД БОЕВЫХ ДЕЙСТВИЙ. ПОТОМ ТРЕБОВАЛОСЬ ДОЖДАТЬСЯ
Dialogue: 0,0:04:00.20,0:04:05.88,Caption,,0,0,0,,НОВОГО ПАКЕТА, СЕЗОНА, ПРОИЗВОДСТВА И РЕШЕНИЯ СОЮЗНИКОВ. ОБЕЩАНИЕ ПОСТОЯННО
Dialogue: 0,0:04:05.88,0:04:08.68,Caption,,0,0,0,,ПЕРЕЕЗЖАЛО ВПЕРЁД И КАЖДЫЙ РАЗ ПРОСИЛО ПОМОЧЬ С
Dialogue: 0,0:04:08.68,0:04:14.24,Caption,,0,0,0,,ВЕЩАМИ. ТЕПЕРЬ ЗАПАДНАЯ ПРЕССА САМА ОБСУЖДАЕТ ПОРАЖЕНИЕ
Dialogue: 0,0:04:14.24,0:04:17.36,Caption,,0,0,0,,УКРАИНЫ. ЕВРОПЕЙСКИЕ ВЛАСТИ НЕ НАЗЫВАЮТ ОШИБКУ
Dialogue: 0,0:04:17.36,0:04:19.92,Caption,,0,0,0,,ОШИБКОЙ. ОНИ НАЗЫВАЮТ ЕЁ ДОЛГОСРОЧНОЙ
Dialogue: 0,0:04:19.92,0:04:25.65,Caption,,0,0,0,,ПРИВЕРЖЕННОСТЬЮ. ЕСЛИ ВАМ НУЖЕН ПЕРЕВОД ТАКИХ РЕШЕНИЙ НА НОРМАЛЬНЫЙ
Dialogue: 0,0:04:25.65,0:04:29.42,Caption,,0,0,0,,ЯЗЫК, ПОДПИШИТЕСЬ. ЗДЕСЬ СУММА НАЗЫВАЕТСЯ СУММОЙ,
Dialogue: 0,0:04:29.50,0:04:33.10,Caption,,0,0,0,,РИСК РИСКОМ, А ОТСУТСТВИЕ ПЛАНА НЕ МАСКИРУЕТСЯ ВЫРАЖЕНИЕМ
Dialogue: 0,0:04:33.10,0:04:35.02,Caption,,0,0,0,,"СТРАТЕГИЧЕСКАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ".
Dialogue: 0,0:04:37.30,0:04:40.26,Caption,,0,0,0,,СПОСОБНА ЛИ ЕВРОПА ВООБЩЕ ВЕСТИ НЫНЕШНИЙ КУРС БЕЗ
Dialogue: 0,0:04:40.26,0:04:45.25,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ? ЭТОТ ВОПРОС СТАЛ ПРАКТИЧЕСКИМ,
Dialogue: 0,0:04:45.41,0:04:48.45,Caption,,0,0,0,,ПОТОМУ ЧТО ВАШИНГТОН УЖЕ ГОВОРИТ ИНАЧЕ. ДОНАЛЬД
Dialogue: 0,0:04:48.45,0:04:50.85,Caption,,0,0,0,,ТРАМП В ИНТЕРВЬЮ СИ БИ ЭС ОБВИНИЛ ЗЕЛЕНСКОГО
Dialogue: 0,0:04:50.85,0:04:54.13,Caption,,0,0,0,,В ОГРОМНОМ НЕУВАЖЕНИИ К РОССИИ. ОН ТАКЖЕ ЗАЯВИЛ,
Dialogue: 0,0:04:54.29,0:04:57.33,Caption,,0,0,0,,ЧТО ЗАПАДНЫЕ ПОСТАВКИ ВООРУЖЕНИЙ НЕ ДАЛИ ОЖИДАЕМОГО
Dialogue: 0,0:04:57.41,0:05:00.29,Caption,,0,0,0,,ЭФФЕКТА. В ОТДЕЛЬНОЙ ВИДЕОПУБЛИКАЦИИ ТА ЖЕ МЫСЛЬ
Dialogue: 0,0:05:00.29,0:05:03.25,Caption,,0,0,0,,ЗВУЧИТ ЕЩЁ ПРЯМЕЕ ПРЕЖНЕЕ ПОВЕДЕНИЕ КИЕВА ЗАВЕЛО
Dialogue: 0,0:05:03.25,0:05:06.13,Caption,,0,0,0,,ПЕРЕГОВОРЫ В ТУПИК, СОГЛАШЕНИЕ ПРИБЛИЖАЕТСЯ,
Dialogue: 0,0:05:06.37,0:05:08.77,Caption,,0,0,0,,А УКРАИНА ПОСЛЕ НЕГО БУДЕТ ВЫГЛЯДЕТЬ НЕСКОЛЬКО
Dialogue: 0,0:05:08.77,0:05:14.01,Caption,,0,0,0,,ИНАЧЕ. ТРАМП СПОСОБЕН ПОМЕНЯТЬ ИНТОНАЦИЮ БЫСТРЕЕ,
Dialogue: 0,0:05:14.17,0:05:17.21,Caption,,0,0,0,,ЧЕМ ПЕРЕВОДЧИК УСПЕЕТ НАДЕТЬ НАУШНИКИ. НО СЕЙЧАС
Dialogue: 0,0:05:17.21,0:05:20.01,Caption,,0,0,0,,ВАЖЕН ВЫБРАННЫЙ КУРС. ПРЕЗИДЕНТ СОЕДИНЁННЫХ ШТАТОВ
Dialogue: 0,0:05:20.01,0:05:23.13,Caption,,0,0,0,,ГОВОРИТ О СОГЛАШЕНИИ. ЕВРОПЕЙСКИЕ КАБИНЕТЫ ГОВОРЯТ О
Dialogue: 0,0:05:23.13,0:05:29.98,Caption,,0,0,0,,ФИНАНСИРОВАНИИ ПРОДОЛЖЕНИЯ. ОФИЦИАЛЬНО ЭТО РАЗЛИЧИЕ ПОДХОДОВ СОЮЗНИКОВ. ПЕРЕВОД
Dialogue: 0,0:05:29.98,0:05:33.90,Caption,,0,0,0,,ВАШИНГТОН ИЩЕТ ВЫХОД, А БРЮССЕЛЬ ПОКА ИЩЕТ НОВЫЙ КОШЕЛЁК.
Dialogue: 0,0:05:36.18,0:05:39.22,Caption,,0,0,0,,ЦЕНА ВОПРОСА НЕ ЗАКАНЧИВАЕТСЯ БЮДЖЕТОМ. ПРОДОЛЖЕНИЕ
Dialogue: 0,0:05:39.30,0:05:42.42,Caption,,0,0,0,,ДАВЛЕНИЯ БЕЗ ОБОЗНАЧЕННОГО ПРЕДЕЛА ПОВЫШАЕТ РИСК
Dialogue: 0,0:05:42.42,0:05:45.38,Caption,,0,0,0,,ПРЯМОГО СТОЛКНОВЕНИЯ РОССИИ И НАТО. ЭТО УЖЕ НЕ
Dialogue: 0,0:05:45.46,0:05:48.02,Caption,,0,0,0,,СПОР О РАЗМЕРЕ ПОСОБИЯ ИЛИ ТАРИФЕ НА ГАЗ.
Dialogue: 0,0:05:48.42,0:05:51.22,Caption,,0,0,0,,БОЛЬШАЯ ВОЙНА НА ТЕРРИТОРИИ ЕВРОПЫ ОЗНАЧАЕТ
Dialogue: 0,0:05:51.22,0:05:53.54,Caption,,0,0,0,,РАЗРУШЕННЫЕ ДОРОГИ, ЭНЕРГЕТИКУ,
Dialogue: 0,0:05:53.62,0:05:59.22,Caption,,0,0,0,,ЭВАКУАЦИЮ, ПОГИБШИХ И ГОРОДА, ГДЕ ГЛАВНЫМ ПОКАЗАТЕЛЕМ КАЧЕСТВА ЖИЗНИ СТАНОВИТСЯ
Dialogue: 0,0:05:59.22,0:06:06.31,Caption,,0,0,0,,ПРОЧНОСТЬ БЛИЖАЙШЕГО ПОДВАЛА. УКРАИНА ПОКАЗЫВАЕТ ЭТУ ЦЕНУ КАЖДЫЙ ДЕНЬ. ЕСЛИ
Dialogue: 0,0:06:06.31,0:06:09.11,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ВЛАСТИ ГОТОВЫ ПРИБЛИЗИТЬ ТАКОЙ СЦЕНАРИЙ
Dialogue: 0,0:06:09.19,0:06:11.59,Caption,,0,0,0,,К СВОИМ СТРАНАМ, ОНИ ОБЯЗАНЫ ОБЪЯСНИТЬ,
Dialogue: 0,0:06:11.69,0:06:14.47,Caption,,0,0,0,,РАДИ КАКОГО ДОСТИЖИМОГО РЕЗУЛЬТАТА. СЛОВ О
Dialogue: 0,0:06:14.47,0:06:17.35,Caption,,0,0,0,,НЕОБХОДИМОСТИ ПРОДОЛЖАТЬ НЕДОСТАТОЧНО. ЧЕЛОВЕКУ
Dialogue: 0,0:06:17.35,0:06:19.19,Caption,,0,0,0,,ПРЕДЛАГАЮТ ПОСТАВИТЬ ДОМ И ЖИЗНЬ,
Dialogue: 0,0:06:19.43,0:06:22.23,Caption,,0,0,0,,А В ГРАФЕ "ВЫИГРЫШ" НАПИСАНО ОБСУДИМ ПОЗДНЕЕ.
Dialogue: 0,0:06:24.43,0:06:27.23,Caption,,0,0,0,,ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ ДВИНУТСЯ К ДОГОВОРЁННОСТИ,
Dialogue: 0,0:06:27.47,0:06:30.35,Caption,,0,0,0,,ЕВРОПЕЙЦАМ ПРИДЁТСЯ САМОСТОЯТЕЛЬНО ОБЕСПЕЧИВАТЬ КИЕВ
Dialogue: 0,0:06:30.43,0:06:35.31,Caption,,0,0,0,,ДЕНЬГАМИ, ОРУЖИЕМ, РАЗВЕДЫВАТЕЛЬНОЙ ИНФОРМАЦИЕЙ И ЛОГИСТИКОЙ. ПРИДЁТСЯ
Dialogue: 0,0:06:35.31,0:06:39.71,Caption,,0,0,0,,НАРАЩИВАТЬ ПРОИЗВОДСТВО, ИСКАТЬ БОЕПРИПАСЫ И ОБЪЯСНЯТЬ ГРАЖДАНАМ ЦЕЛЬ
Dialogue: 0,0:06:39.71,0:06:42.99,Caption,,0,0,0,,РАСХОДОВ. ЗАЯВЛЕНИЕ ПОСЛЕ САММИТА НЕ ЗАПУСКАЕТ
Dialogue: 0,0:06:42.99,0:06:45.47,Caption,,0,0,0,,СТАНКИ. ДАЖЕ ОЧЕНЬ УВЕРЕННОЕ ЗАЯВЛЕНИЕ.
Dialogue: 0,0:06:47.74,0:06:50.80,Caption,,0,0,0,,ГЕРМАНИЯ УЖЕ ЧУВСТВУЕТ ПЕРЕМЕНУ ВОЗДУХА. ФРИДРИХ
Dialogue: 0,0:06:50.80,0:06:53.92,Caption,,0,0,0,,МЕРЦ ЗАЯВИЛ, ЧТО ГОТОВ ВСТРЕТИТЬСЯ С ВЛАДИМИРОМ ПУТИНЫМ,
Dialogue: 0,0:06:54.08,0:06:56.64,Caption,,0,0,0,,ЕСЛИ ТОТ ПРИБУДЕТ НА САММИТ ДВАДЦАТКИ В МАЙАМИ.
Dialogue: 0,0:06:57.06,0:06:59.84,Caption,,0,0,0,,ЕЩЁ НЕДАВНО КАНЦЛЕР ГОВОРИЛ ОБ УВЕЛИЧЕНИИ ПОМОЩИ
Dialogue: 0,0:06:59.84,0:07:02.56,Caption,,0,0,0,,КИЕВУ. ТЕПЕРЬ ОН ДОПУСКАЕТ ЛИЧНЫЙ РАЗГОВОР С
Dialogue: 0,0:07:02.56,0:07:04.80,Caption,,0,0,0,,РОССИЙСКИМ ПРЕЗИДЕНТОМ И НАПОМИНАЕТ,
Dialogue: 0,0:07:04.96,0:07:07.36,Caption,,0,0,0,,ЧТО РАЗГОВАРИВАТЬ ПРИХОДИТСЯ ИМЕННО С ТЕМИ,
Dialogue: 0,0:07:07.44,0:07:13.79,Caption,,0,0,0,,С КЕМ НЕ СОГЛАСЕН. КАЗЁННАЯ ВЕРСИЯ СОХРАНЯЕТСЯ ПОДДЕРЖКА УКРАИНЫ ПРИ
Dialogue: 0,0:07:13.79,0:07:16.91,Caption,,0,0,0,,ГОТОВНОСТИ ИСПОЛЬЗОВАТЬ КАНАЛЫ ОБЩЕНИЯ. ПЕРЕВОД
Dialogue: 0,0:07:16.91,0:07:20.51,Caption,,0,0,0,,ВЫЯСНИЛОСЬ, ЧТО ТЕЛЕФОН ГОДИТСЯ НЕ ТОЛЬКО ДЛЯ ЗВОНКОВ СОЮЗНИКАМ.
Dialogue: 0,0:07:22.79,0:07:26.31,Caption,,0,0,0,,ЭТО НЕ ОЗНАЧАЕТ, ЧТО МЕРЦ СМЕНИЛ КУРС. ГЕРМАНИЯ ПРОДОЛЖАЕТ
Dialogue: 0,0:07:26.31,0:07:28.87,Caption,,0,0,0,,ПОДДЕРЖИВАТЬ КИЕВ, САНКЦИИ ОСТАЮТСЯ,
Dialogue: 0,0:07:29.03,0:07:32.07,Caption,,0,0,0,,ВООРУЖЕНИЕ ПОСТАВЛЯЕТСЯ. НО РАЗГОВОР С МОСКВОЙ
Dialogue: 0,0:07:32.07,0:07:34.15,Caption,,0,0,0,,БОЛЬШЕ НЕ ВЫГЛЯДИТ ЧЕМ ТО НЕПРИЛИЧНЫМ,
Dialogue: 0,0:07:34.39,0:07:36.71,Caption,,0,0,0,,ПОСЛЕ ЧЕГО ТРЕБУЕТСЯ ДОЛГО МЫТЬ РУКИ ПЕРЕД
Dialogue: 0,0:07:36.71,0:07:39.11,Caption,,0,0,0,,ТЕЛЕКАМЕРАМИ. ДВЕРЬ ОТКРЫЛИ НА НЕСКОЛЬКО
Dialogue: 0,0:07:39.11,0:07:41.91,Caption,,0,0,0,,САНТИМЕТРОВ, ЗАТО РАНЬШЕ ВОЗЛЕ НЕЁ ДЕЛАЛИ ВИД,
Dialogue: 0,0:07:42.07,0:07:47.86,Caption,,0,0,0,,ЧТО СТЕНЫ ВООБЩЕ НЕТ. СОВСЕМ ДРУГУЮ ПРОГРАММУ ПРЕДЛАГАЕТ АДГ.
Dialogue: 0,0:07:48.42,0:07:51.06,Caption,,0,0,0,,ПАРТИЯ ХОЧЕТ ВЕСНОЙ СЛЕДУЮЩЕГО ГОДА ПРОВЕСТИ В АБУ
Dialogue: 0,0:07:51.14,0:07:56.26,Caption,,0,0,0,,ДАБИ ВСТРЕЧУ ГЕРМАНИИ, РОССИИ И СОЕДИНЁННЫХ ШТАТОВ БЕЗ УКРАИНЫ. МАРКУС
Dialogue: 0,0:07:56.26,0:07:58.90,Caption,,0,0,0,,ФРОНМАЙЕР ВЫСТУПАЕТ ЗА ВОССТАНОВЛЕНИЕ ОТНОШЕНИЙ С
Dialogue: 0,0:07:58.90,0:08:03.86,Caption,,0,0,0,,МОСКВОЙ, ОТМЕНУ САНКЦИЙ, СОТРУДНИЧЕСТВО В ЭНЕРГЕТИКЕ И ВОЗВРАЩЕНИЕ К ТЕМЕ
Dialogue: 0,0:08:03.86,0:08:08.53,Caption,,0,0,0,,СЕВЕРНОГО ПОТОКА. ЭТО УЖЕ НЕ СПОР О ТОМ,
Dialogue: 0,0:08:08.68,0:08:11.57,Caption,,0,0,0,,СКОЛЬКО ДОБАВИТЬ К ОЧЕРЕДНОМУ ТРАНШУ. ЭТО СПОР О
Dialogue: 0,0:08:11.57,0:08:17.28,Caption,,0,0,0,,НАПРАВЛЕНИИ. ДЕЙСТВУЮЩИЙ ЦЕНТР ПРЕДЛАГАЕТ ФИНАНСИРОВАТЬ КИЕВ,
Dialogue: 0,0:08:17.52,0:08:21.20,Caption,,0,0,0,,ВООРУЖАТЬ ЕГО И УСИЛИВАТЬ ДАВЛЕНИЕ НА РОССИЮ. ЧАСТЬ
Dialogue: 0,0:08:21.28,0:08:23.36,Caption,,0,0,0,,ПРАВЫХ СИЛ ПРЕДЛАГАЕТ ВОССТАНАВЛИВАТЬ СВЯЗИ С
Dialogue: 0,0:08:23.36,0:08:26.64,Caption,,0,0,0,,МОСКВОЙ И ДОГОВАРИВАТЬСЯ. ОДИН КУРС ТРЕБУЕТ НОВЫХ
Dialogue: 0,0:08:26.64,0:08:29.84,Caption,,0,0,0,,РЕСУРСОВ РАДИ ПРЕЖНЕЙ ЛИНИИ. ДРУГОЙ ОБЕЩАЕТ САМУ
Dialogue: 0,0:08:29.84,0:08:35.25,Caption,,0,0,0,,ЛИНИЮ ПОМЕНЯТЬ. ПОДДЕРЖКА АДГ РАСТЁТ НЕ ПОТОМУ,
Dialogue: 0,0:08:35.33,0:08:37.33,Caption,,0,0,0,,ЧТО МИЛЛИОНЫ НЕМЦЕВ ВНЕЗАПНО РЕШИЛИ
Dialogue: 0,0:08:37.33,0:08:40.05,Caption,,0,0,0,,КОЛЛЕКЦИОНИРОВАТЬ ПОРТРЕТЫ РОССИЙСКИХ РУКОВОДИТЕЛЕЙ.
Dialogue: 0,0:08:40.36,0:08:43.57,Caption,,0,0,0,,ЛЮДИ ВИДЯТ ЦЕНУ ДЕЙСТВУЮЩЕЙ ПОЛИТИКИ И ИЩУТ ВАРИАНТ,
Dialogue: 0,0:08:43.89,0:08:46.45,Caption,,0,0,0,,КОТОРЫЙ НЕ ТРЕБУЕТ ЕЖЕГОДНО ПЛАТИТЬ БОЛЬШЕ ЗА ВСЁ
Dialogue: 0,0:08:46.45,0:08:51.53,Caption,,0,0,0,,МЕНЕЕ ПОНЯТНЫЙ ИТОГ. LE MONDE ПРИВОДИТ ОПРОСЫ,
Dialogue: 0,0:08:51.77,0:08:54.57,Caption,,0,0,0,,В КОТОРЫХ АДГ ПОЛУЧАЕТ ПРИМЕРНО ОТ ДВАДЦАТИ СЕМИ
Dialogue: 0,0:08:54.57,0:08:57.53,Caption,,0,0,0,,ДО ТРИДЦАТИ ПРОЦЕНТОВ И ВЫХОДИТ НА ПЕРВОЕ МЕСТО.
Dialogue: 0,0:08:58.01,0:09:01.21,Caption,,0,0,0,,БЛОК ХДС И ХСС МЕРЦА НАБИРАЕТ ПРИМЕРНО ОТ
Dialogue: 0,0:09:01.21,0:09:04.33,Caption,,0,0,0,,ВОСЕМНАДЦАТИ ДО ДВАДЦАТИ ТРЁХ ПРОЦЕНТОВ. ЭТО УЖЕ НЕ
Dialogue: 0,0:09:04.33,0:09:08.65,Caption,,0,0,0,,ПРОТЕСТНАЯ ГРУППА, КОТОРУЮ МОЖНО НЕ ЗАМЕЧАТЬ ДО ОКОНЧАНИЯ ТЕЛЕПЕРЕДАЧИ.
Dialogue: 0,0:09:10.94,0:09:14.30,Caption,,0,0,0,,ПРАВДА, ПЕРВОЕ МЕСТО В ОПРОСАХ ЕЩЁ НЕ ОЗНАЧАЕТ УЧАСТИЕ
Dialogue: 0,0:09:14.38,0:09:17.74,Caption,,0,0,0,,ВО ВЛАСТИ. ОСТАЛЬНЫЕ КРУПНЫЕ ПАРТИИ СОХРАНЯЮТ ЗАПРЕТ
Dialogue: 0,0:09:17.82,0:09:22.38,Caption,,0,0,0,,НА СОТРУДНИЧЕСТВО С АДГ. ОФИЦИАЛЬНОЕ ОБЪЯСНЕНИЕ ЗАЩИЩАЮТСЯ ДЕМОКРАТИЧЕСКИЕ
Dialogue: 0,0:09:22.38,0:09:25.58,Caption,,0,0,0,,ПРИНЦИПЫ. ПЕРЕВОД ГОЛОСА ГРАЖДАН ОЧЕНЬ УВАЖАЮТ,
Dialogue: 0,0:09:25.78,0:09:27.90,Caption,,0,0,0,,ПОКА ОНИ ПРИВОДЯТ К УДОБНОМУ РЕЗУЛЬТАТУ.
Dialogue: 0,0:09:30.16,0:09:33.52,Caption,,0,0,0,,ПОЛУЧАЮТСЯ ДВЕ ГЕРМАНИИ. ОДНА УПРАВЛЯЕТ И ПРОДОЛЖАЕТ
Dialogue: 0,0:09:33.52,0:09:36.56,Caption,,0,0,0,,ПРЕЖНИЙ КУРС. ДРУГАЯ РАСТЁТ В ОПРОСАХ И ТРЕБУЕТ
Dialogue: 0,0:09:36.56,0:09:39.28,Caption,,0,0,0,,ПОВОРОТА. МЕЖДУ НИМИ ИДЁТ СПОР НЕ ТОЛЬКО ОБ
Dialogue: 0,0:09:39.28,0:09:43.68,Caption,,0,0,0,,УКРАИНЕ, НО И О ТОМ, СКОЛЬКО ОБЩЕСТВО ГОТОВО ПЛАТИТЬ ЗА ПОЛИТИКУ БЕЗ
Dialogue: 0,0:09:43.68,0:09:50.13,Caption,,0,0,0,,НАЗВАННОГО ФИНИША. ДЛЯ ОБЫЧНОГО ЕВРОПЕЙЦА ПЕРЕВОД ВЫГЛЯДИТ ТАК. НА
Dialogue: 0,0:09:50.13,0:09:53.49,Caption,,0,0,0,,ПОМОЩЬ УКРАИНЕ СОВМЕСТНЫЙ ЗАЁМ ОФОРМИТЬ МОЖНО. НА
Dialogue: 0,0:09:53.49,0:09:56.45,Caption,,0,0,0,,СОЦИАЛЬНЫЕ ПРОГРАММЫ ТРЕБУЕТСЯ ДИСЦИПЛИНА. ДЛЯ
Dialogue: 0,0:09:56.53,0:09:59.33,Caption,,0,0,0,,ОБОРОНЫ ДЕНЬГИ НАДО НАЙТИ. ДЛЯ ПРОМЫШЛЕННОСТИ
Dialogue: 0,0:09:59.33,0:10:02.37,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО ПОТЕРПЕТЬ. ЕСЛИ ДОРОЖАЕТ ЭНЕРГИЯ,
Dialogue: 0,0:10:02.61,0:10:05.73,Caption,,0,0,0,,ПРЕДПРИЯТИЕ ДОЛЖНО СТАТЬ ЭФФЕКТИВНЕЕ. ЕСЛИ ДОРОЖАЕТ
Dialogue: 0,0:10:05.73,0:10:09.41,Caption,,0,0,0,,ВНЕШНЯЯ ПОЛИТИКА, НАЛОГОПЛАТЕЛЬЩИК ДОЛЖЕН СТАТЬ ПОНЯТЛИВЕЕ.
Dialogue: 0,0:10:11.62,0:10:14.50,Caption,,0,0,0,,В ОКТЯБРЕ РОСТ ЕВРОЗОНЫ ЗАМЕДЛИЛСЯ. ГЕРМАНСКАЯ
Dialogue: 0,0:10:14.50,0:10:17.54,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬ ОСТАЁТСЯ СЛАБОЙ. АВТОМОБИЛЬНЫЙ СЕКТОР
Dialogue: 0,0:10:17.54,0:10:21.54,Caption,,0,0,0,,ПЕРЕСТРАИВАЕТСЯ, ТЕРЯЕТ ПРИВЫЧНЫЕ ПРЕИМУЩЕСТВА И ОТБИВАЕТСЯ ОТ
Dialogue: 0,0:10:21.54,0:10:24.82,Caption,,0,0,0,,КИТАЙСКОЙ КОНКУРЕНЦИИ. ДОРОГАЯ ЭНЕРГИЯ УВЕЛИЧИВАЕТ
Dialogue: 0,0:10:24.82,0:10:28.34,Caption,,0,0,0,,СЕБЕСТОИМОСТЬ, ПРАВИТЕЛЬСТВА ОБСУЖДАЮТ ОГРАНИЧЕНИЕ СОЦИАЛЬНЫХ
Dialogue: 0,0:10:28.34,0:10:33.58,Caption,,0,0,0,,РАСХОДОВ. НА ОФИЦИАЛЬНОМ ЯЗЫКЕ ЭТО РАССТАНОВКА БЮДЖЕТНЫХ
Dialogue: 0,0:10:33.58,0:10:36.78,Caption,,0,0,0,,ПРИОРИТЕТОВ. НА ЧЕЛОВЕЧЕСКОМ ЯЗЫКЕ ОЧЕРЕДЬ ПРОСТАЯ
Dialogue: 0,0:10:36.83,0:10:39.66,Caption,,0,0,0,,СНАЧАЛА ПРЕЖНИЙ КУРС, ЗАТЕМ ВООРУЖЕНИЕ,
Dialogue: 0,0:10:39.89,0:10:43.74,Caption,,0,0,0,,ПОТОМ СПАСЕНИЕ ПРОИЗВОДСТВА, А ГРАЖДАНИНУ ДОСТАЁТСЯ ОБЪЯСНЕНИЕ,
Dialogue: 0,0:10:43.98,0:10:45.74,Caption,,0,0,0,,ПОЧЕМУ ДЛЯ НЕГО ДЕНЕГ НЕ НАШЛОСЬ.
Dialogue: 0,0:10:48.04,0:10:50.60,Caption,,0,0,0,,И ГРАЖДАНИН ВПРАВЕ СПРОСИТЬ ЧТО Я ПОЛУЧУ НА
Dialogue: 0,0:10:50.60,0:10:55.84,Caption,,0,0,0,,ВЫХОДЕ? КОГДА ГОСУДАРСТВО ЗАНИМАЕТ НА ЭЛЕКТРОСТАНЦИЮ,
Dialogue: 0,0:10:56.01,0:10:58.56,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЭЛЕКТРИЧЕСТВО. КОГДА КРЕДИТУЕТ
Dialogue: 0,0:10:58.56,0:11:02.32,Caption,,0,0,0,,ПРЕДПРИЯТИЕ, МОЖНО ПОСЧИТАТЬ ПРОДУКЦИЮ. ЗДЕСЬ ЕСТЬ ДОЛГ,
Dialogue: 0,0:11:02.48,0:11:07.36,Caption,,0,0,0,,ПРОЦЕНТЫ И ДАТА ПЛАТЕЖА, НО НЕТ КРИТЕРИЯ ВЫПОЛНЕНИЯ. ФИНАНСОВАЯ ЧАСТЬ
Dialogue: 0,0:11:07.36,0:11:10.72,Caption,,0,0,0,,ДОГОВОРА НАПИСАНА КРУПНО. РЕЗУЛЬТАТ ОСТАВИЛИ ПУСТЫМ,
Dialogue: 0,0:11:10.83,0:11:13.12,Caption,,0,0,0,,ВЕРОЯТНО, ЧТОБЫ НЕ ПОРТИЛ КОМПОЗИЦИЮ.
Dialogue: 0,0:11:15.41,0:11:18.13,Caption,,0,0,0,,С ДЕНЬГАМИ ВСЁ ОСОБЕННО НАГЛЯДНО. ДОХОДЫ ОТ
Dialogue: 0,0:11:18.13,0:11:20.69,Caption,,0,0,0,,ЗАМОРОЖЕННЫХ РОССИЙСКИХ АКТИВОВ БОЛЕЕ ЧЕМ ЗА ДВА
Dialogue: 0,0:11:20.69,0:11:23.81,Caption,,0,0,0,,ГОДА СОСТАВИЛИ ОКОЛО ВОСЬМИ МИЛЛИАРДОВ ЕВРО. НОВЫЙ
Dialogue: 0,0:11:23.81,0:11:26.21,Caption,,0,0,0,,КРЕДИТНЫЙ ЗАПРОС ПРЕВЫШАЕТ СОРОК МИЛЛИАРДОВ.
Dialogue: 0,0:11:26.62,0:11:29.57,Caption,,0,0,0,,РОССИЙСКИМИ ДОХОДАМИ ЭТУ ДЫРУ НЕ ЗАКРЫТЬ. ПРИДЁТСЯ
Dialogue: 0,0:11:29.65,0:11:33.25,Caption,,0,0,0,,ЗАНИМАТЬ НА РЫНКАХ, БРАТЬ СРЕДСТВА ИЗ БЮДЖЕТОВ ИЛИ ОТПРАВЛЯТЬ
Dialogue: 0,0:11:33.25,0:11:39.93,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА В БУДУЩЕЕ. БУДУЩЕЕ ДЛЯ ЧИНОВНИКА ВООБЩЕ УДОБНЫЙ ПЛАТЕЛЬЩИК. ОНО
Dialogue: 0,0:11:40.01,0:11:41.77,Caption,,0,0,0,,НЕ ПРИХОДИТ НА ВСТРЕЧУ С ПРЕССОЙ,
Dialogue: 0,0:11:41.93,0:11:43.77,Caption,,0,0,0,,НЕ ПЕРЕБИВАЕТ И НЕ СПРАШИВАЕТ,
Dialogue: 0,0:11:43.93,0:11:46.09,Caption,,0,0,0,,ПОЧЕМУ ПОДПИСЬ ПОСТАВИЛ ОДИН КАБИНЕТ,
Dialogue: 0,0:11:46.32,0:11:47.93,Caption,,0,0,0,,А РАСПЛАЧИВАТЬСЯ БУДЕТ ДРУГОЙ.
Dialogue: 0,0:11:50.21,0:11:52.45,Caption,,0,0,0,,ДАЖЕ С РАНЕЕ ОБЕЩАННОЙ ПОМОЩЬЮ ПОРЯДОК НЕ
Dialogue: 0,0:11:52.45,0:11:54.69,Caption,,0,0,0,,ОБРАЗЦОВЫЙ. POLITICO СООБЩАЕТ,
Dialogue: 0,0:11:54.99,0:11:57.65,Caption,,0,0,0,,ЧТО СТРАНАМ НАТО НЕДОСТАЁТ ОКОЛО СЕМИ МИЛЛИАРДОВ
Dialogue: 0,0:11:57.65,0:12:00.53,Caption,,0,0,0,,ЕВРО НА ВОЕННУЮ ПОДДЕРЖКУ КИЕВА В ТЕКУЩЕМ ГОДУ.
Dialogue: 0,0:12:00.78,0:12:03.57,Caption,,0,0,0,,ОФИЦИАЛЬНАЯ ФОРМУЛИРОВКА ПАРТНЁРАМ НЕОБХОДИМО
Dialogue: 0,0:12:03.65,0:12:06.61,Caption,,0,0,0,,ВОСПОЛНИТЬ ДЕФИЦИТ ФИНАНСИРОВАНИЯ. ПЕРЕВОД ОБЕЩАЛИ
Dialogue: 0,0:12:06.61,0:12:13.28,Caption,,0,0,0,,БОЛЬШЕ, ЧЕМ СОБРАЛИ. И ПОСЛЕ ЭТОГО ПРЕДЛАГАЕТСЯ НОВЫЙ КРЕДИТ СВЫШЕ СОРОКА
Dialogue: 0,0:12:13.28,0:12:15.20,Caption,,0,0,0,,МИЛЛИАРДОВ. ОТКУДА УВЕРЕННОСТЬ,
Dialogue: 0,0:12:15.36,0:12:18.08,Caption,,0,0,0,,ЧТО КРУПНАЯ СУММА ОКАЖЕТСЯ РЕАЛЬНЕЕ НЕБОЛЬШОЙ?
Dialogue: 0,0:12:18.39,0:12:20.48,Caption,,0,0,0,,СЕМЬ МИЛЛИАРДОВ НЕ НАШЛИСЬ В СОГЛАСОВАННОЙ
Dialogue: 0,0:12:20.48,0:12:24.08,Caption,,0,0,0,,ПРОГРАММЕ, НО СОРОК МИЛЛИАРДОВ В СЛЕДУЮЩЕЙ ПРЕЗЕНТАЦИИ ВЫГЛЯДЯТ
Dialogue: 0,0:12:24.08,0:12:27.36,Caption,,0,0,0,,БОДРО. У ПРЕЗЕНТАЦИЙ ВООБЩЕ ЗАМЕЧАТЕЛЬНАЯ ЭКОНОМИКА.
Dialogue: 0,0:12:27.60,0:12:30.48,Caption,,0,0,0,,ТАМ ДЕНЬГИ ПОЯВЛЯЮТСЯ СРАЗУ ПОСЛЕ НАЖАТИЯ КЛАВИШИ.
Dialogue: 0,0:12:32.76,0:12:35.48,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА ВЫШЕ ДВУХСОТ МИЛЛИАРДОВ УЖЕ НЕЛЬЗЯ
Dialogue: 0,0:12:35.56,0:12:38.60,Caption,,0,0,0,,НАЗЫВАТЬ ВРЕМЕННОЙ ПОДДЕРЖКОЙ. ЭТО МНОГОЛЕТНИЙ СЧЁТ.
Dialogue: 0,0:12:39.00,0:12:40.68,Caption,,0,0,0,,ПО НЕМУ БУДУТ ПЛАТИТЬ ПРОЦЕНТЫ,
Dialogue: 0,0:12:40.84,0:12:43.80,Caption,,0,0,0,,ПОГАШАТЬ ТЕЛО ДОЛГА И ОБЪЯСНЯТЬ ИЗБИРАТЕЛЯМ,
Dialogue: 0,0:12:43.96,0:12:47.32,Caption,,0,0,0,,ПОЧЕМУ БЮДЖЕТ СНОВА ТРЕБУЕТ ЭКОНОМИИ. ПРИЧЁМ УСЛОВИЕ
Dialogue: 0,0:12:47.40,0:12:49.80,Caption,,0,0,0,,ПРЕКРАЩЕНИЯ РАСХОДОВ ПО ПРЕЖНЕМУ НЕ НАЗВАНО.
Dialogue: 0,0:12:52.09,0:12:53.85,Caption,,0,0,0,,ЕСЛИ ВАМ ПОЛЕЗЕН ТАКОЙ РАЗБОР,
Dialogue: 0,0:12:54.00,0:12:56.49,Caption,,0,0,0,,ПОДПИШИТЕСЬ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:12:56.57,0:12:59.77,Caption,,0,0,0,,ГДЕ ЕВРОПЕЙСКИЕ ВЛАСТИ ВИДЯТ КОНЕЦ ЭТОГО МАРШРУТА.
Dialogue: 0,0:13:00.17,0:13:02.01,Caption,,0,0,0,,НЕ КРАСИВУЮ ФОРМУЛУ ДЛЯ САММИТА,
Dialogue: 0,0:13:02.25,0:13:05.61,Caption,,0,0,0,,А СОБЫТИЕ, ПОСЛЕ КОТОРОГО ОНИ СКАЖУТ ЗАДАЧА ВЫПОЛНЕНА.
Dialogue: 0,0:13:07.89,0:13:10.62,Caption,,0,0,0,,ВОПРОС ПРЕДЕЛЬНО КОНКРЕТНЫЙ. ПОБЕДА ОЗНАЧАЕТ
Dialogue: 0,0:13:10.62,0:13:12.94,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ РОССИЙСКИХ ВОЙСК НА ОПРЕДЕЛЁННЫЕ
Dialogue: 0,0:13:12.94,0:13:16.14,Caption,,0,0,0,,ПОЗИЦИИ? НАЗОВИТЕ ПОЗИЦИИ. НУЖЕН ДОГОВОР?
Dialogue: 0,0:13:16.26,0:13:19.50,Caption,,0,0,0,,ПЕРЕЧИСЛИТЕ УСЛОВИЯ. РАСЧЁТ ДЕЛАЕТСЯ НА СМЕНУ ВЛАСТИ
Dialogue: 0,0:13:19.50,0:13:23.58,Caption,,0,0,0,,В МОСКВЕ? ПОКАЖИТЕ МЕХАНИЗМ. ЕВРОПА НАМЕРЕНА ИДТИ ДО МОСКВЫ
Dialogue: 0,0:13:23.66,0:13:27.18,Caption,,0,0,0,,ИЛИ ДО УРАЛА? ТОГДА СКАЖИТЕ ЭТО ГРАЖДАНАМ И ПРЕДЪЯВИТЕ ЦЕНУ.
Dialogue: 0,0:13:29.37,0:13:32.81,Caption,,0,0,0,,ФРАЗА "СТОЛЬКО, СКОЛЬКО ПОТРЕБУЕТСЯ" СООБЩАЕТ ЛИШЬ ТО,
Dialogue: 0,0:13:33.05,0:13:36.01,Caption,,0,0,0,,ЧТО РАСХОДЫ НЕ ОГРАНИЧЕНЫ СРОКОМ. О РЕЗУЛЬТАТЕ ОНА
Dialogue: 0,0:13:36.09,0:13:42.44,Caption,,0,0,0,,НЕ СООБЩАЕТ НИЧЕГО. ЕВРОПА ТЕХНИЧЕСКИ МОЖЕТ ЗАНЯТЬ ЕЩЁ СОРОК МИЛЛИАРДОВ
Dialogue: 0,0:13:42.44,0:13:45.80,Caption,,0,0,0,,ЕВРО, УВЕЛИЧИТЬ ОБЯЗАТЕЛЬСТВА СВЕРХ ДВУХСОТ МИЛЛИАРДОВ,
Dialogue: 0,0:13:46.04,0:13:49.00,Caption,,0,0,0,,ПОПЫТАТЬСЯ СОБРАТЬ НЕДОСТАЮЩИЕ СЕМЬ МИЛЛИАРДОВ И
Dialogue: 0,0:13:49.00,0:13:52.52,Caption,,0,0,0,,ПРИНЯТЬ ОЧЕРЕДНЫЕ САНКЦИИ. БУМАГА ВЫДЕРЖИТ. ВОПРОС В
Dialogue: 0,0:13:52.52,0:13:54.52,Caption,,0,0,0,,ТОМ, ВЫДЕРЖАТ ЛИ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:13:54.68,0:13:58.84,Caption,,0,0,0,,СОЦИАЛЬНЫЕ БЮДЖЕТЫ И ЛЮДИ, КОТОРЫМ СНОВА ПРЕДЛОЖАТ ОПЛАТИТЬ УВЕРЕННОСТЬ
Dialogue: 0,0:13:58.84,0:14:05.12,Caption,,0,0,0,,РУКОВОДИТЕЛЕЙ. ДВА КУРСА УЖЕ СТОЯТ РЯДОМ. ПЕРВЫЙ ТРЕБУЕТ ПРОДОЛЖАТЬ
Dialogue: 0,0:14:05.20,0:14:09.44,Caption,,0,0,0,,ФИНАНСИРОВАНИЕ И ЖДАТЬ, ЧТО ПРЕЖНИЙ РАСЧЁТ СРАБОТАЕТ. ВТОРОЙ ПРЕДЛАГАЕТ
Dialogue: 0,0:14:09.44,0:14:11.68,Caption,,0,0,0,,ВОССТАНОВИТЬ ОТНОШЕНИЯ С МОСКВОЙ И ИСКАТЬ
Dialogue: 0,0:14:11.76,0:14:15.52,Caption,,0,0,0,,СОГЛАШЕНИЕ. ТРАМП ДВИЖЕТСЯ К СДЕЛКЕ. МЕРЦ ОСТОРОЖНО
Dialogue: 0,0:14:15.52,0:14:19.04,Caption,,0,0,0,,ДОПУСКАЕТ РАЗГОВОР. АДГ ТРЕБУЕТ РАЗВОРОТА. ТОЛЬКО
Dialogue: 0,0:14:19.04,0:14:21.76,Caption,,0,0,0,,ДЕЙСТВУЮЩИЙ ЕВРОПЕЙСКИЙ ЦЕНТР НА ЛЮБОЕ ИЗМЕНЕНИЕ
Dialogue: 0,0:14:21.76,0:14:24.32,Caption,,0,0,0,,ОТВЕЧАЕТ ПРИВЫЧНОЙ КОМАНДОЙ ВЫСТАВИТЬ СЛЕДУЮЩИЙ
Dialogue: 0,0:14:24.40,0:14:28.59,Caption,,0,0,0,,СЧЁТ. И ЧТО ДАЛЬШЕ У ВАС ПО ПЛАНУ?
Dialogue: 0,0:14:30.86,0:14:32.70,Caption,,0,0,0,,ПОКА КОНЕЧНАЯ ЦЕЛЬ НЕ НАЗВАНА,
Dialogue: 0,0:14:32.86,0:14:36.22,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ КУРСА СТАНОВИТСЯ ЗАМЕНОЙ ПОБЕДЫ. КАЖДЫЙ
Dialogue: 0,0:14:36.22,0:14:38.70,Caption,,0,0,0,,НОВЫЙ КРЕДИТ ОПРАВДЫВАЮТ ПРЕДЫДУЩИМ РАЗ УЖЕ
Dialogue: 0,0:14:38.70,0:14:43.10,Caption,,0,0,0,,ПОТРАТИЛИ СТОЛЬКО, НЕЛЬЗЯ ОСТАНАВЛИВАТЬСЯ. ПО ТАКОЙ ЛОГИКЕ НЕВЕРНАЯ
Dialogue: 0,0:14:43.10,0:14:45.42,Caption,,0,0,0,,ДОРОГА СТАНОВИТСЯ ПРАВИЛЬНОЙ ПОСЛЕ ТОГО,
Dialogue: 0,0:14:45.58,0:14:52.18,Caption,,0,0,0,,КАК ЗАКОНЧИЛСЯ БЕНЗИН. ЕВРОПЕЙСКИМ ВЛАСТЯМ ПРИДЁТСЯ ВЫБРАТЬ. ЛИБО НАЗВАТЬ
Dialogue: 0,0:14:52.18,0:14:54.34,Caption,,0,0,0,,ДОСТИЖИМЫЙ РЕЗУЛЬТАТ, УСЛОВИЯ,
Dialogue: 0,0:14:54.42,0:14:56.98,Caption,,0,0,0,,СРОК И ПРЕДЕЛ РИСКА. ЛИБО ПРИЗНАТЬ,
Dialogue: 0,0:14:57.13,0:14:58.98,Caption,,0,0,0,,ЧТО ПРЕЖНИЙ ПОДХОД НЕ СРАБОТАЛ,
Dialogue: 0,0:14:59.14,0:15:01.78,Caption,,0,0,0,,А ПОРАЖЕНИЕ УКРАИНЫ НЕЛЬЗЯ ОТМЕНИТЬ ЕЩЁ ОДНИМ
Dialogue: 0,0:15:01.78,0:15:07.41,Caption,,0,0,0,,ЗАЙМОМ. ВСЁ ОСТАЛЬНОЕ ПЕРЕВОДИТСЯ КОРОТКО РЕШЕНИЯ ПРИНИМАЮТ
Dialogue: 0,0:15:07.41,0:15:09.81,Caption,,0,0,0,,НАВЕРХУ, ИТОГ ОСТАЁТСЯ НЕИЗВЕСТНЫМ,
Dialogue: 0,0:15:10.10,0:15:12.53,Caption,,0,0,0,,А СЧЁТ УЖЕ НЕСУТ ЕВРОПЕЙЦУ. И НА ЭТОТ
Dialogue: 0,0:15:12.53,0:15:14.85,Caption,,0,0,0,,РАЗ В НЁМ БОЛЕЕ ДВУХСОТ МИЛЛИАРДОВ ЕВРО,
Dialogue: 0,0:15:15.09,0:15:17.01,Caption,,0,0,0,,НО СТРОКИ "ЗА ЧТО" ПО ПРЕЖНЕМУ НЕТ.
