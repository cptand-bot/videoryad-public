Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ЕСТЬ ОЧЕНЬ УДОБНЫЙ СПОСОБ ОТКАЗАТЬСЯ ОТ ЧЕГО НИБУДЬ
Dialogue: 0,0:00:03.08,0:00:05.96,Caption,,0,0,0,,НАВСЕГДА. НУЖНО ПРОСТО ПОМЕНЯТЬ ПРОДАВЦА. ТОВАР
Dialogue: 0,0:00:06.04,0:00:09.00,Caption,,0,0,0,,МОЖНО ОСТАВИТЬ ТОТ ЖЕ, ДЕНЬГИ ТОЖЕ ПРОДОЛЖАТ ХОДИТЬ,
Dialogue: 0,0:00:09.20,0:00:11.72,Caption,,0,0,0,,ЗАТО НА БУМАГЕ ВСЁ БУДЕТ СОВЕРШЕННО ПО НОВОМУ.
Dialogue: 0,0:00:11.94,0:00:15.80,Caption,,0,0,0,,И СУДЯ ПО ТОМУ, ЧТО СЕЙЧАС ПРОИСХОДИТ ВОКРУГ ЕВРОПЕЙСКОЙ ЭНЕРГЕТИКИ,
Dialogue: 0,0:00:16.04,0:00:18.68,Caption,,0,0,0,,ЭТОТ СПОСОБ НЕОЖИДАННО ОКАЗАЛСЯ ОЧЕНЬ ПОПУЛЯРНЫМ.
Dialogue: 0,0:00:19.23,0:00:21.64,Caption,,0,0,0,,ТОЛЬКО ЕСТЬ ОДНА ПРОБЛЕМА. ДЕНЬГИ ПОЧЕМУ ТО ВСЁ
Dialogue: 0,0:00:21.64,0:00:23.96,Caption,,0,0,0,,ВРЕМЯ ВЫДАЮТ, ЧТО ПРОИСХОДИТ НА САМОМ ДЕЛЕ.
Dialogue: 0,0:00:24.75,0:00:27.16,Caption,,0,0,0,,ВАЛДИС ДОМБРОВСКИС ИЗ ЕВРОКОМИССИИ ЗАЯВИЛ,
Dialogue: 0,0:00:27.55,0:00:29.72,Caption,,0,0,0,,ЧТО ЕВРОПА В ЦЕЛОМ УЖЕ ЗАВЕРШИЛА РАЗРЫВ
Dialogue: 0,0:00:29.72,0:00:32.28,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИХ СВЯЗЕЙ С РОССИЕЙ. ОСНОВНЫМИ
Dialogue: 0,0:00:32.28,0:00:35.32,Caption,,0,0,0,,ПОСТАВЩИКАМИ СТАЛИ НОРВЕГИЯ И СОЕДИНЁННЫЕ ШТАТЫ. ТО
Dialogue: 0,0:00:35.32,0:00:38.36,Caption,,0,0,0,,ЕСТЬ ВСЁ. РАЗОШЛИСЬ. КАЖДЫЙ ПОШЁЛ СВОЕЙ ДОРОГОЙ.
Dialogue: 0,0:00:38.60,0:00:41.24,Caption,,0,0,0,,МОЖНО ДАЖЕ МУЗЫКУ ГРУСТНУЮ ВКЛЮЧИТЬ И ФОТОГРАФИЮ
Dialogue: 0,0:00:41.32,0:00:44.04,Caption,,0,0,0,,СОВМЕСТНУЮ ПОРВАТЬ. А БУКВАЛЬНО РЯДОМ АЛЕКСАНДР
Dialogue: 0,0:00:44.04,0:00:47.64,Caption,,0,0,0,,НОВАК РАССКАЗЫВАЕТ, ЧТО РОССИЙСКОЕ ДИЗЕЛЬНОЕ ТОПЛИВО ВСЁ РАВНО
Dialogue: 0,0:00:47.64,0:00:50.60,Caption,,0,0,0,,ПЕРИОДИЧЕСКИ ПОЯВЛЯЕТСЯ НА ЕВРОПЕЙСКОМ РЫНКЕ. ТОЛЬКО
Dialogue: 0,0:00:50.68,0:00:53.48,Caption,,0,0,0,,УЖЕ ПОД ДРУГИМИ ТОРГОВЫМИ МАРКАМИ. ВОТ ЭТО ХОРОШИЙ
Dialogue: 0,0:00:53.48,0:00:55.56,Caption,,0,0,0,,РАЗРЫВ ОТНОШЕНИЙ. ЕСЛИ ВАМ НРАВИТСЯ,
Dialogue: 0,0:00:55.88,0:00:58.36,Caption,,0,0,0,,КОГДА ЗА ГРОМКИМИ ЗАЯВЛЕНИЯМИ МЫ ИЩЕМ ТО,
Dialogue: 0,0:00:58.52,0:01:03.56,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ НА САМОМ ДЕЛЕ, ПОДПИШИТЕСЬ. МЫ РОССИЙСКОЕ НЕ ПОКУПАЕМ. МЫ ИНДИЙСКОЕ
Dialogue: 0,0:01:03.56,0:01:06.04,Caption,,0,0,0,,ПОКУПАЕМ. А ИНДИЯ ГДЕ ВЗЯЛА НЕФТЬ,
Dialogue: 0,0:01:06.20,0:01:07.64,Caption,,0,0,0,,ИЗ КОТОРОЙ ЭТОТ ДИЗЕЛЬ СДЕЛАЛИ,
Dialogue: 0,0:01:07.80,0:01:10.52,Caption,,0,0,0,,ЭТО УЖЕ ВОПРОС СЛИШКОМ ЛИЧНЫЙ. НЕ ЛЕЗЬТЕ ЛЮДЯМ
Dialogue: 0,0:01:10.60,0:01:14.49,Caption,,0,0,0,,В БИЗНЕС. ДОКУМЕНТЫ НОВЫЕ,
Dialogue: 0,0:01:14.60,0:01:17.13,Caption,,0,0,0,,ПРОДАВЕЦ ДРУГОЙ, ЗНАЧИТ И ТОПЛИВО,
Dialogue: 0,0:01:17.21,0:01:19.37,Caption,,0,0,0,,ВИДИМО, ПРОШЛО ОБРЯД ОЧИЩЕНИЯ.
Dialogue: 0,0:01:19.95,0:01:22.65,Caption,,0,0,0,,МОЛЕКУЛЫ ГАЗА И НЕФТИ НЕ ДАДУТ СОВРАТЬ. ЭТО
Dialogue: 0,0:01:22.73,0:01:24.89,Caption,,0,0,0,,ВООБЩЕ ОЧЕНЬ УДОБНАЯ ОСОБЕННОСТЬ МИРОВОГО РЫНКА.
Dialogue: 0,0:01:25.17,0:01:27.93,Caption,,0,0,0,,НЕФТЬ НЕ НОСИТ ПАСПОРТ В КАРМАНЕ. НА КАЖДОЙ
Dialogue: 0,0:01:28.01,0:01:31.85,Caption,,0,0,0,,МОЛЕКУЛЕ НЕ НАПИСАНО, ГДЕ ЕЁ ДОБЫЛИ. СЫРЬЁ МОЖНО КУПИТЬ,
Dialogue: 0,0:01:31.99,0:01:35.45,Caption,,0,0,0,,ПЕРЕВЕЗТИ, ПЕРЕРАБОТАТЬ, СМЕШАТЬ С ДРУГИМ СЫРЬЁМ,
Dialogue: 0,0:01:35.69,0:01:40.01,Caption,,0,0,0,,ПРОДАТЬ ДРУГОЙ КОМПАНИИ, ПЕРЕГРУЗИТЬ В ДРУГОМ ПОРТУ. ЧЕРЕЗ НЕСКОЛЬКО ОПЕРАЦИЙ
Dialogue: 0,0:01:40.01,0:01:42.33,Caption,,0,0,0,,ПЕРЕД ПОКУПАТЕЛЕМ УЖЕ ЛЕЖИТ ВПОЛНЕ ПРИЛИЧНЫЙ
Dialogue: 0,0:01:42.33,0:01:45.37,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ПРОДУКТ. ТО ЕСТЬ ПРЯМЫЕ РОССИЙСКИЕ
Dialogue: 0,0:01:45.37,0:01:48.49,Caption,,0,0,0,,ПОСТАВКИ ДЕЙСТВИТЕЛЬНО МОЖНО РЕЗКО СОКРАТИТЬ. ЕВРОПА
Dialogue: 0,0:01:48.57,0:01:51.37,Caption,,0,0,0,,ЭТО СДЕЛАЛА. ЗДЕСЬ СПОРИТЬ НЕ О ЧЕМ. НО
Dialogue: 0,0:01:51.37,0:01:54.49,Caption,,0,0,0,,ПРЯМОЙ ПОСТАВЩИК И ФИЗИЧЕСКОЕ ПРОИСХОЖДЕНИЕ СЫРЬЯ
Dialogue: 0,0:01:54.80,0:01:56.89,Caption,,0,0,0,,ДАЛЕКО НЕ ВСЕГДА ОДНО И ТО ЖЕ. И
Dialogue: 0,0:01:56.89,0:01:59.77,Caption,,0,0,0,,ПОЭТОМУ ФРАЗА "ЭНЕРГЕТИЧЕСКИЙ РАЗРЫВ ЗАВЕРШЁН"
Dialogue: 0,0:01:59.88,0:02:03.29,Caption,,0,0,0,,ЗВУЧИТ НЕМНОГО СМЕШНЕЕ, ЕСЛИ СМОТРЕТЬ НЕ ТОЛЬКО НА КОНТРАКТ,
Dialogue: 0,0:02:03.60,0:02:05.53,Caption,,0,0,0,,НО И НА ВЕСЬ ПУТЬ ТОВАРА. ПОТОМУ ЧТО
Dialogue: 0,0:02:05.53,0:02:10.25,Caption,,0,0,0,,ВДРУГ ОКАЗЫВАЕТСЯ, ЧТО ИНОГДА ИСЧЕЗАЕТ НЕ РОССИЙСКОЕ СЫРЬЁ. ИСЧЕЗАЕТ
Dialogue: 0,0:02:10.25,0:02:13.13,Caption,,0,0,0,,РОССИЙСКИЙ ПРОДАВЕЦ ИЗ ПОСЛЕДНЕЙ СТРОЧКИ НАКЛАДНОЙ.
Dialogue: 0,0:02:13.74,0:02:16.25,Caption,,0,0,0,,А ПОТОМ ПОЯВИЛАСЬ ЕЩЁ БОЛЕЕ КРАСИВАЯ ИСТОРИЯ.
Dialogue: 0,0:02:16.65,0:02:19.21,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ПРЕДЛАГАЮТ СНОВА ЗАПУСТИТЬ
Dialogue: 0,0:02:19.29,0:02:22.25,Caption,,0,0,0,,РОССИЙСКИЙ ГАЗ В ЕВРОПУ ЧЕРЕЗ УКРАИНУ. ТОЛЬКО ТЕПЕРЬ
Dialogue: 0,0:02:22.25,0:02:24.81,Caption,,0,0,0,,МЕЖДУ ПРОДАВЦОМ И ПОКУПАТЕЛЕМ ПРЕДЛАГАЕТСЯ ПОСТАВИТЬ
Dialogue: 0,0:02:24.81,0:02:28.25,Caption,,0,0,0,,АМЕРИКАНСКУЮ КОМПАНИЮ. ГАЗ РОССИЙСКИЙ. ТРУБА ЧЕРЕЗ
Dialogue: 0,0:02:28.25,0:02:34.21,Caption,,0,0,0,,УКРАИНУ. ПОКУПАТЕЛЬ ЕВРОПЕЙСКИЙ. А ПОСРЕДНИК АМЕРИКАНСКИЙ.
Dialogue: 0,0:02:34.76,0:02:38.04,Caption,,0,0,0,,ВОТ ТЕПЕРЬ ВСЁ ПРИЛИЧНО. КУШНЕР И УИТКОФФ ОБСУЖДАЛИ
Dialogue: 0,0:02:38.04,0:02:41.56,Caption,,0,0,0,,СХЕМУ, ПРИ КОТОРОЙ РОССИЙСКИЙ ГАЗ МОГ БЫ ПРОДАВАТЬСЯ ЧЕРЕЗ
Dialogue: 0,0:02:41.56,0:02:45.40,Caption,,0,0,0,,АМЕРИКАНСКОГО ПОСРЕДНИКА, УКРАИНА ПОЛУЧАЛА БЫ ДЕНЬГИ ЗА ТРАНЗИТ,
Dialogue: 0,0:02:45.64,0:02:47.96,Caption,,0,0,0,,А РОССИЙСКАЯ ВЫРУЧКА ПОСТУПАЛА БЫ НА СПЕЦИАЛЬНЫЙ
Dialogue: 0,0:02:48.04,0:02:50.76,Caption,,0,0,0,,СЧЁТ. И ВОТ ЗДЕСЬ УЖЕ СТАНОВИТСЯ ОСОБЕННО ВЕСЕЛО.
Dialogue: 0,0:02:51.24,0:02:53.32,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ ЕВРОПЕЙЦАМ ОБЪЯСНЯЛИ,
Dialogue: 0,0:02:53.53,0:02:56.44,Caption,,0,0,0,,ЧТО РОССИЙСКИЙ ГАЗ СОЗДАЁТ ЗАВИСИМОСТЬ. ЧТО ЭТО
Dialogue: 0,0:02:56.44,0:02:59.16,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ИНСТРУМЕНТ. ЧТО ЕВРОПА ДОЛЖНА
Dialogue: 0,0:02:59.16,0:03:01.72,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО ВЫРВАТЬСЯ ИЗ ЭТОЙ ЗАВИСИМОСТИ. И
Dialogue: 0,0:03:01.72,0:03:04.92,Caption,,0,0,0,,ПОЖАЛУЙСТА. РОССИЙСКИЙ ГАЗ НИКУДА НЕ ДЕЛСЯ. ПРОСТО
Dialogue: 0,0:03:04.92,0:03:07.16,Caption,,0,0,0,,МЕЖДУ РОССИЕЙ И ЕВРОПОЙ ПРЕДЛАГАЮТ ПОСТАВИТЬ
Dialogue: 0,0:03:07.16,0:03:11.64,Caption,,0,0,0,,АМЕРИКАНЦА. ВИДИМО, ЗАВИСИМОСТЬ ТЕПЕРЬ ОПРЕДЕЛЯЕТСЯ НЕ МОЛЕКУЛОЙ ГАЗА,
Dialogue: 0,0:03:11.79,0:03:15.56,Caption,,0,0,0,,А ЧЕЛОВЕКОМ, КОТОРЫЙ ВЫСТАВЛЯЕТ СЧЁТ. ВОТ ЕСЛИ СЧЁТ ВЫСТАВЛЯЕТ
Dialogue: 0,0:03:15.64,0:03:20.20,Caption,,0,0,0,,РОССИЙСКАЯ КОМПАНИЯ, ЭТО ОПАСНАЯ ГЕОПОЛИТИЧЕСКАЯ ЗАВИСИМОСТЬ. ЕСЛИ МЕЖДУ
Dialogue: 0,0:03:20.28,0:03:22.04,Caption,,0,0,0,,НИМИ СИДИТ АМЕРИКАНСКИЙ ПОСРЕДНИК,
Dialogue: 0,0:03:22.28,0:03:25.00,Caption,,0,0,0,,НАЧИНАЕТСЯ УЖЕ СОВЕРШЕННО ДРУГОЙ РАЗГОВОР. ЭТО
Dialogue: 0,0:03:25.00,0:03:28.28,Caption,,0,0,0,,НАЗЫВАЕТСЯ МАГИЯ ПОСРЕДНИКА. ПОДПИШИТЕСЬ,
Dialogue: 0,0:03:28.48,0:03:31.08,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗГОВОР. БЕЗ КРАСИВЫХ
Dialogue: 0,0:03:31.08,0:03:36.20,Caption,,0,0,0,,ВЫВЕСОК И С ВНИМАНИЕМ К ТОМУ, КОМУ В ИТОГЕ ДОСТАЮТСЯ ДЕНЬГИ. ОН НИЧЕГО НЕ
Dialogue: 0,0:03:36.20,0:03:40.20,Caption,,0,0,0,,ДОБЫВАЕТ. ГАЗ НЕ ПРОИЗВОДИТ. ТРУБУ ЧЕРЕЗ АТЛАНТИКУ
Dialogue: 0,0:03:40.30,0:03:45.51,Caption,,0,0,0,,ТОЖЕ ПОКА НЕ ПРОТЯНУЛ. НО ПОСАДИТЕ ЕГО ПОСЕРЕДИНЕ,
Dialogue: 0,0:03:45.91,0:03:48.95,Caption,,0,0,0,,И СТАРАЯ ПОЛИТИЧЕСКАЯ ПРОБЛЕМА ВНЕЗАПНО НАЧИНАЕТ
Dialogue: 0,0:03:48.95,0:03:51.59,Caption,,0,0,0,,ПРЕВРАЩАТЬСЯ В КОММЕРЧЕСКУЮ ВОЗМОЖНОСТЬ. ОНИ ХОТЯТ
Dialogue: 0,0:03:51.59,0:03:56.07,Caption,,0,0,0,,ЗАЩИТИТЬ СВОЁ БАБЛО. ХОТЯТ ЗАЩИТИТЬ СВОЁ БАБЛО. ВОТ ЗДЕСЬ ВООБЩЕ НЕ
Dialogue: 0,0:03:56.07,0:03:58.95,Caption,,0,0,0,,НАДО ИСКАТЬ СЛИШКОМ СЛОЖНЫЕ ОБЪЯСНЕНИЯ. ЕСТЬ ТОВАР.
Dialogue: 0,0:03:59.57,0:04:03.11,Caption,,0,0,0,,ЕСТЬ ПОКУПАТЕЛЬ. ЕСТЬ ПРОДАВЕЦ. ЕСТЬ МАРШРУТ. И
Dialogue: 0,0:04:03.11,0:04:06.55,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЧЕЛОВЕК, КОТОРЫЙ ГОВОРИТ А ДАВАЙТЕ ВСЁ ЭТО ПОЙДЁТ ЧЕРЕЗ
Dialogue: 0,0:04:06.63,0:04:08.87,Caption,,0,0,0,,МЕНЯ. У КОГО УЖЕ ЕСТЬ ВАГОН ЗОЛОТА,
Dialogue: 0,0:04:09.31,0:04:11.19,Caption,,0,0,0,,ТОТ ОБЫЧНО ПОЧЕМУ ТО НЕ ГОВОРИТ ВСЁ,
Dialogue: 0,0:04:11.28,0:04:15.59,Caption,,0,0,0,,РЕБЯТА, ХВАТИТ, МНЕ ДОСТАТОЧНО. НЕТ. К ВАГОНУ НУЖЕН ЕЩЁ ВАГОН.
Dialogue: 0,0:04:15.99,0:04:19.27,Caption,,0,0,0,,ПОТОМ ЕЩЁ МАЛЕНЬКИЙ. ПОТОМ ПЛАТФОРМА. А ПОТОМ
Dialogue: 0,0:04:19.35,0:04:21.91,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО ЖЕЛЕЗНУЮ ДОРОГУ ПРИВАТИЗИРОВАТЬ. ЭТО НЕ
Dialogue: 0,0:04:21.91,0:04:25.03,Caption,,0,0,0,,ЗНАЧИТ, ЧТО АМЕРИКАНСКОЕ ПРЕДЛОЖЕНИЕ ОБЯЗАТЕЛЬНО ПЛОХОЕ.
Dialogue: 0,0:04:25.43,0:04:27.83,Caption,,0,0,0,,ЕСЛИ ЧЕРЕЗ ТАКУЮ СХЕМУ ПОЯВЛЯЕТСЯ ВОЗМОЖНОСТЬ
Dialogue: 0,0:04:27.83,0:04:31.91,Caption,,0,0,0,,СНИЗИТЬ НАПРЯЖЕНИЕ, ОБЕСПЕЧИТЬ ПОСТАВКИ И ДАТЬ УКРАИНЕ ДЕНЬГИ ЗА
Dialogue: 0,0:04:31.91,0:04:34.95,Caption,,0,0,0,,ТРАНЗИТ, ХОРОШО. НО НЕ НАДО ДЕЛАТЬ ВИД,
Dialogue: 0,0:04:35.11,0:04:37.91,Caption,,0,0,0,,ЧТО ЗДЕСЬ ВСЕ ВДРУГ КОЛЛЕКТИВНО ПРОСНУЛИСЬ С МЫСЛЬЮ
Dialogue: 0,0:04:37.99,0:04:41.03,Caption,,0,0,0,,О СПАСЕНИИ ЧЕЛОВЕЧЕСТВА. ДЕНЬГИ ТАМ СТОЯТ ОЧЕНЬ
Dialogue: 0,0:04:41.11,0:04:43.19,Caption,,0,0,0,,БЛИЗКО. ПРИЧЁМ НАСТОЛЬКО БЛИЗКО,
Dialogue: 0,0:04:43.36,0:04:46.07,Caption,,0,0,0,,ЧТО ИХ ДАЖЕ ОСОБО ИСКАТЬ НЕ ПРИХОДИТСЯ. САМОЕ
Dialogue: 0,0:04:46.07,0:04:49.91,Caption,,0,0,0,,СМЕШНОЕ, ЧТО ЕВРОПЕЙЦАМ САМА ИДЕЯ ВОЗВРАЩЕНИЯ РОССИЙСКОГО
Dialogue: 0,0:04:49.91,0:04:52.71,Caption,,0,0,0,,ГАЗА НЕ ОСОБЕННО ПОНРАВИЛАСЬ. И ЭТО ТОЖЕ ПОНЯТНО.
Dialogue: 0,0:04:54.99,0:04:57.79,Caption,,0,0,0,,ОНИ НЕСКОЛЬКО ЛЕТ ОБЪЯСНЯЛИ СОБСТВЕННЫМ ИЗБИРАТЕЛЯМ,
Dialogue: 0,0:04:57.96,0:05:02.19,Caption,,0,0,0,,ПОЧЕМУ НАДО ПОКУПАТЬ ИНАЧЕ, ДОРОЖЕ ПЕРЕСТРАИВАТЬ ИНФРАСТРУКТУРУ,
Dialogue: 0,0:05:02.43,0:05:05.55,Caption,,0,0,0,,ИСКАТЬ НОВЫХ ПОСТАВЩИКОВ, СТРОИТЬ ТЕРМИНАЛЫ,
Dialogue: 0,0:05:05.67,0:05:08.43,Caption,,0,0,0,,МЕНЯТЬ МАРШРУТЫ. А ТЕПЕРЬ ПРИХОДИТ ВАШИНГТОН И
Dialogue: 0,0:05:08.51,0:05:12.59,Caption,,0,0,0,,ФАКТИЧЕСКИ ГОВОРИТ РЕБЯТА, А РОССИЙСКИЙ ГАЗ ВООБЩЕ ТО МОЖНО ВЕРНУТЬ. ТОЛЬКО
Dialogue: 0,0:05:12.59,0:05:15.07,Caption,,0,0,0,,НЕМНОГО ПО ДРУГОМУ. ПРЕДСТАВЛЯЮ ЧЕЛОВЕКА,
Dialogue: 0,0:05:15.32,0:05:17.71,Caption,,0,0,0,,КОТОРЫЙ НЕСКОЛЬКО ЛЕТ НАЗАД ВЫБРОСИЛ СТАРЫЙ
Dialogue: 0,0:05:17.71,0:05:20.99,Caption,,0,0,0,,ХОЛОДИЛЬНИК, КУПИЛ НОВЫЙ, ПЕРЕДЕЛАЛ КУХНЮ,
Dialogue: 0,0:05:21.16,0:05:25.07,Caption,,0,0,0,,ПОТРАТИЛ КУЧУ ДЕНЕГ, А ТЕПЕРЬ ЕМУ ВОЗВРАЩАЮТ ПРЕЖНИЙ И ОБЪЯСНЯЮТ НЕ
Dialogue: 0,0:05:25.07,0:05:28.51,Caption,,0,0,0,,ПЕРЕЖИВАЙТЕ, НА НЁМ УЖЕ АМЕРИКАНСКАЯ НАКЛЕЙКА. ПОЛЬЗУЙТЕСЬ.
Dialogue: 0,0:05:28.97,0:05:32.35,Caption,,0,0,0,,ДАЛЬШЕ ПОЯВЛЯЕТСЯ ЧЁРНОЕ МОРЕ. МАРКО РУБИО ГОВОРИТ О
Dialogue: 0,0:05:32.35,0:05:34.43,Caption,,0,0,0,,ВОЗМОЖНОСТИ ОГРАНИЧЕННОГО ПЕРЕМИРИЯ,
Dialogue: 0,0:05:34.75,0:05:37.63,Caption,,0,0,0,,КОТОРОЕ ДОЛЖНО ОБЕСПЕЧИТЬ БОЛЕЕ БЕЗОПАСНЫЕ ПЕРЕВОЗКИ
Dialogue: 0,0:05:37.63,0:05:41.39,Caption,,0,0,0,,ЗЕРНА И ЭНЕРГОРЕСУРСОВ. ТУРЦИЯ И ИНДИЯ ПРЕДЛАГАЮТ
Dialogue: 0,0:05:41.47,0:05:43.63,Caption,,0,0,0,,СВОИ ВАРИАНТЫ. ВАШИНГТОН ГОВОРИТ,
Dialogue: 0,0:05:43.74,0:05:45.79,Caption,,0,0,0,,ЧТО САМ ПО СЕБЕ ТАКОЙ ДОГОВОР ВОЙНУ НЕ
Dialogue: 0,0:05:45.79,0:05:49.47,Caption,,0,0,0,,ЗАКАНЧИВАЕТ, НО МОЖЕТ РЕШИТЬ ОТДЕЛЬНУЮ ПРОБЛЕМУ. И ОПЯТЬ
Dialogue: 0,0:05:49.47,0:05:52.11,Caption,,0,0,0,,УДИВИТЕЛЬНОЕ СОВПАДЕНИЕ. КАК ТОЛЬКО РЕЧЬ ЗАХОДИТ О
Dialogue: 0,0:05:52.11,0:05:54.67,Caption,,0,0,0,,КОНКРЕТНОМ ТОВАРЕ, КОНКРЕТНОМ СУДНЕ,
Dialogue: 0,0:05:54.83,0:05:57.23,Caption,,0,0,0,,КОНКРЕТНОМ МАРШРУТЕ И КОНКРЕТНЫХ ДЕНЬГАХ,
Dialogue: 0,0:05:57.64,0:06:00.59,Caption,,0,0,0,,ДИПЛОМАТИЯ ВДРУГ СТАНОВИТСЯ ОЧЕНЬ ПРЕДМЕТНОЙ. НЕ
Dialogue: 0,0:06:00.59,0:06:03.31,Caption,,0,0,0,,ВЕЧНЫЙ РАЗГОВОР О ПРИНЦИПАХ. НЕ СОРОК СТРАНИЦ
Dialogue: 0,0:06:03.31,0:06:06.35,Caption,,0,0,0,,ЗАЯВЛЕНИЙ. СУДНО НЕ ТРОГАЕМ. ЗЕРНО ИДЁТ.
Dialogue: 0,0:06:06.59,0:06:09.39,Caption,,0,0,0,,ЭНЕРГОРЕСУРСЫ ИДУТ. ВОТ ЗДЕСЬ НЕ СТРЕЛЯЕМ.
Dialogue: 0,0:06:11.66,0:06:14.78,Caption,,0,0,0,,ВОТ ЭТОТ МАРШРУТ РАБОТАЕТ. СРАЗУ ВСЁ СТАНОВИТСЯ КАК
Dialogue: 0,0:06:14.78,0:06:17.34,Caption,,0,0,0,,ТО ПОНЯТНЕЕ. А ТЕПЕРЬ СРАВНИТЕ ЭТУ СКОРОСТЬ
Dialogue: 0,0:06:17.34,0:06:22.06,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ С ТЕМ, КАК РЕШАЮТСЯ ВОПРОСЫ ОБЫЧНЫХ ЛЮДЕЙ. А ГДЕ ЗДЕСЬ
Dialogue: 0,0:06:22.14,0:06:25.50,Caption,,0,0,0,,ЛЮДИ? ПОТОМУ ЧТО ДОГОВОРИТЬСЯ О ГРУЗЕ ИНОГДА ПОЛУЧАЕТСЯ
Dialogue: 0,0:06:25.50,0:06:27.66,Caption,,0,0,0,,БЫСТРЕЕ, ЧЕМ ДОГОВОРИТЬСЯ О ТЕХ,
Dialogue: 0,0:06:27.87,0:06:30.46,Caption,,0,0,0,,КТО ЖИВЁТ РЯДОМ СО ВСЕМ ЭТИМ. ХОТЯ ПРИМЕР
Dialogue: 0,0:06:30.46,0:06:34.30,Caption,,0,0,0,,АЛЁШЕК ПОКАЗЫВАЕТ, ЧТО И ЧЕЛОВЕЧЕСКИЕ ВОПРОСЫ РЕШАТЬ МОЖНО. ТАМ
Dialogue: 0,0:06:34.30,0:06:36.94,Caption,,0,0,0,,ЛОКАЛЬНОЕ ПРЕКРАЩЕНИЕ ОГНЯ ПОЗВОЛИЛО ПРОВЕСТИ
Dialogue: 0,0:06:36.94,0:06:41.26,Caption,,0,0,0,,ГУМАНИТАРНУЮ ОПЕРАЦИЮ, ДОСТАВИТЬ ПОМОЩЬ И ВЫВЕЗТИ ЛЮДЕЙ. ЗНАЧИТ,
Dialogue: 0,0:06:41.34,0:06:44.30,Caption,,0,0,0,,МЕХАНИЗМ СУЩЕСТВУЕТ. КОГДА СТОРОНЫ ХОТЯТ РЕШИТЬ
Dialogue: 0,0:06:44.30,0:06:48.46,Caption,,0,0,0,,КОНКРЕТНУЮ ЗАДАЧУ, ОНИ ИНОГДА СПОСОБНЫ ХОТЯ БЫ НА ВРЕМЯ ДОГОВОРИТЬСЯ.
Dialogue: 0,0:06:48.82,0:06:53.34,Caption,,0,0,0,,НО ПОСМОТРИТЕ, ГДЕ СЕЙЧАС ПОЯВЛЯЕТСЯ БОЛЬШЕ ВСЕГО КОНКРЕТИКИ. ГАЗ.
Dialogue: 0,0:06:53.73,0:06:59.02,Caption,,0,0,0,,ЗЕРНО. СУДА. ТРАНЗИТ. ЭНЕРГОРЕСУРСЫ. СЧЕТА. ТО ЕСТЬ
Dialogue: 0,0:06:59.02,0:07:02.06,Caption,,0,0,0,,ЭКОНОМИКА УМЕЕТ ОЧЕНЬ БЫСТРО ОБЪЯСНИТЬ ПОЛИТИКАМ,
Dialogue: 0,0:07:02.28,0:07:05.34,Caption,,0,0,0,,ГДЕ ИМЕННО У НИХ НАЧИНАЕТСЯ ЗДРАВЫЙ СМЫСЛ. И
Dialogue: 0,0:07:05.42,0:07:07.50,Caption,,0,0,0,,ЗДЕСЬ МЫ ПОДХОДИМ К СОВЕРШЕННО ПРЕКРАСНОМУ
Dialogue: 0,0:07:07.50,0:07:09.90,Caption,,0,0,0,,EUROCLEAR. В СИСТЕМЕ БЕЛЬГИЙСКОГО EUROCLEAR
Dialogue: 0,0:07:09.90,0:07:12.86,Caption,,0,0,0,,УЧИТЫВАЕТСЯ ОКОЛО ДВУХСОТ ЧЕТЫРЁХ МИЛЛИАРДОВ ЕВРО
Dialogue: 0,0:07:12.86,0:07:17.18,Caption,,0,0,0,,РОССИЙСКИХ АКТИВОВ, ДОСТУП К КОТОРЫМ ОГРАНИЧЕН САНКЦИЯМИ. ЗА ПЕРВЫЕ
Dialogue: 0,0:07:17.18,0:07:20.22,Caption,,0,0,0,,ДЕВЯТЬ МЕСЯЦЕВ ЭТОГО ГОДА ПРОЦЕНТНЫЙ ДОХОД ОТ
Dialogue: 0,0:07:20.30,0:07:23.42,Caption,,0,0,0,,РОССИЙСКИХ АКТИВОВ СОСТАВИЛ ТРИ МИЛЛИАРДА ШЕСТЬСОТ
Dialogue: 0,0:07:23.42,0:07:28.42,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО. EUROCLEAR ОТДЕЛЬНО СООБЩАЕТ,
Dialogue: 0,0:07:28.65,0:07:31.94,Caption,,0,0,0,,ЧТО ОКОЛО ВОСЬМИ МИЛЛИАРДОВ ЕВРО УЖЕ ПЕРЕЧИСЛЕНО
Dialogue: 0,0:07:31.94,0:07:34.26,Caption,,0,0,0,,ЕВРОСОЮЗУ В РАМКАХ МЕХАНИЗМА ИСПОЛЬЗОВАНИЯ
Dialogue: 0,0:07:34.26,0:07:37.30,Caption,,0,0,0,,СВЕРХДОХОДОВ. ТО ЕСТЬ ОТНОШЕНИЯ С РОССИЕЙ ВРОДЕ БЫ
Dialogue: 0,0:07:37.30,0:07:41.06,Caption,,0,0,0,,РАЗОРВАЛИ. ДЕНЬГИ РОССИИ ЗАМОРОЗИЛИ. А ЗАРАБАТЫВАТЬ
Dialogue: 0,0:07:41.14,0:07:44.02,Caption,,0,0,0,,НА ЭТИХ ДЕНЬГАХ НЕ ПЕРЕСТАЛИ. ВОТ ТАКОЙ УДИВИТЕЛЬНЫЙ
Dialogue: 0,0:07:44.02,0:07:46.42,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЙ РАЗВОД. С СУПРУГОМ БОЛЬШЕ НЕ
Dialogue: 0,0:07:46.42,0:07:48.66,Caption,,0,0,0,,РАЗГОВАРИВАЕМ, ВИДЕТЬ ЕГО НЕ ХОТИМ,
Dialogue: 0,0:07:48.82,0:07:52.58,Caption,,0,0,0,,ВЕЩИ ЕГО ЗАБРАЛИ, А ПРОЦЕНТЫ ПО ЕГО ВКЛАДУ ПОЧЕМУ ТО ОСТАВИЛИ
Dialogue: 0,0:07:52.58,0:07:57.54,Caption,,0,0,0,,СЕБЕ. ОЧЕНЬ ПРИНЦИПИАЛЬНО. ЮРИДИЧЕСКИ АКТИВЫ НАЗЫВАЮТСЯ ИММОБИЛИЗОВАННЫМИ,
Dialogue: 0,0:07:57.85,0:08:00.34,Caption,,0,0,0,,А ИСПОЛЬЗОВАНИЕ ДОХОДОВ ОФОРМЛЕНО ЕВРОПЕЙСКИМИ
Dialogue: 0,0:08:00.42,0:08:03.62,Caption,,0,0,0,,РЕШЕНИЯМИ. ЭТО ЮРИДИЧЕСКИЙ ЯЗЫК. НА ОБЫЧНОМ
Dialogue: 0,0:08:03.62,0:08:06.02,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКОМ ЯЗЫКЕ КАРТИНКА ВЫГЛЯДИТ КУДА ПРОЩЕ.
Dialogue: 0,0:08:06.22,0:08:10.58,Caption,,0,0,0,,ПРЕДСТАВЬТЕ УВАЖАЕМОГО ВОРА, КОТОРЫЙ НЕ ПРОСТО ПРИСВОИЛ ЧУЖИЕ ЦЕННОСТИ,
Dialogue: 0,0:08:10.74,0:08:13.14,Caption,,0,0,0,,А ЕЩЁ УМУДРИЛСЯ ПОЛУЧАТЬ С НИХ ПРИБЫЛЬ. И
Dialogue: 0,0:08:13.14,0:08:15.22,Caption,,0,0,0,,ТЕПЕРЬ СТОИТ ПЕРЕД ПУБЛИКОЙ С БУХГАЛТЕРСКИМИ
Dialogue: 0,0:08:15.22,0:08:18.10,Caption,,0,0,0,,БУМАГАМИ. НЕ ПРЯЧЕТСЯ, НЕ ОПРАВДЫВАЕТСЯ,
Dialogue: 0,0:08:18.34,0:08:21.30,Caption,,0,0,0,,А БОДРО ДОКЛАДЫВАЕТ О ФИНАНСОВЫХ УСПЕХАХ. ГОД БЫЛ
Dialogue: 0,0:08:21.38,0:08:24.02,Caption,,0,0,0,,УДАЧНЫМ. ЧУЖОЕ ИМУЩЕСТВО СРАБОТАЛО ХОРОШО.
Dialogue: 0,0:08:24.23,0:08:27.30,Caption,,0,0,0,,ДОХОДНОСТЬ ДОСТОЙНАЯ. ПРОДОЛЖАЕМ РАБОТАТЬ. НУ ФИГНЯ
Dialogue: 0,0:08:27.30,0:08:29.54,Caption,,0,0,0,,КАКАЯ. И ВЕДЬ РЕЧЬ НЕ О ДЕСЯТИ ТЫСЯЧАХ
Dialogue: 0,0:08:29.54,0:08:33.06,Caption,,0,0,0,,ЕВРО. ДВЕСТИ ЧЕТЫРЕ МИЛЛИАРДА. ТРИ МИЛЛИАРДА
Dialogue: 0,0:08:33.06,0:08:35.78,Caption,,0,0,0,,ШЕСТЬСОТ МИЛЛИОНОВ ЕВРО ПРОЦЕНТНОГО ДОХОДА ВСЕГО ЗА
Dialogue: 0,0:08:35.78,0:08:38.50,Caption,,0,0,0,,ДЕВЯТЬ МЕСЯЦЕВ. ЭТО УЖЕ НЕ МЕЛОЧЬ МЕЖДУ ДИВАНОМ
Dialogue: 0,0:08:38.50,0:08:43.74,Caption,,0,0,0,,И СТЕНКОЙ. ЭТО ОТДЕЛЬНАЯ ФИНАНСОВАЯ РЕАЛЬНОСТЬ. ПРИЧЁМ
Dialogue: 0,0:08:43.74,0:08:48.14,Caption,,0,0,0,,EUROCLEAR САМ УКАЗЫВАЕТ, ЧТО ВОКРУГ ЭТИХ АКТИВОВ ИДУТ СУДЕБНЫЕ ПРОЦЕССЫ.
Dialogue: 0,0:08:48.49,0:08:51.02,Caption,,0,0,0,,РОССИЙСКИЙ ЦЕНТРОБАНК СУДИТСЯ С ДЕПОЗИТАРИЕМ,
Dialogue: 0,0:08:51.22,0:08:53.98,Caption,,0,0,0,,А EUROCLEAR ПРОДОЛЖАЕТ ОСПАРИВАТЬ РЕШЕНИЯ РОССИЙСКИХ
Dialogue: 0,0:08:53.98,0:08:56.54,Caption,,0,0,0,,СУДОВ. ТО ЕСТЬ НИКТО НИКУДА ЭТУ ИСТОРИЮ НЕ
Dialogue: 0,0:08:56.62,0:08:59.50,Caption,,0,0,0,,ЗАКРЫЛ. ОНА ПРОСТО СУЩЕСТВУЕТ В СТРАННОМ СОСТОЯНИИ
Dialogue: 0,0:08:59.50,0:09:02.70,Caption,,0,0,0,,ДЕНЬГИ РОССИИ ЗАБЛОКИРОВАНЫ, ДОХОД С НИХ ПОЯВЛЯЕТСЯ,
Dialogue: 0,0:09:02.94,0:09:05.26,Caption,,0,0,0,,ЧАСТЬ ЭТОГО ДОХОДА УХОДИТ ЕВРОСОЮЗУ,
Dialogue: 0,0:09:05.42,0:09:07.58,Caption,,0,0,0,,А ВОКРУГ САМОЙ СОБСТВЕННОСТИ ПРОДОЛЖАЕТСЯ
Dialogue: 0,0:09:07.59,0:09:11.42,Caption,,0,0,0,,ЮРИДИЧЕСКАЯ ДРАКА. И ТУТ САМОЕ ВРЕМЯ ВСПОМНИТЬ СЛОВА,
Dialogue: 0,0:09:11.65,0:09:14.62,Caption,,0,0,0,,КОТОРЫЕ ПРИПИСЫВАЮТ БИСМАРКУ. РУССКИЕ ВСЕГДА
Dialogue: 0,0:09:14.62,0:09:17.82,Caption,,0,0,0,,ВОЗВРАЩАЮТСЯ ЗА СВОИМИ ДЕНЬГАМИ. НО ЗДЕСЬ ВАЖНЕЕ САМ
Dialogue: 0,0:09:17.82,0:09:20.70,Caption,,0,0,0,,СМЫСЛ. ВБЕЙТЕ СЕБЕ ЭТО В МОЗГ. МОЖНО СКОЛЬКО
Dialogue: 0,0:09:20.70,0:09:23.82,Caption,,0,0,0,,УГОДНО СЧИТАТЬ МИЛЛИАРДЫ В КВАРТАЛЬНОМ ОТЧЁТЕ. НО
Dialogue: 0,0:09:23.82,0:09:26.30,Caption,,0,0,0,,ЕСЛИ ВЛАДЕЛЕЦ ЭТИХ АКТИВОВ НЕ СЧИТАЕТ ВОПРОС
Dialogue: 0,0:09:26.30,0:09:30.54,Caption,,0,0,0,,ЗАКРЫТЫМ, ЗНАЧИТ ПОБЕДНЫЙ БАНКЕТ ПРОВОДИТЬ РАНОВАТО. ВЫ РАНО
Dialogue: 0,0:09:30.54,0:09:34.94,Caption,,0,0,0,,ПРАЗДНУЕТЕ СВОИ ПОБЕДЫ. МОСКВА ЭТОТ СЧЁТ НЕ СПИСАЛА И СПОР ПРЕКРАЩАТЬ
Dialogue: 0,0:09:34.94,0:09:38.06,Caption,,0,0,0,,НЕ СОБИРАЕТСЯ. ЕСЛИ ОДНАЖДЫ ДЕЛО ДОЙДЁТ ДО ВОЗВРАТА
Dialogue: 0,0:09:38.06,0:09:41.90,Caption,,0,0,0,,АКТИВОВ, ВОЗНИКНЕТ СЛЕДУЮЩИЙ ВОПРОС. КОМУ ПРИНАДЛЕЖАТ
Dialogue: 0,0:09:41.90,0:09:45.02,Caption,,0,0,0,,МИЛЛИАРДЫ, ЗАРАБОТАННЫЕ НА НИХ ЗА ГОДЫ БЛОКИРОВКИ?
Dialogue: 0,0:09:45.33,0:09:48.62,Caption,,0,0,0,,И ТОГДА НЫНЕШНИМ ЛЮБИТЕЛЯМ КРАСИВЫХ ОТЧЁТОВ МОЖЕТ
Dialogue: 0,0:09:48.62,0:09:51.34,Caption,,0,0,0,,ПОНАДОБИТЬСЯ УЖЕ СОВСЕМ ДРУГАЯ БУХГАЛТЕРИЯ. НЕ
Dialogue: 0,0:09:51.34,0:09:55.26,Caption,,0,0,0,,ИСКЛЮЧЕНО, ЧТО ПЛАТИТЬ ПРИДЁТСЯ С ЛИХВОЙ. И ТЕПЕРЬ ГЕРМАНИЯ.
Dialogue: 0,0:09:57.46,0:09:59.62,Caption,,0,0,0,,ЗДЕСЬ ВООБЩЕ ПРЕКРАСНЫЙ ПРИМЕР ТОГО,
Dialogue: 0,0:09:59.85,0:10:02.50,Caption,,0,0,0,,КАК ИЗ ОДНОЙ ЦИФРЫ МОЖНО СДЕЛАТЬ КОНЕЦ СВЕТА.
Dialogue: 0,0:10:03.22,0:10:05.70,Caption,,0,0,0,,ГАЗОВЫЕ ХРАНИЛИЩА ГЕРМАНИИ НА НАЧАЛО НОЯБРЯ
Dialogue: 0,0:10:05.70,0:10:08.34,Caption,,0,0,0,,ЗАПОЛНЕНЫ ПРИМЕРНО НА ШЕСТЬДЕСЯТ ОДИН ПРОЦЕНТ.
Dialogue: 0,0:10:08.79,0:10:12.90,Caption,,0,0,0,,REUTERS СООБЩАЕТ, ЧТО ВТОРОГО НОЯБРЯ УРОВЕНЬ СОСТАВЛЯЛ ОКОЛО
Dialogue: 0,0:10:12.90,0:10:16.34,Caption,,0,0,0,,ШЕСТИДЕСЯТИ ОДНОЙ ЦЕЛОЙ ПЯТИ СОТЫХ ПРОЦЕНТА. ЭТО
Dialogue: 0,0:10:16.34,0:10:19.78,Caption,,0,0,0,,ЗАМЕТНО НИЖЕ СРЕДНЕГО УРОВНЯ ПО ЕВРОСОЮЗУ И НИЖЕ
Dialogue: 0,0:10:19.86,0:10:22.74,Caption,,0,0,0,,НЕМЕЦКОЙ ОРИЕНТИРОВОЧНОЙ ЦЕЛИ ПРИМЕРНО В СЕМЬДЕСЯТ
Dialogue: 0,0:10:22.74,0:10:25.94,Caption,,0,0,0,,ПРОЦЕНТОВ. И СРАЗУ НАЧИНАЕТСЯ ЛЮБИМОЕ. ВСЁ.
Dialogue: 0,0:10:26.32,0:10:30.50,Caption,,0,0,0,,ЗАМЕРЗАЮТ. ЕВРОПЕ КОНЕЦ. НЕМЦЫ УЖЕ ЖГУТ МЕБЕЛЬ. НЕТ.
Dialogue: 0,0:10:30.80,0:10:32.66,Caption,,0,0,0,,ШЕСТЬДЕСЯТ ОДИН ПРОЦЕНТ ОЗНАЧАЕТ,
Dialogue: 0,0:10:32.81,0:10:36.50,Caption,,0,0,0,,ЧТО В ХРАНИЛИЩАХ МЕНЬШЕ ЗАПАСА. ВСЁ. ГАЗ ПРОДОЛЖАЕТ
Dialogue: 0,0:10:36.50,0:10:40.18,Caption,,0,0,0,,ПОСТУПАТЬ. ЕСТЬ ИМПОРТ. ЕСТЬ СПГ. ЕСТЬ ЕВРОПЕЙСКИЙ
Dialogue: 0,0:10:40.26,0:10:42.58,Caption,,0,0,0,,РЫНОК. ПРОБЛЕМА НАЧИНАЕТСЯ НЕ С ТОГО,
Dialogue: 0,0:10:42.66,0:10:46.02,Caption,,0,0,0,,ЧТО ЗАВТРА ГАЗ ФИЗИЧЕСКИ ИСЧЕЗНЕТ. ПРОБЛЕМА В ЦЕНЕ.
Dialogue: 0,0:10:46.25,0:10:48.34,Caption,,0,0,0,,ЕСЛИ ЗИМОЙ ПОТРЕБУЕТСЯ ПОКУПАТЬ БОЛЬШЕ
Dialogue: 0,0:10:48.34,0:10:51.70,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫХ ОБЪЁМОВ, ПОКУПАТЬ ИХ ПРИДЁТСЯ ПО ТОЙ ЦЕНЕ,
Dialogue: 0,0:10:51.88,0:10:54.26,Caption,,0,0,0,,КОТОРАЯ БУДЕТ НА РЫНКЕ В ЭТОТ МОМЕНТ. А
Dialogue: 0,0:10:54.34,0:10:56.58,Caption,,0,0,0,,ЦЕНЫ УЖЕ ВЫРОСЛИ. REUTERS ПИШЕТ,
Dialogue: 0,0:10:56.80,0:10:59.70,Caption,,0,0,0,,ЧТО ДОРОГОЙ ГАЗ СДЕЛАЛ ЗАКАЧКУ В ХРАНИЛИЩА МЕНЕЕ
Dialogue: 0,0:10:59.70,0:11:01.22,Caption,,0,0,0,,ПРИВЛЕКАТЕЛЬНОЙ ДЛЯ ТРЕЙДЕРОВ,
Dialogue: 0,0:11:01.46,0:11:04.10,Caption,,0,0,0,,А НЕМЕЦКОЕ ПРАВИТЕЛЬСТВО ПОКА НЕ СЧИТАЕТ НЕОБХОДИМЫМ
Dialogue: 0,0:11:04.10,0:11:06.98,Caption,,0,0,0,,ВМЕШИВАТЬСЯ И ПРИНУДИТЕЛЬНО НАРАЩИВАТЬ ЗАПАСЫ. ВОТ
Dialogue: 0,0:11:06.98,0:11:10.34,Caption,,0,0,0,,ЭТО УЖЕ НОРМАЛЬНАЯ ИСТОРИЯ. НЕ АПОКАЛИПСИС. НЕ НЕМЕЦ
Dialogue: 0,0:11:10.34,0:11:13.86,Caption,,0,0,0,,В ВАЛЕНКАХ ВОЗЛЕ КОСТРА. А ОБЫЧНАЯ ЭКОНОМИКА. ЗАПАС
Dialogue: 0,0:11:13.86,0:11:17.02,Caption,,0,0,0,,МЕНЬШЕ. ЗНАЧИТ,
Dialogue: 0,0:11:17.10,0:11:20.22,Caption,,0,0,0,,ЗАВИСИМОСТЬ ОТ ЗИМНЕГО РЫНКА ВЫШЕ. ЕСЛИ РЫНОК
Dialogue: 0,0:11:20.22,0:11:23.34,Caption,,0,0,0,,СПОКОЙНЫЙ, ПРОЖИЛИ. ЕСЛИ РЫНОК СХОДИТ С УМА,
Dialogue: 0,0:11:23.51,0:11:26.14,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ХОРОШИЙ ТАКОЙ СЧЁТ. И ЗДЕСЬ СНОВА
Dialogue: 0,0:11:26.22,0:11:30.86,Caption,,0,0,0,,ВОЗНИКАЕТ ТА ЖЕ САМАЯ ВЕЩЬ, С КОТОРОЙ МЫ НАЧАЛИ. ПОЛИТИКИ ОЧЕНЬ ЛЮБЯТ ГОВОРИТЬ
Dialogue: 0,0:11:30.86,0:11:35.90,Caption,,0,0,0,,СЛОВАМИ ОКОНЧАТЕЛЬНО, НАВСЕГДА И БОЛЬШЕ НИКОГДА. РЫНОК ТАКИХ СЛОВ ВООБЩЕ
Dialogue: 0,0:11:35.98,0:11:39.82,Caption,,0,0,0,,НЕ ЗНАЕТ. ОН ЗНАЕТ ЦЕНУ. ПОСТАВЩИКА. МАРШРУТ.
Dialogue: 0,0:11:40.04,0:11:44.06,Caption,,0,0,0,,СТРАХОВКУ. ПОСРЕДНИКА. СРОК ПОСТАВКИ. ПРОЦЕНТ. И
Dialogue: 0,0:11:44.06,0:11:48.06,Caption,,0,0,0,,ФАМИЛИЮ ТОГО, КТО ПОЛУЧАЕТ ДЕНЬГИ. ПОЭТОМУ ЕВРОПА ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:11:48.06,0:11:51.90,Caption,,0,0,0,,МОЖЕТ СКАЗАТЬ, ЧТО ПРЯМУЮ ЭНЕРГЕТИЧЕСКУЮ ЗАВИСИМОСТЬ ОТ РОССИИ
Dialogue: 0,0:11:52.05,0:11:55.18,Caption,,0,0,0,,РЕЗКО СОКРАТИЛА. ЭТО ПРАВДА. НО ДАЛЬШЕ НАЧИНАЕТСЯ
Dialogue: 0,0:11:55.18,0:11:58.78,Caption,,0,0,0,,САМОЕ НЕУДОБНОЕ. РОССИЙСКОЕ СЫРЬЁ ВСЁ РАВНО СПОСОБНО
Dialogue: 0,0:11:58.86,0:12:02.22,Caption,,0,0,0,,ПОЯВЛЯТЬСЯ ЧЕРЕЗ ТРЕТЬИ СТРАНЫ. РОССИЙСКИЙ ГАЗ СНОВА
Dialogue: 0,0:12:02.22,0:12:05.18,Caption,,0,0,0,,ОБСУЖДАЕТСЯ КАК ТОВАР ДЛЯ ЕВРОПЕЙСКОГО РЫНКА. ТОЛЬКО
Dialogue: 0,0:12:05.26,0:12:08.06,Caption,,0,0,0,,ТЕПЕРЬ РЯДОМ ПОЯВЛЯЕТСЯ АМЕРИКАНСКИЙ ПОСРЕДНИК.
Dialogue: 0,0:12:08.29,0:12:11.10,Caption,,0,0,0,,РОССИЙСКИЕ ДЕНЬГИ ЛЕЖАТ В EUROCLEAR И ОДНОВРЕМЕННО
Dialogue: 0,0:12:11.10,0:12:14.30,Caption,,0,0,0,,ПРИНОСЯТ МИЛЛИАРДЫ ДОХОДА. ГЕРМАНИЯ ВХОДИТ В ЗИМУ С
Dialogue: 0,0:12:14.30,0:12:18.30,Caption,,0,0,0,,МЕНЬШИМ ЗАПАСОМ И СМОТРИТ, СКОЛЬКО БУДЕТ СТОИТЬ СЛЕДУЮЩИЙ КУБОМЕТР ГАЗА.
Dialogue: 0,0:12:18.51,0:12:21.42,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ДОВОЛЬНО ИНТЕРЕСНЫЙ "РАЗРЫВ". СВЯЗИ СТАЛИ
Dialogue: 0,0:12:21.42,0:12:25.02,Caption,,0,0,0,,ДРУГИМИ. МАРШРУТЫ СТАЛИ ДРУГИМИ. ПОСРЕДНИКИ СТАЛИ
Dialogue: 0,0:12:25.02,0:12:28.54,Caption,,0,0,0,,ДРУГИМИ. ПОЛУЧАТЕЛИ ЧАСТИ ДЕНЕГ ТОЖЕ СТАЛИ ДРУГИМИ.
Dialogue: 0,0:12:28.92,0:12:34.41,Caption,,0,0,0,,А ТОВАР ИНОГДА ВСЁ ТОТ ЖЕ. ВОТ ПОЭТОМУ ВОПРОС УЖЕ НЕ В ТОМ,
Dialogue: 0,0:12:34.54,0:12:37.61,Caption,,0,0,0,,ВЕРНЁТСЯ ЛИ РОССИЙСКАЯ ЭНЕРГИЯ В ЕВРОПУ. ОНА МЕСТАМИ
Dialogue: 0,0:12:37.61,0:12:40.49,Caption,,0,0,0,,ОТТУДА ПОЛНОСТЬЮ И НЕ ИСЧЕЗАЛА. ГОРАЗДО ИНТЕРЕСНЕЕ
Dialogue: 0,0:12:40.49,0:12:43.77,Caption,,0,0,0,,ДРУГОЕ. ЧЕРЕЗ ЧЬИ РУКИ ОНА ТЕПЕРЬ БУДЕТ ПРОХОДИТЬ.
Dialogue: 0,0:12:44.08,0:12:46.73,Caption,,0,0,0,,ПОТОМУ ЧТО ИНОГДА БОЛЬШАЯ ГЕОПОЛИТИКА ВЫГЛЯДИТ ОЧЕНЬ
Dialogue: 0,0:12:46.73,0:12:51.53,Caption,,0,0,0,,СЛОЖНО ТОЛЬКО ДО ТЕХ ПОР, ПОКА НЕ НАЙДЁШЬ КАССУ. А ВОЗЛЕ КАССЫ ВСЁ
Dialogue: 0,0:12:51.53,0:12:54.65,Caption,,0,0,0,,ПОЧЕМУ ТО СТАНОВИТСЯ ЗНАЧИТЕЛЬНО ПОНЯТНЕЕ. МОСТ
Dialogue: 0,0:12:54.65,0:12:58.41,Caption,,0,0,0,,ТОРЖЕСТВЕННО СОЖГЛИ. ОРКЕСТР СЫГРАЛ. ВСЕ ВЫСТУПИЛИ.
Dialogue: 0,0:12:58.81,0:13:01.21,Caption,,0,0,0,,А ЧУТЬ В СТОРОНЕ УЖЕ СТРОЯТ НОВЫЙ. ПЛАТНЫЙ.
Dialogue: 0,0:13:01.67,0:13:03.93,Caption,,0,0,0,,И ЖЕЛАЮЩИХ ПОСТАВИТЬ ТАМ СВОЙ ШЛАГБАУМ,
Dialogue: 0,0:13:04.01,0:13:05.13,Caption,,0,0,0,,ПОХОЖЕ, ХВАТАЕТ.
