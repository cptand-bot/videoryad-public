Dialogue: 0,0:00:00.12,0:00:02.00,Caption,,0,0,0,,С ЛЮДЬМИ НА УКРАИНЕ СТАНОВИТСЯ ВСЁ
Dialogue: 0,0:00:02.00,0:00:04.50,Caption,,0,0,0,,ХУЖЕ, А С ОБЕЩАНИЯМИ ВСЁ ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:00:04.50,0:00:07.92,Caption,,0,0,0,,ОБЕЩАНИЙ ХВАТИТ ЕЩЁ НА НЕСКОЛЬКО ПОКОЛЕНИЙ УКРАИНЦЕВ. ТУТ
Dialogue: 0,0:00:07.92,0:00:10.33,Caption,,0,0,0,,ЕВРОПЕЙЦЫ ДЕЙСТВИТЕЛЬНО МОГУТ НИЧЕМ СЕБЯ НЕ
Dialogue: 0,0:00:10.33,0:00:12.85,Caption,,0,0,0,,ОГРАНИЧИВАТЬ. НО ЗА ПОСЛЕДНИЕ НЕСКОЛЬКО ДНЕЙ ОНИ
Dialogue: 0,0:00:12.85,0:00:15.08,Caption,,0,0,0,,НАГОВОРИЛИ И НАДЕЛАЛИ СТОЛЬКО ИНТЕРЕСНОГО,
Dialogue: 0,0:00:15.32,0:00:17.37,Caption,,0,0,0,,ЧТО Я БЫ НА МЕСТЕ КИЕВА ПОВНИМАТЕЛЬНЕЕ
Dialogue: 0,0:00:17.37,0:00:20.05,Caption,,0,0,0,,ПОСЛУШАЛ СВОИХ ЕВРОПЕЙСКИХ ДРУЗЕЙ. ПРИЧЁМ НЕ
Dialogue: 0,0:00:20.05,0:00:22.28,Caption,,0,0,0,,ТОГДА, КОГДА ОНИ РАЗГОВАРИВАЮТ С ЗЕЛЕНСКИМ,
Dialogue: 0,0:00:22.60,0:00:25.48,Caption,,0,0,0,,А ТОГДА, КОГДА ОБСУЖДАЮТ СОБСТВЕННЫЕ ИНТЕРЕСЫ.
Dialogue: 0,0:00:26.04,0:00:27.84,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ ВЗГЛЯД НА
Dialogue: 0,0:00:27.84,0:00:30.04,Caption,,0,0,0,,ПРОИСХОДЯЩЕЕ БЕЗ ДИПЛОМАТИЧЕСКОЙ ШЕЛУХИ,
Dialogue: 0,0:00:30.19,0:00:32.04,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ
Dialogue: 0,0:00:32.04,0:00:35.37,Caption,,0,0,0,,НАЧИНАЕТСЯ СОВСЕМ ЗАНЯТНАЯ АРИФМЕТИКА. УКРАИНА РИСКУЕТ
Dialogue: 0,0:00:35.37,0:00:38.26,Caption,,0,0,0,,СТОЛКНУТЬСЯ С КРИТИЧЕСКОЙ НЕХВАТКОЙ ЛЮДЕЙ УЖЕ К
Dialogue: 0,0:00:38.26,0:00:41.45,Caption,,0,0,0,,НОЯБРЮ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА. ЭТО ХУДШИЙ ИЗ
Dialogue: 0,0:00:41.45,0:00:44.36,Caption,,0,0,0,,РАССМОТРЕННЫХ СЦЕНАРИЕВ АНАЛИТИКОВ BNE INTELLINEWS,
Dialogue: 0,0:00:44.64,0:00:48.31,Caption,,0,0,0,,КОТОРЫЕ СОПОСТАВИЛИ ПОТЕРИ, ТЕМПЫ МОБИЛИЗАЦИИ И МАСШТАБЫ
Dialogue: 0,0:00:48.31,0:00:52.63,Caption,,0,0,0,,ДЕЗЕРТИРСТВА. ПО ИХ РАСЧЁТАМ, ЕЖЕМЕСЯЧНЫЕ ПОТЕРИ УБИТЫМИ СОСТАВЛЯЮТ
Dialogue: 0,0:00:52.63,0:00:55.61,Caption,,0,0,0,,ОТ ТРЁХ ДО ДЕВЯТИ ТЫСЯЧ ЧЕЛОВЕК. ЕЩЁ ОТ ШЕСТИ С
Dialogue: 0,0:00:55.61,0:00:58.30,Caption,,0,0,0,,ПОЛОВИНОЙ ДО ПЯТНАДЦАТИ ТЫСЯЧ ВОЕННОСЛУЖАЩИХ
Dialogue: 0,0:00:58.30,0:01:01.29,Caption,,0,0,0,,ЕЖЕМЕСЯЧНО ПОКИДАЮТ ПОДРАЗДЕЛЕНИЯ БЕЗ РАЗРЕШЕНИЯ.
Dialogue: 0,0:01:01.29,0:01:04.28,Caption,,0,0,0,,И ЭТО ТОЛЬКО АРМИЯ. ПАРАЛЛЕЛЬНО ИДЁТ ЭМИГРАЦИЯ.
Dialogue: 0,0:01:04.28,0:01:06.76,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО РАБОТАЕТ ДЕМОГРАФИЧЕСКАЯ ЯМА.
Dialogue: 0,0:01:09.03,0:01:10.87,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО УМЕНЬШАЕТСЯ КОЛИЧЕСТВО
Dialogue: 0,0:01:10.87,0:01:13.12,Caption,,0,0,0,,ЛЮДЕЙ, КОТОРЫХ ВООБЩЕ МОЖНО ПОСТАВИТЬ ПОД
Dialogue: 0,0:01:13.12,0:01:15.84,Caption,,0,0,0,,РУЖЬЁ. ДОСТУПНЫЙ УКРАИНСКИЙ МОБИЛИЗАЦИОННЫЙ
Dialogue: 0,0:01:15.84,0:01:18.07,Caption,,0,0,0,,РЕЗЕРВ АНАЛИТИКИ ОЦЕНИВАЮТ ОЧЕНЬ ШИРОКО,
Dialogue: 0,0:01:18.31,0:01:20.61,Caption,,0,0,0,,ОТ ОДНОГО ДО ПЯТИ МИЛЛИОНОВ МУЖЧИН.
Dialogue: 0,0:01:20.61,0:01:23.12,Caption,,0,0,0,,РОССИЙСКИЙ РЕЗЕРВ МУЖЧИН ПРИЗЫВНОГО ВОЗРАСТА В
Dialogue: 0,0:01:23.12,0:01:25.71,Caption,,0,0,0,,ТЕХ ЖЕ РАСЧЁТАХ СОСТАВЛЯЕТ ОКОЛО ТРИДЦАТИ ТРЁХ
Dialogue: 0,0:01:25.71,0:01:29.03,Caption,,0,0,0,,МИЛЛИОНОВ. ТО ЕСТЬ ТУТ УЖЕ ВОПРОС НЕ В КРАСИВЫХ РЕЧАХ И
Dialogue: 0,0:01:29.03,0:01:31.12,Caption,,0,0,0,,НЕ В ОЧЕРЕДНОЙ ПРЕЗЕНТАЦИИ О БУДУЩЕМ
Dialogue: 0,0:01:31.12,0:01:34.21,Caption,,0,0,0,,УКРАИНЫ. ВОПРОС ПРОСТОЙ. ЛЮДЕЙ НЕТ. И ЕСЛИ ЭТА
Dialogue: 0,0:01:34.21,0:01:38.17,Caption,,0,0,0,,ТЕНДЕНЦИЯ ПРОДОЛЖАЕТСЯ, СКОРО ВОЕВАТЬ БУДЕТ НЕЧЕМ. А ПОТОМ УЖЕ
Dialogue: 0,0:01:38.17,0:01:41.41,Caption,,0,0,0,,И СПОРИТЬ БУДЕТ НЕ С КЕМ, КТО ТАМ ЧТО ДОЛЖЕН ОТВОЕВАТЬ И НА
Dialogue: 0,0:01:41.41,0:01:43.74,Caption,,0,0,0,,КАКИХ УСЛОВИЯХ. ПРИ ЭТОМ ПЕРЕД РЯДОВЫМ
Dialogue: 0,0:01:43.74,0:01:45.67,Caption,,0,0,0,,УКРАИНЦЕМ, КОТОРЫЙ СИДИТ В ОКОПЕ,
Dialogue: 0,0:01:45.91,0:01:48.24,Caption,,0,0,0,,ВСЁ ЕЩЁ ВИСИТ ТА САМАЯ МОРКОВКА.
Dialogue: 0,0:01:48.24,0:01:51.58,Caption,,0,0,0,,ЕВРОСОЮЗ. ВОТ ЕЩЁ НЕМНОГО. ВОТ ЕЩЁ ПОТЕРПЕТЬ. ВОТ
Dialogue: 0,0:01:51.58,0:01:54.81,Caption,,0,0,0,,ЕЩЁ ВЫПОЛНИТЬ УСЛОВИЯ. ВОТ ЕЩЁ ОДИН ПЕРЕГОВОРНЫЙ
Dialogue: 0,0:01:54.81,0:01:57.54,Caption,,0,0,0,,КЛАСТЕР. ВОТ ЕЩЁ ОДНА РЕФОРМА. И КОГДА НИБУДЬ
Dialogue: 0,0:01:57.54,0:02:00.72,Caption,,0,0,0,,ПРЕКРАСНЫЕ ДВЕРИ ЕВРОПЕЙСКОГО ДОМА ОТКРОЮТСЯ. ТОЛЬКО
Dialogue: 0,0:02:00.72,0:02:03.35,Caption,,0,0,0,,САМИ ЖИЛЬЦЫ ЭТОГО ДОМА ВЕДУТ СЕБЯ КАК ТО СТРАННО.
Dialogue: 0,0:02:03.91,0:02:05.76,Caption,,0,0,0,,ПОЛЬША ЕЩЁ ДО ВСТУПЛЕНИЯ УКРАИНЫ
Dialogue: 0,0:02:05.76,0:02:08.07,Caption,,0,0,0,,ДОБИЛАСЬ ОТ ЕВРОКОМИССИИ ИЗМЕНЕНИЯ УСЛОВИЙ
Dialogue: 0,0:02:08.07,0:02:11.37,Caption,,0,0,0,,ПЕРЕГОВОРОВ СРАЗУ ПО ДВУМ НАПРАВЛЕНИЯМ. СЕЛЬСКОЕ ХОЗЯЙСТВО
Dialogue: 0,0:02:11.37,0:02:14.31,Caption,,0,0,0,,И ТРАНСПОРТ. ВАРШАВА ХОЧЕТ ЗАЩИТИТЬ СОБСТВЕННЫХ
Dialogue: 0,0:02:14.31,0:02:16.83,Caption,,0,0,0,,ФЕРМЕРОВ И ПЕРЕВОЗЧИКОВ. ПРИЧЁМ РЕЧЬ НЕ О КАКИХ
Dialogue: 0,0:02:16.83,0:02:22.55,Caption,,0,0,0,,ТО АБСТРАКТНЫХ ПОЖЕЛАНИЯХ. ОБСУЖДАЮТСЯ ОГРАНИЧЕНИЯ НА ДОСТУП
Dialogue: 0,0:02:22.55,0:02:24.90,Caption,,0,0,0,,УКРАИНСКОГО ЗЕРНА, МЯСА ПТИЦЫ,
Dialogue: 0,0:02:25.06,0:02:27.25,Caption,,0,0,0,,ЯИЦ И САХАРА НА ЕВРОПЕЙСКИЙ РЫНОК.
Dialogue: 0,0:02:27.25,0:02:30.24,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ПРАВИЛА ПРЕДОСТАВЛЕНИЯ СУБСИДИЙ УКРАИНСКИМ
Dialogue: 0,0:02:30.24,0:02:32.77,Caption,,0,0,0,,АГРАРИЯМ. ПЕРЕХОДНЫЙ ПЕРИОД ДЛЯ КАБОТАЖНЫХ
Dialogue: 0,0:02:32.77,0:02:34.67,Caption,,0,0,0,,ПЕРЕВОЗОК, ТО ЕСТЬ ВНУТРЕННИХ ПЕРЕВОЗОК
Dialogue: 0,0:02:34.67,0:02:37.23,Caption,,0,0,0,,ИНОСТРАННЫМИ КОМПАНИЯМИ. ПОЛЬША УЖЕ СЧИТАЕТ
Dialogue: 0,0:02:37.23,0:02:40.34,Caption,,0,0,0,,ВНЕСЁННЫЕ ИЗМЕНЕНИЯ СООТВЕТСТВУЮЩИМИ СВОИМ ТРЕБОВАНИЯМ,
Dialogue: 0,0:02:40.58,0:02:42.59,Caption,,0,0,0,,НО ВСЁ РАВНО ТРЕБУЕТ ДОПОЛНИТЕЛЬНЫХ
Dialogue: 0,0:02:42.59,0:02:44.46,Caption,,0,0,0,,ГАРАНТИЙ. И ФРАНЦИЯ ПО ЗАЩИТЕ СВОЕГО
Dialogue: 0,0:02:44.46,0:02:48.29,Caption,,0,0,0,,СЕЛЬСКОХОЗЯЙСТВЕННОГО РЫНКА ЗАНИМАЕТ ПОХОЖУЮ ПОЗИЦИЮ. ВОТ ТАКАЯ
Dialogue: 0,0:02:48.29,0:02:51.46,Caption,,0,0,0,,ПОЛУЧАЕТСЯ СЕМЕЙНАЯ ФОТОГРАФИЯ. УКРАИНЕ ГОВОРЯТ,
Dialogue: 0,0:02:51.62,0:02:53.98,Caption,,0,0,0,,ЧТО ЕЁ ЖДУТ В ЕВРОПЕЙСКОЙ СЕМЬЕ. НО
Dialogue: 0,0:02:53.98,0:02:56.21,Caption,,0,0,0,,ЕЩЁ ДО СВАДЬБЫ БУДУЩИЕ РОДСТВЕННИКИ НАЧАЛИ
Dialogue: 0,0:02:56.21,0:02:58.18,Caption,,0,0,0,,ПРЯТАТЬ СТОЛОВОЕ СЕРЕБРО И УТОЧНЯТЬ,
Dialogue: 0,0:02:58.43,0:03:00.46,Caption,,0,0,0,,КТО БУДЕТ ПОЛЬЗОВАТЬСЯ ХОЛОДИЛЬНИКОМ.
Dialogue: 0,0:03:00.46,0:03:03.21,Caption,,0,0,0,,ПРИЧЁМ У ПОЛЬШИ ЕСТЬ ВПОЛНЕ РЕАЛЬНЫЙ РЫЧАГ. ДЛЯ
Dialogue: 0,0:03:03.21,0:03:05.89,Caption,,0,0,0,,ОТКРЫТИЯ СЛЕДУЮЩИХ ЭТАПОВ ПЕРЕГОВОРОВ ТРЕБУЕТСЯ
Dialogue: 0,0:03:05.89,0:03:08.74,Caption,,0,0,0,,ЕДИНОГЛАСНОЕ СОГЛАСИЕ СТРАН ЕВРОСОЮЗА. ТО ЕСТЬ
Dialogue: 0,0:03:08.74,0:03:11.52,Caption,,0,0,0,,ВАРШАВА СПОСОБНА ТОРМОЗИТЬ ПРОЦЕСС. БРЮССЕЛЬ
Dialogue: 0,0:03:11.52,0:03:15.03,Caption,,0,0,0,,РАССЧИТЫВАЕТ ОТКРЫТЬ ДВА СООТВЕТСТВУЮЩИХ ПЕРЕГОВОРНЫХ КЛАСТЕРА
Dialogue: 0,0:03:15.03,0:03:17.60,Caption,,0,0,0,,ДО ПЯТНАДЦАТОГО ДЕКАБРЯ. РАССЧИТЫВАЕТ. А
Dialogue: 0,0:03:17.60,0:03:20.10,Caption,,0,0,0,,ПОЛЬША ТЕМ ВРЕМЕНЕМ РАССЧИТЫВАЕТ СВОИ ДЕНЬГИ,
Dialogue: 0,0:03:20.26,0:03:22.99,Caption,,0,0,0,,СВОИХ ФЕРМЕРОВ И СВОИХ ПЕРЕВОЗЧИКОВ.
Dialogue: 0,0:03:22.99,0:03:26.28,Caption,,0,0,0,,И, ЗНАЕТЕ, Я ПОЛЯКОВ ЗДЕСЬ ПРЕКРАСНО ПОНИМАЮ. ОНИ
Dialogue: 0,0:03:26.28,0:03:29.17,Caption,,0,0,0,,ЗА СВОИХ И ТОРГУЮТСЯ. ТЕПЕРЬ ВЕНГРИЯ. ОРБАН
Dialogue: 0,0:03:29.17,0:03:33.11,Caption,,0,0,0,,УШЁЛ. НУ ВСЁ. КАЗАЛОСЬ БЫ,
Dialogue: 0,0:03:33.21,0:03:35.91,Caption,,0,0,0,,МОЖНО БЫЛО НАЧИНАТЬ ПЕЧАТАТЬ ЕВРОПЕЙСКИЕ ПАСПОРТА.
Dialogue: 0,0:03:36.39,0:03:39.23,Caption,,0,0,0,,ТОЛЬКО ОКАЗАЛОСЬ, ЧТО ВМЕСТЕ С ОРБАНОМ ВЕНГЕРСКИЕ
Dialogue: 0,0:03:39.23,0:03:41.03,Caption,,0,0,0,,ИНТЕРЕСЫ ПОЧЕМУ ТО НИКУДА НЕ УШЛИ.
Dialogue: 0,0:03:41.75,0:03:43.60,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СОГЛАСИЛСЯ РАСШИРИТЬ
Dialogue: 0,0:03:43.60,0:03:46.26,Caption,,0,0,0,,ЯЗЫКОВЫЕ, ОБРАЗОВАТЕЛЬНЫЕ И КУЛЬТУРНЫЕ ПРАВА
Dialogue: 0,0:03:46.26,0:03:48.42,Caption,,0,0,0,,ВЕНГЕРСКОГО МЕНЬШИНСТВА. СОГЛАСИЛСЯ НА
Dialogue: 0,0:03:48.42,0:03:51.26,Caption,,0,0,0,,ИСПОЛЬЗОВАНИЕ НАЦИОНАЛЬНОЙ СИМВОЛИКИ. СОГЛАСИЛСЯ
Dialogue: 0,0:03:51.26,0:03:53.74,Caption,,0,0,0,,ПРИЗНАТЬ ДЕПОРТАЦИЮ ВЕНГРОВ НА ПРИНУДИТЕЛЬНЫЕ
Dialogue: 0,0:03:53.74,0:03:55.88,Caption,,0,0,0,,РАБОТЫ ПРЕСТУПЛЕНИЕМ. ПЛЮС ВЕНГЕРСКИЕ
Dialogue: 0,0:03:55.88,0:03:58.28,Caption,,0,0,0,,КОМПАНИИ ДОЛЖНЫ ПОЛУЧИТЬ РАСШИРЕННЫЙ ДОСТУП К
Dialogue: 0,0:03:58.28,0:04:00.89,Caption,,0,0,0,,УКРАИНСКИМ ГАЗОХРАНИЛИЩАМ. НОРМАЛЬНЫЙ ТАКОЙ
Dialogue: 0,0:04:00.89,0:04:03.27,Caption,,0,0,0,,НАБОР. ПОСЛЕ ЭТОГО ПЕТЕР МАДЬЯР ЗАЯВИЛ,
Dialogue: 0,0:04:03.46,0:04:05.54,Caption,,0,0,0,,ЧТО УСКОРЕННОГО ВСТУПЛЕНИЯ УКРАИНЫ В
Dialogue: 0,0:04:05.54,0:04:07.91,Caption,,0,0,0,,ЕВРОСОЮЗ ВСЁ РАВНО НЕ БУДЕТ. ЧЛЕНСТВО,
Dialogue: 0,0:04:07.99,0:04:10.94,Caption,,0,0,0,,ГОВОРИТ, НАДО ЗАСЛУЖИТЬ. ТО ЕСТЬ КИЕВ УСТУПКИ
Dialogue: 0,0:04:10.94,0:04:14.31,Caption,,0,0,0,,УЖЕ ПОЛОЖИЛ НА СТОЛ, А БИЛЕТ В ЕВРОСОЮЗ ЕМУ В ОТВЕТ НЕ
Dialogue: 0,0:04:14.31,0:04:17.59,Caption,,0,0,0,,ПОЛОЖИЛИ. И ВОТ ПОСЛЕ ПОЛЬШИ, ПОСЛЕ ВЕНГРИИ,
Dialogue: 0,0:04:17.75,0:04:20.79,Caption,,0,0,0,,ПОСЛЕ ВСЕХ ЭТИХ УСЛОВИЙ ВЫВОД ПОЛУЧАЕТСЯ ЖЁСТКИЙ. НЕ
Dialogue: 0,0:04:20.79,0:04:23.75,Caption,,0,0,0,,СОБИРАЛИСЬ, НЕ СОБИРАЮТСЯ. ПО КРАЙНЕЙ МЕРЕ,
Dialogue: 0,0:04:23.91,0:04:25.94,Caption,,0,0,0,,РЕАЛЬНЫЕ ДЕЙСТВИЯ ПОКА ОЧЕНЬ ПЛОХО
Dialogue: 0,0:04:25.94,0:04:28.33,Caption,,0,0,0,,ПОХОЖИ НА ПОДГОТОВКУ К БЫСТРОМУ ВСТУПЛЕНИЮ
Dialogue: 0,0:04:28.33,0:04:31.70,Caption,,0,0,0,,УКРАИНЫ В ЕВРОСОЮЗ. А МОРКОВКА ВСЁ РАВНО ВИСИТ ПЕРЕД НОСОМ
Dialogue: 0,0:04:31.70,0:04:34.17,Caption,,0,0,0,,У ТОГО САМОГО РЯДОВОГО УКРАИНЦА В ОКОПЕ.
Dialogue: 0,0:04:34.17,0:04:37.44,Caption,,0,0,0,,ТЫ ЕЩЁ ПОТЕРПИ. ТЫ ЕЩЁ ПОВОЮЙ. ТЫ ЕЩЁ ПОСИДИ
Dialogue: 0,0:04:37.44,0:04:41.67,Caption,,0,0,0,,БЕЗ СВЕТА. ТЫ ЕЩЁ ПОСМОТРИ, КАК РАСТУТ ТАРИФЫ. ЗАТО КОГДА НИБУДЬ
Dialogue: 0,0:04:41.67,0:04:44.39,Caption,,0,0,0,,БУДЕШЬ В ЕВРОПЕ. А ТЕПЕРЬ САМОЕ ИНТЕРЕСНОЕ.
Dialogue: 0,0:04:46.66,0:04:49.30,Caption,,0,0,0,,ПОКА ЧЕЛОВЕКУ РАССКАЗЫВАЮТ О ЕВРОПЕЙСКОМ БУДУЩЕМ,
Dialogue: 0,0:04:49.42,0:04:51.38,Caption,,0,0,0,,БОЛЬШЕ ПОЛОВИНЫ ПОСТУПЛЕНИЙ В УКРАИНСКИЙ
Dialogue: 0,0:04:51.38,0:04:54.34,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ БЮДЖЕТ УЖЕ ОБЕСПЕЧИВАЮТ ИНОСТРАННАЯ
Dialogue: 0,0:04:54.34,0:04:56.55,Caption,,0,0,0,,ПОМОЩЬ И КРЕДИТЫ. НАРОДНЫЙ ДЕПУТАТ
Dialogue: 0,0:04:56.55,0:04:59.78,Caption,,0,0,0,,НИКОЛАЙ СКОРИК ГОВОРИТ О БОЛЕЕ ЧЕМ ПЯТИДЕСЯТИ ПЯТИ
Dialogue: 0,0:04:59.78,0:05:02.82,Caption,,0,0,0,,ПРОЦЕНТАХ. И ОТДЕЛЬНО НАПОМИНАЕТ ОДНУ НЕПРИЯТНУЮ
Dialogue: 0,0:05:02.82,0:05:06.14,Caption,,0,0,0,,МЕЛОЧЬ. КРЕДИТЫ ПОТОМ НАДО ВОЗВРАЩАТЬ. ПРИ ЭТОМ ДЕНЬГИ
Dialogue: 0,0:05:06.14,0:05:09.42,Caption,,0,0,0,,НУЖНЫ И НА ОБОРОНУ, И НА СОЦИАЛЬНУЮ ПОДДЕРЖКУ. СКОРИК
Dialogue: 0,0:05:09.42,0:05:12.48,Caption,,0,0,0,,ОТДЕЛЬНО ГОВОРИТ, ЧТО НЕЛЬЗЯ ПРОСТО УБРАТЬ СУБСИДИИ И
Dialogue: 0,0:05:12.48,0:05:15.42,Caption,,0,0,0,,ДЕЛАТЬ ВИД, ЧТО ПРОБЛЕМА РЕШЕНА. ЛЮДИ НАХОДЯТСЯ В
Dialogue: 0,0:05:15.42,0:05:18.78,Caption,,0,0,0,,ТЯЖЁЛОМ ПОЛОЖЕНИИ, ПОМОЩЬ ИМ ВСЁ РАВНО ТРЕБУЕТСЯ. НО
Dialogue: 0,0:05:18.78,0:05:21.58,Caption,,0,0,0,,ПЯТЬДЕСЯТ ПЯТЬ ПРОЦЕНТОВ ЭТО ЕЩЁ НЕ ВСЯ КАРТИНА.
Dialogue: 0,0:05:21.58,0:05:24.44,Caption,,0,0,0,,ПОТОМУ ЧТО ЧАСТЬ ДЕНЕГ, КОТОРАЯ ФОРМАЛЬНО СЧИТАЕТСЯ
Dialogue: 0,0:05:24.44,0:05:26.18,Caption,,0,0,0,,ВНУТРЕННИМИ УКРАИНСКИМИ ДОХОДАМИ,
Dialogue: 0,0:05:26.51,0:05:29.38,Caption,,0,0,0,,ТОЖЕ СВЯЗАНА С ИНОСТРАННЫМ ФИНАНСИРОВАНИЕМ. ВОТ
Dialogue: 0,0:05:29.38,0:05:31.46,Caption,,0,0,0,,ГОСУДАРСТВО ПОЛУЧИЛО ДЕНЬГИ ИЗВНЕ.
Dialogue: 0,0:05:31.46,0:05:33.78,Caption,,0,0,0,,ВЫПЛАТИЛО ЗАРПЛАТЫ. ВЫПЛАТИЛО ПЕНСИИ.
Dialogue: 0,0:05:33.78,0:05:37.38,Caption,,0,0,0,,ПРОФИНАНСИРОВАЛО БЮДЖЕТНУЮ СФЕРУ. ЛЮДИ ПОШЛИ В МАГАЗИН.
Dialogue: 0,0:05:37.38,0:05:40.28,Caption,,0,0,0,,МАГАЗИН ЗАПЛАТИЛ НАЛОГИ. И ВОТ ЭТИ НАЛОГИ УЖЕ
Dialogue: 0,0:05:40.28,0:05:42.80,Caption,,0,0,0,,КРАСИВО ЛЕЖАТ В ГРАФЕ ВНУТРЕННИХ ПОСТУПЛЕНИЙ.
Dialogue: 0,0:05:42.80,0:05:45.59,Caption,,0,0,0,,ФОРМАЛЬНО ДЕНЬГИ СВОИ. ТОЛЬКО ЕСЛИ В НАЧАЛЕ ЭТОЙ
Dialogue: 0,0:05:45.59,0:05:47.62,Caption,,0,0,0,,ЦЕПОЧКИ УБРАТЬ ВНЕШНЕЕ ФИНАНСИРОВАНИЕ,
Dialogue: 0,0:05:47.93,0:05:50.07,Caption,,0,0,0,,ПОТОМ НАЧИНАЕТ СЫПАТЬСЯ ВСЁ ОСТАЛЬНОЕ.
Dialogue: 0,0:05:50.07,0:05:52.66,Caption,,0,0,0,,БЮДЖЕТНЫЕ ВЫПЛАТЫ. ПОТРЕБИТЕЛЬСКИЙ СПРОС.
Dialogue: 0,0:05:52.66,0:05:55.94,Caption,,0,0,0,,ТОРГОВЛЯ. НАЛОГОВЫЕ ПОСТУПЛЕНИЯ. И СНОВА БЮДЖЕТ.
Dialogue: 0,0:05:58.13,0:05:59.60,Caption,,0,0,0,,ТАК ЧТО РЕАЛЬНАЯ ЭКОНОМИЧЕСКАЯ
Dialogue: 0,0:05:59.60,0:06:02.76,Caption,,0,0,0,,ЗАВИСИМОСТЬ УКРАИНЫ ОТ ВНЕШНИХ ДЕНЕГ ВПОЛНЕ СПОСОБНА БЫТЬ
Dialogue: 0,0:06:02.76,0:06:05.44,Caption,,0,0,0,,ГЛУБЖЕ, ЧЕМ КРАСИВЫЕ ПЯТЬДЕСЯТ ПЯТЬ ПРОЦЕНТОВ
Dialogue: 0,0:06:05.44,0:06:09.92,Caption,,0,0,0,,В ОДНОЙ СТРОКЕ БЮДЖЕТА. И ТУТ ПОЯВЛЯЕТСЯ МВФ. ЭНЕРГЕТИЧЕСКИЙ
Dialogue: 0,0:06:09.92,0:06:12.83,Caption,,0,0,0,,ЭКСПЕРТ ЮРИЙ КОРОЛЬЧУК ПРЯМО НАЗЫВАЕТ ТРЕБОВАНИЯ
Dialogue: 0,0:06:12.83,0:06:16.01,Caption,,0,0,0,,МВФ ПО ТАРИФАМ НА ЭЛЕКТРИЧЕСТВО И ГАЗ УЛЬТИМАТУМОМ.
Dialogue: 0,0:06:16.01,0:06:19.70,Caption,,0,0,0,,ПРИЧЁМ, ПО ЕГО СЛОВАМ, ПРОЦЕСС УЖЕ ИДЁТ. ПО ЭЛЕКТРОЭНЕРГИИ
Dialogue: 0,0:06:19.70,0:06:22.99,Caption,,0,0,0,,ЭТО ВИДНО. ПО ГАЗУ ПОКА СОХРАНЯЕТСЯ ЗАПАС ПРОЧНОСТИ
Dialogue: 0,0:06:22.99,0:06:25.05,Caption,,0,0,0,,И РЕЗЕРВ. И ВОТ ЗДЕСЬ ОСОБЕННО ИНТЕРЕСНО
Dialogue: 0,0:06:25.05,0:06:27.89,Caption,,0,0,0,,ПОСМОТРЕТЬ НЕ ТОЛЬКО НА ТАРИФ. КОРОЛЬЧУК ГОВОРИТ,
Dialogue: 0,0:06:28.05,0:06:29.91,Caption,,0,0,0,,ЧТО ЗАВИСИМОСТЬ УКРАИНЫ ЗАКЛЮЧАЕТСЯ
Dialogue: 0,0:06:29.91,0:06:33.35,Caption,,0,0,0,,ДАЖЕ НЕ ПРОСТО В ДЕНЬГАХ МВФ. МВФ ДАЁТ РЕКОМЕНДАЦИИ
Dialogue: 0,0:06:33.35,0:06:36.21,Caption,,0,0,0,,ДРУГИМ КРЕДИТОРАМ. ТО ЕСТЬ СХЕМА ЗНАЧИТЕЛЬНО
Dialogue: 0,0:06:36.21,0:06:38.62,Caption,,0,0,0,,ВЕСЕЛЕЕ. ТЫ МОЖЕШЬ НЕ БРАТЬ КОНКРЕТНУЮ КУПЮРУ
Dialogue: 0,0:06:38.62,0:06:41.09,Caption,,0,0,0,,НЕПОСРЕДСТВЕННО У МВФ. НО ОТ ТОГО,
Dialogue: 0,0:06:41.18,0:06:43.17,Caption,,0,0,0,,ВЫПОЛНИЛ ТЫ ЕГО УСЛОВИЯ ИЛИ НЕТ,
Dialogue: 0,0:06:43.44,0:06:46.00,Caption,,0,0,0,,ЗАВИСИТ, ЧТО СКАЖУТ ТЕБЕ ДРУГИЕ ЛЮДИ С
Dialogue: 0,0:06:46.00,0:06:49.05,Caption,,0,0,0,,ДЕНЬГАМИ. КОРОЛЬЧУК ПРИВОДИТ КОНКРЕТНЫЕ ПРИМЕРЫ. ОТ
Dialogue: 0,0:06:49.05,0:06:51.49,Caption,,0,0,0,,ПОВЫШЕНИЯ ТАРИФОВ НА ЭЛЕКТРОЭНЕРГИЮ И ГАЗ,
Dialogue: 0,0:06:51.65,0:06:55.32,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ЗАВИСИТ, ДАДУТ ЛИ ДАЛЬШЕ СУЩЕСТВОВАТЬ ТОЙ ЖЕ
Dialogue: 0,0:06:55.32,0:06:58.54,Caption,,0,0,0,,"УКРЗАЛІЗНИЦІ", ИЛИ ЕЁ ОТПРАВЯТ К БАНКРОТСТВУ. ТО ЖЕ
Dialogue: 0,0:06:58.54,0:07:01.17,Caption,,0,0,0,,КАСАЕТСЯ "УКРЭНЕРГО". И ЗДЕСЬ ВСПЛЫВАЕТ ЕЩЁ
Dialogue: 0,0:07:01.17,0:07:04.70,Caption,,0,0,0,,ОДНА НЕПРИЯТНАЯ ИСТОРИЯ. СООБЩЕНИЯ О БУДУЩЕМ ПОВЫШЕНИИ
Dialogue: 0,0:07:04.70,0:07:06.86,Caption,,0,0,0,,ТАРИФОВ ХОДИЛИ ЕЩЁ С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:07:06.86,0:07:11.71,Caption,,0,0,0,,ПЯТОГО ГОДА. ЗЕЛЕНСКИЙ ТОГДА ПУБЛИЧНО ОПРОВЕРГАЛ
Dialogue: 0,0:07:11.71,0:07:14.70,Caption,,0,0,0,,ПОДОБНЫЕ СООБЩЕНИЯ И ОБРАЩАЛСЯ К УКРАИНЦАМ. ПРИ
Dialogue: 0,0:07:14.70,0:07:16.56,Caption,,0,0,0,,ЭТОМ ВОПРОС ПОВЫШЕНИЯ ТАРИФОВ,
Dialogue: 0,0:07:16.67,0:07:20.22,Caption,,0,0,0,,ПО ТЕМ ЖЕ СООБЩЕНИЯМ, ПРЕДПОЛАГАЛОСЬ РЕШИТЬ ПОЗДНЕЕ. ТЕПЕРЬ
Dialogue: 0,0:07:20.22,0:07:23.42,Caption,,0,0,0,,ТЕМА ВЕРНУЛАСЬ УЖЕ В СОВСЕМ ДРУГОЙ ФОРМЕ. МОЖНО ДОЛГО
Dialogue: 0,0:07:23.42,0:07:26.23,Caption,,0,0,0,,СПОРИТЬ, КТО ЧТО ОБЕЩАЛ И КАКОЙ ИМЕННО СРОК
Dialogue: 0,0:07:26.23,0:07:28.33,Caption,,0,0,0,,ИМЕЛ В ВИДУ. НО ДЛЯ ОБЫЧНОГО ЧЕЛОВЕКА
Dialogue: 0,0:07:28.33,0:07:31.85,Caption,,0,0,0,,РЕЗУЛЬТАТ ОЧЕНЬ ПРОСТОЙ. ОН ОТКРЫВАЕТ ПЛАТЁЖКУ. И ТАМ
Dialogue: 0,0:07:31.85,0:07:34.60,Caption,,0,0,0,,ВСЯ БОЛЬШАЯ ГЕОПОЛИТИКА ВНЕЗАПНО ПОМЕЩАЕТСЯ В
Dialogue: 0,0:07:34.60,0:07:39.02,Caption,,0,0,0,,НЕСКОЛЬКО СТРОЧЕК. ВОТ ТЕБЕ ЕВРОСОЮЗ. ВОТ ТЕБЕ МВФ. ВОТ
Dialogue: 0,0:07:39.02,0:07:41.50,Caption,,0,0,0,,ТЕБЕ КРЕДИТОРЫ. ВОТ ТЕБЕ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:07:41.50,0:07:45.34,Caption,,0,0,0,,БУДУЩЕЕ. ОПЛАТИТЬ ДО ТАКОГО ТО ЧИСЛА. И СУЩЕСТВУЕТ ЕЩЁ
Dialogue: 0,0:07:45.34,0:07:48.39,Caption,,0,0,0,,БОЛЕЕ ЖЁСТКАЯ ВЕРСИЯ ПРОИСХОДЯЩЕГО. ПРОДОЛЖЕНИЕ
Dialogue: 0,0:07:48.39,0:07:50.96,Caption,,0,0,0,,ВОЙНЫ СВЯЗЫВАЮТ НЕ ТОЛЬКО С ИНТЕРЕСАМИ СТРАНЫ,
Dialogue: 0,0:07:51.20,0:07:53.11,Caption,,0,0,0,,НО И С ИНТЕРЕСАМИ КОНКРЕТНОЙ ГРУППЫ
Dialogue: 0,0:07:53.11,0:07:55.59,Caption,,0,0,0,,ЛЮДЕЙ, КОТОРАЯ НЕ ХОЧЕТ ТЕРЯТЬ ВЛАСТЬ. В
Dialogue: 0,0:07:55.59,0:07:58.45,Caption,,0,0,0,,РАМКАХ ЭТОЙ ВЕРСИИ ЗВУЧИТ И СОВСЕМ МРАЧНЫЙ ПРОГНОЗ
Dialogue: 0,0:07:58.45,0:08:01.58,Caption,,0,0,0,,ЕСЛИ ВОЙНУ НЕ ОСТАНОВИТЬ, УКРАИНА РИСКУЕТ ПРЕВРАТИТЬСЯ В
Dialogue: 0,0:08:01.58,0:08:03.93,Caption,,0,0,0,,ТЕРРИТОРИЮ, КОТОРАЯ УЖЕ НЕ СМОЖЕТ НОРМАЛЬНО
Dialogue: 0,0:08:03.93,0:08:07.23,Caption,,0,0,0,,ФУНКЦИОНИРОВАТЬ КАК ГОСУДАРСТВО. ЭТО ИМЕННО ПОЛИТИЧЕСКАЯ
Dialogue: 0,0:08:07.23,0:08:10.34,Caption,,0,0,0,,ВЕРСИЯ И ПРОГНОЗ, А НЕ УСТАНОВЛЕННЫЙ ФАКТ. НО ОНА
Dialogue: 0,0:08:10.34,0:08:12.08,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ НЕ НА ПУСТОМ МЕСТЕ,
Dialogue: 0,0:08:12.31,0:08:14.45,Caption,,0,0,0,,КОГДА ГРАЖДАНАМ СНАЧАЛА ЧТО ТО ОБЕЩАЮТ
Dialogue: 0,0:08:14.45,0:08:16.56,Caption,,0,0,0,,ПУБЛИЧНО, ПОТОМ ПРОХОДЯТ МЕСЯЦЫ,
Dialogue: 0,0:08:16.80,0:08:18.73,Caption,,0,0,0,,А ЗАТЕМ ИМ ВЫКАТЫВАЮТ УЖЕ ГОТОВОЕ
Dialogue: 0,0:08:18.73,0:08:23.14,Caption,,0,0,0,,РЕШЕНИЕ. ЕСЛИ ВАМ БЛИЗОК ТАКОЙ ФОРМАТ,
Dialogue: 0,0:08:23.30,0:08:25.10,Caption,,0,0,0,,ГДЕ МЫ СМОТРИМ НЕ ТОЛЬКО НА ГРОМКИЕ
Dialogue: 0,0:08:25.10,0:08:28.26,Caption,,0,0,0,,ЗАЯВЛЕНИЯ, НО И НА ТО, КТО В ИТОГЕ ПЛАТИТ ПО СЧЁТУ,
Dialogue: 0,0:08:28.42,0:08:30.45,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ ДАЛЬШЕ КАК РАЗ
Dialogue: 0,0:08:30.45,0:08:33.90,Caption,,0,0,0,,НАЧИНАЕТСЯ РАЗГОВОР О СЧЁТЕ. СТО МИЛЛИАРДОВ ЕВРО
Dialogue: 0,0:08:33.90,0:08:36.74,Caption,,0,0,0,,УКРАИНЕ. СТО МИЛЛИАРДОВ. ВОТ СКАЖИТЕ ЧЕСТНО,
Dialogue: 0,0:08:36.98,0:08:38.60,Caption,,0,0,0,,ОБЫЧНЫЙ ЧЕЛОВЕК ВООБЩЕ СПОСОБЕН
Dialogue: 0,0:08:38.60,0:08:42.54,Caption,,0,0,0,,ПРЕДСТАВИТЬ, СКОЛЬКО ЭТО? ДЕСЯТЬ ТЫСЯЧ ЕВРО ОН ПОНИМАЕТ. СТО
Dialogue: 0,0:08:42.54,0:08:45.19,Caption,,0,0,0,,ТЫСЯЧ ЕЩЁ СПОСОБЕН КАК ТО УЛОЖИТЬ В ГОЛОВЕ. КТО
Dialogue: 0,0:08:45.19,0:08:47.95,Caption,,0,0,0,,ТО КВАРТИРУ ВИДЕЛ ЗА ТАКИЕ ДЕНЬГИ. КТО ТО
Dialogue: 0,0:08:47.95,0:08:50.96,Caption,,0,0,0,,ИПОТЕКУ. КТО ТО ХОТЯ БЫ ОБЪЯВЛЕНИЕ ОТКРЫВАЛ. А
Dialogue: 0,0:08:50.96,0:08:53.22,Caption,,0,0,0,,СТО МИЛЛИАРДОВ ЭТО УЖЕ ГДЕ ТО ТАМ. ЗА
Dialogue: 0,0:08:53.22,0:08:55.14,Caption,,0,0,0,,ОБЛАКАМИ. ЭТО УЖЕ КАК В МУЛЬТФИЛЬМЕ,
Dialogue: 0,0:08:55.36,0:08:57.56,Caption,,0,0,0,,ГДЕ УДАВА ИЗМЕРЯЛИ В ПОПУГАЯХ. ТУТ
Dialogue: 0,0:08:57.56,0:09:00.42,Caption,,0,0,0,,ТОЖЕ ХОЧЕТСЯ СПРОСИТЬ, СКОЛЬКО ЭТО В ПОПУГАЯХ,
Dialogue: 0,0:09:00.66,0:09:02.44,Caption,,0,0,0,,ПОТОМУ ЧТО В ЕВРО ОБЫЧНЫЙ МОЗГ УЖЕ
Dialogue: 0,0:09:02.44,0:09:04.83,Caption,,0,0,0,,ОТКАЗЫВАЕТСЯ СЧИТАТЬ. И ВОТ ИМЕННО ПОЭТОМУ
Dialogue: 0,0:09:04.83,0:09:08.24,Caption,,0,0,0,,ОГРОМНЫМИ СУММАМИ ТАК УДОБНО ОПЕРИРОВАТЬ. КОГДА ЕВРОПЕЙЦУ
Dialogue: 0,0:09:08.24,0:09:11.30,Caption,,0,0,0,,ГОВОРЯТ ЕВРОСОЮЗ ВЫДЕЛИТ УКРАИНЕ СТО МИЛЛИАРДОВ ЕВРО,
Dialogue: 0,0:09:11.54,0:09:13.76,Caption,,0,0,0,,ЗВУЧИТ ПОЧТИ БЛАГОРОДНО. БОЛЬШОЙ
Dialogue: 0,0:09:13.76,0:09:16.93,Caption,,0,0,0,,КРАСИВЫЙ СОЮЗ ПОМОГАЕТ СТРАНЕ. А ТЕПЕРЬ СКАЖИТЕ
Dialogue: 0,0:09:16.93,0:09:20.75,Caption,,0,0,0,,ИНАЧЕ. МЫ ЗАБЕРЁМ ЭТИ ДЕНЬГИ У ВАС И ОТДАДИМ УКРАИНЕ.
Dialogue: 0,0:09:20.75,0:09:22.42,Caption,,0,0,0,,ВОТ ТУТ РАЗГОВОР УЖЕ СТАНОВИТСЯ
Dialogue: 0,0:09:22.42,0:09:25.93,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО ПОНЯТНЕЕ. ПРЕМЬЕР ЧЕХИИ АНДРЕЙ БАБИШ КАК РАЗ И
Dialogue: 0,0:09:25.93,0:09:28.63,Caption,,0,0,0,,ПОДНЯЛ ВОПРОС ОБЩЕГО ЕВРОПЕЙСКОГО БЮДЖЕТА. ОН
Dialogue: 0,0:09:28.63,0:09:31.72,Caption,,0,0,0,,НАЗВАЛ НОВЫЙ ПРОЕКТ СЕМИЛЕТНЕГО БЮДЖЕТА ЕВРОСОЮЗА
Dialogue: 0,0:09:31.72,0:09:35.98,Caption,,0,0,0,,НЕПРИЕМЛЕМЫМ ДЛЯ ПРАГИ. ЧЕХИЯ,
Dialogue: 0,0:09:36.05,0:09:38.93,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ДОЛЖНА УВЕЛИЧИВАТЬ СВОИ ВЗНОСЫ,
Dialogue: 0,0:09:39.09,0:09:40.70,Caption,,0,0,0,,А ПОЛУЧАТЬ ПРИ ЭТОМ ВСЁ МЕНЬШЕ.
Dialogue: 0,0:09:41.25,0:09:43.11,Caption,,0,0,0,,ПЛЮС БАБИШ ПРОШЁЛСЯ ПО РАСХОДАМ НА
Dialogue: 0,0:09:43.11,0:09:45.76,Caption,,0,0,0,,СОДЕРЖАНИЕ ЕВРОПЕЙСКИХ ИНСТИТУТОВ. И ОТДЕЛЬНО
Dialogue: 0,0:09:45.76,0:09:48.83,Caption,,0,0,0,,ВЫСТУПИЛ ПРОТИВ ИДЕИ ВЫДЕЛИТЬ УКРАИНЕ СТО МИЛЛИАРДОВ
Dialogue: 0,0:09:48.83,0:09:51.89,Caption,,0,0,0,,ЕВРО ИМЕННО ИЗ ОБЩЕГО БЮДЖЕТА ЕВРОСОЮЗА. УКРАИНЕ
Dialogue: 0,0:09:51.89,0:09:55.82,Caption,,0,0,0,,НУЖНЫ ДЕНЬГИ? ПОЖАЛУЙСТА. НО, ПО ПОЗИЦИИ БАБИША,
Dialogue: 0,0:09:56.05,0:09:58.29,Caption,,0,0,0,,НЕ ИЗ ОБЩЕГО ЕВРОПЕЙСКОГО КОШЕЛЬКА.
Dialogue: 0,0:09:58.29,0:10:01.40,Caption,,0,0,0,,ВОТ ЗДЕСЬ МАГИЯ ОГРОМНЫХ ЦИФР БЫСТРО ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:10:01.40,0:10:03.60,Caption,,0,0,0,,ПОКА СТО МИЛЛИАРДОВ СУЩЕСТВУЮТ ГДЕ ТО В
Dialogue: 0,0:10:03.60,0:10:06.62,Caption,,0,0,0,,ВОЗДУХЕ, ВСЕ ДОБРЫЕ. КАК ТОЛЬКО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:10:06.72,0:10:08.86,Caption,,0,0,0,,ИЗ ЧЬЕГО КАРМАНА ОНИ ДОЛЖНЫ ПОЯВИТЬСЯ,
Dialogue: 0,0:10:09.10,0:10:10.96,Caption,,0,0,0,,СЕРДОБОЛЬНОСТЬ НАЧИНАЕТ ТРЕБОВАТЬ
Dialogue: 0,0:10:10.96,0:10:13.85,Caption,,0,0,0,,КАЛЬКУЛЯТОР. И ВОТ ПОСЛЕ ЭТОГО УЖЕ МОЖНО ПОГОВОРИТЬ О ЛЕ
Dialogue: 0,0:10:13.85,0:10:16.35,Caption,,0,0,0,,ПЕН. ТОЛЬКО СПОКОЙНО. ПОТОМУ ЧТО ОНА ЕЩЁ НЕ
Dialogue: 0,0:10:16.35,0:10:18.98,Caption,,0,0,0,,ПРЕЗИДЕНТ ФРАНЦИИ. ПУСКАЙ СНАЧАЛА ПОБЕДИТ. ТОГДА
Dialogue: 0,0:10:18.98,0:10:22.03,Caption,,0,0,0,,И ПОСМОТРИМ. А ТО ВОКРУГ БУДУЩИХ ВЫБОРОВ УЖЕ УСПЕЛИ
Dialogue: 0,0:10:22.03,0:10:24.95,Caption,,0,0,0,,ПОСТРОИТЬ ЦЕЛЫЙ ДВОРЕЦ НАДЕЖД. ЛЕ ПЕН ЗАЯВЛЯЕТ
Dialogue: 0,0:10:24.95,0:10:27.96,Caption,,0,0,0,,КАТЕГОРИЧЕСКИ, ЧТО УКРАИНА НЕ ДОЛЖНА ВСТУПАТЬ В
Dialogue: 0,0:10:27.96,0:10:30.46,Caption,,0,0,0,,ЕВРОСОЮЗ И ЧТО ЕЁ БУДУЩЕЕ, ПО ЕЁ СЛОВАМ,
Dialogue: 0,0:10:30.70,0:10:32.97,Caption,,0,0,0,,НЕ ПРЕДПОЛАГАЕТ ЧЛЕНСТВА В ЕС. ЕЁ
Dialogue: 0,0:10:32.97,0:10:35.34,Caption,,0,0,0,,ПАРТИЯ УЖЕ ПОТРЕБОВАЛА ОБЪЯСНИТЬ ФРАНЦУЗАМ,
Dialogue: 0,0:10:35.50,0:10:37.85,Caption,,0,0,0,,КАКАЯ ИМЕННО ДОЛЯ НОВОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:10:37.85,0:10:40.62,Caption,,0,0,0,,КРЕДИТА УКРАИНЕ ЛЯЖЕТ НА ФРАНЦИЮ. РЕЧЬ ИДЁТ О
Dialogue: 0,0:10:40.62,0:10:42.78,Caption,,0,0,0,,СУММЕ ДО СОРОКА ПЯТИ МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:10:45.06,0:10:48.66,Caption,,0,0,0,,И ОТДЕЛЬНО ОНИ ХОТЯТ ЗНАТЬ, КАКИЕ РАСХОДЫ ПРИДЁТСЯ СОКРАЩАТЬ,
Dialogue: 0,0:10:48.90,0:10:51.06,Caption,,0,0,0,,ЕСЛИ РОССИЯ НЕ ВЫПЛАТИТ РЕПАРАЦИИ И
Dialogue: 0,0:10:51.06,0:10:53.22,Caption,,0,0,0,,СРАБОТАЮТ ГАРАНТИИ БЮДЖЕТА ЕВРОСОЮЗА.
Dialogue: 0,0:10:53.84,0:10:55.64,Caption,,0,0,0,,ВОТ ЭТО УЖЕ ХОРОШИЙ ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:10:55.64,0:10:58.86,Caption,,0,0,0,,ВОПРОС. ПОТОМУ ЧТО СОРОК ПЯТЬ МИЛЛИАРДОВ ДЛЯ БАНКОВОЙ ЭТО
Dialogue: 0,0:10:58.86,0:11:01.20,Caption,,0,0,0,,ПОМОЩЬ. А ФРАНЦУЗСКОМУ ИЗБИРАТЕЛЮ МОЖНО ЗАДАТЬ
Dialogue: 0,0:11:01.20,0:11:03.46,Caption,,0,0,0,,ВОПРОС ИНАЧЕ. ПЕНСИЯ ИЛИ УКРАИНА?
Dialogue: 0,0:11:03.53,0:11:06.66,Caption,,0,0,0,,НАЛОГ ИЛИ УКРАИНА? ЗАРПЛАТА УЧИТЕЛЮ ИЛИ УКРАИНА?
Dialogue: 0,0:11:06.97,0:11:08.91,Caption,,0,0,0,,И ВСЯ ВЫСОКАЯ ГЕОПОЛИТИКА СРАЗУ
Dialogue: 0,0:11:08.91,0:11:10.90,Caption,,0,0,0,,СПУСКАЕТСЯ С ПЯТОГО ЭТАЖА НА ПЕРВЫЙ.
Dialogue: 0,0:11:11.46,0:11:14.39,Caption,,0,0,0,,ПО ДАННЫМ ОПРОСА, РАБОТОЙ МАКРОНА ДОВОЛЬНЫ ВСЕГО
Dialogue: 0,0:11:14.39,0:11:17.56,Caption,,0,0,0,,ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ ОПРОШЕННЫХ. НОЯБРЬСКИЙ ОПРОС
Dialogue: 0,0:11:17.56,0:11:20.36,Caption,,0,0,0,,TOLUNA HARRIS INTERACTIVE ПОКАЗЫВАЕТ ЛЕ ПЕН ВО
Dialogue: 0,0:11:20.36,0:11:23.33,Caption,,0,0,0,,ВТОРОМ ТУРЕ ПРОТИВ МЕЛАНШОНА С РЕЗУЛЬТАТОМ ШЕСТЬДЕСЯТ
Dialogue: 0,0:11:23.33,0:11:26.11,Caption,,0,0,0,,ПЯТЬ ПРОЦЕНТОВ ПРОТИВ ТРИДЦАТИ ПЯТИ. ЕСТЬ ДАЖЕ
Dialogue: 0,0:11:26.11,0:11:28.80,Caption,,0,0,0,,ПРОГНОЗ С ОЦЕНКОЙ ЕЁ ШАНСОВ НА ПОБЕДУ ПРИМЕРНО В
Dialogue: 0,0:11:28.80,0:11:32.58,Caption,,0,0,0,,ДЕВЯНОСТО ПРОЦЕНТОВ. НО ЭТО ПРОГНОЗ. НЕ РЕЗУЛЬТАТ ВЫБОРОВ.
Dialogue: 0,0:11:32.58,0:11:34.95,Caption,,0,0,0,,ПОЭТОМУ ДАВАЙТЕ БЕЗ ПРЕЖДЕВРЕМЕННОГО ВЫНОСА
Dialogue: 0,0:11:34.95,0:11:37.22,Caption,,0,0,0,,МЕБЕЛИ В ЕЛИСЕЙСКИЙ ДВОРЕЦ. ДОПУСТИМ,
Dialogue: 0,0:11:37.30,0:11:40.35,Caption,,0,0,0,,ПОБЕДИЛА ЛЕ ПЕН. И ЧТО? РОССИЙСКИЙ ФЛАГ ПОВЕСЯТ НА
Dialogue: 0,0:11:40.35,0:11:44.16,Caption,,0,0,0,,ПРЕЗИДЕНТСКИЙ ДВОРЕЦ? ПРЕЗИДЕНТЫ МЕНЯЮТСЯ. ФАМИЛИИ МЕНЯЮТСЯ.
Dialogue: 0,0:11:44.16,0:11:47.98,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА МЕНЯЮТСЯ. А КУРС ОСТАЁТСЯ ПРЕЖНИМ.
Dialogue: 0,0:11:47.98,0:11:50.58,Caption,,0,0,0,,КУРС АНТИРОССИЙСКИЙ. И РАССЧИТЫВАТЬ,
Dialogue: 0,0:11:50.76,0:11:52.99,Caption,,0,0,0,,ЧТО ОДНА НОВАЯ ФАМИЛИЯ АВТОМАТИЧЕСКИ
Dialogue: 0,0:11:52.99,0:11:55.22,Caption,,0,0,0,,ПЕРЕВЕРНЁТ ВСЮ ФРАНЦУЗСКУЮ ПОЛИТИКУ,
Dialogue: 0,0:11:55.36,0:12:00.54,Caption,,0,0,0,,ДОВОЛЬНО НАИВНО. ТЕМ БОЛЕЕ САМА ЛЕ ПЕН УКРАИНСКОМУ
Dialogue: 0,0:12:00.54,0:12:03.52,Caption,,0,0,0,,ПОСЛУ УЖЕ ОБОЗНАЧИЛА ДОВОЛЬНО ПОНЯТНУЮ ГРАНИЦУ.
Dialogue: 0,0:12:03.52,0:12:06.69,Caption,,0,0,0,,СУЩЕСТВУЮЩИЕ ОБЯЗАТЕЛЬСТВА ФРАНЦИЯ ВЫПОЛНИТ. НОВЫХ
Dialogue: 0,0:12:06.69,0:12:08.94,Caption,,0,0,0,,ФИНАНСОВЫХ ПАКЕТОВ ПРИ ЕЁ ПРЕЗИДЕНТСТВЕ,
Dialogue: 0,0:12:09.02,0:12:12.13,Caption,,0,0,0,,ПО ЕЁ СЛОВАМ, ЖДАТЬ НЕ СТОИТ. ТО ЕСТЬ ДАЖЕ ЗДЕСЬ
Dialogue: 0,0:12:12.13,0:12:14.11,Caption,,0,0,0,,РЕЧЬ НЕ О КАКОЙ ТО СКАЗОЧНОЙ ДРУЖБЕ С
Dialogue: 0,0:12:14.11,0:12:16.77,Caption,,0,0,0,,МОСКВОЙ. РЕЧЬ О ДЕНЬГАХ И ФРАНЦУЗСКИХ
Dialogue: 0,0:12:16.77,0:12:20.59,Caption,,0,0,0,,ИНТЕРЕСАХ. И ИМЕННО ЗДЕСЬ ПОЯВЛЯЕТСЯ КУДА БОЛЕЕ ИНТЕРЕСНАЯ
Dialogue: 0,0:12:20.59,0:12:22.69,Caption,,0,0,0,,ЦИФРА. ДЛЯ ПЯТИДЕСЯТИ ДЕВЯТИ ПРОЦЕНТОВ
Dialogue: 0,0:12:22.69,0:12:25.92,Caption,,0,0,0,,ФРАНЦУЗСКИХ ИЗБИРАТЕЛЕЙ СРЕДИ ГЛАВНЫХ МОТИВОВ ГОЛОСОВАНИЯ
Dialogue: 0,0:12:25.92,0:12:28.51,Caption,,0,0,0,,ВАЖНА ПОКУПАТЕЛЬНАЯ СПОСОБНОСТЬ. МИГРАЦИЯ
Dialogue: 0,0:12:28.51,0:12:31.22,Caption,,0,0,0,,ВАЖНА ДЛЯ ТРИДЦАТИ ШЕСТИ ПРОЦЕНТОВ. ВОЙНА НА
Dialogue: 0,0:12:31.22,0:12:34.30,Caption,,0,0,0,,УКРАИНЕ ДЛЯ ДВЕНАДЦАТИ ПРОЦЕНТОВ. ВОТ ЛЕ ПЕН И
Dialogue: 0,0:12:34.30,0:12:36.38,Caption,,0,0,0,,СВЯЗЫВАЕТ УКРАИНСКИЕ РАСХОДЫ С ТЕМ,
Dialogue: 0,0:12:36.53,0:12:38.72,Caption,,0,0,0,,ЧТО РЕАЛЬНО БОЛИТ У ЧЕЛОВЕКА ДОМА. НЕ
Dialogue: 0,0:12:38.72,0:12:40.79,Caption,,0,0,0,,С ТАНКАМИ. НЕ С ГЕОПОЛИТИЧЕСКИМИ
Dialogue: 0,0:12:40.79,0:12:43.62,Caption,,0,0,0,,ДОКТРИНАМИ. С КОШЕЛЬКОМ. И ЭТО ДЛЯ ЕВРОПЕЙСКИХ
Dialogue: 0,0:12:43.62,0:12:47.08,Caption,,0,0,0,,ВЛАСТЕЙ ЗНАЧИТЕЛЬНО ОПАСНЕЕ. УКРАИНСКОМУ ВОПРОСУ ВООБЩЕ НЕ
Dialogue: 0,0:12:47.08,0:12:49.49,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО СТАТЬ ГЛАВНЫМ ВОПРОСОМ ФРАНЦУЗСКИХ
Dialogue: 0,0:12:49.49,0:12:52.06,Caption,,0,0,0,,ВЫБОРОВ. ДОСТАТОЧНО ПРИКЛЕИТЬ ЕГО К ЦЕНАМ,
Dialogue: 0,0:12:52.14,0:12:54.72,Caption,,0,0,0,,НАЛОГАМ И ПЕНСИЯМ. И ТОГДА ЛЮБОЙ НОВЫЙ
Dialogue: 0,0:12:54.72,0:12:56.88,Caption,,0,0,0,,МИЛЛИАРД ПРЕВРАЩАЕТСЯ ВО ВНУТРЕННИЙ
Dialogue: 0,0:12:56.88,0:13:00.41,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ АРГУМЕНТ. В ГЕРМАНИИ ЛОГИКА ПОХОЖАЯ. СОГЛАСНО
Dialogue: 0,0:13:00.41,0:13:03.92,Caption,,0,0,0,,ПРИВОДИМЫМ ОЦЕНКАМ, СЕЙЧАС СОРОК ДЕВЯТЬ ПРОЦЕНТОВ НЕМЦЕВ
Dialogue: 0,0:13:03.92,0:13:06.95,Caption,,0,0,0,,ВЫСТУПАЮТ ЗА СОКРАЩЕНИЕ ЛИБО ПРЕКРАЩЕНИЕ ПОМОЩИ
Dialogue: 0,0:13:06.95,0:13:11.63,Caption,,0,0,0,,УКРАИНЕ. СОВЕТ ЭКОНОМИЧЕСКИХ ЭКСПЕРТОВ ЖДЁТ
Dialogue: 0,0:13:11.63,0:13:14.47,Caption,,0,0,0,,ЗАМЕДЛЕНИЯ РОСТА НЕМЕЦКОЙ ЭКОНОМИКИ ДО ОДНОГО ПРОЦЕНТА
Dialogue: 0,0:13:14.47,0:13:17.14,Caption,,0,0,0,,В СЛЕДУЮЩЕМ ГОДУ. А ВЕСНОЙ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:13:17.14,0:13:19.30,Caption,,0,0,0,,СЕДЬМОГО ГОДА ПРОЙДУТ ЗЕМЕЛЬНЫЕ ВЫБОРЫ.
Dialogue: 0,0:13:19.86,0:13:21.96,Caption,,0,0,0,,ЕСЛИ ХДС И СОЦИАЛ ДЕМОКРАТЫ СНОВА
Dialogue: 0,0:13:21.96,0:13:25.29,Caption,,0,0,0,,ПОТЕРЯЮТ ГОЛОСА, ВНУТРИ КОАЛИЦИИ НАЧНЁТСЯ ПРОСТОЙ
Dialogue: 0,0:13:25.29,0:13:28.33,Caption,,0,0,0,,РАЗГОВОР. КТО ВИНОВАТ И КОГО ПОРА МЕНЯТЬ. ПО ЭТОМУ
Dialogue: 0,0:13:28.33,0:13:32.05,Caption,,0,0,0,,ПОЛИТИЧЕСКОМУ ПРОГНОЗУ, КРИТИЧЕСКИМ ПЕРИОДОМ ДЛЯ МЕРЦА СТАНЕТ
Dialogue: 0,0:13:32.05,0:13:34.47,Caption,,0,0,0,,ЛЕТО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА. А ПРИ
Dialogue: 0,0:13:34.47,0:13:37.24,Caption,,0,0,0,,НЕБЛАГОПРИЯТНОМ РАЗВИТИИ СОБЫТИЙ НЫНЕШНЯЯ КОАЛИЦИЯ
Dialogue: 0,0:13:37.24,0:13:41.27,Caption,,0,0,0,,МОЖЕТ НЕ ДОЖИТЬ ДО КОНЦА ГОДА. ОПЯТЬ ЖЕ. ЭТО ПРОГНОЗ.
Dialogue: 0,0:13:41.27,0:13:43.56,Caption,,0,0,0,,МЕРЦ ПОКА КАНЦЛЕР. ЛЕ ПЕН ПОКА НЕ
Dialogue: 0,0:13:43.56,0:13:47.03,Caption,,0,0,0,,ПРЕЗИДЕНТ. ПОЭТОМУ СТАВИТЬ ВСЮ УКРАИНСКУЮ СТРАТЕГИЮ НА
Dialogue: 0,0:13:47.03,0:13:49.42,Caption,,0,0,0,,ТО, КТО КОГДА ВЫИГРАЕТ ВЫБОРЫ В ПАРИЖЕ ИЛИ
Dialogue: 0,0:13:49.42,0:13:53.34,Caption,,0,0,0,,ПОТЕРЯЕТ КРЕСЛО В БЕРЛИНЕ, ЗАНЯТИЕ ДОВОЛЬНО РИСКОВАННОЕ. ТЕМ
Dialogue: 0,0:13:53.34,0:13:56.23,Caption,,0,0,0,,БОЛЕЕ В ВАШИНГТОНЕ ПОХОЖАЯ ИСТОРИЯ. НА БАНКОВОЙ
Dialogue: 0,0:13:56.23,0:13:59.49,Caption,,0,0,0,,РАССЧИТЫВАЮТ НА УСПЕХ ДЕМОКРАТОВ НА ВЫБОРАХ В КОНГРЕСС.
Dialogue: 0,0:13:59.49,0:14:02.09,Caption,,0,0,0,,ТОЛЬКО ПОБЕДА ДЕМОКРАТОВ В КОНГРЕССЕ НЕ УБИРАЕТ
Dialogue: 0,0:14:02.09,0:14:05.42,Caption,,0,0,0,,ПРЕЗИДЕНТА ИЗ БЕЛОГО ДОМА. ПРАВО ВЕТО ОСТАЁТСЯ. ПО
Dialogue: 0,0:14:05.42,0:14:08.86,Caption,,0,0,0,,ДАННЫМ FINANCIAL TIMES, ДЕМОКРАТЫ ОБСУЖДАЮТ ВОЕННЫЙ ПАКЕТ
Dialogue: 0,0:14:08.86,0:14:11.92,Caption,,0,0,0,,УКРАИНЕ ПРИМЕРНО НА ПЯТНАДЦАТЬ МИЛЛИАРДОВ ДОЛЛАРОВ. НО
Dialogue: 0,0:14:11.92,0:14:14.83,Caption,,0,0,0,,ПЕРЕД ВЫБОРАМИ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА ИМ
Dialogue: 0,0:14:14.83,0:14:17.30,Caption,,0,0,0,,САМИМ ПРИДЁТСЯ ОБЪЯСНЯТЬ АМЕРИКАНЦАМ ЦЕНЫ,
Dialogue: 0,0:14:17.54,0:14:19.70,Caption,,0,0,0,,МЕДИЦИНСКИЕ СТРАХОВКИ И РАСХОДЫ СЕМЕЙ.
Dialogue: 0,0:14:21.98,0:14:23.62,Caption,,0,0,0,,А ПОСЛЕ ПОРАЖЕНИЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:14:23.62,0:14:25.93,Caption,,0,0,0,,ЧЕТВЁРТОГО ГОДА УРОК ТАМ ПОЛУЧИЛИ ДОВОЛЬНО
Dialogue: 0,0:14:25.93,0:14:28.22,Caption,,0,0,0,,НАГЛЯДНЫЙ. ПОЭТОМУ ВПОЛНЕ ЛОГИЧНА СХЕМА,
Dialogue: 0,0:14:28.46,0:14:30.37,Caption,,0,0,0,,ПРИ КОТОРОЙ УКРАИНЕ ДАДУТ ОТДЕЛЬНЫЙ
Dialogue: 0,0:14:30.37,0:14:33.11,Caption,,0,0,0,,ПАКЕТ, А ОСНОВНУЮ ФИНАНСОВУЮ НАГРУЗКУ СНОВА
Dialogue: 0,0:14:33.11,0:14:35.63,Caption,,0,0,0,,ОСТАВЯТ ЕВРОПЕ. И В ИТОГЕ МОЖЕТ ПОЛУЧИТЬСЯ
Dialogue: 0,0:14:35.63,0:14:39.05,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ. ВАШИНГТОН ДАЛ ОДИН ПАКЕТ.
Dialogue: 0,0:14:39.05,0:14:41.77,Caption,,0,0,0,,ПАРИЖ ВЫПОЛНИЛ ПОСЛЕДНЕЕ СТАРОЕ ОБЕЩАНИЕ. В
Dialogue: 0,0:14:41.77,0:14:44.42,Caption,,0,0,0,,БЕРЛИНЕ НАЧАЛАСЬ СВОЯ ПОЛИТИЧЕСКАЯ ДРАКА.
Dialogue: 0,0:14:44.42,0:14:47.88,Caption,,0,0,0,,ПОЛЬША ЗАЩИЩАЕТ ФЕРМЕРОВ. ВЕНГРИЯ ВЫБИВАЕТ УСТУПКИ.
Dialogue: 0,0:14:47.88,0:14:50.98,Caption,,0,0,0,,ЧЕХИЯ НЕ ХОЧЕТ ПЛАТИТЬ ИЗ ОБЩЕГО БЮДЖЕТА. МВФ
Dialogue: 0,0:14:50.98,0:14:54.49,Caption,,0,0,0,,ВЫСТАВЛЯЕТ УСЛОВИЯ. А УКРАИНЦУ В ОКОПЕ ВСЁ ЕЩЁ ПОКАЗЫВАЮТ
Dialogue: 0,0:14:54.49,0:14:57.82,Caption,,0,0,0,,МОРКОВКУ. ЕВРОСОЮЗ. ВОТ ТОЛЬКО ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:14:58.04,0:15:00.30,Caption,,0,0,0,,ЧТО ЧЕЛОВЕК НЕ ВЕЧНЫЙ РЕСУРС. ДЕНЬГИ
Dialogue: 0,0:15:00.30,0:15:04.33,Caption,,0,0,0,,МОЖНО НАПЕЧАТАТЬ, ЗАНЯТЬ, ПЕРЕКИНУТЬ ИЗ ОДНОЙ СТАТЬИ БЮДЖЕТА В
Dialogue: 0,0:15:04.33,0:15:07.50,Caption,,0,0,0,,ДРУГУЮ, НАЗВАТЬ НОВЫМ ФОНДОМ, СТАРЫМ ФОНДОМ,
Dialogue: 0,0:15:07.58,0:15:10.86,Caption,,0,0,0,,КРЕДИТОМ, ГАРАНТИЕЙ ИЛИ ПОМОЩЬЮ. ЧЕЛОВЕКА ТАК НЕ
Dialogue: 0,0:15:10.86,0:15:15.29,Caption,,0,0,0,,ПЕРЕИМЕНУЕШЬ. ЕСЛИ ЕГО НЕТ, ЕГО НЕТ. И ЕСЛИ ПРОГНОЗ ОБ ИСТОЩЕНИИ
Dialogue: 0,0:15:15.29,0:15:17.82,Caption,,0,0,0,,ЛЮДСКОГО РЕСУРСА К ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМУ
Dialogue: 0,0:15:17.82,0:15:19.90,Caption,,0,0,0,,ГОДУ ХОТЯ БЫ ПРИБЛИЗИТСЯ К РЕАЛЬНОСТИ,
Dialogue: 0,0:15:20.31,0:15:22.03,Caption,,0,0,0,,ТОГДА ВСЕ ЭТИ КРАСИВЫЕ РАЗГОВОРЫ О
Dialogue: 0,0:15:22.03,0:15:24.56,Caption,,0,0,0,,ПРЕКРАСНОМ ЕВРОПЕЙСКОМ БУДУЩЕМ СТОЛКНУТСЯ С ОЧЕНЬ
Dialogue: 0,0:15:24.56,0:15:27.04,Caption,,0,0,0,,ПРОСТОЙ ПРОБЛЕМОЙ. ДО ЭТОГО БУДУЩЕГО ЕЩЁ
Dialogue: 0,0:15:27.04,0:15:28.38,Caption,,0,0,0,,ДОЛЖЕН КТО ТО ДОЙТИ.
