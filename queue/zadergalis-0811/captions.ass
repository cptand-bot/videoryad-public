Dialogue: 0,0:00:00.12,0:00:02.76,Caption,,0,0,0,,ЧТО ТО ЕВРОПЕЙЦЫ НАЧАЛИ СЛИШКОМ ВНИМАТЕЛЬНО СЛЕДИТЬ
Dialogue: 0,0:00:02.84,0:00:05.88,Caption,,0,0,0,,ЗА РУКАМИ ТРАМПА. КУДА ПОШЁЛ, С КЕМ ГОВОРИЛ,
Dialogue: 0,0:00:06.12,0:00:11.08,Caption,,0,0,0,,ЧТО СОБИРАЕТСЯ ПОДПИСЫВАТЬ, КОГО СПРОСИЛ. МЕРЦ УЖЕ ТРЕБУЕТ СОГЛАСОВАНИЯ СО ВСЕМ
Dialogue: 0,0:00:11.16,0:00:14.20,Caption,,0,0,0,,НАТО. ЕЩЁ НЕМНОГО, И БУДУТ ЗА РУЧКУ ДЕРЖАТЬ,
Dialogue: 0,0:00:14.28,0:00:17.08,Caption,,0,0,0,,ЧТОБЫ СЛУЧАЙНО НЕ ПОСТАВИЛ ПОДПИСЬ НЕ ТАМ. СМЕШНО
Dialogue: 0,0:00:17.16,0:00:20.04,Caption,,0,0,0,,ТОЛЬКО ПЕРВЫЕ ПЯТЬ СЕКУНД. ПОТОМУ ЧТО КОГДА СОЮЗНИКИ
Dialogue: 0,0:00:20.04,0:00:22.28,Caption,,0,0,0,,ТАК НЕРВНИЧАЮТ ИЗ ЗА ДЕЙСТВИЙ СОЮЗНИКА,
Dialogue: 0,0:00:22.60,0:00:25.16,Caption,,0,0,0,,ЗНАЧИТ, ГДЕ ТО УЖЕ ПОШЛО СОВСЕМ НЕ ПО ПЛАНУ.
Dialogue: 0,0:00:25.32,0:00:28.44,Caption,,0,0,0,,КСТАТИ, ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ КАК РАЗ ИНТЕРЕСНО НЕ
Dialogue: 0,0:00:28.52,0:00:30.76,Caption,,0,0,0,,ТО, ЧТО ПОЛИТИКИ СКАЗАЛИ В МИКРОФОН,
Dialogue: 0,0:00:31.00,0:00:33.72,Caption,,0,0,0,,А ПОЧЕМУ ОНИ ВДРУГ НАЧАЛИ ГОВОРИТЬ ИМЕННО ЭТО
Dialogue: 0,0:00:33.72,0:00:35.88,Caption,,0,0,0,,И ИМЕННО СЕЙЧАС. А СЕЙЧАС СМОТРИТЕ,
Dialogue: 0,0:00:36.02,0:00:41.24,Caption,,0,0,0,,ЧТО ПОЛУЧАЕТСЯ. МЕРЦ ТРЕБУЕТ, ЧТОБЫ БУДУЩАЯ СДЕЛКА ПО УКРАИНЕ СОГЛАСОВЫВАЛАСЬ СО
Dialogue: 0,0:00:41.32,0:00:45.56,Caption,,0,0,0,,ВСЕМ НАТО. МЕЛОНИ ГОВОРИТ, ЧТО ЕВРОСОЮЗУ НУЖЕН ОДИН ЧЕЛОВЕК,
Dialogue: 0,0:00:45.80,0:00:48.04,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ РАЗГОВАРИВАТЬ С ПУТИНЫМ ОТ ИМЕНИ
Dialogue: 0,0:00:48.04,0:00:51.40,Caption,,0,0,0,,ЕВРОПЫ. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОТКРЫТО БЕСПОКОЯТСЯ,
Dialogue: 0,0:00:51.67,0:00:53.96,Caption,,0,0,0,,ЧТО ТРАМП СПОСОБЕН ДОГОВОРИТЬСЯ С МОСКВОЙ ТАК,
Dialogue: 0,0:00:54.28,0:00:56.36,Caption,,0,0,0,,ЧТО ИМ ПОТОМ ОСТАНЕТСЯ ТОЛЬКО ЧИТАТЬ ИТОГОВЫЙ
Dialogue: 0,0:00:56.36,0:00:59.16,Caption,,0,0,0,,ДОКУМЕНТ И ИСКАТЬ ТАМ СВОЮ ФАМИЛИЮ. ВОТ ЭТО
Dialogue: 0,0:00:59.16,0:01:01.64,Caption,,0,0,0,,УЖЕ ИНТЕРЕСНЕЕ. ПОТОМУ ЧТО ЕСЛИ У ВСЕХ ОДНА
Dialogue: 0,0:01:01.72,0:01:05.88,Caption,,0,0,0,,ЦЕЛЬ, ЕСЛИ ВСЕ СОЮЗНИКИ, ЕСЛИ ВСЕ ХОТЯТ ОДНОГО РЕЗУЛЬТАТА,
Dialogue: 0,0:01:06.12,0:01:10.68,Caption,,0,0,0,,ЧЕГО ВООБЩЕ НЕРВНИЧАТЬ? ТРАМП ДОГОВОРИТСЯ. ЕВРОПА ПОДДЕРЖИТ. УКРАИНА
Dialogue: 0,0:01:10.68,0:01:14.20,Caption,,0,0,0,,ПОДПИШЕТ. ВСЕ ПОЖМУТ ДРУГ ДРУГУ РУКИ. ФОТОГРАФИЯ.
Dialogue: 0,0:01:14.28,0:01:20.95,Caption,,0,0,0,,ФЛАГИ. УЛЫБКИ. МОЖНО РАСХОДИТЬСЯ. НО ПОЧЕМУ ТО МЕРЦ УЖЕ ЗАРАНЕЕ
Dialogue: 0,0:01:20.95,0:01:23.91,Caption,,0,0,0,,ТРЕБУЕТ БЕЗ НАС НЕ ПОДПИСЫВАТЬ. МЕЛОНИ ГОВОРИТ НАМ
Dialogue: 0,0:01:23.99,0:01:26.23,Caption,,0,0,0,,ВООБЩЕ НУЖЕН СВОЙ ЧЕЛОВЕК У ПУТИНА. А В
Dialogue: 0,0:01:26.31,0:01:29.83,Caption,,0,0,0,,МОСКВЕ ОТВЕЧАЮТ, ЧТО ЕВРОПЕЙСКИХ ПРЕДЛОЖЕНИЙ ПОКА НИКТО ОСОБО И НЕ
Dialogue: 0,0:01:29.83,0:01:32.47,Caption,,0,0,0,,ВИДЕЛ. ТО ЕСТЬ МЕСТО ЗА СТОЛОМ УЖЕ ТРЕБУЮТ,
Dialogue: 0,0:01:32.71,0:01:36.55,Caption,,0,0,0,,ПЕРЕГОВОРЩИКА УЖЕ ИЩУТ, ПРАВА НА БУДУЩУЮ СДЕЛКУ УЖЕ ЗАЯВЛЯЮТ,
Dialogue: 0,0:01:36.79,0:01:39.35,Caption,,0,0,0,,А СОБСТВЕННОГО ВНЯТНОГО ПРЕДЛОЖЕНИЯ ЕЩЁ НЕТ.
Dialogue: 0,0:01:39.51,0:01:42.07,Caption,,0,0,0,,НЕПЛОХОЙ РЕСТОРАН. СТОЛИК ЗАБРОНИРОВАЛИ,
Dialogue: 0,0:01:42.30,0:01:44.87,Caption,,0,0,0,,ОФИЦИАНТА ПОЗВАЛИ, МЕНЮ ПОТРЕБОВАЛИ,
Dialogue: 0,0:01:45.16,0:01:46.71,Caption,,0,0,0,,ТОЛЬКО РЕШИЛИ ПОКА НЕ СООБЩАТЬ,
Dialogue: 0,0:01:46.94,0:01:49.91,Caption,,0,0,0,,ЧТО ИМЕННО СОБИРАЮТСЯ ЗАКАЗЫВАТЬ. И ТУТ ЕСТЬ ОДНА
Dialogue: 0,0:01:49.91,0:01:53.35,Caption,,0,0,0,,ВЕРСИЯ, КОТОРАЯ ЭТУ СУЕТУ ОБЪЯСНЯЕТ ГОРАЗДО ЛУЧШЕ,
Dialogue: 0,0:01:53.51,0:01:55.91,Caption,,0,0,0,,ЧЕМ ОБЫЧНЫЕ РАЗГОВОРЫ О ЕВРОПЕЙСКОМ ЕДИНСТВЕ.
Dialogue: 0,0:01:56.50,0:02:01.03,Caption,,0,0,0,,ПРОБЛЕМА ЕВРОПЫ НЕ В ТОМ, ЧТО ТРАМП ХОЧЕТ ДОГОВОРИТЬСЯ. ПРОБЛЕМА В ТОМ,
Dialogue: 0,0:02:01.20,0:02:04.31,Caption,,0,0,0,,КАК ИМЕННО ОН СОБИРАЕТСЯ ЭТО ДЕЛАТЬ. НА ПРОТЯЖЕНИИ
Dialogue: 0,0:02:04.39,0:02:07.19,Caption,,0,0,0,,МНОГИХ ЛЕТ США И ЕВРОПА ДЕЙСТВОВАЛИ ПРОТИВ РОССИИ
Dialogue: 0,0:02:07.27,0:02:10.39,Caption,,0,0,0,,В ОДНОЙ ОБЩЕЙ КОНСТРУКЦИИ. МЕТОДЫ ОТЛИЧАЛИСЬ,
Dialogue: 0,0:02:10.56,0:02:13.75,Caption,,0,0,0,,СПОРЫ БЫЛИ, ДЕНЕГ ДРУГ У ДРУГА ПРОСИЛИ ПОСТОЯННО,
Dialogue: 0,0:02:14.15,0:02:17.59,Caption,,0,0,0,,НО ГЛАВНАЯ СИЛОВАЯ МАШИНА БЫЛА ОБЩЕЙ. АМЕРИКА ДАВАЛА
Dialogue: 0,0:02:17.59,0:02:21.35,Caption,,0,0,0,,МАССУ ВЕЩЕЙ, БЕЗ КОТОРЫХ ВСЯ КОНСТРУКЦИЯ ВЫГЛЯДЕЛА БЫ СОВЕРШЕННО
Dialogue: 0,0:02:21.43,0:02:25.35,Caption,,0,0,0,,ИНАЧЕ. ВОЕННЫЕ ВОЗМОЖНОСТИ. РАЗВЕДКУ. ЛОГИСТИКУ.
Dialogue: 0,0:02:25.60,0:02:29.03,Caption,,0,0,0,,ПОЛИТИЧЕСКОЕ ПРИКРЫТИЕ. ФИНАНСОВУЮ МОЩЬ. ДОЛЛАРОВУЮ
Dialogue: 0,0:02:29.03,0:02:32.23,Caption,,0,0,0,,СИСТЕМУ. ОГРОМНЫЙ ВОЕННО ПРОМЫШЛЕННЫЙ КОМПЛЕКС.
Dialogue: 0,0:02:34.50,0:02:36.50,Caption,,0,0,0,,ЕВРОПА МОГЛА ПОЗВОЛИТЬ СЕБЕ БЫТЬ ОЧЕНЬ
Dialogue: 0,0:02:36.50,0:02:39.86,Caption,,0,0,0,,ПРИНЦИПИАЛЬНОЙ, ПОКА ЗА СПИНОЙ СТОЯЛ ПАРЕНЬ РОСТОМ ДВА МЕТРА
Dialogue: 0,0:02:39.94,0:02:42.50,Caption,,0,0,0,,И ВЕСОМ СТО ДВАДЦАТЬ КИЛОГРАММОВ. ОЧЕНЬ УДОБНО
Dialogue: 0,0:02:42.50,0:02:44.82,Caption,,0,0,0,,ОБЪЯСНЯТЬ СОСЕДУ, КАКОЙ ТЫ ОПАСНЫЙ,
Dialogue: 0,0:02:44.98,0:02:47.70,Caption,,0,0,0,,КОГДА РЯДОМ СТОИТ ТАЙСОН. А ТЕПЕРЬ ТАЙСОН ВДРУГ
Dialogue: 0,0:02:47.70,0:02:49.62,Caption,,0,0,0,,ПОСМОТРЕЛ НА ЧАСЫ И ГОВОРИТ РЕБЯТА,
Dialogue: 0,0:02:49.78,0:02:52.34,Caption,,0,0,0,,У МЕНЯ ВООБЩЕ ДРУГИЕ ДЕЛА. ВОТ ТУТ РАЗГОВОР
Dialogue: 0,0:02:52.42,0:02:55.06,Caption,,0,0,0,,СТАНОВИТСЯ ГОРАЗДО КОРОЧЕ. ПОТОМУ ЧТО СТАРЫЙ
Dialogue: 0,0:02:55.06,0:02:57.30,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ РАСЧЁТ СТРОИЛСЯ НЕ НА ТОМ,
Dialogue: 0,0:02:57.46,0:03:00.18,Caption,,0,0,0,,ЧТО ГЕРМАНИЯ, ФРАНЦИЯ, ПОЛЬША,
Dialogue: 0,0:03:00.42,0:03:03.14,Caption,,0,0,0,,БРИТАНИЯ И ОСТАЛЬНЫЕ КОГДА НИБУДЬ САМОСТОЯТЕЛЬНО
Dialogue: 0,0:03:03.22,0:03:05.94,Caption,,0,0,0,,БУДУТ ВЫЯСНЯТЬ ОТНОШЕНИЯ С РОССИЕЙ НА ПРЕДЕЛЕ СВОИХ
Dialogue: 0,0:03:05.94,0:03:09.06,Caption,,0,0,0,,ВОЗМОЖНОСТЕЙ. ОН СТРОИЛСЯ НА СОВМЕСТНОЙ КОНСТРУКЦИИ
Dialogue: 0,0:03:09.14,0:03:12.74,Caption,,0,0,0,,С США. И ВОТ ИЗ ЭТОЙ КОНСТРУКЦИИ НАЧИНАЕТ ВЫПАДАТЬ ГЛАВНЫЙ
Dialogue: 0,0:03:12.74,0:03:16.74,Caption,,0,0,0,,ЭЛЕМЕНТ. НЕ ЛАТВИЯ. НЕ ЛЮКСЕМБУРГ. НЕ ОЧЕРЕДНОЙ ФОНД
Dialogue: 0,0:03:16.82,0:03:20.02,Caption,,0,0,0,,В БРЮССЕЛЕ. СОЕДИНЁННЫЕ ШТАТЫ. И ТРАМП,
Dialogue: 0,0:03:20.16,0:03:23.62,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, НЕ ГОВОРИТ ЕВРОПЕ ВЫ ВСЁ ДЕЛАЛИ НЕПРАВИЛЬНО,
Dialogue: 0,0:03:23.86,0:03:26.50,Caption,,0,0,0,,ТЕПЕРЬ Я БУДУ ДОБРЫМ И ХОРОШИМ. НЕТ. У
Dialogue: 0,0:03:26.58,0:03:30.02,Caption,,0,0,0,,НЕГО СВОЯ ЛОГИКА. АМЕРИКЕ НУЖНЫ ДЕНЬГИ. РЫНКИ.
Dialogue: 0,0:03:30.25,0:03:33.70,Caption,,0,0,0,,СДЕЛКИ. РЕСУРСЫ. КОНТРОЛЬ НАД БОЛЬШИМИ ПОТОКАМИ.
Dialogue: 0,0:03:33.86,0:03:36.98,Caption,,0,0,0,,ВЛИЯНИЕ. ВАШИНГТОН ПРИ ТРАМПЕ НЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:03:36.98,0:03:39.14,Caption,,0,0,0,,БЛАГОТВОРИТЕЛЬНУЮ ОРГАНИЗАЦИЮ ИМЕНИ СВЯТОГО
Dialogue: 0,0:03:39.22,0:03:42.58,Caption,,0,0,0,,ДОНАЛЬДА. ПРОСТО СПОСОБ ДРУГОЙ. ЕСЛИ МОЖНО ПОЛУЧИТЬ
Dialogue: 0,0:03:42.58,0:03:46.74,Caption,,0,0,0,,НУЖНОЕ ЧЕРЕЗ ДОГОВОРЁННОСТЬ, ЗАЧЕМ ПЛАТИТЬ ЗА БЕСКОНЕЧНУЮ КОНФРОНТАЦИЮ?
Dialogue: 0,0:03:47.06,0:03:53.50,Caption,,0,0,0,,ВОТ ГДЕ РАСХОДЯТСЯ ДОРОГИ. ЕВРОПЕЙСКАЯ ЛОГИКА ПОСЛЕДНИХ ЛЕТ БЫЛА ПОСТРОЕНА НА
Dialogue: 0,0:03:53.50,0:03:57.02,Caption,,0,0,0,,ДАВЛЕНИИ, САНКЦИЯХ, ВОЕННОЙ ПОДДЕРЖКЕ УКРАИНЫ,
Dialogue: 0,0:03:57.26,0:03:59.82,Caption,,0,0,0,,ПОСТЕПЕННОМ ОСЛАБЛЕНИИ РОССИИ И НАДЕЖДЕ,
Dialogue: 0,0:04:00.08,0:04:02.54,Caption,,0,0,0,,ЧТО В КАКОЙ ТО МОМЕНТ МОСКВА ЛИБО СЛОМАЕТСЯ,
Dialogue: 0,0:04:02.78,0:04:07.18,Caption,,0,0,0,,ЛИБО ОКАЖЕТСЯ В ПОЛОЖЕНИИ, КОГДА ЕЙ МОЖНО БУДЕТ ДИКТОВАТЬ УСЛОВИЯ. И ЗА
Dialogue: 0,0:04:07.18,0:04:10.14,Caption,,0,0,0,,ЭТИМ УГАДЫВАЕТСЯ ЕЩЁ ОДИН РАСЧЁТ ОСЛАБИТЬ РОССИЮ
Dialogue: 0,0:04:10.14,0:04:13.50,Caption,,0,0,0,,НАСТОЛЬКО, ЧТОБЫ ПОТОМ ПОЛУЧИТЬ ДОСТУП К ЕЁ РЕСУРСАМ НА
Dialogue: 0,0:04:13.50,0:04:16.46,Caption,,0,0,0,,ВЫГОДНЫХ ДЛЯ СЕБЯ УСЛОВИЯХ. ТРАМП СМОТРИТ НА ЭТО
Dialogue: 0,0:04:16.46,0:04:19.10,Caption,,0,0,0,,И ЗАДАЁТ ОЧЕНЬ АМЕРИКАНСКИЙ ВОПРОС А СКОЛЬКО ЕЩЁ
Dialogue: 0,0:04:19.18,0:04:21.82,Caption,,0,0,0,,СТОИТ ЭТОТ АТТРАКЦИОН? И ЧТО Я ПОЛУЧУ В КОНЦЕ?
Dialogue: 0,0:04:22.04,0:04:25.34,Caption,,0,0,0,,НЕ ЛОЗУНГ. НЕ КРАСИВУЮ РЕЗОЛЮЦИЮ. НЕ ЕЩЁ ОДНУ
Dialogue: 0,0:04:25.34,0:04:28.46,Caption,,0,0,0,,ФОТОГРАФИЮ ЛИДЕРОВ В БРЮССЕЛЕ. ЧТО КОНКРЕТНО ПОЛУЧИТ
Dialogue: 0,0:04:28.46,0:04:32.22,Caption,,0,0,0,,АМЕРИКА? ВОТ ЗДЕСЬ СТАРЫЙ СОЮЗ НАЧИНАЕТ СКРИПЕТЬ. ПОТОМУ ЧТО
Dialogue: 0,0:04:32.30,0:04:35.98,Caption,,0,0,0,,ЕСЛИ ТРАМП РЕШАЕТ, ЧТО ВЫГОДНЕЕ ДОГОВОРИТЬСЯ С РОССИЕЙ НАПРЯМУЮ,
Dialogue: 0,0:04:36.30,0:04:38.62,Caption,,0,0,0,,ТО ЕВРОПЕЙСКИЙ ПЛАН НЕ ИСЧЕЗАЕТ АВТОМАТИЧЕСКИ.
Dialogue: 0,0:04:38.79,0:04:41.58,Caption,,0,0,0,,ХОТИТЕ ПРОДОЛЖАТЬ? ПРОДОЛЖАЙТЕ. ТОЛЬКО УЖЕ САМИ.
Dialogue: 0,0:04:42.37,0:04:44.62,Caption,,0,0,0,,ВОТ ЭТА ФРАЗА ДЛЯ ЕВРОПЫ СТРАШНЕЕ ПОЛОВИНЫ
Dialogue: 0,0:04:44.62,0:04:47.66,Caption,,0,0,0,,РОССИЙСКИХ РАКЕТ. ПОТОМУ ЧТО ОДНО ДЕЛО НЕСКОЛЬКО ЛЕТ
Dialogue: 0,0:04:47.66,0:04:49.98,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО РОССИЮ НАДО ОСТАНОВИТЬ,
Dialogue: 0,0:04:50.14,0:04:55.90,Caption,,0,0,0,,ОСЛАБИТЬ, ЗАСТАВИТЬ, ДОЖАТЬ, НАКАЗАТЬ И ЕЩЁ ОБЯЗАТЕЛЬНО ЧЕМУ НИБУДЬ НАУЧИТЬ. И
Dialogue: 0,0:04:55.90,0:04:58.54,Caption,,0,0,0,,СОВСЕМ ДРУГОЕ УСЛЫШАТЬ ИЗ ВАШИНГТОНА ОТЛИЧНО,
Dialogue: 0,0:04:58.70,0:05:03.85,Caption,,0,0,0,,ПРОДОЛЖАЙТЕ. МЫ ВЫШЛИ. И ВОТ ТОГДА ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:05:04.08,0:05:06.09,Caption,,0,0,0,,СКОЛЬКО В ЭТОЙ КОНСТРУКЦИИ БЫЛО ЕВРОПЫ,
Dialogue: 0,0:05:06.39,0:05:11.05,Caption,,0,0,0,,А СКОЛЬКО СОЕДИНЁННЫХ ШТАТОВ. ВОТ ПОЭТОМУ ТРЕБОВАНИЕ МЕРЦА СОГЛАСОВЫВАТЬ ВСЁ С
Dialogue: 0,0:05:11.05,0:05:13.69,Caption,,0,0,0,,НАТО ВЫГЛЯДИТ СОВСЕМ ИНАЧЕ. ЭТО УЖЕ НЕ ПРОСТО
Dialogue: 0,0:05:13.69,0:05:16.41,Caption,,0,0,0,,ЖЕЛАНИЕ СИДЕТЬ ЗА СТОЛОМ. ЭТО ПОПЫТКА НЕ ДАТЬ
Dialogue: 0,0:05:16.41,0:05:19.13,Caption,,0,0,0,,ГЛАВНОМУ УЧАСТНИКУ ВЫЙТИ ИЗ ОБЩЕЙ ИГРЫ И НАЧАТЬ
Dialogue: 0,0:05:19.13,0:05:21.93,Caption,,0,0,0,,СОБСТВЕННУЮ. ПОТОМУ ЧТО НАТО БЕЗ АМЕРИКАНСКОГО
Dialogue: 0,0:05:22.01,0:05:25.05,Caption,,0,0,0,,УЧАСТИЯ НА БУМАГЕ ОСТАЁТСЯ НАТО. ФЛАЖКИ ОСТАНУТСЯ.
Dialogue: 0,0:05:25.31,0:05:28.25,Caption,,0,0,0,,ШТАБ КВАРТИРА ОСТАНЕТСЯ. СОВЕЩАНИЯ ОСТАНУТСЯ.
Dialogue: 0,0:05:28.49,0:05:31.45,Caption,,0,0,0,,ФОТОГРАФИИ ОСТАНУТСЯ ВООБЩЕ ВЕЛИКОЛЕПНЫЕ. А ВОТ
Dialogue: 0,0:05:31.45,0:05:33.85,Caption,,0,0,0,,РЕАЛЬНАЯ ТЯЖЕСТЬ КОНСТРУКЦИИ МЕНЯЕТСЯ ОЧЕНЬ
Dialogue: 0,0:05:33.85,0:05:37.69,Caption,,0,0,0,,СЕРЬЁЗНО. И ТУТ КУШНЕР ПОДБРАСЫВАЕТ ЕВРОПЕЙЦАМ ЕЩЁ ОДИН
Dialogue: 0,0:05:37.69,0:05:40.81,Caption,,0,0,0,,ПОДАРОК. ВАШИНГТОН ГОВОРИТ УЖЕ НЕ ТОЛЬКО ОБ УКРАИНЕ.
Dialogue: 0,0:05:40.97,0:05:43.61,Caption,,0,0,0,,РАЗГОВОР ИДЁТ О БОЛЕЕ ШИРОКОЙ СИСТЕМЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:05:43.61,0:05:47.53,Caption,,0,0,0,,БЕЗОПАСНОСТИ, ГДЕ ДОЛЖНЫ КАКИМ ТО ОБРАЗОМ УЧИТЫВАТЬСЯ И РОССИЙСКИЕ
Dialogue: 0,0:05:47.53,0:05:50.01,Caption,,0,0,0,,ИНТЕРЕСЫ. ВОТ ТУТ У МНОГИХ В ЕВРОПЕ,
Dialogue: 0,0:05:50.16,0:05:52.97,Caption,,0,0,0,,ДУМАЮ, КОФЕ ПОШЁЛ НЕ В ТО ГОРЛО. ПОТОМУ ЧТО
Dialogue: 0,0:05:52.97,0:05:55.29,Caption,,0,0,0,,УКРАИНА ЭТО ОДИН ВОПРОС. БОЛЬШОЙ,
Dialogue: 0,0:05:55.37,0:06:00.01,Caption,,0,0,0,,ТЯЖЁЛЫЙ, КРОВАВЫЙ, СЛОЖНЫЙ. НО ВСЁ ТАКИ ОДИН. А ЕВРОПЕЙСКАЯ
Dialogue: 0,0:06:00.01,0:06:02.97,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ЭТО УЖЕ СОВСЕМ ДРУГОЙ ЭТАЖ. ТАМ НАТО.
Dialogue: 0,0:06:03.23,0:06:06.89,Caption,,0,0,0,,ТАМ РАЗМЕЩЕНИЕ ВОЙСК. ТАМ ВООРУЖЕНИЯ. ТАМ БАЗЫ. ТАМ
Dialogue: 0,0:06:06.89,0:06:09.77,Caption,,0,0,0,,ОГРАНИЧЕНИЯ. ТАМ ГАРАНТИИ. ТАМ ВОПРОС,
Dialogue: 0,0:06:09.93,0:06:12.33,Caption,,0,0,0,,КТО КОМУ УГРОЖАЕТ И КТО ОТ КОГО ЧЕГО
Dialogue: 0,0:06:12.33,0:06:15.21,Caption,,0,0,0,,ТРЕБУЕТ. ТАМ СТАРЫЕ РОССИЙСКИЕ ПРЕТЕНЗИИ,
Dialogue: 0,0:06:15.45,0:06:18.25,Caption,,0,0,0,,КОТОРЫЕ МОСКВА ВЫДВИГАЛА ЕЩЁ ДО НАЧАЛА НЫНЕШНЕГО
Dialogue: 0,0:06:18.25,0:06:23.57,Caption,,0,0,0,,КОНФЛИКТА. И ВОТ ЕСЛИ РАЗГОВОР ДЕЙСТВИТЕЛЬНО ПЕРЕХОДИТ НА ЭТОТ
Dialogue: 0,0:06:23.57,0:06:25.73,Caption,,0,0,0,,ЭТАЖ, ТОГДА СТАНОВИТСЯ ПОНЯТНО,
Dialogue: 0,0:06:25.85,0:06:27.73,Caption,,0,0,0,,ПОЧЕМУ ЕВРОПА ВДРУГ ВСПОМИНАЕТ,
Dialogue: 0,0:06:27.97,0:06:30.29,Caption,,0,0,0,,ЧТО БЕЗ НЕЁ НЕЛЬЗЯ ОБСУЖДАТЬ ЕВРОПЕЙСКУЮ
Dialogue: 0,0:06:30.29,0:06:33.25,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. ЛОГИЧНО. ТОЛЬКО ЕСТЬ МАЛЕНЬКАЯ
Dialogue: 0,0:06:33.25,0:06:36.21,Caption,,0,0,0,,НЕПРИЯТНОСТЬ. ЧТОБЫ ТЕБЯ ОБЯЗАТЕЛЬНО СПРАШИВАЛИ,
Dialogue: 0,0:06:36.29,0:06:40.53,Caption,,0,0,0,,МАЛО ГРОМКО ЗАЯВИТЬ, ЧТО ВОПРОС КАСАЕТСЯ ТЕБЯ. НУЖНО ЕЩЁ ИМЕТЬ
Dialogue: 0,0:06:40.53,0:06:42.45,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ОСТАНОВИТЬ РЕШЕНИЕ,
Dialogue: 0,0:06:42.53,0:06:45.09,Caption,,0,0,0,,ЕСЛИ ТЕБЯ НЕ СПРОСИЛИ. ВОТ ЗДЕСЬ И НАЧИНАЕТСЯ
Dialogue: 0,0:06:45.09,0:06:47.41,Caption,,0,0,0,,НАСТОЯЩАЯ АРИФМЕТИКА. ПОДПИШИТЕСЬ,
Dialogue: 0,0:06:47.49,0:06:50.05,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ КАК
Dialogue: 0,0:06:50.05,0:06:53.81,Caption,,0,0,0,,РАЗ ТОТ МОМЕНТ, ГДЕ УКРАИНСКИЕ ПЕРЕГОВОРЫ ПЕРЕСТАЮТ БЫТЬ ВСЕЙ
Dialogue: 0,0:06:53.81,0:06:57.09,Caption,,0,0,0,,КАРТИНОЙ И СТАНОВЯТСЯ ТОЛЬКО ОДНИМ ЕЁ КУСКОМ. НА
Dialogue: 0,0:06:57.09,0:06:59.81,Caption,,0,0,0,,СЛЕДУЮЩЕЙ НЕДЕЛЕ В АБУ ДАБИ ДОЛЖНЫ СНОВА ВСТРЕТИТЬСЯ
Dialogue: 0,0:06:59.81,0:07:03.89,Caption,,0,0,0,,АМЕРИКАНЦЫ, РОССИЯНЕ И УКРАИНЦЫ. С УКРАИНСКОЙ СТОРОНЫ ЕДЕТ
Dialogue: 0,0:07:03.89,0:07:07.33,Caption,,0,0,0,,БУДАНОВ. С РОССИЙСКОЙ СТОРОНЫ МЕДИНСКИЙ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:07:07.41,0:07:10.29,Caption,,0,0,0,,НЕ СТОИТ УСТРАИВАТЬ ЦИРК ВОКРУГ ФАМИЛИЙ. ЛЮДИ ДРУГ
Dialogue: 0,0:07:10.37,0:07:12.77,Caption,,0,0,0,,ДРУГА ЗНАЮТ. ПЕРЕГОВОРЩИКИ УЖЕ ПОНИМАЮТ,
Dialogue: 0,0:07:12.93,0:07:15.65,Caption,,0,0,0,,ГДЕ СТОРОНЫ РАНЬШЕ УПИРАЛИСЬ ЛБОМ В СТЕНУ. ОНИ
Dialogue: 0,0:07:15.73,0:07:19.25,Caption,,0,0,0,,ЗНАЮТ ТРЕБОВАНИЯ. ЗНАЮТ, ЧТО КИЕВ ГОТОВ ОБСУЖДАТЬ,
Dialogue: 0,0:07:19.41,0:07:22.77,Caption,,0,0,0,,А ЧТО НЕ ГОТОВ. ЗНАЮТ РОССИЙСКИЕ ПОЗИЦИИ. ЗНАЮТ
Dialogue: 0,0:07:22.77,0:07:25.17,Caption,,0,0,0,,АМЕРИКАНСКИЕ ПРЕДЛОЖЕНИЯ. ТАМ УЖЕ НЕ ПЕРВОЕ
Dialogue: 0,0:07:25.17,0:07:27.73,Caption,,0,0,0,,СВИДАНИЕ. НЕ НУЖНО СИДЕТЬ И СПРАШИВАТЬ А ЧЕМ
Dialogue: 0,0:07:27.81,0:07:30.21,Caption,,0,0,0,,ВЫ ЗАНИМАЕТЕСЬ, КАКИЕ ФИЛЬМЫ ЛЮБИТЕ,
Dialogue: 0,0:07:30.45,0:07:33.65,Caption,,0,0,0,,РАССКАЖИТЕ НЕМНОГО О СЕБЕ. ВСЕ ДАВНО ПОЗНАКОМИЛИСЬ.
Dialogue: 0,0:07:33.81,0:07:40.48,Caption,,0,0,0,,ВСЕ ЗНАЮТ, КТО ЧТО ХОЧЕТ. И ИМЕННО ПОЭТОМУ УКРАИНСКАЯ ЧАСТЬ СЕЙЧАС ИНТЕРЕСНА
Dialogue: 0,0:07:40.56,0:07:43.12,Caption,,0,0,0,,НЕ ФАМИЛИЕЙ БУДАНОВА. ОНА ИНТЕРЕСНА ТЕМ,
Dialogue: 0,0:07:43.28,0:07:45.84,Caption,,0,0,0,,ЧТО ЭТОТ БЛОК УЖЕ ДОСТАТОЧНО ХОРОШО ОЧЕРЧЕН.
Dialogue: 0,0:07:45.99,0:07:49.60,Caption,,0,0,0,,ТЕРРИТОРИИ. ГАРАНТИИ. ПРЕКРАЩЕНИЕ УДАРОВ. МЕХАНИЗМЫ
Dialogue: 0,0:07:49.60,0:07:52.96,Caption,,0,0,0,,КОНТРОЛЯ. ВОЕННЫЕ ВОПРОСЫ. ПОЛИТИЧЕСКИЕ ВОПРОСЫ.
Dialogue: 0,0:07:53.34,0:07:55.92,Caption,,0,0,0,,ТОРГОВАТЬСЯ ТАМ МОЖНО ЕЩЁ ДОЛГО. НО САМ ПРЕДМЕТ
Dialogue: 0,0:07:55.92,0:07:58.96,Caption,,0,0,0,,ТОРГОВЛИ СТОРОНАМ ДАВНО ИЗВЕСТЕН. А ВОТ ВОКРУГ ЭТОГО
Dialogue: 0,0:07:59.04,0:08:02.08,Caption,,0,0,0,,БЛОКА НАЧИНАЕТ ПОЯВЛЯТЬСЯ БОЛЬШАЯ РАМКА. РОССИЯ И
Dialogue: 0,0:08:02.16,0:08:06.72,Caption,,0,0,0,,США. РОССИЯ И НАТО. ЕВРОПА И США. БУДУЩАЯ
Dialogue: 0,0:08:06.72,0:08:09.60,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ. И ВОТ ЗДЕСЬ У МЕРЦА УЖЕ
Dialogue: 0,0:08:09.60,0:08:12.24,Caption,,0,0,0,,ГОРАЗДО МЕНЬШЕ ПОВОДОВ УЛЫБАТЬСЯ. ПОТОМУ ЧТО В
Dialogue: 0,0:08:12.24,0:08:14.72,Caption,,0,0,0,,УКРАИНСКОМ ВОПРОСЕ ЕВРОПА ЕЩЁ МОЖЕТ ГОВОРИТЬ МЫ
Dialogue: 0,0:08:14.72,0:08:17.20,Caption,,0,0,0,,ГЛАВНЫЙ СПОНСОР, ЭТО НАША БЕЗОПАСНОСТЬ,
Dialogue: 0,0:08:17.36,0:08:22.00,Caption,,0,0,0,,ЭТО РЯДОМ С НАМИ, БЕЗ НАС НЕЛЬЗЯ. А ЕСЛИ ВАШИНГТОН НАЧИНАЕТ НАПРЯМУЮ
Dialogue: 0,0:08:22.00,0:08:24.48,Caption,,0,0,0,,ОБСУЖДАТЬ С МОСКВОЙ ДОЛГОСРОЧНЫЕ ОТНОШЕНИЯ МЕЖДУ
Dialogue: 0,0:08:24.48,0:08:28.80,Caption,,0,0,0,,ДВУМЯ КРУПНЫМИ ДЕРЖАВАМИ, ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОКАЗЫВАЮТСЯ В СОВЕРШЕННО ДРУГОЙ
Dialogue: 0,0:08:28.80,0:08:32.32,Caption,,0,0,0,,ПОЗИЦИИ. ОНИ УЖЕ НЕ ХОЗЯЕВА ПРОЦЕССА. ОНИ ОДИН
Dialogue: 0,0:08:32.40,0:08:35.60,Caption,,0,0,0,,ИЗ УЧАСТНИКОВ ПРОЦЕССА. А ЭТО ОЧЕНЬ НЕПРИЯТНАЯ СМЕНА
Dialogue: 0,0:08:35.60,0:08:38.32,Caption,,0,0,0,,ДОЛЖНОСТИ. ВЧЕРА ТЫ СТОЯЛ У ДОСКИ И ОБЪЯСНЯЛ
Dialogue: 0,0:08:38.32,0:08:40.88,Caption,,0,0,0,,ВСЕМ ПРАВИЛА. СЕГОДНЯ ТЕБЕ ГОВОРЯТ САДИСЬ,
Dialogue: 0,0:08:40.96,0:08:44.00,Caption,,0,0,0,,СЕЙЧАС БУДЕМ ОБСУЖДАТЬ ПРАВИЛА ВМЕСТЕ. ВОТ МЕЛОНИ И
Dialogue: 0,0:08:44.08,0:08:46.88,Caption,,0,0,0,,ПРЕДЛАГАЕТ СРОЧНО НАЗНАЧИТЬ ЕДИНОГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:08:46.88,0:08:50.24,Caption,,0,0,0,,ПЕРЕГОВОРЩИКА. И САМА ЭТА ИДЕЯ ОЧЕНЬ ПОКАЗАТЕЛЬНАЯ.
Dialogue: 0,0:08:52.52,0:08:56.12,Caption,,0,0,0,,ПОЛУЧАЕТСЯ, ЕВРОПА СТОЛЬКО ЛЕТ ГОВОРИЛА ОТ ИМЕНИ ЕВРОПЫ,
Dialogue: 0,0:08:56.44,0:08:58.84,Caption,,0,0,0,,НО КОГДА ДОШЛО ДО РЕАЛЬНОГО БОЛЬШОГО РАЗГОВОРА,
Dialogue: 0,0:08:59.16,0:09:01.24,Caption,,0,0,0,,ВНЕЗАПНО ВЫЯСНИЛОСЬ, ЧТО ЧЕЛОВЕКА,
Dialogue: 0,0:09:01.47,0:09:03.72,Caption,,0,0,0,,КОТОРЫЙ ДЕЙСТВИТЕЛЬНО МОЖЕТ ГОВОРИТЬ ОТ ИМЕНИ ВСЕЙ
Dialogue: 0,0:09:03.72,0:09:08.20,Caption,,0,0,0,,ЕВРОПЫ, ЕЩЁ НАДО НАЙТИ. КРАСИВО. ДВАДЦАТЬ СЕМЬ СТРАН.
Dialogue: 0,0:09:08.55,0:09:12.60,Caption,,0,0,0,,ЕВРОКОМИССИЯ. ЕВРОПЕЙСКИЙ СОВЕТ. ЕВРОПАРЛАМЕНТ. НАТО
Dialogue: 0,0:09:12.60,0:09:15.88,Caption,,0,0,0,,РЯДОМ. ТЫСЯЧИ ЧИНОВНИКОВ. ДЕСЯТКИ ТЫСЯЧ СТРАНИЦ
Dialogue: 0,0:09:15.88,0:09:19.32,Caption,,0,0,0,,ДОКУМЕНТОВ. А ПОГОВОРИТЬ С ПУТИНЫМ НЕКОМУ. ВОТ ТАКАЯ
Dialogue: 0,0:09:19.32,0:09:22.68,Caption,,0,0,0,,ИНСТИТУЦИОНАЛЬНАЯ МОЩЬ. И ЭТО НЕ ШУТКА РАДИ ШУТКИ.
Dialogue: 0,0:09:22.92,0:09:25.80,Caption,,0,0,0,,ЭТО РЕАЛЬНАЯ ПРОБЛЕМА ЕВРОПЫ. ПОТОМУ ЧТО ИНТЕРЕСЫ
Dialogue: 0,0:09:25.80,0:09:29.00,Caption,,0,0,0,,ВНУТРИ САМОГО ЕВРОПЕЙСКОГО БЛОКА РАЗНЫЕ. ГЕРМАНИЯ
Dialogue: 0,0:09:29.08,0:09:32.12,Caption,,0,0,0,,ДУМАЕТ О СВОЁМ. ИТАЛИЯ О СВОЁМ. ФРАНЦИЯ О
Dialogue: 0,0:09:32.12,0:09:35.00,Caption,,0,0,0,,СВОЁМ. ПОЛЬША ВООБЩЕ ЖИВЁТ В ОТДЕЛЬНОЙ ИСТОРИЧЕСКОЙ
Dialogue: 0,0:09:35.08,0:09:37.72,Caption,,0,0,0,,ВСЕЛЕННОЙ, ГДЕ РОССИЯ ПРИСУТСТВУЕТ ДАЖЕ ТОГДА,
Dialogue: 0,0:09:38.04,0:09:40.84,Caption,,0,0,0,,КОГДА РАЗГОВОР НАЧИНАЕТСЯ С КАРТОШКИ. БРИТАНИЯ ВНЕ
Dialogue: 0,0:09:40.84,0:09:44.44,Caption,,0,0,0,,ЕВРОСОЮЗА, НО ВНУТРИ ВСЕЙ ЭТОЙ БОЛЬШОЙ КОНСТРУКЦИИ. БАЛТИЯ
Dialogue: 0,0:09:44.44,0:09:48.12,Caption,,0,0,0,,ИМЕЕТ СВОЮ ЛИНИЮ. ВЕНГРИЯ СВОЮ. СЛОВАКИЯ СВОЮ. И
Dialogue: 0,0:09:48.12,0:09:50.20,Caption,,0,0,0,,ПОПРОБУЙ ИЗ ЭТОГО СОБРАТЬ ОДНОГО ЧЕЛОВЕКА,
Dialogue: 0,0:09:50.43,0:09:52.36,Caption,,0,0,0,,КОТОРЫЙ ПРИДЁТ К МОСКВЕ И СКАЖЕТ Я ГОВОРЮ
Dialogue: 0,0:09:52.44,0:09:55.16,Caption,,0,0,0,,ЗА ВСЕХ. ПУТИН ПЕРВЫМ ДЕЛОМ СПРОСИТ ТОЧНО ЗА
Dialogue: 0,0:09:55.16,0:09:57.56,Caption,,0,0,0,,ВСЕХ? И ТУТ ЗА СПИНОЙ УЖЕ КТО НИБУДЬ КАШЛЯНЕТ.
Dialogue: 0,0:09:57.80,0:09:59.72,Caption,,0,0,0,,НО ГЛАВНАЯ ПРОБЛЕМА ДАЖЕ НЕ В ЕВРОПЕЙСКОЙ
Dialogue: 0,0:09:59.72,0:10:02.12,Caption,,0,0,0,,РАЗДРОБЛЕННОСТИ. ГЛАВНАЯ ПРОБЛЕМА В США.
Dialogue: 0,0:10:04.41,0:10:06.89,Caption,,0,0,0,,ПОТОМУ ЧТО РАНЬШЕ ЕВРОПА МОГЛА СПОРИТЬ ВНУТРИ СЕБЯ
Dialogue: 0,0:10:06.97,0:10:10.57,Caption,,0,0,0,,СКОЛЬКО УГОДНО, ПОКА АМЕРИКАНСКАЯ МАШИНА ДЕРЖАЛА ОБЩИЙ КАРКАС.
Dialogue: 0,0:10:10.89,0:10:13.53,Caption,,0,0,0,,ТЕПЕРЬ АМЕРИКАНСКИЙ ПРЕЗИДЕНТ САМ СПОСОБЕН СТАТЬ
Dialogue: 0,0:10:13.53,0:10:15.29,Caption,,0,0,0,,ГЛАВНЫМ ИСТОЧНИКОМ РАСХОЖДЕНИЯ.
Dialogue: 0,0:10:15.86,0:10:18.73,Caption,,0,0,0,,ТРАМП НЕ ПРОСТО РАЗГОВАРИВАЕТ С МОСКВОЙ. ОН ПЫТАЕТСЯ
Dialogue: 0,0:10:18.73,0:10:21.85,Caption,,0,0,0,,ПОСТРОИТЬ СВОЮ СДЕЛКУ. И ЭТА СДЕЛКА МОЖЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:10:21.85,0:10:25.77,Caption,,0,0,0,,СОВЕРШЕННО НЕ ТОЙ, РАДИ КОТОРОЙ ЕВРОПА ПЯТЬ ЛЕТ ВКЛАДЫВАЛА ДЕНЬГИ,
Dialogue: 0,0:10:25.94,0:10:29.37,Caption,,0,0,0,,ОРУЖИЕ, ПОЛИТИЧЕСКИЙ КАПИТАЛ И СОБСТВЕННУЮ ПРОМЫШЛЕННОСТЬ.
Dialogue: 0,0:10:29.85,0:10:32.73,Caption,,0,0,0,,ВОТ ПОЧЕМУ ТРЕБОВАНИЕ МЕРЦА ЗВУЧИТ НЕРВНО. ОН
Dialogue: 0,0:10:32.81,0:10:35.93,Caption,,0,0,0,,ТРЕБУЕТ НЕ ПРОСТО УЧАСТИЯ. ОН ТРЕБУЕТ ПРАВА ВЛИЯТЬ
Dialogue: 0,0:10:36.01,0:10:38.65,Caption,,0,0,0,,НА ФИНАЛЬНЫЙ РЕЗУЛЬТАТ. А ЭТО ДВЕ СОВЕРШЕННО РАЗНЫЕ
Dialogue: 0,0:10:38.65,0:10:42.17,Caption,,0,0,0,,ВЕЩИ. ПОСИДЕТЬ РЯДОМ МОЖНО КОМУ УГОДНО. СТУЛ НАЙДУТ.
Dialogue: 0,0:10:42.33,0:10:45.61,Caption,,0,0,0,,ВОДЫ НАЛЬЮТ. ТАБЛИЧКУ ПОСТАВЯТ. А ВОТ ПРАВО СКАЗАТЬ
Dialogue: 0,0:10:45.61,0:10:48.09,Caption,,0,0,0,,НЕТ, ТАК НЕЛЬЗЯ, ПЕРЕДЕЛЫВАЙТЕ,
Dialogue: 0,0:10:48.39,0:10:50.81,Caption,,0,0,0,,ЭТО УЖЕ ВЛАСТЬ. И ВОПРОС СЕЙЧАС ИМЕННО В
Dialogue: 0,0:10:50.89,0:10:54.25,Caption,,0,0,0,,ТОМ, ОСТАНЕТСЯ ЛИ У ЕВРОПЫ ТАКАЯ ВЛАСТЬ. ОСОБЕННО ПОСЛЕ
Dialogue: 0,0:10:54.25,0:10:57.13,Caption,,0,0,0,,АМЕРИКАНСКИХ ВЫБОРОВ. ДЕМОКРАТЫ ПОЛУЧИЛИ СЕРЬЁЗНЫЙ
Dialogue: 0,0:10:57.13,0:10:59.85,Caption,,0,0,0,,РЕЗУЛЬТАТ И ПОЛУЧАЮТ ГОРАЗДО БОЛЬШЕ ВОЗМОЖНОСТЕЙ
Dialogue: 0,0:10:59.85,0:11:02.33,Caption,,0,0,0,,ДАВИТЬ НА АДМИНИСТРАЦИЮ ТРАМПА ЧЕРЕЗ КОНГРЕСС.
Dialogue: 0,0:11:02.72,0:11:05.45,Caption,,0,0,0,,ПОДДЕРЖКА УКРАИНЫ СНОВА СТАНОВИТСЯ ДЛЯ НИХ БОЛЬШИМ
Dialogue: 0,0:11:05.45,0:11:08.25,Caption,,0,0,0,,ПОЛИТИЧЕСКИМ ИНСТРУМЕНТОМ. ДЕНЬГИ. САНКЦИИ.
Dialogue: 0,0:11:08.46,0:11:12.01,Caption,,0,0,0,,РАССЛЕДОВАНИЯ. БЮДЖЕТ. ДАВЛЕНИЕ НА БЕЛЫЙ ДОМ. И
Dialogue: 0,0:11:12.09,0:11:14.49,Caption,,0,0,0,,ЗДЕСЬ НАЧИНАЕТСЯ ЕЩЁ ОДНА ГОНКА СО ВРЕМЕНЕМ.
Dialogue: 0,0:11:16.77,0:11:19.49,Caption,,0,0,0,,ЕСЛИ ТРАМП ХОЧЕТ ПРОВЕСТИ СОБСТВЕННУЮ БОЛЬШУЮ ЛИНИЮ
Dialogue: 0,0:11:19.57,0:11:22.93,Caption,,0,0,0,,ПО УКРАИНЕ И РОССИИ, ЕМУ ВЫГОДНО ПРОДВИГАТЬ ЕЁ СЕЙЧАС,
Dialogue: 0,0:11:23.01,0:11:25.73,Caption,,0,0,0,,ПОКА ПОЛИТИЧЕСКАЯ КОНСТРУКЦИЯ В ВАШИНГТОНЕ НЕ СТАЛА
Dialogue: 0,0:11:25.81,0:11:28.37,Caption,,0,0,0,,ДЛЯ НЕГО ЕЩЁ ТЯЖЕЛЕЕ. ПОТОМУ ЧТО ПОСЛЕ ПРИХОДА
Dialogue: 0,0:11:28.37,0:11:31.25,Caption,,0,0,0,,НОВОГО КОНГРЕССА КАЖДЫЙ БОЛЬШОЙ ШАГ МОЖНО БУДЕТ
Dialogue: 0,0:11:31.25,0:11:33.73,Caption,,0,0,0,,ПРЕВРАТИТЬ В ОТДЕЛЬНЫЙ АМЕРИКАНСКИЙ ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:11:33.73,0:11:37.25,Caption,,0,0,0,,МОРДОБОЙ. А ЕВРОПЕ ЭТО ДАЁТ НАДЕЖДУ. НЕ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:11:37.25,0:11:39.73,Caption,,0,0,0,,ПОБЕДИТЬ ТРАМПА В СПОРЕ НАПРЯМУЮ. МОЖНО ПРОСТО
Dialogue: 0,0:11:39.73,0:11:42.93,Caption,,0,0,0,,ДОЖДАТЬСЯ, КОГДА У НЕГО ДОМА ПОЯВИТСЯ БОЛЬШЕ ЛЮДЕЙ,
Dialogue: 0,0:11:43.10,0:11:45.89,Caption,,0,0,0,,ГОТОВЫХ ЦЕПЛЯТЬСЯ ЗА КАЖДОЕ РЕШЕНИЕ. ТО ЕСТЬ
Dialogue: 0,0:11:45.89,0:11:48.05,Caption,,0,0,0,,ПЕРЕГОВОРЫ ИДУТ НЕ ТОЛЬКО МЕЖДУ МОСКВОЙ,
Dialogue: 0,0:11:48.14,0:11:52.29,Caption,,0,0,0,,КИЕВОМ, ВАШИНГТОНОМ И ЕВРОПЕЙЦАМИ. У ТРАМПА ЕЩЁ ОДИН СТОЛ
Dialogue: 0,0:11:52.29,0:11:54.77,Caption,,0,0,0,,СТОИТ ПРЯМО ДОМА. И ТАМ НИКТО НЕ СОБИРАЕТСЯ
Dialogue: 0,0:11:54.77,0:11:57.49,Caption,,0,0,0,,ОБЛЕГЧАТЬ ЕМУ ЖИЗНЬ. НО ТЕПЕРЬ САМОЕ ИНТЕРЕСНОЕ.
Dialogue: 0,0:11:57.70,0:12:01.73,Caption,,0,0,0,,ДОПУСТИМ, США ПРОСТО ВЫХОДЯТ ИЗ ПРЕЖНЕЙ ЕВРОПЕЙСКОЙ ЛИНИИ. НЕ
Dialogue: 0,0:12:01.73,0:12:04.53,Caption,,0,0,0,,МЕШАЮТ. НЕ ПОМОГАЮТ. ГОВОРЯТ РЕБЯТА,
Dialogue: 0,0:12:04.77,0:12:09.57,Caption,,0,0,0,,ХОТИТЕ ДАЛЬШЕ ДАВИТЬ РОССИЮ, ДАВИТЕ САМИ. УЖЕ ЭТОГО ЕВРОПЕ ХВАТИТ ДЛЯ ОЧЕНЬ
Dialogue: 0,0:12:09.57,0:12:12.61,Caption,,0,0,0,,СЕРЬЁЗНОЙ ГОЛОВНОЙ БОЛИ. ВОЕННЫЕ РАСХОДЫ ПРИДЁТСЯ
Dialogue: 0,0:12:12.61,0:12:15.57,Caption,,0,0,0,,ТАЩИТЬ БОЛЬШЕ САМИМ. УКРАИНУ ФИНАНСИРОВАТЬ БОЛЬШЕ
Dialogue: 0,0:12:15.65,0:12:18.53,Caption,,0,0,0,,САМИМ. ОРУЖИЕ ИСКАТЬ САМИМ. ЭКОНОМИЧЕСКИЕ
Dialogue: 0,0:12:18.53,0:12:21.25,Caption,,0,0,0,,ПОСЛЕДСТВИЯ ПЕРЕВАРИВАТЬ САМИМ. РИСКИ ПРЯМОГО
Dialogue: 0,0:12:21.25,0:12:24.21,Caption,,0,0,0,,СТОЛКНОВЕНИЯ ТОЖЕ СТАНОВЯТСЯ ГОРАЗДО МЕНЕЕ УЮТНЫМИ,
Dialogue: 0,0:12:24.45,0:12:27.17,Caption,,0,0,0,,КОГДА РЯДОМ НЕТ АМЕРИКАНСКОГО ПЛЕЧА ТОГО ЖЕ РАЗМЕРА,
Dialogue: 0,0:12:27.36,0:12:29.73,Caption,,0,0,0,,ЧТО РАНЬШЕ. НО ЕСТЬ СЦЕНАРИЙ ЕЩЁ ЖЁСТЧЕ.
Dialogue: 0,0:12:32.00,0:12:34.64,Caption,,0,0,0,,НЕ СОЮЗ США И РОССИИ. НЕ НАДО СЕЙЧАС
Dialogue: 0,0:12:34.64,0:12:37.12,Caption,,0,0,0,,РИСОВАТЬ ПУТИНА С ТРАМПОМ В ОДНОМ ОКОПЕ. РЕЧЬ
Dialogue: 0,0:12:37.20,0:12:39.04,Caption,,0,0,0,,ВООБЩЕ НЕ ОБ ЭТОМ. ДОСТАТОЧНО,
Dialogue: 0,0:12:39.28,0:12:41.84,Caption,,0,0,0,,ЧТОБЫ ПО НЕСКОЛЬКИМ КЛЮЧЕВЫМ ВОПРОСАМ ИНТЕРЕСЫ
Dialogue: 0,0:12:41.84,0:12:44.96,Caption,,0,0,0,,ВАШИНГТОНА И МОСКВЫ НАЧАЛИ СОВПАДАТЬ. НАПРИМЕР,
Dialogue: 0,0:12:45.20,0:12:47.68,Caption,,0,0,0,,ВАШИНГТОН ХОЧЕТ СНИЗИТЬ РАСХОДЫ НА ЕВРОПЕЙСКУЮ
Dialogue: 0,0:12:47.68,0:12:50.40,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. МОСКВА ХОЧЕТ СОКРАТИТЬ ВОЕННОЕ
Dialogue: 0,0:12:50.48,0:12:53.60,Caption,,0,0,0,,ДАВЛЕНИЕ НАТО ВОЗЛЕ СВОИХ ГРАНИЦ. ВАШИНГТОН ХОЧЕТ
Dialogue: 0,0:12:53.60,0:12:56.72,Caption,,0,0,0,,СДЕЛКИ И ЭКОНОМИЧЕСКИЕ ПРОЕКТЫ. МОСКВА ХОЧЕТ СНЯТИЯ
Dialogue: 0,0:12:56.80,0:12:59.20,Caption,,0,0,0,,ЧАСТИ ОГРАНИЧЕНИЙ И НОРМАЛИЗАЦИИ ОТНОШЕНИЙ.
Dialogue: 0,0:12:59.60,0:13:01.84,Caption,,0,0,0,,ВАШИНГТОН НЕ ХОЧЕТ БЕСКОНЕЧНО ФИНАНСИРОВАТЬ
Dialogue: 0,0:13:01.84,0:13:04.40,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ КОНФРОНТАЦИЮ. МОСКВА ХОЧЕТ,
Dialogue: 0,0:13:04.64,0:13:07.44,Caption,,0,0,0,,ЧТОБЫ ЕВРОПА НЕ СТРОИЛА БЕЗОПАСНОСТЬ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:13:07.44,0:13:10.24,Caption,,0,0,0,,ПРОТИВ РОССИИ. И ВОТ ЕСЛИ ПО ЭТИМ ВОПРОСАМ
Dialogue: 0,0:13:10.32,0:13:15.04,Caption,,0,0,0,,НАЧИНАЕТСЯ РЕАЛЬНЫЙ ТОРГ, ЕВРОПА ПОЛУЧАЕТ СОВЕРШЕННО НОВУЮ КАРТИНУ. ПОТОМУ ЧТО
Dialogue: 0,0:13:15.04,0:13:18.08,Caption,,0,0,0,,ТОГДА АМЕРИКАНЦЫ НЕ ПРОСТО ОТХОДЯТ В СТОРОНУ. ОНИ
Dialogue: 0,0:13:18.08,0:13:19.76,Caption,,0,0,0,,НАЧИНАЮТ ДОГОВАРИВАТЬСЯ С ТЕМ,
Dialogue: 0,0:13:19.92,0:13:22.40,Caption,,0,0,0,,ПРОТИВ КОГО БЫЛА ПОСТРОЕНА ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:13:22.40,0:13:25.36,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ СТРАТЕГИИ ПОСЛЕДНИХ ЛЕТ. ДЛЯ БРЮССЕЛЯ
Dialogue: 0,0:13:25.36,0:13:28.32,Caption,,0,0,0,,ЭТО УЖЕ НЕ ПОТЕРЯ ОДНОГО ПОМОЩНИКА. ЭТО ИЗМЕНЕНИЕ
Dialogue: 0,0:13:28.40,0:13:30.88,Caption,,0,0,0,,САМОЙ ГЕОМЕТРИИ. БЫЛ ТРЕУГОЛЬНИК,
Dialogue: 0,0:13:30.97,0:13:33.36,Caption,,0,0,0,,ГДЕ США И ЕВРОПА СТОЯЛИ С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:13:33.60,0:13:36.16,Caption,,0,0,0,,РОССИЯ С ДРУГОЙ. А ПОТОМ ОДНА ВЕРШИНА БЕРЁТ
Dialogue: 0,0:13:36.16,0:13:38.88,Caption,,0,0,0,,СТУЛ И ПЕРЕСТАВЛЯЕТ ЕГО. И ПОПРОБУЙ ПОСЛЕ ЭТОГО
Dialogue: 0,0:13:38.88,0:13:42.80,Caption,,0,0,0,,ОБЪЯСНИТЬ, ЧТО ВСЁ ПО ПРЕЖНЕМУ. НЕ ПО ПРЕЖНЕМУ. ВООБЩЕ.
Dialogue: 0,0:13:45.09,0:13:47.57,Caption,,0,0,0,,ВОТ ПОЧЕМУ ИСТОРИЯ С МЕРЦЕМ НЕ ПРО ОЧЕРЕДНОЕ
Dialogue: 0,0:13:47.57,0:13:50.37,Caption,,0,0,0,,ЗАЯВЛЕНИЕ НЕМЕЦКОГО КАНЦЛЕРА. И НЕ ПРО ТО,
Dialogue: 0,0:13:50.53,0:13:53.65,Caption,,0,0,0,,ОБИДЕЛАСЬ ЕВРОПА НА ТРАМПА ИЛИ НЕ ОБИДЕЛАСЬ. ОБИДА
Dialogue: 0,0:13:53.73,0:13:56.53,Caption,,0,0,0,,В БОЛЬШОЙ ПОЛИТИКЕ ВООБЩЕ ДЕШЁВАЯ ВАЛЮТА. СЕГОДНЯ
Dialogue: 0,0:13:56.53,0:13:59.81,Caption,,0,0,0,,ОБИДЕЛИСЬ. ЗАВТРА ПОДПИСАЛИ КОНТРАКТ. ПОСЛЕЗАВТРА
Dialogue: 0,0:13:59.89,0:14:03.57,Caption,,0,0,0,,СНОВА ОБИДЕЛИСЬ. ЗДЕСЬ ВОПРОС ГОРАЗДО СЕРЬЁЗНЕЕ. КТО
Dialogue: 0,0:14:03.57,0:14:06.21,Caption,,0,0,0,,БУДЕТ ОПРЕДЕЛЯТЬ ПРАВИЛА ПОСЛЕ ОКОНЧАНИЯ УКРАИНСКОГО
Dialogue: 0,0:14:06.21,0:14:08.69,Caption,,0,0,0,,КОНФЛИКТА? США ВМЕСТЕ С ЕВРОПОЙ?
Dialogue: 0,0:14:08.85,0:14:12.61,Caption,,0,0,0,,США ОТДЕЛЬНО? РОССИЯ И США ЧЕРЕЗ СОБСТВЕННЫЙ БОЛЬШОЙ ТОРГ?
Dialogue: 0,0:14:12.93,0:14:17.09,Caption,,0,0,0,,ЕВРОПА ПОЛУЧИТ ПРАВО ВЕТО? ИЛИ ЕЁ ПОСТАВЯТ ПЕРЕД ЧАСТЬЮ УЖЕ СОГЛАСОВАННЫХ
Dialogue: 0,0:14:17.17,0:14:21.25,Caption,,0,0,0,,РЕШЕНИЙ? ВОТ ГДЕ СЕЙЧАС ПРОХОДИТ НАСТОЯЩИЙ НЕРВ. А УКРАИНА
Dialogue: 0,0:14:21.33,0:14:23.57,Caption,,0,0,0,,В ЭТОЙ КОНСТРУКЦИИ ОСТАЁТСЯ ВАЖНЕЙШЕЙ ЧАСТЬЮ
Dialogue: 0,0:14:23.57,0:14:27.09,Caption,,0,0,0,,ПЕРЕГОВОРОВ, НО УЖЕ НЕ ВСЕЙ КАРТИНОЙ. БУДАНОВ ЕДЕТ В
Dialogue: 0,0:14:27.09,0:14:30.13,Caption,,0,0,0,,АБУ ДАБИ. МЕДИНСКИЙ ЕДЕТ ТУДА ЖЕ. ОНИ СНОВА
Dialogue: 0,0:14:30.13,0:14:34.61,Caption,,0,0,0,,БУДУТ СПОРИТЬ О ВЕЩАХ, КОТОРЫЕ ОБЕ СТОРОНЫ ДАВНО ЗНАЮТ. ТАМ БУДУТ ТЯЖЁЛЫЕ
Dialogue: 0,0:14:34.61,0:14:37.57,Caption,,0,0,0,,РАЗГОВОРЫ. ТАМ БУДУТ КРАСНЫЕ ЛИНИИ. ТАМ НИКТО НЕ
Dialogue: 0,0:14:37.57,0:14:39.89,Caption,,0,0,0,,СОБИРАЕТСЯ ЗА ОДИН ВЕЧЕР ПРЕВРАТИТЬСЯ В ЛУЧШИХ
Dialogue: 0,0:14:39.89,0:14:42.29,Caption,,0,0,0,,ДРУЗЕЙ. НО ЗА ИХ СПИНАМИ УЖЕ ИДЁТ ДРУГОЙ
Dialogue: 0,0:14:42.29,0:14:47.33,Caption,,0,0,0,,РАЗГОВОР. РАЗГОВОР О ТОМ, КАКОЙ ВООБЩЕ БУДЕТ СИСТЕМА ПОСЛЕ ЭТОГО КОНФЛИКТА. И
Dialogue: 0,0:14:47.41,0:14:49.81,Caption,,0,0,0,,ВОТ В ЭТОМ РАЗГОВОРЕ ЕВРОПА ВНЕЗАПНО ОБНАРУЖИЛА
Dialogue: 0,0:14:49.81,0:14:52.77,Caption,,0,0,0,,НЕПРИЯТНУЮ ВЕЩЬ. ОНА ПРИВЫКЛА СЧИТАТЬ СОЕДИНЁННЫЕ
Dialogue: 0,0:14:52.77,0:14:58.80,Caption,,0,0,0,,ШТАТЫ ЧАСТЬЮ СВОЕЙ ПОЗИЦИИ. А ТРАМП ВСЁ НАСТОЙЧИВЕЕ ПОКАЗЫВАЕТ,
Dialogue: 0,0:14:59.04,0:15:02.08,Caption,,0,0,0,,ЧТО СОЕДИНЁННЫЕ ШТАТЫ ЭТО ОТДЕЛЬНАЯ СТРАНА СО СВОИМИ
Dialogue: 0,0:15:02.08,0:15:05.20,Caption,,0,0,0,,ИНТЕРЕСАМИ. ЗВУЧИТ БАНАЛЬНО. ТОЛЬКО ПОЧЕМУ ТО ДЛЯ
Dialogue: 0,0:15:05.20,0:15:07.76,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ ПОЛИТИКИ ПОСЛЕДНИХ ЛЕТ ЭТО ОКАЗАЛОСЬ
Dialogue: 0,0:15:07.76,0:15:10.72,Caption,,0,0,0,,ПОЧТИ РЕВОЛЮЦИОННЫМ ОТКРЫТИЕМ. ЕСЛИ ВАШИНГТОН
Dialogue: 0,0:15:10.80,0:15:14.16,Caption,,0,0,0,,ОКОНЧАТЕЛЬНО РЕШИТ, ЧТО ЕМУ ВЫГОДНЕЕ ТОРГОВАТЬСЯ С МОСКВОЙ,
Dialogue: 0,0:15:14.47,0:15:16.80,Caption,,0,0,0,,ЧЕМ ОПЛАЧИВАТЬ ПРОДОЛЖЕНИЕ СТАРОЙ КОНСТРУКЦИИ,
Dialogue: 0,0:15:17.13,0:15:20.16,Caption,,0,0,0,,МЕРЦУ ПРИДЁТСЯ ОТВЕЧАТЬ НА ОЧЕНЬ ПРОСТОЙ ВОПРОС. ЧТО
Dialogue: 0,0:15:20.16,0:15:25.68,Caption,,0,0,0,,ЕВРОПА БУДЕТ ДЕЛАТЬ САМА? НЕ ТРЕБОВАТЬ. НЕ ПРИЗЫВАТЬ. НЕ ПРОВОДИТЬ САММИТ. НЕ
Dialogue: 0,0:15:25.76,0:15:28.88,Caption,,0,0,0,,ВЫПУСКАТЬ ЗАЯВЛЕНИЕ НА ТРЁХ ЯЗЫКАХ. ДЕЛАТЬ. САМА.
Dialogue: 0,0:15:29.44,0:15:32.48,Caption,,0,0,0,,ВОТ ТОГДА И ВЫЯСНИТСЯ НАСТОЯЩАЯ ЦЕНА ВСЕХ РАЗГОВОРОВ
Dialogue: 0,0:15:32.56,0:15:35.28,Caption,,0,0,0,,О СТРАТЕГИЧЕСКОЙ САМОСТОЯТЕЛЬНОСТИ ЕВРОПЫ. ПОТОМУ
Dialogue: 0,0:15:35.36,0:15:37.28,Caption,,0,0,0,,ЧТО САМОСТОЯТЕЛЬНОСТЬ ЭТО НЕ КОГДА ТЫ САМ
Dialogue: 0,0:15:37.28,0:15:40.32,Caption,,0,0,0,,ПРОИЗНОСИШЬ РЕЧЬ. САМОСТОЯТЕЛЬНОСТЬ ЭТО КОГДА ПОСЛЕ
Dialogue: 0,0:15:40.32,0:15:42.88,Caption,,0,0,0,,РЕЧИ ТЫ САМ ОПЛАЧИВАЕШЬ СЧЁТ. И ВОТ ЭТОТ
Dialogue: 0,0:15:42.88,0:15:45.68,Caption,,0,0,0,,СЧЁТ СЕЙЧАС МЕДЛЕННО НЕСУТ К ЕВРОПЕЙСКОМУ СТОЛИКУ.
