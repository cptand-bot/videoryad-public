Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,НУ ЧТО, С ПРИНУДИТЕЛЬНОЙ МОБИЛИЗАЦИЕЙ НА УКРАИНЕ,
Dialogue: 0,0:00:03.11,0:00:06.44,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, ПОКОНЧЕНО! ВСЁ, ПРОБЛЕМУ РЕШИЛИ,
Dialogue: 0,0:00:06.60,0:00:11.08,Caption,,0,0,0,,МОЖНО ПОЗДРАВЛЯТЬ. ПРАВДА, ПОЧЕМУ ТО ПРОДОЛЖАЮТ ИСКАТЬ НОВЫЕ СПОСОБЫ ДОБРАТЬСЯ
Dialogue: 0,0:00:11.16,0:00:14.52,Caption,,0,0,0,,ДО МУЖЧИН, А ИЗ СТРАНЫ ЭТОЙ ЗИМОЙ РИСКУЮТ УЕХАТЬ МИЛЛИОНЫ
Dialogue: 0,0:00:14.52,0:00:17.80,Caption,,0,0,0,,ЛЮДЕЙ. НО ЭТО, ВИДИМО, ТАКИЕ МЕЛОЧИ,
Dialogue: 0,0:00:18.04,0:00:20.04,Caption,,0,0,0,,НА КОТОРЫЕ ОБРАЩАТЬ ВНИМАНИЕ НЕОБЯЗАТЕЛЬНО.
Dialogue: 0,0:00:20.60,0:00:22.92,Caption,,0,0,0,,ГОРАЗДО ИНТЕРЕСНЕЕ ДРУГОЕ. ПОКА НАВЕРХУ
Dialogue: 0,0:00:22.92,0:00:25.40,Caption,,0,0,0,,РАССКАЗЫВАЮТ, КАК ЗАМЕЧАТЕЛЬНО ОБСТОЯТ ДЕЛА,
Dialogue: 0,0:00:25.55,0:00:29.64,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ ПОДРОБНОСТИ, ПОСЛЕ КОТОРЫХ ХОЧЕТСЯ СПРОСИТЬ ОНИ ВООБЩЕ ПОНИМАЮТ,
Dialogue: 0,0:00:29.80,0:00:33.72,Caption,,0,0,0,,ДО ЧЕГО УЖЕ ДОШЛО? ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР БЕЗ ЛИШНЕЙ МИШУРЫ,
Dialogue: 0,0:00:33.96,0:00:36.60,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ КАК РАЗ ИНТЕРЕСНО НЕ
Dialogue: 0,0:00:36.60,0:00:39.08,Caption,,0,0,0,,ТО, ЧТО ЧИНОВНИКИ ГОВОРЯТ ПО ОТДЕЛЬНОСТИ,
Dialogue: 0,0:00:39.40,0:00:43.32,Caption,,0,0,0,,А ЧТО ПОЛУЧАЕТСЯ, КОГДА ПОСТАВИТЬ ИХ ЗАЯВЛЕНИЯ РЯДОМ. ДО ДВУХ С
Dialogue: 0,0:00:43.32,0:00:45.80,Caption,,0,0,0,,ПОЛОВИНОЙ МИЛЛИОНОВ ЧЕЛОВЕК МОГУТ ПОКИНУТЬ УКРАИНУ
Dialogue: 0,0:00:45.80,0:00:48.84,Caption,,0,0,0,,ЭТОЙ ЗИМОЙ. ПРИЧИНА ВПОЛНЕ ЗЕМНАЯ. СВЕТ,
Dialogue: 0,0:00:48.95,0:00:51.96,Caption,,0,0,0,,ОТОПЛЕНИЕ И СОСТОЯНИЕ ЭНЕРГЕТИЧЕСКОЙ ИНФРАСТРУКТУРЫ.
Dialogue: 0,0:00:52.47,0:00:54.76,Caption,,0,0,0,,ЧЕМ ДОЛЬШЕ КРУПНЫЙ ГОРОД ЖИВЁТ С ПРОДОЛЖИТЕЛЬНЫМИ
Dialogue: 0,0:00:54.76,0:00:58.44,Caption,,0,0,0,,ОТКЛЮЧЕНИЯМИ, ТЕМ БЫСТРЕЕ ОБЫЧНЫЙ БЫТОВОЙ ВОПРОС ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:00:58.52,0:01:01.48,Caption,,0,0,0,,ВОПРОС ОТЪЕЗДА. ЗДЕСЬ УЖЕ НЕ НУЖНЫ НИКАКИЕ БОЛЬШИЕ
Dialogue: 0,0:01:01.48,0:01:04.36,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ ТЕОРИИ. ЧЕЛОВЕК МОЖЕТ СКОЛЬКО УГОДНО
Dialogue: 0,0:01:04.44,0:01:07.80,Caption,,0,0,0,,СЛУШАТЬ ПРАВИЛЬНЫЕ РЕЧИ, НО ЖИТЬ ЕМУ ПРИХОДИТСЯ НЕ В РЕЧИ,
Dialogue: 0,0:01:07.95,0:01:10.76,Caption,,0,0,0,,А В СОБСТВЕННОЙ КВАРТИРЕ. ЭТУ ОЦЕНКУ ПРИВОДИТ
Dialogue: 0,0:01:10.76,0:01:16.80,Caption,,0,0,0,,RZECZPOSPOLITA. ПРИЧЁМ ОСОБЕННО УЯЗВИМЫМИ НАЗЫВАЮТСЯ КРУПНЫЕ ГОРОДА.
Dialogue: 0,0:01:17.20,0:01:19.52,Caption,,0,0,0,,И ЭТО ВАЖНАЯ ДЕТАЛЬ. КОГДА РЕЧЬ ИДЁТ О
Dialogue: 0,0:01:19.52,0:01:24.40,Caption,,0,0,0,,НЕБОЛЬШОМ НАСЕЛЁННОМ ПУНКТЕ, ПРОБЛЕМА ОСТАЁТСЯ ЛОКАЛЬНОЙ. КОГДА ТЕ ЖЕ ПРОБЛЕМЫ
Dialogue: 0,0:01:24.40,0:01:27.12,Caption,,0,0,0,,ПРИХОДЯТ В ОГРОМНЫЙ ГОРОД, КОЛИЧЕСТВО ЛЮДЕЙ,
Dialogue: 0,0:01:27.20,0:01:29.68,Caption,,0,0,0,,КОТОРЫЕ ОДНОВРЕМЕННО НАЧИНАЮТ ДУМАТЬ ОБ ОДНОМ И ТОМ
Dialogue: 0,0:01:29.76,0:01:33.44,Caption,,0,0,0,,ЖЕ, СТАНОВИТСЯ СОВСЕМ ДРУГИМ. ПОЭТОМУ МАСШТАБ МИГРАЦИИ
Dialogue: 0,0:01:33.52,0:01:37.52,Caption,,0,0,0,,ПРЯМО ПРИВЯЗЫВАЮТ К ТОМУ, В КАКОМ СОСТОЯНИИ ОСТАНЕТСЯ ЭНЕРГЕТИЧЕСКАЯ
Dialogue: 0,0:01:37.52,0:01:40.64,Caption,,0,0,0,,ИНФРАСТРУКТУРА. И РЕЧЬ ИДЁТ НЕ О НЕСКОЛЬКИХ ДЕСЯТКАХ
Dialogue: 0,0:01:40.72,0:01:44.24,Caption,,0,0,0,,ТЫСЯЧ ЧЕЛОВЕК, КОТОРЫХ МОЖНО ПОЧТИ НЕ ЗАМЕТИТЬ В ОБЩЕЙ СТАТИСТИКЕ.
Dialogue: 0,0:01:44.56,0:01:49.28,Caption,,0,0,0,,ДВА С ПОЛОВИНОЙ МИЛЛИОНА, ЭТО ОГРОМНАЯ МАССА ЛЮДЕЙ. ЕСЛИ ЗНАЧИТЕЛЬНАЯ ЧАСТЬ
Dialogue: 0,0:01:49.28,0:01:52.00,Caption,,0,0,0,,ТАКОГО ПОТОКА ДЕЙСТВИТЕЛЬНО ПОЙДЁТ ЧЕРЕЗ ГРАНИЦУ,
Dialogue: 0,0:01:52.16,0:01:54.16,Caption,,0,0,0,,УКРАИНА ПОТЕРЯЕТ НЕ ТОЛЬКО ПОТРЕБИТЕЛЕЙ
Dialogue: 0,0:01:54.16,0:01:57.12,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВА И ОТОПЛЕНИЯ. ОНА ПОТЕРЯЕТ РАБОТНИКОВ,
Dialogue: 0,0:01:57.20,0:01:59.36,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКОВ, СПЕЦИАЛИСТОВ,
Dialogue: 0,0:01:59.44,0:02:03.04,Caption,,0,0,0,,СЕМЬИ, МУЖЧИН И ЖЕНЩИН ТРУДОСПОСОБНОГО ВОЗРАСТА. ТО ЕСТЬ
Dialogue: 0,0:02:03.05,0:02:06.88,Caption,,0,0,0,,ИМЕННО ТЕХ ЛЮДЕЙ, КОТОРЫХ ГОСУДАРСТВУ СЕЙЧАС ОСОБЕННО НЕ ХВАТАЕТ.
Dialogue: 0,0:02:07.28,0:02:09.92,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ. С ОДНОЙ
Dialogue: 0,0:02:09.92,0:02:12.72,Caption,,0,0,0,,СТОРОНЫ, СТРАНЕ НУЖНЫ ЛЮДИ. С ДРУГОЙ СТОРОНЫ,
Dialogue: 0,0:02:12.83,0:02:16.00,Caption,,0,0,0,,УСЛОВИЯ ЖИЗНИ СПОСОБНЫ ВЫТАЛКИВАТЬ ИХ НАРУЖУ. И ЧЕМ
Dialogue: 0,0:02:16.08,0:02:19.84,Caption,,0,0,0,,ХУЖЕ ПЕРЕЖИВАЕТСЯ ЗИМА, ТЕМ ТРУДНЕЕ ПОТОМ ОБЪЯСНИТЬ ЧЕЛОВЕКУ,
Dialogue: 0,0:02:20.00,0:02:22.24,Caption,,0,0,0,,ПОЧЕМУ ОН ДОЛЖЕН ОСТАТЬСЯ ИМЕННО ТАМ,
Dialogue: 0,0:02:22.49,0:02:24.88,Caption,,0,0,0,,ГДЕ ГОСУДАРСТВО ОДНОВРЕМЕННО ТРЕБУЕТ ОТ НЕГО ВСЁ
Dialogue: 0,0:02:24.88,0:02:30.19,Caption,,0,0,0,,БОЛЬШЕ. И ВОТ НА ЭТОМ ФОНЕ ДЕПУТАТ ВЕНИСЛАВСКИЙ ЗАЯВЛЯЕТ,
Dialogue: 0,0:02:30.51,0:02:33.07,Caption,,0,0,0,,ЧТО ПРИНУДИТЕЛЬНАЯ МОБИЛИЗАЦИЯ В УКРАИНЕ СВЕДЕНА К
Dialogue: 0,0:02:33.15,0:02:36.11,Caption,,0,0,0,,НУЛЮ. ИМЕННО ТАК. К НУЛЮ. МОЖНО БЫЛО БЫ
Dialogue: 0,0:02:36.11,0:02:38.83,Caption,,0,0,0,,ПОСТАВИТЬ ТОЧКУ И РАЗОЙТИСЬ. ПРОБЛЕМА РЕШЕНА,
Dialogue: 0,0:02:38.92,0:02:43.15,Caption,,0,0,0,,ГРАЖДАНЕ ДОВОЛЬНЫ, ЧИНОВНИКИ ТОЖЕ ДОВОЛЬНЫ. ОСТАЛОСЬ ТОЛЬКО ОБЪЯСНИТЬ,
Dialogue: 0,0:02:43.38,0:02:45.87,Caption,,0,0,0,,ПОЧЕМУ ВОКРУГ ЭТОЙ ЗАМЕЧАТЕЛЬНОЙ ПОБЕДЫ ПРОДОЛЖАЮТ
Dialogue: 0,0:02:45.87,0:02:48.19,Caption,,0,0,0,,ПОЯВЛЯТЬСЯ СООБЩЕНИЯ О НАРУШЕНИЯХ СО СТОРОНЫ
Dialogue: 0,0:02:48.19,0:02:51.07,Caption,,0,0,0,,СОТРУДНИКОВ ТЦК И ОГРАНИЧЕНИЯХ ПРАВ ГРАЖДАН.
Dialogue: 0,0:02:51.47,0:02:54.35,Caption,,0,0,0,,ЗАЯВЛЕНИЕ ВЫГЛЯДИТ ОСОБЕННО ИНТЕРЕСНО ИМЕННО ПОТОМУ,
Dialogue: 0,0:02:54.51,0:02:57.47,Caption,,0,0,0,,ЧТО ОНО НЕ СУЩЕСТВУЕТ В ПУСТОТЕ. ЛЮДИ СЛЫШАТ
Dialogue: 0,0:02:57.55,0:03:01.47,Caption,,0,0,0,,СЛОВА ПРО НОЛЬ, А ЗАТЕМ ВИДЯТ СОВЕРШЕННО ДРУГУЮ КАРТИНУ В РАССКАЗАХ,
Dialogue: 0,0:03:01.57,0:03:04.03,Caption,,0,0,0,,ВИДЕО И МНОГОЧИСЛЕННЫХ СООБЩЕНИЯХ О РАБОТЕ ТЦК.
Dialogue: 0,0:03:04.91,0:03:07.23,Caption,,0,0,0,,И ТУТ ВОПРОС ДАЖЕ НЕ В КРАСИВОЙ ФОРМУЛИРОВКЕ
Dialogue: 0,0:03:07.23,0:03:11.95,Caption,,0,0,0,,ДЕПУТАТА. ВОПРОС В ТОМ, ЧЕМУ ЧЕЛОВЕК ВЕРИТ БОЛЬШЕ ОФИЦИАЛЬНОМУ НУЛЮ ИЛИ
Dialogue: 0,0:03:12.03,0:03:15.55,Caption,,0,0,0,,ТОМУ, ЧТО ПРОИСХОДИТ ВОКРУГ НЕГО. А СРАЗУ РЯДОМ ПОЯВЛЯЕТСЯ
Dialogue: 0,0:03:15.63,0:03:18.75,Caption,,0,0,0,,ЕЩЁ ОДНА ИСТОРИЯ. В УКРАИНЕ ПОДРОСТКОВ ЯКОБЫ НАЧАЛИ
Dialogue: 0,0:03:18.75,0:03:22.91,Caption,,0,0,0,,ПРИВЛЕКАТЬ К ПОИСКУ МУЖЧИН, КОТОРЫЕ ИЗБЕГАЮТ МОБИЛИЗАЦИИ. ПО ЭТОЙ
Dialogue: 0,0:03:22.91,0:03:27.31,Caption,,0,0,0,,НЕПОДТВЕРЖДЁННОЙ ВЕРСИИ, НЕСОВЕРШЕННОЛЕТНИМ ПЛАТЯТ ПО ДВЕ ТЫСЯЧИ ГРИВЕН ЗА
Dialogue: 0,0:03:27.39,0:03:29.95,Caption,,0,0,0,,СВЕДЕНИЯ О МЕСТНЫХ ЖИТЕЛЯХ. ОБОШЁЛ ДВОРЫ,
Dialogue: 0,0:03:30.19,0:03:32.91,Caption,,0,0,0,,ВЫЯСНИЛ, КТО ГДЕ ЖИВЁТ, ПЕРЕДАЛ ДАННЫЕ,
Dialogue: 0,0:03:33.00,0:03:36.11,Caption,,0,0,0,,ПОЛУЧИЛ ДЕНЬГИ. ОТЛИЧНАЯ ВОСПИТАТЕЛЬНАЯ ПРОГРАММА.
Dialogue: 0,0:03:36.51,0:03:39.07,Caption,,0,0,0,,ОСТАЛОСЬ ТОЛЬКО ЗНАЧКИ ВРУЧАТЬ ЗА ОСОБО УДАЧНЫЙ
Dialogue: 0,0:03:39.07,0:03:45.04,Caption,,0,0,0,,ПОИСК СОСЕДА. СХЕМА ОПИСЫВАЕТСЯ ДОВОЛЬНО ПРОСТО. ПОДРОСТОК
Dialogue: 0,0:03:45.04,0:03:47.68,Caption,,0,0,0,,СОБИРАЕТ ИНФОРМАЦИЮ О МУЖЧИНАХ ПО МЕСТУ ЖИТЕЛЬСТВА,
Dialogue: 0,0:03:48.00,0:03:50.48,Caption,,0,0,0,,ПОСЛЕ ЧЕГО СВЕДЕНИЯ ПЕРЕДАЮТСЯ ДЛЯ ПОСЛЕДУЮЩИХ
Dialogue: 0,0:03:50.48,0:03:53.28,Caption,,0,0,0,,ПРОВЕРОК. И ВОТ ТУТ ЗАЯВЛЕНИЕ О СВЕДЁННОЙ К
Dialogue: 0,0:03:53.28,0:03:56.24,Caption,,0,0,0,,НУЛЮ ПРИНУДИТЕЛЬНОЙ МОБИЛИЗАЦИИ НАЧИНАЕТ ЗВУЧАТЬ
Dialogue: 0,0:03:56.24,0:03:59.20,Caption,,0,0,0,,СОВСЕМ ОСОБЕННО. ПОТОМУ ЧТО ЕСЛИ ДЛЯ ПОИСКА ЛЮДЕЙ
Dialogue: 0,0:03:59.20,0:04:03.12,Caption,,0,0,0,,УЖЕ ПОДКЛЮЧАЮТ ТЕХ, КТО ВООБЩЕ НЕ ИМЕЕТ ОТНОШЕНИЯ К МОБИЛИЗАЦИОННОЙ
Dialogue: 0,0:04:03.12,0:04:06.72,Caption,,0,0,0,,СИСТЕМЕ, ЗНАЧИТ ПРОБЛЕМА С ПОИСКОМ МУЖЧИН НИКУДА НЕ ДЕЛАСЬ.
Dialogue: 0,0:04:07.12,0:04:09.76,Caption,,0,0,0,,ДАЖЕ САМА ОПИСАННАЯ КОНСТРУКЦИЯ ГОВОРИТ О МНОГОМ.
Dialogue: 0,0:04:10.08,0:04:12.56,Caption,,0,0,0,,ОФИЦИАЛЬНОГО СОТРУДНИКА ТЦК ЧЕЛОВЕК ХОТЯ БЫ
Dialogue: 0,0:04:12.56,0:04:15.92,Caption,,0,0,0,,ПОНИМАЕТ, КТО ПЕРЕД НИМ. А ПОДРОСТОК ИЗ СОСЕДНЕГО ДВОРА
Dialogue: 0,0:04:16.00,0:04:18.64,Caption,,0,0,0,,НЕ ВЫГЛЯДИТ ЧАСТЬЮ ГОСУДАРСТВЕННОЙ СИСТЕМЫ. ОН
Dialogue: 0,0:04:18.72,0:04:21.44,Caption,,0,0,0,,ПРОСТО ХОДИТ РЯДОМ, ЗНАЕТ, КТО ГДЕ ЖИВЁТ,
Dialogue: 0,0:04:21.68,0:04:24.00,Caption,,0,0,0,,КТО ДАВНО НЕ ПОЯВЛЯЛСЯ И КТО СТАРАЕТСЯ МЕНЬШЕ
Dialogue: 0,0:04:24.00,0:04:26.96,Caption,,0,0,0,,ПОПАДАТЬСЯ НА ГЛАЗА. И ТОГДА ПОИСК СТАНОВИТСЯ УЖЕ
Dialogue: 0,0:04:27.04,0:04:30.72,Caption,,0,0,0,,НЕ ТОЛЬКО ОФИЦИАЛЬНЫМ, НО И БЫТОВЫМ. УЖЕ НЕ СИСТЕМА ПРИХОДИТ ВО
Dialogue: 0,0:04:30.80,0:04:34.00,Caption,,0,0,0,,ДВОР. САМ ДВОР НАЧИНАЕТ РАБОТАТЬ НА СИСТЕМУ. И
Dialogue: 0,0:04:34.08,0:04:36.32,Caption,,0,0,0,,ВСЁ ЭТО РЯДОМ С ТЕМ САМЫМ НУЛЁМ. НО
Dialogue: 0,0:04:36.32,0:04:39.44,Caption,,0,0,0,,КИЕВУ ЭТОГО МАЛО. ЕСТЬ НЕПОДТВЕРЖДЁННАЯ ИНФОРМАЦИЯ,
Dialogue: 0,0:04:39.68,0:04:42.24,Caption,,0,0,0,,ЧТО БАНКОВАЯ ГОТОВИТ СОКРАЩЕНИЕ БРОНИРОВАНИЯ
Dialogue: 0,0:04:42.24,0:04:45.84,Caption,,0,0,0,,РАБОТНИКОВ, ЧТОБЫ УВЕЛИЧИТЬ МОБИЛИЗАЦИОННЫЙ РЕЗЕРВ. ТО ЕСТЬ
Dialogue: 0,0:04:45.84,0:04:50.08,Caption,,0,0,0,,ПОДОЙТИ ХОТЯТ УЖЕ К ТЕМ, КОГО ПОКА ОСТАВЛЯЛИ РАБОТАТЬ НА КРИТИЧЕСКИ ВАЖНЫХ
Dialogue: 0,0:04:50.08,0:04:53.36,Caption,,0,0,0,,ПРЕДПРИЯТИЯХ. ЛОГИКА ПОНЯТНА. АРМИИ НУЖНЫ ЛЮДИ.
Dialogue: 0,0:04:55.64,0:04:58.04,Caption,,0,0,0,,ТОЛЬКО ЭКОНОМИКА ТОЖЕ ПОЧЕМУ ТО ОТКАЗЫВАЕТСЯ
Dialogue: 0,0:04:58.04,0:05:01.08,Caption,,0,0,0,,РАБОТАТЬ БЕЗ ЛЮДЕЙ. ВОТ НЕЗАДАЧА. БРОНЬ ВООБЩЕ
Dialogue: 0,0:05:01.08,0:05:04.44,Caption,,0,0,0,,СУЩЕСТВУЕТ НЕ РАДИ КРАСОТЫ БУМАЖКИ. ОНА ОЗНАЧАЕТ,
Dialogue: 0,0:05:04.60,0:05:07.40,Caption,,0,0,0,,ЧТО КОНКРЕТНЫЙ ЧЕЛОВЕК НУЖЕН НА КОНКРЕТНОМ МЕСТЕ.
Dialogue: 0,0:05:07.80,0:05:12.76,Caption,,0,0,0,,ЕСЛИ ЭТУ ЗАЩИТУ СОКРАЩАЮТ, ЧЕЛОВЕК СТАНОВИТСЯ ДОСТУПЕН ДЛЯ МОБИЛИЗАЦИИ. АРМИЯ
Dialogue: 0,0:05:12.84,0:05:15.96,Caption,,0,0,0,,ПОЛУЧАЕТ ДОПОЛНИТЕЛЬНЫЙ РЕСУРС. НО ПРЕДПРИЯТИЕ ЭТОГО
Dialogue: 0,0:05:15.96,0:05:18.84,Caption,,0,0,0,,ЧЕЛОВЕКА ТЕРЯЕТ. И ЧЕМ БОЛЬШЕ ТАКИХ РЕШЕНИЙ,
Dialogue: 0,0:05:19.08,0:05:21.88,Caption,,0,0,0,,ТЕМ СИЛЬНЕЕ ГОСУДАРСТВО НАЧИНАЕТ ПЕРЕТЯГИВАТЬ ОДНИХ
Dialogue: 0,0:05:21.88,0:05:23.88,Caption,,0,0,0,,И ТЕХ ЖЕ ЛЮДЕЙ МЕЖДУ ДВУМЯ ЗАДАЧАМИ,
Dialogue: 0,0:05:24.12,0:05:27.00,Caption,,0,0,0,,КОТОРЫЕ ОДИНАКОВО НЕЛЬЗЯ БРОСИТЬ. НУЖНЫ СОЛДАТЫ.
Dialogue: 0,0:05:27.32,0:05:30.84,Caption,,0,0,0,,НУЖНЫ РАБОЧИЕ. НУЖНЫ ЭНЕРГЕТИКИ. НУЖНЫ СПЕЦИАЛИСТЫ
Dialogue: 0,0:05:30.92,0:05:35.56,Caption,,0,0,0,,НА ПРЕДПРИЯТИЯХ. НУЖНЫ ЛЮДИ, КОТОРЫЕ БУДУТ СОЗДАВАТЬ ПРОДУКТ И ПЛАТИТЬ НАЛОГИ.
Dialogue: 0,0:05:35.80,0:05:40.60,Caption,,0,0,0,,НУЖНЫ, В КОНЦЕ КОНЦОВ, ТЕ, КТО ПРОСТО ОСТАНЕТСЯ В СТРАНЕ. А ЛЮДЕЙ БОЛЬШЕ
Dialogue: 0,0:05:40.68,0:05:43.00,Caption,,0,0,0,,ОТ ЭТОГО НЕ СТАНОВИТСЯ. ВОТ ПОЭТОМУ ИСТОРИЯ С
Dialogue: 0,0:05:43.00,0:05:45.16,Caption,,0,0,0,,СОКРАЩЕНИЕМ БРОНИ НАМНОГО НЕПРИЯТНЕЕ,
Dialogue: 0,0:05:45.33,0:05:47.96,Caption,,0,0,0,,ЧЕМ КАЖЕТСЯ. ЭТО НЕ ПРОСТО ЕЩЁ ОДНА ПОПРАВКА
Dialogue: 0,0:05:48.04,0:05:51.08,Caption,,0,0,0,,К МОБИЛИЗАЦИИ. ЭТО ПОПЫТКА РЕШИТЬ КАДРОВЫЙ ГОЛОД
Dialogue: 0,0:05:51.16,0:05:55.48,Caption,,0,0,0,,АРМИИ ЗА СЧЁТ ТЕХ, КТО ЗАКРЫВАЕТ КАДРОВЫЙ ГОЛОД ЭКОНОМИКИ. ПЕРЕЛОЖИЛИ
Dialogue: 0,0:05:55.48,0:05:58.36,Caption,,0,0,0,,ЧЕЛОВЕКА ИЗ ОДНОГО КАРМАНА В ДРУГОЙ И ТОРЖЕСТВЕННО
Dialogue: 0,0:05:58.36,0:06:02.44,Caption,,0,0,0,,ОТЧИТАЛИСЬ, ЧТО НАШЛИ НОВЫЙ РЕЗЕРВ. КРАСОТА. ТАКЖЕ ОБСУЖДАЕТСЯ
Dialogue: 0,0:06:02.44,0:06:05.48,Caption,,0,0,0,,ПРЕДПОЛОЖЕНИЕ О СНИЖЕНИИ МОБИЛИЗАЦИОННОГО ВОЗРАСТА.
Dialogue: 0,0:06:05.67,0:06:07.40,Caption,,0,0,0,,ТО ЕСТЬ РЕЗЕРВ ИЩУТ УЖЕ НЕ В ОДНОМ
Dialogue: 0,0:06:07.40,0:06:10.97,Caption,,0,0,0,,МЕСТЕ. СНАЧАЛА БРОНЬ,
Dialogue: 0,0:06:11.13,0:06:13.37,Caption,,0,0,0,,ПОТОМ ВОЗРАСТ, ПАРАЛЛЕЛЬНО ПОИСК ТЕХ,
Dialogue: 0,0:06:13.44,0:06:15.29,Caption,,0,0,0,,КТО УЖЕ СТАРАЕТСЯ НЕ ПОПАДАТЬСЯ ТЦК.
Dialogue: 0,0:06:15.85,0:06:17.45,Caption,,0,0,0,,И ВСЁ ЭТО ПРОИСХОДИТ В СТРАНЕ,
Dialogue: 0,0:06:17.68,0:06:19.85,Caption,,0,0,0,,ОТКУДА ЗА ОДНУ ЗИМУ МОГУТ УЕХАТЬ ДО ДВУХ
Dialogue: 0,0:06:19.93,0:06:22.81,Caption,,0,0,0,,С ПОЛОВИНОЙ МИЛЛИОНОВ ЧЕЛОВЕК. САМОЕ НЕПРИЯТНОЕ
Dialogue: 0,0:06:22.89,0:06:25.77,Caption,,0,0,0,,ЗДЕСЬ ДАЖЕ НЕ КАЖДОЕ РЕШЕНИЕ ПО ОТДЕЛЬНОСТИ. САМОЕ
Dialogue: 0,0:06:25.77,0:06:29.21,Caption,,0,0,0,,НЕПРИЯТНОЕ, ЧТО ВСЕ ОНИ НАЧИНАЮТ РАБОТАТЬ ДРУГ ПРОТИВ ДРУГА.
Dialogue: 0,0:06:29.44,0:06:32.09,Caption,,0,0,0,,ЧЕМ ЖЁСТЧЕ ПОИСК ДОПОЛНИТЕЛЬНОГО МОБИЛИЗАЦИОННОГО
Dialogue: 0,0:06:32.09,0:06:35.37,Caption,,0,0,0,,РЕСУРСА, ТЕМ БОЛЬШЕ ПРИЧИН У ЧАСТИ ЛЮДЕЙ ЗАДУМЫВАТЬСЯ ОБ
Dialogue: 0,0:06:35.37,0:06:37.93,Caption,,0,0,0,,ОТЪЕЗДЕ. ЧЕМ БОЛЬШЕ ЛЮДЕЙ УЕЗЖАЕТ,
Dialogue: 0,0:06:38.20,0:06:40.73,Caption,,0,0,0,,ТЕМ МЕНЬШЕ ОСТАЁТСЯ РАБОТНИКОВ И ПОТЕНЦИАЛЬНОГО
Dialogue: 0,0:06:40.73,0:06:43.45,Caption,,0,0,0,,МОБИЛИЗАЦИОННОГО РЕСУРСА. А ЧЕМ МЕНЬШЕ ЛЮДЕЙ
Dialogue: 0,0:06:43.45,0:06:47.29,Caption,,0,0,0,,ОСТАЁТСЯ, ТЕМ СИЛЬНЕЕ ЖЕЛАНИЕ ГОСУДАРСТВА ИСКАТЬ НОВЫЕ РЕЗЕРВЫ
Dialogue: 0,0:06:47.37,0:06:51.13,Caption,,0,0,0,,СРЕДИ ТЕХ, КТО ЕЩЁ НИКУДА НЕ УЕХАЛ. ПОЛУЧАЕТСЯ ТАКОЙ КРУГ,
Dialogue: 0,0:06:51.28,0:06:53.77,Caption,,0,0,0,,ИЗ КОТОРОГО ОЧЕНЬ УДОБНО ВЫХОДИТЬ ТОЛЬКО НА БУМАГЕ.
Dialogue: 0,0:06:54.17,0:06:58.33,Caption,,0,0,0,,ЕСЛИ ВЫ ЕЩЁ НЕ ПОДПИСАЛИСЬ, САМОЕ ВРЕМЯ ЭТО СДЕЛАТЬ. ПОТОМУ ЧТО ДАЛЬШЕ
Dialogue: 0,0:06:58.41,0:07:01.45,Caption,,0,0,0,,НАЧИНАЕТСЯ ДРУГАЯ ЧАСТЬ ЭТОЙ ИСТОРИИ. ТАМ УЖЕ ИЩУТ
Dialogue: 0,0:07:01.45,0:07:04.25,Caption,,0,0,0,,НЕ РЯДОВЫХ МУЖЧИН, А РЫЧАГИ ВЛИЯНИЯ НАВЕРХУ.
Dialogue: 0,0:07:04.81,0:07:07.05,Caption,,0,0,0,,ГЕНЕРАЛ СБУ СЕРГЕЙ ДУКА УТВЕРЖДАЕТ,
Dialogue: 0,0:07:07.37,0:07:09.93,Caption,,0,0,0,,ЧТО МАТЕРИАЛЫ ДЛЯ ПОДОЗРЕНИЯ ДИРЕКТОРУ НАБУ СЕМЁНУ
Dialogue: 0,0:07:09.93,0:07:12.41,Caption,,0,0,0,,КРИВОНОСУ БЫЛИ ПОДГОТОВЛЕНЫ ЕЩЁ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:07:12.41,0:07:15.05,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТОМ ГОДУ. НО ПОЧТИ ГОД ДЕЛО НЕ
Dialogue: 0,0:07:15.13,0:07:17.37,Caption,,0,0,0,,ДВИГАЛОСЬ, ПОТОМУ ЧТО, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:07:17.75,0:07:20.41,Caption,,0,0,0,,НЕ БЫЛО ПОЛИТИЧЕСКОГО РЕШЕНИЯ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:07:20.41,0:07:23.05,Caption,,0,0,0,,ИНТЕРЕСНЕЕ ОБЫЧНОЙ ПЕРЕПАЛКИ МЕЖДУ СИЛОВИКАМИ.
Dialogue: 0,0:07:25.24,0:07:27.41,Caption,,0,0,0,,МАТЕРИАЛЫ ВРОДЕ ЕСТЬ. ОСНОВАНИЯ,
Dialogue: 0,0:07:27.57,0:07:32.37,Caption,,0,0,0,,КАК УТВЕРЖДАЕТ ДУКА, ЕСТЬ. А ПОДОЗРЕНИЯ НЕТ. НЕ ХВАТАЕТ НЕ ДОКУМЕНТА,
Dialogue: 0,0:07:32.53,0:07:35.17,Caption,,0,0,0,,НЕ ЕЩЁ ОДНОЙ ПАПКИ И НЕ КРАСИВОГО ЗАЯВЛЕНИЯ.
Dialogue: 0,0:07:35.57,0:07:38.53,Caption,,0,0,0,,НЕ ХВАТАЕТ ПОЛИТИЧЕСКОГО РЕШЕНИЯ. И СРАЗУ ВОЗНИКАЕТ
Dialogue: 0,0:07:38.61,0:07:41.57,Caption,,0,0,0,,ПРОСТОЙ ВОПРОС. ЕСЛИ ЗАПУСК ТАКОГО ДЕЛА ЗАВИСИТ ОТ
Dialogue: 0,0:07:41.65,0:07:45.17,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО РЕШЕНИЯ, ТО ГДЕ ЗАКАНЧИВАЕТСЯ УГОЛОВНАЯ ПРОЦЕДУРА И
Dialogue: 0,0:07:45.17,0:07:48.05,Caption,,0,0,0,,НАЧИНАЕТСЯ ПОЛИТИКА? ПОТОМУ ЧТО ДИРЕКТОР НАБУ,
Dialogue: 0,0:07:48.21,0:07:50.45,Caption,,0,0,0,,ЭТО НЕ РАЙОННЫЙ ЧИНОВНИК. ЭТО РУКОВОДИТЕЛЬ
Dialogue: 0,0:07:50.45,0:07:54.37,Caption,,0,0,0,,СТРУКТУРЫ, КОТОРАЯ ДОЛЖНА РАССЛЕДОВАТЬ КОРРУПЦИОННЫЕ ДЕЛА. ЕСЛИ
Dialogue: 0,0:07:54.37,0:07:57.25,Caption,,0,0,0,,МАТЕРИАЛЫ ПРОТИВ НЕГО ДЕЙСТВИТЕЛЬНО ЛЕЖАЛИ ПОЧТИ ГОД
Dialogue: 0,0:07:57.33,0:08:01.89,Caption,,0,0,0,,И ЖДАЛИ РЕШЕНИЯ СВЕРХУ, ТОГДА САМА ПАУЗА СТАНОВИТСЯ ВАЖНЕЕ МНОГИХ ГРОМКИХ
Dialogue: 0,0:08:01.89,0:08:04.69,Caption,,0,0,0,,ОБВИНЕНИЙ. ДУКА ЗАТРАГИВАЕТ И РОЛЬ РУКОВОДСТВА
Dialogue: 0,0:08:04.69,0:08:06.93,Caption,,0,0,0,,ГЕНЕРАЛЬНОЙ ПРОКУРАТУРЫ. ТО ЕСТЬ ИСТОРИЯ
Dialogue: 0,0:08:06.93,0:08:09.65,Caption,,0,0,0,,РАСШИРЯЕТСЯ. ВОПРОС УЖЕ НЕ ТОЛЬКО В КРИВОНОСЕ И
Dialogue: 0,0:08:09.73,0:08:12.85,Caption,,0,0,0,,НЕ ТОЛЬКО В ТОМ, ЧТО ЛЕЖАЛО В МАТЕРИАЛАХ. ВОПРОС В ТОМ,
Dialogue: 0,0:08:13.17,0:08:16.21,Caption,,0,0,0,,КТО ИМЕЕТ ВОЗМОЖНОСТЬ ОТКРЫТЬ ШЛЮЗ. СЕГОДНЯ ПАПКА
Dialogue: 0,0:08:16.29,0:08:19.01,Caption,,0,0,0,,ЛЕЖИТ. ЗАВТРА ПРИХОДИТ ПОЛИТИЧЕСКОЕ РЕШЕНИЕ.
Dialogue: 0,0:08:19.33,0:08:22.61,Caption,,0,0,0,,ПОСЛЕЗАВТРА ОНА ПРЕВРАЩАЕТСЯ В ПУБЛИЧНОЕ ДЕЛО. ОЧЕНЬ
Dialogue: 0,0:08:22.61,0:08:25.73,Caption,,0,0,0,,УДОБНЫЙ МЕХАНИЗМ, ЕСЛИ ВСЁ ПРОИСХОДИЛО ИМЕННО ТАК,
Dialogue: 0,0:08:25.89,0:08:28.61,Caption,,0,0,0,,КАК УТВЕРЖДАЕТ ДУКА. ПОТОМУ ЧТО ТОГДА УГОЛОВНЫЙ
Dialogue: 0,0:08:28.69,0:08:31.33,Caption,,0,0,0,,ПРОЦЕСС СТАНОВИТСЯ НЕ ПРОСТО ЮРИДИЧЕСКОЙ ПРОЦЕДУРОЙ,
Dialogue: 0,0:08:31.56,0:08:35.33,Caption,,0,0,0,,А РЫЧАГОМ, КОТОРЫЙ МОЖНО ВКЛЮЧИТЬ В НУЖНЫЙ МОМЕНТ. И ТУТ
Dialogue: 0,0:08:35.33,0:08:37.97,Caption,,0,0,0,,УЖЕ СОВСЕМ ДРУГОЙ ВЕС ПОЛУЧАЕТ СЛЕДУЮЩАЯ ИСТОРИЯ.
Dialogue: 0,0:08:40.24,0:08:44.80,Caption,,0,0,0,,ЕСТЬ НЕПОДТВЕРЖДЁННАЯ ВЕРСИЯ, ЧТО ДУКА И ГОНЧАРЕНКО ПРЕВРАЩАЮТ ПАРЛАМЕНТСКУЮ
Dialogue: 0,0:08:44.80,0:08:48.08,Caption,,0,0,0,,КОМИССИЮ В ИНСТРУМЕНТ ДАВЛЕНИЯ НА НАБУ. И ЗДЕСЬ
Dialogue: 0,0:08:48.08,0:08:51.12,Caption,,0,0,0,,СТАРЫЙ КОНФЛИКТ ПОЛУЧАЕТ НОВЫЙ МЕХАНИЗМ. УЖЕ НЕ
Dialogue: 0,0:08:51.12,0:08:53.92,Caption,,0,0,0,,ПРОСТО ПУБЛИЧНЫЕ ОБВИНЕНИЯ И ВЗАИМНЫЕ ПРЕТЕНЗИИ.
Dialogue: 0,0:08:54.19,0:08:56.16,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ОФИЦИАЛЬНАЯ ПЛОЩАДКА,
Dialogue: 0,0:08:56.35,0:09:01.04,Caption,,0,0,0,,ГДЕ МОЖНО ЗАДАВАТЬ ВОПРОСЫ, ВЫТАСКИВАТЬ ОБВИНЕНИЯ В ПУБЛИЧНОЕ ПРОСТРАНСТВО И
Dialogue: 0,0:09:01.12,0:09:03.12,Caption,,0,0,0,,СОЗДАВАТЬ ПОЛИТИЧЕСКОЕ ДАВЛЕНИЕ ВОКРУГ
Dialogue: 0,0:09:03.12,0:09:05.84,Caption,,0,0,0,,РАССЛЕДОВАНИЙ. КОМИССИЯ ВООБЩЕ ВЕЩЬ УДОБНАЯ.
Dialogue: 0,0:09:06.00,0:09:09.44,Caption,,0,0,0,,НАЗВАНИЕ СОЛИДНОЕ. ЗАСЕДАНИЯ ОФИЦИАЛЬНЫЕ. ВОПРОСЫ
Dialogue: 0,0:09:09.44,0:09:12.08,Caption,,0,0,0,,МОЖНО ЗАДАВАТЬ ГРОМКО. ОБВИНЕНИЯ РАЗЛЕТАЮТСЯ
Dialogue: 0,0:09:12.08,0:09:15.12,Caption,,0,0,0,,МОМЕНТАЛЬНО. И ДАЖЕ ЕСЛИ ЮРИДИЧЕСКОГО РЕЗУЛЬТАТА ЕЩЁ
Dialogue: 0,0:09:15.20,0:09:18.72,Caption,,0,0,0,,НЕТ, ПОЛИТИЧЕСКИЙ ЭФФЕКТ ПОЯВЛЯЕТСЯ СРАЗУ. ОДНОГО МОЖНО
Dialogue: 0,0:09:18.80,0:09:22.32,Caption,,0,0,0,,ПОСТАВИТЬ ОПРАВДЫВАТЬСЯ, ДРУГОГО СДЕЛАТЬ ГЕРОЕМ РАЗОБЛАЧЕНИЯ,
Dialogue: 0,0:09:22.41,0:09:26.72,Caption,,0,0,0,,ТРЕТЬЕМУ НАПОМНИТЬ, ЧТО СПОКОЙНОЙ ЖИЗНИ НЕ БУДЕТ. ЕСЛИ СОЕДИНИТЬ ЭТО
Dialogue: 0,0:09:26.80,0:09:29.04,Caption,,0,0,0,,С ЗАЯВЛЕНИЕМ ДУКИ О ПОЧТИ ГОДОВОЙ ЗАДЕРЖКЕ
Dialogue: 0,0:09:29.04,0:09:33.92,Caption,,0,0,0,,ПОДОЗРЕНИЯ КРИВОНОСУ, ПОЯВЛЯЕТСЯ КУДА БОЛЕЕ НЕПРИЯТНЫЙ ВОПРОС. КТО В ЭТОЙ
Dialogue: 0,0:09:34.00,0:09:36.40,Caption,,0,0,0,,СИСТЕМЕ КОНТРОЛИРУЕТ НЕ ТОЛЬКО РАССЛЕДОВАНИЯ,
Dialogue: 0,0:09:36.72,0:09:40.16,Caption,,0,0,0,,НО И МОМЕНТ, КОГДА КОНКРЕТНОЕ РАССЛЕДОВАНИЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:09:40.16,0:09:44.08,Caption,,0,0,0,,ПОЛИТИЧЕСКОЕ ОРУЖИЕ? ПОТОМУ ЧТО ВРЕМЯ ЗДЕСЬ НЕ МЕЛОЧЬ. ОДНО И
Dialogue: 0,0:09:44.08,0:09:46.80,Caption,,0,0,0,,ТО ЖЕ ДЕЛО, ЗАПУЩЕННОЕ В РАЗНЫЕ МЕСЯЦЫ,
Dialogue: 0,0:09:46.96,0:09:49.92,Caption,,0,0,0,,СПОСОБНО ДАТЬ СОВЕРШЕННО РАЗНЫЙ ПОЛИТИЧЕСКИЙ ЭФФЕКТ.
Dialogue: 0,0:09:50.14,0:09:52.88,Caption,,0,0,0,,И ВОТ ТЕПЕРЬ ПОСМОТРИМ НА ВСЮ КОНСТРУКЦИЮ ЦЕЛИКОМ.
Dialogue: 0,0:09:55.16,0:09:58.36,Caption,,0,0,0,,ВНИЗУ ГОСУДАРСТВО ИЩЕТ ЛЮДЕЙ. ИЩЕТ СРЕДИ ТЕХ,
Dialogue: 0,0:09:58.54,0:10:01.32,Caption,,0,0,0,,КТО ЕЩЁ НЕ МОБИЛИЗОВАН. ИЩЕТ СРЕДИ РАБОТНИКОВ С
Dialogue: 0,0:10:01.32,0:10:04.68,Caption,,0,0,0,,БРОНЬЮ. ОБСУЖДАЕТСЯ СНИЖЕНИЕ ВОЗРАСТА. ПОЯВЛЯЮТСЯ
Dialogue: 0,0:10:04.68,0:10:08.92,Caption,,0,0,0,,СООБЩЕНИЯ ДАЖЕ О ПОДРОСТКАХ, КОТОРЫЕ ЗА ДЕНЬГИ СОБИРАЮТ СВЕДЕНИЯ О МУЖЧИНАХ.
Dialogue: 0,0:10:09.35,0:10:11.64,Caption,,0,0,0,,ОДНОВРЕМЕННО МИЛЛИОНЫ ЛЮДЕЙ МОГУТ РЕШИТЬ,
Dialogue: 0,0:10:11.88,0:10:14.44,Caption,,0,0,0,,ЧТО ЛУЧШИЙ СПОСОБ НЕ УЧАСТВОВАТЬ ВО ВСЁМ ЭТОМ,
Dialogue: 0,0:10:14.55,0:10:18.04,Caption,,0,0,0,,ПРОСТО УЕХАТЬ. А НАВЕРХУ ИДЁТ СОВСЕМ ДРУГАЯ БОРЬБА.
Dialogue: 0,0:10:18.31,0:10:20.92,Caption,,0,0,0,,ТАМ ВЫЯСНЯЮТ, КТО МОЖЕТ ДАВИТЬ НА НАБУ,
Dialogue: 0,0:10:21.16,0:10:24.28,Caption,,0,0,0,,КТО СПОСОБЕН ЗАПУСКАТЬ ДЕЛО ПРОТИВ ДИРЕКТОРА НАБУ И
Dialogue: 0,0:10:24.36,0:10:28.52,Caption,,0,0,0,,КТО КОНТРОЛИРУЕТ МОМЕНТ, КОГДА МАТЕРИАЛЫ ИЗ ПАПКИ ПРЕВРАЩАЮТСЯ В ПОДОЗРЕНИЕ.
Dialogue: 0,0:10:29.00,0:10:31.32,Caption,,0,0,0,,ЭТО ДВЕ СТОРОНЫ ОДНОЙ И ТОЙ ЖЕ ПРОБЛЕМЫ
Dialogue: 0,0:10:31.40,0:10:34.36,Caption,,0,0,0,,УПРАВЛЕНИЯ. ГОСУДАРСТВУ ОДНОВРЕМЕННО НУЖНЫ ЛЮДИ ДЛЯ
Dialogue: 0,0:10:34.36,0:10:37.32,Caption,,0,0,0,,АРМИИ, ЛЮДИ ДЛЯ ЭКОНОМИКИ И ЛЮДИ,
Dialogue: 0,0:10:37.40,0:10:40.36,Caption,,0,0,0,,КОТОРЫЕ ПРОСТО ОСТАНУТСЯ ЖИТЬ В СТРАНЕ. НО КАЖДЫЙ
Dialogue: 0,0:10:40.44,0:10:43.48,Caption,,0,0,0,,НОВЫЙ СПОСОБ РЕШИТЬ ОДНУ ПРОБЛЕМУ НАЧИНАЕТ БИТЬ ПО
Dialogue: 0,0:10:43.56,0:10:46.28,Caption,,0,0,0,,ДРУГОЙ. ЗАБРАЛИ РАБОТНИКОВ ИЗ ЭКОНОМИКИ,
Dialogue: 0,0:10:46.52,0:10:48.76,Caption,,0,0,0,,ПОЛУЧИЛИ БОЛЬШЕ МОБИЛИЗАЦИОННОГО РЕСУРСА,
Dialogue: 0,0:10:48.92,0:10:51.96,Caption,,0,0,0,,НО МЕНЬШЕ РАБОЧИХ РУК. УСИЛИЛИ ПОИСК МУЖЧИН,
Dialogue: 0,0:10:52.24,0:10:55.24,Caption,,0,0,0,,ПОЛУЧИЛИ ЕЩЁ БОЛЬШЕ ЖЕЛАНИЯ СПРЯТАТЬСЯ ИЛИ УЕХАТЬ.
Dialogue: 0,0:10:55.56,0:11:00.36,Caption,,0,0,0,,НЕ УДЕРЖАЛИ ЭНЕРГЕТИКУ, ПОЛУЧИЛИ НОВУЮ ВОЛНУ БЕЖЕНЦЕВ. А КОГДА НАВЕРХУ ИДЁТ
Dialogue: 0,0:11:00.44,0:11:03.24,Caption,,0,0,0,,БОРЬБА ЗА СИЛОВЫЕ И АНТИКОРРУПЦИОННЫЕ РЫЧАГИ,
Dialogue: 0,0:11:03.56,0:11:05.64,Caption,,0,0,0,,ДОВЕРИЯ КО ВСЕЙ ЭТОЙ КОНСТРУКЦИИ БОЛЬШЕ НЕ
Dialogue: 0,0:11:05.64,0:11:08.28,Caption,,0,0,0,,СТАНОВИТСЯ. ВОТ ЭТО И ЕСТЬ САМОЕ НЕПРИЯТНОЕ
Dialogue: 0,0:11:08.28,0:11:13.68,Caption,,0,0,0,,ПРОТИВОРЕЧИЕ. ГОСУДАРСТВО ТРЕБУЕТ ОТ ЧЕЛОВЕКА ВСЁ БОЛЬШЕ,
Dialogue: 0,0:11:14.00,0:11:16.72,Caption,,0,0,0,,А СПОСОБНОСТЬ САМОГО ГОСУДАРСТВА ДАТЬ ЕМУ НОРМАЛЬНЫЕ
Dialogue: 0,0:11:16.72,0:11:19.68,Caption,,0,0,0,,УСЛОВИЯ СТАНОВИТСЯ ВСЁ СЛАБЕЕ. ЭЛЕКТРИЧЕСТВО И
Dialogue: 0,0:11:19.76,0:11:22.80,Caption,,0,0,0,,ОТОПЛЕНИЕ ПРЕВРАЩАЮТСЯ В ВОПРОС МИГРАЦИИ. РАБОТА
Dialogue: 0,0:11:22.80,0:11:26.24,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ВОПРОС БРОНИ. ВОЗРАСТ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:11:26.24,0:11:29.28,Caption,,0,0,0,,ВОПРОС МОБИЛИЗАЦИОННОГО РЕЗЕРВА. ДАЖЕ СОСЕДСКИЙ
Dialogue: 0,0:11:29.36,0:11:31.76,Caption,,0,0,0,,ДВОР, ЕСЛИ ВЕРИТЬ ПОЯВИВШИМСЯ СООБЩЕНИЯМ,
Dialogue: 0,0:11:32.08,0:11:34.96,Caption,,0,0,0,,МОЖЕТ ПРЕВРАТИТЬСЯ В МЕСТО СБОРА ИНФОРМАЦИИ. И ТУТ
Dialogue: 0,0:11:34.96,0:11:38.88,Caption,,0,0,0,,УЖЕ НЕ СПАСЁТ ЗАЯВЛЕНИЕ, ЧТО ПРИНУДИТЕЛЬНАЯ МОБИЛИЗАЦИЯ СВЕДЕНА К НУЛЮ.
Dialogue: 0,0:11:39.30,0:11:42.08,Caption,,0,0,0,,ПОТОМУ ЧТО ЛЮДИ ОЦЕНИВАЮТ НЕ ФОРМУЛИРОВКУ ДЕПУТАТА,
Dialogue: 0,0:11:42.24,0:11:44.16,Caption,,0,0,0,,А ТО, ЧТО ПРОИСХОДИТ ВОКРУГ НИХ.
Dialogue: 0,0:11:45.04,0:11:47.44,Caption,,0,0,0,,САМАЯ ОПАСНАЯ ДЛЯ КИЕВА ВЕЩЬ ЗДЕСЬ ДАЖЕ НЕ
Dialogue: 0,0:11:47.44,0:11:50.48,Caption,,0,0,0,,ОТДЕЛЬНАЯ ЦИФРА И НЕ ОТДЕЛЬНЫЙ СКАНДАЛ. ПРОБЛЕМА
Dialogue: 0,0:11:50.48,0:11:54.40,Caption,,0,0,0,,НАЧИНАЕТСЯ ТОГДА, КОГДА ЧЕЛОВЕК СМОТРИТ НА ВСЁ ЭТО ОДНОВРЕМЕННО И
Dialogue: 0,0:11:54.48,0:11:57.20,Caption,,0,0,0,,ДЕЛАЕТ СОБСТВЕННЫЙ ВЫВОД. ЕСЛИ ВПЕРЕДИ ХОЛОДНАЯ
Dialogue: 0,0:11:57.20,0:12:00.72,Caption,,0,0,0,,ЗИМА, БРОНЬ МОГУТ СНЯТЬ, ПРАВИЛА МОБИЛИЗАЦИИ УЖЕСТОЧАЮТ,
Dialogue: 0,0:12:01.12,0:12:03.20,Caption,,0,0,0,,А НАВЕРХУ ЗАНЯТЫ БОРЬБОЙ МЕЖДУ СИЛОВЫМИ И
Dialogue: 0,0:12:03.20,0:12:04.88,Caption,,0,0,0,,АНТИКОРРУПЦИОННЫМИ СТРУКТУРАМИ,
Dialogue: 0,0:12:05.20,0:12:07.76,Caption,,0,0,0,,ТО У НЕГО ОСТАЁТСЯ ОЧЕНЬ ПРОСТОЙ ВЫБОР. ТЕРПЕТЬ
Dialogue: 0,0:12:07.84,0:12:10.40,Caption,,0,0,0,,И ЖДАТЬ СЛЕДУЮЩЕГО РЕШЕНИЯ ИЛИ УЕХАТЬ РАНЬШЕ,
Dialogue: 0,0:12:10.64,0:12:13.20,Caption,,0,0,0,,ЧЕМ РЕШЕНИЕ ПРИМУТ ЗА НЕГО. И ВОТ ТОГДА
Dialogue: 0,0:12:13.25,0:12:15.76,Caption,,0,0,0,,ДВА С ПОЛОВИНОЙ МИЛЛИОНА ПЕРЕСТАЮТ БЫТЬ ПРОСТО
Dialogue: 0,0:12:15.76,0:12:18.72,Caption,,0,0,0,,ПРОГНОЗНОЙ ЦИФРОЙ. ОНИ ПРЕВРАЩАЮТСЯ В ПРЕДЕЛ,
Dialogue: 0,0:12:18.96,0:12:21.68,Caption,,0,0,0,,ЗА КОТОРЫМ САМА МОБИЛИЗАЦИОННАЯ ПОЛИТИКА НАЧИНАЕТ
Dialogue: 0,0:12:21.68,0:12:27.88,Caption,,0,0,0,,СПОРИТЬ С ДЕМОГРАФИЕЙ. МОЖНО СКОЛЬКО УГОДНО РАСШИРЯТЬ РЕЗЕРВ НА БУМАГЕ,
Dialogue: 0,0:12:28.04,0:12:31.08,Caption,,0,0,0,,МЕНЯТЬ БРОНЬ И ИСКАТЬ НОВЫЕ КАТЕГОРИИ ЛЮДЕЙ. НО
Dialogue: 0,0:12:31.16,0:12:33.40,Caption,,0,0,0,,ЕСЛИ ЧЕЛОВЕК ФИЗИЧЕСКИ ПОКИНУЛ СТРАНУ,
Dialogue: 0,0:12:33.64,0:12:36.04,Caption,,0,0,0,,НИКАКОЕ ПОСТАНОВЛЕНИЕ УЖЕ НЕ ВЕРНЁТ ЕГО В
Dialogue: 0,0:12:36.04,0:12:39.24,Caption,,0,0,0,,МОБИЛИЗАЦИОННЫЙ СПИСОК. И В ЭТОМ САМАЯ НЕПРИЯТНАЯ
Dialogue: 0,0:12:39.24,0:12:42.04,Caption,,0,0,0,,МАТЕМАТИКА ВСЕЙ ИСТОРИИ. ЧЕМ СИЛЬНЕЕ ГОСУДАРСТВО
Dialogue: 0,0:12:42.04,0:12:44.52,Caption,,0,0,0,,ПЫТАЕТСЯ ВЫЖАТЬ ДОПОЛНИТЕЛЬНЫЙ РЕСУРС ИЗ ТЕХ,
Dialogue: 0,0:12:44.65,0:12:48.36,Caption,,0,0,0,,КТО ОСТАЛСЯ, ТЕМ ВАЖНЕЕ СТАНОВИТСЯ ДРУГОЙ ВОПРОС СКОЛЬКО ЛЮДЕЙ
Dialogue: 0,0:12:48.44,0:12:50.28,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ВООБЩЕ ЗАХОТЯТ ОСТАТЬСЯ?
